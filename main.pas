{ [Ammo]: the weapon in the hands is empty and nothing is left to load: it is taken away (the
  secondary stays) }
procedure AmmoTake(ID: Integer; P: TActivePlayer);
var
  NW: TNewWeapon;
  W: Integer;
begin
  W := P.Primary.WType;
  NW := TNewWeapon.Create;
  try
    NW.WType := WEP_NONE;
    P.ForceWeapon(NW, P.Secondary);
  finally
    NW.Free;
  end;
  AmSetLastW(ID, WEP_NONE);
  AmRepacking[ID] := False;
  AmNoAmmoUntil[ID] := Game.TickCount + AhNoAmmoTicks;
  AcAmmoTouched(ID);
  if HumanOf[ID] then
    if (W >= 0) and (W <= 16) then
      Say(ID, 'Out of ammo: the ' + WeaponName(W) + ' is taken away (nothing left to load).', ColorBad);
end;

{ !ammo: the magazine and what is left for the weapon in the hands }
procedure CmdAmmo(ID: Integer);
var
  P: TActivePlayer;
  W, i, n, Clip: Integer;
  Msg: string;
begin
  if not AmmoEnabled then
  begin
    Say(ID, 'Ammo system is switched off on this server.', ColorBad);
    Exit;
  end;
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'The ammunition is for players in the game.', ColorBad);
    Exit;
  end;
  P := PL[ID];
  W := P.Primary.WType;
  if (W < 0) or (W > 16) or (W = WEP_KNIFE) or not P.Alive then
  begin
    Say(ID, 'No weapon in hands.', ColorBad);
    Exit;
  end;
  Clip := BE_AmmoShown(ID, Game.TickCount, W, P.Primary.Ammo);
  if W = 12 then
  begin
    Msg := BE_AmmoFormatHud(ID, W, Clip);
    if Copy(Msg, 1, 3) = ' | ' then
      Msg := Copy(Msg, 4, Length(Msg));
    Say(ID, WeaponName(W) + ' - ' + Msg, ColorGood);
    Exit;
  end;
  if BE_AmmoUsesMags(W) = 1 then
  begin
    n := BE_AmmoMagCount(ID, W);
    Msg := WeaponName(W) + ' - loaded ' + IntToStr(Clip) + '/' + IntToStr(WpAmmo[W]) + ' | spare magazines (' +
      IntToStr(n) + '): ';
    if n = 0 then
      Msg := Msg + 'none';
    for i := 0 to n - 1 do
    begin
      if i > 0 then
        Msg := Msg + ', ';
      Msg := Msg + '[' + IntToStr(i + 1) + '] ' + IntToStr(BE_AmmoMagRounds(ID, W, i));
    end;
    if BE_AmmoLoose(ID, W) > 0 then
      Msg := Msg + ' | loose rounds ' + IntToStr(BE_AmmoLoose(ID, W));
    Say(ID, Msg, ColorGood);
  end
  else
    Say(ID, WeaponName(W) + ' - loaded ' + IntToStr(Clip) + ' | reserve ' + IntToStr(BE_AmmoLoose(ID, W)), ColorGood);
end;

{ !mag - the spare magazines; !mag <n> - load that one now (the one in the weapon goes back into the
  pouch) }
procedure CmdMag(ID: Integer; Args: string);
var
  P: TActivePlayer;
  W, n, k, Clip: Integer;
begin
  if not AmmoEnabled then
  begin
    Say(ID, 'Ammo system is switched off on this server.', ColorBad);
    Exit;
  end;
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'The ammunition is for players in the game.', ColorBad);
    Exit;
  end;
  P := PL[ID];
  W := P.Primary.WType;
  if (W < 0) or (W > 16) or not P.Alive then
  begin
    Say(ID, 'No weapon in hands.', ColorBad);
    Exit;
  end;
  { D13: the change of the weapon in his hands is not counted yet (the ammunition's next look) }
  if W <> AmLastW[ID] then
  begin
    Say(ID, 'A moment - the weapon in your hands just changed.', ColorBad);
    Exit;
  end;
  if BE_AmmoUsesMags(W) = 0 then
  begin
    Say(ID, WeaponName(W) + ' has no magazines here (' + iif(AmmoMagazineMode, 'shells and single rounds come from the ' +
      'reserve', 'MagazineMode = 0') + '). Try !ammo.', ColorBad);
    Exit;
  end;
  Args := Trim(Args);
  if Args = '' then
  begin
    CmdAmmo(ID);
    Say(ID, 'Load one of them now: !mag <number>', ColorGood);
    Exit;
  end;
  n := BE_AmmoMagCount(ID, W);
  k := StrToIntDef(Args, 0);
  if (k < 1) or (k > n) then
  begin
    Say(ID, 'Choose a magazine from 1 to ' + IntToStr(n) + '.', ColorBad);
    Exit;
  end;
  BE_AmmoSelectMag(ID, W, k - 1);
  Clip := BE_AmmoShown(ID, Game.TickCount, W, P.Primary.Ammo);
  if BE_AmmoReloadNow(ID, Game.TickCount, Clip) = 1 then
  begin
    P.Primary.Ammo := 0;
    AcAmmoTouched(ID);
    Say(ID, 'Reloading magazine ' + IntToStr(k) + ' (' + IntToStr(BE_AmmoMagRounds(ID, W, k - 1)) + ' rounds).', ColorGood);
  end
  else
    Say(ID, 'Magazine ' + IntToStr(k) + ' is loaded at the next reload.', ColorGood);
  HudMark(ID, False);
end;

