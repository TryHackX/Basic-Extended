{ /be_prof on|off|reset, or the table: each part of the tick that ran, with its runs, the average
  and longest time of a run and the time it takes a tick on average }
procedure CmdProf(ID: Integer; Args: string);
var
  W, T: string;
  k, Ticks: Integer;
begin
  W := LowerCase(Trim(Args));
  if not BeOk then
  begin
    Say(ID, 'The profile needs basicext_dll, which is not running.', ColorBad);
    Exit;
  end;
  if (W = 'on') or (W = 'reset') or ((W = '') and not ProfOn) then
  begin
    BE_ProfReset();
    ProfFrom := Game.TickCount;
    ProfOn := True;
    Say(ID, 'Profiling on: /be_prof shows the parts of a tick, /be_prof reset starts again, /be_prof off stops.',
      ColorGood);
    Exit;
  end;
  if W = 'off' then
  begin
    ProfOn := False;
    Say(ID, 'Profiling off.', ColorGood);
    Exit;
  end;
  Ticks := Game.TickCount - ProfFrom;
  Say(ID, 'Profile of ' + IntToStr(Ticks) + ' ticks (' + IntToStr(Ticks div 60) + ' s); a tick has 16667 us:', ColorGood);
  for k := 0 to 43 do
  begin
    T := BE_ProfText(k, Ticks);
    if T <> '' then
      Say(ID, ProfName(k) + ': ' + T, ColorGood);
  end;
end;

procedure CmdRepack(ID: Integer);
var
  P: TActivePlayer;
  R: Integer;
begin
  if not AmmoEnabled then
  begin
    Say(ID, 'Ammo system is switched off on this server.', ColorBad);
    Exit;
  end;
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'The ammunition is for players in the game.', ColorBad);
    Exit;
  end;
  P := PL[ID];
  if not P.Alive then
  begin
    Say(ID, 'No weapon in hands.', ColorBad);
    Exit;
  end;
  { D13: the change of the weapon in his hands is not counted yet }
  if P.Primary.WType <> AmLastW[ID] then
  begin
    Say(ID, 'A moment - the weapon in your hands just changed.', ColorBad);
    Exit;
  end;
  R := BE_AmmoRepack(ID, Game.TickCount);
  if R = 1 then
  begin
    AmRepacking[ID] := True;
    AmMaskDirty := True;
    Say(ID, 'Repacking the spare magazines: hold your fire (it begins in ' + FloatStr(AmmoRepackStart / 60.0, 1) +
      ' s, then ' + FloatStr(AmmoRepackStep / 60.0, 1) + ' s a magazine; a shot stops it).', ColorGood);
  end
  else if R = 0 then
    Say(ID, 'Nothing to repack: the spare magazines are full, or only one is partly empty.', ColorGood)
  else if R = -1 then
    Say(ID, WeaponName(P.Primary.WType) + ' has no magazines here. Try !ammo.', ColorBad)
  else
    Say(ID, 'No weapon in hands.', ColorBad);
end;

{ what the library says about a /repack: the messages, and "Repacking..." over the soldier }
{ a short status text over a soldier (Looting, Repacking): centred on him, [Looting] TextScale,
  TextOffsetX and TextOffsetY (standing); crouching or lying his head is lower and the text follows it
  (his eyes from the skeleton: standing 19 px over his position, crouching 11, lying 6.5) }
procedure StatusText(P: TActivePlayer; Text: string; Delay: Integer; X, Y: Single);
var
  W, EX, EY, Drop: Single;
begin
  if BeOk then
    W := BE_TextWidth(Text, LootTextScale)
  else
    W := Length(Text) * LootTextScale * WT_CHAR_WIDTH;
  Drop := -1;
  if BeOk then
    if BE_SpriteEyes(P.ID, P, X, Y, EX, EY) = 1 then
      Drop := EY - (Y - 19);
  if Drop < 0 then
  begin
    Drop := 0;
    if P.IsProne then
      Drop := 12
    else if P.KeyCrouch then
      Drop := 8;
  end;
  if Drop > 16 then
    Drop := 16;
  P.WorldText(249, Text, Delay, ColorGood, LootTextScale, X - W / 2 + LootTextX, Y + LootTextY + Drop);
end;

{ a dead soldier's spare magazines stay with his body now (DeadMagazines; only with corpse looting) }
function LootBodyNow(): Boolean;
begin
  Result := False;
  if LootEnabled then
    if LootCorpse then
      if LootDeadMags = 1 then
        Result := True
      else if LootDeadMags = 2 then
        Result := Game.Survival;
end;

procedure AmmoRepackNews(i: Integer; P: TActivePlayer);
var
  E: Integer;
begin
  E := BE_AmmoRepackEvent(i);
  if E = AMR_STARTED then
    HudMark(i, False)
  else if E = AMR_STEP then
    HudMark(i, False)
  else if E = AMR_DONE then
  begin
    AmRepacking[i] := False;
    HudMark(i, False);
    Say(i, 'Magazines repacked.', ColorGood);
  end
  else if E = AMR_SHOT then
  begin
    AmRepacking[i] := False;
    Say(i, 'Repacking stopped: you fired.', ColorBad);
  end
  else if E = AMR_STOPPED then
  begin
    AmRepacking[i] := False;
    Say(i, 'Repacking stopped.', ColorBad);
  end;
  if AmRepacking[i] then
    if BE_AmmoRepacking(i) = 0 then
      AmRepacking[i] := False
    else if HumanOf[i] then
      if (Game.TickCount + i) mod 30 = 0 then
        StatusText(P, 'Repacking', 40, P.X, P.Y);
end;

{ [Looting]: crouching or lying still over a dead soldier's weapon of the kind in the hands takes a
  spare magazine (or rounds), and with a full pouch tops up the own magazines. Looked at every 10
  ticks. }
procedure LootCheck(i, W: Integer; P: TActivePlayer);
var
  R: Integer;
  X, Y: Single;
begin
  if not (P.KeyCrouch or P.IsProne) then
  begin
    AmLootTicks[i] := 0;
    Exit;
  end;
  if (Abs(P.VelX) >= 0.6) or (Abs(P.VelY) >= 0.6) then
  begin
    AmLootTicks[i] := 0;
    Exit;
  end;
  X := P.X;
  Y := P.Y;
  if BE_AmmoCanLoot(i, W, X, Y) <> 1 then
  begin
    AmLootTicks[i] := 0;
    Exit;
  end;
  if (AmLootTicks[i] > 0) and (Abs(X - AmLootX[i]) < 15) and (Abs(Y - AmLootY[i]) < 15) then
    AmLootTicks[i] := AmLootTicks[i] + 10
  else
  begin
    AmLootTicks[i] := 10;
    AmLootX[i] := X;
    AmLootY[i] := Y;
  end;
  if AmLootTicks[i] < LootTimeTicks then
  begin
    if HumanOf[i] then
      StatusText(P, 'Looting', 25, X, Y);
    Exit;
  end;
  R := BE_AmmoLoot(i, W, X, Y, 0);
  if R > 0 then
  begin
    Say(i, 'Looted a spare magazine (' + IntToStr(R) + ' rounds).', ColorGood);
    AmLootTicks[i] := 0;
    HudMark(i, False);
  end
  else if R < 0 then
  begin
    if AmLootTicks[i] >= LootRepackTicks then
    begin
      R := BE_AmmoLoot(i, W, X, Y, 1);
      if R > 0 then
      begin
        Say(i, 'Repacked ' + IntToStr(R) + ' loose rounds into your magazines.', ColorGood);
        HudMark(i, False);
      end;
      AmLootTicks[i] := 0;
    end;
  end
  else
    AmLootTicks[i] := 0;
end;

{ the map object style of a weapon lying on the ground (0 = it never lies there) }
function WeaponObjStyle(W: Integer): Integer;
begin
  Result := 0;
  if (W >= 0) and (W <= 10) then
    Result := W + 4
  else if W = WEP_KNIFE then
    Result := 24
  else if W = 12 then
    Result := 25
  else if W = WEP_LAW then
    Result := 26
  else if (W = WEP_BOW) or (W = WEP_BOW_FIRE) then
    Result := 15;
end;

function WeaponObjGone(Slot, Style: Integer): Boolean;
begin
  Result := True;
  if (Slot < 1) or (Slot > MAX_OBJECT_ID) then
    Exit;
  if OB[Slot].Active then
    Result := OB[Slot].Style <> Style;
end;

{ a weapon was thrown away or left by a dead soldier near X, Y: its map object (the nearest of its
  kind nobody claimed) is told to the library }
procedure WeaponObjAttach(ID, W, Corpse, Tick: Integer; X, Y: Single);
var
  i, St, Best: Integer;
  D, BestD: Single;
begin
  St := WeaponObjStyle(W);
  if St = 0 then
    Exit;
  Best := 0;
  BestD := 150 * 150;
  for i := 1 to MAX_OBJECT_ID do
    if OB[i].Active then
      if OB[i].Style = St then
      begin
        D := (OB[i].X - X) * (OB[i].X - X) + (OB[i].Y - Y) * (OB[i].Y - Y);
        if D <= BestD then
          if BE_AmmoGroundHasSlot(i) = 0 then
          begin
            BestD := D;
            Best := i;
          end;
      end;
  if Best > 0 then
    BE_AmmoGroundAttach(ID, W, Best, Corpse, Tick);
end;

{ a weapon came into empty hands: the record whose object vanished near the soldier (a pickup), or
  -1 (a weapon from the menu or one of the map) }
function WeaponObjTaken(W: Integer; X, Y: Single; Tick: Integer): Integer;
var
  k, St, Slot, D, BestD: Integer;
begin
  Result := -1;
  St := WeaponObjStyle(W);
  if St = 0 then
    Exit;
  BestD := 250;
  k := BE_AmmoGroundNext(W, 0);
  while k >= 0 do
  begin
    Slot := BE_AmmoGroundSlot(k);
    { D8: a weapon 20 s on the ground despawned (the game's GUNRESISTTIME), nobody took it }
    if Slot > 0 then
      if BE_AmmoGroundAge(k, Tick) < 1190 then
      if WeaponObjGone(Slot, St) then
      begin
        D := BE_AmmoGroundDist(k, X, Y);
        if D <= BestD then
        begin
          BestD := D;
          Result := k;
        end;
      end;
    k := BE_AmmoGroundNext(W, k + 1);
  end;
end;

{ every half second: the weapons on the ground follow their objects; one missing for a while is
  gone (despawned, or taken by somebody the ammunition does not follow) }
procedure WeaponObjRefresh(Tick: Integer);
var
  k, Slot, St: Integer;
begin
  k := BE_AmmoGroundNext(-1, 0);
  while k >= 0 do
  begin
    Slot := BE_AmmoGroundSlot(k);
    if Slot > 0 then
    begin
      St := WeaponObjStyle(BE_AmmoGroundKind(k));
      if WeaponObjGone(Slot, St) then
        BE_AmmoGroundMissing(k, Tick)
      else
        BE_AmmoGroundMove(k, OB[Slot].X, OB[Slot].Y);
    end;
    k := BE_AmmoGroundNext(-1, k + 1);
  end;
end;

{ D8: the script put a weapon into his hands now (the next weapon change is no pickup from the ground) }
procedure AmGiven(ID: Integer);
begin
  if (ID >= 1) and (ID <= 32) then
    AmGivenT[ID] := Game.TickCount;
end;

{ the library's answer for soldier i: set the magazine, take the weapon away, draw the line again }
procedure AmmoAct(i, Act, V: Integer; P: TActivePlayer);
begin
  if Act = AMA_SET then
  begin
    P.Primary.Ammo := V;
    AcAmmoTouched(i);
    HudMarkL(i, HlAmmoBits());
  end
  else if Act = AMA_DROP then
  begin
    AmmoTake(i, P);
    HudMarkL(i, HlAmmoBits());
  end
  else if Act = AMA_HUD then
    HudMarkL(i, HlAmmoBits());
end;

{ [Ammo], one soldier through his properties: the library follows the magazine count the game reports for the weapon
  in the hands and says when the script must set the magazine (a reload loaded more than there was) or take the
  weapon away (nothing left). The secondary is read only when the primary changed. }
procedure AmmoTickOne(i, Tick: Integer);
var
  W, A, SW, SA, F, Act, V, OldW: Integer;
  P: TActivePlayer;
  Pr: TPlayerWeapon;
  X, Y: Single;
  Thrown, Swap: Boolean;
begin
        P := PL[i];
        if not P.Alive then
        begin
          { DeadMagazines: the spare magazines lie with the body, which the game still moves }
          if AmBody[i] then
            if (Tick + i) mod 15 = 0 then
              BE_AmmoBodyMove(i, P.X, P.Y);
          Exit;
        end;
        Pr := P.Primary;
        W := Pr.WType;
        A := Pr.Ammo;
        SW := -1;
        SA := -1;
        X := 0;
        Y := 0;
        OldW := AmLastW[i];
        Thrown := False;
        { D9: a count the game reports out of range for a tick (2.8.2 may say 255): the change waits for the next
          tick (the library would postpone it and lose the swap and the pickup of this one) }
        if W <> OldW then
          if (W >= 0) and (W <= 16) and (W <> WEP_KNIFE) and (W <> 12) then
            if (A < 0) or (A > WpAmmo[W]) then
              Exit;
        if W <> OldW then
        begin
          SW := P.Secondary.WType;
          SA := P.Secondary.Ammo;
          X := P.X;
          Y := P.Y;
          AmSetLastW(i, W);
          { the anticheat's look at the magazine starts again (a weapon taken up or swapped is no reload) }
          AcAmmoTouched(i);
          { a swap with the secondary (the key Q) brings the old secondary into the hands and puts
            the old primary in its place. Anything else: a weapon into empty hands is from the ground
            when its object vanished; a weapon out of the hands into nothing was thrown away. }
          Swap := (SW = OldW) and (W = AmLastSW[i]);
          AmLastSW[i] := SW;
          if not Swap then
          begin
            { D8: only into hands emptied in this life (not the first weapon of a life), and not a weapon the
              script gave a moment ago }
            if (W >= 0) and (W <= 16) then
              if OldW = WEP_NONE then
                if Tick - AmGivenT[i] > 3 then
                  BE_AmmoPickFrom(i, Tick, WeaponObjTaken(W, X, Y, Tick));
            if W = WEP_NONE then
              if (OldW >= 0) and (OldW <= 16) and (OldW <> WEP_KNIFE) then
                Thrown := True;
          end;
        end;
        F := 0;
        if HumanOf[i] then
          F := F + AMF_HUMAN;
        if (W >= 0) and (W <= 16) then
        begin
          if P.KeyReload then
            F := F + AMF_RELOAD;
          { the fire key counts for the chainsaw's fuel and stops a /repack }
          if (W = 12) or AmRepacking[i] then
            if P.KeyShoot then
              F := F + AMF_SHOOT;
        end;
        if InfOn[i] then
          F := F + AMF_FREE;
        V := 0;
        Act := BE_AmmoObserve(i, Tick, W, A, SW, SA, F, X, Y, V);
        AmmoAct(i, Act, V, P);
        if Thrown then
          if not HookThings then
            WeaponObjAttach(i, OldW, 0, Tick, X, Y);
        if AmRepacking[i] then
          AmmoRepackNews(i, P);
        if LootEnabled then
          if LootCorpse then
            if (Tick + i) mod 10 = 0 then
              if (W >= 0) and (W <= 16) and (W <> WEP_KNIFE) and (W <> 12) then
                LootCheck(i, W, P);
end;

{ round 26: [General] MemoryReads - two living soldiers with two weapons each teach the library where the weapons,
  the keys and the aim lie in the soldiers' records (once a second until it knows) }
procedure AmMemCalibrate();
var
  i, j, n, W, SW: Integer;
  P: TActivePlayer;
begin
  n := 0;
  for i := 1 to TopSlot do
    if n < 3 then
      if ActiveSlot[i] then
        if SkBound[i] then
        begin
          P := PL[i];
          if P.Alive then
          begin
            W := P.Primary.WType;
            SW := P.Secondary.WType;
            if (W >= 0) and (W <= 16) and (SW >= 0) and (SW <= 16) and (W <> SW) then
            begin
              n := n + 1;
              if BE_SpriteCalibrate(i, W, P.Primary.Ammo, SW, P.Secondary.Ammo, P.Grenades, P.MouseAimX,
                P.MouseAimY) = 1 then
              begin
                AmMemOn := True;
                Log('[Ammo] ' + BE_SpriteMemInfo());
                { the library looks at a soldier only while his weapon is the one the script saw last }
                for j := 1 to 32 do
                  BE_AmmoLastW(j, AmLastW[j]);
                Exit;
              end;
            end;
          end;
        end;
end;

{ round 26: once a second the next living soldier's record against his properties - a mismatch switches the reading
  off for good (the properties are read again, as before) }
procedure AmMemCheck();
var
  k, i, R, Keys: Integer;
  P: TActivePlayer;
begin
  for k := 1 to TopSlot do
  begin
    AmMemNext := AmMemNext + 1;
    if AmMemNext > TopSlot then
      AmMemNext := 1;
    i := AmMemNext;
    if ActiveSlot[i] then
    begin
      P := PL[i];
      { the keys in the record's order: left, right, up, crouch, fire, jetpack, grenade, change, throw, reload, prone,
        flag throw }
      Keys := BoolInt(P.KeyLeft) + BoolInt(P.KeyRight) * 2 + BoolInt(P.KeyUp) * 4 + BoolInt(P.KeyCrouch) * 8 +
        BoolInt(P.KeyShoot) * 16 + BoolInt(P.KeyJetpack) * 32 + BoolInt(P.KeyGrenade) * 64 +
        BoolInt(P.KeyChangeWeap) * 128 + BoolInt(P.KeyThrow) * 256 + BoolInt(P.KeyReload) * 512 +
        BoolInt(P.KeyProne) * 1024 + BoolInt(P.KeyFlagThrow) * 2048;
      R := BE_SpriteCheck(i, BoolInt(P.Alive), P.Primary.WType, P.Primary.Ammo, P.Secondary.WType, P.Secondary.Ammo,
        P.Grenades, P.MouseAimX, P.MouseAimY, Keys);
      if R = 0 then
      begin
        AmMemOn := False;
        if not AmMemTold then
        begin
          AmMemTold := True;
          Log('[Ammo] ' + BE_SpriteMemInfo() + ' - the properties are read again');
        end;
      end;
      Exit;
    end;
  end;
end;

{ round 26: the ammunition of all soldiers in one library call (their records); the ones it cannot follow (a weapon
  change, a record not readable) are looked at the old way }
procedure AmMaskBuild();
var
  i, b: Integer;
begin
  AmMaskDirty := False;
  AmMask := 0;
  AmHumanMask := 0;
  AmFreeMask := 0;
  AmRepackMask := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] or AmmoBots then
      begin
        b := 1 shl (i - 1);
        AmMask := AmMask or b;
        if HumanOf[i] then
          AmHumanMask := AmHumanMask or b;
        if InfOn[i] then
          AmFreeMask := AmFreeMask or b;
        if AmRepacking[i] then
          AmRepackMask := AmRepackMask or b;
      end;
end;

procedure AmmoTickMem(Tick: Integer);
var
  i, n, k, ID, Act, V, W: Integer;
  P: TActivePlayer;
begin
  if AmMaskDirty or (Tick mod 30 = 0) then
    AmMaskBuild();
  n := BE_AmmoPass(Tick, AmMask, AmHumanMask, AmFreeMask, AmRepackMask);
  for k := 0 to n - 1 do
  begin
    BE_AmmoPassOp(k, ID, Act, V);
    if (ID >= 1) and (ID <= 32) then
      if Act = AMA_FULL then
        AmmoTickOne(ID, Tick)
      else
        AmmoAct(ID, Act, V, PL[ID]);
  end;
  { the repacking soldiers }
  if AmRepackMask <> 0 then
    for i := 1 to TopSlot do
      if AmRepacking[i] then
        if ActiveSlot[i] then
          AmmoRepackNews(i, PL[i]);
  { the bodies' magazines move with them: each slot every 15 ticks (a couple of slots a tick) }
  i := 15 - Tick mod 15;
  while i <= TopSlot do
  begin
    if AmBody[i] then
      if ActiveSlot[i] then
        if not PL[i].Alive then
          BE_AmmoBodyMove(i, PL[i].X, PL[i].Y);
    i := i + 15;
  end;
  { the looting: each slot every 10 ticks }
  if LootEnabled then
    if LootCorpse then
    begin
      i := 10 - Tick mod 10;
      while i <= TopSlot do
      begin
        if ActiveSlot[i] then
          if HumanOf[i] or AmmoBots then
          begin
            W := AmLastW[i];
            if (W >= 0) and (W <= 16) and (W <> WEP_KNIFE) and (W <> 12) then
            begin
              P := PL[i];
              if P.Alive then
                LootCheck(i, W, P);
            end;
          end;
        i := i + 10;
      end;
    end;
end;

procedure AmmoTick(Tick: Integer);
var
  i: Integer;
begin
  { a weapon left on the ground in the last tick (with a body, at a team change, by a player who left
    the game): its map object is there now - the hook in CreateThing told it already, else the
    nearest one of its kind is taken }
  if AmCorpseN > 0 then
  begin
    AmCorpseN := 0;
    for i := 1 to 32 do
      if AmCorpseW[i] >= 0 then
      begin
        if Tick > AmCorpseT[i] then
        begin
          if not HookThings then
            WeaponObjAttach(i, AmCorpseW[i], 1, Tick, AmCorpseX[i], AmCorpseY[i]);
          AmCorpseW[i] := -1;
        end
        else
          AmCorpseN := AmCorpseN + 1;
      end;
  end;
  if AmMemOn and AmMemWant then
    AmmoTickMem(Tick)
  else
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if HumanOf[i] or AmmoBots then
          AmmoTickOne(i, Tick);
  { [General] MemoryReads: the places learnt once a second, then checked once a second }
  if BeOk then
    if AmMemWant then
      if Tick mod 60 = 41 then
      begin
        if AmMemOn then
          AmMemCheck()
        else if not AmMemTold then
          if BE_SpriteMemReady() = 0 then
            AmMemCalibrate();
      end;
  if AmmoTrackGround then
    if Tick mod 30 = 0 then
      WeaponObjRefresh(Tick);
end;


{ !radar (players, when the radar is public) and /radar or /overlay (SteamIds users and admins):
  on/off, mode, tick, zoom, show, edit, done, pos, size, reset, help. Cmd is the word shown in the
  answers. }
procedure CmdRadar(ID: Integer; Args, Cmd: string);
var
  W, Rest, Modes: string;
  N, M, X, Y: Integer;
  V: Single;
  Ok, NewOn, DefOn, Was, OldOn: Boolean;
begin
  if not OvlEnabled then
  begin
    Say(ID, 'The radar is switched off on this server.', ColorBad);
    Exit;
  end;
  OldOn := OvlOn[ID];
  Was := OvlAllowed[ID];
  OverlayAllow(ID);
  if Was <> OvlAllowed[ID] then
  begin
    RadarApplyOn(ID);
    RadarDirty(ID);
    OverlayRecount();
  end;
  if not RadarMay(ID) then
  begin
    if Cmd = '!radar' then
      Say(ID, 'The radar is not public on this server.', ColorBad)
    else
      Say(ID, 'The radar is only for the Steam ids in [Radar] SteamIds (admins too with AdminsFull = 1, everybody ' +
        'with Public = 1).', ColorBad);
    Exit;
  end;
  W := LowerCase(FirstWord(Args));
  Rest := AfterFirstWord(Args);
  { shortcuts: !radar circle = !radar mode circle, !radar scale = !radar size }
  if RadarModeOf(W) >= 0 then
  begin
    Rest := W;
    W := 'mode';
  end
  else if W = 'scale' then
    W := 'size';
  Modes := ModesText(RadarModes(ID));
  if (W = '') or (W = 'on') or (W = 'off') then
  begin
    if W = '' then
      NewOn := not OldOn
    else
      NewOn := W = 'on';
    DefOn := OvlPublicOn;
    if OvlAllowed[ID] then
      DefOn := OvlDefaultOn;
    if NewOn = DefOn then
      RdPOn[ID] := PREF_DEFAULT
    else if NewOn then
      RdPOn[ID] := PREF_ON
    else
      RdPOn[ID] := PREF_OFF;
    RadarApplyOn(ID);
    if not OvlOn[ID] then
    begin
      if RadarEditing(ID) then
        EditorStop(ID, False);
      OverlayHide(ID);
    end;
    RadarDirty(ID);
    OverlayRecount();
    PrefsSave(ID);
    Say(ID, 'Radar ' + BoolText(OvlOn[ID]) + ' (' + RadarModeName(RadarMode(ID)) + '). More: ' + Cmd + ' help',
      ColorGood);
  end
  else if W = 'mode' then
  begin
    M := RadarModeOf(Rest);
    if M < 0 then
    begin
      Say(ID, 'Radar mode now: ' + RadarModeName(RadarMode(ID)) + '. Use: ' + Cmd + ' mode ' + ReplaceAll(Modes, ', ', '|'),
        ColorGood);
      Exit;
    end;
    if not RadarModeOk(ID, M) then
    begin
      Say(ID, 'On this server your radar has: ' + Modes + '.', ColorBad);
      Exit;
    end;
    if RadarEditing(ID) then
      EditorStop(ID, True);
    if M = RadarDefMode(ID) then
      RdPMode[ID] := 0
    else
      RdPMode[ID] := M + 1;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Radar mode ' + RadarModeName(M) + '.', ColorGood);
    if not OvlOn[ID] then
      Say(ID, 'The radar is off: ' + Cmd + ' switches it on.', ColorGood);
  end
  else if (W = 'tick') or (W = 'ticks') then
  begin
    N := StrToIntDef(Rest, -1);
    if N < 0 then
    begin
      Say(ID, 'The radar is updated every ' + IntToStr(RadarTicks(ID)) + ' ticks (60 = 1 second). Use: ' + Cmd +
        ' tick <n>, 0 = the server setting.', ColorGood);
      Exit;
    end;
    if N > 600 then
      N := 600;
    if N > 0 then
      if N < RadarMinTicks(ID) then
      begin
        N := RadarMinTicks(ID);
        Say(ID, 'Not faster than every ' + IntToStr(N) + ' ticks on this server.', ColorBad);
      end;
    RdMTicks[ID][RadarMode(ID)] := N;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'The radar (' + RadarModeName(RadarMode(ID)) + ') is updated every ' + IntToStr(RadarTicks(ID)) +
      ' ticks.', ColorGood);
  end
  else if W = 'zoom' then
  begin
    V := ParseFloat(Rest, Ok);
    if not Ok then
    begin
      Say(ID, 'The radar reaches ' + IntToStr(Round(RadarRange(ID))) + ' pixels (zoom ' + FloatStr(RadarZoom(ID), 2) +
        '). Use: ' + Cmd + ' zoom <0.5-4> - more reaches further (each mode has its own).', ColorGood);
      Exit;
    end;
    if V < 0.5 then
      V := 0.5;
    if V > 4 then
      V := 4;
    RdMZoom[ID][RadarMode(ID)] := V;
    if Abs(V - 1) < 0.001 then
      RdMZoom[ID][RadarMode(ID)] := 0;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Radar (' + RadarModeName(RadarMode(ID)) + ') zoom ' + FloatStr(RadarZoom(ID), 2) + ': it reaches ' +
      IntToStr(Round(RadarRange(ID))) + ' pixels.', ColorGood);
    if RadarZoom(ID) < V - 0.001 then
      Say(ID, 'A public radar reaches at most ' + FloatStr(OvlPublicMaxZoom, 2) + ' x its range here.', ColorBad);
  end
  else if W = 'show' then
  begin
    M := ShowOf(Rest);
    if M < 0 then
    begin
      Say(ID, 'The radar shows: ' + ShowName(RadarShowOf(ID)) + '. Use: ' + Cmd + ' show all|seen|seenall|seenreal|' +
        'seenallreal', ColorGood);
      Say(ID, 'seen = the enemies you or a living team mate can see (on a realistic server: in front, no wall ' +
        'between; otherwise: on the screen), seenall = dead team mates count too, seenreal / seenallreal = always ' +
        'in front with no wall between.', ColorGood);
      Exit;
    end;
    if not OvlAllowed[ID] then
      if not ShowWithin(M, OvlPublicShow) then
      begin
        Say(ID, 'On this server the radar shows at most: ' + ShowName(OvlPublicShow) + '.', ColorBad);
        Exit;
      end;
    RdPShow[ID] := M + 1;
    if OvlAllowed[ID] then
    begin
      if M = OvlShow then
        RdPShow[ID] := 0;
    end
    else if M = OvlPublicShow then
      RdPShow[ID] := 0;
    RadarDirty(ID);
    OverlayRecount();
    PrefsSave(ID);
    Say(ID, 'The radar shows: ' + ShowName(RadarShowOf(ID)) + '.', ColorGood);
  end
  else if (W = 'team') or (W = 'friends') or (W = 'mates') then
  begin
    W := LowerCase(Trim(Rest));
    if (W = 'on') or (W = '1') then
      RdPTeam[ID] := PREF_ON
    else if (W = 'off') or (W = '0') then
      RdPTeam[ID] := PREF_OFF
    else if W = 'default' then
      RdPTeam[ID] := PREF_DEFAULT
    else
    begin
      Say(ID, 'Team mates on the radar: ' + BoolText(RadarTeamOf(ID)) + '. Use: ' + Cmd + ' team on|off|default',
        ColorGood);
      Exit;
    end;
    if (RdPTeam[ID] = PREF_ON) and OvlShowTeam then
      RdPTeam[ID] := PREF_DEFAULT;
    if (RdPTeam[ID] = PREF_OFF) and (not OvlShowTeam) then
      RdPTeam[ID] := PREF_DEFAULT;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Team mates on the radar: ' + BoolText(RadarTeamOf(ID)) + '.', ColorGood);
  end
  else if (W = 'outline') or (W = 'map') then
  begin
    if not OvlOutline then
    begin
      Say(ID, 'The map outline is switched off on this server.', ColorBad);
      Exit;
    end;
    W := LowerCase(Trim(Rest));
    if (W = 'on') or (W = '1') then
      RdPOutline[ID] := PREF_ON
    else if (W = 'off') or (W = '0') then
      RdPOutline[ID] := PREF_OFF
    else if W = 'default' then
      RdPOutline[ID] := PREF_DEFAULT
    else if W = '' then
    begin
      if RadarOutlineOf(ID) then
        RdPOutline[ID] := PREF_OFF
      else
        RdPOutline[ID] := PREF_ON;
    end
    else
    begin
      Say(ID, 'Use: ' + Cmd + ' outline on|off|default - a few dots of the walls around you in the circle', ColorBad);
      Exit;
    end;
    if (RdPOutline[ID] = PREF_ON) and OvlOutlineOn then
      RdPOutline[ID] := PREF_DEFAULT;
    if (RdPOutline[ID] = PREF_OFF) and (not OvlOutlineOn) then
      RdPOutline[ID] := PREF_DEFAULT;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Map outline in the circle: ' + BoolText(RadarOutlineOf(ID)) + '.', ColorGood);
    if RadarMode(ID) <> OVL_CIRCLE then
      Say(ID, 'It shows in the circle mode (' + Cmd + ' circle).', ColorGood);
  end
  else if W = 'edit' then
  begin
    if TeamOf[ID] = TEAM_SPECTATOR then
      Say(ID, 'The editor works only while you play.', ColorBad)
    else
      EditorStart(ID, ED_RADAR);
  end
  else if (W = 'done') or (W = 'save') then
  begin
    if RadarEditing(ID) then
      EditorStop(ID, True)
    else
      Say(ID, 'The radar editor is not open (' + Cmd + ' edit).', ColorBad);
  end
  else if (W = 'pos') or (W = 'position') then
  begin
    X := StrToIntDef(FirstWord(Rest), -1);
    Y := StrToIntDef(AfterFirstWord(Rest), -1);
    if (X < 0) or (Y < 0) or (X > 854) or (Y > 480) then
    begin
      Say(ID, 'Use: ' + Cmd + ' pos <x 0-854> <y 0-480> (the top-left corner; keep x below 600 to be seen on every screen)',
        ColorBad);
      Exit;
    end;
    M := RadarMode(ID);
    if (M <> OVL_LIST) and (M <> OVL_CIRCLE) then
    begin
      Say(ID, 'Only the list and the circle have a place on the screen.', ColorBad);
      Exit;
    end;
    RdMX[ID][M] := X;
    RdMY[ID][M] := Y;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Radar (' + RadarModeName(M) + ') position ' + IntToStr(X) + ' ' + IntToStr(Y) + '.', ColorGood);
  end
  else if W = 'size' then
  begin
    V := ParseFloat(Rest, Ok);
    if not Ok then
    begin
      Say(ID, 'Use: ' + Cmd + ' size <0.3-4> (1 = the server setting)', ColorBad);
      Exit;
    end;
    if V < 0.3 then
      V := 0.3;
    if V > 4 then
      V := 4;
    M := RadarMode(ID);
    RdMSize[ID][M] := V;
    if Abs(V - 1) < 0.001 then
      RdMSize[ID][M] := 0;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Radar (' + RadarModeName(M) + ') size ' + FloatStr(V, 2) + '.', ColorGood);
  end
  else if (W = 'marks') or (W = 'edge') then
  begin
    V := ParseFloat(Rest, Ok);
    if not Ok then
    begin
      if W = 'marks' then
        Say(ID, 'Circle marks x' + FloatStr(RadarMarksOf(ID), 2) + '. Use: ' + Cmd + ' marks <0.3-3> - the size of the ' +
          'players'' marks in the circle (1 = normal)', ColorGood)
      else
        Say(ID, 'Circle edge x' + FloatStr(RadarEdgeOf(ID), 2) + '. Use: ' + Cmd + ' edge <0.3-3> - the size of the ' +
          'dots on the edge of the circle (1.2 = 20% bigger)', ColorGood);
      Exit;
    end;
    if V < 0.3 then
      V := 0.3;
    if V > 3 then
      V := 3;
    if W = 'marks' then
    begin
      RdPMarks[ID] := V;
      if Abs(V - 1) < 0.001 then
        RdPMarks[ID] := 0;
    end
    else
    begin
      RdPEdge[ID] := V;
      if Abs(V - OvlEdgeScale) < 0.001 then
        RdPEdge[ID] := 0;
    end;
    RadarDirty(ID);
    PrefsSave(ID);
    Say(ID, 'Circle ' + W + ' x' + FloatStr(V, 2) + '.', ColorGood);
  end
  else if W = 'reset' then
  begin
    if RadarEditing(ID) then
      EditorStop(ID, False);
    RadarPrefsClear(ID);
    RadarApplyOn(ID);
    RadarDirty(ID);
    OverlayRecount();
    PrefsSave(ID);
    Say(ID, 'Radar: the server settings again.', ColorGood);
  end
  else
  begin
    Say(ID, Cmd + ' - on/off; ' + Cmd + ' mode ' + ReplaceAll(Modes, ', ', '|') + ' (or just ' + Cmd + ' circle); ' +
      Cmd + ' reset', ColorGood);
    Say(ID, Cmd + ' tick <n> - update every n ticks (60 = 1 s); ' + Cmd + ' edit - move and resize it with the keys',
      ColorGood);
    Say(ID, Cmd + ' pos <x> <y>; ' + Cmd + ' size <n> (labels: the letters, ring: the dots); ' + Cmd +
      ' zoom <n> - reach further', ColorGood);
    if RadarModeOk(ID, OVL_CIRCLE) then
      Say(ID, Cmd + ' marks <n>, ' + Cmd + ' edge <n> - the players'' marks and the edge dots of the circle (a bigger ' +
        'size with smaller marks = a finer circle)', ColorGood);
    Say(ID, Cmd + ' show all|seen|seenall|seenreal|seenallreal - only the players you or your team can see; ' + Cmd +
      ' team on|off - team mates too', ColorGood);
    if OvlOutline then
      if RadarModeOk(ID, OVL_CIRCLE) then
        Say(ID, Cmd + ' outline on|off - a simple outline of the walls in the circle', ColorGood);
    Say(ID, 'The place, the size, the zoom and the update rate are kept for each mode.', ColorGood);
  end;
end;

procedure CmdTele(ID: Integer; Console: Boolean; Mode: Integer; Args: string);
var
  K, Name, W: string;
  Vari: Integer;
begin
  if Console then
  begin
    Say(ID, 'The teleport is for admins in the game.', ColorBad);
    Exit;
  end;
  if not BeOk then
  begin
    Say(ID, 'The teleport needs basicext_dll, which is not running.', ColorBad);
    Exit;
  end;
  W := LowerCase(Trim(Args));
  Vari := TpVariant[ID];
  if W <> '' then
  begin
    if (W = 'inherit') or (W = 'accel') or (W = 'i') then
      Vari := TP_VAR_INHERIT
    else if (W = 'fixed') or (W = 'f') then
      Vari := TP_VAR_FIXED
    else
    begin
      Say(ID, 'Use: /teletomouse [inherit|fixed] - inherit = the longer you hold, the faster you fly.', ColorBad);
      Exit;
    end;
  end;
  if TpOn[ID] and (TpMode[ID] = Mode) and ((W = '') or (Vari = TpVariant[ID])) then
  begin
    TpOn[ID] := False;
    TpMode[ID] := TP_OFF;
    TpCount := TpCount - 1;
    if TpCount < 0 then
      TpCount := 0;
    BE_MoveReset(ID);
    Say(ID, 'Teleport off.', ColorGood);
    Exit;
  end;
  if not TpOn[ID] then
    TpCount := TpCount + 1;
  TpOn[ID] := True;
  TpMode[ID] := Mode;
  TpVariant[ID] := Vari;
  BE_MoveReset(ID);
  K := 'reload';
  if TpKey = TK_GRENADE then
    K := 'grenade'
  else if TpKey = TK_THROW then
    K := 'throw weapon'
  else if TpKey = TK_CHANGE then
    K := 'change weapon';
  if Mode = TP_MOMENTUM then
  begin
    Name := 'tap ' + K + ' = jump to your cursor and keep flying that way; hold it = fly where the cursor points ' +
      '(turning round too), jumping towards it';
    if Vari = TP_VAR_INHERIT then
      Name := Name + ', faster the longer you hold (up to ' + FloatStr(TpVmax, 1) + ')'
    else
      Name := Name + ', the speed by the cursor distance';
    Say(ID, 'Teleport on: ' + Name + '. The same command switches it off.', ColorGood);
    Exit;
  end;
  if Mode = TP_FLY then
    Name := 'you fly towards your cursor while you hold it (faster when it is further, you hover when it is on you)'
  else
    Name := 'you jump to your cursor and stop there';
  Say(ID, 'Teleport on: press ' + K + ' and ' + Name + '. The same command switches it off.', ColorGood);
end;

{ ---- admin commands on one player ---- }

function TakeArg(var S: string): string;
var
  p: Integer;
begin
  S := Trim(S);
  Result := '';
  if S = '' then
    Exit;
  if S[1] = '"' then
  begin
    Delete(S, 1, 1);
    p := Pos('"', S);
    if p = 0 then
    begin
      Result := S;
      S := '';
    end
    else
    begin
      Result := Copy(S, 1, p - 1);
      Delete(S, 1, p);
      S := Trim(S);
    end;
    Exit;
  end;
  p := Pos(' ', S);
  if p = 0 then
  begin
    Result := S;
    S := '';
  end
  else
  begin
    Result := Copy(S, 1, p - 1);
    S := Trim(Copy(S, p + 1, Length(S)));
  end;
end;

function TeamWord(W: string): Integer;
begin
  Result := -1;
  if (W = 'alpha') or (W = 'red') then
    Result := 1
  else if (W = 'bravo') or (W = 'blue') then
    Result := 2
  else if (W = 'charlie') or (W = 'yellow') then
    Result := 3
  else if (W = 'delta') or (W = 'green') then
    Result := 4
  else if (W = 'spec') or (W = 'specs') or (W = 'spectators') then
    Result := TEAM_SPECTATOR;
end;

function PickTargets(ID: Integer; W: string; SelfOk, AliveOnly, Harmful: Boolean): Boolean;
var
  i, n, Tm, Hits: Integer;
  L, Names: string;
  Ok: Boolean;
begin
  TgtCount := 0;
  TgtMany := False;
  Result := False;
  L := LowerCase(Trim(W));
  if L = '' then
  begin
    if SelfOk and (ID >= 1) then
      L := 'me'
    else
    begin
      Say(ID, 'Name a player: id, name (part of it, "in quotes" with spaces), me, all, others, ' +
        'alpha/bravo/charlie/delta/spec, bots or humans.', ColorBad);
      Exit;
    end;
  end;
  Tm := TeamWord(L);
  if (L = 'all') or (L = '*') or (L = 'others') or (L = 'bots') or (L = 'humans') or (Tm >= 0) then
  begin
    TgtMany := True;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
      begin
        Ok := True;
        if L = 'others' then
          Ok := i <> ID
        else if (L = 'all') or (L = '*') then
          Ok := (i <> ID) or (not Harmful)
        else if L = 'bots' then
          Ok := not HumanOf[i]
        else if L = 'humans' then
          Ok := HumanOf[i]
        else
          Ok := TeamOf[i] = Tm;
        if Ok then
          if AliveOnly then
            Ok := PL[i].Alive;
        if Ok then
        begin
          TgtList[TgtCount] := i;
          TgtCount := TgtCount + 1;
        end;
      end;
    Result := TgtCount > 0;
    if not Result then
      Say(ID, 'Nobody matches "' + W + '"' + iif(AliveOnly, ' (alive)', '') + '.', ColorBad);
    Exit;
  end;
  n := 0;
  if L = 'me' then
  begin
    if ID < 1 then
    begin
      Say(ID, 'The console is not a player: name one.', ColorBad);
      Exit;
    end;
    n := ID;
  end
  else
  begin
    n := StrToIntDef(L, 0);
    if n <> 0 then
    begin
      if (n < 1) or (n > 32) then
        n := 0
      else if not ActiveSlot[n] then
        n := 0;
    end
    else
    begin
      for i := 1 to TopSlot do
        if n = 0 then
          if ActiveSlot[i] then
            if LowerCase(PL[i].Name) = L then
              n := i;
      if n = 0 then
      begin
        Hits := 0;
        Names := '';
        for i := 1 to TopSlot do
          if ActiveSlot[i] then
            if Pos(L, LowerCase(PL[i].Name)) > 0 then
            begin
              Hits := Hits + 1;
              n := i;
              if Names <> '' then
                Names := Names + ', ';
              Names := Names + PL[i].Name + ' (' + IntToStr(i) + ')';
            end;
        if Hits > 1 then
        begin
          Say(ID, '"' + W + '" matches ' + IntToStr(Hits) + ' players: ' + Names + '. Use the id.', ColorBad);
          Exit;
        end;
      end;
    end;
  end;
  if n = 0 then
  begin
    Say(ID, 'Player not found (' + W + ')', ColorBad);
    Exit;
  end;
  if AliveOnly then
    if not PL[n].Alive then
    begin
      Say(ID, PL[n].Name + ' is dead.', ColorBad);
      Exit;
    end;
  TgtList[0] := n;
  TgtCount := 1;
  Result := True;
end;

function TgtDesc(): string;
begin
  if TgtMany or (TgtCount <> 1) then
    Result := IntToStr(TgtCount) + ' players'
  else
    Result := PL[TgtList[0]].Name;
end;

function OnOffWord(W: string; Current: Boolean): Boolean;
begin
  W := LowerCase(W);
  if (W = 'on') or (W = '1') or (W = 'yes') then
    Result := True
  else if (W = 'off') or (W = '0') or (W = 'no') then
    Result := False
  else
    Result := not Current;
end;

procedure CmdExplode(ID: Integer; Args: string; Kind: Integer);
var
  k, K2: Integer;
  W, Rest: string;
begin
  Rest := Args;
  W := TakeArg(Rest);
  K2 := Kind;
  if Rest <> '' then
  begin
    K2 := FxKindOf(Rest);
    if K2 < 0 then
    begin
      Say(ID, 'Unknown explosion "' + Rest + '". Kinds: ' + FX_KINDS + '.', ColorBad);
      Exit;
    end;
  end;
  if K2 <> FX_PLAIN then
    if not BeOk then
    begin
      Say(ID, 'This explosion needs basicext_dll, which is not running: a plain one is used.', ColorBad);
      K2 := FX_PLAIN;
    end;
  if W = '' then
  begin
    Say(ID, 'Use: /explode <player|all|others|team> [' + ReplaceAll(FX_KINDS, ', ', '|') + ']', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, W, False, True, True) then
    Exit;
  FxDropped := 0;
  for k := 0 to TgtCount - 1 do
    FxStart(TgtList[k], K2);
  Say(ID, 'Explosion (' + FxName(K2) + '): ' + TgtDesc() + '.', ColorGood);
  if FxDropped > 0 then
    Say(ID, 'The effects queue was full: some of them got less or nothing (' + IntToStr(FxDropped) +
      ' bullets left out). Fewer players at once.', ColorBad);
end;

procedure CmdTraj(ID: Integer; Args: string; Console: Boolean);
var
  T, Aud: Integer;
  W, Rest, M: string;
  CurOnly: Boolean;
begin
  if Console then
  begin
    Say(ID, 'The trajectory is drawn in the game, for an admin who is on the server.', ColorBad);
    Exit;
  end;
  if not BeOk then
  begin
    Say(ID, 'The trajectory needs basicext_dll, which is not running.', ColorBad);
    Exit;
  end;
  Rest := Trim(Args);
  W := LowerCase(Rest);
  if (W = 'off') or ((W = '') and (TrWatch[ID] > 0)) then
  begin
    TrStop(ID);
    Say(ID, 'Trajectory off.', ColorGood);
    Exit;
  end;
  if W = '' then
  begin
    if TeamOf[ID] = TEAM_SPECTATOR then
    begin
      Say(ID, 'Use: /trajectory <player> [cursor] [me|self|selfme|public] - the flight of that player''s bullets ' +
        '(cursor: only the cursor); me = only you see it, self = only that player, selfme = both, public = ' +
        'everybody; /trajectory off', ColorBad);
      Exit;
    end;
    T := ID;
    CurOnly := False;
    Aud := TA_ME;
  end
  else
  begin
    if not PickTargets(ID, TakeArg(Rest), False, False, False) then
      Exit;
    if TgtCount <> 1 then
    begin
      Say(ID, 'Name one player.', ColorBad);
      Exit;
    end;
    T := TgtList[0];
    CurOnly := False;
    Aud := TA_ME;
    M := LowerCase(Trim(TakeArg(Rest)));
    while M <> '' do
    begin
      if (M = 'cursor') or (M = 'mouse') then
        CurOnly := True
      else if M = 'me' then
        Aud := TA_ME
      else if M = 'self' then
        Aud := TA_SELF
      else if (M = 'selfme') or (M = 'meself') or (M = 'both') then
        Aud := TA_SELFME
      else if (M = 'public') or (M = 'all') then
        Aud := TA_PUBLIC
      else
      begin
        Say(ID, 'Use: /trajectory <player> [cursor] [me|self|selfme|public]', ColorBad);
        Exit;
      end;
      M := LowerCase(Trim(TakeArg(Rest)));
    end;
    if (T = ID) and (Aud = TA_SELFME) then
      Aud := TA_ME;
  end;
  if TrWatch[ID] = T then
    if (TrCursor[ID] = CurOnly) and (TrAud[ID] = Aud) then
    begin
      TrStop(ID);
      Say(ID, 'Trajectory off.', ColorGood);
      Exit;
    end;
  if TrWatch[ID] > 0 then
    TrStop(ID);
  TrWatch[ID] := T;
  TrCursor[ID] := CurOnly;
  TrAud[ID] := Aud;
  TrBullet[ID] := 0;
  TrShotAt[ID] := -1000000;
  TrAmmo[ID] := 0;
  TrDue[ID] := 0;
  TrCount := TrCount + 1;
  if CurOnly then
    Say(ID, 'Watching the cursor of ' + PL[T].Name + ' (' + TrAudName(Aud) + '). /trajectory off', ColorGood)
  else if T = ID then
    Say(ID, 'Trajectory on: where the bullets of your weapon fly (green = where they hit; ' + TrAudName(Aud) +
      '). /trajectory off', ColorGood)
  else
    Say(ID, 'Trajectory on: where the bullets of ' + PL[T].Name + ' fly (green = where they hit; ' + TrAudName(Aud) +
      '). /trajectory off', ColorGood);
end;

function AbKeyWord(K: Integer): string;
begin
  if K = AK_JET then
    Result := 'jet'
  else if K = AK_PRONE then
    Result := 'prone'
  else if K = AK_FIRE then
    Result := 'fire'
  else if K = AK_FLAG then
    Result := 'flag throw'
  else
    Result := 'crouch';
end;

function AbKeyName(): string;
begin
  Result := AbKeyWord(AbKey);
  if AbFlagKey <> AbKey then
    Result := Result + ' (' + AbKeyWord(AbFlagKey) + ' with a flag)';
end;

procedure CmdAimbot(ID: Integer; Args: string; Console: Boolean);
var
  W, M, Rest, V: string;
  N, NB: Integer;
  NewOn, Was: Boolean;
begin
  if Console then
  begin
    Say(ID, 'The aimbot is for admins in the game.', ColorBad);
    Exit;
  end;
  if not BeOk then
  begin
    Say(ID, 'The aimbot needs basicext_dll, which is not running.', ColorBad);
    Exit;
  end;
  Rest := Args;
  W := LowerCase(TakeArg(Rest));
  Was := AbOn[ID];
  NewOn := not AbOn[ID];
  if (W = 'acc') or (W = 'accuracy') or (W = 'spread') then
  begin
    V := Trim(TakeArg(Rest));
    if V <> '' then
      if V[Length(V)] = '%' then
        Delete(V, Length(V), 1);
    N := StrToIntDef(V, -1);
    if (N < 0) or (N > 100) then
    begin
      Say(ID, 'Spread of the aimbot: ' + IntToStr(AbAcc[ID]) + '% of the weapon''s own (0 = every shot exact). Use: ' +
        '/aimbot acc <0-100>', ColorGood);
      Exit;
    end;
    AbAcc[ID] := N;
    Say(ID, 'Aimbot spread ' + IntToStr(N) + '% of the weapon''s own (standing, crouching, prone, running and ' +
      'jumping count as in the game).', ColorGood);
    Exit;
  end;
  if W = 'law' then
  begin
    N := LawRuleOf(TakeArg(Rest));
    if N < 0 then
    begin
      Say(ID, 'LAW of the aimbot: ' + LawRuleName(AbLaw[ID]) + '. Use: /aimbot law game (on the ground, crouching ' +
        'or prone), ground (on the ground) or anywhere (also standing and in the air)', ColorGood);
      Exit;
    end;
    AbLaw[ID] := N;
    Say(ID, 'Aimbot LAW: ' + LawRuleName(N) + '.', ColorGood);
    Exit;
  end;
  if (W = 'extra') or (W = 'after') then
  begin
    V := Trim(TakeArg(Rest));
    if V = '' then
    begin
      Say(ID, 'Extra shots after a kill (none while another enemy is within range): ' + ShotRangeText(AbXMin[ID], AbXMax[ID]) +
        ' (random in the range). Use: /aimbot extra <n>|<min-max>|off', ColorGood);
      Exit;
    end;
    if not ShotRange(V, N, NB) then
    begin
      Say(ID, 'Use: /aimbot extra 1-5 (a random number of shots in this range, at most 50) or off', ColorBad);
      Exit;
    end;
    AbXMin[ID] := N;
    AbXMax[ID] := NB;
    Say(ID, 'Aimbot extra shots after the target: ' + ShotRangeText(AbXMin[ID], AbXMax[ID]) +
      ' (weapons that fire at least every ' + IntToStr(AbXInterval) + ' ticks).', ColorGood);
    Exit;
  end;
  if (W = 'radius') or (W = 'circle') then
  begin
    V := LowerCase(Trim(TakeArg(Rest)));
    if V = 'edit' then
    begin
      AbMode[ID] := AT_RADIUS;
      if not AbEdit[ID] then
        AbEditCount := AbEditCount + 1;
      AbEdit[ID] := True;
      AbEditR[ID] := AbRadius[ID];
      AbEditUntil[ID] := After(Game.TickCount, AbEditSecs * 60);
      AbEditDue[ID] := 0;
      Say(ID, 'Radius editor: the circle around your cursor (only you see it). Hold Reload = bigger, Change weapon ' +
        '= smaller, or /aimbot radius <px>. /aimbot radius save (or cancel).', ColorGood);
      Exit;
    end;
    if (V = 'save') or (V = 'done') or (V = 'cancel') then
    begin
      if AbEdit[ID] then
        AbEditStop(ID, V <> 'cancel')
      else
        Say(ID, 'The radius editor is not open (/aimbot radius edit).', ColorBad);
      Exit;
    end;
    if V <> '' then
    begin
      N := StrToIntDef(V, -1);
      if (N < 10) or (N > 2000) then
      begin
        Say(ID, 'Use: /aimbot radius <10-2000>|edit|save|cancel - only enemies this many pixels from your cursor',
          ColorBad);
        Exit;
      end;
      if AbEdit[ID] then
      begin
        AbEditR[ID] := N;
        AbEditDue[ID] := 0;
        Say(ID, 'Radius ' + IntToStr(N) + ' pixels (not saved yet: /aimbot radius save).', ColorGood);
        Exit;
      end;
      AbRadius[ID] := N;
    end;
    AbMode[ID] := AT_RADIUS;
    if not AbOn[ID] then
    begin
      AbOn[ID] := True;
      AbCount := AbCount + 1;
      AbHeld[ID] := False;
      AbAmmoW[ID] := -1;
      AcAmmoTouched(ID);
      BE_GunReset(ID);
    end;
    Say(ID, 'Aimbot on: only enemies within ' + IntToStr(Round(AbRadius[ID])) + ' pixels of your cursor (nearest to ' +
      'it first); it does not jump to anybody else. Hold ' + AbKeyName() + '.', ColorGood);
    Exit;
  end;
  if (W = 'colliders') or (W = 'collider') then
  begin
    V := LowerCase(TakeArg(Rest));
    if (V = 'on') or (V = '1') then
      AbCol[ID] := True
    else if (V = 'off') or (V = '0') then
      AbCol[ID] := False
    else
      AbCol[ID] := not AbCol[ID];
    if AbCol[ID] then
      Say(ID, 'Aimbot colliders on: it does not shoot at players behind a collider (the red circle that stops ' +
        'bullets and sets off grenades).', ColorGood)
    else
      Say(ID, 'Aimbot colliders off: colliders are not checked.', ColorGood);
    Exit;
  end;
  if W = 'on' then
    NewOn := True
  else if W = 'off' then
    NewOn := False
  else if (W = 'nearest') or (W = 'near') then
  begin
    AbMode[ID] := AT_NEAREST;
    NewOn := True;
  end
  else if (W = 'cursor') or (W = 'aim') then
  begin
    AbMode[ID] := AT_CURSOR;
    NewOn := True;
  end
  else if W <> '' then
  begin
    Say(ID, 'Use: /aimbot [on|off|cursor|radius [px]|nearest|acc <0-100>|extra <min-max>|law <game|ground|anywhere>|' +
      'colliders <on|off>]', ColorBad);
    Exit;
  end;
  if NewOn and not Was then
  begin
    AbCount := AbCount + 1;
    if (W <> 'nearest') and (W <> 'near') and (W <> 'cursor') and (W <> 'aim') then
      AbMode[ID] := AbTarget;
  end
  else if Was and not NewOn then
    AbCount := AbCount - 1;
  AbOn[ID] := NewOn;
  AbHeld[ID] := False;
  AbAmmoW[ID] := -1;
  AcAmmoTouched(ID);
  AbManualAt[ID] := -1000000;
  BE_GunReset(ID);
  if not NewOn then
  begin
    Say(ID, 'Aimbot off.', ColorGood);
    Exit;
  end;
  M := 'the enemy nearest to your cursor';
  if AbMode[ID] = AT_NEAREST then
    M := 'the nearest enemy'
  else if AbMode[ID] = AT_RADIUS then
    M := 'enemies within ' + IntToStr(Round(AbRadius[ID])) + ' pixels of your cursor';
  Say(ID, 'Aimbot on: hold ' + AbKeyName() + ' and your weapon fires at ' + M + ', spread ' + IntToStr(AbAcc[ID]) +
    '% (/aimbot acc <n>), LAW ' + LawRuleName(AbLaw[ID]) + ', colliders ' + BoolText(AbCol[ID]) +
    '. It uses your ammo; the game reloads the weapon.', ColorGood);
  if (AbKey = AK_FIRE) or (AbFlagKey = AK_FIRE) then
    Say(ID, 'Your own bullets do no damage while it is on: only its shots hit.', ColorGood)
  else
    Say(ID, 'It waits while you shoot yourself, so the ammo count stays right.', ColorGood);
end;

