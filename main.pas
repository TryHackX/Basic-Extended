begin
  Result := '';
  if MnActive then
    if MnHudOn then
      if P.Alive then
        if HumanOf[ID] or DebugBots then
          if MnHave[ID] + MnHaveC[ID] > 0 then
            Result := MnFill(MnHudText, ID, 0, 0, '', '');
end;

{ [Bleeding] the line of his blood: its text - the tokens blood (percent), wound (HudWound while a wound bleeds: every
  place that bleeds with its worst wound and how many there are), rate (the blood he loses a second), bandage
  (percent), kits; empty = not shown now (HudShow = auto: only while he bleeds or has lost blood) }
function BdHudTextOf(ID: Integer): string;
var
  W, L, Part, Nm, KN: string;
  Code, Rate, Left, p, C, Kd: Integer;
begin
  Result := '';
  if BdHudShowWhen = 0 then
    if BdWounds[ID] <= 0 then
      if BdBlood[ID] >= 100 then
        Exit;
  W := '';
  Rate := 0;
  Left := -1;
  if BdWounds[ID] > 0 then
  begin
    Code := 0;
    L := '';
    if BeOk then
    begin
      Code := BE_BodyPlaces(ID, Rate, Left);
      { round 26: the list made by the library in one call }
      L := BE_BodyWoundList(ID);
      Code := 0;
    end;
    for p := 0 to 3 do
    begin
      C := (Code shr (p * 8)) and 15;
      if C > 0 then
      begin
        Kd := (Code shr (p * 8 + 4)) and 3;
        if p = 0 then
          Nm := BdPlaceHead
        else if p = 1 then
          Nm := BdPlaceTorso
        else if p = 2 then
          Nm := BdPlaceLegs
        else
          Nm := BdPlaceBlast;
        if Kd = 3 then
          KN := BdNameArtery
        else if Kd = 2 then
          KN := BdNameHeavy
        else
          KN := BdNameGraze;
        Part := ReplaceAll(ReplaceAll(ReplaceAll(BdHudPart, '{place}', Nm), '{kind}', KN), '{count}', IntToStr(C));
        if C > 1 then
          Part := ReplaceAll(Part, '{many}', ' ' + ReplaceAll(BdHudMany, '{count}', IntToStr(C)))
        else
          Part := ReplaceAll(Part, '{many}', '');
        if L <> '' then
          L := L + ', ';
        L := L + Part;
      end;
    end;
    { without the library: the worst wound }
    if L = '' then
    begin
      if BdWorst[ID] = 3 then
        L := BdNameArtery
      else if BdWorst[ID] = 2 then
        L := BdNameHeavy
      else
        L := BdNameGraze;
    end;
    W := ' ' + ReplaceAll(BdHudWound, '{list}', L);
  end;
  Result := BE_Fill(BdHudText, '{blood}'#1 + IntToStr(BdBlood[ID]) + #1'{wound}'#1 + W + #1'{bandage}'#1 +
    IntToStr(BdBand[ID]) + #1'{kits}'#1 + IntToStr(BdKits[ID]) + #1'{rate}'#1 + FloatStr(Rate / 100.0, 1));
end;

{ [Bleeding] Hud: the line of his blood and its colour (HudBleedColor while a wound bleeds; '' = no line) }
function BdHudWant(ID: Integer; P: TActivePlayer; var C: Longint): string;
begin
  Result := '';
  C := BdHudColor;
  if BdActive then
    if BdHudOn then
      if P.Alive then
        if HumanOf[ID] or DebugBots then
          Result := BdHudTextOf(ID);
  if BdWounds[ID] > 0 then
    C := BdHudBadColor;
end;

