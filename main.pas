procedure OnKitEv(Player: TActivePlayer; Kit: TActiveMapObject);
var
  k: Integer;
begin
  { [Classes]: a healthpack or a grenade kit of a class - its owner's points; the server put it back at a spawn
    point of its kind: it goes (a class's kit is no map kit) }
  if ClsObjN > 0 then
    if ClsKitTaken(Player.ID, Kit.ID) then
      if Kit.Active then
        Kit.Kill;
  if FnEnabled then
    if Kit.Style = OBJECT_GRENADEKIT then
      FnKitGive(Player.ID);
  if KitsAny then
    if Kit.Active then
    begin
      k := Kit.Style;
      if (k >= 0) and (k <= 31) then
        if KitObj[k] then
        begin
          Kit.Kill;
          StatKits := StatKits + 1;
        end;
    end;
  { [Bleeding]: a health kit closes every wound }
  if BdActive then
    if Kit.Style = OBJECT_MEDKIT then
      BE_BodyHeal(Player.ID, BC_KIT, 30);
  HudMark(Player.ID, False);
end;

procedure SetupPlayer(ID: Integer);
var
  i: Integer;
begin
  { D12: a dummy left over in the slot (the game never clears it) }
  if FnBotDummy[ID] or LfBotDummy[ID] then
    PL[ID].Dummy := False;
  SteamId[ID] := ReadSteam(ID);
  PrefsLoad(ID);
  ResetLife(ID);
  TeamOf[ID] := PL[ID].Team;
  OppTold[ID] := False;
  if BeOk then
    BE_Team(ID, TeamOf[ID]);
  { [TeamKill]: his record by his key }
  FfLoad(ID);
  { C18: the respawn before the join (2.8.2) started his first life: SpawnFactor counts it }
  if PL[ID].Alive then
    FfSpawnTick[ID] := Game.TickCount;
  FfPlayerSync(ID, PL[ID].Alive);
  { [Shop], [Points]: what his life can pay out as damage (the script may start in the middle of a life) }
  ShDmgPool[ID] := MaxHealth * ShDmgLimit / 100;
  BpDmgPool[ID] := MaxHealth * BpDmgLimit / 100;
  SpecLeft[ID] := 0;
  AfIdle[ID] := 0;
  GodOn[ID] := False;
  if FrOn[ID] then
    FrCount := FrCount - 1;
  FrOn[ID] := False;
  if InfOn[ID] then
    InfCount := InfCount - 1;
  InfOn[ID] := False;
  InfLastW[ID] := WEP_NONE;
  if SpOn[ID] then
    SpCount := SpCount - 1;
  SpOn[ID] := False;
  DmOut[ID] := 1;
  DmIn[ID] := 1;
  DmRecount();
  AsCount[ID] := 0;
  SrRun[ID] := 0;
  McCount[ID] := 0;
  McLast[ID] := 0;
  SvTarget[ID] := 0;
  ServerKill[ID] := -1;
  AdminHit[ID] := -1000000;
  AcWep[ID] := -1;
  AcTold[ID] := -1000000;
  AcVoted[ID] := -1000000;
  AcSkip[ID] := -1000000;
  if BeOk then
    BE_AcReset(ID);
  RsWait[ID] := 0;
  MdWants[ID] := False;
  LgWatched[ID] := False;
  if TpOn[ID] then
    TpCount := TpCount - 1;
  TpOn[ID] := False;
  TpMode[ID] := TP_OFF;
  TpVariant[ID] := TpVariantDefault;
  if AbOn[ID] then
    AbCount := AbCount - 1;
  AbOn[ID] := False;
  AbAcc[ID] := AbSpreadPct;
  AbRadius[ID] := AbRadiusDef;
  if AbEdit[ID] then
    AbEditCount := AbEditCount - 1;
  AbEdit[ID] := False;
  AbXMin[ID] := AbXMinDef;
  AbXMax[ID] := AbXMaxDef;
  AbExtra[ID] := 0;
  AbLastT[ID] := 0;
  AbLaw[ID] := AbLawRule;
  AbCol[ID] := AbColliders;
  AbAmmoW[ID] := -1;
  AbAmmoTick[ID] := -1000000;
  AbManualAt[ID] := -1000000;
  if TrWatch[ID] > 0 then
    TrCount := TrCount - 1;
  TrWatch[ID] := 0;
  TrDue[ID] := 0;
  TrBullet[ID] := 0;
  TrCursor[ID] := False;
  TrAud[ID] := TA_ME;
  HumanOf[ID] := PL[ID].Human;
  SnapExtraTick := -1000000;
  SnapIdx[ID] := -1;
  SnapNew := SnapNew + 1;
  if BeOk then
  begin
    BE_Name(ID, PL[ID].Name);
    BE_Human(ID, BoolInt(HumanOf[ID]));
    BE_RadarReset(ID);
    BE_TrajReset(ID);
    BE_MoveReset(ID);
    BE_GunReset(ID);
    BE_VisReset(ID);
  end;
  { [FlashNades], [ExtraRocket] }
  FnFill(ID);
  FnBlindUntil[ID] := 0;
  if FnBotDummy[ID] then
  begin
    FnBotDummy[ID] := False;
    FnBotCount := FnBotCount - 1;
    if FnBotCount < 0 then
      FnBotCount := 0;
  end;
  FnBotUntil[ID] := 0;
  if FnHoldLeft[ID] > 0 then
  begin
    FnHoldLeft[ID] := 0;
    FnHoldCount := FnHoldCount - 1;
    if FnHoldCount < 0 then
      FnHoldCount := 0;
  end;
  FnKeyWas[ID] := False;
  MnSetup(ID);
  { [Mines]: the server respawned him before the join - the spawn mines of this life }
  if MnEnabled then
    if PL[ID].Alive then
      MnRespawn(ID);
  LfSetup(ID);
  AdSetup(ID);
  ShJoin(ID, Game.TickCount);
  { a bot already alive (the server respawns before the join) shops now }
  if ShActive then
    if PL[ID].Alive then
      ShBotBuy(ID);
  RkUsed[ID] := 0;
  RkNextAt[ID] := 0;
  RkLawShot[ID] := -1000000;
  RkLaunchAt[ID] := -1000000;
  RkLockOn[ID] := 0;
  RkLockSent[ID] := 0;
  RkHudHeld[ID] := False;
  RkSeeking[ID] := False;
  RkWShown[ID] := False;
  RkWSight[ID] := False;
  RkWBeepAt[ID] := 0;
  KnLeft[ID] := AmmoMax[WEP_KNIFE];
  if KnGiveAt[ID] > 0 then
    KnPending := KnPending - 1;
  KnGiveAt[ID] := 0;
  KnLastW[ID] := WEP_NONE;
  RkKeyWas[ID] := False;
  HudLowSet(ID, False);
  EdShowAt[ID] := 0;
  EdPinAt[ID] := 0;
  RdMark[ID] := 0;
  WtNext[ID] := 0;
  RdDue[ID] := 0;
  RadarDirty(ID);
  EdKind[ID] := ED_HUD;
  TrackLeft[ID] := 0;
  CallLast[ID] := 0;
  if EdOn[ID] then
    EdCount := EdCount - 1;
  EdOn[ID] := False;
  { a new game client shows nothing }
  HlReset(ID, HS_HIDDEN);
  OverlayAllow(ID);
  RadarApplyOn(ID);
  { a hit on the slot's last player that is not settled yet takes nothing from this one }
  VicLastBefore[ID] := 0;
  OutQ[ID].Clear;
  DnNext[ID] := DmgLayerFirst;
  for i := 1 to 32 do
  begin
    DnLayer[ID][i] := 0;
    DnLayer[i][ID] := 0;
    DnKillPend[ID][i] := False;
    DnKillPend[i][ID] := False;
    Dealt[i][ID] := 0;
  end;
  for i := DmgLayerFirst to DmgLayerLast do
    WtDue[ID][i] := 0;
  { [LagGuard], [SteamBan], [Teams] }
  LgdN[ID] := 0;
  LgdPos[ID] := 0;
  LgdBlocked[ID] := False;
  LgdBadSecs[ID] := 0;
  LgdGoodSecs[ID] := 0;
  LgdSrvCount[ID] := 0;
  LgdNextWarn[ID] := 0;
  SbChecked[ID] := '';
  TeJoinTick[ID] := Game.TickCount;
  InsForget(ID);
  InsVestDirty[ID] := True;
  if BeOk then
    BE_LagReset(ID);
  { [Points]: his score of this map (a rejoin); [Resupply] }
  BpSetup(ID);
  RySince[ID] := 0;
  RyNextOk[ID] := 0;
  { [Shop] ShopOnly: no free flash grenades or Javelins in the first life either (its respawn came before the join) }
  if ShActive then
    if PL[ID].Alive then
    begin
      if (ShShopOnly and 8) <> 0 then
        if FnEnabled then
        begin
          FnFlashLeft[ID] := 0;
          FnAutoType(ID);
          FnNeed[ID] := True;
        end;
      if (ShShopOnly and 4) <> 0 then
        if RkEnabled then
          RkUsed[ID] := RkRockets;
    end;
  { [Classes]: his class (rolled); alive (the server respawned him before the join): its loadout and the check of
    his weapons - after the shop's ShopOnly (the Loadout wins unless RespectShopOnly) }
  ClsJoin(ID, Game.TickCount);
end;

procedure OnJoinGameEv(Player: TActivePlayer; Team: TTeam);
var
  ID: Integer;
begin
  ID := Player.ID;
  ActiveSlot[ID] := True;
  if ID > TopSlot then
    TopSlot := ID;
  SetupPlayer(ID);
  if Player.Human then
  begin
    { a Steam id given at the join is confirmed already; otherwise OnSteamAuth brings it }
    GrantSteamAdmin(ID);
    DropStaleGrant(ID);
    if WeEnabled then
      if WeOnJoin then
        Say(ID, ReplaceAll(WeText, '{player}', Player.Name), WeColor);
    LogWatchCheck(ID);
    if FnEnabled then
      FnJoinHint(ID, Player);
    if LgEnabled then
      if LgJoins then
        LogLine(ID, Player.Name + ' joined (IP ' + Player.IP + ', Steam ' + iif(SteamId[ID] = '', 'not yet', SteamId[ID]) +
          ', HWID ' + Player.HWID + ')');
    if RsEnabled then
      ResCheck(ID, False);
  end;
  OverlayRecount();
  HudMark(ID, True);
end;

procedure LeaveRun(Player: TActivePlayer; Kicked: Boolean);
var
  ID, i, k: Integer;
begin
  ID := Player.ID;
  { leaving drops the weapon in the hands (when kicked, right after this event) }
  if AmDropT[ID] <> Game.TickCount then
  begin
    AmDropT[ID] := Game.TickCount;
    AmDropX[ID] := Player.X;
    AmDropY[ID] := Player.Y;
  end;
  AmmoLeftBehind(ID);
  if BeOk then
    if AcOn then
    begin
      BE_AcSave(ID, PChar(AcKey(ID)));
      BE_AcReset(ID);
    end;
  { [TeamKill]: his record is written; nobody decides about him any more }
  FfSave(ID);
  if BeOk then
  begin
    BE_TkPlayer(ID, 0, 0);
    BE_TkForget(ID);
  end;
  FfClear(ID);
  { [ExtraRocket]: his lock ends (its target would hear the warning on), his rockets in flight go }
  RkLockOn[ID] := 0;
  RkSeeking[ID] := False;
  for k := 0 to RK_MAX - 1 do
    if RkLive[k] then
      if RkOwner[k] = ID then
      begin
        if BeOk then
          BE_RkDrop(k);
        RkGone(k);
      end;
  { [Ammo] CombatKnife: a thrown knife that was to come back }
  if KnGiveAt[ID] > 0 then
  begin
    KnGiveAt[ID] := 0;
    KnPending := KnPending - 1;
    if KnPending < 0 then
      KnPending := 0;
  end;
  { [Mines]: his mines go with him }
  MnLeave(ID);
  LfLeave(ID);
  AdLeave(ID);
  ClsLeave(ID);
  BpLeave(ID);
  InsForget(ID);
  { [BanJournal] Names: who left (a ban of the server kicks first, the journal sees the ban a moment later) }
  UbLeftName[UbLeftNext] := PL[ID].Name;
  UbLeftIP[UbLeftNext] := PL[ID].IP;
  UbLeftHW[UbLeftNext] := PL[ID].HWID;
  UbLeftAt[UbLeftNext] := SqNow();
  UbLeftNext := (UbLeftNext + 1) mod 32;
  ShLeave(ID);
  AcWep[ID] := -1;
  if LgEnabled then
    if LgJoins then
      LogLine(ID, Player.Name + iif(Kicked, ' was kicked', ' left'));
  for i := 0 to 4 do
    if MdOf[i] = ID then
      MdOf[i] := 0;
  GodOn[ID] := False;
  if FrOn[ID] then
  begin
    FrOn[ID] := False;
    FrCount := FrCount - 1;
  end;
  if InfOn[ID] then
  begin
    InfOn[ID] := False;
    InfCount := InfCount - 1;
  end;
  if SpOn[ID] then
  begin
    SpOn[ID] := False;
    SpCount := SpCount - 1;
  end;
  DmOut[ID] := 1;
  DmIn[ID] := 1;
  DmRecount();
  RsWait[ID] := 0;
  { [FlashNades]: a bot paused by a flash, a player held }
  FnBotRelease(ID);
  if FnHoldLeft[ID] > 0 then
  begin
    FnHoldLeft[ID] := 0;
    FnHoldCount := FnHoldCount - 1;
    if FnHoldCount < 0 then
      FnHoldCount := 0;
  end;
  FnBlindUntil[ID] := 0;
  { left before a ban he was told about: the ban lists get his address and computer }
  if BanAt[ID] > 0 then
  begin
    BanAt[ID] := 0;
    BanPending := BanPending - 1;
    if BanMin[ID] > 0 then
    begin
      Game.BanLists.AddIPBan(Player.IP, BanWhy[ID], BanMin[ID] * 3600);
      if Player.HWID <> '' then
        Game.BanLists.AddHWBan(Player.HWID, BanWhy[ID], BanMin[ID] * 3600);
    end;
  end;
  if EdOn[ID] then
  begin
    EdOn[ID] := False;
    EdCount := EdCount - 1;
  end;
  { a ping measurement he asked for has nobody to report to }
  for i := 1 to TopSlot do
    if TrackAsker[i] = ID then
      TrackLeft[i] := 0;
  SpecLeft[ID] := 0;
  TrackLeft[ID] := 0;
  Hurt[ID] := False;
  Regenerating[ID] := False;
  HudDirty[ID] := False;
  HudLines[ID] := 0;
  HudLowSet(ID, False);
  if TpOn[ID] then
  begin
    TpOn[ID] := False;
    TpCount := TpCount - 1;
  end;
  TpMode[ID] := TP_OFF;
  if AbOn[ID] then
  begin
    AbOn[ID] := False;
    AbCount := AbCount - 1;
  end;
  AbAcc[ID] := AbSpreadPct;
  AbRadius[ID] := AbRadiusDef;
  if AbEdit[ID] then
    AbEditCount := AbEditCount - 1;
  AbEdit[ID] := False;
  AbXMin[ID] := AbXMinDef;
  AbXMax[ID] := AbXMaxDef;
  AbExtra[ID] := 0;
  AbLastT[ID] := 0;
  AbLaw[ID] := AbLawRule;
  AbCol[ID] := AbColliders;
  AbAmmoW[ID] := -1;
  AbAmmoTick[ID] := -1000000;
  AbManualAt[ID] := -1000000;
  TrStop(ID);
  for i := 1 to TopSlot do
    if TrWatch[i] = ID then
      if i <> ID then
        TrStop(i);
  OvlOn[ID] := False;
  OvlAllowed[ID] := False;
  if BeOk then
  begin
    BE_RadarReset(ID);
    BE_TrajReset(ID);
    BE_MoveReset(ID);
    BE_GunReset(ID);
    BE_VisReset(ID);
  end;
  { the radars: a pass soon (his marks go by themselves), not a whole new setup of every user in one tick }
  for i := 1 to TopSlot do
    if OvlAdmin[i] then
      RdDue[i] := Game.TickCount;
  for i := 1 to 32 do
    SnapIdx[i] := -1;
  OutQ[ID].Clear;
end;

{ a player leaves: the modules forget him; his slot is free whatever one of them did }
procedure OnLeaveGameEv(Player: TActivePlayer; Kicked: Boolean);
var
  ID: Integer;
begin
  ID := Player.ID;
  { D12: a bot held by a flash or by [Downed] is let go first (whatever fails later) }
  try
    FnBotRelease(ID);
    LfBotHold(ID, False);
  except
    StageError('leave');
  end;
  try
    LeaveRun(Player, Kicked);
  except
    StageError('leave');
  end;
  PrefKey[ID] := '';
  TeamOf[ID] := -1;
  try
    if BeOk then
      BE_Team(ID, -1);
    RevokeGrant(ID);
  except
    StageError('leave');
  end;
  SteamId[ID] := '';
  ActiveSlot[ID] := False;
  RecountTop();
  OverlayRecount();
end;

{ Steam confirmed a player after his join: his admin rights, the radar and his saved choices follow
  his Steam id from now on }
procedure SteamReady(ID: Integer);
var
  S: string;
begin
  S := ReadSteam(ID);
  if S = '' then
    Exit;
  if S = SteamId[ID] then
    Exit;
  SteamId[ID] := S;
  PrefsAdopt(ID);
  FfAdopt(ID);
  HudMark(ID, True);
  GrantSteamAdmin(ID);
  { [PrivateMessages]: his blocks by his Steam id; [Notes]: an admin now - the unread notes }
  PmRestore(ID);
  NtHintAt[ID] := Game.TickCount + 120;
  { [Shop]: the global account comes with the Steam id }
  ShSteam(ID);
  OverlayAllow(ID);
  RadarApplyOn(ID);
  RadarDirty(ID);
  OverlayRecount();
  LogWatchCheck(ID);
  if LgEnabled then
    if LgJoins then
      LogLine(ID, PL[ID].Name + ' Steam confirmed: ' + S);
  if RsWait[ID] > 0 then
    ResCheck(ID, True);
end;

{ Steam's answer for a player (AuthState 0 = his account is confirmed). It may come before the join;
  then the join reads the id itself. }
function OnSteamAuthEv(ID: Byte; AuthState: Byte): Byte;
var
  Slot: Integer;
begin
  Result := AuthState;
  Slot := ID;
  if (Slot < 1) or (Slot > 32) then
    Exit;
  if AuthState <> 0 then
    Exit;
  if not ActiveSlot[Slot] then
    Exit;
  try
    SteamReady(Slot);
  except
    StageError('Steam login');
  end;
end;

procedure OnJoinTeamEv(Player: TActivePlayer; Team: TTeam);
var
  ID, Want, OldTeam: Integer;
begin
  ID := Player.ID;
  OldTeam := TeamOf[ID];
  { a team change dropped the weapon in the hands (to the spectators there is no respawn) }
  AmmoLeftBehind(ID);
  { [ExtraRocket]: a team change brings the rockets back (and ends a lock) - not the ones the shop sells }
  if ShActive and ((ShShopOnly and 4) <> 0) then
    RkUsed[ID] := RkRockets
  else
    RkUsed[ID] := 0;
  RkLockOn[ID] := 0;
  { [TeamGuard]: a team the game mode does not have (a cheat or a console trick) - the player is put
    into one it has (the game runs this event again for that team) }
  if TgEnabled then
    if Team.ID <> TEAM_SPECTATOR then
    begin
      Want := TeamForMode(Team.ID);
      if Want <> Team.ID then
      begin
        Log(Player.Name + ' joined team ' + IntToStr(Team.ID) + ', which this game mode does not have: moved to team ' +
          IntToStr(Want) + '.');
        Say(ID, 'This game mode has no such team: you were moved.', ColorBad);
        { the game runs this event again for the new team inside the call: the rest is done there }
        Player.Team := Want;
        Exit;
      end;
    end;
  { [LagGuard]: a player it moved to the spectators comes back only when his connection is good (the game's own
    team menu too, not only !j) }
  if LgdEnabled then
    if LgdBlocked[ID] then
      if Team.ID <> TEAM_SPECTATOR then
      begin
        Say(ID, ReplaceAll(LgdWaitText, '{ping}', IntToStr(Player.Ping)), ColorBad);
        Player.Team := TEAM_SPECTATOR;
        Exit;
      end;
  { read back: the guard or another script may have moved the player again }
  TeamOf[ID] := Player.Team;
  { his game reset its weapon menu: BuyOnly's menu, the survival locks again (after the game's own packets) }
  if Player.Human then
    if ShBuyOnly or CyAnyLock[ID] or ClsActive or (InsActive and (InsMenu <> 0)) then
    begin
      if MenuAgainAt[ID] = 0 then
        MenuAgainAny := MenuAgainAny + 1;
      MenuAgainAt[ID] := Game.TickCount + 2;
    end;
  { [Classes]: his objects go; a class of the new team }
  ClsTeamChanged(ID, OldTeam);
  if OldTeam <> TeamOf[ID] then
  begin
    TeJoinTick[ID] := Game.TickCount;
    { [Insurgents]: maybe of the other side now }
    InsForget(ID);
    InsVestDirty[ID] := True;
  end;
  if BeOk then
    BE_Team(ID, TeamOf[ID]);
  FfPlayerSync(ID, Player.Alive);
  { [Mines]: another team - his planted ones go }
  if TeamOf[ID] <> OldTeam then
    if OldTeam >= 0 then
      MnTeamChanged(ID);
  SpecLeft[ID] := 0;
  AfIdle[ID] := 0;
  RadarDirty(ID);
  if LgEnabled then
    if LgJoins then
      LogLine(ID, Player.Name + ' joined ' + TeamName(TeamOf[ID]));
  if Team.ID = TEAM_SPECTATOR then
  begin
    Hurt[ID] := False;
    Regenerating[ID] := False;
    if DwDown[ID] then
      DwClear(ID);
    if BdShockUntil[ID] > 0 then
      BdShockEnd(ID);
    if SiEnabled then
      if Player.Human then
        if Game.NumPlayers >= SiMinPlayers then
          if not (SiIgnoreAdmins and Player.IsAdmin) then
          begin
            SpecLeft[ID] := SiSeconds;
            Say(ID, 'Remember, you cannot idle as spectator forever!', ColorGood);
            Say(ID, 'If you won''t leave or join any team,', ColorGood);
            Say(ID, 'you will be kicked per ' + IntToStr(SiSeconds div 60) + iif(SiSeconds = 60, ' minute.', ' minutes.'),
              ColorGood);
          end;
  end;
  HudMark(ID, True);
end;

{ [Mines]: a capture brings mines; [Points]: the captured flag (Team = the flag's own team) may pay a grab again }
procedure OnFlagScoreEv(Player: TActivePlayer; Flag: TActiveFlag; Team: Byte);
begin
  try
    if (Team >= 1) and (Team <= 2) then
    begin
      BpFlagPaid[Team] := False;
      BpFlagAway[Team] := False;
    end;
    if ShActive then
      ShCapture(Player.ID, Game.TickCount);
    if MnEnabled then
      MnCapture(Player.ID);
    if BpActive then
      BpEvent(Player.ID, PE_FLAGSCORE);
  except
    StageError('capture');
  end;
end;

{ [Points]: a flag taken from its base - once until it is captured or its own team returns it (CTF, Infiltration:
  Team is the flag's team; the yellow flag of HTF has no base) }
procedure OnFlagGrabEv(Player: TActivePlayer; Flag: TActiveFlag; Team: Byte; GrabbedInBase: Boolean);
begin
  try
    if (Team >= 1) and (Team <= 2) then
    begin
      BpFlagAway[Team] := True;
      if BpActive then
        if GrabbedInBase then
          if not BpFlagPaid[Team] then
          begin
            BpFlagPaid[Team] := True;
            BpEvent(Player.ID, PE_FLAGGRAB);
          end;
    end;
  except
    StageError('flag grab');
  end;
end;

{ [Points]: a flag brought back by its own team - paid when an enemy had taken it (a player could shoot his own flag
  out of the base and touch it); the grab of it may pay again }
procedure OnFlagReturnEv(Player: TActivePlayer; Flag: TActiveFlag; Team: Byte);
begin
  try
    if (Team >= 1) and (Team <= 2) then
    begin
      if BpActive then
        if BpFlagAway[Team] then
          BpEvent(Player.ID, PE_FLAGRETURN);
      BpFlagPaid[Team] := False;
      BpFlagAway[Team] := False;
    end
    else if BpActive then
      BpEvent(Player.ID, PE_FLAGRETURN);
  except
    StageError('flag return');
  end;
end;

procedure OnBeforeMapEv(NewMap: string);
var
  i: Integer;
begin
  PrevMap := Game.CurrentMap;
  MapChanging := True;
  MapChangeTick := Game.TickCount;
  SpawnsCleared := False;
  for i := 1 to TopSlot do
  begin
    Hurt[i] := False;
    Regenerating[i] := False;
    { [Ammo] SurvivalCarry: nothing kept for the new map }
    if CyKept[i] or CyAnyLock[i] or (CyPending[i] > 0) then
      CyDrop(i);
  end;
  { [Points]: the board of the map; [Classes]: the classes of the new map's first round }
  try
    BpBoard();
    ClsBeforeMap();
  except
    StageError('map change');
  end;
end;

procedure OnAfterMapEv(NewMap: string);
var
  i, j: Integer;
begin
  MapChanging := False;
  TgTick := -1;
  { the kits the scripts placed on the old map: the new map's objects in their slots are the sweep's again }
  for i := 1 to MAX_OBJECT_ID do
    ObjKeep[i] := 0;
  { realistic mode may have been switched for this map }
  Realistic := Game.Realistic;
  if Realistic then
    MaxHealth := REALISTIC_HEALTH
  else
    MaxHealth := DEFAULT_HEALTH;
  if KitsAny then
  begin
    KitSpawnsOff();
    KitSweep();
  end;
  SpawnsCleared := False;
  ScanTop := MAX_BULLET_ID;
  VicCount := 0;
  if BeOk then
    BE_AmmoGroundClear();
  for i := 1 to 32 do
  begin
    if AcOn then
      if BeOk then
        BE_AcMoved(i, Game.TickCount);
    VicPend[i] := False;
    SrRun[i] := 0;
    ResetLife(i);
    for j := 1 to 32 do
      DnLayer[i][j] := 0;
    RadarDirty(i);
  end;
  EngineConfigure();
  { [FlashNades], [ExtraRocket]: nothing of the old map is in the air; Refill = map: the rockets come back }
  FnClear();
  RkClearAll();
  RkConfigure();
  FfMapStart();
  MnMapStart();
  LfMapStart();
  AdMapStart();
  for i := 1 to 32 do
    PzUsed[i] := 0;
  if PzKeys <> nil then
    PzKeys.Clear;
  ShMapStart();
  BpMapStart();
  ClsMapStart();
  RyRefresh();
  if BeOk then
    BE_LagReset(0);
  InsMapStart();
  { [Shop]: the respawns of the map change came before the new map's wallets - the bots shop now, a BuyOnly menu
    is sent again }
  if ShActive then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if PL[i].Alive then
        begin
          if HumanOf[i] then
          begin
            if ShBuyOnly then
            begin
              ShMaskForce(i);
              ShCheckTick[i] := Game.TickCount + 3;
            end;
          end
          else
            ShBotBuy(i);
        end;
  SuMapStart();
  for i := 1 to 32 do
    RkLockOn[i] := 0;
  if RkPerMap then
    for i := 1 to 32 do
      RkUsed[i] := 0;
  if RuAfterMap then
    if RuLines.Count > 0 then
      ShowList(0, RuLines, RuColors, RuColor, 0, True);
  HudMarkAll(True);
  { extras: a new first blood, no medics, no combos }
  FbDone := False;
  TkLeft := 0;
  for i := 0 to 4 do
  begin
    MdOf[i] := 0;
    MdCool[i] := 0;
    MdGiven[i] := 0;
  end;
  for i := 1 to 32 do
  begin
    McCount[i] := 0;
    SvTarget[i] := 0;
    MdWants[i] := False;
    { a frozen player would be pulled to the old map's place }
    if FrOn[i] then
    begin
      FrOn[i] := False;
      FrCount := FrCount - 1;
      if FrCount < 0 then
        FrCount := 0;
    end;
  end;
  if LgEnabled then
    if LgMaps then
      LogLine(0, 'map ' + NewMap);
end;

procedure OnTcpEv(Ip: string; Port: Word; Text: string);
begin
  if WhoisLeft > 0 then
    if WaTcp then
      if Length(Text) >= 3 then
        if Copy(Text, 1, 1) = '[' then
          if Copy(Text, 3, 1) = ']' then
            TcpAdmins.Add(Text);
end;

function OnErrorEv(ErrorCode: TErrorType; Message, UnitName, FunctionName: string; Row, Col: Cardinal): Boolean;
var
  n: Integer;
begin
  Result := True;
  n := ErrCount(FunctionName);
  if (n <= 3) or (n mod 1000 = 0) then
    Log('script error in ' + FunctionName + ' (' + UnitName + ' ' + IntToStr(Row) + ':' + IntToStr(Col) + '; ' +
      IntToStr(n) + '): ' + Message);
end;

{ ================================ start ================================ }

procedure Startup();
var
  i: Integer;
  Dir: string;
begin
  Started := False;
  Errors := 0;
  { TeamGame and the other per-tick caches read the game from the first call: the settings below ask them }
  LastTickSeen := Game.TickCount;
  TgTick := -1;
  Dir := Script.Dir;
  if Dir <> '' then
    if (Copy(Dir, Length(Dir), 1) <> '/') and (Copy(Dir, Length(Dir), 1) <> '\') then
      Dir := Dir + '/';
  DataDir := Dir + 'data/';
  ScriptDir := Dir;
  for i := 1 to 32 do
    PL[i] := Players[i];
  for i := 1 to MAX_BULLET_ID do
    BL[i] := Map.Bullets[i];
  for i := 1 to MAX_OBJECT_ID do
    OB[i] := Map.Objects[i];
  for i := 1 to MAX_SPAWN_ID do
    SP[i] := Map.Spawns[i];
  for i := 1 to 32 do
  begin
    ActiveSlot[i] := PL[i].Active;
    EdKind[i] := ED_HUD;
    SnapIdx[i] := -1;
    SlotBit[i] := 1 shl (i - 1);
    DmOut[i] := 1;
    DmIn[i] := 1;
  end;
  RecountTop();
  CfgKeys := File.CreateStringList();
  { a sorted set: the unknown-key check looks up by halves }
  CfgKeys.Sorted := True;
  ChatWords := File.CreateStringList();
  SlashWords := File.CreateStringList();
  ClLines := File.CreateStringList();
  ClAutoLines := File.CreateStringList();
  OvlSteams := File.CreateStringList();
  AdSteams := File.CreateStringList();
  AdSteamRaw := File.CreateStringList();
  RsList := File.CreateStringList();
  LgWatch := File.CreateStringList();
  RuLines := File.CreateStringList();
  AdListLines := File.CreateStringList();
  TcpAdmins := File.CreateStringList();
  OutAll := File.CreateStringList();
  for i := 1 to 32 do
    OutQ[i] := File.CreateStringList();
  { the library: the players' store (it takes over an older data/players.txt once) and the logger }
  BeOk := False;
  i := BE_Init(PChar(DataDir), BE_API);
  if i = BE_API then
  begin
    BeOk := True;
    if BE_BridgeReady() = 1 then
      Log('bullet memory bridge active: ' + BE_BridgeInfo())
    else
      Log('bullet memory bridge not ready: aimbot kills show the weapon of the bullet style');
  end
  else if i < 0 then
  begin
    Log('basicext_dll comes from another release (API ' + IntToStr(-i) + ', main.pas needs ' + IntToStr(BE_API) +
      '): the script does NOT start. Put the library of this release next to main.pas and restart the server ' +
      '(a /recompile keeps the old library loaded).');
    WriteLn('[Basic-Extended] NOT STARTED: basicext_dll API ' + IntToStr(-i) + ', main.pas needs ' + IntToStr(BE_API) +
      ' - restart the server with the matching library.');
    Exit;
  end
  else
    Log('basicext_dll could not start: the players'' choices are not kept, the logger does not write');
  if File.Exists(DataDir + 'granted_admins.txt') then
    GrantList := File.CreateStringListFromFile(DataDir + 'granted_admins.txt')
  else
    GrantList := File.CreateStringList();
  for i := GrantList.Count - 1 downto 0 do
    if Trim(GrantList[i]) = '' then
      GrantList.Delete(i);

  Script.OnUnhandledException := @OnErrorEv;
  FnSavedMax := -1;
  LoadAll();
  FnApply();
  MnMapScan();
  LfMapStart();
  Realistic := Game.Realistic;
  if Realistic then
    MaxHealth := REALISTIC_HEALTH
  else
    MaxHealth := DEFAULT_HEALTH;
  PrevMap := Game.CurrentMap;
  MapChanging := False;
  SpawnsCleared := False;
  ScanTop := MAX_BULLET_ID;
  PendHead := 0;
  PendCount := 0;
  DnPendCount := 0;
  VicCount := 0;
  OutPending := 0;
  EdCount := 0;
  HurtCount := 0;
  WhoisLeft := 0;
  LastFlush := 0;
  StatSince := Game.TickCount;
  LastTickSeen := Game.TickCount;
  DueTip := After(Game.TickCount, TiTicks);
  DueWelcome := After(Game.TickCount, WeTicks);
  DuePing := After(Game.TickCount, SpTicks);

  { [Shop]: the wallets of this map the last stop of the script kept (a /recompile) }
  ShWalletsBack();
  { the script may be loaded in the middle of a map }
  for i := 1 to 32 do
  begin
    SeenTick[i] := -1;
    GrantedIp[i] := '';
    if PL[i].Active then
    begin
      SetupPlayer(i);
      GrantSteamAdmin(i);
    end
    else
    begin
      PrefsClear(i);
      SteamId[i] := '';
      TeamOf[i] := -1;
    end;
  end;
  for i := 1 to 32 do
    if PL[i].Active then
      if PL[i].Human then
        DropStaleGrant(i);
  { the HUD lines an earlier start of the script left on their screens are not known: each one is sent again or
    taken away by the first draw }
  for i := 1 to 32 do
    if PL[i].Active then
      if PL[i].Human then
        HlReset(i, HS_UNKNOWN);
  for i := 0 to GrantList.Count - 1 do
    Log('remote.txt holds ' + GrantList[i] + ', made admin for ' + AdSteamFile + ' earlier; it is taken out when ' +
      'that player leaves, or when somebody else joins from that address');
  if KitsAny then
  begin
    KitSpawnsOff();
    KitSweep();
  end;
  if MapsShuffle then
    ShuffleMapsList();
  { [Notes], [BanJournal]: their files are read now, not in the tick an admin comes }
  if NtEnabled then
    NtLoad();
  if UbEnabled then
    UbLoad();

  Game.OnJoin := @OnJoinGameEv;
  Game.OnLeave := @OnLeaveGameEv;
  Game.OnAdminCommand := @OnAdminCommandEv;
  Game.OnTCPMessage := @OnTcpEv;
  Game.OnSteamAuth := @OnSteamAuthEv;
  Map.OnBeforeMapChange := @OnBeforeMapEv;
  Map.OnAfterMapChange := @OnAfterMapEv;
  for i := 0 to 5 do
    Game.Teams[i].OnJoin := @OnJoinTeamEv;
  for i := 1 to 32 do
  begin
    PL[i].OnSpeak := @OnSpeakEv;
    PL[i].OnCommand := @OnCommandEv;
    PL[i].OnDamage := @OnDamageEv;
    PL[i].OnKill := @OnKillEv;
    PL[i].OnAfterRespawn := @OnRespawnEv;
    PL[i].OnKitPickup := @OnKitEv;
    PL[i].OnWeaponChange := @OnWeaponEv;
    PL[i].OnVoteKickStart := @OnVoteKickEv;
    PL[i].OnVoteMapStart := @OnVoteMapEv;
    PL[i].OnFlagScore := @OnFlagScoreEv;
    PL[i].OnFlagGrab := @OnFlagGrabEv;
    PL[i].OnFlagReturn := @OnFlagReturnEv;
  end;
  OverlayRecount();
  HudMarkAll(True);
  Game.TickThreshold := 1;
  Game.OnClockTick := @OnTick;
  Started := True;
  { like Basic 2.0.2: the players see that the script is running again after a recompile }
  if StartMessage <> '' then
    SayAll(ReplaceAll(StartMessage, '{version}', VERSION), $FFAA00);
  Log(VERSION + ' started (' + IntToStr(ChatWords.Count + SlashWords.Count) + ' command words, health ' +
    IntToStr(Round(MaxHealth)) + ').');
end;

{ the script is unloaded (/recompile, or an error it could not handle): the health texts go away and
  the admin rights it gave are taken back }
procedure CleanUp();
var
  i, k: Integer;
begin
  if not Started then
    Exit;
  Started := False;
  try
    FnRestore();
    { [Shop], [Classes]: the stationary guns and the kits of the classes would stay for good (their clocks stop) }
    for k := 0 to 15 do
      if ShStatObj[k] > 0 then
        if OB[ShStatObj[k]].Active then
          if OB[ShStatObj[k]].Style = 27 then
            OB[ShStatObj[k]].Kill;
    for k := ClsObjN - 1 downto 0 do
      ClsObjRemove(k, True);
    for i := 1 to 32 do
      if PL[i].Active then
      begin
        HlHideAll(i);
        { the weapon menu as the server has it (BuyOnly, the classes, the survival locks) }
        if PL[i].Human then
          if (ShMaskLast[i] <> -2) or CyAnyLock[i] then
            for k := 1 to 14 do
              PL[i].WeaponActive[k] := ShServerW[CyWeaponOfSlot(k)];
        { a bot held by [Bleeding] or [Downed] moves again; a downed soldier has his weapons back }
        if LfBotDummy[i] then
        begin
          LfBotDummy[i] := False;
          PL[i].Dummy := False;
        end;
        if DwDown[i] then
          if DwTookW[i] >= 0 then
            DwGiveBack(i);
        FfSave(i);
        if BeOk then
          if AcOn then
            BE_AcSave(i, PChar(AcKey(i)));
        OverlayHide(i);
        RevokeGrant(i);
      end;
  except
  end;
  { [Shop]: the accounts, this map's wallets; [AntiSpam]: the mutes }
  try
    ShCleanUp();
    if SqDirty then
      SqSave();
  except
  end;
  { the library writes what is pending and stops its thread }
  if BeOk then
  begin
    BeOk := False;
    BE_Shutdown();
  end;
end;

initialization
begin
  Startup();
end;

finalization
begin
  CleanUp();
end;

end.
