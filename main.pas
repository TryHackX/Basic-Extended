    StageError('kill');
  end;
  if ProfOn then
    BE_ProfEnd(28);
end;

{ F2-23: nobody but ID alive (a survival round's first respawn when nobody survived the last one) }
function ClsNobodyAlive(ID: Integer): Boolean;
var
  i: Integer;
begin
  Result := True;
  for i := 1 to TopSlot do
    if i <> ID then
      if ActiveSlot[i] then
        if TeamOf[i] <> TEAM_SPECTATOR then
          if PL[i].Alive then
          begin
            Result := False;
            Exit;
          end;
end;

procedure RespawnRun(Player: TActivePlayer);
var
  ID, k: Integer;
  Rallied, TeamMove: Boolean;
begin
  ID := Player.ID;
  { a team change respawns him before OnJoinTeam: TeamOf still holds the team he left }
  TeamMove := False;
  if ActiveSlot[ID] then
    if Player.Team <> TeamOf[ID] then
      TeamMove := True;
  { F13 the respawn before the join (2.8.2): the slot's last player is not used - who he is now }
  if not ActiveSlot[ID] then
  begin
    HumanOf[ID] := Player.Human;
    TeamOf[ID] := Player.Team;
  end;
  { [Shop], [Points]: what this life can pay out as damage }
  ShDmgPool[ID] := MaxHealth * ShDmgLimit / 100;
  BpDmgPool[ID] := MaxHealth * BpDmgLimit / 100;
  { [TeamKill]: a new life - the points of the old one can no longer be forgiven; slain after this
    respawn when his victim chose so (survival) }
  FfSpawnTick[ID] := Game.TickCount;
  FfPlayerSync(ID, True);
  for k := 1 to 32 do
    FfPair[k][ID] := 0;
  if FfNextRound[ID] then
  begin
    FfNextRound[ID] := False;
    FfSlayDue[ID] := After(Game.TickCount, 3);
  end;
  if AcOn then
    if BeOk then
      BE_AcMoved(ID, Game.TickCount);
  { during a map change the new map is loaded and its kits come right after the respawns: with the
    medkit spawn points switched off no kit is created at all. A respawn during the countdown (still
    the old map) must not use this up. A restart of the same map is left to OnAfterMapEv. }
  if MapChanging then
    if KitsAny then
      if not SpawnsCleared then
        if Game.CurrentMap <> PrevMap then
        begin
          SpawnsCleared := True;
          KitSpawnsOff();
        end;
  ResetLife(ID);
  { [FlashNades]: the grenades of a new life; [ExtraRocket] Refill = life: the rockets too }
  if FnEnabled then
    FnRespawn(ID);
  { [Mines]: SpawnMines, SpawnClaymores }
  if MnEnabled then
    MnRespawn(ID);
  if not RkPerMap then
    RkUsed[ID] := 0;
  RkLockOn[ID] := 0;
  RkSeeking[ID] := False;
  { [Ammo] CombatKnife: the spare knives of a new life }
  KnLeft[ID] := AmmoMax[WEP_KNIFE];
  if KnGiveAt[ID] > 0 then
  begin
    KnGiveAt[ID] := 0;
    KnPending := KnPending - 1;
  end;
  if EdOn[ID] then
    EditorStop(ID, False);
  { [Bleeding], [Downed]: full blood; the survival carry-over: a survivor's kept supplies }
  LfRespawn(ID, Game.TickCount);
  { [Classes]: a rally brings him back at the one who called it (no spawn protection then) }
  Rallied := False;
  if ClsActive then
    if ActiveSlot[ID] then
      if not TeamMove then
        Rallied := ClsRallyRespawn(ID, Game.TickCount);
  { [SpawnProtection] }
  if not Rallied then
    SfRespawn(ID, Game.TickCount);
  { [Shop]: the buy time, the round's money, ShopOnly, BuyOnly; a bot buys; [Supply]: a crate in a survival round }
  if ShActive then
  begin
    ShRespawn(ID, Game.TickCount);
    { a map change: the bots shop when the new map's wallets are there (OnAfterMapEv) }
    if not HumanOf[ID] then
      if not MapChanging then
        ShBotBuy(ID);
  end;
  if SuActive then
    if Game.Survival then
      SuRoundStart(Game.TickCount);
  { [Classes]: the class of this life, its loadout, the check of the weapons (after the shop's buys); after a team
    change OnJoinTeam does it for the new team }
  if ClsActive then
  begin
    { F2-23: a survival round that nobody survived had no round's end hit: its first respawn ends it for the classes
      (new classes with Assign = round, the skills ready) }
    if Game.Survival then
      if not TeamMove then
        if not MapChanging then
          if Game.TickCount - ClsRoundDone > 30 then
            if ClsNobodyAlive(ID) then
            begin
              ClsRoundDone := Game.TickCount;
              ClsRoundOver(0);
            end;
    if TeamMove then
      ClsTeamLife[ID] := True
    else
      ClsRespawn(ID, Game.TickCount);
  end;
  { [Insurgents]: the vest of this life }
  if InsActive then
    InsRespawn(ID, Game.TickCount);
  RySince[ID] := 0;
  HudMark(ID, True);
end;

procedure OnRespawnEv(Player: TActivePlayer);
begin
  try
    RespawnRun(Player);
  except
    StageError('respawn');
  end;
end;

procedure OnWeaponEv(Player: TActivePlayer; Primary, Secondary: TPlayerWeapon);
begin
  { nothing may change the weapons here: the server applies the new ones only after this event, and
    a ForceWeapon inside it replaces them with the old secondary }
  AcAmmoTouched(Player.ID);
  { [Shop] BuyOnly: checked in the next ticks }
  if ShBuyOnly then
    ShWeaponSeen(Player.ID, Primary.WType, Secondary.WType);
  { [Classes]: a weapon of the first 3 s of a life (a lagging player's menu): checked in the next ticks }
  if ClsActive then
    ClsWeaponSeen(Player.ID);
  if AmmoEnabled then
  begin
    { the game drops the weapon in the hands (thrown away, a death, a team change, leaving the game):
      the place is kept for the team change and leaving, which end the life without a death }
    if Primary.WType = WEP_NONE then
    begin
      AmDropT[Player.ID] := Game.TickCount;
      AmDropX[Player.ID] := Player.X;
      AmDropY[Player.ID] := Player.Y;
    end;
    HudMark(Player.ID, False);
  end;
end;

