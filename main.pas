{ a value of the server's soldat.ini (read only; Def when it has none) }
function ServerIniValue(Section, Key, Def: string): string;
var
  L: TStringList;
  i, p: Integer;
  S: string;
  InSec: Boolean;
begin
  Result := Def;
  if not File.Exists('soldat.ini') then
    Exit;
  L := nil;
  try
    L := File.CreateStringListFromFile('soldat.ini');
    InSec := False;
    for i := 0 to L.Count - 1 do
    begin
      S := Trim(L[i]);
      if Copy(S, 1, 1) = '[' then
        InSec := LowerCase(S) = '[' + LowerCase(Section) + ']'
      else if InSec then
      begin
        p := Pos('=', S);
        if p > 0 then
          if LowerCase(Trim(Copy(S, 1, p - 1))) = LowerCase(Key) then
            Result := Trim(Copy(S, p + 1, Length(S)));
      end;
    end;
  except
    Result := Def;
  end;
  if L <> nil then
    L.Free;
end;

