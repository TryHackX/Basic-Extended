{ the server's tick counter starts again from 0 after about 414 days: every time stamp starts again }
procedure ClockWrapped(Tick: Integer);
var
  i, j: Integer;
begin
  DueRegen := Tick;
  DueScan := Tick;
  DueSecond := Tick;
  DueSweep := Tick;
  DueTip := After(Tick, TiTicks);
  DueWelcome := After(Tick, WeTicks);
  DuePing := After(Tick, SpTicks);
  StatSince := Tick;
  for i := 1 to 32 do
  begin
    LastHit[i] := 0;
    LastSupp[i] := 0;
    RegenStart[i] := Tick;
    HlClockReset(i);
    CallLast[i] := 0;
    SeenTick[i] := -1;
    EdUntil[i] := Tick + HudEditorTicks;
    EdShowAt[i] := 0;
    EdPinAt[i] := 0;
    RdDue[i] := Tick;
    RadarDirty(i);
    RdRetry[i] := 0;
    RdTokTick[i] := Tick;
    TrDue[i] := Tick;
    WtNext[i] := 0;
    WtNextAll := 0;
    for j := 0 to 255 do
      WtDue[i][j] := 0;
    for j := 1 to 32 do
      DnLast[i][j] := 0;
    if BeOk then
    begin
      BE_RadarReset(i);
      BE_TrajReset(i);
      BE_MoveReset(i);
      BE_GunReset(i);
    end;
  end;
  { [FlashNades], [ExtraRocket] }
  FnClear();
  RkClearAll();
  RkDueHint := After(Tick, RkHintTicks);
  for i := 1 to 32 do
  begin
    FnRefillAt[i] := 0;
    FnNeed[i] := True;
    FnBlindUntil[i] := 0;
    if FnBotDummy[i] then
      FnBotUntil[i] := Tick;
    RkNextAt[i] := 0;
    RkLawShot[i] := -1000000;
    RkLaunchAt[i] := -1000000;
  end;
  SnapTick := -1;
  SnapExtraTick := -1000000;
  OvlNextTick := 0;
  if BeOk then
    OverlayRecount();
end;

{ the game goes on after N paused ticks: the deadlines of the modules whose clocks stood move on by them }
procedure PauseShift(N: Integer);
var
  i, k: Integer;
begin
  if BeOk then
  begin
    if BdEnabled or DwEnabled then
      BE_BodyShift(N);
    if MnEnabled then
      BE_MineShift(N);
  end;
  for i := 1 to 32 do
  begin
    if DwKilling[i] > 0 then
      DwKilling[i] := DwKilling[i] + N;
    if DwProtect[i] > 0 then
      DwProtect[i] := DwProtect[i] + N;
    if DwSince[i] > 0 then
      DwSince[i] := DwSince[i] + N;
    if DwFinAt[i] > 0 then
      DwFinAt[i] := DwFinAt[i] + N;
    if BdShockUntil[i] > 0 then
      BdShockUntil[i] := BdShockUntil[i] + N;
    for k := 0 to 4 do
      if SgUntil[i][k] > 0 then
      begin
        SgUntil[i][k] := SgUntil[i][k] + N;
        { L2-03: the radar's copy of the spot (the library) too }
        if BeOk then
          BE_SpotSet(i, k, SgUntil[i][k]);
      end;
    if RkNextAt[i] > 0 then
      RkNextAt[i] := RkNextAt[i] + N;
    { round 26: every other clock that ran through the pause - the team-kill shield, vote and decay, the regeneration's
      wait, the bounty's time, the flash refill and blindness, a Javelin lock, a mine's work, the shop's buy time
      and income }
    if FfShieldUntil[i] > 0 then
      FfShieldUntil[i] := FfShieldUntil[i] + N;
    if FfVoteUntil[i] > 0 then
      FfVoteUntil[i] := FfVoteUntil[i] + N;
    if FfRise[i] > 0 then
      FfRise[i] := FfRise[i] + N;
    if LastHit[i] > 0 then
      LastHit[i] := LastHit[i] + N;
    if RegenStart[i] > 0 then
      RegenStart[i] := RegenStart[i] + N;
    if BnSince[i] > 0 then
      BnSince[i] := BnSince[i] + N;
    if FnRefillAt[i] > 0 then
      FnRefillAt[i] := FnRefillAt[i] + N;
    if FnBlindUntil[i] > 0 then
      FnBlindUntil[i] := FnBlindUntil[i] + N;
    if FnBotUntil[i] > 0 then
      FnBotUntil[i] := FnBotUntil[i] + N;
    if RkLockDue[i] > 0 then
      RkLockDue[i] := RkLockDue[i] + N;
    if MnWorkStart[i] > 0 then
      MnWorkStart[i] := MnWorkStart[i] + N;
    if ShSpawnTick[i] > 0 then
      ShSpawnTick[i] := ShSpawnTick[i] + N;
    if ShIncomeAt[i] > 0 then
      ShIncomeAt[i] := ShIncomeAt[i] + N;
  end;
  for k := 0 to 15 do
    if ShStatEnd[k] > 0 then
      ShStatEnd[k] := ShStatEnd[k] + N;
  for k := 0 to 63 do
    if MnFuseAt[k] > 0 then
      MnFuseAt[k] := MnFuseAt[k] + N;
  for k := 1 to MAX_OBJECT_ID do
    if ObjKeep[k] > 0 then
      ObjKeep[k] := ObjKeep[k] + N;
  { [Insurgents]: a vest counting down, the time a life must last, the team's wait, the blasts under way }
  for k := 1 to 32 do
  begin
    if InsArmAt[k] > 0 then
      InsArmAt[k] := InsArmAt[k] + N;
    if InsLifeAt[k] > 0 then
      InsLifeAt[k] := InsLifeAt[k] + N;
  end;
  for k := 1 to 4 do
    if InsTeamCool[k] > 0 then
      InsTeamCool[k] := InsTeamCool[k] + N;
  for k := 0 to InsQN - 1 do
    InsQAt[k] := InsQAt[k] + N;
end;

procedure OnTick(Ticks: Integer);
var
  Tick: Integer;
  T: TDateTime;
begin
  if ProfOn then
    BE_ProfBegin(0);
  Tick := Game.TickCount;
  if Tick < LastTickSeen then
    try
      ClockWrapped(Tick);
    except
      StageError('clock');
    end;
  LastTickSeen := Tick;
  InTick := True;
  PausedNow := Game.Paused;
  { a pause: the clocks of the modules below stand; they move on by its ticks when the game goes on }
  if PausedNow then
    PauseTicks := PauseTicks + 1
  else if PauseTicks > 0 then
  begin
    try
      PauseShift(PauseTicks);
    except
      StageError('pause');
    end;
    PauseTicks := 0;
  end;
  { the bullets and weapons the hooks see from now on are in the next tick's reports }
  if HookOn then
    try
      BE_HookTick(Tick);
    except
      StageError('hooks');
    end;
  { every part on its own: an error in one of them is logged and the others still run }
  if PendCount > 0 then
    try
      if ProfOn then
        BE_ProfBegin(1);
      RunPending();
      if ProfOn then
        BE_ProfEnd(1);
    except
      StageError('commands');
    end;
  if (DnPendCount > 0) or (VicCount > 0) then
    try
      if ProfOn then
        BE_ProfBegin(2);
      DmgFlush(Tick);
      if ProfOn then
        BE_ProfEnd(2);
    except
      StageError('damage numbers');
    end;
  if EdCount > 0 then
    try
      if ProfOn then
        BE_ProfBegin(3);
      EditorTick(Tick);
      if ProfOn then
        BE_ProfEnd(3);
    except
      StageError('editor');
    end;
  if Tick >= DueRegen then
  begin
    DueRegen := After(Tick, RegStepTicks);
    if RegEnabled then
      if not MapChanging then
        if not Game.Paused then
          try
            if ProfOn then
              BE_ProfBegin(4);
            RegenPass(Tick);
            if ProfOn then
              BE_ProfEnd(4);
          except
            StageError('regeneration');
          end;
  end;
  if Tick >= DueScan then
  begin
    DueScan := After(Tick, SupScanTicks);
    if RegEnabled then
      if SupEnabled then
        if HurtCount > 0 then
          if not MapChanging then
            try
              if ProfOn then
                BE_ProfBegin(5);
              SuppressionScan(Tick);
              if ProfOn then
                BE_ProfEnd(5);
            except
              StageError('bullet scan');
            end;
  end;
  if OvlCount > 0 then
    try
      if ProfOn then
        BE_ProfBegin(6);
      OverlayTick(Tick);
      if ProfOn then
        BE_ProfEnd(6);
    except
      StageError('radar');
    end;
  if BeOk then
    if Tick mod 30 = 7 then
      try
        SkeletonBind();
      except
        StageError('skeletons');
      end;
  if FfEnabled then
    try
      FfTickRun(Tick);
    except
      StageError('team kills');
    end;
  if MnEnabled or MnHideDue then
    if not (PausedNow or MapChanging) then
    try
      if ProfOn then
        BE_ProfBegin(31);
      MnTickRun(Tick);
      if ProfOn then
        BE_ProfEnd(31);
    except
      StageError('mines');
    end;
  if BdEnabled or DwEnabled then
