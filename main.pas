{ a short word in the middle of his screen on Layer (the mines' place and size: [Mines] BigX, BigY, BigScale,
  BigSeconds); ' ' takes it away }
{ the line of a module's centre text under the mines' one (their texts do not lie on each other) }
function LfBigLine(Layer: Integer): Integer;
begin
  Result := 0;
  if Layer = BdBigLayer then
    Result := 1
  else if Layer = DwBigLayer then
    Result := 2
  else if Layer = SgBigLayer then
    Result := 3
  else if Layer = SfBigLayer then
    Result := 4
  else if Layer = SuBigLayer then
    Result := 5;
end;

procedure LfBig(ID, Layer: Integer; Text: string; Color: Longint);
begin
  if Text = '' then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not (HumanOf[ID] or DebugBots) then
    Exit;
  if Text = ' ' then
    PL[ID].BigText(Layer, ' ', 1, ColorGood, 0.01, 0, 0)
  else
    PL[ID].BigText(Layer, Text, MnBigTicks, Color, MnBigScale, MnBigX, MnBigY + LfBigLine(Layer) *
      Round(MnBigScale * 207.4 + 2));
end;

{ a short word over X, Y (OffY px higher) for ID only, centred, gone by itself Ticks later ('' takes it
  away) }
procedure LfOver(ID, Layer: Integer; Text: string; X, Y, Scale, OffY: Single; Ticks: Integer; Color: Longint);
var
  W: Single;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not (HumanOf[ID] or DebugBots) then
    Exit;
  if Text = '' then
  begin
    PL[ID].WorldText(Layer, ' ', 1, ColorGood, 0.01, 0, 0);
    Exit;
  end;
  if BeOk then
    W := BE_TextWidth(Text, Scale)
  else
    W := Length(Text) * Scale * WT_CHAR_WIDTH;
  PL[ID].WorldText(Layer, Text, Ticks, Color, Scale, X - W / 2, Y - OffY);
end;

{ the same word over X, Y for every player who may see it, its width counted once ('' takes it away); Team >= 0:
  the realistic sight rule - only that team (none for 0), the dead and the spectators }
procedure LfOverAll(Layer: Integer; Text: string; X, Y, Scale, OffY: Single; Ticks: Integer; Color: Longint;
  Team: Integer);
var
  j: Integer;
  W, TX, TY: Single;
  See: Boolean;
begin
  if Text = '' then
  begin
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if HumanOf[j] or DebugBots then
          PL[j].WorldText(Layer, ' ', 1, ColorGood, 0.01, 0, 0);
    Exit;
  end;
  if BeOk then
    W := BE_TextWidth(Text, Scale)
  else
    W := Length(Text) * Scale * WT_CHAR_WIDTH;
  TX := X - W / 2;
  TY := Y - OffY;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] or DebugBots then
      begin
        See := True;
        if Team >= 0 then
        begin
          See := TeamOf[j] = TEAM_SPECTATOR;
          if Team >= 1 then
            if TeamOf[j] = Team then
              See := True;
          if not See then
            if not PL[j].Alive then
              See := True;
        end;
        if See then
          PL[j].WorldText(Layer, Text, Ticks, Color, Scale, TX, TY);
      end;
end;

{ a bot held by this module (shock, down): its AI paused, its keys let go; a bot somebody else made a dummy
  is left alone }
procedure LfBotHold(i: Integer; On: Boolean);
begin
  if (i < 1) or (i > 32) then
    Exit;
  if On then
  begin
    if LfBotDummy[i] then
      Exit;
    if not ActiveSlot[i] then
      Exit;
    if HumanOf[i] then
      Exit;
    if PL[i].Dummy then
      if not FnBotDummy[i] then
        Exit;
    PL[i].Dummy := True;
    FnBotKeysOff(PL[i]);
    LfBotDummy[i] := True;
  end
  else if LfBotDummy[i] then
  begin
    LfBotDummy[i] := False;
    if ActiveSlot[i] then
      if not FnBotDummy[i] then
        PL[i].Dummy := False;
  end;
end;

{ the weapons of a downed soldier come back as they were taken (the magazine, the secondary's ammunition) }
procedure DwGiveBack(V: Integer);
var
  NW, NS: TNewWeapon;
begin
  if DwTookW[V] < 0 then
  begin
    DwNoneLeft[V] := 0;
    if AmmoEnabled then
      if BeOk then
        BE_AmmoPause(V, 0, Game.TickCount);
    Exit;
  end;
  if ActiveSlot[V] then
    if PL[V].Alive then
    begin
      NW := TNewWeapon.Create;
      NS := TNewWeapon.Create;
      try
        NW.WType := DwTookW[V];
        NW.Ammo := DwTookA[V];
        if DwTookSW[V] >= 0 then
        begin
          NS.WType := DwTookSW[V];
          NS.Ammo := DwTookSA[V];
        end
        else
          NS.WType := WEP_NONE;
        PL[V].ForceWeapon(NW, NS);
        AmGiven(V);
      finally
        NW.Free;
        NS.Free;
      end;
      AcAmmoTouched(V);
    end;
  DwTookW[V] := -1;
  DwNoneLeft[V] := 0;
  if AmmoEnabled then
    if BeOk then
      BE_AmmoPause(V, 0, Game.TickCount);
end;

{ V dies of what K did to him (bled out, his time down ran out, he gave up): a slow bullet of K into V's body
  with K's weapon W written by the bridge - the kill list, the kill events and ZitroStats see K and W.
  Without K (gone, himself, slot 32, no library) the server's kind of kill (no penalty) }
procedure LfKill(V, K, W, Tick: Integer);
var
  B: Integer;
  Done: Boolean;
begin
  if (V < 1) or (V > 32) then
    Exit;
  if not ActiveSlot[V] then
    Exit;
  if not PL[V].Alive then
    Exit;
  if DwKilling[V] > 0 then
    if Tick - DwKilling[V] < 4 then
      Exit;
  { his weapons back first: his death drops them as usual }
  if DwTookW[V] >= 0 then
    DwGiveBack(V);
  DwKilling[V] := Tick;
  DwKillingAny := DwKillingAny + 1;
  PL[V].Health := 1;
  LastHealth[V] := 1;
  Done := False;
  if (K >= 1) and (K <= 31) then
    if K <> V then
      if ActiveSlot[K] then
        if BeOk then
        begin
          AcSkip[K] := Tick;
          B := ScriptBullet(PL[V].X - 2, PL[V].Y - 8, 0, 2, 5, 1, PL[K]);
          if (B >= 1) and (B <= MAX_BULLET_ID) then
          begin
            DwKillB[B] := V;
            DwKillT[B] := Tick;
            if (W >= 0) and (W <= 16) then
              BE_BridgeSetWeapon(B, 1, W, 5)
            else if W = 17 then
            begin
              { a mine's: the kill list shows the blast (M79), the kill counts as the mine's }
              BE_BridgeSetWeapon(B, 1, 7, 5);
              MnBulOwner[B] := K;
              MnBulTick[B] := Tick;
              MnBulKind[B] := DwMineK[V];
              if MnBulKind[B] < 1 then
                MnBulKind[B] := 1;
            end;
            Done := True;
          end;
        end;
  if not Done then
  begin
    ServerKill[V] := Tick;
    AdminHit[V] := Tick;
    PL[V].Damage(V, 4000);
  end;
end;

{ a bullet of this module's kill (it must kill; no down, no team kill guard) }
function LfOwnBullet(B, V: Integer): Boolean;
begin
  Result := False;
  if (B >= 1) and (B <= MAX_BULLET_ID) then
    if DwKillB[B] = V then
      if Game.TickCount - DwKillT[B] <= 10 then
        Result := True;
end;

{ ---------------- [Bleeding] ---------------- }

function BdKindName(Kind: Integer): string;
begin
  if Kind = 3 then
    Result := BdNameArtery
  else if Kind = 2 then
    Result := BdNameHeavy
  else
    Result := BdNameGraze;
end;

function BdPlaceName(Part: Integer): string;
begin
  if Part = 12 then
    Result := BdPlaceHead
  else if Part = 10 then
    Result := BdPlaceTorso
  else if Part = 3 then
    Result := BdPlaceLegs
  else
    Result := BdPlaceBlast;
end;

{ the tokens of the bleeding texts: player, kind, Kind, place, bandage, kits, use, pct, blood, kit (in braces) }
function BdFill(S: string; ID, Kind: Integer; Num, Place: string): string;
var
  KN: string;
begin
  KN := BdKindName(Kind);
  Result := BE_Fill(S, '{player}'#1 + PL[ID].Name + #1'{kind}'#1 + KN + #1'{Kind}'#1 + UpperCase(Copy(KN, 1, 1)) +
    Copy(KN, 2, Length(KN)) + #1'{place}'#1 + Place + #1'{bandage}'#1 + IntToStr(BdBand[ID]) + #1'{kits}'#1 +
    IntToStr(BdKits[ID]) + #1'{use}'#1 + Num + #1'{pct}'#1 + Num + #1'{blood}'#1 + IntToStr(BdBlood[ID]) +
    #1'{kit}'#1 + BdKitWord);
end;

{ his state as the library has it (the line, the regeneration's cap) }
procedure BdSync(ID: Integer);
var
  Blood, Band: Single;
  Worst, Wounds, Kits, Work, Pct, State, R: Integer;
begin
  if not BeOk then
    Exit;
  Blood := 100;
  Band := 0;
  Worst := 0;
  Wounds := 0;
  Kits := 0;
  Work := 0;
  Pct := 0;
  State := 0;
  R := BE_BodyGet(ID, Blood, Worst, Wounds, Band, Kits, Work, Pct, State);
  if R <> 1 then
    Exit;
  BdBlood[ID] := Round(Blood);
  BdWorst[ID] := Worst;
  BdWounds[ID] := Wounds;
  BdBand[ID] := Round(Band);
  BdKits[ID] := Kits;
  HudMark(ID, False);
end;

{ shock: frozen where he is, the black screen; a bot stops }
procedure BdShock(ID, Ticks, Tick: Integer);
var
  P: TActivePlayer;
begin
  if not ActiveSlot[ID] then
    Exit;
  P := PL[ID];
  if not P.Alive then
    Exit;
  if BdShockUntil[ID] = 0 then
    BdShockCount := BdShockCount + 1;
  BdShockUntil[ID] := After(Tick, Ticks);
  BdHoldX[ID] := P.X;
  BdHoldY[ID] := P.Y;
  BdHoldAt[ID] := Tick;
  BdStatShocks := BdStatShocks + 1;
  if HumanOf[ID] or DebugBots then
  begin
    if BdShockOn then
      P.WorldText(BdShockLayer, BdShockChar, Ticks, BdShockColor, BdShockScale, P.X + BdShockX, P.Y + BdShockY);
    LfBig(ID, BdBigLayer, BdFill(BdShockText, ID, BdWorst[ID], '', ''), BdColor);
  end
  else
    LfBotHold(ID, True);
end;

procedure BdShockEnd(ID: Integer);
begin
  if BdShockUntil[ID] > 0 then
  begin
    BdShockCount := BdShockCount - 1;
    { the black screen goes with it (a death, a respawn) }
    if Game.TickCount < BdShockUntil[ID] then
      if ActiveSlot[ID] then
        if HumanOf[ID] or DebugBots then
          PL[ID].WorldText(BdShockLayer, ' ', 1, ColorGood, 0.01, 0, 0);
  end;
  if BdShockCount < 0 then
    BdShockCount := 0;
  BdShockUntil[ID] := 0;
  if not DwDown[ID] then
    LfBotHold(ID, False);
end;

{ ---------------- [Downed] ---------------- }

function DwDownHealth(): Single;
begin
  Result := MaxHealth * DwHealthPct / 100;
  if Result < 1 then
    Result := 1;
end;

{ the one who helps V up, 0 = nobody (the library's) }
function DwHelperOf(V: Integer): Integer;
begin
  Result := 0;
  if BeOk then
    Result := BE_BodyHelper(V);
end;

{ the ticks he has left while down }
function DwLeft(V, Tick: Integer): Integer;
begin
  Result := 0;
  if BeOk then
    Result := BE_BodyDownLeft(V, Tick);
end;

{ he goes down (a hit that would kill him, or his blood ran out): the library looks after his time and the
  mates who help him; his weapons go in the next ticks (not inside the server's damage routine) }
procedure DwPutDown(V, By, W, Tick: Integer);
begin
  if BdShockUntil[V] > 0 then
    BdShockEnd(V);
  DwDown[V] := True;
  DwSince[V] := Tick;
  DwBy[V] := By;
  DwW[V] := W;
  DwDowns[V] := DwDowns[V] + 1;
  DwAnchorX[V] := PL[V].X;
  DwAnchorY[V] := PL[V].Y;
  DwHoldAt[V] := Tick;
  DwLayerOf[V] := -1;
  DwTold[V] := False;
  DwCount := DwCount + 1;
  DwStatDowned := DwStatDowned + 1;
  if DwNoWeapons then
    DwNoneLeft[V] := 6;
  if BeOk then
    BE_BodyDown(V, By, W, Tick);
  if not HumanOf[V] then
    LfBotHold(V, True);
end;

{ may this lethal hit put V down instead: the rules of [Downed] }
function DwMayDown(V, Part: Integer; Damage, Health: Single): Boolean;
begin
  Result := False;
  if not DwActive then
    Exit;
  if not (HumanOf[V] or DwBots) then
    Exit;
  if DwMaxDowns > 0 then
    if DwDowns[V] >= DwMaxDowns then
      Exit;
  if DwHeadKills then
    if Part = 12 then
      Exit;
  if DwOverkill > 0 then
    if Damage - Health > MaxHealth * DwOverkill / 100 then
      Exit;
  Result := True;
end;

{ his mark goes (for everybody who got it) }
{ a mark layer of the pool no other downed soldier uses now; -1: none free (no mark) }
function DwLayerFor(V: Integer): Integer;
var
  k, j, L: Integer;
  Used: Boolean;
begin
  Result := -1;
  for k := 0 to DwLayers - 1 do
    if Result < 0 then
    begin
      L := DwLayer0 + ((V + k) mod DwLayers);
      Used := False;
      for j := 1 to TopSlot do
        if j <> V then
          if DwLayerOf[j] = L then
            Used := True;
      if not Used then
        Result := L;
    end;
end;

procedure DwMarkHide(V: Integer);
var
  j, L: Integer;
begin
  L := DwLayerOf[V];
  if L < 0 then
    Exit;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] or DebugBots then
        PL[j].WorldText(L, ' ', 1, ColorGood, 0.01, 0, 0);
  DwLayerOf[V] := -1;
end;

{ up again (a mate, his kit): health, his weapons, a moment of protection }
procedure DwGetUp(V, By, Tick: Integer);
var
  H: Single;
begin
  if not DwDown[V] then
    Exit;
  DwDown[V] := False;
  DwCount := DwCount - 1;
  if DwCount < 0 then
    DwCount := 0;
  DwStatRevived := DwStatRevived + 1;
  if ActiveSlot[V] then
    if PL[V].Alive then
    begin
      H := MaxHealth * DwReviveHealth / 100;
      if H > PL[V].Health then
      begin
        PL[V].Health := H;
        LastHealth[V] := H;
      end;
    end;
  DwGiveBack(V);
  if BdShockUntil[V] = 0 then
    LfBotHold(V, False);
  DwMarkHide(V);
  LfBig(V, DwBigLayer, ' ', ColorGood);
  DwProtect[V] := After(Tick, DwProtectTicks);
  if (By >= 1) and (By <= 32) then
  begin
    if By <> V then
    begin
      LfBig(V, DwBigLayer, BE_Fill(DwUpText, '{player}'#1 + PL[By].Name), DwColor);
      if HumanOf[By] then
        Say(By, BE_Fill(DwUpMateText, '{player}'#1 + PL[V].Name), DwColor);
      if BpActive then
        if TeamOf[By] = TeamOf[V] then
          if (DwBy[V] >= 1) and (DwBy[V] <= 32) and (DwBy[V] <> V) then
            if Enemies(DwBy[V], V) then
            begin
              BpEvPend[By][PE_REVIVE] := BpEvPend[By][PE_REVIVE] + 1;
              BpPendAny := True;
            end;
      if ActiveSlot[By] then
        LfOver(By, BdWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
    end;
  end;
  HudMark(V, False);
end;

{ not down any more: his death, he leaves, a new map }
procedure DwClear(V: Integer);
begin
  DwFinAt[V] := 0;
  if DwDown[V] then
  begin
    DwDown[V] := False;
    DwCount := DwCount - 1;
    if DwCount < 0 then
      DwCount := 0;
  end;
  DwTookW[V] := -1;
  DwNoneLeft[V] := 0;
  if AmmoEnabled then
    if BeOk then
      BE_AmmoPause(V, 0, Game.TickCount);
  if BdShockUntil[V] = 0 then
    LfBotHold(V, False);
  DwMarkHide(V);
  if ActiveSlot[V] then
    LfBig(V, DwBigLayer, ' ', ColorGood);
end;

{ the marks of the downed for their team mates, and the downed ones' own texts (every 30 ticks) }
procedure DwMarks(Tick: Integer);
var
  v, j, L, Secs: Integer;
  T, Kit: string;
begin
  for v := 1 to TopSlot do
    if DwDown[v] then
      if ActiveSlot[v] then
      begin
        Secs := (DwLeft(v, Tick) + 59) div 60;
        if DwLayerOf[v] < 0 then
          DwLayerOf[v] := DwLayerFor(v);
        L := DwLayerOf[v];
        T := BE_Fill(DwMark, '{seconds}'#1 + IntToStr(Secs) + #1'{player}'#1 + PL[v].Name);
        { drawn whole (it lives longer than the next one), taken away when he is up or dead }
        if L >= 0 then
          if TeamGame() then
            for j := 1 to TopSlot do
              if j <> v then
                if ActiveSlot[j] then
                  if HumanOf[j] or DebugBots then
                    if TeamOf[j] = TeamOf[v] then
                      LfOver(j, L, T, PL[v].X, PL[v].Y, DwMarkScale, 22, 110, DwMarkColor);
        if DwHelperOf(v) = 0 then
        begin
          Kit := '';
          if BdKits[v] > 0 then
            Kit := ' (or crouch: your first-aid kit)';
          LfBig(v, DwBigLayer, BE_Fill(DwDownText, '{seconds}'#1 + IntToStr(Secs) + #1'{giveup}'#1 +
            DwGiveUpWord + #1'{kit}'#1 + Kit), DwColor);
        end;
      end;
end;

{ his weapons go (a few times: the reports his game sent before it got the change bring them back) }
procedure DwTakeWeapons(V, Tick: Integer);
var
  P: TActivePlayer;
  NW, NS: TNewWeapon;
  W: Integer;
begin
  P := PL[V];
  if not P.Alive then
    Exit;
  W := P.Primary.WType;
  if (W = WEP_NONE) and (P.Secondary.WType = WEP_NONE) then
    Exit;
  if DwTookW[V] < 0 then
  begin
    { the first time: what he had (the magazine the ammunition module shows), and the module stops looking }
    DwTookW[V] := W;
    DwTookA[V] := P.Primary.Ammo;
    if AmmoEnabled then
      if BeOk then
        if (W >= 0) and (W <= 16) then
          DwTookA[V] := BE_AmmoShown(V, Tick, W, P.Primary.Ammo);
    DwTookSW[V] := P.Secondary.WType;
    if DwTookSW[V] = WEP_NONE then
      DwTookSW[V] := -1;
    DwTookSA[V] := P.Secondary.Ammo;
    if AmmoEnabled then
      if BeOk then
        BE_AmmoPause(V, 1, Tick);
  end;
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NW.WType := WEP_NONE;
    NS.WType := WEP_NONE;
    P.ForceWeapon(NW, NS);
  finally
    NW.Free;
    NS.Free;
  end;
  AcAmmoTouched(V);
end;

{ the downed and the shocked are held where they lie (crawl: a little along); every 3 ticks }
procedure LfHolds(Tick: Integer);
var
  i: Integer;
  X, Y, AX, AY, D, Most, VY: Single;
  P: TActivePlayer;
begin
  for i := 1 to TopSlot do
    if DwDown[i] or (BdShockUntil[i] > 0) then
      if ActiveSlot[i] then
      begin
        P := PL[i];
        if not P.Alive then
          Continue;
        if DwDown[i] then
        begin
          AX := DwAnchorX[i];
          AY := DwAnchorY[i];
        end
        else
        begin
          AX := BdHoldX[i];
          AY := BdHoldY[i];
        end;
        X := P.X;
        Y := P.Y;
        if DwDown[i] then
          if DwCrawl then
            if BdShockUntil[i] = 0 then
            begin
              { crawling: the anchor follows him slowly along the ground }
              Most := DwCrawlSpeed * (Tick - DwHoldAt[i]);
              D := Sqrt((X - AX) * (X - AX) + (Y - AY) * (Y - AY));
              if D > 0.01 then
              begin
                if D <= Most then
                begin
                  AX := X;
                  AY := Y;
                end
                else
                begin
                  AX := AX + (X - AX) * Most / D;
                  AY := AY + (Y - AY) * Most / D;
                end;
              end;
              DwAnchorX[i] := AX;
              DwAnchorY[i] := AY;
              DwHoldAt[i] := Tick;
            end;
        { in the air he falls (the hold follows him down): a shock or a down in the air does not hang him there }
        if Y > AY then
          if not P.OnGround then
          begin
            AY := Y;
            if DwDown[i] then
              DwAnchorY[i] := Y
            else
              BdHoldY[i] := Y;
          end;
        if Abs(X - AX) + Abs(Y - AY) > 3 then
        begin
          VY := P.VelY;
          MovePlayer(P, AX, AY);
          if (VY > 0) and (Y >= AY) then
            P.SetVelocity(0, VY)
          else
            P.SetVelocity(0, 0);
        end;
      end;
end;

{ ---------------- the events of the library (be_body) ---------------- }

procedure LfEvent(Kind, ID, P, Q, Tick: Integer);
var
  K, W, j: Integer;
  H: Single;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if Kind = BDE_HUD then
    BdSync(ID)
  else if Kind = BDE_WOUND then
  begin
    BdSync(ID);
    if HumanOf[ID] then
      if ActiveSlot[ID] then
        if PL[ID].Alive then
    begin
      LfBig(ID, BdBigLayer, BdFill(BdWoundText, ID, P, '', BdPlaceName(Q)), BdColor);
      if BdSoundWound <> '' then
        PL[ID].PlaySound(BdSoundWound, PL[ID].X, PL[ID].Y);
    end;
  end
  else if Kind = BDE_CLOSED then
  begin
    BdSync(ID);
    if Q = BC_CLOTTED then
      if HumanOf[ID] then
        Say(ID, BdFill(BdClosedText, ID, P, '', ''), BdColor);
  end
  else if Kind = BDE_WORK then
  begin
    BdWorkKind[ID] := P;
  end
  else if Kind = BDE_WORK_STOP then
  begin
    BdWorkKind[ID] := 0;
    if ActiveSlot[ID] then
      LfOver(ID, BdWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
  end
  else if Kind = BDE_BANDAGED then
  begin
    BdWorkKind[ID] := 0;
    BdSync(ID);
    BdStatBandaged := BdStatBandaged + 1;
    if HumanOf[ID] then
    begin
      LfOver(ID, BdWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
      Say(ID, BdFill(BdBandagedText, ID, P, FloatStr(Q / 10.0, 1), ''), BdColor);
      if BdSoundBandage <> '' then
        PL[ID].PlaySound(BdSoundBandage, PL[ID].X, PL[ID].Y);
    end;
  end
  else if Kind = BDE_NO_BANDAGE then
  begin
    if HumanOf[ID] then
      Say(ID, BdFill(BdNoBandageText, ID, 0, '', ''), ColorBad);
  end
  else if Kind = BDE_FADING then
  begin
    { bleeding out (BleedOut = drain): his health goes faster and faster now }
    if HumanOf[ID] then
      if ActiveSlot[ID] then
        if BdOutText <> '' then
          LfBig(ID, BdBigLayer, BdFill(BdOutText, ID, BdWorst[ID], '', ''), BdHudBadColor);
  end
  else if Kind = BDE_TREAT then
  begin
    { a medic (ID) begins on a mate's wound (P, kind Q) }
    if (P >= 1) and (P <= 32) then
      if HumanOf[P] then
        if ActiveSlot[P] then
          if BdTreatText <> '' then
            Say(P, BdFill(ReplaceAll(BdTreatText, '{medic}', PL[ID].Name), P, Q, '', ''), BdColor);
  end
  else if Kind = BDE_TREATED then
  begin
    { a medic (ID) bandaged a mate's wound (P, kind Q) with his own bandage }
    BdWorkKind[ID] := 0;
    BdSync(ID);
    BdStatBandaged := BdStatBandaged + 1;
    if (P >= 1) and (P <= 32) then
    begin
      BdSync(P);
      if HumanOf[ID] then
        if ActiveSlot[ID] then
        begin
          LfOver(ID, BdWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
          if BdTreatedText <> '' then
            Say(ID, BdFill(ReplaceAll(BdTreatedText, '{mate}', PL[P].Name), ID, Q, '', ''), BdColor);
          if BdSoundBandage <> '' then
            PL[ID].PlaySound(BdSoundBandage, PL[ID].X, PL[ID].Y);
        end;
      if HumanOf[P] then
        if ActiveSlot[P] then
          if BdTreatedMateText <> '' then
            Say(P, BdFill(ReplaceAll(BdTreatedMateText, '{medic}', PL[ID].Name), P, Q, '', ''), BdColor);
    end;
  end
  else if Kind = BDE_KIT then
  begin
    BdWorkKind[ID] := 0;
    BdSync(ID);
    BdStatKits := BdStatKits + 1;
    if Q = 0 then
      if ActiveSlot[ID] then
        if PL[ID].Alive then
        begin
          H := PL[ID].Health + MaxHealth * BdKitHealth / 100;
          if H > MaxHealth then
            H := MaxHealth;
          PL[ID].Health := H;
          LastHealth[ID] := H;
        end;
    if HumanOf[ID] then
    begin
      LfOver(ID, BdWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
      Say(ID, BdFill(BdKitText, ID, 0, '', ''), BdColor);
      if BdSoundBandage <> '' then
        PL[ID].PlaySound(BdSoundBandage, PL[ID].X, PL[ID].Y);
    end;
    HudMark(ID, False);
  end
  else if Kind = BDE_DRAIN then
  begin
    if ActiveSlot[ID] then
      if PL[ID].Alive then
        if not DwDown[ID] then
        begin
          H := PL[ID].Health - MaxHealth * P * 0.0001;
          if H < 1 then
          begin
            W := -1;
            K := BE_BodyCulprit(ID, W);
            BdStatBled := BdStatBled + 1;
            if DwMayDown(ID, 0, 0, 0) then
            begin
              DwPutDown(ID, K, W, Tick);
              PL[ID].Health := DwDownHealth();
              LastHealth[ID] := PL[ID].Health;
            end
            else
            begin
              if BdBledText <> '' then
                SayAll(BdFill(BdBledText, ID, 0, '', ''), BdColor);
              LfKill(ID, K, W, Tick);
            end;
          end
          else
          begin
            PL[ID].Health := H;
            LastHealth[ID] := H;
            HudMark(ID, False);
          end;
        end;
  end
  else if Kind = BDE_SHOCK then
    BdShock(ID, P, Tick)
  else if Kind = BDE_SHOCK_END then
    BdShockEnd(ID)
  else if Kind = BDE_BLED then
  begin
    BdStatBled := BdStatBled + 1;
    if ActiveSlot[ID] then
      if PL[ID].Alive then
      begin
        if not DwDown[ID] then
          if DwMayDown(ID, 0, 0, 0) then
          begin
            DwPutDown(ID, P, Q, Tick);
            PL[ID].Health := DwDownHealth();
            LastHealth[ID] := PL[ID].Health;
            HudMark(ID, False);
            Exit;
          end;
        if BdBledText <> '' then
          SayAll(BdFill(BdBledText, ID, 0, '', ''), BdColor);
        LfKill(ID, P, Q, Tick);
      end;
  end
  else if Kind = BDE_DOWN_END then
  begin
    if DwDown[ID] then
    begin
      DwStatDied := DwStatDied + 1;
      K := DwBy[ID];
      W := DwW[ID];
      DwMarkHide(ID);
      if DwEndText <> '' then
        for j := 1 to TopSlot do
          if ActiveSlot[j] then
            if HumanOf[j] then
              if (TeamOf[j] = TeamOf[ID]) or not TeamGame() then
                Say(j, BE_Fill(DwEndText, '{player}'#1 + PL[ID].Name), DwColor);
      LfKill(ID, K, W, Tick);
    end;
  end
  else if Kind = BDE_REVIVED then
    DwGetUp(ID, P, Tick);
end;

{ the progress of bandaging, a kit, helping a mate up (every 10 ticks) }
procedure LfWorkShow;
var
  i, D, Work, Pct, Worst, Wounds, Kits, State, R: Integer;
  Blood, Band: Single;
begin
  for i := 1 to TopSlot do
    if BdWorkKind[i] > 0 then
      if ActiveSlot[i] then
      begin
        Blood := 100;
        Band := 0;
        Worst := 0;
        Wounds := 0;
        Kits := 0;
        Work := 0;
        Pct := 0;
        State := 0;
        R := BE_BodyGet(i, Blood, Worst, Wounds, Band, Kits, Work, Pct, State);
        if (R <> 1) or (Work = 0) then
        begin
          BdWorkKind[i] := 0;
          Continue;
        end;
        if Work = 3 then
        begin
          D := BE_BodyWorkOn(i);
          if (D >= 1) and (D <= 32) then
            if ActiveSlot[D] then
            begin
              LfOver(i, BdWorkLayer, BE_Fill(DwHelpText, '{pct}'#1 + IntToStr(Pct) + #1'{player}'#1 + PL[D].Name),
                PL[D].X, PL[D].Y, DwTextScale, DwTextY, 25, DwColor);
              LfBig(D, DwBigLayer, BE_Fill(DwHelpedText, '{pct}'#1 + IntToStr(Pct) + #1'{player}'#1 + PL[i].Name),
                DwColor);
            end;
        end
        else if Work = 2 then
          LfOver(i, BdWorkLayer, BdFill(BdKitUseText, i, Worst, IntToStr(Pct), ''), PL[i].X, PL[i].Y, BdWorkScale,
            BdWorkY, 25, BdColor)
        else
          LfOver(i, BdWorkLayer, BdFill(BdBandagingText, i, Worst, IntToStr(Pct), ''), PL[i].X, PL[i].Y, BdWorkScale,
            BdWorkY, 25, BdColor);
      end;
end;

{ [Bleeding] AirBandage: he falls freely - in the air, no key of a move held (left, right, jump, jets) }
function LfFreeFall(P: TActivePlayer): Boolean;
var
  VX, VY: Single;
begin
  Result := False;
  if P.OnGround then
    Exit;
  if P.KeyLeft or P.KeyRight or P.KeyUp or P.KeyJetpack then
    Exit;
  { E10: falling - going down, not flying on with the speed of a jump or a jet let go }
  VY := P.VelY;
  if VY <= 0 then
    Exit;
  VX := P.VelX;
  if (VX > 3) or (VX < -3) then
    Exit;
  Result := True;
end;

{ the tick of [Bleeding] and [Downed] }
procedure LfTickRun(Tick: Integer);
var
  i, n, k, M, Kind, Id, P, Q: Integer;
begin
  if not (BdActive or DwActive) then
    Exit;
  if not BeOk then
    Exit;
  { where the library cannot read a soldier: his feet and stance; his keys where it cannot read his stance }
  M := BE_BodyWants();
  if M <> 0 then
    for i := 1 to TopSlot do
      if (M and SlotBit[i]) <> 0 then
        if ActiveSlot[i] then
          if PL[i].Alive then
            BE_BodyPos(i, PL[i].X, PL[i].Y, BoolInt(PL[i].KeyCrouch or PL[i].IsProne));
  M := BE_BodyNear();
  if M <> 0 then
    for i := 1 to TopSlot do
      if (M and SlotBit[i]) <> 0 then
        if ActiveSlot[i] then
          BE_BodyLow(i, BoolInt(PL[i].KeyCrouch or PL[i].IsProne));
  { [Bleeding] AirBandage: who of those who bleed falls freely (as low and still for bandaging) }
  if BdAirOn then
    if BdActive then
      for i := 1 to TopSlot do
        if BdWounds[i] > 0 then
          if ActiveSlot[i] then
            if HumanOf[i] then
              if PL[i].Alive then
                BE_BodyAir(i, BoolInt(LfFreeFall(PL[i])));
  n := BE_BodyTick(Tick);
  for k := 1 to n do
    if BE_BodyNext(Kind, Id, P, Q) = 1 then
      LfEvent(Kind, Id, P, Q, Tick);
  { holding the downed and the shocked; the weapons of the newly downed; the kills that did not happen }
  if (DwCount > 0) or (BdShockCount > 0) then
    if Tick mod 3 = 0 then
      LfHolds(Tick);
  if DwCount > 0 then
  begin
    for i := 1 to TopSlot do
      if DwDown[i] then
      begin
        if DwNoneLeft[i] > 0 then
          if Tick mod 5 = 0 then
          begin
            DwNoneLeft[i] := DwNoneLeft[i] - 1;
            if ActiveSlot[i] then
              DwTakeWeapons(i, Tick);
          end;
        if not DwTold[i] then
        begin
          DwTold[i] := True;
          if DwTellTeam then
            if TeamGame() then
              for k := 1 to TopSlot do
                if k <> i then
                  if ActiveSlot[k] then
                    if HumanOf[k] then
                      if TeamOf[k] = TeamOf[i] then
                        Say(k, BE_Fill(DwTeamText, '{player}'#1 + PL[i].Name), DwColor);
        end;
      end;
    if Tick mod 30 = 0 then
      DwMarks(Tick);
  end;
  { a downed soldier finished by a hit (OnDamage queued it): killed now, his weapons drop }
  if DwFinAny > 0 then
  begin
    DwFinAny := 0;
    for i := 1 to TopSlot do
      if DwFinAt[i] > 0 then
      begin
        if DwDown[i] then
          if ActiveSlot[i] then
            if PL[i].Alive then
              LfKill(i, DwFinBy[i], DwFinW[i], Tick);
        DwFinAt[i] := 0;
      end;
  end;
  if DwKillingAny > 0 then
  begin
  DwKillingAny := 0;
  for i := 1 to TopSlot do
    if DwKilling[i] > 0 then
      if Tick - DwKilling[i] >= 4 then
      begin
        DwKilling[i] := 0;
        { E7: still down (a healing polygon or a kit lifted his health over the last point): ended all the same }
        if ActiveSlot[i] then
          if PL[i].Alive then
            if (PL[i].Health <= 1.5) or DwDown[i] then
            begin
              { the bullet missed him (no friendly fire, a wall): the server's kind of kill }
              ServerKill[i] := Tick;
              AdminHit[i] := Tick;
              PL[i].Damage(i, 4000);
            end;
      end
      else
        DwKillingAny := DwKillingAny + 1;
  end;
  if Tick mod 10 = 0 then
    LfWorkShow;
end;

{ ---------------- the damage and the kills ---------------- }

{ OnDamage (after the team kill guard): the survival round's end, the module's own kill bullets, the downed
  and the shocked (no damage from them; a hit on a downed one finishes him), the protection after getting up,
  a wound, a lethal hit that puts him down. The damage to take }
{ E3: a bullet of a downed or shocked soldier that he did not fire in that state: his mine's or claymore's blast, a
  class skill's (mortar, C4), a rocket or a grenade he launched before (the bridge knows when a bullet was made) -
  it does its damage; only what he fires while down or in shock does none }
function LfOldShot(B, S, Tick: Integer): Boolean;
var
  X, Y: Single;
  T, Since: Integer;
begin
  Result := False;
  if (B < 1) or (B > 254) then
    Exit;
  if MnBulletKind(B, S) > 0 then
  begin
    Result := True;
    Exit;
  end;
  if ClsBulOwner[B] = S then
    if Tick - ClsBulTick[B] <= 180 then
    begin
      Result := True;
      Exit;
    end;
  if not BeOk then
    Exit;
  if BE_BulletOrigin(B, X, Y, T) <> 1 then
    Exit;
  Since := 0;
  if DwDown[S] then
    Since := DwSince[S]
  else if BdShockUntil[S] > 0 then
    Since := BdHoldAt[S];
  if Since > 0 then
    if T < Since then
      Result := True;
end;

function LfOnDamage(Shooter, Victim: TActivePlayer; S, V: Integer; Damage, Raw: Single; BulletId: Byte;
  Tick: Integer): Single;
var
  Part, W, Style, B, PD, MK: Integer;
  H, Left: Single;
  Lethal: Boolean;
begin
  Result := Damage;
  { the round's end of survival (and the deaths after a capture): 4000 on every living player - a quarter of
    it with a vest }
  if S = V then
    if BulletId = NO_BULLET then
      if (Abs(Raw - 4000) < 0.5) or (Abs(Raw - 1000) < 0.5) or (Abs(Raw - 16000) < 0.5) then
      begin
        ServerKill[V] := Tick;
        if Game.Survival then
          CyRoundHit[V] := Tick;
      end;
  if not (BdActive or DwActive) then
    Exit;
  B := BulletId;
  if LfOwnBullet(B, V) then
    Exit;
  if DwKilling[V] > 0 then
    if Tick - DwKilling[V] < 4 then
      Exit;
  if S <> V then
    if DwDown[S] or (BdShockUntil[S] > 0) then
      if not LfOldShot(B, S, Tick) then
      begin
        Result := 0;
        Exit;
      end;
  if S = V then
    if B = NO_BULLET then
      if DwDown[V] then
        if Raw <= SERVER_HIT_DAMAGE then
          if (Abs(Raw - 1000) >= 0.5) and (Raw > 1) then
            if BeOk then
            begin
              Result := 0;
              BE_BodyGiveUp(V);
              Exit;
            end;
  if B = NO_BULLET then
    Exit;
  if Raw > SERVER_HIT_DAMAGE then
    Exit;
  if DwProtect[V] > Tick then
  begin
    Result := 0;
    Exit;
  end;
  { the script's own blows (a flash, a Javelin, /slap, a mirrored team hit): no wound, no down }
  if InTick then
    Exit;
  { where it hit, with what }
  Part := 0;
  W := -1;
  Style := 1;
  if (B >= 1) and (B <= MAX_BULLET_ID) then
  begin
    Style := BL[B].Style;
    if BL[B].Owner = S then
      W := BL[B].GetOwnerWeaponId;
    Part := BE_BodyHitPart(V, Style, BL[B].X, BL[B].Y, BL[B].VelX, BL[B].VelY);
    { E17: a mine's or claymore's blast: the down or the wound it leaves is the mine's (W = 17) }
    MK := MnBulletKind(B, S);
    if MK > 0 then
    begin
      W := 17;
      DwMineK[V] := MK;
    end;
  end;
  { E16: a blast hits no head (its nearest body part is chance): HeadKills only for bullets }
  PD := Part;
  if (Style = 2) or (Style = 4) or (Style = 9) or (Style = 10) or (Style = 12) then
    PD := 0;
  if W < 0 then
    W := Shooter.Primary.WType;
  { a hit on a downed soldier finishes him - not the rest of the burst that put him down; the kill is made in the
    tick (his weapons drop; FinishCredit = downer: the kill is the one's who put him down) }
  if DwDown[V] then
  begin
    Result := 0;
    if Tick - DwSince[V] < DW_FINISH_GRACE then
      Exit;
    if DwFinAt[V] = 0 then
    begin
      DwFinAt[V] := Tick;
      DwFinAny := DwFinAny + 1;
      DwFinBy[V] := S;
      DwFinW[V] := W;
      if DwFinishDowner then
      begin
        DwFinBy[V] := DwBy[V];
        DwFinW[V] := DwW[V];
      end;
    end;
    Exit;
  end;
  { a hit that would kill him puts him down instead; a wound only on a hit he lives through }
  H := Victim.Health;
  Lethal := Damage >= H;
  if DwActive then
    if Lethal then
      if DwMayDown(V, PD, Damage, H) then
      begin
        DwPutDown(V, S, W, Tick);
        Left := H - DwDownHealth();
        if Left < 0 then
          Left := 0;
        Result := Left;
        Lethal := False;
      end;
  if BdActive then
    if not Lethal then
    begin
      { VestTorso: the vest he wears keeps his torso from bleeding (for this hit) }
      if BdVestTorso then
        if Victim.Vest > 0 then
          BE_BodyCover(V, 2);
      if BE_BodyHit(V, S, W, Style, Damage * ClsWoundsOf(S), MaxHealth, Part, Tick) > 0 then
        BdStatWounds := BdStatWounds + 1;
    end;
end;

{ ---------------- [Spotting] ---------------- }

{ the reload key does nothing now: a full magazine (or nothing to reload) }
function SgNoReload(i, Tick: Integer; P: TActivePlayer): Boolean;
var
  W, A, St, Iv, Am, Rl, Su: Integer;
  Sp, Dm, Spr, Inh: Single;
begin
  Result := True;
  W := P.Primary.WType;
  if (W < 0) or (W > 10) then
    Exit;
  A := P.Primary.Ammo;
  if AmmoEnabled then
    if BeOk then
      A := BE_AmmoShown(i, Tick, W, A);
  Am := 0;
  if BeOk then
    if BE_Weapon(W, Sp, Dm, Spr, Inh, St, Iv, Am, Rl, Su) = 1 then
      Result := A >= Am;
end;

{ T is spotted by By's team for SpotSeconds: on their radar, in the world with World = 1 }
procedure SgSpot(By, T, Tick: Integer);
var
  Tm, j, Till: Integer;
  Keep, Mark: Boolean;
begin
  Tm := TeamOf[By];
  if (Tm < 1) or (Tm > 4) then
    Exit;
  { a longer spot still running (a UAV, a sensor) is never shortened, nor its marks taken away }
  Keep := False;
  if SgUntil[T][Tm] > Tick then
    Keep := SgMarkIt[T][Tm];
  Till := After(Tick, SgTicks);
  Mark := False;
  { [Classes]: a class whose spots last longer (and, SkillSpots = marks, show over the enemy) }
  if ClsActive then
    if (ClsOf[By] >= 1) and (ClsOf[By] <= ClsCount) then
    begin
      Till := After(Tick, Round(SgTicks * ClsSpotF[ClsOf[By]]));
      if ClsSpotF[ClsOf[By]] > 1.001 then
        if ClsSpotsMode = 0 then
          Mark := True;
    end;
  if Till > SgUntil[T][Tm] then
    SgUntil[T][Tm] := Till;
  SgBy[T][Tm] := By;
  SgMarkIt[T][Tm] := Keep or Mark;
  if SgMarkIt[T][Tm] then
    SgMarkAny := True;
  if SgRadar then
    if BeOk then
      BE_SpotSet(T, Tm, SgUntil[T][Tm]);
  SgAny := SgAny + 1;
  SgStatSpots := SgStatSpots + 1;
  if HumanOf[By] then
  begin
    Say(By, BE_Fill(SgSpotText, '{target}'#1 + PL[T].Name + #1'{player}'#1 + PL[By].Name), SgColor);
    if SgSound <> '' then
      PL[By].PlaySound(SgSound, PL[By].X, PL[By].Y);
  end;
  if SgTellTeam then
    for j := 1 to TopSlot do
      if j <> By then
        if ActiveSlot[j] then
          if HumanOf[j] then
            if TeamOf[j] = Tm then
              Say(j, BE_Fill(SgTeamText, '{target}'#1 + PL[T].Name + #1'{player}'#1 + PL[By].Name), SgColor);
  if SgTellTarget then
    LfBig(T, SgBigLayer, BE_Fill(SgTargetText, '{player}'#1 + PL[By].Name), ColorBad);
end;

{ he spots: the enemy nearest to his cursor within CursorRadius, in his sight and within Range }
procedure SgTry(ID, Tick: Integer; ByKey: Boolean);
var
  n: Integer;
  SX, SY, EX, EY: Single;
  P: TActivePlayer;
begin
  if not SgActive then
  begin
    if not ByKey then
      Say(ID, 'Spotting is off here (' + SgIdleWhy + ').', ColorBad);
    Exit;
  end;
  P := PL[ID];
  if not P.Alive then
    Exit;
  if DwDown[ID] then
    Exit;
  if BdShockUntil[ID] > 0 then
    Exit;
  if FnEnabled then
    if FnBlindUntil[ID] > Tick then
      Exit;
  if Tick < SgNextOk[ID] then
  begin
    if not ByKey then
      Say(ID, 'Not so fast - spot again in a moment.', ColorBad);
    Exit;
  end;
  WorldSnap(Tick, SNAP_AIM, False);
  SX := P.X;
  SY := P.Y - 15;
  if BE_SpriteEyes(ID, P, P.X, P.Y, EX, EY) = 1 then
  begin
    SX := EX;
    SY := EY;
  end;
  n := BE_GunPick(ID, AT_RADIUS, SgRange, SgRadius, SX, SY, BODY_HEIGHT, 4, MR_BULLET);
  if (n >= 1) and (n <= 32) then
  begin
    SgNextOk[ID] := After(Tick, SgCoolTicks);
    SgSpot(ID, n, Tick);
  end
  else if not ByKey then
    Say(ID, SgNoTargetText, ColorBad);
end;

{ the marks over the spotted enemies (World = 1) and over the bounties' targets ([Bounty] World = 1): each
  viewer the ones for him, every 6 ticks - his first mark on MarkLayerFirst, the next one on the next layer (up to
  MarkLayers); a layer he no longer needs is taken away }
procedure SgMarksTick(Tick: Integer);
var
  e, j, Tm: Integer;
  Show, Any: Boolean;
  EX, EY, SgW, BnW: Single;
  Kv: array[1..32] of Integer;
begin
  for j := 1 to 32 do
    Kv[j] := 0;
  if BeOk then
  begin
    SgW := BE_TextWidth(SgMark, SgMarkScale);
    BnW := BE_TextWidth(BnMark, BnMarkScale);
  end
  else
  begin
    SgW := Length(SgMark) * SgMarkScale * WT_CHAR_WIDTH;
    BnW := Length(BnMark) * BnMarkScale * WT_CHAR_WIDTH;
  end;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
    begin
      { only an enemy spotted by some team or with a bounty gets marks }
      Any := False;
      if BnWorld then
        if BnPrice[e] > 0 then
          Any := True;
      if not Any then
        for Tm := 1 to 4 do
          if SgUntil[e][Tm] > Tick then
            if SgWorld or SgMarkIt[e][Tm] then
              Any := True;
      if Any then
        if not PL[e].Alive then
          Any := False;
      if Any then
      begin
        EX := PL[e].X;
        EY := PL[e].Y;
        for j := 1 to TopSlot do
          if j <> e then
            if ActiveSlot[j] then
              if HumanOf[j] or DebugBots then
                if Kv[j] < SgLayers then
                begin
                  Show := False;
                  if BnWorld then
                    if BnPrice[e] > 0 then
                      if Enemies(j, e) then
                      begin
                        PL[j].WorldText(SgLayer0 + Kv[j], BnMark, 90, BnMarkColor, BnMarkScale, EX - BnW / 2, EY - 32);
                        Kv[j] := Kv[j] + 1;
                        Show := True;
                      end;
                  if not Show then
                    begin
                      Tm := TeamOf[j];
                      if (Tm >= 1) and (Tm <= 4) then
                        if SgUntil[e][Tm] > Tick then
                        if SgWorld or SgMarkIt[e][Tm] then
                        begin
                          PL[j].WorldText(SgLayer0 + Kv[j], SgMark, 90, SgMarkColor, SgMarkScale, EX - SgW / 2,
                            EY - 32);
                          Kv[j] := Kv[j] + 1;
                        end;
                    end;
                end;
      end;
    end;
  { the layers a viewer no longer needs }
  for j := 1 to TopSlot do
  begin
    while SgUsed[j] > Kv[j] do
    begin
      SgUsed[j] := SgUsed[j] - 1;
      if ActiveSlot[j] then
        if HumanOf[j] or DebugBots then
          PL[j].WorldText(SgLayer0 + SgUsed[j], ' ', 1, ColorGood, 0.01, 0, 0);
    end;
    SgUsed[j] := Kv[j];
  end;
end;

{ ---------------- [Bounty] ---------------- }

procedure BnSay(Text: string);
var
  j: Integer;
begin
  if Text = '' then
    Exit;
  if (BnAnnounce = 2) or (BnAnnounce = 3) then
    SayAll(Text, BnColor);
  if (BnAnnounce = 1) or (BnAnnounce = 3) then
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if HumanOf[j] then
          PL[j].BigText(BnLayer, Text, MnBigTicks, BnColor, MnBigScale, MnBigX, MnBigY + 25);
end;

function BnFill(S: string; ID, K, Price: Integer; Why: string): string;
var
  KN: string;
begin
  KN := '';
  if (K >= 1) and (K <= 32) then
    if ActiveSlot[K] then
      KN := PL[K].Name;
  Result := BE_Fill(S, '{player}'#1 + PL[ID].Name + #1'{killer}'#1 + KN + #1'{bounty}'#1 + IntToStr(Price) +
    #1'{kills}'#1 + IntToStr(BnKills[ID]) + #1'{why}'#1 + Why + #1'{bonus}'#1 + IntToStr(BnSurvival));
end;

{ the bounty's target on the enemies' radars (the spotting of the library: refreshed every second) }
procedure BnMarkRadar(T, Tick: Integer);
var
  tm: Integer;
begin
  if not BnRadar then
    Exit;
  if not BeOk then
    Exit;
  if TeamGame() then
  begin
    for tm := 1 to 4 do
      if tm <> TeamOf[T] then
        BE_SpotSet(T, tm, After(Tick, 150));
  end
  else
    BE_SpotSet(T, 0, After(Tick, 150));
end;

{ off the radars again (a spotting of his own stays until it ends) }
procedure BnUnmark(T: Integer);
var
  tm: Integer;
begin
  if not BeOk then
    Exit;
  for tm := 0 to 4 do
    BE_SpotSet(T, tm, SgUntil[T][tm]);
end;

procedure BnDrop(V: Integer; Why: string);
begin
  if BnPrice[V] <= 0 then
    Exit;
  BnSay(BnFill(BnLostText, V, 0, BnPrice[V], Why));
  BnPrice[V] := 0;
  BnStatLost := BnStatLost + 1;
  BnUnmark(V);
end;

{ the rewards of the one who collects a bounty }
procedure BnReward(K, Price: Integer);
var
  P: TActivePlayer;
  H: Single;
  W, n: Integer;
begin
  P := PL[K];
  if (K >= 1) and (K <= 32) then
  begin
    ShBnPend[K] := ShBnPend[K] + Price;
    ShBnAny := True;
  end;
  if BnRewardKills then
    if Price > 0 then
      AddPoints(K, Price);
  if P.Alive then
  begin
    if BnRewardHealth > 0 then
    begin
      H := P.Health + MaxHealth * BnRewardHealth / 100;
      if H > MaxHealth then
        H := MaxHealth;
      P.Health := H;
      LastHealth[K] := H;
    end;
    if BnRewardVest > 0 then
    begin
      H := P.Vest + BnRewardVest;
      if H > 100 then
        H := 100;
      P.Vest := H;
    end;
    if BnRewardAmmo then
      if AmmoEnabled then
        if BeOk then
        begin
          W := P.Primary.WType;
          if (W >= 0) and (W <= 16) then
            BE_AmmoRefill(K, W);
        end;
  end;
  if MnEnabled then
  begin
    if BnRewardMines > 0 then
      n := MnGive(K, MN_LAND, BnRewardMines, 'the bounty', True);
    if BnRewardClays > 0 then
      n := MnGive(K, MN_CLAY, BnRewardClays, 'the bounty', True);
  end;
  { F17: up to the shop's MaxFlashes and MaxJavelins (what he has above stays: bought, of his class) }
  if FnEnabled then
    if BnRewardFlashes > 0 then
      if FnFlashLeft[K] < ShMaxFlashes then
      begin
        FnFlashLeft[K] := FnFlashLeft[K] + BnRewardFlashes;
        if FnFlashLeft[K] > ShMaxFlashes then
          FnFlashLeft[K] := ShMaxFlashes;
        FnNeed[K] := True;
      end;
  if RkEnabled then
    if BnRewardRockets > 0 then
      if RkRockets - RkUsed[K] < ShMaxJav then
      begin
        RkUsed[K] := RkUsed[K] - BnRewardRockets;
        if RkRockets - RkUsed[K] > ShMaxJav then
          RkUsed[K] := RkRockets - ShMaxJav;
      end;
  if BdActive then
    if (BnRewardBand > 0) or (BnRewardKits > 0) then
    begin
      BE_BodySupplies(K, BnRewardBand, BnRewardKits, 1);
      BdSync(K);
    end;
  HudMark(K, False);
end;

{ a kill: the victim's bounty (collected by an enemy, lost otherwise - kept at the round's end of survival);
  the killer's kills this life and his bounty }
procedure BnKill(K, V, Tick: Integer; RoundEnd: Boolean);
var
  Price, Old: Integer;
begin
  if not BnActive then
    Exit;
  if BnPrice[V] > 0 then
  begin
    if RoundEnd then
    begin
      if BnSurvival > 0 then
      begin
        AddPoints(V, BnSurvival);
        BnSay(BnFill(BnSurviveText, V, 0, BnPrice[V], ''));
      end;
    end
    else if (K >= 1) and (K <= 32) and (K <> V) then
    begin
      if Enemies(K, V) then
      begin
        Price := BnPrice[V];
        BnSay(BnFill(BnClaimText, V, K, Price, ''));
        BnPrice[V] := 0;
        BnStatClaimed := BnStatClaimed + 1;
        if BpActive then
        begin
          BpEvPend[K][PE_BOUNTY] := BpEvPend[K][PE_BOUNTY] + 1;
          BpPendAny := True;
        end;
        BnUnmark(V);
        BnReward(K, Price);
      end
      else
        BnDrop(V, 'a team kill');
    end
    else
      BnDrop(V, 'he died');
  end;
  if not RoundEnd then
    BnKills[V] := 0;
  if (K < 1) or (K > 32) or (K = V) then
    Exit;
  if not Enemies(K, V) then
    Exit;
  if not (HumanOf[K] or BnBots) then
    Exit;
  BnKills[K] := BnKills[K] + 1;
  if BnKills[K] < BnStart then
    Exit;
  Price := BnBase + BnPer * (BnKills[K] - BnStart);
  if BnMax > 0 then
    if Price > BnMax then
      Price := BnMax;
  Old := BnPrice[K];
  BnPrice[K] := Price;
  BnSince[K] := Tick;
  if Old = 0 then
  begin
    BnSay(BnFill(BnStartText, K, 0, Price, ''));
    if HumanOf[K] then
      Say(K, BnFill(BnTargetText, K, 0, Price, ''), BnColor);
  end
  else if Price > Old then
    BnSay(BnFill(BnRaiseText, K, 0, Price, ''));
  BnMarkRadar(K, Tick);
end;

{ once a second: the targets stay on the enemies' radars; a bounty with no kill for ExpireSeconds ends }
procedure BnSecond(Tick: Integer);
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if BnPrice[i] > 0 then
    begin
      if not ActiveSlot[i] then
        BnPrice[i] := 0
      else if BnExpireTicks > 0 then
        if Tick - BnSince[i] >= BnExpireTicks then
        begin
          BnDrop(i, 'no kill for a while');
          Continue;
        end;
      if BnPrice[i] > 0 then
        BnMarkRadar(i, Tick);
    end;
end;

{ the tick of [Spotting] and [Bounty] }
procedure SgTickRun(Tick: Integer);
var
  i, n: Integer;
  Down: Boolean;
  P: TActivePlayer;
begin
  if SgActive then
  begin
    { the keys (a new press), every 3 ticks }
    if SgKeys <> 0 then
      if Tick mod 3 = 0 then
        for i := 1 to TopSlot do
          if ActiveSlot[i] then
            if HumanOf[i] then
            begin
              P := PL[i];
              Down := False;
              if P.Alive then
                Down := KeysHeld(P, SgKeys);
              if Down then
                if not SgKeyWas[i] then
                begin
                  { reload: only one the game ignores (a full magazine), standing }
                  if (SgKeys and KM_RELOAD) <> 0 then
                  begin
                    if not P.KeyCrouch then
                      if not P.IsProne then
                        if SgNoReload(i, Tick, P) then
                          SgTry(i, Tick, True);
                  end
                  else
                    SgTry(i, Tick, True);
                end;
              SgKeyWas[i] := Down;
            end;
    { aiming at an enemy he sees for AutoSeconds spots him }
    if SgAutoTicks > 0 then
      if Tick mod 10 = 5 then
      begin
        WorldSnap(Tick, SNAP_AIM, False);
        for i := 1 to TopSlot do
          if ActiveSlot[i] then
            if HumanOf[i] then
              if PL[i].Alive then
              begin
                n := BE_GunPick(i, AT_RADIUS, SgRange, SgRadius, PL[i].X, PL[i].Y - 15, BODY_HEIGHT, 4, MR_BULLET);
                if n <> SgAimAt[i] then
                begin
                  SgAimAt[i] := n;
                  SgAimSince[i] := Tick;
                end
                else if (n >= 1) and (n <= 32) then
                  if Tick - SgAimSince[i] >= SgAutoTicks then
                    if Tick >= SgNextOk[i] then
                    begin
                      SgNextOk[i] := After(Tick, SgCoolTicks);
                      SgAimSince[i] := Tick;
                      SgSpot(i, n, Tick);
                    end;
              end;
      end;
    { a bot spots now and then (one a tick in turn) }
    if SgBots then
    begin
      i := Tick mod 60 + 1;
      if i <= TopSlot then
        if ActiveSlot[i] then
          if not HumanOf[i] then
            if PL[i].Alive then
              if Random(0, 1000) < Round(SgBotChance * 1000) then
                SgTry(i, Tick, True);
    end;
  end;
  if SgWorld or BnWorld or SgMarkAny then
    if Tick mod 6 = 0 then
      SgMarksTick(Tick);
  if BnActive then
    if Tick mod 60 = 30 then
      BnSecond(Tick);
end;

{ ---------------- the survival carry-over ([Ammo] SurvivalCarry, SurvivalLock) ---------------- }

{ the weapon menu's slot of a weapon (1-10 the guns, 11 SOCOM, 12 knife, 13 chainsaw, 14 LAW; 0 none) }
function CySlot(W: Integer): Integer;
begin
  Result := 0;
  if (W >= 1) and (W <= 10) then
    Result := W
  else if W = 0 then
    Result := 11
  else if W = 11 then
    Result := 12
  else if W = 12 then
    Result := 13
  else if W = 13 then
    Result := 14;
end;

function CyWeaponOfSlot(k: Integer): Integer;
begin
  Result := k;
  if k = 11 then
    Result := 0
  else if k = 12 then
    Result := 11
  else if k = 13 then
    Result := 12
  else if k = 14 then
    Result := 13;
end;

{ his locks go (a death in the round, he leaves, a new map): the weapon menu whole again }
procedure CyUnlock(ID: Integer);
var
  k: Integer;
  Any: Boolean;
begin
  Any := False;
  for k := 1 to 14 do
  begin
    if CyLocked[ID][k] then
    begin
      Any := True;
      if ActiveSlot[ID] then
        if HumanOf[ID] then
          PL[ID].WeaponActive[k] := ShServerW[CyWeaponOfSlot(k)];
    end;
    CyLocked[ID][k] := False;
    CyLockPend[ID][k] := False;
  end;
  CyAnyLock[ID] := False;
  if Any then
  begin
    ShMaskLast[ID] := -1;
    { the class's or BuyOnly's menu again (ShMaskSend comes later in the file: MenuAgainRun sends it) }
    if ActiveSlot[ID] then
      if HumanOf[ID] then
      begin
        if MenuAgainAt[ID] = 0 then
          MenuAgainAny := MenuAgainAny + 1;
        MenuAgainAt[ID] := Game.TickCount + 1;
      end;
  end;
end;

{ nothing kept any more }
procedure CyDrop(ID: Integer);
begin
  CyKept[ID] := False;
  CyPending[ID] := 0;
  if BeOk then
    if AmmoEnabled then
      BE_AmmoCarryDrop(ID);
  CyUnlock(ID);
end;

{ the round's end killed him (he survived it): what he has is kept - not yet sure it is the round's end
  (the next tick tells: nobody alive any more) }
procedure CyRoundKill(V, Tick: Integer);
var
  k, W, L: Integer;
begin
  CyPending[V] := Tick;
  CyPendingAny := True;
  if CyCarry then
    if AmmoEnabled then
      if BeOk then
        BE_AmmoCarrySave(V, Tick);
  { what will be locked: a weapon he used that has nothing left }
  for k := 1 to 14 do
    CyLockPend[V][k] := False;
  if CyLock then
    if AmmoEnabled then
      if BeOk then
        for k := 1 to 14 do
        begin
          W := CyWeaponOfSlot(k);
          if W <> WEP_KNIFE then
          begin
            L := BE_AmmoLeftOf(V, W, Tick);
            if L = 0 then
              CyLockPend[V][k] := True;
          end;
        end;
  CyBand[V] := BdBand[V];
  CyKits[V] := BdKits[V];
  CyRkUsed[V] := RkUsed[V];
end;

{ the tick after the round's end: confirmed when nobody (not a spectator) lives - the kept states stay and
  the locks come; else it was no round's end }
procedure CyTickRun(Tick: Integer);
var
  i, k, Alive: Integer;
begin
  if CyPendingAny then
  begin
    CyPendingAny := False;
    Alive := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if (TeamOf[i] >= 0) and (TeamOf[i] <= 4) then
          if PL[i].Alive then
            Alive := Alive + 1;
    for i := 1 to TopSlot do
      if CyPending[i] > 0 then
      begin
        CyPending[i] := 0;
        if Alive = 0 then
        begin
          CyKept[i] := True;
          CyStatKept := CyStatKept + 1;
          if BeOk then
            if AmmoEnabled then
              BE_AmmoCarryConfirm(i);
          for k := 1 to 14 do
            if CyLockPend[i][k] then
            begin
              CyLockPend[i][k] := False;
              if not CyLocked[i][k] then
              begin
                CyLocked[i][k] := True;
                CyAnyLock[i] := True;
                ShMaskLast[i] := -1;
                CyStatLocked := CyStatLocked + 1;
                if ActiveSlot[i] then
                  if HumanOf[i] then
                    PL[i].WeaponActive[k] := False;
              end;
            end;
        end
        else
          CyDrop(i);
      end;
  end;
  { a locked weapon in his hands (an old game, a pick-up): taken }
  if Tick mod 10 = 0 then
    for i := 1 to TopSlot do
      if CyAnyLock[i] then
        if ActiveSlot[i] then
          if PL[i].Alive then
          begin
            k := CySlot(PL[i].Primary.WType);
            if k > 0 then
              if CyLocked[i][k] then
                AmmoTake(i, PL[i]);
          end;
end;

{ ---------------- a player's life ---------------- }

{ OnKill (before the other modules): the round's end of survival or a death; [Downed], [Bounty] }
procedure LfOnKill(K, V, Tick: Integer);
var
  RoundEnd: Boolean;
begin
  RoundEnd := False;
  if Game.Survival then
    if K = V then
      if CyRoundHit[V] = Tick then
        if not MapChanging then
          RoundEnd := True;
  if RoundEnd then
  begin
    { [Supply]: the next round arms its crate }
    SuArmed := False;
    if CyCarry or CyLock then
      CyRoundKill(V, Tick);
  end
  else if CyKept[V] or CyAnyLock[V] or (CyPending[V] > 0) then
    CyDrop(V);
  BnKill(K, V, Tick, RoundEnd);
  DwClear(V);
  if BdShockUntil[V] > 0 then
    BdShockEnd(V);
  DwKilling[V] := 0;
  BdWorkKind[V] := 0;
  { [Spotting]: the spots on him go at the end of the kill event (SgClearSpots) - [Points] SpotKill reads them }
end;

{ [Spotting]: a dead soldier is no longer spotted (OnKillRun, after [Points] paid SpotKill) }
procedure SgClearSpots(V: Integer);
var
  Tm: Integer;
begin
  if (V < 1) or (V > 32) then
    Exit;
  for Tm := 0 to 4 do
    if SgUntil[V][Tm] > 0 then
    begin
      SgUntil[V][Tm] := 0;
      if BeOk then
        BE_SpotSet(V, Tm, 0);
    end;
end;

{ a new life (after ResetLife and the other modules): full blood, the kept supplies of a survivor }
procedure LfRespawn(ID, Tick: Integer);
var
  k: Integer;
begin
  CyWasKept[ID] := CyKept[ID];
  DwClear(ID);
  DwDowns[ID] := 0;
  DwProtect[ID] := 0;
  DwKilling[ID] := 0;
  if BdShockUntil[ID] > 0 then
    BdShockEnd(ID);
  BdWorkKind[ID] := 0;
  if BeOk then
    if BdEnabled or DwEnabled then
    begin
      BE_BodySpawn(ID, Tick);
      if CyKept[ID] then
        if CyCarry then
          BE_BodySupplies(ID, CyBand[ID], CyKits[ID], 0);
      BdSync(ID);
    end;
  if CyKept[ID] then
  begin
    CyKept[ID] := False;
    if CyCarry then
    begin
      RkUsed[ID] := CyRkUsed[ID];
      if HumanOf[ID] then
      begin
        k := 0;
        if CyAnyLock[ID] then
          k := 1;
        if k = 1 then
          Say(ID, 'You survived the round: you keep your ammunition (a weapon with nothing left is locked).', ColorGood)
        else
          Say(ID, 'You survived the round: you keep your ammunition.', ColorGood);
      end;
    end;
  end;
end;

{ a player comes (or the script starts) }
procedure LfSetup(ID: Integer);
var
  k: Integer;
begin
  DwDown[ID] := False;
  DwTookW[ID] := -1;
  DwNoneLeft[ID] := 0;
  DwDowns[ID] := 0;
  DwProtect[ID] := 0;
  DwKilling[ID] := 0;
  DwLayerOf[ID] := -1;
  BdShockUntil[ID] := 0;
  BdWorkKind[ID] := 0;
  BdBlood[ID] := 100;
  BdWounds[ID] := 0;
  BdWorst[ID] := 0;
  BdBand[ID] := 100;
  BdKits[ID] := 0;
  LfBotDummy[ID] := False;
  BnKills[ID] := 0;
  BnPrice[ID] := 0;
  SgNextOk[ID] := 0;
  SgAimAt[ID] := 0;
  SgKeyWas[ID] := False;
  for k := 0 to 4 do
  begin
    SgUntil[ID][k] := 0;
    SgMarkIt[ID][k] := False;
  end;
  CyKept[ID] := False;
  CyPending[ID] := 0;
  CyRoundHit[ID] := -1;
  for k := 1 to 14 do
  begin
    CyLocked[ID][k] := False;
    CyLockPend[ID][k] := False;
  end;
  CyAnyLock[ID] := False;
  if BeOk then
  begin
    BE_BodyForget(ID);
    { the script's copy of his kits and bandage as the library has them now (it tells only changes later) }
    BdSync(ID);
  end;
end;

{ he leaves: his bounty goes, nothing of him stays }
procedure LfLeave(ID: Integer);
var
  v: Integer;
begin
  for v := 1 to 32 do
    if DwBy[v] = ID then
      DwBy[v] := 0;
  BnDrop(ID, 'he left');
  DwClear(ID);
  if BdShockUntil[ID] > 0 then
    BdShockEnd(ID);
  LfBotHold(ID, False);
  CyDrop(ID);
  LfSetup(ID);
end;

{ a new map: nobody down, no bounty, nothing spotted, nothing kept }
procedure LfMapStart();
var
  i: Integer;
begin
  for i := 1 to 32 do
  begin
    DwClear(i);
    if BdShockUntil[i] > 0 then
      BdShockEnd(i);
    CyDrop(i);
    LfSetup(i);
  end;
  DwCount := 0;
  BdShockCount := 0;
  SgAny := 0;
  { no spots left to mark (a mark on screen fades by itself in 1.5 s) }
  SgMarkAny := False;
  for i := 1 to 255 do
    DwKillB[i] := 0;
  if BeOk then
    BE_SpotClear();
  LfRefresh();
end;

