{ ======================= [Bleeding], [Downed], [Spotting], [Bounty]: settings ======================= }

{ the game modes a module works in (dm pm tm ctf rm inf htf): bit k = Game.GameStyle k }
function ModeBits(Section, Def: string): Integer;
var
  S, W: string;
  p: Integer;
begin
  Result := 0;
  S := ReplaceAll(ReplaceAll(LowerCase(Trim(CfgStr(Section, 'Modes', Def))), ',', '|'), ' ', '|') + '|';
  while S <> '' do
  begin
    p := Pos('|', S);
    W := Trim(Copy(S, 1, p - 1));
    Delete(S, 1, p);
    if W = 'dm' then
      Result := Result or 1
    else if W = 'pm' then
      Result := Result or 2
    else if W = 'tm' then
      Result := Result or 4
    else if W = 'ctf' then
      Result := Result or 8
    else if W = 'rm' then
      Result := Result or 16
    else if W = 'inf' then
      Result := Result or 32
    else if W = 'htf' then
      Result := Result or 64
    else if W <> '' then
      CfgWarn(Section, 'Modes', W, 'dm, pm, tm, ctf, rm, inf or htf');
  end;
end;

function GameStyleNow(): Integer;
begin
  Result := Game.GameStyle;
  if (Result < 0) or (Result > 7) then
    Result := 0;
end;

procedure BdPut(Key: Integer; Value: Single);
begin
  if BeOk then
    BE_BodySet(Key, Value);
end;

{ [Bleeding] / [Downed]: on now - a game mode of Modes (Downed: survival only with SurvivalOnly), the
  library running }
procedure LfRefresh();
var
  Was: Boolean;
  S: Integer;
begin
  S := GameStyleNow();
  Was := BdActive;
  BdActive := False;
  BdIdleWhy := 'switched off';
  if BdEnabled then
  begin
    if not BeOk then
      BdIdleWhy := 'it needs the script''s library, which is not running'
    else if not BdModeOk[S] then
      BdIdleWhy := 'this game mode is not in [Bleeding] Modes'
    else
    begin
      BdActive := True;
      BdIdleWhy := '';
    end;
    if BdActive <> Was then
    begin
      if BdActive then
        Log('[Bleeding] on')
      else
        Log('[Bleeding] idle: ' + BdIdleWhy);
    end;
  end;
  Was := DwActive;
  DwActive := False;
  DwIdleWhy := 'switched off';
  if DwEnabled then
  begin
    if not BeOk then
      DwIdleWhy := 'it needs the script''s library, which is not running'
    else if not DwModeOk[S] then
      DwIdleWhy := 'this game mode is not in [Downed] Modes'
    else if DwSurvivalOnly and not Game.Survival then
      DwIdleWhy := 'survival mode is off ([Downed] SurvivalOnly = 1)'
    else
    begin
      DwActive := True;
      DwIdleWhy := '';
    end;
    if DwActive <> Was then
    begin
      if DwActive then
        Log('[Downed] on')
      else
        Log('[Downed] idle: ' + DwIdleWhy);
    end;
  end;
  BdPut(BDC_ON, BoolInt(BdActive) * 1.0);
  BdPut(BDC_DOWN, BoolInt(DwActive) * 1.0);
  BdPut(BDC_TEAMS, BoolInt(TeamGame()) * 1.0);
  { [Spotting]: only in the team modes it works in }
  SgActive := False;
  SgIdleWhy := 'switched off';
  if SgEnabled then
  begin
    if not BeOk then
      SgIdleWhy := 'it needs the script''s library, which is not running'
    else if not SgModeOk[S] then
      SgIdleWhy := 'this game mode is not in [Spotting] Modes'
    else
    begin
      SgActive := True;
      SgIdleWhy := '';
    end;
  end;
  BnActive := False;
  BnIdleWhy := 'switched off';
  if BnEnabled then
  begin
    if not BnModeOk[S] then
      BnIdleWhy := 'this game mode is not in [Bounty] Modes'
    else
    begin
      BnActive := True;
      BnIdleWhy := '';
    end;
  end;
end;

