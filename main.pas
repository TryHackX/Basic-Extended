  RyWhat := 0;
  if Pos('mags|', S) > 0 then
    RyWhat := RyWhat or 1;
  if Pos('grenades|', S) > 0 then
    RyWhat := RyWhat or 2;
  if Pos('bandage|', S) > 0 then
