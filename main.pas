{ [SpawnProtection]: on now - a game mode of Modes }
procedure SfRefresh();
var
  Was: Boolean;
begin
  Was := SfActive;
  SfActive := False;
  SfIdleWhy := 'switched off';
  if SfEnabled then
  begin
    if ((SfModes shr GameStyleNow()) and 1) = 0 then
      SfIdleWhy := 'this game mode is not in [SpawnProtection] Modes'
    else
    begin
      SfActive := True;
      SfIdleWhy := '';
    end;
    if SfActive <> Was then
    begin
      if SfActive then
        Log('[SpawnProtection] on')
      else
        Log('[SpawnProtection] idle: ' + SfIdleWhy);
    end;
  end;
end;

