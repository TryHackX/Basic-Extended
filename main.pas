{ [Supply] works in the shop's modes (everywhere without the shop); switched off: the crates are gone }
procedure SuRefresh();
var
  Was: Boolean;
  k: Integer;
begin
  Was := SuActive;
  SuActive := SuEnabled and (((ShModes shr GameStyleNow()) and 1) <> 0);
  if SuEnabled and not ShEnabled then
    SuActive := SuEnabled;
