    IntToStr(ShStatSpent) + ', AP blasts ' + IntToStr(ShStatAp), ColorGood);
end;


{ ---------------- the earnings ---------------- }

{ a kill (OnKill, before the other modules looked): the killer's money (the weapon's factor, a headshot, a
  bot's kill less), the victim's penalties; a death loses what was bought (LoseOnDeath) - the round's end of
  survival is no death: the survivors keep it }
procedure ShKill(K, V, B, Tick: Integer; RoundEnd: Boolean);
var
  W, Base, i: Integer;
  F, BotF: Single;
  Why: string;
  Known: Boolean;
begin
  if not ShActive then
    Exit;
  if RoundEnd then
  begin
    { alive at the end of the round: SurviveMoney; his team was alive }
    if ShRoundEndTick <> Tick then
    begin
      ShRoundEndTick := Tick;
      ShAliveTeams := 0;
      ShRoundDone := False;
    end;
    if (TeamOf[V] >= 0) and (TeamOf[V] <= 5) then
      ShAliveTeams := ShAliveTeams or (1 shl TeamOf[V]);
    { SurviveMoney when the round's end is confirmed (ShRoundResult: nobody alive any more) }
    ShSurv[V] := True;
    { BuyOnly: a survivor keeps the weapons in his hands for the next round (the game drops them after this) }
    if ShBuyOnly then
    begin
      ShOwnSet(V, PL[V].Primary.WType, True);
      ShOwnSet(V, PL[V].Secondary.WType, True);
    end;
    Exit;
  end;
  { the victim: a death }
  if ShLoseOnDeath then
  begin
    ShApLeft[V] := 0;
    if MnEnabled then
    begin
      if (ShShopOnly and 1) <> 0 then
        MnHave[V] := 0;
      if (ShShopOnly and 2) <> 0 then
        MnHaveC[V] := 0;
    end;
    if ShBuyOnly then
      ShOwnClear(V);
  end
  else if ShBuyOnly then
  begin
    { the weapons in his hands are his from now on (picked up ones too) }
    ShOwnSet(V, PL[V].Primary.WType, True);
    ShOwnSet(V, PL[V].Secondary.WType, True);
  end;
  if K = V then
  begin
    if ShSelfMoney <> 0 then
      if OwnSuicide(V, Tick) then
        ShEarn(V, ShSelfMoney, 1, 'suicide');
    Exit;
  end;
  if (K < 1) or (K > 32) then
    Exit;
  if not Enemies(K, V) then
  begin
    if ShTkMoney <> 0 then
      ShEarn(K, ShTkMoney, 1, 'team kill');
    Exit;
  end;
  { the weapon of the kill: the bullet's (a grenade, a cluster, a stationary gun, a script's bullet have no factor of
    their own: 1); the weapon in his hands only when no bullet killed }
  W := -1;
  Known := False;
  if (B >= 1) and (B <= MAX_BULLET_ID) then
    if BL[B].Owner = K then
    begin
      W := BL[B].GetOwnerWeaponId;
      Known := True;
    end;
  if MnBulletKind(B, K) > 0 then
    W := 17;
  if not Known then
    if (W < 0) or (W > 17) then
      W := PL[K].Primary.WType;
  F := 1;
  if (W >= 0) and (W <= 17) then
    F := ShKillW[W];
  BotF := 1;
  if not HumanOf[V] then
    BotF := ShBotKill;
  F := F * BotF;
  { the same enemy again within a minute: from the third kill on RepeatKillPercent }
  if (ShVicLast[K] = V) and (Tick - ShVicTick[K] < 3600) then
    ShVicN[K] := ShVicN[K] + 1
  else
    ShVicN[K] := 0;
  ShVicLast[K] := V;
  ShVicTick[K] := Tick;
  if ShVicN[K] >= 2 then
    F := F * ShRepeatPct / 100;
  Why := 'kill';
  Base := ShKillMoney;
  ShEarn(K, Base, F, Why);
  if ShHeadMoney <> 0 then
    if ShLastPart[V] = 12 then
      if ShLastPartTick[V] = Tick then
        ShEarn(K, ShHeadMoney, BotF, 'headshot');
  ShLastPart[V] := 0;
  { AssistMoney: the others who did AssistPercent of the damage to him }
  if ShAssistMoney <> 0 then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if (i <> K) and (i <> V) then
          if Enemies(i, V) then
            if Dealt[i][V] * 100 >= ShAssistPct * MaxHealth then
              ShEarn(i, ShAssistMoney, BotF, 'assist');
end;

{ the damage done to enemies (DmgSettle adds it up): DamageMoney for every whole health, once a second }
procedure ShDamagePay(S: Integer);
var
  n: Integer;
begin
  if ShDamageMoney = 0 then
  begin
    ShDamageAcc[S] := 0;
    Exit;
  end;
  n := Trunc(ShDamageAcc[S] / MaxHealth);
  if n > 0 then
  begin
    ShDamageAcc[S] := ShDamageAcc[S] - n * MaxHealth;
    ShEarn(S, ShDamageMoney * n, 1, 'damage');
  end;
end;

{ OnDamage, a hit that kills: the place it hit (HeadshotMoney) }
procedure ShLethal(V, B: Integer);
begin
  if not ShActive then
    Exit;
  if ShHeadMoney = 0 then
    Exit;
  if not BeOk then
    Exit;
  if (B < 1) or (B > MAX_BULLET_ID) then
    Exit;
  ShLastPart[V] := BE_BodyHitPart(V, BL[B].Style, BL[B].X, BL[B].Y, BL[B].VelX, BL[B].VelY);
  ShLastPartTick[V] := Game.TickCount;
end;

procedure ShCapture(ID, Tick: Integer);
var
  i: Integer;
begin
  if not ShActive then
    Exit;
  ShCapTeam := TeamOf[ID];
  ShCapTick := Tick;
  if ShCapMoney <> 0 then
    ShEarn(ID, ShCapMoney, 1, 'capture');
  if ShTeamCapMoney <> 0 then
    for i := 1 to TopSlot do
      if i <> ID then
        if ActiveSlot[i] then
          if TeamOf[i] = TeamOf[ID] then
            ShEarn(i, ShTeamCapMoney, 1, 'team capture');
end;

{ [Bounty]: the bounty collected - money too }
procedure ShBountyPaid(K, Price: Integer);
begin
  if not ShActive then
    Exit;
  if ShBountyMoney <> 0 then
    if Price > 0 then
      ShEarn(K, ShBountyMoney * Price, 1, 'bounty');
end;

{ a survival round is over (two ticks after the blows): the team still alive - or the one that captured - won;
  the others lost (more with every round lost in a row) }
procedure ShRoundResult(Tick: Integer);
var
  Win, Tm, n, i, k: Integer;
begin
  ShRoundDone := True;
  { the round's end really came: the server killed every survivor - somebody still alive means it was another
    death (an exploding polygon) - nothing is paid }
  n := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if (TeamOf[i] >= 1) and (TeamOf[i] <= 4) then
        if PL[i].Alive then
          n := n + 1;
  if n > 0 then
  begin
    for i := 1 to 32 do
      ShSurv[i] := False;
    Exit;
  end;
  for i := 1 to TopSlot do
    if ShSurv[i] then
    begin
      ShSurv[i] := False;
      if ActiveSlot[i] then
        if ShSurviveMoney <> 0 then
          ShEarn(i, ShSurviveMoney, 1, 'survived');
    end;
  ShRound := ShRound + 1;
  Win := -1;
  if (ShCapTick > 0) and (Tick - ShCapTick < 600) then
    Win := ShCapTeam
  else
  begin
    n := 0;
    for Tm := 1 to 4 do
      if (ShAliveTeams and (1 shl Tm)) <> 0 then
      begin
        n := n + 1;
        Win := Tm;
      end;
    if n <> 1 then
      Win := -1;
  end;
  if (Win < 1) or (Win > 4) then
    Exit;
  for Tm := 1 to 4 do
    if Tm = Win then
      ShLossRow[Tm] := 0
    else
      ShLossRow[Tm] := ShLossRow[Tm] + 1;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      Tm := TeamOf[i];
      if (Tm >= 1) and (Tm <= 4) then
      begin
        if Tm = Win then
        begin
          if ShWinMoney <> 0 then
            ShEarn(i, ShWinMoney, 1, 'round won');
        end
        else
        begin
          k := ShLossRow[Tm] - 1;
          if k > ShStreakMax then
            k := ShStreakMax;
          if k < 0 then
            k := 0;
          if ShLossMoney + ShStreakMoney * k <> 0 then
            ShEarn(i, ShLossMoney + ShStreakMoney * k, 1, 'round lost');
        end;
      end;
    end;
end;

{ ---------------- explosive armour-piercing rounds ---------------- }

{ the blast: ApBlasts clusters of the owner where the round met a soldier or a wall }
procedure ShApBlast(Owner: Integer; X, Y: Single);
var
  k, n: Integer;
begin
  if (Owner < 1) or (Owner > 32) then
    Exit;
  if not ActiveSlot[Owner] then
    Exit;
  if not BulletRoom(ShApBlasts) then
    Exit;
  for k := 0 to ShApBlasts - 1 do
    n := ScriptBullet(X, Y - 2, (k - (ShApBlasts - 1) * 0.5) * 0.8, -0.5, ShApPower, 10, PL[Owner]);
  ShStatAp := ShStatAp + 1;
end;

procedure ShApForget(k: Integer);
begin
  ShApCount := ShApCount - 1;
  ShApSlot[k] := ShApSlot[ShApCount];
  ShApOwner[k] := ShApOwner[ShApCount];
  ShApTick[k] := ShApTick[ShApCount];
  ShApStyle[k] := ShApStyle[ShApCount];
  ShApX[k] := ShApX[ShApCount];
  ShApY[k] := ShApY[ShApCount];
  ShApWall[k] := ShApWall[ShApCount];
end;

{ the hook saw a Barrett round of an owner with AP rounds (T: the tick it belongs to): it is one; its wall is known
  now. The round meets the wall in the server's frame T + t - 1 (a game client's round, moved first in frame T) or
  T + t - 2 (a bot's, made and moved once in the frame before T); the script's tick runs before its frame. }
procedure ShApShot(Owner, Slot, St: Integer; X, Y, VX, VY: Single; T, Tick: Integer);
var
  t0, k: Integer;
  HX, HY: Single;
begin
  if (Owner < 1) or (Owner > 32) then
    Exit;
  { it blasted at a soldier already, in its first move before this report }
  if (Slot >= 1) and (Slot <= 255) then
    if ShApSpent[Slot] <> 0 then
    begin
      k := ShApSpent[Slot];
      ShApSpent[Slot] := 0;
      if k >= T - 1 then
        if ShApSpentBy[Slot] = Owner then
          Exit;
    end;
  if ShApLeft[Owner] <= 0 then
    Exit;
  ShApLeft[Owner] := ShApLeft[Owner] - 1;
  { the same slot made again: the old round is gone - at its wall if it was due about now }
  for k := ShApCount - 1 downto 0 do
    if ShApSlot[k] = Slot then
    begin
      if ShApWall[k] then
        if Tick + 2 >= ShApTick[k] then
        begin
          ShApBlast(ShApOwner[k], ShApX[k], ShApY[k]);
          ShStatApWall := ShStatApWall + 1;
        end;
      ShApForget(k);
    end;
  if ShApCount > 63 then
    Exit;
  t0 := -1;
  if BeOk then
    if MapOk then
      t0 := BE_ShopApPredict(St, X, Y, VX, VY, 180, TeamOf[Owner], HX, HY);
  ShApSlot[ShApCount] := Slot;
  ShApOwner[ShApCount] := Owner;
  ShApStyle[ShApCount] := St;
  if t0 > 0 then
  begin
    if HumanOf[Owner] then
      ShApTick[ShApCount] := T + t0 - 1
    else
      ShApTick[ShApCount] := T + t0 - 2;
    ShApWall[ShApCount] := True;
    ShApX[ShApCount] := HX;
    ShApY[ShApCount] := HY;
  end
  else
  begin
    ShApTick[ShApCount] := Tick + 180;
    ShApWall[ShApCount] := False;
    ShApX[ShApCount] := 0;
    ShApY[ShApCount] := 0;
  end;
  ShApCount := ShApCount + 1;
  if ShApLeft[Owner] = 0 then
    Say(Owner, 'Your explosive rounds are spent.', ShColor);
end;

{ OnDamage of a marked round (or of a Barrett round of an owner with AP rounds the hook's report has not
  brought yet): the blast at the soldier, once; Dmg = False: the hit did nothing }
procedure ShApHit(S, V, B: Integer; Dmg: Boolean);
var
  k: Integer;
  Found, Mark: Boolean;
begin
  if (B < 1) or (B > MAX_BULLET_ID) then
    Exit;
  Found := False;
  Mark := False;
  for k := ShApCount - 1 downto 0 do
    if ShApSlot[k] = B then
      if ShApOwner[k] = S then
      begin
        ShApForget(k);
        Mark := True;
      end;
  { the mark is this bullet's only while the slot holds a Barrett round (his other bullets reuse the slots) }
  if Mark then
    if BL[B].GetOwnerWeaponId = 8 then
      Found := True;
  { the hit did nothing (spawn protection, a blocked team hit): the round stopped there, no blast }
  if not Dmg then
    Exit;
  if not Found then
  begin
    if (S < 1) or (S > 32) then
      Exit;
    if ShApLeft[S] <= 0 then
      Exit;
    if BL[B].Owner <> S then
      Exit;
    if BL[B].GetOwnerWeaponId <> 8 then
      Exit;
    ShApLeft[S] := ShApLeft[S] - 1;
    ShApSpent[B] := Game.TickCount;
    ShApSpentBy[B] := S;
  end;
  ShApBlast(S, PL[V].X, PL[V].Y - 10);
end;

{ a marked round at its wall: the blast there - the round met the wall or meets it in this tick's frame (taken
  out while it still flies); a round with no wall ahead is forgotten }
procedure ShApTickRun(Tick: Integer);
var
  k, Act, Own, W, St, TOut: Integer;
  Same: Boolean;
begin
  for k := ShApCount - 1 downto 0 do
    if Tick >= ShApTick[k] then
    begin
      if ShApWall[k] then
      begin
        Same := False;
        Act := 0;
        Own := 0;
        W := 0;
        St := 0;
        if BeOk then
          if BE_BulletInfo(ShApSlot[k], Act, Own, W, St, TOut) = 1 then
            if Act <> 0 then
              if Own = ShApOwner[k] then
                if St = ShApStyle[k] then
                  if W = 8 then
                    Same := True;
        ShApBlast(ShApOwner[k], ShApX[k], ShApY[k]);
        ShStatApWall := ShStatApWall + 1;
        if Same then
          Act := BE_BulletKill(ShApSlot[k], Own, St);
      end;
      ShApForget(k);
    end;
end;

{ the tick, after the hook's reports of this tick (FnTick): the Barrett rounds reported, the walls met now; a
  pause holds the rounds in the air - their ticks wait }
procedure ShApStage(Tick: Integer);
var
  k: Integer;
begin
  for k := 0 to ShQN - 1 do
    ShApShot(ShQOwner[k], ShQSlot[k], ShQStyle[k], ShQX[k], ShQY[k], ShQVX[k], ShQVY[k], ShQT[k], Tick);
  ShQN := 0;
  if ShApCount <= 0 then
    Exit;
  if PausedNow then
  begin
    for k := 0 to ShApCount - 1 do
      ShApTick[k] := ShApTick[k] + 1;
    Exit;
  end;
  ShApTickRun(Tick);
end;

{ ---------------- the stationary guns of the shop, the life of a player ---------------- }

procedure ShStatTick(Tick: Integer);
var
  k: Integer;
begin
  if not ShStatLive then
    Exit;
  ShStatLive := False;
  for k := 0 to 15 do
    if ShStatObj[k] > 0 then
    begin
      if Tick >= ShStatEnd[k] then
      begin
        if OB[ShStatObj[k]].Active then
          if OB[ShStatObj[k]].Style = 27 then
            OB[ShStatObj[k]].Kill;
        if (ShStatOwner[k] >= 1) and (ShStatOwner[k] <= 32) then
          if ActiveSlot[ShStatOwner[k]] then
            Say(ShStatOwner[k], 'Your stationary gun is gone.', ShColor);
        ShStatObj[k] := 0;
      end
      else
        ShStatLive := True;
    end;
end;

{ a new life: the buy time starts; the round's money; ShopOnly: no free supply of the modules; BuyOnly: his
  menu, his owned weapon }
procedure ShRespawn(ID, Tick: Integer);
var
  It: Integer;
begin
  if not ShActive then
    Exit;
  { the respawn before the join: the join sets the first life up (ShJoin, SetupPlayer) }
  if not ActiveSlot[ID] then
    Exit;
  ShLastPart[ID] := 0;
  ShSpawnTick[ID] := Tick;
  for It := 0 to IT_LAST do
    ShBought[ID][It] := 0;
  if Game.Survival then
    if ShRoundPaid[ID] <> ShRound then
    begin
      ShRoundPaid[ID] := ShRound;
      if ShStartRound <> 0 then
        ShEarn(ID, ShStartRound, 1, 'round');
    end;
  { the modules' free supply stops (a survivor keeps what he had: the carry-over) }
  if not CyWasKept[ID] then
  begin
    if (ShShopOnly and 8) <> 0 then
      if FnEnabled then
      begin
        FnFlashLeft[ID] := 0;
        FnNeed[ID] := True;
      end;
    if (ShShopOnly and 4) <> 0 then
      if RkEnabled then
        RkUsed[ID] := RkRockets;
  end;
  if ShBuyOnly then
  begin
    ShMaskSend(ID);
    ShCheckTick[ID] := Tick + 3;
  end;
  HudMark(ID, False);
end;

{ BuyOnly: a weapon he does not own in his hands right after the respawn is taken (the menu of a game client
  shows only his own; the server's bots and an altered client do not care) }
procedure ShBuyOnlyCheck(ID: Integer);
var
  P: TActivePlayer;
  W, S: Integer;
  OkW, OkS: Boolean;
  NW, NS: TNewWeapon;
begin
  P := PL[ID];
  if not P.Alive then
    Exit;
  { Bots = 0: the bots do not shop - they keep the server's weapons }
  if not HumanOf[ID] then
    if not ShBots then
      Exit;
  W := P.Primary.WType;
  S := P.Secondary.WType;
  OkW := ShOwnsWeapon(ID, W);
  OkS := ShOwnsWeapon(ID, S);
  if OkW and OkS then
    Exit;
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NS.WType := WEP_NONE;
    NW.WType := WEP_NONE;
    if OkW then
    begin
      NW.WType := W;
      NW.Ammo := P.Primary.Ammo;
    end
    else if OkS then
    begin
      NW.WType := S;
      NW.Ammo := P.Secondary.Ammo;
    end;
    P.ForceWeapon(NW, NS);
    AmGiven(ID);
  finally
    NW.Free;
    NS.Free;
  end;
  AcAmmoTouched(ID);
  if HumanOf[ID] then
  begin
    if not OkW then
      Say(ID, 'BuyOnly: the ' + WeaponName(W) + ' is not yours - buy it (!shop weapons).', ShBadColor)
    else
      Say(ID, 'BuyOnly: the ' + WeaponName(S) + ' is not yours - buy it (!shop weapons).', ShBadColor);
  end;
end;

{ OnWeaponChange, BuyOnly: a weapon not his chosen in the first 3 s of a life (the menu) is taken in the next
  ticks; later it is a weapon picked up - his for the life, and his own once he dies or survives the round }
procedure ShWeaponSeen(ID, W, S: Integer);
begin
  if not ShActive then
    Exit;
  if not PL[ID].Alive then
    Exit;
  if Game.TickCount - ShSpawnTick[ID] > 180 then
    Exit;
  if ShOwnsWeapon(ID, W) and ShOwnsWeapon(ID, S) then
    Exit;
  ShCheckTick[ID] := Game.TickCount + 2;
end;

{ the keys of his wallet kept on this map: the key of his saved choices (Steam id, computer id or name) and
  his computer id (at the join the Steam id is not known yet) }
function ShMapKey(ID: Integer; Second: Boolean): string;
begin
  Result := '';
  if Second then
  begin
    if HumanOf[ID] then
      if Trim(PL[ID].HWID) <> '' then
        Result := 'H' + Trim(PL[ID].HWID);
  end
  else
    Result := AdKeyOf(ID);
  Result := ReplaceAll(Result, '=', '_');
end;

{ his wallet kept on this map (-1: none); it is taken out of the list }
function ShMapTake(ID: Integer): Integer;
var
  k, n: Integer;
  K0: string;
begin
  Result := -1;
  if ShMapStore = nil then
    Exit;
  for n := 0 to 1 do
  begin
    K0 := ShMapKey(ID, n = 1);
    if K0 <> '' then
    begin
      k := ShMapStore.IndexOfName(K0);
      if k >= 0 then
      begin
        if Result < 0 then
          Result := StrToIntDef(Copy(ShMapStore[k], Pos('=', ShMapStore[k]) + 1, 20), -1);
        ShMapStore.Delete(k);
      end;
    end;
  end;
end;

{ the join: a wallet (the map's start money, a wallet kept from earlier on this map, or the account) }
procedure ShJoin(ID, Tick: Integer);
var
  k, It: Integer;
begin
  ShMoney[ID] := 0;
  ShEarned[ID] := 0;
  ShSpent[ID] := 0;
  ShDelta[ID] := 0;
  ShKey[ID] := '';
  ShLoaded[ID] := False;
  ShDirty[ID] := False;
  ShJoinTick[ID] := Tick;
  ShSpawnTick[ID] := Tick;
  ShNextBuy[ID] := 0;
  ShIncomeAt[ID] := Tick + ShIncomeTicks;
  ShGainSum[ID] := 0;
  ShGainUntil[ID] := 0;
  ShDamageAcc[ID] := 0;
  ShApLeft[ID] := 0;
  ShLastPart[ID] := 0;
  ShRoundPaid[ID] := ShRound;
  ShCheckTick[ID] := 0;
  ShMaskLast[ID] := -2;
  ShResetPending[ID] := False;
  for It := 0 to IT_LAST do
    ShBought[ID][It] := 0;
  ShOwnClear(ID);
  ShNoAcct[ID] := False;
  if not ShEnabled then
    Exit;
  { BuyOnly: the server respawned him before his join (2.8.2) - his first life is checked too }
  if ShActive then
    if ShBuyOnly then
      if PL[ID].Alive then
      begin
        ShSpawnTick[ID] := Tick;
        ShMaskForce(ID);
        ShCheckTick[ID] := Tick + 3;
      end;
  if ShGlobal then
    if HumanOf[ID] then
    begin
      ShLoadAccount(ID);
      if not ShLoaded[ID] then
        ShMoney[ID] := 0;
      Exit;
    end;
  ShMoney[ID] := ShStartMoney;
  k := ShMapTake(ID);
  if k >= 0 then
    ShMoney[ID] := k;
  if ShMoney[ID] > ShMax() then
    ShMoney[ID] := ShMax();
end;

{ Steam answered: the account (global) }
procedure ShSteam(ID: Integer);
begin
  if ShEnabled then
    if ShGlobal then
      ShLoadAccount(ID);
end;

{ his wallet is kept on this map by his keys (a player who comes back to this map gets it) }
procedure ShMapPut(ID: Integer);
var
  k, n: Integer;
  K0: string;
begin
  if ShMapStore = nil then
    Exit;
  k := ShMapTake(ID);
  for n := 0 to 1 do
  begin
    K0 := ShMapKey(ID, n = 1);
    if K0 <> '' then
      if ShMapStore.IndexOfName(K0) < 0 then
      begin
        if ShMapStore.Count >= 400 then
          ShMapStore.Delete(0);
        ShMapStore.Add(K0 + '=' + IntToStr(ShMoney[ID]));
      end;
  end;
end;

procedure ShLeave(ID: Integer);
var
  k: Integer;
  Keep: Boolean;
begin
  if not ShEnabled then
    Exit;
  { the global economy: the account; a map's wallet for the others (bots, no account) - a player who
    returns to this map gets it back (he cannot rejoin for new start money) }
  Keep := True;
  if ShGlobal then
    if HumanOf[ID] then
    begin
      ShSave(ID);
      Keep := ShNoAcct[ID];
    end;
  if Keep then
    ShMapPut(ID);
  for k := 0 to 15 do
    if ShStatOwner[k] = ID then
      ShStatEnd[k] := 0;
end;

{ the script stops (/recompile, the server's end): the accounts are saved; this map's wallets wait in the data
  folder for the next start of the script on the same map (within a minute) }
procedure ShCleanUp();
var
  i: Integer;
  L: TStringList;
begin
  if not ShEnabled then
    Exit;
  for i := 1 to 32 do
    if ActiveSlot[i] then
    begin
      if ShLoaded[i] then
      begin
        if ShDirty[i] then
          ShSave(i);
      end
      else if not (ShGlobal and HumanOf[i] and (not ShNoAcct[i])) then
        ShMapPut(i);
    end;
  if ShMapStore = nil then
    Exit;
  L := File.CreateStringList();
  L.Add(Game.CurrentMap);
  L.Add(IntToStr(Game.TickCount));
  for i := 0 to ShMapStore.Count - 1 do
    L.Add(ShMapStore[i]);
  try
    L.SaveToFile(DataDir + 'shop_wallets.txt');
  except
    Log('[Shop] cannot write ' + DataDir + 'shop_wallets.txt');
  end;
  L.Free;
end;

{ the start: the wallets the last stop kept, when it was on this map less than a minute ago }
procedure ShWalletsBack();
var
  L: TStringList;
  i, T: Integer;
begin
  if not ShEnabled then
    Exit;
  if ShMapStore = nil then
    Exit;
  if not File.Exists(DataDir + 'shop_wallets.txt') then
    Exit;
  L := File.CreateStringListFromFile(DataDir + 'shop_wallets.txt');
  if L.Count >= 2 then
    if L[0] = Game.CurrentMap then
    begin
      T := StrToIntDef(L[1], -1);
      if T >= 0 then
        if Game.TickCount >= T then
          if Game.TickCount - T <= 3600 then
            for i := 2 to L.Count - 1 do
              if Pos('=', L[i]) > 1 then
                ShMapStore.Add(L[i]);
    end;
  L.Free;
end;

{ a new map: the map economy starts again; the global accounts are saved }
procedure ShMapStart();
var
  i, k: Integer;
begin
  for i := 1 to 32 do
  begin
    if ActiveSlot[i] then
    begin
      { the global economy: the accounts are saved; a player whose account is still coming keeps waiting }
      if ShLoaded[i] then
        ShSave(i)
      else if not (ShGlobal and HumanOf[i] and (not ShNoAcct[i])) then
        ShMoney[i] := ShStartMoney;
      ShApLeft[i] := 0;
      ShOwnClear(i);
      HudMark(i, False);
    end;
  end;
  if ShMapStore <> nil then
    ShMapStore.Clear;
  for k := 0 to 15 do
    ShStatObj[k] := 0;
  ShStatLive := False;
  ShApCount := 0;
  ShQN := 0;
  ShRoundEndTick := 0;
  ShRoundDone := True;
  ShCapTick := 0;
  for k := 0 to 5 do
    ShLossRow[k] := 0;
  ShRefresh();
end;

{ a bot shops at its respawn (Bots = 1): now and then a weapon for half of its money and a vest. BuyOnly: every
  time - the server's bots choose from all the weapons (the menu is a game client's): a weapon not its own is
  taken, it gets the best one of its own, else it buys the one the server chose (or another one it can pay) }
procedure ShBotBuy(ID: Integer);
var
  It, Best, BestPr, Pr, W, n, Lim: Integer;
  Need: Boolean;
begin
  if not ShBots then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if HumanOf[ID] then
    Exit;
  W := PL[ID].Primary.WType;
  Need := True;
  if ShBuyOnly then
  begin
    if (W >= 1) and (W <= 10) then
      if ShOwnsWeapon(ID, W) then
        Need := False;
    if Need then
    begin
      ShBuyOnlyCheck(ID);
      Best := -1;
      BestPr := -1000000;
      for It := 1 to 10 do
        if ShOwned[ID][It] then
          if ShWeaponOk(It) and ClsShopAllows(ID, It) then
            if ShPrice[It] > BestPr then
            begin
              Best := It;
              BestPr := ShPrice[It];
            end;
      if Best >= 0 then
      begin
        ShGiveWeapon(ID, Best);
        Need := False;
      end;
    end;
  end
  else if Random(0, 100) >= 40 then
    Need := False;
  if Need then
  begin
    Best := -1;
    if ShBuyOnly then
      if (W >= 1) and (W <= 10) then
        if ShWeaponOk(W) and ClsShopAllows(ID, W) then
        begin
          Pr := ShPriceOf(ID, W);
          if (Pr > 0) and (Pr <= ShMoney[ID]) then
            Best := W;
        end;
    { one it can pay for - without BuyOnly with half of its money at most }
    Lim := ShMoney[ID];
    if not ShBuyOnly then
      Lim := ShMoney[ID] div 2;
    if Best < 0 then
    begin
      n := 0;
      for It := 1 to 10 do
        if It <> W then
          if ShWeaponOk(It) and ClsShopAllows(ID, It) then
          begin
            Pr := ShPriceOf(ID, It);
            if (Pr > 0) and (Pr <= Lim) then
            begin
              n := n + 1;
              if Random(0, n) = 0 then
                Best := It;
            end;
          end;
    end;
    if Best >= 0 then
      ShBuy(ID, Best);
  end;
  if ShPriceOf(ID, IT_VEST) > 0 then
    if ShPriceOf(ID, IT_VEST) * 2 <= ShMoney[ID] then
      if Random(0, 100) < 40 then
      begin
        ShNextBuy[ID] := 0;
        ShBuy(ID, IT_VEST);
      end;
end;

{ the tick: the AP rounds, the stationary guns, the round's result, the income, saving, BuyOnly checks }
procedure ShTickRun(Tick: Integer);
var
  i, k: Integer;
begin
  { the bounties collected ([Bounty] notes them) }
  if ShBnAny then
  begin
    ShBnAny := False;
    for i := 1 to TopSlot do
      if ShBnPend[i] > 0 then
      begin
        k := ShBnPend[i];
        ShBnPend[i] := 0;
        if ActiveSlot[i] then
          ShBountyPaid(i, k);
      end;
  end;
  { a pause: the stationary guns' clocks wait (moved on afterwards), no income }
  if Tick mod 30 = 0 then
    if not PausedNow then
      ShStatTick(Tick);
  { the tick after the round's end, before the server's respawns of that tick (they come after the scripts' tick):
    nobody may be alive then - else it was no round's end }
  if ShRoundEndTick > 0 then
    if not ShRoundDone then
      if Tick - ShRoundEndTick >= 1 then
        ShRoundResult(Tick);
  if ShBuyOnly then
    for i := 1 to TopSlot do
      if ShCheckTick[i] > 0 then
        if Tick >= ShCheckTick[i] then
        begin
          ShCheckTick[i] := 0;
          if ActiveSlot[i] then
            ShBuyOnlyCheck(i);
        end;
  if Tick mod 60 <> 0 then
    Exit;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      { the account comes late (Steam), the session's money waits for it; no account after 15 s (no Steam): a
        wallet of this map }
      if ShGlobal then
        if not ShLoaded[i] then
        begin
          ShLoadAccount(i);
          if not ShLoaded[i] then
            if not ShNoAcct[i] then
              if Tick - ShJoinTick[i] > 900 then
                if HumanOf[i] then
                begin
                  ShNoAcct[i] := True;
                  k := ShMapTake(i);
                  if k < 0 then
                    k := ShStartMoney;
                  k := k + ShMoney[i];
                  if k > ShMax() then
                    k := ShMax();
                  ShMoney[i] := k;
                  HudMark(i, False);
                end;
        end;
      if ShDirty[i] then
        if Tick - ShSavedTick[i] >= 1200 then
          ShSave(i);
      if ShIncomeMoney <> 0 then
        if not Game.Survival then
          if not PausedNow then
          if Tick >= ShIncomeAt[i] then
          begin
            ShIncomeAt[i] := Tick + ShIncomeTicks;
            if (TeamOf[i] >= 0) and (TeamOf[i] <= 4) then
              ShEarn(i, ShIncomeMoney, 1, 'income');
          end;
      if ShDamageAcc[i] >= MaxHealth then
        ShDamagePay(i);
      if ShGainUntil[i] > 0 then
        if Tick > ShGainUntil[i] then
        begin
          ShGainUntil[i] := 0;
          ShGainSum[i] := 0;
          HudMark(i, False);
        end;
    end;
end;

{ the commands the server must not run itself (the script answers them): /pause, /unpause; /pm of a player;
  /unbanlast with a number or a time; /map with a part of a name }
function AdSuppress(Cmd: Integer; Command: string; Console: Boolean): Boolean;
var
  p: Integer;
  Args: string;
begin
  Result := False;
  p := Pos(' ', Command);
  Args := '';
  if p > 0 then
    Args := Trim(Copy(Command, p + 1, Length(Command)));
  if (Cmd = C_PAUSE) or (Cmd = C_UNPAUSE) then
    Result := PzEnabled
  else if Cmd = C_PM then
    Result := PmEnabled and not Console
  else if Cmd = C_UNBANLAST then
    Result := UbEnabled and (Args <> '')
  else if Cmd = C_MAPPART then
    Result := MmEnabled and not MmExact(Args);
end;

procedure CmdRocket(ID: Integer);
var
  S: string;
  Left: Integer;
begin
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'The rockets are for players in the game.', ColorBad);
    Exit;
  end;
  if not RkEnabled then
  begin
    Say(ID, 'Guided rockets are switched off on this server.', ColorBad);
    Exit;
  end;
  if not BeOk then
  begin
    Say(ID, 'Guided rockets need the script''s library, which is not running.', ColorBad);
    Exit;
  end;
  if RkPerMap then
    S := 'this map'
  else
    S := 'this life';
  Left := RkRockets - RkUsed[ID];
  if Left < 0 then
    Left := 0;
  Say(ID, RkName + ' - guided rockets: ' + IntToStr(Left) + ' of ' + IntToStr(RkRockets) + ' left for ' + S + '.',
    RkColor);
  S := 'How: hold the ';
  if RkLauncher <> RL_FREE then
    S := S + 'loaded ';
  S := S + WeaponName(RkWeapon);
  if RkGround then
    S := S + ' on the ground';
  S := S + ' and keep ' + RkKeysText + ' down';
  if (RkKeys and KM_CROUCH) <> 0 then
    S := S + ' (lying: without crouch)';
  if RkTargetMode = AT_RADIUS then
    S := S + '; the sight looks for an enemy within ' + FloatStr(RkRadius / 14, 0) + ' m of your cursor'
  else if RkTargetMode = AT_CURSOR then
    S := S + '; the sight takes the enemy nearest to the line of your cursor'
  else
    S := S + '; the sight takes the nearest enemy';
  Say(ID, S + ' that you can see (up to ' + FloatStr(RkRange / 14, 0) + ' m).', RkColor);
  if RkLockTicks > 0 then
    Say(ID, 'Found, it locks on him in ' + FloatStr(RkLockTicks * 1.0 / 60, 1) + ' s while the keys stay down - the ' +
      'cursor is free then; let go and it stops. He must stay in sight.', RkColor);
  S := 'It leaves the tube slowly and its motor starts';
  if RkProfile = RP_TOP then
    S := S + '; it climbs and dives on him from above'
  else if RkProfile = RP_AUTO then
    S := S + '; with room above (and him far enough) it climbs and dives on him from above';
  Say(ID, S + '.', RkColor);
  Say(ID, 'Slow it turns tight, fast it turns wide: cover close to him can still stop it, a wall far ahead it ' +
    'flies around.', RkColor);
  if RkLauncher = RL_RELOAD then
    S := 'It leaves from the loaded ' + WeaponName(RkWeapon) + ', which reloads - its rounds stay.'
  else if RkLauncher = RL_ROUND then
    S := 'It takes the round in the ' + WeaponName(RkWeapon) + ', which reloads.'
  else
    S := 'It is extra: the ' + WeaponName(RkWeapon) + ' stays as it is.';
  if RkHudText <> '' then
    S := S + ' The count shows next to your ammunition while you hold it.';
  Say(ID, S, RkColor);
  S := '';
  if FnEnabled then
    if RkBlindTicks < FnMaxTicks then
      S := 'Blinded by a flash you cannot lock until the white fades. ';
  if RkLockWarn then
  begin
    S := S + 'The one it locks on sees the sight';
    if RkWarnSound <> '' then
      S := S + ' and hears a warning';
    S := S + '.';
  end;
  if S <> '' then
    Say(ID, S, RkColor);
end;

procedure CmdGod(ID: Integer; Args: string);
var
  k, T: Integer;
  W, Rest: string;
  NewOn: Boolean;
begin
  Rest := Args;
  W := TakeArg(Rest);
  if not PickTargets(ID, W, True, False, False) then
    Exit;
  NewOn := True;
  if (TgtCount = 1) and (not TgtMany) then
    NewOn := not GodOn[TgtList[0]];
  NewOn := OnOffWord(TakeArg(Rest), not NewOn);
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    GodOn[T] := NewOn;
    if T <> ID then
      Say(T, AdminName(ID) + ' switched your godmode ' + BoolText(NewOn) + '.', ColorGood);
  end;
  Say(ID, 'Godmode ' + BoolText(NewOn) + ': ' + TgtDesc() + '.', ColorGood);
  Log('godmode ' + BoolText(NewOn) + ' for ' + TgtDesc() + ' by ' + AdminName(ID));
end;

procedure CmdHeal(ID: Integer; Args: string);
var
  k, T: Integer;
begin
  if not PickTargets(ID, TakeArg(Args), True, True, False) then
    Exit;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    PL[T].Health := MaxHealth;
    LastHealth[T] := MaxHealth;
    if BdActive then
      BE_BodyHeal(T, BC_KIT, 100);
    HudMark(T, False);
  end;
  Say(ID, 'Healed: ' + TgtDesc() + '.', ColorGood);
end;

procedure CmdSlap(ID: Integer; Args: string);
var
  k, T, N: Integer;
  W, Rest: string;
begin
  Rest := Args;
  W := TakeArg(Rest);
  if not PickTargets(ID, W, False, True, True) then
    Exit;
  N := StrToIntDef(TakeArg(Rest), AdSlapDamage);
  if N < 0 then
    N := 0;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    AdminHit[T] := Game.TickCount;
    if N > 0 then
      PL[T].Damage(T, N);
    PL[T].SetVelocity(Random(-40, 41) * 0.1, -6);
    if T <> ID then
      Say(T, AdminName(ID) + ' slapped you.', ColorBad);
  end;
  Say(ID, 'Slapped (' + IntToStr(N) + '): ' + TgtDesc() + '.', ColorGood);
end;

procedure CmdFreeze(ID: Integer; Args: string);
var
  k, T: Integer;
  W, Rest: string;
  NewOn: Boolean;
begin
  Rest := Args;
  W := TakeArg(Rest);
  if not PickTargets(ID, W, False, False, True) then
    Exit;
  NewOn := True;
  if (TgtCount = 1) and (not TgtMany) then
    NewOn := not FrOn[TgtList[0]];
  NewOn := OnOffWord(TakeArg(Rest), not NewOn);
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    if NewOn and not FrOn[T] then
    begin
      FrOn[T] := True;
      FrX[T] := PL[T].X;
      FrY[T] := PL[T].Y;
      FrAt[T] := 0;
      FrCount := FrCount + 1;
      Say(T, 'An admin froze you.', ColorBad);
    end
    else if (not NewOn) and FrOn[T] then
    begin
      FrOn[T] := False;
      FrCount := FrCount - 1;
      Say(T, 'You can move again.', ColorGood);
    end;
  end;
  if FrCount < 0 then
    FrCount := 0;
  Say(ID, ShIf(NewOn, 'Frozen: ', 'Free again: ') + TgtDesc() + '.', ColorGood);
end;

procedure CmdBring(ID: Integer; Args: string; Bring: Boolean);
var
  k, T, n: Integer;
  X, Y: Single;
begin
  if ID < 1 then
  begin
    Say(ID, 'Only for an admin in the game.', ColorBad);
    Exit;
  end;
  if not PL[ID].Alive then
  begin
    Say(ID, 'You are dead.', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, TakeArg(Args), False, True, True) then
    Exit;
  if not Bring then
  begin
    if TgtCount <> 1 then
    begin
      Say(ID, 'Go to one player.', ColorBad);
      Exit;
    end;
    T := TgtList[0];
    MovePlayer(PL[ID], PL[T].X, PL[T].Y - 10);
    PL[ID].SetVelocity(0, 0);
    Say(ID, 'You went to ' + PL[T].Name + '.', ColorGood);
    Exit;
  end;
  X := PL[ID].X;
  Y := PL[ID].Y - 10;
  n := 0;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    if T = ID then
      Continue;
    MovePlayer(PL[T], X + NearX(n + 1), Y);
    PL[T].SetVelocity(0, 0);
    if FrOn[T] then
    begin
      FrX[T] := X + NearX(n + 1);
      FrY[T] := Y;
    end;
    n := n + 1;
  end;
  Say(ID, 'Brought to you: ' + TgtDesc() + '.', ColorGood);
end;

procedure CmdDisarm(ID: Integer; Args: string);
var
  k: Integer;
