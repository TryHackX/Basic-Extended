  else
    ClsSetNext(T, c, True);
  if ClsFor(T, c) then
    Say(ID, PL[T].Name + ' is ' + ClsName[c] + ' now.', ColorGood)
  else
    Say(ID, PL[T].Name + ' is ' + ClsName[c] + ' for this life (not a class of his side here).', ColorGood);
end;

{ ============ round 21: [Resupply] - the work ============ }

{ he stands at a base of his team ([Resupply] Where: his flag's base, his team's spawn points) }
function RyAtBase(ID: Integer; X, Y: Single): Boolean;
var
  Tm, k: Integer;
  DX, DY, R2: Single;
begin
  Result := False;
  Tm := TeamOf[ID];
  if (Tm < 1) or (Tm > 4) then
    Exit;
  R2 := RyRadius * RyRadius;
  if (RyWhere and 1) <> 0 then
    if MnBaseOk[Tm] then
    begin
      DX := X - MnBaseX[Tm];
      DY := Y - MnBaseY[Tm];
      if DX * DX + DY * DY <= R2 then
        Result := True;
    end;
  if not Result then
    if (RyWhere and 2) <> 0 then
      for k := 0 to MnSpCount - 1 do
        if not Result then
          if MnSpTeam[k] = Tm then
          begin
            DX := X - MnSpX[k];
            DY := Y - MnSpY[k];
            if DX * DX + DY * DY <= R2 then
              Result := True;
          end;
end;

{ what he gets: his magazines, grenades, bandage, vest - the words of what he got ('' = nothing missing) }
function RyGive(ID: Integer): string;
var
  P: TActivePlayer;
  W: Integer;
  Got: Boolean;
begin
  Result := '';
  P := PL[ID];
  if (RyWhat and 1) <> 0 then
    if AmmoEnabled and BeOk then
    begin
      Got := False;
      W := P.Primary.WType;
      if (W >= 0) and (W <= 16) then
        if BE_AmmoTopUp(ID, W) > 0 then
          Got := True;
      W := P.Secondary.WType;
      if (W >= 0) and (W <= 16) then
        if BE_AmmoTopUp(ID, W) > 0 then
          Got := True;
      if Got then
        Result := 'magazines';
    end;
  if (RyWhat and 2) <> 0 then
    if FnEnabled then
      if FnNadeLeft[ID] < ClsNadeCap(ID) then
      begin
        FnNadeLeft[ID] := ClsNadeCap(ID);
        FnNeed[ID] := True;
        if Result <> '' then
          Result := Result + ', ';
        Result := Result + 'grenades';
      end;
  if (RyWhat and 4) <> 0 then
    if BdActive and BeOk then
      if BdBand[ID] < 100 then
      begin
        BE_BodySupplies(ID, 100, BdKits[ID], 0);
        BdSync(ID);
        if Result <> '' then
          Result := Result + ', ';
        Result := Result + 'bandage';
      end;
  if (RyWhat and 8) <> 0 then
    if (P.Vest > 0) and (P.Vest < 100) then
    begin
      P.Vest := 100;
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + 'vest';
    end;
  if Result <> '' then
    HudMark(ID, False);
end;

{ every 10 ticks: who stays low at his base (a bot by standing there) resupplies after Seconds }
procedure RyTick(Tick: Integer);
var
  i, Pct: Integer;
  P: TActivePlayer;
  Low: Boolean;
  What: string;
begin
  if Tick mod 10 <> 0 then
    Exit;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      P := PL[i];
      Low := False;
      if P.Alive then
        if not DwDown[i] then
          if Tick >= RyNextOk[i] then
            if HumanOf[i] or RyBots then
              if RyAtBase(i, P.X, P.Y) then
              begin
                if HumanOf[i] then
                  Low := P.KeyCrouch or P.IsProne
                else
                  Low := True;
              end;
      if not Low then
      begin
        if RySince[i] > 0 then
        begin
          RySince[i] := 0;
          LfOver(i, RyLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
        end;
        Continue;
      end;
      if RySince[i] = 0 then
        RySince[i] := Tick;
      if Tick - RySince[i] >= RyTicks then
      begin
        RySince[i] := 0;
        LfOver(i, RyLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
        What := RyGive(i);
        RyNextOk[i] := Tick + RyCoolTicks;
        if What <> '' then
        begin
          RyStatDone := RyStatDone + 1;
          BpEvent(i, PE_RESUPPLY);
          if HumanOf[i] then
            Say(i, ReplaceAll(RyDoneText, '{what}', What), RyColor);
        end;
      end
      else if RyTicks > 0 then
      begin
        Pct := (Tick - RySince[i]) * 100 div RyTicks;
        LfOver(i, RyLayer, ReplaceAll(RyText, '{pct}', IntToStr(Pct)), P.X, P.Y, 0.04, 26, 60, RyColor);
      end;
    end;
end;

{ ============ round 22: [SteamBan] - bans of Steam accounts ============ }

{ the list from the data folder (again after /reloadsettings): lines that start with a Steam id; the rest (comments,
  empty lines) is kept as it is }
procedure SbLoad();
var
  L: TStringList;
  i: Integer;
begin
  if SbList = nil then
    SbList := File.CreateStringList();
  SbList.Clear;
  if SbFileName = '' then
    Exit;
  if not File.Exists(DataDir + SbFileName) then
    Exit;
  L := File.CreateStringListFromFile(DataDir + SbFileName);
  for i := 0 to L.Count - 1 do
    if Trim(L[i]) <> '' then
      SbList.Add(Trim(L[i]));
  L.Free;
end;

procedure SbSave();
begin
  if SbList = nil then
    Exit;
  if SbFileName = '' then
    Exit;
  if not SaveListFile(SbList, DataDir + SbFileName) then
    Log('[SteamBan] cannot write ' + DataDir + SbFileName);
end;

{ the Steam id of a line ('' = a comment) }
function SbIdOf(Line: string): string;
begin
  Result := '';
  if Line = '' then
    Exit;
  if (Line[1] = '#') or (Line[1] = ';') or (Copy(Line, 1, 2) = '//') then
    Exit;
  Result := NormalizeSteam(FirstWord(Line));
end;

{ the line of a Steam id (-1 = none) }
function SbFind(Steam: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  if SbList = nil then
    Exit;
  for i := 0 to SbList.Count - 1 do
    if Result < 0 then
      if SbIdOf(SbList[i]) = Steam then
        Result := i;
end;

{ the seconds of the ban left (-1 = for good, 0 = over) }
function SbLeftSecs(Line: string): Integer;
var
  W: string;
  U: Integer;
begin
  W := LowerCase(FirstWord(AfterFirstWord(Line)));
  if (W = 'perm') or (W = '') then
  begin
    Result := -1;
    Exit;
  end;
  U := StrToIntDef(W, 0);
  Result := U - SqNow();
  if Result < 0 then
    Result := 0;
end;

{ 'for good' or '3 days left' }
function SbLeftText(Line: string): string;
var
  n: Integer;
begin
  n := SbLeftSecs(Line);
  if n < 0 then
    Result := 'for good'
  else
    Result := UbAgo(n) + ' left';
end;

{ the part after '//': the name, then the reason after ': ' }
function SbNote(Line: string): string;
var
  p: Integer;
begin
  Result := '';
  p := Pos('//', Line);
  if p > 0 then
    Result := Trim(Copy(Line, p + 2, Length(Line)));
end;

function SbNameOf(Line: string): string;
var
  N: string;
  p: Integer;
begin
  N := SbNote(Line);
  p := Pos(': ', N);
  if p > 0 then
    Result := Trim(Copy(N, 1, p - 1))
  else
    Result := '-';
end;

function SbReasonOf(Line: string): string;
var
  N: string;
  p: Integer;
begin
  N := SbNote(Line);
  p := Pos(': ', N);
  if p > 0 then
    Result := Trim(Copy(N, p + 2, Length(N)))
  else
    Result := N;
end;

{ the admin who banned (the third word) }
function SbAdminOf(Line: string): string;
begin
  Result := FirstWord(AfterFirstWord(AfterFirstWord(Line)));
  if (Result = '') or (Result = '//') then
    Result := '-';
end;

{ a ban of Steam for Minutes (-1 = for good); a line of the same account is replaced }
procedure SbAdd(Steam: string; Minutes: Integer; Admin, Name, Reason: string);
var
  k: Integer;
  U: string;
begin
  if SbList = nil then
    SbLoad();
  k := SbFind(Steam);
  if k >= 0 then
    SbList.Delete(k);
  if Minutes < 0 then
    U := 'perm'
  else
    U := IntToStr(SqNow() + Minutes * 60);
  { one word for the admin, no ': ' in the name (the reason follows it) }
  Admin := ReplaceAll(ReplaceAll(Trim(Admin), ' ', '_'), '//', '/');
  if Admin = '' then
    Admin := '-';
  Name := ReplaceAll(AdClean(Name), ': ', ':');
  if Trim(Name) = '' then
    Name := '-';
  SbList.Add(Steam + ' ' + U + ' ' + Admin + ' // ' + Name + ': ' + AdClean(Reason));
  SbSave();
  Log('[SteamBan] ' + Steam + ' (' + Name + ') banned ' + ShIf(Minutes < 0, 'for good', 'for ' + IntToStr(Minutes) +
    ' min') + ' by ' + Admin + ': ' + Reason);
end;

{ the bans that are over leave the list }
procedure SbPrune();
var
  i: Integer;
  Gone: Boolean;
begin
  if SbList = nil then
    Exit;
  Gone := False;
  for i := SbList.Count - 1 downto 0 do
    if SbIdOf(SbList[i]) <> '' then
      if SbLeftSecs(SbList[i]) = 0 then
      begin
        SbList.Delete(i);
        Gone := True;
      end;
  if Gone then
    SbSave();
end;

{ Steam confirmed him (or he joined with his id): an account on the list is told why and banned by the server for
  the time left, at most EvasionIpMinutes (his address soon belongs to somebody else; the list stays) }
procedure SbCheck(ID: Integer);
var
  S, Line, R: string;
  k, Left, Mins, i: Integer;
begin
  if not SbEnabled then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  S := SteamId[ID];
  if S = '' then
    Exit;
  if SbChecked[ID] = S then
    Exit;
  SbChecked[ID] := S;
  if SbList = nil then
    SbLoad();
  k := SbFind(S);
  if k < 0 then
    Exit;
  Line := SbList[k];
  Left := SbLeftSecs(Line);
  if Left = 0 then
  begin
    SbList.Delete(k);
    SbSave();
    Exit;
  end;
  R := SbReasonOf(Line);
  for i := 1 to 4 do
    Say(ID, ' ', ColorGood);
  for i := 1 to 2 do
    Say(ID, ReplaceAll(ReplaceAll(SbText, '{left}', SbLeftText(Line)), '{reason}', R), ColorBad);
  Mins := SbIpMinutes;
  if Left > 0 then
    if (Left + 59) div 60 < Mins then
      Mins := (Left + 59) div 60;
  if Mins < 1 then
    Mins := 1;
  ScheduleBan(ID, Mins, 'Steam ban: ' + R);
  SbStatKicked := SbStatKicked + 1;
  Log('[SteamBan] ' + PL[ID].Name + ' (' + S + ') is banned (' + SbLeftText(Line) + '): ' + R);
end;

{ once a second: the bans /banr and [TeamKill] handed over; once a minute the ones that are over go }
procedure SbSecond(Tick: Integer);
var
  L, W1, W2, W3, W4: string;
  p, i: Integer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
        if SteamId[i] <> '' then
          if SbChecked[i] <> SteamId[i] then
            SbCheck(i);
  if SbPend <> nil then
    while SbPend.Count > 0 do
    begin
      L := SbPend[0] + #1;
      SbPend.Delete(0);
      p := Pos(#1, L);
      W1 := Copy(L, 1, p - 1);
      Delete(L, 1, p);
      p := Pos(#1, L);
      W2 := Copy(L, 1, p - 1);
      Delete(L, 1, p);
      p := Pos(#1, L);
      W3 := Copy(L, 1, p - 1);
      Delete(L, 1, p);
      p := Pos(#1, L);
      W4 := Copy(L, 1, p - 1);
      Delete(L, 1, p);
      if NormalizeSteam(W1) <> '' then
        SbAdd(NormalizeSteam(W1), StrToIntDef(W2, 1), W3, W4, Copy(L, 1, Length(L) - 1));
    end;
  if Tick mod 3600 < 60 then
    SbPrune();
end;

{ /bansteam <time | perm> <player | Steam id> <reason> }
procedure CmdBanSteam(ID: Integer; Args: string);
var
  Rest, Wt, Who, Steam, Name, Reason: string;
  T, Minutes: Integer;
begin
  if not SbEnabled then
    Exit;
  Rest := Args;
  Wt := LowerCase(TakeArg(Rest));
  Who := TakeArg(Rest);
  Reason := Trim(Rest);
  { -1: for good; BanMinutes gives -1 for a word it does not know too }
  if (Wt = 'perm') or (Wt = 'permanent') or (Wt = 'forever') then
    Minutes := -1
  else
  begin
    Minutes := BanMinutes(Wt);
    if Minutes < 1 then
      Minutes := 0;
  end;
  if (Minutes = 0) or (Who = '') or (Reason = '') then
  begin
    Say(ID, 'Use: /bansteam <time: 30m, 2h, 7d, 1mon, 1y or perm> <player or Steam id> <reason>', ColorBad);
    Exit;
  end;
  { an admin in the game: [Admin] MaxBanMinutes (for good counts as too long); the console may ban for good }
  if (ID >= 1) and (ID <= 32) then
  begin
    if Minutes < 0 then
      Minutes := CheckBanTime(ID, BAN_LIMIT + 1)
    else
      Minutes := CheckBanTime(ID, Minutes);
    if Minutes < 1 then
      Exit;
  end;
  Steam := '';
  Name := '-';
  T := FindPlayerOnly(Who);
  if T = -2 then
  begin
    Say(ID, 'More than one player has "' + Who + '" in the name - type more of it, or the id.', ColorBad);
    Exit;
  end;
  if (T >= 1) and (T <= 32) then
    if PL[T].Active then
    begin
      Name := PL[T].Name;
      Steam := SteamId[T];
      if Steam = '' then
      begin
        Say(ID, Name + '''s Steam id is not confirmed (no Steam, or not yet) - give the id itself.', ColorBad);
        Exit;
      end;
    end;
  if Steam = '' then
    Steam := NormalizeSteam(Who);
  if Steam = '' then
  begin
    Say(ID, 'No player or Steam id "' + Who + '" (S123456789, 7656119..., [U:1:...] or STEAM_0:...).', ColorBad);
    Exit;
  end;
  SbAdd(Steam, Minutes, AdminName(ID), Name, Reason);
  Say(ID, 'Steam ban: ' + Steam + ' (' + Name + ') ' + ShIf(Minutes < 0, 'for good', 'for ' + IntToStr(Minutes) +
    ' minutes') + ': ' + Reason, ColorGood);
  { in the game now: out at once }
  for T := 1 to TopSlot do
    if ActiveSlot[T] then
      if SteamId[T] = Steam then
      begin
        SbChecked[T] := '';
        SbCheck(T);
      end;
end;

{ /unbansteam <Steam id | number of /steambans | part of a name> }
procedure CmdUnbanSteam(ID: Integer; Args: string);
var
  W, Steam, Names: string;
  i, n, k, Hits: Integer;
begin
  if not SbEnabled then
    Exit;
  if SbList = nil then
    SbLoad();
  W := Trim(Args);
  if W = '' then
  begin
    Say(ID, 'Use: /unbansteam <Steam id, the number of /steambans or a part of the name>', ColorBad);
    Exit;
  end;
  k := -1;
  { a number of the list (the newest first) }
  n := StrToIntDef(W, 0);
  if (n >= 1) and (n <= 999) then
  begin
    Hits := 0;
    for i := SbList.Count - 1 downto 0 do
      if k < 0 then
        if SbIdOf(SbList[i]) <> '' then
        begin
          Hits := Hits + 1;
          if Hits = n then
            k := i;
        end;
  end;
  if k < 0 then
  begin
    Steam := NormalizeSteam(W);
    if Steam <> '' then
      k := SbFind(Steam);
  end;
  if k < 0 then
  begin
    Hits := 0;
    Names := '';
    for i := 0 to SbList.Count - 1 do
      if SbIdOf(SbList[i]) <> '' then
        if Pos(LowerCase(W), LowerCase(SbNameOf(SbList[i]))) > 0 then
        begin
          Hits := Hits + 1;
          k := i;
          if Hits <= 6 then
          begin
            if Names <> '' then
              Names := Names + ', ';
            Names := Names + SbNameOf(SbList[i]);
          end;
        end;
    if Hits > 1 then
    begin
      Say(ID, 'Several bans match "' + W + '": ' + Names + ' - type more of the name, or the id.', ColorBad);
      Exit;
    end;
  end;
  if k < 0 then
  begin
    Say(ID, 'No Steam ban of "' + W + '" (/steambans).', ColorBad);
    Exit;
  end;
  Say(ID, 'Steam ban lifted: ' + SbIdOf(SbList[k]) + ' (' + SbNameOf(SbList[k]) + ').', ColorGood);
  Log('[SteamBan] lifted by ' + AdminName(ID) + ': ' + SbList[k]);
  SbList.Delete(k);
  SbSave();
end;

{ /steambans [n]: the newest first }
procedure CmdSteamBans(ID: Integer; Args: string);
var
  i, n, Shown: Integer;
  Line: string;
begin
  if not SbEnabled then
    Exit;
  if SbList = nil then
    SbLoad();
  SbPrune();
  n := StrToIntDef(Trim(Args), 10);
  if n < 1 then
    n := 10;
  if n > 30 then
    n := 30;
  Shown := 0;
  for i := SbList.Count - 1 downto 0 do
    if Shown < n then
    begin
      Line := SbList[i];
      if SbIdOf(Line) <> '' then
      begin
        Shown := Shown + 1;
        Say(ID, IntToStr(Shown) + '. ' + SbNameOf(Line) + ' (' + SbIdOf(Line) + ') - ' + SbLeftText(Line) + ' - by ' +
          SbAdminOf(Line) + ': ' + SbReasonOf(Line), ColorBad);
      end;
    end;
  if Shown = 0 then
    Say(ID, 'No Steam bans.', ColorGood);
end;

{ ============ round 22: [Teams] AutoBalance, [LagGuard] ============ }

{ [Teams] AutoBalance: a dead soldier of the bigger team goes to the smaller one }
procedure TeMove(ID, Team: Integer);
begin
  PL[ID].ChangeTeam(Team, TJoinSilent);
  TeStatMoved := TeStatMoved + 1;
  TeUnevenSince := 0;
  SayAll(ReplaceAll(ReplaceAll(TeAutoText, '{player}', PL[ID].Name), '{team}', TeamName(Team)), ColorGood);
  Log('[Teams] ' + PL[ID].Name + ' moved to ' + TeamName(Team) + ' (the balance)');
end;

{ once a second: Alpha and Bravo AutoDifference or more apart for AutoSeconds - one dead soldier of the bigger team
  (the bots first with AutoBotsFirst, else the one who joined it last; admins only with AutoAdmins) is moved }
procedure TeSecond(Tick: Integer);
var
  A, B, Big, Small, i, Best, Sc, BestSc: Integer;
begin
  if not TeamGame() then
  begin
    TeUnevenSince := 0;
    Exit;
  end;
  if MapChanging or PausedNow then
    Exit;
  A := Game.Teams[1].Count;
  B := Game.Teams[2].Count;
  Big := 1;
  Small := 2;
  if B > A then
  begin
    Big := 2;
    Small := 1;
  end;
  if A - B < TeAutoDiff then
    if B - A < TeAutoDiff then
    begin
      TeUnevenSince := 0;
      Exit;
    end;
  if TeUnevenSince = 0 then
    TeUnevenSince := Tick;
  if Tick - TeUnevenSince < TeAutoTicks then
    Exit;
  Best := 0;
  BestSc := -1;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] = Big then
        if not PL[i].Alive then
          if TeAutoAdmins or (not PL[i].IsAdmin) then
          begin
            Sc := TeJoinTick[i] div 60;
            if TeAutoBots then
              if not HumanOf[i] then
                Sc := Sc + 50000000;
            if Sc > BestSc then
            begin
              BestSc := Sc;
              Best := i;
            end;
          end;
  if Best > 0 then
    TeMove(Best, Small);
end;

{ [LagGuard]: his connection over the window - the average ping, the spread (the mean jump between two readings),
  the highest, the warps a minute }
procedure LgdStats(ID: Integer; var Avg, Jit, Mx, Wm: Integer);
var
  k, n, j, Prev, Sum, SumJ, SumW, Pg: Integer;
begin
  Avg := 0;
  Jit := 0;
  Mx := 0;
  Wm := 0;
  n := LgdN[ID];
  if n <= 0 then
    Exit;
  Sum := 0;
  SumJ := 0;
  SumW := 0;
  Prev := -1;
  for k := 0 to n - 1 do
  begin
    j := (LgdPos[ID] - n + k + LgdWindow * 2) mod LgdWindow;
    Pg := LgdPing[ID][j];
    Sum := Sum + Pg;
    if Pg > Mx then
      Mx := Pg;
    if Prev >= 0 then
    begin
      if Pg > Prev then
        SumJ := SumJ + Pg - Prev
      else
        SumJ := SumJ + Prev - Pg;
    end;
    Prev := Pg;
    SumW := SumW + LgdWarp[ID][j];
  end;
  Avg := Sum div n;
  if n > 1 then
    Jit := SumJ div (n - 1);
  Wm := SumW * 60 div n;
end;

function LgdFill(T: string; ID, Avg, Jit, Mx, Wm: Integer): string;
begin
  Result := ReplaceAll(ReplaceAll(ReplaceAll(T, '{player}', PL[ID].Name), '{ping}', IntToStr(Avg)), '{jitter}',
    IntToStr(Jit));
  Result := ReplaceAll(ReplaceAll(ReplaceAll(Result, '{max}', IntToStr(Mx)), '{warps}', IntToStr(Wm)), '{limit}',
    IntToStr(LgdMaxPing));
end;

{ the library's warps on or off (the start, a reload) }
procedure LgdApply();
begin
  if not BeOk then
    Exit;
  if LgdEnabled then
  begin
    BE_LagSet(LG_WARP_PX, LgdWarpPx);
    BE_LagSet(LG_GRACE, 90);
    BE_LagSet(LG_ON, 1);
  end
  else
    BE_LagSet(LG_ON, 0);
end;

{ !track: the spread and the warps too }
function LgdTrackText(ID: Integer): string;
var
  Avg, Jit, Mx, Wm: Integer;
begin
  Result := '';
  if not LgdEnabled then
    Exit;
  if LgdN[ID] < 5 then
    Exit;
  LgdStats(ID, Avg, Jit, Mx, Wm);
  Result := ', spread ' + IntToStr(Jit) + ' ms, ' + IntToStr(Wm) + ' warps a minute';
end;

{ once a second: every human's ping and warps; every third second each one is looked at - told (WarnPing), moved to
  the spectators (step 2); the server's own ping rule is followed to tell him how close its kick is }
procedure LgdSecondRun(Tick: Integer);
var
  i, W, Pg, k, Avg, Jit, Mx, Wm, Humans: Integer;
  NowT: TDateTime;
  Stall, Bad: Boolean;
begin
  NowT := Now;
  Stall := False;
  if LgdLastNow > 0 then
    if (NowT - LgdLastNow) * 86400 > 1.5 then
      Stall := True;
  LgdLastNow := NowT;
  if PausedNow or MapChanging then
    Exit;
  LgdSecond := LgdSecond + 1;
  Humans := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
        if (TeamOf[i] >= 1) and (TeamOf[i] <= 4) then
          Humans := Humans + 1;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
      begin
        W := 0;
        if BeOk then
          W := BE_LagWarps(i);
        { the server stood still: nobody's second (not their connections) }
        if Stall then
          Continue;
        Pg := PL[i].Ping;
        k := LgdPos[i];
        if (k < 0) or (k >= LgdWindow) then
          k := 0;
        LgdPing[i][k] := Pg;
        LgdWarp[i][k] := W;
        LgdPos[i] := (k + 1) mod LgdWindow;
        if LgdN[i] < LgdWindow then
          LgdN[i] := LgdN[i] + 1;
        { the server's own rule: every 6 s above Max_Ping a warning, one melts every 5 minutes }
        if LgdServerLimit then
          if LgdMaxPing > 0 then
          begin
            if LgdSecond mod 6 = 0 then
              if Pg > LgdMaxPing then
              begin
                LgdSrvCount[i] := LgdSrvCount[i] + 1;
                if LgdSrvCount[i] * 2 >= LgdMaxWarnings then
                  Say(i, ReplaceAll(LgdFill(LgdLimitText, i, Pg, 0, Pg, 0), '{seconds}',
                    IntToStr((LgdMaxWarnings - LgdSrvCount[i] + 1) * 6)), ColorBad);
              end;
            if LgdSecond mod 300 = 0 then
              if LgdSrvCount[i] > 0 then
                LgdSrvCount[i] := LgdSrvCount[i] - 1;
          end;
        if (LgdSecond + i) mod 3 <> 0 then
          Continue;
        if LgdN[i] < 10 then
          Continue;
        if LgdIgnoreAdmins then
          if PL[i].IsAdmin then
            Continue;
        LgdStats(i, Avg, Jit, Mx, Wm);
        { step 1: he is told }
        if LgdWarnPing > 0 then
          if Avg > LgdWarnPing then
            if Tick >= LgdNextWarn[i] then
            begin
              LgdNextWarn[i] := Tick + LgdWarnEvery * 60;
              Say(i, LgdFill(LgdWarnText, i, Avg, Jit, Mx, Wm), LgdColor);
              LgdStatWarned := LgdStatWarned + 1;
            end;
        { step 2: to the spectators (in a survival round only when dead) }
        if (LgdSpecPing > 0) or (LgdSpecJitter > 0) or (LgdSpecWarps > 0) then
          if (TeamOf[i] >= 1) and (TeamOf[i] <= 4) then
          begin
            Bad := False;
            if LgdSpecPing > 0 then
              if Avg > LgdSpecPing then
                Bad := True;
            if LgdSpecJitter > 0 then
              if Jit > LgdSpecJitter then
                Bad := True;
            if LgdSpecWarps > 0 then
              if Wm > LgdSpecWarps then
                Bad := True;
            if Bad then
              LgdBadSecs[i] := LgdBadSecs[i] + 3
            else
              LgdBadSecs[i] := 0;
            if LgdBadSecs[i] >= LgdSpecSecs then
              if Humans >= LgdMinPlayers then
                if (not Game.Survival) or (not PL[i].Alive) then
                begin
                  LgdBadSecs[i] := 0;
                  LgdBlocked[i] := True;
                  LgdGoodSecs[i] := 0;
                  SayAll(LgdFill(LgdSpecText, i, Avg, Jit, Mx, Wm), LgdColor);
                  Log('[LagGuard] ' + PL[i].Name + ' to the spectators: ping ' + IntToStr(Avg) + ', spread ' +
                    IntToStr(Jit) + ', warps ' + IntToStr(Wm) + ' a minute');
                  PL[i].ChangeTeam(TEAM_SPECTATOR, TJoinSilent);
                  LgdStatMoved := LgdStatMoved + 1;
                end;
          end;
        { one moved may play again once his average stays under ResumePing for ResumeSeconds }
        if LgdBlocked[i] then
        begin
          if Avg < LgdResumePing then
          begin
            LgdGoodSecs[i] := LgdGoodSecs[i] + 3;
            if LgdGoodSecs[i] >= LgdResumeSecs then
              LgdBlocked[i] := False;
          end
          else
            LgdGoodSecs[i] := 0;
        end;
      end;
end;

{ /lag: every human measured, the worst connection first }
procedure CmdLag(ID: Integer);
var
  i, j, n, Best, Sc, BestSc, Av, Ji, Mx, Wm: Integer;
  LA, LJ, LM, LW: array[1..32] of Integer;
  Used: array[1..32] of Boolean;
  C: Longint;
begin
  if not LgdEnabled then
    Exit;
  for i := 1 to 32 do
  begin
    Used[i] := True;
    LA[i] := 0;
    LJ[i] := 0;
    LM[i] := 0;
    LW[i] := 0;
  end;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
        if LgdN[i] > 0 then
        begin
          Used[i] := False;
          LgdStats(i, Av, Ji, Mx, Wm);
          LA[i] := Av;
          LJ[i] := Ji;
          LM[i] := Mx;
          LW[i] := Wm;
        end;
  n := 0;
  for j := 1 to 32 do
  begin
    Best := 0;
    BestSc := -1;
    for i := 1 to TopSlot do
      if not Used[i] then
      begin
        Sc := LA[i] + LJ[i] * 2 + LW[i] * 10;
        if Sc > BestSc then
        begin
          BestSc := Sc;
          Best := i;
        end;
      end;
    if Best = 0 then
      Break;
    Used[Best] := True;
    n := n + 1;
    C := ColorGood;
    if LgdWarnPing > 0 then
      if LA[Best] > LgdWarnPing then
        C := ColorBad;
    Say(ID, PL[Best].Name + ': ping ' + IntToStr(LA[Best]) + ' ms (max ' + IntToStr(LM[Best]) + '), spread ' +
      IntToStr(LJ[Best]) + ' ms, ' + IntToStr(LW[Best]) + ' warps a minute' + ShIf(LgdBlocked[Best],
      ' - waits to play again', ''), C);
  end;
  if n = 0 then
    Say(ID, 'Nobody measured yet (once a second, the last ' + IntToStr(LgdWindow) + ' s).', ColorGood);
end;

{ ============ round 23: [Insurgents] - the vest ============ }

{ how the vest is set off here: "hold crouch + jump 1.0 s (or /detonate)" }
function InsHowText(): string;
var
  K: string;
begin
  if InsKeyMask = KM_FLAG then
    K := 'crouch + jump'
  else
    K := KeyMaskText(InsKeyMask);
  if InsKeyMask <> 0 then
  begin
    Result := 'holding ' + K + ' ' + InsTenths(InsHoldTicks) + ' s';
    if InsCmdWord <> '' then
      Result := Result + ' (or ' + InsCmdWord + ')';
  end
  else if InsCmdWord <> '' then
    Result := InsCmdWord + ' (' + InsTenths(InsHoldTicks) + ' s)'
  else
    Result := 'nothing';
end;

{ the vest of his life: an admin's, else his class's (Vest), else Pattern (random: a new one every life, not the plain
  one); -1 none }
function InsVestOf(ID: Integer): Integer;
var
  c, k: Integer;
begin
  Result := -1;
  if InsGiven[ID] >= 0 then
  begin
    Result := InsGiven[ID];
    Exit;
  end;
  if not InsIsIns(ID) then
    Exit;
  { G18: the game makes no bullet for the last slot (32): its blast would kill only him }
  if ID = 32 then
    Exit;
  k := InsPattern;
  if ClsActive then
  begin
    c := ClsOf[ID];
    if (c >= 1) and (c <= ClsCount) then
      if ClsVest[c] <> -2 then
        k := ClsVest[c];
  end;
  if k = -1 then
    k := Random(FX_V_FIRST, FX_V_PLAIN);
  if (k >= FX_V_FIRST) and (k <= FX_V_LAST) then
    Result := k;
end;

{ his vest looked at again (a respawn, a new class, an admin) }
procedure InsSetVest(ID: Integer);
begin
  InsVestDirty[ID] := False;
  InsVest[ID] := InsVestOf(ID);
  if InsVest[ID] < 0 then
    InsArmAt[ID] := 0;
  HudMarkL(ID, HLB_VEST);
  { his first vest since he joined the side: how it works }
  if InsVest[ID] >= 0 then
    if not InsJoinTold[ID] then
      if HumanOf[ID] and InsIsIns(ID) then
        if PL[ID].Alive then
        begin
          InsJoinTold[ID] := True;
          if InsJoinText <> '' then
            Say(ID, ReplaceAll(ReplaceAll(ReplaceAll(InsJoinText, '{faction}', InsName), '{enemy}', InsEnemyName),
              '{how}', InsHowText()), InsColor);
        end;
end;

{ the bullet of a vest: whose and when (the kill's messages; no team kill guard's judging of its own) }
procedure InsMark(B, Owner, Tick: Integer);
begin
  if (B >= 1) and (B <= 255) then
  begin
    InsBulOwner[B] := Owner;
    InsBulTick[B] := Tick;
  end;
end;

{ a bullet of a vest that went off lately (0 = not one) }
function InsBulletOf(B: Integer): Integer;
begin
  Result := 0;
  B := B and 255;
  if InsBulOwner[B] > 0 then
    if Game.TickCount - InsBulTick[B] <= 180 then
      Result := InsBulOwner[B];
end;

{ an enemy spawn point within SpawnDistance that he can see (the vest is not set off there) }
function InsNearEnemySpawn(ID: Integer): Boolean;
var
  k: Integer;
  X, Y: Single;
begin
  Result := False;
  if InsSpawnDist <= 0 then
    Exit;
  X := PL[ID].X;
  Y := PL[ID].Y;
  for k := 0 to MnSpCount - 1 do
    if not Result then
      if (MnSpTeam[k] >= 1) and (MnSpTeam[k] <= 4) then
        if MnSpTeam[k] <> TeamOf[ID] then
          if (MnSpX[k] - X) * (MnSpX[k] - X) + (MnSpY[k] - Y) * (MnSpY[k] - Y) <= InsSpawnDist * InsSpawnDist then
            if not Ray(X, Y - 10, MnSpX[k], MnSpY[k] - 10, False) then
              Result := True;
end;

{ may he set it off now ('' = yes, else why not) }
function InsWhyNot(ID, Tick: Integer): string;
var
  Tm: Integer;
begin
  Result := '';
  if InsVest[ID] < 0 then
    Result := 'you wear no vest'
  else if not PL[ID].Alive then
    Result := 'you are dead'
  else if DwDown[ID] and (not InsDownedDet) then
    Result := 'not while you are down'
  else if Tick - InsLifeAt[ID] < InsMinLifeTicks then
    Result := 'not in the first ' + IntToStr((InsMinLifeTicks + 59) div 60) + ' s of a life'
  else if PL[ID].Flagger and (not InsFlagCarrier) then
    Result := 'not with a flag'
  else if PausedNow then
    Result := 'not during a pause';
  if Result <> '' then
    Exit;
  Tm := TeamOf[ID];
  if (Tm >= 1) and (Tm <= 4) then
    if InsTeamCool[Tm] > Tick then
    begin
      Result := 'your team waits ' + IntToStr((InsTeamCool[Tm] - Tick + 59) div 60) + ' s';
      Exit;
    end;
  if InsNearEnemySpawn(ID) then
    Result := 'not this near an enemy spawn';
end;

{ the countdown starts (ByKey: letting the keys go stops it) }
procedure InsArmStart(ID, Tick: Integer; ByKey: Boolean);
var
  Why: string;
begin
  Why := InsWhyNot(ID, Tick);
  if Why <> '' then
  begin
    if HumanOf[ID] then
      if Tick - InsToldAt[ID] >= 120 then
      begin
        InsToldAt[ID] := Tick;
        Say(ID, 'Vest: ' + Why + '.', ColorBad);
      end;
    Exit;
  end;
  InsArmAt[ID] := Tick;
  InsArmKey[ID] := ByKey;
  InsHitPart[ID] := 0;
  InsStatArmed := InsStatArmed + 1;
  HudMarkL(ID, HLB_VEST);
end;

procedure InsArmStop(ID: Integer);
begin
  if InsArmAt[ID] = 0 then
    Exit;
  InsArmAt[ID] := 0;
  InsStatCancel := InsStatCancel + 1;
  LfOver(ID, InsArmLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
  HudMarkL(ID, HLB_VEST);
end;

{ the beep and the mark of a vest going off, for everybody within SoundRadius }
procedure InsWarn(ID: Integer);
var
  j: Integer;
  X, Y: Single;
begin
  X := PL[ID].X;
  Y := PL[ID].Y;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] or DebugBots then
        if (PL[j].X - X) * (PL[j].X - X) + (PL[j].Y - Y) * (PL[j].Y - Y) <= InsSoundR * InsSoundR then
        begin
          if InsArmSound <> '' then
            if HumanOf[j] then
              PL[j].PlaySound(InsArmSound, X, Y);
          if InsArmText <> '' then
            LfOver(j, InsArmLayer, InsArmText, X, Y, 0.09, 44, 20, InsArmColor);
        end;
end;

{ the bullets of the blasts under way that are due now (a blast's pattern from a fixed place, at most 48 a tick and
  32 slots of the server kept free) }
procedure InsQRun(Tick: Integer);
var
  k, j, n, Style, Delay, Fired, Room, b, Own, Age: Integer;
  DX, DY, VX, VY, HitM, D: Single;
begin
  if InsQN = 0 then
    Exit;
  Room := -1;
  Fired := 0;
  for k := InsQN - 1 downto 0 do
  begin
    Own := InsQOwner[k];
    Age := Tick - InsQAt[k];
    { each step once (InsBlast and InsTick both run the queue in a tick) }
    if Age > InsQDone[k] then
      if ActiveSlot[Own] and BeOk then
      begin
        n := BE_Fx(InsQKind[k], InsQSeed[k], InsPower);
        D := InsQDir[k];
        for j := 0 to n - 1 do
          if BE_FxGet(j, DX, DY, VX, VY, HitM, Style, Delay) = 1 then
          begin
            if Delay > InsQLast[k] then
              InsQLast[k] := Delay;
            if Delay > InsQDone[k] then
              if Delay <= Age then
              begin
                { the free bullet slots, read only when a bullet is due }
                if Room < 0 then
                  Room := BulletsFree(48 + BULLET_MARGIN) - BULLET_MARGIN;
                if Fired < Room then
                begin
                  b := ScriptBullet(InsQX[k] + DX * D, InsQY[k] + DY, VX * D, VY, HitM, Style, PL[Own]);
                  InsMark(b, Own, Tick);
                  Fired := Fired + 1;
                end;
              end;
          end;
        InsQDone[k] := Age;
      end;
    { a pattern goes after its last step (20 ticks at most) }
    if (Age >= InsQLast[k]) or (Age >= 20) or (not ActiveSlot[Own]) then
    begin
      InsQN := InsQN - 1;
      InsQOwner[k] := InsQOwner[InsQN];
      InsQKind[k] := InsQKind[InsQN];
      InsQSeed[k] := InsQSeed[InsQN];
      InsQAt[k] := InsQAt[InsQN];
      InsQDir[k] := InsQDir[InsQN];
      InsQDone[k] := InsQDone[InsQN];
      InsQLast[k] := InsQLast[InsQN];
      InsQX[k] := InsQX[InsQN];
      InsQY[k] := InsQY[InsQN];
    end;
  end;
end;

{ the vest goes off at X, Y (Alive: he is alive - he dies of it now; else it went off as he died): a blast inside every
  enemy within CoreRadius he can see (it surely goes off there), the pattern from this place, every kill his }
procedure InsBlast(ID: Integer; X, Y: Single; Tick: Integer; Alive: Boolean);
var
  e, Kind, Tm, b: Integer;
  Dir, AX: Single;
begin
  Kind := InsVest[ID];
  InsArmAt[ID] := 0;
  InsVest[ID] := -1;
  if (Kind < FX_V_FIRST) or (Kind > FX_V_LAST) then
    Exit;
  LfOver(ID, InsArmLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
  Tm := TeamOf[ID];
  if (Tm >= 1) and (Tm <= 4) then
    InsTeamCool[Tm] := Tick + InsTeamCoolTicks;
  InsStatBlasts := InsStatBlasts + 1;
  InsBlastAt[ID] := Tick;
  InsKills[ID] := 0;
  { the core }
  if InsCoreR > 0 then
    for e := 1 to TopSlot do
      if ActiveSlot[e] then
        if e <> ID then
          if PL[e].Alive then
            if Enemies(ID, e) then
              if (PL[e].X - X) * (PL[e].X - X) + (PL[e].Y - 10 - Y) * (PL[e].Y - 10 - Y) <= InsCoreR * InsCoreR then
                if not Ray(X, Y - 12, PL[e].X, PL[e].Y - 10, True) then
                  if BulletRoom(1) then
                  begin
                    b := ScriptBullet(PL[e].X, PL[e].Y - 6, 0, 3, InsPower, 4, PL[ID]);
                    InsMark(b, ID, Tick);
                  end;
  { the pattern, mirrored when he looks left }
  Dir := 1;
  AX := PL[ID].MouseAimX;
  if AX < X then
    Dir := -1;
  if InsQN < 8 then
  begin
    InsQOwner[InsQN] := ID;
    InsQKind[InsQN] := Kind;
    InsQSeed[InsQN] := Random(1, 100000);
    InsQAt[InsQN] := Tick;
    InsQDone[InsQN] := -1;
    InsQLast[InsQN] := -1;
    InsQDir[InsQN] := Round(Dir);
    InsQX[InsQN] := X;
    InsQY[InsQN] := Y;
    InsQN := InsQN + 1;
    InsQRun(Tick);
  end;
  if InsShout <> '' then
    SayChat(0, '[' + PL[ID].Name + '] ', InsShout, SayChatColor);
  Log('[Insurgents] ' + PL[ID].Name + '''s vest (' + InsPatternName(Kind) + ') went off at ' + IntToStr(Round(X)) +
    ',' + IntToStr(Round(Y)));
  { he dies of it (as a slay: no suicide's penalty, no grenade of [Posthumous], not downed) }
  if Alive then
    if PL[ID].Alive then
    begin
      ServerKill[ID] := Tick;
      AdminHit[ID] := Tick;
      PL[ID].Damage(ID, 4000);
    end;
  HudMarkL(ID, HLB_VEST);
end;

{ every tick: the keys (every 3rd tick), the countdowns, the blasts under way, the bots once a second, the bomber's
  message 2 s after his blast }
procedure InsTick(Tick: Integer);
var
  i, Tm, e, n: Integer;
  P: TActivePlayer;
  Held: Boolean;
  D, DMate, Near: Single;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      if InsVestDirty[i] then
        InsSetVest(i);
      if InsBlastAt[i] > 0 then
        if Tick - InsBlastAt[i] >= 120 then
        begin
          InsBlastAt[i] := 0;
          if HumanOf[i] then
            if InsKills[i] > 0 then
              Say(i, ReplaceAll(InsBomberText, '{kills}', IntToStr(InsKills[i]) + ShIf(InsKills[i] = 1, ' enemy', ' enemies')),
                InsColor);
        end;
      if InsVest[i] < 0 then
        Continue;
      P := PL[i];
      if not P.Alive then
        Continue;
      { the keys of a player: held - it counts down, let go - it stops (lying: they are the claymore's) }
      if HumanOf[i] then
        if InsKeyMask <> 0 then
          if Tick mod 3 = 0 then
          begin
            Held := False;
            if not P.IsProne then
              Held := KeysHeld(P, InsKeyMask);
            if Held then
            begin
              if InsArmAt[i] = 0 then
                InsArmStart(i, Tick, True);
            end
            else if InsArmAt[i] > 0 then
              if InsArmKey[i] then
                InsArmStop(i);
          end;
      if InsArmAt[i] > 0 then
      begin
        if (Tick - InsArmAt[i]) mod 15 = 0 then
          InsWarn(i);
        if (Tick - InsArmAt[i]) mod 6 = 0 then
          HudMarkL(i, HLB_VEST);
        if Tick - InsArmAt[i] >= InsHoldTicks then
          InsBlast(i, P.X, P.Y, Tick, True);
      end
      else if Tick mod 60 = 0 then
      begin
        HudMarkL(i, HLB_VEST);
        { a bot: enough enemies near him that he can see, no mate nearer than the nearest of them (with the server's
          friendly fire on) }
        if not HumanOf[i] then
          if InsBots then
            if Random(0, 100) < InsBotChance then
            begin
              n := 0;
              Near := 1000000;
              DMate := 1000000;
              Tm := TeamOf[i];
              for e := 1 to TopSlot do
                if ActiveSlot[e] then
                  if e <> i then
                    if PL[e].Alive then
                    begin
                      D := (PL[e].X - P.X) * (PL[e].X - P.X) + (PL[e].Y - P.Y) * (PL[e].Y - P.Y);
                      if Enemies(i, e) then
                      begin
                        if D <= InsBotR * InsBotR then
                          if not Ray(P.X, P.Y - 10, PL[e].X, PL[e].Y - 10, True) then
                          begin
                            n := n + 1;
                            if D < Near then
                              Near := D;
                          end;
                      end
                      else if TeamOf[e] = Tm then
                        if D < DMate then
                          DMate := D;
                    end;
              if n >= InsBotMin then
                if (DMate > Near) or (not Game.FriendlyFire) then
                  InsArmStart(i, Tick, False);
            end;
      end;
    end;
  InsQRun(Tick);
end;

{ OnKill: a vest's kill is told to the one it killed and counted for the bomber; a bomber killed while it counted
  down - DeadManChance that it goes off anyway (never on a headshot with HeadshotStops) }
procedure InsOnKill(K, V, BulletId, Tick: Integer);
var
  B: Integer;
begin
  B := InsBulletOf(BulletId);
  if (B >= 1) and (B <= 32) then
    if B = K then
      if B <> V then
        if Enemies(B, V) then
      begin
        InsKills[B] := InsKills[B] + 1;
        InsStatKills := InsStatKills + 1;
        if HumanOf[V] then
          Say(V, ReplaceAll(InsVictimText, '{name}', PL[B].Name), ColorBad);
      end;
  if (V < 1) or (V > 32) then
    Exit;
  if InsArmAt[V] > 0 then
  begin
    if (Random(0, 100) < InsDeadMan) and (not (InsHeadshotStops and (InsHitPart[V] = 12))) then
    begin
      InsStatDead := InsStatDead + 1;
      InsBlast(V, PL[V].X, PL[V].Y, Tick, False);
    end
    else
      InsArmStop(V);
  end;
  InsVest[V] := -1;
  InsGiven[V] := -1;
  HudMarkL(V, HLB_VEST);
end;

{ a new life: his vest }
procedure InsRespawn(ID, Tick: Integer);
begin
  InsLifeAt[ID] := Tick;
  InsArmAt[ID] := 0;
  InsSetVest(ID);
end;

{ he came, left, changed teams: nothing of the vest stays }
procedure InsForget(ID: Integer);
begin
  InsArmAt[ID] := 0;
  InsVest[ID] := -1;
  InsGiven[ID] := -1;
  InsBlastAt[ID] := 0;
  InsVestDirty[ID] := False;
  InsJoinTold[ID] := False;
end;

{ idle now (a game mode without it, switched off): nobody wears a vest }
procedure InsAllOff();
var
  i: Integer;
begin
  for i := 1 to 32 do
  begin
    InsArmAt[i] := 0;
    InsVest[i] := -1;
    InsGiven[i] := -1;
    InsVestDirty[i] := False;
    if ActiveSlot[i] then
      HudMarkL(i, HLB_VEST);
  end;
end;

{ a new map: no blast under way, the teams wait no more; everybody's vest of this mode }
procedure InsMapStart();
var
  i: Integer;
begin
  InsQN := 0;
  for i := 1 to 4 do
    InsTeamCool[i] := 0;
  InsRefresh();
  if not InsActive then
  begin
    InsAllOff();
    Exit;
  end;
  for i := 1 to 32 do
  begin
    InsArmAt[i] := 0;
    InsGiven[i] := -1;
    if ActiveSlot[i] then
      InsVestDirty[i] := True;
  end;
end;

{ /detonate: the countdown (again: stopped) }
procedure CmdDetonate(ID: Integer);
var
  Tick: Integer;
  Why: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not InsActive then
  begin
    Say(ID, 'There are no insurgents here (' + InsIdleWhy + ').', ColorBad);
    Exit;
  end;
  Tick := Game.TickCount;
  if InsArmAt[ID] > 0 then
  begin
    InsArmStop(ID);
    Say(ID, 'Vest: stopped.', InsColor);
    Exit;
  end;
  Why := InsWhyNot(ID, Tick);
  if Why <> '' then
  begin
    Say(ID, 'Vest: ' + Why + '.', ColorBad);
    Exit;
  end;
  InsArmStart(ID, Tick, False);
end;

{ !insurgents: how the vest works here }
procedure CmdInsInfo(ID: Integer);
begin
  if not InsActive then
  begin
    Say(ID, 'There are no insurgents here (' + InsIdleWhy + ').', ColorBad);
    Exit;
  end;
  Say(ID, InsName + ' (' + iif(InsTeam = 0, 'both teams', TeamName(InsTeam)) + ') against the ' + InsEnemyName +
    ': every insurgent wears a vest.', InsColor);
  Say(ID, 'It goes off after ' + InsHowText() + '; everybody near hears it' + iif(InsCmdWord <> '', ' (' + InsCmdWord +
    ' again stops it)', '') + '.', InsColor);
  Say(ID, 'Not in the first ' + IntToStr((InsMinLifeTicks + 59) div 60) + ' s of a life, not near an enemy spawn' +
    iif(InsFlagCarrier, '', ', not with a flag') + '; killed while it counts down: ' + IntToStr(InsDeadMan) +
    '% that it goes off anyway' + iif(InsHeadshotStops, ' (never after a headshot)', '') + '.', InsColor);
  if (ID >= 1) and (ID <= 32) then
    if InsVest[ID] >= 0 then
      Say(ID, 'Your vest: ' + InsPatternName(InsVest[ID]) + '.', InsColor);
end;

{ /givevest <player|all|team> [pattern], /takevest <player|all|team> }
procedure CmdGiveVest(ID: Integer; Args: string; Give: Boolean);
var
  Rest, W: string;
  k, T, P: Integer;
begin
  if not InsActive then
  begin
    Say(ID, 'There are no insurgents here (' + InsIdleWhy + ').', ColorBad);
    Exit;
  end;
  Rest := Args;
  if not PickTargets(ID, TakeArg(Rest), True, True, True) then
    Exit;
  P := InsPattern;
  W := Trim(Rest);
  if W <> '' then
    P := InsPatternOf(W);
  if P = -1 then
    P := Random(FX_V_FIRST, FX_V_PLAIN);
  if Give then
    if (P < FX_V_FIRST) or (P > FX_V_LAST) then
    begin
      Say(ID, 'Use: /givevest <player|all|team> [classic, hawk, inferno, shrapnel, ring, scatter, ied, plain, random]',
        ColorBad);
      Exit;
    end;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    if Give then
      InsGiven[T] := P
    else
    begin
      InsGiven[T] := -1;
      InsArmStop(T);
    end;
    InsSetVest(T);
    if not Give then
    begin
      InsVest[T] := -1;
      HudMarkL(T, HLB_VEST);
    end
    else if HumanOf[T] then
      if not InsIsIns(T) then
        Say(T, 'You wear a vest now: ' + InsHowText() + ' sets it off.', InsColor);
  end;
  if Give then
    Say(ID, 'A vest (' + InsPatternName(P) + ') for: ' + TgtDesc() + '.', ColorGood)
  else
    Say(ID, 'No vest for: ' + TgtDesc() + ' (this life).', ColorGood);
end;

{ /reloadsettings: what was active before; after it a module gone idle ends what it holds }
procedure ModulesKeep();
begin
  WasIns := InsActive;
  WasSq := SqActive;
  WasBd := BdActive;
  WasDw := DwActive;
  WasBn := BnActive;
end;

procedure ModulesOff();
var
  i: Integer;
begin
  for i := 1 to 32 do
  begin
    if WasSq and (not SqActive) then
      if SqMutedUntil[i] > 0 then
        SqUnmute(i, False);
    if (WasDw and (not DwActive)) or (WasBd and (not BdActive)) then
    begin
      if DwDown[i] then
      begin
        if ActiveSlot[i] then
          if DwTookW[i] >= 0 then
            DwGiveBack(i);
        DwClear(i);
      end;
      if BdShockUntil[i] > 0 then
        BdShockEnd(i);
      LfBotHold(i, False);
    end;
    if WasBn and (not BnActive) then
      if BnPrice[i] > 0 then
        BnDrop(i, 'switched off');
  end;
  if WasIns and (not InsActive) then
    InsAllOff();
end;

