  MapsFile := CfgStr('MapsList', 'File', 'mapslist.txt');
  MapsShuffle := CfgBool('MapsList', 'ShuffleOnStart', True);
  AddWords(CfgStr('Admin', 'TestCommands', 'be_test'), C_TEST, True);
  AddWords(CfgStr('Admin', 'BenchCommands', 'be_bench'), C_BENCH, True);
  AddWords(CfgStr('Admin', 'ProfileCommands', 'be_prof'), C_PROF, True);
  DebugBots := CfgBool('Debug', 'BotsSeeTexts', False);
  PermLoad();
  BuildWords();

  { keys this script does not know: most likely a misspelt one }
  if CfgOk then
  begin
    Sections := File.CreateStringList();
    Keys := File.CreateStringList();
    Cfg.ReadSections(Sections);
    for i := 0 to Sections.Count - 1 do
    begin
      Sec := Sections[i];
      Keys.Clear;
      Cfg.ReadSection(Sec, Keys);
      { [Classes]: the section of a class that List does not name is not read (a class kept for later) }
      if not ClsUnlisted(Sec) then
        for k := 0 to Keys.Count - 1 do
          if CfgKeys.IndexOf(LowerCase(Sec + '/' + Keys[k])) < 0 then
            Log('settings.ini: unknown key [' + Sec + '] ' + Keys[k]);
    end;
    Sections.Free;
    Keys.Free;
    Cfg.Free;
  end;
  CfgOk := False;
end;

{ ================================ player preferences ================================ }

{ a player is known by his Steam id (S<number>), without Steam by his computer (H + HWID, which can
  be faked, but it only keeps a text position); bots are not remembered }
function PrefKeyOf(ID: Integer): string;
var
  S: string;
begin
  Result := SteamId[ID];
  if Result <> '' then
    Exit;
  if not PL[ID].Human then
    Exit;
  S := Trim(PL[ID].HWID);
  if S <> '' then
    Result := 'H' + S;
end;

{ the radar's choices of a player: the server's settings again }
procedure RadarPrefsClear(ID: Integer);
var
  m: Integer;
begin
  RdPOn[ID] := PREF_DEFAULT;
  RdPMode[ID] := 0;
  RdPMarks[ID] := 0;
  RdPEdge[ID] := 0;
  RdPShow[ID] := 0;
  RdPTeam[ID] := PREF_DEFAULT;
  RdPOutline[ID] := PREF_DEFAULT;
  for m := 0 to 3 do
  begin
    RdMX[ID][m] := -1;
    RdMY[ID][m] := -1;
    RdMSize[ID][m] := 0;
    RdMTicks[ID][m] := 0;
    RdMZoom[ID][m] := 0;
  end;
end;

procedure PrefsClear(ID: Integer);
var
  m: Integer;
begin
  AmPOn[ID] := PREF_DEFAULT;
  AmPX[ID] := -1;
  AmPY[ID] := -1;
  AmPScale[ID] := 0;
  HudPOn[ID] := PREF_DEFAULT;
  DmgPOn[ID] := PREF_DEFAULT;
  HudPX[ID] := -1;
  HudPY[ID] := -1;
  HudPStyle[ID] := 0;
  HudPScale[ID] := 0;
  RdPOn[ID] := PREF_DEFAULT;
  RdPMode[ID] := 0;
  RdPMarks[ID] := 0;
  RdPEdge[ID] := 0;
  RdPShow[ID] := 0;
  RdPTeam[ID] := PREF_DEFAULT;
  RdPOutline[ID] := PREF_DEFAULT;
  for m := 0 to 3 do
  begin
    RdMX[ID][m] := -1;
    RdMY[ID][m] := -1;
    RdMSize[ID][m] := 0;
    RdMTicks[ID][m] := 0;
    RdMZoom[ID][m] := 0;
  end;
end;

procedure AmmoPrefsSave(ID: Integer);
begin
  if (AmPOn[ID] = PREF_DEFAULT) and (AmPX[ID] < 0) and (AmPY[ID] < 0) and (AmPScale[ID] <= 0) then
  begin
    if BE_Pref_Count(PChar('A' + PrefKey[ID])) > 0 then
      BE_Pref_Save(PChar('A' + PrefKey[ID]), 0, PfI);
    Exit;
  end;
  PfI[0] := AmPOn[ID];
  PfI[1] := AmPX[ID];
  PfI[2] := AmPY[ID];
  PfI[3] := Round(AmPScale[ID] * 10000);
  BE_Pref_Save(PChar('A' + PrefKey[ID]), 4, PfI);
end;

{ the ammunition's own text: on/off, x, y, scale*10000 under 'A' and the player's key }
procedure AmmoPrefsLoad(ID: Integer; Key: string);
var
  Cnt: Integer;
begin
  Cnt := BE_Pref_Load(PChar('A' + Key), PfI);
  if Cnt < 4 then
    Exit;
  if (PfI[0] >= 0) and (PfI[0] <= 2) then
    AmPOn[ID] := PfI[0];
  AmPX[ID] := PfI[1];
  AmPY[ID] := PfI[2];
  if PfI[3] > 0 then
    AmPScale[ID] := PfI[3] * 0.0001;
end;

procedure PrefsSave(ID: Integer);
var
  AllDefault: Boolean;
  m: Integer;
begin
  if not HudSave then
    Exit;
  if not BeOk then
    Exit;
  if PrefKey[ID] = '' then
    Exit;
  AmmoPrefsSave(ID);
  AllDefault := (HudPOn[ID] = PREF_DEFAULT) and (DmgPOn[ID] = PREF_DEFAULT) and (HudPX[ID] < 0) and
    (HudPY[ID] < 0) and (HudPStyle[ID] = 0) and (HudPScale[ID] <= 0) and (RdPOn[ID] = PREF_DEFAULT) and
    (RdPMode[ID] = 0) and (RdPShow[ID] = 0) and (RdPTeam[ID] = PREF_DEFAULT) and
    (RdPOutline[ID] = PREF_DEFAULT) and (RdPMarks[ID] <= 0) and (RdPEdge[ID] <= 0);
  for m := 0 to 3 do
    if (RdMX[ID][m] >= 0) or (RdMY[ID][m] >= 0) or (RdMSize[ID][m] > 0) or (RdMTicks[ID][m] > 0) or
      (RdMZoom[ID][m] > 0) then
      AllDefault := False;
  if AllDefault then
  begin
    BE_Pref_Save(PChar(PrefKey[ID]), 0, PfI);
    Exit;
  end;
  PfI[0] := HudPOn[ID];
  PfI[1] := HudPX[ID];
  PfI[2] := HudPY[ID];
  PfI[3] := Round(HudPScale[ID] * 10000);
  PfI[4] := HudPStyle[ID];
  PfI[5] := DmgPOn[ID];
  PfI[6] := RdPOn[ID];
  PfI[7] := RdPMode[ID];
  PfI[8] := 0;
  PfI[9] := RdMX[ID][OVL_LIST];
  PfI[10] := RdMY[ID][OVL_LIST];
  PfI[11] := Round(RdMSize[ID][OVL_LIST] * 1000);
  PfI[12] := 0;
  PfI[13] := 0;
  PfI[14] := RdPShow[ID];
  PfI[15] := RdMX[ID][OVL_CIRCLE];
  PfI[16] := RdMY[ID][OVL_CIRCLE];
  PfI[17] := Round(RdMSize[ID][OVL_CIRCLE] * 1000);
  PfI[18] := RdPTeam[ID];
  for m := 0 to 3 do
    PfI[19 + m] := RdMTicks[ID][m];
  PfI[23] := RdPOutline[ID];
  for m := 0 to 3 do
    PfI[24 + m] := Round(RdMZoom[ID][m] * 1000);
  PfI[28] := Round(RdPMarks[ID] * 1000);
  PfI[29] := Round(RdPEdge[ID] * 1000);
  PfI[30] := Round(RdMSize[ID][OVL_LABELS] * 1000);
  PfI[31] := Round(RdMSize[ID][OVL_ARROWS] * 1000);
  BE_Pref_Save(PChar(PrefKey[ID]), 32, PfI);
end;

{ The values of a player in the store (data/players.bdb): hud, x, y, scale*10000, style, dmg, radar,
  radar mode+1, the radar ticks of older releases, list x, list y, list size*1000, 0 (was the hit
  markers), radar zoom*1000, radar show+1, circle x, circle y, circle size*1000, team mates shown,
  the ticks of list, labels, circle and ring, the map outline, the zoom*1000 of list, labels, circle
  and ring, the circle marks*1000, the circle edge*1000, labels size*1000, ring size*1000; 0 or -1 =
  the server default, older players have fewer. }
procedure PrefsLoad(ID: Integer);
var
  n, m, Cnt: Integer;
  S, Key: string;
  V: array[0..31] of Integer;
  Copied: Boolean;
begin
  PrefsClear(ID);
  PrefKey[ID] := PrefKeyOf(ID);
  if PrefKey[ID] = '' then
    Exit;
  if not BeOk then
    Exit;
  { SavePlayers = 0: the players' choices are not kept, nor are the ones saved before used }
  if not HudSave then
    Exit;
  Key := PrefKey[ID];
  AmmoPrefsLoad(ID, Key);
  { the ammunition line his computer kept before the Steam id was known }
  if SteamId[ID] <> '' then
    if BE_Pref_Count(PChar('A' + Key)) = 0 then
      if Trim(PL[ID].HWID) <> '' then
        AmmoPrefsLoad(ID, 'H' + Trim(PL[ID].HWID));
  Cnt := BE_Pref_Count(PChar(Key));
  { known by his computer before this script knew Steam ids: those values are taken over for the
    Steam id }
  Copied := False;
  if Cnt = 0 then
    if SteamId[ID] <> '' then
    begin
      S := Trim(PL[ID].HWID);
      if S <> '' then
      begin
        Key := 'H' + S;
        Cnt := BE_Pref_Count(PChar(Key));
        Copied := Cnt > 0;
      end;
    end;
  if Cnt = 0 then
    Exit;
  for n := 0 to 31 do
    V[n] := 0;
  V[9] := -1;
  V[10] := -1;
  V[15] := -1;
  V[16] := -1;
  Cnt := BE_Pref_Load(PChar(Key), PfI);
  for n := 0 to 31 do
    if n < Cnt then
      V[n] := PfI[n];
  if Cnt <= 15 then
  begin
    V[15] := V[9];
    V[16] := V[10];
    V[17] := V[11];
    for m := 0 to 3 do
      V[19 + m] := V[8];
  end;
  if (V[0] >= 0) and (V[0] <= 2) then
    HudPOn[ID] := V[0];
  HudPX[ID] := V[1];
  HudPY[ID] := V[2];
  if V[3] > 0 then
    HudPScale[ID] := V[3] * 0.0001;
  if (V[4] >= 1) and (V[4] <= STYLE_COUNT) then
    HudPStyle[ID] := V[4];
  if (V[5] >= 0) and (V[5] <= 2) then
    DmgPOn[ID] := V[5];
  if (V[6] >= 0) and (V[6] <= 2) then
    RdPOn[ID] := V[6];
  if (V[7] >= 1) and (V[7] <= 4) then
    RdPMode[ID] := V[7];
  RdMX[ID][OVL_LIST] := V[9];
  RdMY[ID][OVL_LIST] := V[10];
  if V[11] > 0 then
    RdMSize[ID][OVL_LIST] := V[11] * 0.001;
  RdMX[ID][OVL_CIRCLE] := V[15];
  RdMY[ID][OVL_CIRCLE] := V[16];
  if V[17] > 0 then
    RdMSize[ID][OVL_CIRCLE] := V[17] * 0.001;
  if Cnt <= 24 then
    for m := 0 to 3 do
      V[24 + m] := V[13];
  for m := 0 to 3 do
    if (V[24 + m] >= 100) and (V[24 + m] <= 4000) then
      RdMZoom[ID][m] := V[24 + m] * 0.001;
  if (V[28] >= 100) and (V[28] <= 5000) then
    RdPMarks[ID] := V[28] * 0.001;
  if (V[29] >= 100) and (V[29] <= 5000) then
    RdPEdge[ID] := V[29] * 0.001;
  if (V[14] >= 1) and (V[14] <= 5) then
    RdPShow[ID] := V[14];
  if V[30] > 0 then
    RdMSize[ID][OVL_LABELS] := V[30] * 0.001;
  if V[31] > 0 then
    RdMSize[ID][OVL_ARROWS] := V[31] * 0.001;
  if (V[18] >= 0) and (V[18] <= 2) then
    RdPTeam[ID] := V[18];
  for m := 0 to 3 do
    if (V[19 + m] >= 1) and (V[19 + m] <= 600) then
      RdMTicks[ID][m] := V[19 + m];
  if (V[23] >= 0) and (V[23] <= 2) then
    RdPOutline[ID] := V[23];
  if Copied then
    PrefsSave(ID);
end;

{ Steam confirmed the player after his join: from now on his choices go by the Steam id. A line kept
  for that id wins; without one, what he has now (his computer's line) is kept for the id too. }
procedure PrefsAdopt(ID: Integer);
var
  Key: string;
begin
  Key := PrefKeyOf(ID);
  if Key = PrefKey[ID] then
    Exit;
  if not BeOk then
    Exit;
  if (BE_Pref_Count(PChar(Key)) > 0) or (BE_Pref_Count(PChar('A' + Key)) > 0) then
    PrefsLoad(ID)
  else
  begin
    PrefKey[ID] := Key;
    PrefsSave(ID);
  end;
end;

{ ================================ health display ================================ }

function HudIsOn(ID: Integer): Boolean;
begin
  if HudPOn[ID] = PREF_DEFAULT then
    Result := HudDefaultOn
  else
    Result := HudPOn[ID] = PREF_ON;
end;

function HudWanted(ID: Integer; P: TActivePlayer): Boolean;
begin
  Result := False;
  if not HudEnabled then
    Exit;
  if not HudIsOn(ID) then
    Exit;
  if not P.Human then
    if not DebugBots then
      Exit;
  if P.Team = TEAM_SPECTATOR then
    Exit;
  if not P.Alive then
    Exit;
  Result := True;
end;

{ players at low health are counted: their texts blink }
procedure HudLowSet(ID: Integer; Low: Boolean);
begin
  if Low = HudLowOn[ID] then
    Exit;
  HudLowOn[ID] := Low;
  if Low then
    LowCount := LowCount + 1
  else
    LowCount := LowCount - 1;
  if LowCount < 0 then
    LowCount := 0;
end;

{ [ExtraRocket]: the tokens of the rocket's texts - player (the shooter), target, name, weapon, keys,
  used, left and max in braces }
function RkText(S: string; ID, T: Integer): string;
var
  PN, TN: string;
  Used, Left: Integer;
begin
  PN := '';
  TN := '';
  Used := 0;
  if (ID >= 1) and (ID <= 32) then
  begin
    PN := PL[ID].Name;
    Used := RkUsed[ID];
  end;
  if (T >= 1) and (T <= 32) then
    TN := PL[T].Name;
  Left := RkRockets - Used;
  if Left < 0 then
    Left := 0;
  if BeOk then
    Result := BE_Fill(S, '{player}'#1 + PN + #1'{target}'#1 + TN + #1'{name}'#1 + RkName + #1'{weapon}'#1 +
      WeaponName(RkWeapon) + #1'{keys}'#1 + RkKeysText + #1'{used}'#1 + IntToStr(Used) + #1'{left}'#1 +
      IntToStr(Left) + #1'{max}'#1 + IntToStr(RkRockets))
  else
  begin
    Result := ReplaceAll(S, '{player}', PN);
    Result := ReplaceAll(Result, '{target}', TN);
    Result := ReplaceAll(Result, '{name}', RkName);
    Result := ReplaceAll(Result, '{weapon}', WeaponName(RkWeapon));
    Result := ReplaceAll(Result, '{keys}', RkKeysText);
    Result := ReplaceAll(Result, '{used}', IntToStr(Used));
    Result := ReplaceAll(Result, '{left}', IntToStr(Left));
    Result := ReplaceAll(Result, '{max}', IntToStr(RkRockets));
  end;
end;

{ [ExtraRocket] HudText, HudEmptyText: the rockets left, next to the ammunition while the rocket's weapon
  (W) is in the hands ('' = nothing) }
function RkHudPart(ID, W: Integer): string;
var
  S: string;
begin
  Result := '';
  if not RkEnabled then
    Exit;
  if W <> RkWeapon then
    Exit;
  if RkUsed[ID] >= RkRockets then
    S := RkHudEmpty
  else
    S := RkHudText;
  if S <> '' then
    Result := RkText(S, ID, 0);
end;

{ [Ammo] CombatKnife: the knife's ammunition text - the one in the hand and the spare ones }
function KnifeHud(ID: Integer): string;
begin
  Result := '';
  if AmmoEnabled then
    if AmmoMax[WEP_KNIFE] > 0 then
      Result := 'Ammo: 1/' + IntToStr(KnLeft[ID]);
end;

{ ---------------- the HUD lines: one state table, one sender ----------------
  Six lines a player may have on his screen: 0 health, 1 ammunition, 2 flash grenades, 3 mines, 4 blood, 5 money.
  His game keeps a text on its layer until it is replaced or its time runs out (a map change keeps it, only a
  new game client starts empty), so only HlSend sends to these layers and it keeps what his game shows. A text
  lives HlLifeTicks (three refreshes) and a shown line is sent again every refresh: a lost hide or a text left
  by an earlier start of the script goes by itself. }

function HlLayerOf(L: Integer): Integer;
begin
  case L of
    HL_HEALTH: Result := HudLayer;
    HL_AMMO: Result := AhLayer;
    HL_FLASH: Result := FnHudLayer;
    HL_MINES: Result := MnHudLayer;
    HL_BLOOD: Result := BdHudLayer;
    HL_MONEY: Result := ShHudLayer;
    HL_CLASS: Result := ClsHudLayer;
    HL_SCORE: Result := BpHudLayer;
  else
    Result := InsHudLayer;
  end;
end;

{ line L of his screen: T at X, Y ('' = hidden); sent when it differs from what his game shows, or its refresh
  is due, or Force }
procedure HlSend(ID, L: Integer; P: TActivePlayer; T: string; X, Y: Integer; Sc: Single; C: Longint;
  Force: Boolean);
begin
  if T = '' then
  begin
    if HlState[ID][L] <> HS_HIDDEN then
    begin
      P.BigText(HlLayerOf(L), ' ', 1, ColorGood, 0.01, 0, 0);
      HlState[ID][L] := HS_HIDDEN;
      HlText[ID][L] := '';
      StatHud := StatHud + 1;
    end;
    Exit;
  end;
  if not Force then
    if HlState[ID][L] = HS_SHOWN then
      if T = HlText[ID][L] then
        if (X = HlX[ID][L]) and (Y = HlY[ID][L]) and (C = HlC[ID][L]) and (Sc = HlSc[ID][L]) then
          if Game.TickCount - HlTick[ID][L] < HlDueTicks then
            Exit;
  P.BigText(HlLayerOf(L), T, HlLifeTicks, C, QScale(Sc), X, Y);
  HlState[ID][L] := HS_SHOWN;
  HlText[ID][L] := T;
  HlX[ID][L] := X;
  HlY[ID][L] := Y;
  HlC[ID][L] := C;
  HlSc[ID][L] := Sc;
  HlTick[ID][L] := Game.TickCount;
  StatHud := StatHud + 1;
end;

{ what his game shows is known (a join: nothing) or not (the script starts: an earlier start may have left
  lines); everything is built again }
procedure HlReset(ID, St: Integer);
var
  L: Integer;
begin
  if BeOk then
    BE_HudReset(ID, St);
  for L := 0 to 8 do
  begin
    HlState[ID][L] := St;
    HlText[ID][L] := '';
    HlWant[ID][L] := '';
    HlTick[ID][L] := 0;
  end;
  HudLines[ID] := HLB_ALL;
end;

{ the script stops: every line his game may still show goes }
procedure HlHideAll(ID: Integer);
var
  L, n, k, La, Ti, Co, X, Y: Integer;
  Sc: Single;
begin
  if BeOk then
  begin
    n := BE_HudHideAll(ID);
    for k := 0 to n - 1 do
    begin
      BE_HudOp(k, La, Ti, Co, X, Y, Sc);
      PL[ID].BigText(La, ' ', 1, ColorGood, 0.01, 0, 0);
    end;
    Exit;
  end;
  for L := 0 to 8 do
    if HlState[ID][L] <> HS_HIDDEN then
    begin
      PL[ID].BigText(HlLayerOf(L), ' ', 1, ColorGood, 0.01, 0, 0);
      HlState[ID][L] := HS_HIDDEN;
    end;
end;

{ the tick counter started again: every shown line is due }
procedure HlClockReset(ID: Integer);
var
  L: Integer;
begin
  if BeOk then
    BE_HudClockReset(ID);
  for L := 0 to 8 do
    HlTick[ID][L] := 0;
end;

{ /reloadsettings: the layers before; after it a line whose layer changed - the old text goes, the new one is
  not known yet }
procedure HlLayersKeep();
var
  L: Integer;
begin
  for L := 0 to 8 do
    HlOldLayer[L] := HlLayerOf(L);
end;

procedure HlLayersMoved();
var
  i, L: Integer;
begin
  for L := 0 to 8 do
    if HlLayerOf(L) <> HlOldLayer[L] then
      for i := 1 to TopSlot do
        if ActiveSlot[i] then
          if BeOk then
          begin
            if BE_HudMoved(i, L) = 1 then
              if PL[i].Active then
                PL[i].BigText(HlOldLayer[L], ' ', 1, ColorGood, 0.01, 0, 0);
          end
          else if HlState[i][L] <> HS_HIDDEN then
          begin
            if PL[i].Active then
              PL[i].BigText(HlOldLayer[L], ' ', 1, ColorGood, 0.01, 0, 0);
            HlState[i][L] := HS_UNKNOWN;
          end;
end;

{ where the health line stands (the editor's live place while he moves it) }
procedure HudHealthPlace(ID: Integer; var X, Y: Integer; var Sc: Single);
begin
  if EdOn[ID] and (EdKind[ID] = ED_HUD) then
  begin
    X := Round(EdX[ID]);
    Y := Round(EdY[ID]);
    Sc := EdScale[ID];
    Exit;
  end;
  X := HudPX[ID];
  if X < 0 then
    X := HudDefX;
  Y := HudPY[ID];
  if Y < 0 then
    Y := HudDefY;
  Sc := HudPScale[ID];
  if Sc <= 0 then
    Sc := HudDefScale;
end;

{ the health line: its text and colour now ('' = not shown); the health and the vest it shows are kept for
  HudPoll }
procedure HudWant(ID: Integer; P: TActivePlayer; var T: string; var C: Longint);
var
  H: Single;
  Pct, S, Vs, W: Integer;
  Part: string;
  Low: Boolean;
begin
  T := '';
  C := ColorGood;
  if not HudWanted(ID, P) then
  begin
    HudLowSet(ID, False);
    Exit;
  end;
  H := P.Health;
  HlDrawnH[ID] := H;
  Pct := HealthPct(H);
  S := HudPStyle[ID];
  if (S < 1) or (S > STYLE_COUNT) then
    S := HudDefStyle;
  Vs := 0;
  if HudHasVest[S] then
    Vs := Round(P.Vest);
  HlDrawnV[ID] := Vs;
  if BeOk then
  begin
    T := BE_HudText(S, Pct, Round(H), Round(MaxHealth), Vs, BoolInt(Regenerating[ID]));
    if AmmoEnabled then
      if AmmoHudMode = 1 then
      begin
        W := P.Primary.WType;
        if W = WEP_KNIFE then
        begin
          Part := KnifeHud(ID);
          if Part <> '' then
            T := T + ' | ' + Part;
        end
        else if (W >= 0) and (W <= 16) then
          T := T + BE_AmmoFormatHud(ID, W, BE_AmmoShown(ID, Game.TickCount, W, P.Primary.Ammo));
      end;
    { [ExtraRocket]: the rockets left, after the ammunition (here when it has no text of its own) }
    if RkEnabled then
      if (not AmmoEnabled) or (AmmoHudMode <> 2) then
      begin
        Part := RkHudPart(ID, P.Primary.WType);
        if Part <> '' then
          T := T + ' ' + Part;
      end;
  end
  else
  begin
    T := HudStyleText[S];
    if HudHasPct[S] then
      T := ReplaceAll(T, '{pct}', IntToStr(Pct));
    if HudHasHp[S] then
      T := ReplaceAll(T, '{hp}', IntToStr(Round(H)));
    if HudHasMax[S] then
      T := ReplaceAll(T, '{max}', IntToStr(Round(MaxHealth)));
    if HudHasBar[S] then
      T := ReplaceAll(T, '{bar}', BarCache[Round(Pct * HudBarLen * 0.01)]);
    if HudHasVest[S] then
      T := ReplaceAll(T, '{vest}', IntToStr(Vs));
    if HudHasRegen[S] then
    begin
      if Regenerating[ID] then
        T := ReplaceAll(T, '{regen}', HudRegenMark)
      else
        T := ReplaceAll(T, '{regen}', '');
    end;
  end;
  C := HudColorAt[Pct];
  { low health: its own colour, blinking with the second one }
  Low := False;
  if HudLowPct > 0 then
    if Pct <= HudLowPct then
      Low := True;
  HudLowSet(ID, Low);
  if Low then
  begin
    C := HudLowColor;
    if HudLowBlink > 0 then
      if (Game.TickCount div HudLowBlink) mod 2 = 1 then
        C := HudLowColor2;
  end;
  if EdOn[ID] and (EdKind[ID] = ED_HUD) then
  begin
    T := T + ' <edit>';
    C := $00FFFF;
  end;
end;

{ [AmmoHud] (HudAppend = 2): the ammunition in its own text }
function AmmoHudIsOn(ID: Integer): Boolean;
begin
  if AmPOn[ID] = PREF_DEFAULT then
    Result := AhDefaultOn
  else
    Result := AmPOn[ID] = PREF_ON;
end;

{ players with a blinking NO AMMO are counted: their texts are drawn again every BlinkTicks }
procedure AmmoBlinkSet(ID: Integer; On: Boolean);
begin
  if On = AmBlinkOn[ID] then
    Exit;
  AmBlinkOn[ID] := On;
  if On then
    AmBlinkCount := AmBlinkCount + 1
  else
    AmBlinkCount := AmBlinkCount - 1;
  if AmBlinkCount < 0 then
    AmBlinkCount := 0;
end;

{ the magazine and the spare ones, coloured by what is left of a full load (Color, LowColor below
  LowPercent, CriticalColor below CriticalPercent); NoAmmoText blinking when nothing is left or the
  weapon was just taken away; '' = no line (HudAppend is not 2, off for him, dead, a spectator) }
procedure AmmoHudWant(ID: Integer; P: TActivePlayer; var T: string; var C: Longint);
var
  W, Clip, Lv: Integer;
  Part: string;
  Blink, Editing: Boolean;
begin
  T := '';
  C := AhColor;
  if not (AmmoEnabled and (AmmoHudMode = 2)) then
  begin
    AmmoBlinkSet(ID, False);
    Exit;
  end;
  Part := '';
  Blink := False;
  Editing := EdOn[ID] and (EdKind[ID] = ED_AMMO);
  if P.Alive then
    if AmmoHudIsOn(ID) or Editing then
      if P.Human or DebugBots then
        if P.Team <> TEAM_SPECTATOR then
        begin
          W := P.Primary.WType;
          { [ExtraRocket]: the rockets left go after it }
          Part := RkHudPart(ID, W);
          if W = WEP_KNIFE then
            T := KnifeHud(ID)
          else if (W >= 0) and (W <= 16) then
          begin
            Clip := BE_AmmoShown(ID, Game.TickCount, W, P.Primary.Ammo);
            T := BE_AmmoFormatHud(ID, W, Clip);
            if Copy(T, 1, 3) = ' | ' then
              T := Copy(T, 4, Length(T));
            Lv := BE_AmmoLevel(ID, W, Clip);
            if Lv <= 0 then
              Blink := True
            else if Lv < AhCritPct then
              C := AhCritColor
            else if Lv < AhLowPct then
              C := AhLowColor;
          end
          else if Game.TickCount < AmNoAmmoUntil[ID] then
            Blink := True;
        end;
  if Blink then
  begin
    T := AhNoText;
    C := AhNoColor;
    if AhBlink > 0 then
      if (Game.TickCount div AhBlink) mod 2 = 1 then
        C := AhNoColor2;
  end;
  if Part <> '' then
  begin
    if T <> '' then
      T := T + ' ';
    T := T + Part;
  end;
  AmmoBlinkSet(ID, Blink);
  if Editing then
  begin
    if T = '' then
      T := 'Ammo: 30 [30, 30]';
    T := T + ' <edit>';
    C := $00FFFF;
  end;
end;

{ where the ammunition line stands (the editor's live place while he moves it) }
procedure HudAmmoPlace(ID: Integer; var X, Y: Integer; var Sc: Single);
begin
  if EdOn[ID] and (EdKind[ID] = ED_AMMO) then
  begin
    X := Round(EdX[ID]);
    Y := Round(EdY[ID]);
    Sc := EdScale[ID];
    Exit;
  end;
  X := AmPX[ID];
  if X < 0 then
    X := AhDefX;
  Y := AmPY[ID];
  if Y < 0 then
    Y := AhDefY;
  Sc := AmPScale[ID];
  if Sc <= 0 then
    Sc := AhDefScale;
end;

