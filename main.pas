{ [Mines]: are they on now - a game mode of Modes, a kind on, the library running. Switched off, the mines
  on the map go (their marks at the next tick) }
procedure MnRefresh();
var
  Was: Boolean;
  S: Integer;
begin
  Was := MnActive;
  MnActive := False;
  MnIdleWhy := 'switched off';
  if MnEnabled then
  begin
    S := Game.GameStyle;
    if (S < 0) or (S > 7) then
      S := 0;
    if not BeOk then
      MnIdleWhy := 'they need the script''s library, which is not running'
    else if not (MnLand or MnClay) then
      MnIdleWhy := 'both kinds are off ([Mines] Landmines, Claymores)'
    else if not MnModeOk[S] then
      MnIdleWhy := 'this game mode is not in [Mines] Modes'
    else
    begin
      MnActive := True;
      MnIdleWhy := '';
    end;
  end;
  if BeOk then
  begin
    BE_MineSet(MNC_ON, BoolInt(MnActive));
    BE_MineSet(MNC_REAL, BoolInt(Game.Realistic));
  end;
  { the enemies see a claymore only with their eyes on it: the marks are looked at more often }
  MnSightFast := (MnSightRule = 2) or ((MnSightRule = 1) and Game.Realistic);
  if Was then
    if not MnActive then
    begin
      if BeOk then
        BE_MineClear();
      MnFuseCount := 0;
      MnHideDue := True;
    end;
  if MnEnabled then
    if MnActive <> Was then
    begin
      if MnActive then
        Log('[Mines] on')
      else
        Log('[Mines] idle: ' + MnIdleWhy);
    end;
end;

{ who sees a kind's marks: owner, team or all }
function MnSeenOf(Key, Def: string): Integer;
var
  S: string;
begin
  S := LowerCase(Trim(CfgStr('Mines', Key, Def)));
  if S = 'owner' then
    Result := 0
  else if S = 'team' then
    Result := 1
  else if S = 'all' then
    Result := 2
  else
  begin
    CfgWarn('Mines', Key, S, 'owner, team or all; ' + Def + ' used');
    if Def = 'all' then
      Result := 2
    else
      Result := 1;
  end;
end;

