{ [Mines]: bullet B of Owner is one of a blast of a mine or a claymore (its kind; 0 = not): made by the
  blast in its tick (the bridge reads when the bullet was made), else at most a second ago }
function MnBulletKind(B, Owner: Integer): Integer;
var
  X, Y: Single;
  T: Integer;
begin
  Result := 0;
  if (B < 1) or (B > 255) then
    Exit;
  if MnBulKind[B] = 0 then
    Exit;
  if MnBulOwner[B] <> Owner then
    Exit;
  if BeOk then
    if BE_BulletOrigin(B, X, Y, T) = 1 then
    begin
      if Abs(T - MnBulTick[B]) <= 1 then
        Result := MnBulKind[B];
      Exit;
    end;
  if Game.TickCount - MnBulTick[B] <= 60 then
    Result := MnBulKind[B];
end;

{ [Mines]: the tokens of the texts, in braces - player (Other), kind / Kind, mines and claymores (what ID
  carries), nextmine and nextclaymore (kills still needed), planted, keys and command (of the kind),
  seconds, pct and kills (Num), why }
function MnFill(S: string; ID, Kind, Other: Integer; Num, Why: string): string;
var
  PN, KN, KC, NM, NC, Keys, Cmd: string;
  M, C, Planted: Integer;
begin
  Result := S;
  if S = '' then
    Exit;
  if not BeOk then
    Exit;
  PN := '';
  if (Other >= 1) and (Other <= 32) then
    PN := PL[Other].Name;
  KN := MnKindName(Kind);
  KC := KN;
  if KC <> '' then
    KC := UpperCase(Copy(KC, 1, 1)) + Copy(KC, 2, Length(KC));
  M := 0;
  C := 0;
  Planted := 0;
  NM := '-';
  NC := '-';
  if (ID >= 1) and (ID <= 32) then
  begin
    M := MnHave[ID];
    C := MnHaveC[ID];
    if MnKillsM > 0 then
      NM := IntToStr(MnKillsM - MnProgM[ID]);
    if MnKillsC > 0 then
      NC := IntToStr(MnKillsC - MnProgC[ID]);
    if Pos('{planted}', S) > 0 then
      Planted := BE_MineCount(ID, 0);
  end;
  if Kind = MN_CLAY then
  begin
    Keys := MnKeysTextC;
    Cmd := MnCmdC;
  end
  else
  begin
    Keys := MnKeysTextM;
    Cmd := MnCmdM;
  end;
  Result := BE_Fill(S, '{player}'#1 + PN + #1'{kind}'#1 + KN + #1'{Kind}'#1 + KC + #1'{mines}'#1 + IntToStr(M) +
    #1'{claymores}'#1 + IntToStr(C) + #1'{nextmine}'#1 + NM + #1'{nextclaymore}'#1 + NC + #1'{planted}'#1 +
    IntToStr(Planted) + #1'{keys}'#1 + Keys + #1'{command}'#1 + Cmd + #1'{seconds}'#1 + Num + #1'{pct}'#1 + Num +
    #1'{kills}'#1 + Num + #1'{why}'#1 + Why);
end;

{ [Mines] Hud: what he carries ('' = no line: nothing carried) }
