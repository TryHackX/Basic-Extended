begin
  case K of
    FX_V_CLASSIC: Result := 'classic';
    FX_V_HAWK: Result := 'hawk';
    FX_V_INFERNO: Result := 'inferno';
    FX_V_SHRAPNEL: Result := 'shrapnel';
    FX_V_RING: Result := 'ring';
    FX_V_SCATTER: Result := 'scatter';
    FX_V_IED: Result := 'ied';
    FX_V_PLAIN: Result := 'plain';
  else
    Result := '-';
  end;
end;

{ ============ round 21: [Classes] - the settings ============ }

{ the next part of S up to Sep (S keeps the rest); the spaces around it go }
function ClsTake(var S: string; Sep: string): string;
var
  p: Integer;
begin
  S := Trim(S);
  p := Pos(Sep, S);
  if p = 0 then
  begin
    Result := S;
    S := '';
  end
  else
  begin
    Result := Trim(Copy(S, 1, p - 1));
    Delete(S, 1, p);
  end;
end;

{ the next word of P as a number (Def when there is none) }
function ClsNum(var P: string; Def: Single): Single;
var
  W: string;
  Ok: Boolean;
begin
  Result := Def;
  W := ClsTake(P, ' ');
  if W = '' then
    Exit;
  Result := ParseFloat(W, Ok);
  if not Ok then
    Result := Def;
end;

function ClsClamp(V, Lo, Hi: Single): Single;
begin
  Result := V;
  if Result < Lo then
    Result := Lo;
  if Result > Hi then
    Result := Hi;
end;

{ the name of a key of a class (CK_*) }
function ClsKeyName(Ck: Integer): string;
begin
  case Ck of
    CK_MAX: Result := 'Max';
    CK_INFO: Result := 'Info';
    CK_PRIM: Result := 'Primary';
    CK_SEC: Result := 'Secondary';
    CK_LOAD: Result := 'Loadout';
    CK_PERKS: Result := 'Perks';
    CK_SKILL: Result := 'Skill';
    CK_SKILL2: Result := 'Skill2';
  else
    Result := 'Vest';
  end;
end;

{ the value of a key of class k for this game mode: its ...RealisticSurvival form in realistic survival, else its
  ...Survival form in survival, else its ...Realistic form in realistic mode, else the key itself }
function ClsVal(k, Ck: Integer): string;
var
  R, S: Boolean;
begin
  R := Game.Realistic;
  S := Game.Survival;
  Result := ClsRaw[k][Ck * 4];
  if R and S and (ClsRaw[k][Ck * 4 + 3] <> '~') then
    Result := ClsRaw[k][Ck * 4 + 3]
  else if S and (ClsRaw[k][Ck * 4 + 2] <> '~') then
    Result := ClsRaw[k][Ck * 4 + 2]
  else if R and (ClsRaw[k][Ck * 4 + 1] <> '~') then
    Result := ClsRaw[k][Ck * 4 + 1];
end;

{ the menu slot of a weapon (1-10 the primaries, 11 SOCOM, 12 knife, 13 chainsaw, 14 LAW; 0 = not in the menu) }
function ClsSlotOf(W: Integer): Integer;
begin
  Result := 0;
  if (W >= 1) and (W <= 10) then
    Result := W
  else if W = 0 then
    Result := 11
  else if W = 11 then
    Result := 12
  else if W = 12 then
    Result := 13
  else if W = 13 then
    Result := 14;
end;

{ the menu of weapon words (spaces, | or , between them): bits 1..14 of the menu slots; Warn: an unknown word is
  told (at a load) }
function ClsMenuOf(S, Sec, Key: string; Warn: Boolean): Integer;
var
  W: string;
  k: Integer;
begin
  Result := 0;
  S := ReplaceAll(ReplaceAll(LowerCase(S), '|', ' '), ',', ' ');
  while Trim(S) <> '' do
  begin
    W := ClsTake(S, ' ');
    if W <> '' then
    begin
      k := ClsSlotOf(ShWeaponWord(W));
      if k > 0 then
        Result := Result or (1 shl k)
      else if Warn then
        CfgWarn(Sec, Key, W, 'not a weapon of the menu (deagles mp5 ak aug spas ruger m79 barrett minimi minigun; ' +
          'socom knife chainsaw law)');
    end;
  end;
end;

{ Loadout = grenades N, flashes N, mines N, claymores N, javelins N, vest P, bandage P, kits N, mags N (-1: not
  named - the modules' own amount) }
procedure ClsLoadOf(k: Integer; S, Sec: string; Warn: Boolean);
var
  P, W: string;
  i, n: Integer;
begin
  for i := 0 to LO_LAST do
    ClsLoad[k][i] := -1;
  S := LowerCase(S);
  while Trim(S) <> '' do
  begin
    P := ClsTake(S, ',');
    if P <> '' then
    begin
      W := ClsTake(P, ' ');
      n := StrToIntDef(Trim(P), -1);
      i := -1;
      if (W = 'grenades') or (W = 'grenade') or (W = 'nades') then
        i := LO_NADES
      else if (W = 'flashes') or (W = 'flash') then
        i := LO_FLASHES
      else if (W = 'mines') or (W = 'mine') then
        i := LO_MINES
      else if (W = 'claymores') or (W = 'claymore') then
        i := LO_CLAYS
      else if (W = 'javelins') or (W = 'javelin') then
        i := LO_JAVS
      else if W = 'vest' then
        i := LO_VEST
      else if W = 'bandage' then
        i := LO_BAND
      else if (W = 'kits') or (W = 'kit') then
        i := LO_KITS
      else if (W = 'mags') or (W = 'magazines') then
        i := LO_MAGS
      else if (W = 'c4') or (W = 'charges') then
        i := LO_C4;
      if (i < 0) or (n < 0) then
      begin
        if Warn then
          CfgWarn(Sec, 'Loadout', W + ' ' + P, 'grenades, flashes, mines, claymores, javelins, vest, bandage, kits, ' +
            'mags or c4 and a number');
      end
      else
      begin
        if i = LO_BAND then
        begin
          if n > 1000 then
            n := 1000;
        end
        else if n > 100 then
          n := 100;
        if (i <> LO_VEST) and (i <> LO_BAND) then
          if n > 20 then
            n := 20;
        ClsLoad[k][i] := n;
      end;
    end;
  end;
end;

{ Perks = heal PCT RADIUS, repair VEST RADIUS, ammo MAGS SECONDS RADIUS, revive FACTOR RADIUS, bandage FACTOR,
  damage WEAPON FACTOR STANCE, armor FACTOR, spot FACTOR, distance FACTOR }
procedure ClsPerksOf(k: Integer; S, Sec: string; Warn: Boolean);
var
  P, W, St: string;
  d, Wp: Integer;
begin
  ClsHeal[k] := 0;
  ClsHealR[k] := 0;
  ClsRepair[k] := 0;
  ClsRepairR[k] := 0;
  ClsAmmoN[k] := 0;
  ClsAmmoR[k] := 0;
  ClsAmmoTicks[k] := 600;
  ClsReviveF[k] := 1;
  ClsReviveR[k] := 0;
  ClsBandF[k] := 1;
  ClsArmor[k] := 1;
  ClsSpotF[k] := 1;
  ClsDistF[k] := 1;
  ClsDmgN[k] := 0;
  ClsDetR[k] := 0;
  ClsCrit[k] := 0;
  ClsCritF[k] := 1;
  ClsWoundsF[k] := 1;
  ClsLeech[k] := 0;
  ClsMedicR[k] := 0;
  { the perks may also be parted by | or ; }
  S := ReplaceAll(ReplaceAll(LowerCase(S), '|', ','), ';', ',');
  while Trim(S) <> '' do
  begin
    P := ClsTake(S, ',');
    W := ClsTake(P, ' ');
    if W = 'heal' then
    begin
      ClsHeal[k] := ClsClamp(ClsNum(P, 3), 0, 100);
      ClsHealR[k] := ClsClamp(ClsNum(P, 120), 10, 2000);
    end
    else if W = 'repair' then
    begin
      ClsRepair[k] := ClsClamp(ClsNum(P, 8), 0, 100);
      ClsRepairR[k] := ClsClamp(ClsNum(P, 120), 10, 2000);
    end
    else if W = 'ammo' then
    begin
      ClsAmmoN[k] := ClsClamp(ClsNum(P, 1), 0, 10);
      ClsAmmoTicks[k] := Round(ClsClamp(ClsNum(P, 10), 1, 600) * 60);
      ClsAmmoR[k] := ClsClamp(ClsNum(P, 120), 10, 2000);
    end
    else if W = 'revive' then
    begin
      ClsReviveF[k] := ClsClamp(ClsNum(P, 2), 0.1, 20);
      ClsReviveR[k] := ClsClamp(ClsNum(P, 60), 0, 2000);
    end
    else if W = 'bandage' then
      ClsBandF[k] := ClsClamp(ClsNum(P, 2), 0.1, 20)
    else if W = 'armor' then
      ClsArmor[k] := ClsClamp(ClsNum(P, 0.85), 0, 10)
    else if W = 'spot' then
      ClsSpotF[k] := ClsClamp(ClsNum(P, 2), 0.1, 20)
    else if W = 'distance' then
      ClsDistF[k] := ClsClamp(ClsNum(P, 1.5), 0, 20)
    else if W = 'detector' then
      ClsDetR[k] := ClsClamp(ClsNum(P, 160), 20, 2000)
    else if W = 'crit' then
    begin
      ClsCrit[k] := ClsClamp(ClsNum(P, 25), 0, 100);
      ClsCritF[k] := ClsClamp(ClsNum(P, 1.15), 1, 10);
    end
    else if W = 'wounds' then
      ClsWoundsF[k] := ClsClamp(ClsNum(P, 2), 0, 10)
    else if W = 'leech' then
      ClsLeech[k] := ClsClamp(ClsNum(P, 4), 0, 100)
    else if W = 'firstaid' then
      ClsMedicR[k] := ClsClamp(ClsNum(P, 40), 10, 300)
    else if W = 'damage' then
    begin
      Wp := ShWeaponWord(ClsTake(P, ' '));
      if (Wp < 0) or (Wp > 16) then
      begin
        if Warn then
          CfgWarn(Sec, 'Perks', 'damage', 'a weapon word, a factor and a stance (any, crouch, prone, low)');
      end
      else if ClsDmgN[k] < 4 then
      begin
        d := ClsDmgN[k];
        ClsDmgW[k][d] := Wp;
        ClsDmgF[k][d] := ClsClamp(ClsNum(P, 1), 0, 20);
        St := ClsTake(P, ' ');
        ClsDmgSt[k][d] := STC_ANY;
        if St = 'crouch' then
          ClsDmgSt[k][d] := STC_CROUCH
        else if St = 'prone' then
          ClsDmgSt[k][d] := STC_PRONE
        else if St = 'low' then
          ClsDmgSt[k][d] := STC_LOW;
        ClsDmgN[k] := d + 1;
      end
      else if Warn then
        CfgWarn(Sec, 'Perks', 'damage', 'four damage perks at most - the others are left out');
    end
    else if W <> '' then
      if Warn then
        CfgWarn(Sec, 'Perks', W, 'heal, repair, ammo, revive, bandage, damage, armor, spot, distance, detector, crit, ' +
          'wounds, leech or firstaid');
  end;
end;

{ Skill / Skill2 = rally SECONDS COOLDOWN RADIUS, healthpack COOLDOWN, grenadekit COOLDOWN, statgun SECONDS COOLDOWN,
  mortar SHELLS COOLDOWN SPREAD, uav SECONDS COOLDOWN, supply COOLDOWN [ammo|medical|grenades|...], patchup PERCENT
  COOLDOWN, resupply COOLDOWN; off = none }
procedure ClsSkillOf(k, n: Integer; P, Sec, Key: string; Warn: Boolean);
var
  W: string;
begin
  ClsSk[k][n] := SK_NONE;
  ClsSkCool[k][n] := 0;
  ClsSkOnT[k][n] := 0;
  ClsSkP1[k][n] := 0;
  ClsSkP2[k][n] := 0;
  ClsSkWhat[k][n] := '';
  P := LowerCase(P);
  W := ClsTake(P, ' ');
  if (W = '') or (W = 'off') or (W = 'none') or (W = '-') then
    Exit;
  if W = 'rally' then
  begin
    ClsSk[k][n] := SK_RALLY;
