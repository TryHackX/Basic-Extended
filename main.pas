{ [Teams] Balance: the team words follow the balance rule (Balance = auto: the server's Balance_Teams) }
function TeBalanceOn(): Boolean;
begin
  Result := (TeBalance = 1) or ((TeBalance = 2) and TeServerBalance);
end;

{ may ID join Team by a team word: not one with as many players as his own (from the spectators: only the smallest) }
function TeJoinOk(ID, Team: Integer): Boolean;
var
  Mine, k, Least: Integer;
begin
  Result := True;
  if not TeBalanceOn() then
    Exit;
  if (Team < 1) or (Team > 4) then
    Exit;
  Mine := PL[ID].Team;
  if (Mine >= 1) and (Mine <= 4) then
  begin
    if Game.Teams[Team].Count >= Game.Teams[Mine].Count then
      Result := False;
    Exit;
  end;
  Least := Game.Teams[Team].Count;
  for k := 1 to 4 do
    if (k <= 2) or (Game.GameStyle = 2) then
      if Game.Teams[k].Count < Least then
        Least := Game.Teams[k].Count;
  if Game.Teams[Team].Count > Least then
    Result := False;
end;

procedure CmdJoin(ID: Integer; Team: Integer);
var
  P: TActivePlayer;
begin
  P := PL[ID];
  if Team < 0 then
  begin
    if P.Team <> TEAM_SPECTATOR then
    begin
      Say(ID, 'You''re already in the game.', ColorBad);
      Exit;
    end;
    Team := SmallerTeam();
  end
  else if P.Team = Team then
  begin
    Say(ID, 'You''re already in this team.', ColorBad);
    Exit;
  end
  else if TeamForMode(Team) <> Team then
  begin
    { D16: Charlie in CTF, a team in deathmatch }
    Say(ID, 'This game mode has no ' + TeamName(Team) + ' team.', ColorBad);
    Exit;
  end;
  { [LagGuard]: moved to the spectators for his connection - back when it is better }
  if LgdBlocked[ID] then
  begin
    Say(ID, ReplaceAll(LgdWaitText, '{ping}', IntToStr(P.Ping)), ColorBad);
    Exit;
  end;
  if not TeJoinOk(ID, Team) then
  begin
    Say(ID, TeamName(Team) + ' team is full.', ColorBad);
    Exit;
  end;
  P.ChangeTeam(Team, TJoinSilent);
  Say(ID, 'You joined the game.', ColorGood);
end;

procedure CmdSpec(ID: Integer);
var
  P: TActivePlayer;
begin
  P := PL[ID];
  if P.Team = TEAM_SPECTATOR then
  begin
    Say(ID, 'You''re already on the observer team.', ColorBad);
    Exit;
  end;
  if TeMaxSpec > 0 then
    if Game.Spectators >= TeMaxSpec then
    begin
      Say(ID, 'Spectators are full!', ColorBad);
      Exit;
    end;
  P.ChangeTeam(TEAM_SPECTATOR, TJoinSilent);
  Say(ID, 'You joined the observer team.', ColorGood);
end;

