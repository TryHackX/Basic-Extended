{ the class's values for this game mode (a map start, a load); Warn: the words are told (at a load) }
procedure ClsResolveOne(k: Integer; Warn: Boolean);
var
  M, Sec: string;
begin
  Sec := ClsSec[k];
  ClsInfo[k] := ClsVal(k, CK_INFO);
  M := Trim(ClsVal(k, CK_MAX));
  ClsMaxN[k] := 0;
  ClsMaxPct[k] := 0;
  if M <> '' then
    if Copy(M, Length(M), 1) = '%' then
      ClsMaxPct[k] := StrToIntDef(Trim(Copy(M, 1, Length(M) - 1)), 0)
    else
      ClsMaxN[k] := StrToIntDef(M, 0);
  ClsMenu[k] := ClsMenuOf(ClsVal(k, CK_PRIM), Sec, 'Primary', Warn) or ClsMenuOf(ClsVal(k, CK_SEC), Sec, 'Secondary',
    Warn);
  ClsLoadOf(k, ClsVal(k, CK_LOAD), Sec, Warn);
  ClsPerksOf(k, ClsVal(k, CK_PERKS), Sec, Warn);
  ClsSkillOf(k, 1, ClsVal(k, CK_SKILL), Sec, 'Skill', Warn);
  ClsSkillOf(k, 2, ClsVal(k, CK_SKILL2), Sec, 'Skill2', Warn);
  { [Insurgents]: the class's vest (none set: [Insurgents] Pattern) }
  M := Trim(ClsVal(k, CK_VEST));
  ClsVest[k] := -2;
  if M <> '' then
  begin
    ClsVest[k] := InsPatternOf(M);
    if ClsVest[k] = -2 then
      if Warn then
        CfgWarn(Sec, 'Vest', M, 'classic, hawk, inferno, shrapnel, ring, scatter, ied, plain, random or none');
  end;
end;

{ every class for this game mode; how classes are given (Assign) for it }
procedure ClsResolve(Warn: Boolean);
var
  k, d: Integer;
  S: string;
begin
  S := ClsAssignRaw;
  if Game.Realistic and Game.Survival and (ClsAssignRawRS <> '~') then
    S := ClsAssignRawRS
  else if Game.Survival and (ClsAssignRawS <> '~') then
    S := ClsAssignRawS
  else if Game.Realistic and (ClsAssignRawR <> '~') then
    S := ClsAssignRawR;
  S := LowerCase(Trim(S));
  ClsAssign := CL_CHOICE;
  if S = 'life' then
    ClsAssign := CL_LIFE
  else if S = 'round' then
    ClsAssign := CL_ROUND
  else if S = 'map' then
    ClsAssign := CL_MAP
  else if S = 'limited' then
    ClsAssign := CL_LIMITED
  else if S <> 'choice' then
    if Warn then
      CfgWarn('Classes', 'Assign', S, 'choice, limited, life, round or map; choice used');
  ClsDmgAny := False;
  ClsAnyHeal := False;
  for k := 1 to ClsCount do
  begin
    ClsResolveOne(k, Warn);
    if ClsCrit[k] > 0 then
      ClsDmgAny := True;
    if ClsHeal[k] > 0 then
      ClsAnyHeal := True;
    if Abs(ClsArmor[k] - 1) > 0.0001 then
      ClsDmgAny := True;
    for d := 0 to ClsDmgN[k] - 1 do
      if Abs(ClsDmgF[k][d] - 1) > 0.0001 then
        ClsDmgAny := True;
  end;
end;

{ the classes of [Classes] List, each from its section [Class-<name>]: every form of every key is read now (they are
  resolved for the mode at each map start) }
procedure ClsLoadClasses();
var
  S, W, Sec: string;
  k, Ck, OldN, i, j: Integer;
  Ins, Moved: Boolean;
  OldSec: array[1..20] of string;
  NewOf: array[1..20] of Integer;
begin
  { a /reloadsettings with another List: the players keep their classes by name (the numbers change) }
  OldN := ClsCount;
  for k := 1 to OldN do
    OldSec[k] := LowerCase(ClsSec[k]);
  ClsCount := 0;
  S := CfgStr('Classes', 'List', 'assault|medic|support|engineer|sniper|recon');
  { [Insurgents]: its classes after them (a # in front: the insurgents' side) }
  if CfgBool('Insurgents', 'Enabled', False) then
    S := S + '|#' + ReplaceAll(CfgStr('Insurgents', 'Classes',
      'hawk|healer|thief|saboteur|spotter|leader|raider|mortarman'), '|', '|#');
  while Trim(S) <> '' do
  begin
    W := ClsTake(S, '|');
    Ins := False;
    if Copy(W, 1, 1) = '#' then
    begin
      Ins := True;
      W := Trim(Copy(W, 2, Length(W)));
    end;
    if W <> '' then
      if ClsCount >= CL_MAX then
        Log('settings.ini: [Classes] List and [Insurgents] Classes: ' + IntToStr(CL_MAX) + ' classes at most - ' + W +
          ' left out')
      else
      begin
        k := ClsCount + 1;
        ClsIns[k] := Ins;
        Sec := 'Class-' + W;
        ClsSec[k] := Sec;
        ClsName[k] := CfgStr(Sec, 'Name', W);
        ClsWords[k] := '|' + LowerCase(ReplaceAll(ReplaceAll(CfgStr(Sec, 'Words', W), ' ', '|'), ',', '|')) + '|';
        ClsColor[k] := CfgColor(Sec, 'Color', ClsColor0);
        ClsModeBits[k] := ModeBits(Sec, 'dm|pm|tm|ctf|rm|inf|htf');
        for Ck := 0 to CK_LAST do
        begin
          ClsRaw[k][Ck * 4] := CfgStr(Sec, ClsKeyName(Ck), '');
          ClsRaw[k][Ck * 4 + 1] := CfgStr(Sec, ClsKeyName(Ck) + 'Realistic', '~');
          ClsRaw[k][Ck * 4 + 2] := CfgStr(Sec, ClsKeyName(Ck) + 'Survival', '~');
          ClsRaw[k][Ck * 4 + 3] := CfgStr(Sec, ClsKeyName(Ck) + 'RealisticSurvival', '~');
        end;
        ClsCount := k;
      end;
  end;
  if ClsEnabled then
  begin
    if ClsCount = 0 then
      Log('settings.ini: [Classes] List names no class');
    for k := 1 to ClsCount do
      if Trim(ClsRaw[k][CK_PRIM * 4] + ClsRaw[k][CK_SEC * 4]) = '' then
        Log('settings.ini: [' + ClsSec[k] + '] has no weapons (Primary, Secondary) - every weapon allowed');
  end;
  if OldN > 0 then
  begin
    Moved := OldN <> ClsCount;
    for k := 1 to OldN do
    begin
      NewOf[k] := 0;
      for j := 1 to ClsCount do
        if LowerCase(ClsSec[j]) = OldSec[k] then
          NewOf[k] := j;
      if NewOf[k] <> k then
        Moved := True;
    end;
    if Moved then
    begin
      for i := 1 to 32 do
      begin
        if (ClsOf[i] >= 1) and (ClsOf[i] <= OldN) then
          ClsOf[i] := NewOf[ClsOf[i]];
        if (ClsNext[i] >= 1) and (ClsNext[i] <= OldN) then
          ClsNext[i] := NewOf[ClsNext[i]];
        if (ClsLast[i] >= 1) and (ClsLast[i] <= OldN) then
          ClsLast[i] := NewOf[ClsLast[i]];
        for j := 1 to 20 do
          ClsPlayed[i][j] := 0;
      end;
      { Assign = map keeps class numbers: rolled again }
      if ClsMapStore <> nil then
        ClsMapStore.Clear;
    end;
  end;
end;

{ a section of a class that [Classes] List does not name (kept for later: not read, its keys not reported) }
function ClsUnlisted(Sec: string): Boolean;
var
  k: Integer;
begin
  Result := False;
  if LowerCase(Copy(Sec, 1, 6)) <> 'class-' then
    Exit;
  Result := True;
  for k := 1 to ClsCount do
    if LowerCase(ClsSec[k]) = LowerCase(Sec) then
      Result := False;
end;

{ the module on or idle in this game mode (a load, a map start); ClsRefresh sends the menus and perks too }
function ClsRefreshState(): Boolean;
var
  Was: Boolean;
begin
  Was := ClsActive;
  ClsActive := False;
  ClsIdleWhy := 'switched off';
  if ClsEnabled then
  begin
    if ClsCount = 0 then
      ClsIdleWhy := '[Classes] List names no class'
    else if ((ClsModes shr GameStyleNow()) and 1) = 0 then
      ClsIdleWhy := 'this game mode is not in [Classes] Modes'
    else if Game.Advance then
      ClsIdleWhy := 'the Advance mode gives the weapons itself'
    else
    begin
      ClsActive := True;
      ClsIdleWhy := '';
    end;
    if ClsActive <> Was then
    begin
      if ClsActive then
        Log('[Classes] on')
      else
        Log('[Classes] idle: ' + ClsIdleWhy);
    end;
  end;
  Result := ClsActive <> Was;
end;

