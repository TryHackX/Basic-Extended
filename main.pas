end;

{ [Insurgents] Hud: "Vest: ready" / "Vest: 0.6 s" (going off) / "Vest: wait 2 s" ('' = no line) }
function InsHudWant(ID: Integer): string;
var
  T, n, Tm: Integer;
  St: string;
begin
  Result := '';
  if not InsActive then
    Exit;
  if not InsHudOn then
    Exit;
  if not (HumanOf[ID] or DebugBots) then
    Exit;
  if InsVest[ID] < 0 then
    Exit;
  if not PL[ID].Alive then
    Exit;
  T := Game.TickCount;
  if InsArmAt[ID] > 0 then
    St := ReplaceAll(InsArmingText, '{seconds}', InsTenths(InsHoldTicks - (T - InsArmAt[ID])))
  else
  begin
    n := InsLifeAt[ID] + InsMinLifeTicks - T;
    Tm := TeamOf[ID];
    if (Tm >= 1) and (Tm <= 4) then
      if InsTeamCool[Tm] - T > n then
        n := InsTeamCool[Tm] - T;
    if n > 0 then
      St := ReplaceAll(InsWaitText, '{seconds}', IntToStr((n + 59) div 60))
    else
      St := InsReadyText;
  end;
  Result := ReplaceAll(InsHudText, '{state}', St);
end;

{ [Classes] wounds perk: how much more often his hits open wounds of [Bleeding] (1 = as anybody's) }
function ClsWoundsOf(S: Integer): Single;
var
  c: Integer;
begin
  Result := 1;
  if not ClsActive then
    Exit;
  if (S < 1) or (S > 32) then
    Exit;
  c := ClsOf[S];
  if (c >= 1) and (c <= ClsCount) then
    if ClsWoundsF[c] > 0 then
      Result := ClsWoundsF[c];
end;

{ ---------------- the HUD lines: placing and sending ---------------- }

{ a line placed over the ammunition (its HudPlace = ammo); else at its own fixed place }
function HlStacked(L: Integer): Boolean;
begin
  Result := False;
  case L of
    HL_FLASH: Result := FnHudWhere = FHP_AMMO;
    HL_MINES: Result := MnHudWhere = 1;
    HL_BLOOD: Result := BdHudWhere = 1;
    HL_MONEY: Result := ShHudWhere = 1;
    HL_CLASS: Result := ClsHudWhere = 1;
    HL_SCORE: Result := BpHudWhere = 1;
    HL_VEST: Result := InsHudWhere = 1;
  end;
end;

{ the fixed place of a line (HudPlace = fixed: its HudX, HudY, HudScale) }
procedure HlFixedPlace(L: Integer; var X, Y: Integer; var Sc: Single);
begin
  case L of
    HL_FLASH:
      begin
        X := FnHudX;
        Y := FnHudY;
        Sc := FnHudScale;
      end;
    HL_MINES:
      begin
        X := MnHudX;
        Y := MnHudY;
        Sc := MnHudScale;
      end;
    HL_BLOOD:
      begin
        X := BdHudX;
        Y := BdHudY;
        Sc := BdHudScale;
      end;
    HL_MONEY:
      begin
        X := ShHudX;
        Y := ShHudY;
        Sc := ShHudScale;
      end;
    HL_CLASS:
      begin
        X := ClsHudX;
        Y := ClsHudY;
        Sc := ClsHudScale;
      end;
    HL_SCORE:
      begin
        X := BpHudX;
        Y := BpHudY;
        Sc := BpHudScale;
      end;
  else
    begin
      X := InsHudX;
      Y := InsHudY;
      Sc := InsHudScale;
    end;
  end;
end;

{ a line over the ammunition at Y (H high) would meet the health line (a line of its own with HudAppend = 2) or a
  line at its fixed place shown now (the places of the player being drawn: HlPX, HlPY, HlPSc) }
function HlClash(ID, Y, H: Integer): Boolean;
var
  L, FH: Integer;
begin
  Result := False;
  if AmmoEnabled and (AmmoHudMode = 2) then
    if HlWant[ID][HL_HEALTH] <> '' then
    begin
      FH := Round(HlPSc[HL_HEALTH] * 207.4);
      if Y < HlPY[HL_HEALTH] + FH then
        if Y + H > HlPY[HL_HEALTH] then
          Result := True;
    end;
  for L := HL_FLASH to HL_VEST do
    if not HlStacked(L) then
      if HlWant[ID][L] <> '' then
      begin
        FH := Round(HlPSc[L] * 207.4);
        if Y < HlPY[L] + FH then
          if Y + H > HlPY[L] then
            Result := True;
      end;
end;

{ round 26: the library's copy of the HUD's layers, the fixed places, which lines stand over the ammunition, the
  times }
procedure HudCfgSend();
var
  L, X, Y: Integer;
  Sc: Single;
begin
  HudCfgDirty := False;
  for L := 0 to 8 do
  begin
    X := 0;
    Y := 0;
    Sc := 0.06;
    if L >= HL_FLASH then
      HlFixedPlace(L, X, Y, Sc);
    BE_HudCfgLine(L, HlLayerOf(L), BoolInt(HlStacked(L)), X, Y, Sc);
  end;
  BE_HudCfgTimes(HlLifeTicks, HlDueTicks, BoolInt(AmmoEnabled and (AmmoHudMode = 2)));
end;

{ his lines: the marked ones built again, all of them placed, what changed (or is due) sent }
procedure HlFlushOne(ID: Integer);
var
  P: TActivePlayer;
  M, L, k, Below, AX, AY, AH, X, Y, n, La, Ti, Co: Integer;
  ASc, Sc: Single;
  Force: Boolean;
  T: string;
  C: Longint;
begin
  M := HudLines[ID];
  HudLines[ID] := 0;
  Force := HudForce[ID];
  HudForce[ID] := False;
  if not ActiveSlot[ID] then
    Exit;
  P := PL[ID];
  if not P.Active then
    Exit;
  { the texts of the marked lines }
  if (M and HLB_HEALTH) <> 0 then
  begin
    HudWant(ID, P, T, C);
    HlWant[ID][HL_HEALTH] := T;
    HlWantC[ID][HL_HEALTH] := C;
  end;
  if (M and HLB_AMMO) <> 0 then
  begin
    AmmoHudWant(ID, P, T, C);
    HlWant[ID][HL_AMMO] := T;
    HlWantC[ID][HL_AMMO] := C;
  end;
  if (M and HLB_FLASH) <> 0 then
  begin
    HlWant[ID][HL_FLASH] := FnHudWant(ID, P);
    HlWantC[ID][HL_FLASH] := FnHudColor;
  end;
  if (M and HLB_MINES) <> 0 then
  begin
    HlWant[ID][HL_MINES] := MnHudWant(ID, P);
    HlWantC[ID][HL_MINES] := MnHudColor;
  end;
  if (M and HLB_BLOOD) <> 0 then
  begin
    HlWant[ID][HL_BLOOD] := BdHudWant(ID, P, C);
    HlWantC[ID][HL_BLOOD] := C;
  end;
  if (M and HLB_MONEY) <> 0 then
  begin
    HlWant[ID][HL_MONEY] := ShHudWant(ID, C);
    HlWantC[ID][HL_MONEY] := C;
  end;
  if (M and HLB_CLASS) <> 0 then
  begin
    HlWant[ID][HL_CLASS] := ClsHudWant(ID, P);
    C := ClsHudColor;
    k := ClsOf[ID];
    if ClsNext[ID] > 0 then
      if not P.Alive then
        k := ClsNext[ID];
    if (k >= 1) and (k <= ClsCount) then
      C := ClsColor[k];
    HlWantC[ID][HL_CLASS] := C;
  end;
  if (M and HLB_SCORE) <> 0 then
  begin
    HlWant[ID][HL_SCORE] := BpHudWant(ID);
    HlWantC[ID][HL_SCORE] := BpHudColor;
  end;
  if (M and HLB_VEST) <> 0 then
  begin
    HlWant[ID][HL_VEST] := InsHudWant(ID);
    HlWantC[ID][HL_VEST] := InsHudColor;
    if InsArmAt[ID] > 0 then
      HlWantC[ID][HL_VEST] := InsArmColor;
  end;
  { round 26: the library places the lines and says what his game must be sent (be_hud) }
  if BeOk then
  begin
    if HudCfgDirty then
      HudCfgSend();
    for L := 0 to 8 do
      if (M and (1 shl L)) <> 0 then
        BE_HudWant(ID, L, PChar(HlWant[ID][L]), HlWantC[ID][L]);
    HudHealthPlace(ID, X, Y, Sc);
    BE_HudPlace(ID, HL_HEALTH, X, Y, Sc);
    HudAmmoPlace(ID, X, Y, Sc);
    BE_HudPlace(ID, HL_AMMO, X, Y, Sc);
    n := BE_HudDraw(ID, Game.TickCount, BoolInt(Force));
    for k := 0 to n - 1 do
    begin
      T := BE_HudOp(k, La, Ti, Co, X, Y, Sc);
      if Ti = 0 then
        P.BigText(La, ' ', 1, ColorGood, 0.01, 0, 0)
      else
        P.BigText(La, T, Ti, Co, Sc, X, Y);
      StatHud := StatHud + 1;
    end;
    Exit;
  end;
  { the places: the health line, the ammunition line, the lines at fixed places }
  HudHealthPlace(ID, X, Y, Sc);
  HlPX[HL_HEALTH] := X;
  HlPY[HL_HEALTH] := Y;
  HlPSc[HL_HEALTH] := Sc;
  HudAmmoPlace(ID, X, Y, Sc);
  HlPX[HL_AMMO] := X;
  HlPY[HL_AMMO] := Y;
  HlPSc[HL_AMMO] := Sc;
  for L := HL_FLASH to HL_VEST do
    if not HlStacked(L) then
    begin
      HlFixedPlace(L, X, Y, Sc);
      HlPX[L] := X;
      HlPY[L] := Y;
      HlPSc[L] := Sc;
    end;
  { the lines over the ammunition (its line with HudAppend = 2, else the health line): one line up for each one
    shown, past the health line and the fixed lines; under it when the top of the screen is reached }
  if AmmoEnabled and (AmmoHudMode = 2) then
    k := HL_AMMO
  else
    k := HL_HEALTH;
  AX := HlPX[k];
  AY := HlPY[k];
  ASc := HlPSc[k];
  { a line of a BigText is 1.157 of the font's 179.2 units per scale }
  AH := Round(ASc * 207.4);
  if AH < 1 then
    AH := 1;
  k := 0;
  Below := 0;
  for L := HL_FLASH to HL_VEST do
    if HlStacked(L) then
    begin
      HlPX[L] := AX;
      HlPY[L] := AY;
      HlPSc[L] := ASc;
      if HlWant[ID][L] <> '' then
      begin
        repeat
          k := k + 1;
          Y := AY - k * AH;
        until (Y < 0) or (not HlClash(ID, Y, AH));
        if Y < 0 then
        begin
          Below := Below + 1;
          Y := AY + Below * AH;
        end;
        HlPY[L] := Y;
      end;
    end;
  for L := 0 to 8 do
    HlSend(ID, L, P, HlWant[ID][L], HlPX[L], HlPY[L], HlPSc[L], HlWantC[ID][L], Force);
end;

{ all his lines are built again (Force: sent even when nothing changed) }
procedure HudMark(ID: Integer; Force: Boolean);
begin
  if not HumanOf[ID] then
    if not DebugBots then
      Exit;
  HudLines[ID] := HLB_ALL;
  HudDirty[ID] := True;
  if Force then
    HudForce[ID] := True;
  HudAnyDirty := True;
end;

{ only these lines are built again (HLB_* bits; 0: none - the places and the refreshes are looked at) }
procedure HudMarkL(ID, Bits: Integer);
begin
  if not HumanOf[ID] then
    if not DebugBots then
      Exit;
  HudLines[ID] := HudLines[ID] or Bits;
  HudDirty[ID] := True;
  HudAnyDirty := True;
end;

{ the line of the ammunition: its own with HudAppend = 2, else the end of the health line }
function HlAmmoBits(): Integer;
begin
  if AmmoEnabled and (AmmoHudMode = 2) then
    Result := HLB_AMMO
  else
    Result := HLB_HEALTH;
end;

procedure HudMarkAll(Force: Boolean);
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    HudMark(i, Force);
end;

{ the marked players; an error in one of them leaves the others drawn }
procedure HudFlush();
var
  i: Integer;
begin
  HudAnyDirty := False;
  for i := 1 to TopSlot do
    if HudDirty[i] then
    begin
      HudDirty[i] := False;
      try
        HlFlushOne(i);
      except
        HudErrors := HudErrors + 1;
      end;
    end;
end;

{ the texts of players at low health change colour every LowBlinkTicks }
procedure LowBlinkTick(Tick: Integer);
var
  i: Integer;
begin
  if Tick < DueBlink then
    Exit;
  DueBlink := After(Tick, HudLowBlink);
  for i := 1 to TopSlot do
    if HudLowOn[i] then
      HudMarkL(i, HLB_HEALTH);
end;

{ the players with NO AMMO: drawn again every BlinkTicks ([AmmoHud]) }
procedure AmmoBlinkTick(Tick: Integer);
var
  i: Integer;
begin
  if Tick < DueAmBlink then
    Exit;
  DueAmBlink := After(Tick, AhBlink);
  for i := 1 to TopSlot do
    if AmBlinkOn[i] then
      HudMarkL(i, HLB_AMMO);
end;

{ one player, every 30 ticks: health lost without a hit (hurt and lava polygons, other scripts), a health or a
  vest his line does not show yet, a shown line whose refresh is due (HlSend sends it) }
procedure HudPollOne(i, Tick: Integer);
var
  P: TActivePlayer;
  H: Single;
  S, L: Integer;
  Due: Boolean;
begin
  P := PL[i];
  if not P.Active then
    Exit;
  if P.Alive then
  begin
    H := P.Health;
    if H < LastHealth[i] - 0.01 then
    begin
      LastHit[i] := Tick;
      Regenerating[i] := False;
    end;
    LastHealth[i] := H;
    if RegEnabled then
      if H < MaxHealth * RegMaxPercent / 100 - 0.01 then
        if not Hurt[i] then
          if P.Human or RegBots then
            Hurt[i] := True;
    if HudEnabled then
      if P.Human or DebugBots then
      begin
        if HlWant[i][HL_HEALTH] = '' then
        begin
          if HudIsOn(i) then
            HudMarkL(i, HLB_HEALTH);
        end
        else if Abs(H - HlDrawnH[i]) > 0.01 then
          HudMarkL(i, HLB_HEALTH)
        else
        begin
          S := HudPStyle[i];
          if (S < 1) or (S > STYLE_COUNT) then
            S := HudDefStyle;
          if HudHasVest[S] then
            if Round(P.Vest) <> HlDrawnV[i] then
              HudMarkL(i, HLB_HEALTH);
        end;
      end;
  end
  else if HlWant[i][HL_HEALTH] <> '' then
    HudMarkL(i, HLB_HEALTH);
  Due := False;
  if BeOk then
    Due := BE_HudDue(i, Tick) = 1
  else
    for L := 0 to 8 do
      if HlState[i][L] <> HS_HIDDEN then
        if Tick - HlTick[i][L] >= HlDueTicks then
          Due := True;
  if Due then
    HudMarkL(i, 0);
end;

{ every tick one or two players (each one every 30 ticks): no tick draws everybody }
procedure HudPoll(Tick: Integer);
var
  i: Integer;
begin
  i := 30 - Tick mod 30;
  while i <= TopSlot do
  begin
    if ActiveSlot[i] then
      HudPollOne(i, Tick);
    i := i + 30;
  end;
end;

{ [Ammo]: the game dropped the weapon in the hands this tick without a death (a team change, leaving
  the game): it stays on the ground with the soldier's spare magazines, as a dead soldier's does. Its
  map object is looked for in the next tick. }
procedure AmmoLeftBehind(ID: Integer);
var
  W: Integer;
begin
  if not AmmoEnabled then
    Exit;
  if AmDropT[ID] <> Game.TickCount then
    Exit;
  AmDropT[ID] := -1;
  W := BE_AmmoLeftBehind(ID, Game.TickCount, AmDropX[ID], AmDropY[ID]);
  if W >= 0 then
  begin
    AmCorpseW[ID] := W;
    AmCorpseN := AmCorpseN + 1;
    AmCorpseT[ID] := Game.TickCount;
    AmCorpseX[ID] := AmDropX[ID];
    AmCorpseY[ID] := AmDropY[ID];
  end;
end;

{ ================================ regeneration ================================ }

{ a new life, a new map or a new player: nothing waits, nothing regenerates }
procedure ResetLife(ID: Integer);
var
  j: Integer;
begin
  Hurt[ID] := False;
  Regenerating[ID] := False;
  LastHit[ID] := 0;
  LastSupp[ID] := 0;
  LastHealth[ID] := MaxHealth;
  { kill info counts the damage done during this life to the other player's current fight; a kill
    mark that waited for his number is not for his next life }
  for j := 1 to 32 do
  begin
    Dealt[ID][j] := 0;
    Dealt[j][ID] := 0;
    DnKillPend[j][ID] := False;
  end;
  if AmmoEnabled then
  begin
    { a team change dropped the weapon in the hands just before this respawn }
    AmmoLeftBehind(ID);
    BE_AmmoRespawn(ID, Game.TickCount);
  end;
  AmRepacking[ID] := False;
  AmNoAmmoUntil[ID] := 0;
  AmSetLastW(ID, -1);
  AmLastSW[ID] := -1;
  AmLootTicks[ID] := 0;
  AmBody[ID] := False;
end;

{ Method = damage heals through Soldat's damage routine (other scripts see a heal), but a vest would
  keep three quarters of it and round small heals away: with a vest the health is set directly }
procedure ApplyHeal(ID: Integer; P: TActivePlayer; H, Amount: Single);
var
  Direct: Boolean;
begin
  Direct := True;
  if RegByDamage then
    if P.Vest <= 0 then
      Direct := False;
  if Direct then
    P.Health := H + Amount
  else
    P.Damage(ID, -Amount);
  LastHealth[ID] := P.Health;
  StatHeals := StatHeals + 1;
end;

procedure RegenPass(Tick: Integer);
var
  i, j: Integer;
  P: TActivePlayer;
  H, Cap, Rate, Add, PCap: Single;
  Wait: Boolean;
begin
  Cap := MaxHealth * RegMaxPercent / 100;
  HurtCount := 0;
  for i := 1 to TopSlot do
    if Hurt[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        Hurt[i] := False;
        Regenerating[i] := False;
        Continue;
      end;
      if not P.Alive then
      begin
        Hurt[i] := False;
        Regenerating[i] := False;
        Continue;
      end;
      H := P.Health;
      { health lost since the last look without a hit: lava, hurt polygons, other scripts }
      if H < LastHealth[i] - 0.01 then
        LastHit[i] := Tick;
      LastHealth[i] := H;
      { [Bleeding] RegenBlock: with little blood the health comes back only up to the blood's share }
      PCap := Cap;
      if BdActive then
        if BdRegenBlock then
          if BdBlood[i] < BdWeak then
            if MaxHealth * BdBlood[i] / 100 < PCap then
              PCap := MaxHealth * BdBlood[i] / 100;
      if H >= PCap - 0.01 then
      begin
        Hurt[i] := False;
        if Regenerating[i] then
        begin
          Regenerating[i] := False;
          HudMarkL(i, HLB_HEALTH);
        end;
        Continue;
      end;
      HurtCount := HurtCount + 1;
      Wait := Tick - LastHit[i] < RegDelayTicks;
      if SupEnabled then
        if Tick - LastSupp[i] < SupDelayTicks then
          Wait := True;
      { [Bleeding]: not while a wound bleeds; [Downed]: not while he is down }
      if DwDown[i] then
        Wait := True;
      if BdActive then
        if BdRegenBlock then
          if BdWounds[i] > 0 then
            Wait := True;
      if Wait then
      begin
        if Regenerating[i] then
        begin
          Regenerating[i] := False;
          HudMarkL(i, HLB_HEALTH);
        end;
        Continue;
      end;
      if not Regenerating[i] then
      begin
        Regenerating[i] := True;
        RegenStart[i] := Tick;
        { the fight is over: kill info counts the damage done to him from here on }
        for j := 1 to TopSlot do
          Dealt[j][i] := 0;
      end;
      Rate := RegStartRate + RegAccel * (Tick - RegenStart[i]) / 60;
      if Rate > RegMaxRate then
        Rate := RegMaxRate;
      Add := MaxHealth * Rate / 100 * RegStepTicks / 60;
      if H + Add > PCap then
        Add := PCap - H;
      if Add > 0 then
        ApplyHeal(i, P, H, Add);
      HudMarkL(i, HLB_HEALTH);
    end;
end;

{ Every enemy bullet is taken as the line it flies until the next look; a line that passes near a
  player who waits for regeneration delays it. Bullets take the lowest free slot, so the slots above
  the highest one in use (plus a margin for new ones) are empty and not looked at. }
procedure SuppressionScan(Tick: Integer);
var
  b, k, n, o, Top, M: Integer;
  Bul: TActiveMapBullet;
  List: array[1..32] of Integer;
  P: TActivePlayer;
begin
  n := 0;
  for k := 1 to TopSlot do
    if Hurt[k] then
    begin
      P := PL[k];
      n := n + 1;
      List[n] := k;
      SupI[(n - 1) * 2] := k;
      SupI[(n - 1) * 2 + 1] := TeamOf[k];
      SupF[(n - 1) * 2] := P.X;
      SupF[(n - 1) * 2 + 1] := P.Y - 10;
    end;
  if n = 0 then
    Exit;
  BE_SupPlayers(n, SupI, SupF);
  StatScans := StatScans + 1;
  Top := 0;
  if ScanTop > MAX_BULLET_ID then
    ScanTop := MAX_BULLET_ID;
  for b := 1 to ScanTop do
  begin
    Bul := BL[b];
    if Bul.Active then
    begin
      Top := b;
      StatBullets := StatBullets + 1;
      o := Bul.Owner;
      if (o >= 1) and (o <= 32) then
      begin
        M := BE_SupBullet(o, Bul.Style, Bul.X, Bul.Y, Bul.VelX, Bul.VelY);
        if M <> 0 then
          for k := 1 to n do
            if (M and SlotBit[List[k]]) <> 0 then
              LastSupp[List[k]] := Tick;
      end;
    end;
  end;
  ScanTop := Top + 32;
end;

{ ================================ kits ================================ }

{ switch off the spawn points of the kits [Kits] removes: kits are placed only where one is active }
procedure KitSpawnsOff();
var
  i, k: Integer;
begin
  for i := 1 to MAX_SPAWN_ID do
    if SP[i].Active then
    begin
      k := SP[i].Style;
      if (k >= 0) and (k <= 31) then
        if KitSpawn[k] then
          SP[i].Active := False;
    end;
end;

{ a killed kit stays dead for the rest of the map }
procedure KitSweep();
var
  i, k: Integer;
begin
  for i := 1 to MAX_OBJECT_ID do
    if OB[i].Active then
    begin
      k := OB[i].Style;
      if (k >= 0) and (k <= 31) then
        if KitObj[k] then
          if Game.TickCount >= ObjKeep[i] then
        begin
          OB[i].Kill;
          StatKits := StatKits + 1;
        end;
    end;
end;

{ ================================ sharp texts ================================ }

{ The client fades a text out over its last 77 ticks. With [DamageNumbers] Sharp a damage number is
  sent for FADE_MARGIN ticks longer than it should stay and taken away with ' ' at the wanted tick
  (WtHideDue): it keeps its full colour until then. If that ' ' is lost on the way, the number fades
  out as before. }
function WtTicks(Ticks: Integer): Integer;
begin
  Result := Ticks;
  if DmgSharp then
    Result := Ticks + FADE_MARGIN;
end;

procedure WtSharp(ID, Layer, Tick, Ticks: Integer);
var
  Due: Integer;
begin
  if not DmgSharp then
    Exit;
  if (Layer < 0) or (Layer > 255) then
    Exit;
  Due := After(Tick, Ticks);
  WtDue[ID][Layer] := Due;
  if (WtNext[ID] = 0) or (Due < WtNext[ID]) then
    WtNext[ID] := Due;
  if (WtNextAll = 0) or (Due < WtNextAll) then
    WtNextAll := Due;
end;

procedure WtHideDue(Tick: Integer);
var
  i, L, Next: Integer;
begin
  if WtNextAll = 0 then
    Exit;
  if Tick < WtNextAll then
    Exit;
  for i := 1 to TopSlot do
    if WtNext[i] > 0 then
      if Tick >= WtNext[i] then
      begin
        Next := 0;
        for L := DmgLayerFirst to DmgLayerLast do
          if WtDue[i][L] > 0 then
          begin
            if Tick >= WtDue[i][L] then
            begin
              WtDue[i][L] := 0;
              if PL[i].Active then
                PL[i].WorldText(L, ' ', 1, ColorGood, 0.01, 0, 0);
            end
            else if (Next = 0) or (WtDue[i][L] < Next) then
              Next := WtDue[i][L];
          end;
        WtNext[i] := Next;
      end;
  WtNextAll := 0;
  for i := 1 to TopSlot do
    if WtNext[i] > 0 then
      if (WtNextAll = 0) or (WtNext[i] < WtNextAll) then
        WtNextAll := WtNext[i];
end;

{ ================================ damage numbers ================================ }

function DmgIsOn(ID: Integer): Boolean;
begin
  if DmgPOn[ID] = PREF_DEFAULT then
    Result := DmgDefaultOn
  else
    Result := DmgPOn[ID] = PREF_ON;
end;

function DmgNumber(V: Single): string;
var
  N: Integer;
begin
  N := Round(V);
  if N < 1 then
    N := 1;
  Result := '-' + IntToStr(N);
  if DmgPercent then
    Result := Result + '%';
end;

{ ================================ [TeamKill] ================================ }

{ The owner's old tk script (ban points, the victim's !1-!4) grown into an automatic guard: every hit on
  a team mate and every team kill gives points by how meant it looked - the library follows the line of
  every shot (aimed at the mate with no enemy near, crossfire, a blast near enemies, a spray) - the
  points climb a ladder of penalties (a warning, his fire at the team blocked and turned back on him, a
  slay, a kick, bans that grow) and melt away with time, and the record follows the player by his Steam
  id. The victim still decides about the kill (forgive, kill him, points, next round in survival). }

function FfMates(A, B: Integer): Boolean;
begin
  Result := False;
  if A = B then
    Exit;
  if not TeamGame() then
    Exit;
  if (TeamOf[A] < 1) or (TeamOf[A] > 4) then
    Exit;
  Result := TeamOf[A] = TeamOf[B];
end;

{ bots are left alone unless [TeamKill] Bots = 1 }
function FfCounts(ID: Integer): Boolean;
begin
  Result := False;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not PL[ID].Active then
    Exit;
  Result := PL[ID].Human or FfBots;
end;

procedure FfPlayerSync(ID: Integer; Alive: Boolean);
begin
  if BeOk then
    BE_TkPlayer(ID, TeamOf[ID], BoolInt(Alive));
end;

procedure FfLog(Text: string);
begin
  Log('[TeamKill] ' + Text);
  if FfLogName = '' then
    Exit;
  if not BeOk then
    Exit;
  BE_Log(PChar(DataDir + FfLogName), PChar(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '  ' + Game.CurrentMap + '  ' +
    Text));
end;

function FfWhy(Reason: Integer): string;
begin
  case Reason of
    TR_AIMED: Result := 'aimed at him';
    TR_SPRAY: Result := 'sprayed at him';
    TR_CROSSFIRE: Result := 'crossfire';
    TR_SPLASH_ENEMY: Result := 'a blast near enemies';
    TR_SPLASH_ALONE: Result := 'a blast with no enemy near';
    TR_MELEE: Result := 'knife or fists';
    TR_STRAY: Result := 'he ran into the fire';
  else
    Result := 'no shot seen';
  end;
end;

function FfPtsStr(P: Single): string;
begin
  Result := FloatStr(P, 1);
end;

{ the texts' tokens (in curly brackets): player = ID, victim and killer = Other, points, max, why, shots,
  seconds, minutes }
function FfFill(T: string; ID, Other: Integer; Why: string; N: Integer): string;
begin
  Result := T;
  if (ID >= 1) and (ID <= 32) then
  begin
    Result := ReplaceAll(Result, '{player}', PL[ID].Name);
    Result := ReplaceAll(Result, '{points}', FfPtsStr(FfPts[ID]));
  end;
  if (Other >= 1) and (Other <= 32) then
  begin
    Result := ReplaceAll(Result, '{victim}', PL[Other].Name);
    Result := ReplaceAll(Result, '{killer}', PL[Other].Name);
  end;
  Result := ReplaceAll(Result, '{max}', FfPtsStr(FfBanAt));
  Result := ReplaceAll(Result, '{why}', Why);
  Result := ReplaceAll(Result, '{shots}', IntToStr(N));
  Result := ReplaceAll(Result, '{seconds}', IntToStr(N));
  Result := ReplaceAll(Result, '{minutes}', IntToStr(N));
end;

procedure FfBig(ID: Integer; Text: string);
begin
  if FfBigTicks <= 0 then
    Exit;
  if Text = '' then
    Exit;
  if not PL[ID].Active then
    Exit;
  if PL[ID].Human or DebugBots then
    PL[ID].BigText(FfLayer, Text, FfBigTicks, FfColor, FfBigScale, FfBigX, FfBigY);
end;

procedure FfSay(ID: Integer; Text: string; Color: Longint);
begin
  if Text <> '' then
    if PL[ID].Active then
      if PL[ID].Human or DebugBots then
        Say(ID, Text, Color);
end;

{ his team mates hear it (not he himself) }
procedure FfSayTeam(ID: Integer; Text: string);
var
  i: Integer;
begin
  if Text = '' then
    Exit;
  for i := 1 to TopSlot do
    if i <> ID then
      if ActiveSlot[i] then
        if TeamOf[i] = TeamOf[ID] then
          FfSay(i, Text, FfInfoColor);
end;

{ the step of the ladder these points reach (0 = none; a step at 0 points is off) }
function FfStepOf(P: Single): Integer;
begin
  Result := 0;
  if FfWarnAt > 0 then
    if P >= FfWarnAt then
      Result := TKA_WARN;
  if FfShieldAt > 0 then
    if P >= FfShieldAt then
      Result := TKA_SHIELD;
  if FfSlayAt > 0 then
    if P >= FfSlayAt then
      Result := TKA_SLAY;
  if FfKickAt > 0 then
    if P >= FfKickAt then
      Result := TKA_KICK;
  if FfBanAt > 0 then
    if P >= FfBanAt then
      Result := TKA_BAN;
end;

{ his fire at the team blocked: for a while after a spray or a step of the ladder, and while his points
  stay at ShieldAt }
function FfShielded(ID, Tick: Integer): Boolean;
begin
  Result := FfShieldUntil[ID] > Tick;
  if not Result then
    if FfShieldAt > 0 then
      Result := FfPts[ID] >= FfShieldAt;
end;

procedure FfShieldOn(ID, Tick: Integer);
begin
  if FfShieldTicks <= 0 then
    Exit;
  if FfShieldUntil[ID] < After(Tick, FfShieldTicks) then
    FfShieldUntil[ID] := After(Tick, FfShieldTicks);
  FfShieldNote[ID] := True;
end;

procedure FfSlay(ID: Integer);
begin
  if not PL[ID].Active then
    Exit;
  if not PL[ID].Alive then
    Exit;
  ServerKill[ID] := Game.TickCount;
  AdminHit[ID] := Game.TickCount;
  PL[ID].Damage(ID, 4000);
end;

{ a player's record in players.bdb under 'K' and his key: points*1000, bans, team kills ever, the
  minute it was written (the points melt between his visits too, DecayOffline), the minute of his last
  ban (BanForgetDays) }
function FfNowMin(): Integer;
begin
  Result := Round(Now * 1440);
end;

procedure FfSave(ID: Integer);
var
  Key: string;
begin
  FfDirty[ID] := False;
  if not FfKeep then
    Exit;
  if not BeOk then
    Exit;
  Key := FfKey[ID];
  if Key = '' then
    Exit;
  if (FfPts[ID] < 0.001) and (FfBans[ID] = 0) and (FfTotal[ID] = 0) then
  begin
    if BE_Pref_Count(PChar('K' + Key)) > 0 then
      BE_Pref_Save(PChar('K' + Key), 0, PfI);
    Exit;
  end;
  PfI[0] := Round(FfPts[ID] * 1000);
  PfI[1] := FfBans[ID];
  PfI[2] := FfTotal[ID];
  PfI[3] := FfNowMin();
  PfI[4] := FfBanMinute[ID];
  BE_Pref_Save(PChar('K' + Key), 5, PfI);
end;

procedure FfClear(ID: Integer);
var
  k: Integer;
begin
  FfPts[ID] := 0;
  FfStep[ID] := 0;
  FfBans[ID] := 0;
  FfTotal[ID] := 0;
  FfMapKills[ID] := 0;
  FfMapDmg[ID] := 0;
  FfMirror[ID] := 0;
  FfShieldUntil[ID] := 0;
  FfShieldNote[ID] := False;
  FfNextRound[ID] := False;
  FfSlayDue[ID] := 0;
  FfBanMinute[ID] := 0;
  FfRise[ID] := 0;
  FfTold[ID] := -1000000;
  FfSpawnTick[ID] := -1000000;
  FfFlagTick[ID] := -1000000;
  FfLastTkBy[ID] := 0;
  FfLastTkTick[ID] := -1000000;
  FfLastWhy[ID] := '';
  FfDirty[ID] := False;
  FfLastFriendly[ID] := False;
  FfVoteBy[ID] := 0;
  for k := 1 to 32 do
  begin
    FfPair[ID][k] := 0;
    FfPair[k][ID] := 0;
    if FfVoteBy[k] = ID then
      FfVoteBy[k] := 0;
    if FfLastTkBy[k] = ID then
      FfLastTkBy[k] := 0;
  end;
end;

{ every BanForgetDays days without a ban the count of his bans goes one down, so the next ban is shorter
  again; the days left over count towards the next one }
procedure FfBanForget(ID: Integer);
var
  Per, Mins, n: Integer;
begin
  if FfBanForgetDays <= 0 then
    Exit;
  if FfBans[ID] <= 0 then
    Exit;
  Per := Round(FfBanForgetDays * 1440);
  if Per < 1 then
    Per := 1;
  Mins := FfNowMin();
  if FfBanMinute[ID] <= 0 then
    FfBanMinute[ID] := Mins;
  n := (Mins - FfBanMinute[ID]) div Per;
  if n <= 0 then
    Exit;
  if n > FfBans[ID] then
    n := FfBans[ID];
  FfBans[ID] := FfBans[ID] - n;
  FfBanMinute[ID] := FfBanMinute[ID] + n * Per;
  FfDirty[ID] := True;
end;

{ a new player: his record by his key (the points melted by the minutes since it was written, with
  DecayOffline; his bans by BanForgetDays) }
procedure FfLoad(ID: Integer);
var
  Cnt, Mins: Integer;
begin
  FfClear(ID);
  FfKey[ID] := PrefKey[ID];
  if FfKeep then
    if BeOk then
      if FfKey[ID] <> '' then
      begin
        Cnt := BE_Pref_Load(PChar('K' + FfKey[ID]), PfI);
        if Cnt >= 4 then
        begin
          FfPts[ID] := PfI[0] * 0.001;
          FfBans[ID] := PfI[1];
          FfTotal[ID] := PfI[2];
          if Cnt >= 5 then
            FfBanMinute[ID] := PfI[4]
          else
            FfBanMinute[ID] := PfI[3];
          Mins := FfNowMin() - PfI[3];
          if FfDecayOffline then
            if Mins > 0 then
              if FfDecayMin > 0 then
                FfPts[ID] := FfPts[ID] - Mins / FfDecayMin;
          if FfPts[ID] < 0 then
            FfPts[ID] := 0;
          FfBanForget(ID);
        end;
      end;
  { the step he is at now is not a new step: nothing happens to him for old points }
  FfStep[ID] := FfStepOf(FfPts[ID]);
  if BeOk then
    BE_TkForget(ID);
end;

{ Steam confirmed him after his join: the record goes by the Steam id from now on }
procedure FfAdopt(ID: Integer);
var
  Old, P: Single;
  Cnt: Integer;
begin
  if PrefKey[ID] = FfKey[ID] then
    Exit;
  if PrefKey[ID] = '' then
    Exit;
  Old := FfPts[ID];
  FfKey[ID] := PrefKey[ID];
  if FfKeep then
    if BeOk then
    begin
      Cnt := BE_Pref_Load(PChar('K' + FfKey[ID]), PfI);
      if Cnt >= 4 then
      begin
        P := PfI[0] * 0.001;
        if FfDecayOffline then
          if FfDecayMin > 0 then
            if FfNowMin() > PfI[3] then
              P := P - (FfNowMin() - PfI[3]) / FfDecayMin;
        if P < 0 then
          P := 0;
        if P > Old then
          FfPts[ID] := P;
        if PfI[1] > FfBans[ID] then
        begin
          FfBans[ID] := PfI[1];
          if Cnt >= 5 then
            FfBanMinute[ID] := PfI[4]
          else
            FfBanMinute[ID] := PfI[3];
          FfBanForget(ID);
        end;
        if PfI[2] > FfTotal[ID] then
          FfTotal[ID] := PfI[2];
        FfStep[ID] := FfStepOf(FfPts[ID]);
      end;
    end;
  FfDirty[ID] := True;
end;

function FfBanMinutes(ID: Integer): Integer;
var
  k: Integer;
begin
  Result := FfBanMin;
  if FfBanDouble then
    for k := 1 to FfBans[ID] do
      if Result < FfBanMaxMin then
        Result := Result * 2;
  if Result > FfBanMaxMin then
    Result := FfBanMaxMin;
end;

{ a step of the ladder reached }
procedure FfApply(ID, Step, Tick: Integer);
var
  Mins: Integer;
begin
  case Step of
    TKA_WARN:
      begin
        FfSay(ID, FfFill(FfWarnText, ID, 0, '', 0), FfColor);
        FfBig(ID, FfFill(FfWarnText, ID, 0, '', 0));
        FfLog(PL[ID].Name + ' warned (' + FfPtsStr(FfPts[ID]) + ' points)');
      end;
    TKA_SHIELD:
      begin
        FfShieldOn(ID, Tick);
        FfSay(ID, FfFill(FfShieldText, ID, 0, '', FfShieldTicks div 60), FfColor);
        FfBig(ID, FfFill(FfShieldText, ID, 0, '', FfShieldTicks div 60));
        FfSayTeam(ID, FfFill(FfShieldTeamText, ID, 0, '', 0));
        FfLog(PL[ID].Name + ': fire at the team blocked (' + FfPtsStr(FfPts[ID]) + ' points)');
      end;
    TKA_SLAY:
      begin
        FfShieldOn(ID, Tick);
        FfStatPunished := FfStatPunished + 1;
        if PL[ID].Alive then
        begin
          FfSlay(ID);
          FfSay(ID, FfFill(FfSlayText, ID, 0, '', 0), FfColor);
          FfBig(ID, FfFill(FfSlayText, ID, 0, '', 0));
          FfLog(PL[ID].Name + ' slain (' + FfPtsStr(FfPts[ID]) + ' points)');
        end
        else if Game.Survival then
        begin
          FfNextRound[ID] := True;
          FfSay(ID, FfFill(FfNextText, ID, 0, '', 0), FfColor);
          FfLog(PL[ID].Name + ' will be slain after his next respawn (' + FfPtsStr(FfPts[ID]) + ' points)');
        end;
      end;
    TKA_KICK:
      begin
        FfStatPunished := FfStatPunished + 1;
        SayAll(FfFill(FfKickText, ID, 0, '', 0), FfColor);
        FfLog(PL[ID].Name + ' kicked (' + FfPtsStr(FfPts[ID]) + ' points)');
        FfSave(ID);
        ScheduleBan(ID, 0, 'team killing');
      end;
    TKA_BAN:
      begin
        FfStatPunished := FfStatPunished + 1;
        Mins := FfBanMinutes(ID);
        if PL[ID].Human then
        begin
          FfBans[ID] := FfBans[ID] + 1;
          FfBanMinute[ID] := FfNowMin();
          SayAll(FfFill(FfBanText, ID, 0, '', Mins), FfColor);
          FfLog(PL[ID].Name + ' banned for ' + IntToStr(Mins) + ' minutes (' + FfPtsStr(FfPts[ID]) + ' points, ban ' +
            IntToStr(FfBans[ID]) + ')');
          FfSave(ID);
          ScheduleBan(ID, Mins, 'team killing (' + FfPtsStr(FfPts[ID]) + ' points)');
          if SbEnabled and SbAlsoSteam then
            if SteamId[ID] <> '' then
              if SbPend <> nil then
                SbPend.Add(SteamId[ID] + #1 + IntToStr(Mins) + #1 + 'TeamKill' + #1 + PL[ID].Name + #1 +
                  'team killing');
        end
        else
        begin
          { a bot has nothing to ban: it goes }
          SayAll(FfFill(FfKickText, ID, 0, '', 0), FfColor);
          ScheduleBan(ID, 0, 'team killing');
        end;
      end;
  end;
end;

{ the ladder after a change of the points: a higher step is carried out (the highest one reached - its
  text says it all), a lower one is only noted, so it can come again }
procedure FfLadder(ID, Tick: Integer);
var
  St: Integer;
begin
  St := FfStepOf(FfPts[ID]);
  if St > FfStep[ID] then
  begin
    FfStep[ID] := St;
    FfApply(ID, St, Tick);
  end
  else
    FfStep[ID] := St;
end;

procedure FfAddPoints(ID: Integer; Delta: Single; Tick: Integer);
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  FfPts[ID] := FfPts[ID] + Delta;
  if FfPts[ID] < 0 then
    FfPts[ID] := 0;
  FfDirty[ID] := True;
  if Delta > 0 then
    FfRise[ID] := Tick;
  FfLadder(ID, Tick);
end;

{ OnDamage, S hits his team mate V: how meant it looks (kept with the hit until the damage it really
  took is known, FfTeamDamage); while S's fire at the team is blocked the hit does ShieldShare of its
  damage and MirrorShare of it comes back to S in the next tick }
function FfFriendlyHit(Victim: TActivePlayer; S, V: Integer; Damage: Single; BulletId: Byte; Tick: Integer): Single;
var
  St, W, Reason, Intent: Integer;
begin
  Result := Damage;
  St := 0;
  if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
  begin
    St := BL[BulletId].Style;
    W := BL[BulletId].GetOwnerWeaponId;
    if (W = WEP_KNIFE) or (W = TK_WEP_SAW) then
      St := 11;
  end;
  Reason := TR_UNKNOWN;
  Intent := 50;
  if BeOk then
    Intent := BE_TkHit(S, V, St, Tick, Reason);
  if Victim.Flagger then
    FfFlagTick[V] := Tick;
  FfCurFriendly := FfCounts(S);
  FfCurIntent := Intent;
  FfCurReason := Reason;
  if not FfCurFriendly then
    Exit;
  FfStatHits := FfStatHits + 1;
  if FfShielded(S, Tick) then
  begin
    FfMirror[S] := FfMirror[S] + Damage * FfMirrorShare;
    if FfMirrorShare > 0 then
      FfMirrorAny := True;
    Result := Damage * FfShieldShare;
  end;
end;

{ the damage a team hit really took (DmgSettle): its points - a whole health = DamagePoints times how
  meant it looked; a word to him now and then }
procedure FfTeamDamage(S, V: Integer; Taken: Single; Intent, Reason: Integer);
var
  Pct, Pts: Single;
  Tick: Integer;
begin
  if not FfCounts(S) then
    Exit;
  Tick := Game.TickCount;
  Pct := Taken * 100 / MaxHealth;
  if Pct > 100 then
    Pct := 100;
  FfMapDmg[S] := FfMapDmg[S] + Pct;
  Pts := Pct / 100 * FfDamagePts * Intent / 100;
  FfPair[S][V] := FfPair[S][V] + Pts;
  if Pts > 0 then
    FfAddPoints(S, Pts, Tick);
  { the killing hit comes after the kill's vote was opened: forgiving the kill takes it back too }
  if FfVoteBy[V] = S then
    FfVotePts[V] := FfVotePts[V] + Pts;
  if Intent >= 50 then
    if Tick - FfTold[S] >= 300 then
    begin
      FfTold[S] := Tick;
      FfSay(S, FfFill(FfHitText, S, V, FfWhy(Reason), 0), FfColor);
    end;
end;

{ how S's recent shots went: "8 of 9 shots at him" }
function FfShotsText(S, V, Tick: Integer): string;
var
  AtT, Cross, AtEnemy, All: Integer;
begin
  Result := '';
  if not BeOk then
    Exit;
  AtT := 0;
  Cross := 0;
  AtEnemy := 0;
  All := 0;
  if BE_TkShots(S, V, Tick, AtT, Cross, AtEnemy, All) = 1 then
    if AtT > 0 then
      Result := IntToStr(AtT) + ' of ' + IntToStr(All) + ' shots at him';
end;

{ K killed his team mate V: the kill's points (how meant, sooner after V's respawn, a flag carrier, not
  for killing back), the texts, the victim's decision }
procedure FfKill(K, V: Integer; BulletId: Byte; Tick: Integer);
var
  St, W, Reason, Intent, Secs: Integer;
  F, Pts: Single;
  Why, Extra, Shots, T: string;
begin
  if not FfCounts(K) then
    Exit;
  FfStatKills := FfStatKills + 1;
  if FfLastFriendly[V] and (VicLastS[V] = K) then
  begin
    Intent := FfLastIntent[V];
    Reason := FfLastReason[V];
  end
  else
  begin
    St := 0;
    if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
    begin
      St := BL[BulletId].Style;
      W := BL[BulletId].GetOwnerWeaponId;
      if (W = WEP_KNIFE) or (W = TK_WEP_SAW) then
        St := 11;
    end;
    Reason := TR_UNKNOWN;
    Intent := 50;
    if BeOk then
      Intent := BE_TkHit(K, V, St, Tick, Reason);
  end;
  { Intent * 0.01: ScriptCore divides two whole numbers without the fraction }
  F := Intent * 0.01;
  Extra := '';
  if Tick - FfSpawnTick[V] <= FfSpawnTicks then
  begin
    F := F * FfSpawnFactor;
    Extra := Extra + ', right after his respawn';
  end;
  if Tick - FfFlagTick[V] <= 60 then
  begin
    F := F * FfFlagFactor;
    Extra := Extra + ', he carried a flag';
  end;
  if FfLastTkBy[K] = V then
    if Tick - FfLastTkTick[K] <= FfRevengeTicks then
    begin
      F := F * FfRevengeFactor;
      Extra := Extra + ', he had team killed you';
    end;
  Pts := FfKillPts * F;
  FfPair[K][V] := FfPair[K][V] + Pts;
  FfMapKills[K] := FfMapKills[K] + 1;
  FfTotal[K] := FfTotal[K] + 1;
  FfLastTkBy[V] := K;
  FfLastTkTick[V] := Tick;
  Why := FfWhy(Reason);
  Shots := '';
  if (Reason = TR_AIMED) or (Reason = TR_SPRAY) then
    Shots := FfShotsText(K, V, Tick);
  if Shots <> '' then
    Why := Why + ', ' + Shots;
  Why := Why + Extra;
  FfLastWhy[K] := 'killed ' + PL[V].Name + ' (' + Why + ')';
  { the points first, so the texts tell the new sum; the ladder's step comes after the kill's text }
  FfPts[K] := FfPts[K] + Pts;
  FfDirty[K] := True;
  if Pts > 0 then
    FfRise[K] := Tick;
  FfSay(K, FfFill(FfKillText, K, V, Why, 0), FfColor);
  FfBig(K, FfFill(FfKillText, K, V, Why, 0));
  FfLog(PL[K].Name + ' killed team mate ' + PL[V].Name + ': ' + Why + ', intent ' + IntToStr(Intent) + '%, +' +
    FfPtsStr(Pts) + ' = ' + FfPtsStr(FfPts[K]) + ' points');
  { the victim decides }
  if FfVote then
    if PL[V].Human or DebugBots then
    begin
      FfVoteBy[V] := K;
      FfVoteUntil[V] := After(Tick, FfVoteTicks);
      FfVotePts[V] := FfPair[K][V];
      FfVoteName[V] := PL[K].Name;
      Secs := FfVoteTicks div 60;
      T := FfFill(FfVictimText, V, K, FfWhy(Reason) + Extra, Secs);
      if Game.Survival then
        T := T + FfVictimNext;
      FfSay(V, T, FfInfoColor);
    end;
  FfLadder(K, Tick);
end;

{ the library saw S spray at his team mate T: his fire at the team is blocked at once }
procedure FfSpray(S, T, N, Tick: Integer);
begin
  if not FfCounts(S) then
    Exit;
  if (T < 1) or (T > 32) then
    Exit;
  if not PL[T].Active then
    Exit;
  FfStatSprays := FfStatSprays + 1;
  FfShieldOn(S, Tick);
  FfPts[S] := FfPts[S] + FfSprayPts;
  FfDirty[S] := True;
  FfRise[S] := Tick;
  FfSay(S, FfFill(FfSprayText, S, T, '', N), FfColor);
  FfBig(S, FfFill(FfSprayText, S, T, '', N));
  FfSay(T, FfFill(FfSprayVicText, S, T, '', N), FfInfoColor);
  FfLastWhy[S] := 'sprayed at ' + PL[T].Name + ' (' + IntToStr(N) + ' shots)';
  FfLog(PL[S].Name + ' sprayed at team mate ' + PL[T].Name + ' (' + IntToStr(N) + ' shots, no enemy near): fire at the ' +
    'team blocked, +' + FfPtsStr(FfSprayPts) + ' = ' + FfPtsStr(FfPts[S]) + ' points');
  FfLadder(S, Tick);
end;

{ the victim's decision: forgive (the kill's points go), punish (slain now - dead in survival: after his
  next respawn - and PunishPoints), points (PunishPoints), next round (survival: slain after his next
  respawn, PunishPoints) }
procedure FfDecide(V, Choice: Integer);
var
  K, Tick: Integer;
begin
  Tick := Game.TickCount;
  K := FfVoteBy[V];
  if K > 0 then
    if Tick > FfVoteUntil[V] then
      K := 0;
  if K = 0 then
  begin
    Say(V, 'There is no team kill of yours to decide on now.', ColorBad);
    Exit;
  end;
  if (not PL[K].Active) or (PL[K].Name <> FfVoteName[V]) then
  begin
    Say(V, FfVoteName[V] + ' has left the game.', ColorBad);
    FfVoteBy[V] := 0;
    Exit;
  end;
  if Choice = TKV_NEXT then
    if not Game.Survival then
    begin
      Say(V, 'That is for survival mode only: !2 kills him now.', ColorBad);
      Exit;
    end;
  FfVoteBy[V] := 0;
  case Choice of
    TKV_FORGIVE:
      begin
        FfAddPoints(K, -FfVotePts[V], Tick);
        FfPair[K][V] := 0;
        { forgiven: his fire at the team is free again unless his points still say otherwise }
        if (FfShieldAt <= 0) or (FfPts[K] < FfShieldAt) then
          FfShieldUntil[K] := 0;
        FfSay(K, PL[V].Name + ' has forgiven you (' + FfPtsStr(FfPts[K]) + ' team kill points).', FfInfoColor);
        Say(V, 'You forgave ' + PL[K].Name + '.', FfInfoColor);
        FfLog(PL[V].Name + ' forgave ' + PL[K].Name + ' (-' + FfPtsStr(FfVotePts[V]) + ')');
      end;
    TKV_PUNISH:
      begin
        FfStatPunished := FfStatPunished + 1;
        if PL[K].Alive then
        begin
          FfSlay(K);
          FfSay(K, PL[V].Name + ' has chosen to kill you.', FfColor);
        end
        else if Game.Survival then
        begin
          FfNextRound[K] := True;
          FfSay(K, PL[V].Name + ' has chosen to kill you: after your next respawn.', FfColor);
        end
        else
          FfSay(K, PL[V].Name + ' has chosen to punish you.', FfColor);
        Say(V, 'Punished: ' + PL[K].Name + '.', FfInfoColor);
        FfLog(PL[V].Name + ' punished ' + PL[K].Name);
        FfAddPoints(K, FfPunishPts, Tick);
      end;
    TKV_POINTS:
      begin
        FfSay(K, PL[V].Name + ' gave you team kill points.', FfColor);
        Say(V, 'Points given to ' + PL[K].Name + '.', FfInfoColor);
        FfLog(PL[V].Name + ' gave ' + PL[K].Name + ' points');
        FfAddPoints(K, FfPunishPts, Tick);
      end;
    TKV_NEXT:
      begin
        FfStatPunished := FfStatPunished + 1;
        FfNextRound[K] := True;
        FfSay(K, PL[V].Name + ' has chosen to kill you on your next spawn.', FfColor);
        Say(V, PL[K].Name + ' will be slain after his next respawn.', FfInfoColor);
        FfLog(PL[V].Name + ' chose next round for ' + PL[K].Name);
        FfAddPoints(K, FfPunishPts, Tick);
      end;
  end;
end;

{ a step of the ladder in a record: its points, or off }
function FfAtStr(P: Single): string;
begin
  if P > 0 then
    Result := FfPtsStr(P)
  else
    Result := 'off';
end;

{ one line of a player's record }
function FfRecord(ID: Integer): string;
var
  Tick: Integer;
begin
  Tick := Game.TickCount;
  Result := PL[ID].Name + ': ' + FfPtsStr(FfPts[ID]) + ' team kill points (warning ' + FfAtStr(FfWarnAt) +
    ', fire blocked ' + FfAtStr(FfShieldAt) + ', slay ' + FfAtStr(FfSlayAt) + ', kick ' + FfAtStr(FfKickAt) + ', ban ' +
    FfAtStr(FfBanAt) + '); this map ' + IntToStr(FfMapKills[ID]) + ' team kills, ' + IntToStr(Round(FfMapDmg[ID])) +
    '% team damage; team kills ever ' + IntToStr(FfTotal[ID]) + ', bans ' + IntToStr(FfBans[ID]);
  if FfShielded(ID, Tick) then
  begin
    if FfShieldUntil[ID] > Tick then
      Result := Result + '; fire at the team blocked for ' + IntToStr((FfShieldUntil[ID] - Tick) div 60 + 1) + ' s'
    else
      Result := Result + '; fire at the team blocked';
  end;
  if FfBanAt > 0 then
    Result := Result + '; the next ban ' + IntToStr(FfBanMinutes(ID)) + ' min';
  if FfNextRound[ID] then
    Result := Result + '; slain after the next respawn';
end;

{ every tick while [TeamKill] is on: the library's spray events, the mirrored damage; once a second the
  points melt, the blocks end, the decisions run out, a slay after a respawn, the records are written }
procedure FfSecond(Tick: Integer);
var
  i: Integer;
  Melt: Single;
begin
  if Tick mod 300 = 13 then
    FfRefresh();
  Melt := 0;
  if FfDecayMin > 0 then
    Melt := 1 / (FfDecayMin * 60);
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      if Melt > 0 then
        if FfPts[i] > 0 then
          if Tick - FfRise[i] >= FfDecayAfter then
          begin
            FfPts[i] := FfPts[i] - Melt;
            if FfPts[i] < 0 then
              FfPts[i] := 0;
            FfDirty[i] := True;
            FfLadder(i, Tick);
          end;
      if FfShieldNote[i] then
        if not FfShielded(i, Tick) then
        begin
          FfShieldNote[i] := False;
          FfSay(i, 'Your shots can hurt your team again - watch your fire.', FfInfoColor);
        end;
      if FfVoteBy[i] > 0 then
        if Tick > FfVoteUntil[i] then
        begin
          FfVoteBy[i] := 0;
          FfSay(i, 'Your time to decide is over.', FfInfoColor);
        end;
      if FfDirty[i] then
        if Tick mod 1800 = 13 then
          FfSave(i);
    end;
end;

procedure FfTickRun(Tick: Integer);
var
  i, n, Kind, S, T, N2, Reason: Integer;
  D: Single;
begin
  if FfActive then
    if BeOk then
    begin
      n := BE_TkTick();
      while n > 0 do
      begin
        Kind := 0;
        S := 0;
        T := 0;
        N2 := 0;
        Reason := 0;
        if BE_TkNext(Kind, S, T, N2, Reason) <> 1 then
          Break;
        if Kind = TK_EV_SPRAY then
          if FfSprayOn then
            FfSpray(S, T, N2, Tick);
        n := n - 1;
      end;
    end;
  { what he did not do to his team hits him (as an admin's hit: no suicide penalty) }
  if FfMirrorAny then
  begin
    FfMirrorAny := False;
    for i := 1 to TopSlot do
      if FfMirror[i] > 0 then
      begin
        D := FfMirror[i];
        FfMirror[i] := 0;
        if PL[i].Active then
          if PL[i].Alive then
            if D >= 0.5 then
            begin
              AdminHit[i] := Tick;
              PL[i].Damage(i, D);
            end;
      end;
  end;
  for i := 1 to TopSlot do
    if FfSlayDue[i] > 0 then
      if Tick >= FfSlayDue[i] then
      begin
        FfSlayDue[i] := 0;
        if PL[i].Active then
          if PL[i].Alive then
          begin
            FfSlay(i);
            FfSay(i, 'Slain for team killing, as your victim chose.', FfColor);
          end;
      end;
  if Tick mod 60 = 13 then
    if not PausedNow then
      FfSecond(Tick);
end;

{ a map begins: this map's counts start again (and every point with ResetOnMapChange) }
procedure FfMapStart();
var
  i: Integer;
begin
  for i := 1 to 32 do
  begin
    FfMapKills[i] := 0;
    FfMapDmg[i] := 0;
    FfVoteBy[i] := 0;
    if FfResetMap then
      if FfPts[i] > 0 then
      begin
        FfPts[i] := 0;
        FfStep[i] := 0;
        FfShieldUntil[i] := 0;
        FfDirty[i] := True;
      end;
    if ActiveSlot[i] then
      if FfDirty[i] then
        FfSave(i);
  end;
  if FfResetMap then
    if FfEnabled then
      SayAll('All team kill points reset.', FfInfoColor);
  FfRefresh();
end;

procedure DmgAdd(S, V: Integer; Amount: Single; X, Y: Single);
begin
  if DnPend[S][V] then
  begin
    DnTickSum[S][V] := DnTickSum[S][V] + Amount;
    DnX[S][V] := X;
    DnY[S][V] := Y;
    Exit;
  end;
  if DnPendCount >= DN_PEND_SIZE then
    Exit;
  DnPend[S][V] := True;
  DnTickSum[S][V] := Amount;
  DnX[S][V] := X;
  DnY[S][V] := Y;
  DnPendS[DnPendCount] := S;
  DnPendV[DnPendCount] := V;
  DnPendCount := DnPendCount + 1;
end;

{ What the last hit on V really took (Taken): kill info counts it, and with Amount = taken it is the
  damage number. }
procedure DmgSettle(V: Integer; Taken: Single);
var
  S: Integer;
  Amount: Single;
begin
  if Taken <= 0.01 then
    Exit;
  S := VicLastS[V];
  { [TeamKill]: a hit on a team mate - the damage it really took }
  if FfLastFriendly[V] then
  begin
    FfLastFriendly[V] := False;
    if FfActive then
      FfTeamDamage(S, V, Taken, FfLastIntent[V], FfLastReason[V]);
  end;
  { [Shop] DamageMoney: added up here, paid by the shop's tick - at most DamageLimit of the victim's life }
  if ShActive then
    if (S >= 1) and (S <= 32) and (S <> V) then
      if (not TeamGame()) or (TeamOf[S] <> TeamOf[V]) then
      begin
        Amount := Taken;
        if ShDmgLimit > 0 then
        begin
          if Amount > ShDmgPool[V] then
            Amount := ShDmgPool[V];
          ShDmgPool[V] := ShDmgPool[V] - Amount;
        end;
        if not HumanOf[V] then
          Amount := Amount * ShBotKill;
        if Amount > 0 then
          ShDamageAcc[S] := ShDamageAcc[S] + Amount;
      end;
  { [Points]: the damage of the hits (paid by the points' tick) - an enemy's at most DamageLimit of his life }
  if BpActive then
    if (S >= 1) and (S <= 32) and (S <> V) then
    begin
      if (not TeamGame()) or (TeamOf[S] <> TeamOf[V]) then
      begin
        Amount := Taken;
        if BpDmgLimit > 0 then
        begin
          if Amount > BpDmgPool[V] then
            Amount := BpDmgPool[V];
          BpDmgPool[V] := BpDmgPool[V] - Amount;
        end;
        if Amount > 0 then
          BpDmgPend[S] := BpDmgPend[S] + Amount;
      end
      else
        BpTeamPend[S] := BpTeamPend[S] + Taken;
      BpPendAny := True;
    end;
  if VicLastCount[V] then
    if S <> V then
    begin
      Dealt[S][V] := Dealt[S][V] + Taken;
      if HfEnabled then
        if PL[V].Human or DebugBots then
        begin
          { the percent of ReferenceHealth: a hit flashes as long in the normal mode as in the realistic one }
          if HfRefHP > 0 then
            HfPend[V] := HfPend[V] + Taken * 100 / HfRefHP
          else
            HfPend[V] := HfPend[V] + Taken * 100 / MaxHealth;
        end;
    end;
  if VicLastShow[V] then
  begin
    Amount := Taken;
    if DmgPercent then
      Amount := Amount * 100 / MaxHealth;
    DmgAdd(S, V, Amount, VicLastX[V], VicLastY[V]);
  end;
end;

{ [DamageNumbers] LineOfSight: auto = in realistic mode only (the other modes show every player) }
function SightActive(): Boolean;
begin
  Result := False;
  if DmgSight = SIGHT_ON then
    Result := True
  else if DmgSight = SIGHT_AUTO then
    Result := Realistic;
end;

function Ray(X1, Y1, X2, Y2: Single; Bullet: Boolean): Boolean;
var
  n: Integer;
begin
  if MapOk then
  begin
    if Bullet then
      n := BE_MapRay(X1, Y1, X2, Y2, MR_BULLET, 0)
    else
      n := BE_MapRay(X1, Y1, X2, Y2, 0, 0);
    if n >= 0 then
    begin
      Result := n = 1;
      Exit;
    end;
  end;
  Result := Map.RayCast(X1, Y1, X2, Y2, False, False, Bullet, False, 0);
end;

{ point K of player ID's skeleton as the server has it ([Radar] SkeletonSight: 7 the upper body, 9 the
  neck), else Up pixels over his feet }
procedure SkPoint(ID, K: Integer; Up: Single; var X, Y: Single);
var
  PX, PY: Single;
begin
  X := PL[ID].X;
  Y := PL[ID].Y - Up;
  if OvlSkeleton then
    if BeOk then
      if BE_SpritePoint(ID, PL[ID], X, PL[ID].Y, K, PX, PY) = 1 then
      begin
        X := PX;
        Y := PY;
      end;
end;

procedure MovePlayer(P: TActivePlayer; X, Y: Single);
begin
  P.Move(X, Y);
  { not a teleport for [AntiCheat], not a warp for [LagGuard] }
  if BeOk then
    BE_AcMoved(P.ID, Game.TickCount);
end;

{ Could Viewer see Target now? The fog of war of realistic mode: team mates always, everybody for a
  dead player, the others only in front of the aim, up to LOS_RANGE away and with no wall between
  the upper bodies (the viewer's 2 px higher; the server's skeletons with [Radar] SkeletonSight). A
  damage number over a player the shooter cannot see would show where he is. }
function CanSee(Viewer, Target: Integer): Boolean;
var
  P: TActivePlayer;
  VX, VY, TX, TY, AX, AY, DX, DY: Single;
begin
  Result := True;
  if Viewer = Target then
    Exit;
  P := PL[Viewer];
  if not P.Alive then
    Exit;
  if TeamGame() then
    if TeamOf[Viewer] = TeamOf[Target] then
      Exit;
  SkPoint(Viewer, 7, LOS_HEIGHT, VX, VY);
  VY := VY - 2;
  SkPoint(Target, 7, LOS_HEIGHT, TX, TY);
  if MapOk then
  begin
    Result := BE_Sees(VX, VY, P.MouseAimX, P.MouseAimY, TX, TY, LOS_RANGE, 0) = 1;
    Exit;
  end;
  DX := TX - VX;
  DY := TY - VY;
  AX := P.MouseAimX - VX;
  AY := P.MouseAimY - VY;
  Result := False;
  if DX * AX + DY * AY <= 0 then
    Exit;
  if DX * DX + DY * DY > LOS_RANGE * LOS_RANGE then
    Exit;
  Result := not Ray(VX, VY, TX, TY, False);
end;

procedure DmgPlace(S, V: Integer; Widest: string; var X, Y: Single);
begin
  if BeOk then
    X := DnX[S][V] - BE_TextWidth(Widest, DmgScale) / 2 + DmgOffsetX
  else
    X := DnX[S][V] - Length(Widest) * DmgScale * WT_CHAR_WIDTH / 2 + DmgOffsetX;
  Y := DnY[S][V] - DmgOffsetY;
  if DmgMode = DM_COLUMN then
    Y := Y - (DnLines[S][V] - 1) * DmgScale * WT_LINE_HEIGHT;
end;

procedure DmgFlush(Tick: Integer);
var
  k, n, Cut, S, V, Layer, FlashTicks: Integer;
  P: TActivePlayer;
  T, Line, Col, Widest: string;
  C: Longint;
  X, Y, H: Single;
  Fresh, Sight: Boolean;
  LS, LV: array[0..255] of Integer;
begin
  { first the last hit on every player hit since the last flush: it took what is gone now }
  n := VicCount;
  VicCount := 0;
  for k := 0 to n - 1 do
  begin
    V := VicList[k];
    VicPend[V] := False;
    { a player who left in the meantime lost nothing to the hit }
    if PL[V].Active then
    begin
      H := 0;
      if PL[V].Alive then
        H := PL[V].Health;
      if H < 0 then
        H := 0;
      DmgSettle(V, VicLastBefore[V] - H);
      { [HitFlash]: the longer, the more health it took (it fades out by itself) }
      if HfPend[V] > 0 then
      begin
        FlashTicks := Round(HfPend[V] * HfTicksPerPct);
        if FlashTicks < HfMinTicks then
          FlashTicks := HfMinTicks;
        if FlashTicks > HfMaxTicks then
          FlashTicks := HfMaxTicks;
        PL[V].BigText(HfLayer, HfChar, FlashTicks, HfColor, HfScale, HfX, HfY);
        HfPend[V] := 0;
      end;
    end;
  end;
  if DnPendCount = 0 then
    Exit;
  Sight := SightActive();
  { the list is taken over before anything is sent: an error while sending cannot leave it stuck }
  n := DnPendCount;
  for k := 0 to n - 1 do
  begin
    LS[k] := DnPendS[k];
    LV[k] := DnPendV[k];
    DnPend[LS[k]][LV[k]] := False;
  end;
  DnPendCount := 0;
  for k := 0 to n - 1 do
  begin
    S := LS[k];
    V := LV[k];
    P := PL[S];
    if not P.Active then
      Continue;
    { too many texts for this player in this tick: the number waits for the next tick }
    if not TextRoom(S, Tick) then
    begin
      DnPend[S][V] := True;
      DnPendS[DnPendCount] := S;
      DnPendV[DnPendCount] := V;
      DnPendCount := DnPendCount + 1;
      Continue;
    end;
    { a player the shooter cannot see gets no number (nor a kill mark) }
    if Sight then
      if S <> V then
        if not CanSee(S, V) then
        begin
          DnKillPend[S][V] := False;
          StatHid := StatHid + 1;
          Continue;
        end;
    Fresh := Tick - DnLast[S][V] > DmgStackTicks;
    if DnLayer[S][V] = 0 then
      Fresh := True;
    if DmgMode = DM_HIT then
      Fresh := True;
    if Fresh then
    begin
      Layer := DnNext[S];
      if (Layer < DmgLayerFirst) or (Layer > DmgLayerLast) then
        Layer := DmgLayerFirst;
      DnNext[S] := Layer + 1;
      DnLayer[S][V] := Layer;
      DnSum[S][V] := 0;
      DnLines[S][V] := 0;
      DnText[S][V] := '';
      DnKill[S][V] := False;
    end;
    { the killing hit is still waiting here when OnKill comes }
    if DnKillPend[S][V] then
    begin
      DnKill[S][V] := True;
      DnKillPend[S][V] := False;
    end;
    DnLast[S][V] := Tick;
    DnSum[S][V] := DnSum[S][V] + DnTickSum[S][V];
    Line := DmgNumber(DnTickSum[S][V]);
    if DmgMode = DM_COLUMN then
    begin
      Col := DnText[S][V];
      if DnLines[S][V] = 0 then
        Col := Line
      else
        Col := Col + #13#10 + Line;
      DnLines[S][V] := DnLines[S][V] + 1;
      if DnLines[S][V] > DN_MAX_LINES then
      begin
        Cut := Pos(#10, Col);
        if Cut > 0 then
          Delete(Col, 1, Cut);
        DnLines[S][V] := DnLines[S][V] - 1;
      end;
      DnText[S][V] := Col;
      T := Col;
      Widest := Line;
    end
    else
    begin
      if DmgMode = DM_SUM then
        T := DmgNumber(DnSum[S][V])
      else
        T := Line;
      Widest := T;
    end;
    if S = V then
      C := DmgColorSelf
    else if TeamOf[V] = TeamOf[S] then
    begin
      if TeamGame() then
        C := DmgColorFriend
      else
        C := DmgColorEnemy;
    end
    else
      C := DmgColorEnemy;
    if DnKill[S][V] then
    begin
      T := T + ' ' + DmgKillMark;
      Widest := Widest + ' ' + DmgKillMark;
      C := DmgColorKill;
    end;
    DmgPlace(S, V, Widest, X, Y);
    P.WorldText(DnLayer[S][V], T, WtTicks(DmgDisplayTicks), C, DmgScale, X, Y);
    WtSharp(S, DnLayer[S][V], Tick, DmgDisplayTicks);
    TextSent(S);
    StatDmg := StatDmg + 1;
  end;
end;

function LastLine(T: string): string;
var
  k: Integer;
begin
  Result := T;
  k := Pos(#10, Result);
  while k > 0 do
  begin
    Delete(Result, 1, k);
    k := Pos(#10, Result);
  end;
end;

{ the kill turns the victim's number of this shooter red, with the kill mark }
procedure DmgKill(S, V, Tick: Integer);
var
  T, Widest: string;
  X, Y: Single;
  Waiting: Boolean;
begin
  { usually the killing hit is not settled yet: the flush of this tick adds the mark }
  Waiting := DnPend[S][V];
  if VicPend[V] then
    if VicLastS[V] = S then
      Waiting := True;
  if Waiting then
  begin
    DnKillPend[S][V] := True;
    Exit;
  end;
  if DnLayer[S][V] = 0 then
    Exit;
  if Tick - DnLast[S][V] > DmgStackTicks then
    Exit;
  if not TextRoom(S, Tick) then
    Exit;
  if SightActive() then
    if not CanSee(S, V) then
    begin
      StatHid := StatHid + 1;
      Exit;
    end;
  DnKill[S][V] := True;
  if DmgMode = DM_COLUMN then
  begin
    T := DnText[S][V];
    Widest := LastLine(T);
  end
  else
  begin
    T := DmgNumber(DnSum[S][V]);
    Widest := T;
  end;
  Widest := Widest + ' ' + DmgKillMark;
  DmgPlace(S, V, Widest, X, Y);
  PL[S].WorldText(DnLayer[S][V], T + ' ' + DmgKillMark, WtTicks(DmgDisplayTicks), DmgColorKill, DmgScale, X, Y);
  WtSharp(S, DnLayer[S][V], Tick, DmgDisplayTicks);
  TextSent(S);
  StatDmg := StatDmg + 1;
end;

{ ================================ radar ================================ }

procedure OverlayAllow(ID: Integer);
begin
  OvlAllowed[ID] := False;
  if SteamId[ID] <> '' then
    OvlAllowed[ID] := OvlSteams.IndexOf(SteamId[ID]) >= 0;
  if OvlAdminsFull then
    if PL[ID].IsAdmin then
      OvlAllowed[ID] := True;
  if DebugBots then
    if not PL[ID].Human then
      OvlAllowed[ID] := True;
end;

{ SkillSpots = radar: his team's UAV or sensor works now - he has the public radar for that time }
function SkRadarOn(ID: Integer): Boolean;
var
  Tm: Integer;
begin
  Result := False;
  if ClsSpotsMode <> 1 then
    Exit;
  Tm := TeamOf[ID];
  if (Tm >= 1) and (Tm <= 4) then
    Result := ClsRadarUntil[Tm] > Game.TickCount;
end;

function RadarModes(ID: Integer): Integer;
begin
  Result := 0;
  if OvlAllowed[ID] then
    Result := OvlFullModes
  else if OvlPublic then
    Result := OvlPublicModes
  else if SkRadarOn(ID) then
    Result := OvlPublicModes;
end;

function RadarMay(ID: Integer): Boolean;
begin
  Result := RadarModes(ID) <> 0;
end;

function RadarModeOk(ID, M: Integer): Boolean;
begin
  Result := False;
  if (M >= 0) and (M <= 3) then
    Result := (RadarModes(ID) and (1 shl M)) <> 0;
end;

function RadarDefMode(ID: Integer): Integer;
var
  M, Mask: Integer;
begin
  if OvlAllowed[ID] then
    Result := OvlMode
  else
    Result := OvlPublicMode;
  Mask := RadarModes(ID);
  if (Mask and (1 shl Result)) = 0 then
    for M := 3 downto 0 do
      if (Mask and (1 shl M)) <> 0 then
        Result := M;
end;

function RadarMode(ID: Integer): Integer;
begin
  Result := RadarDefMode(ID);
  if RdPMode[ID] >= 1 then
    if RadarModeOk(ID, RdPMode[ID] - 1) then
      Result := RdPMode[ID] - 1;
  { a spectator has the list (no soldier for the circle, the labels or the ring) }
  if Result <> OVL_LIST then
    if TeamOf[ID] = TEAM_SPECTATOR then
      Result := OVL_LIST;
end;

function RadarMinTicks(ID: Integer): Integer;
begin
  if OvlAllowed[ID] then
    Result := OvlFullMinTicks
  else
    Result := OvlPublicMinTicks;
end;

function RadarTicks(ID: Integer): Integer;
var
  M: Integer;
begin
  M := RadarMode(ID);
  if M = OVL_LIST then
    Result := OvlListTicks
  else if M = OVL_CIRCLE then
    Result := OvlCircleTicks
  else if M = OVL_ARROWS then
    Result := OvlArrowTicks
  else
    Result := OvlUpdateTicks;
  if RdMTicks[ID][M] > 0 then
    Result := RdMTicks[ID][M];
  if Result < RadarMinTicks(ID) then
    Result := RadarMinTicks(ID);
  if Result < 1 then
    Result := 1;
end;

function RadarOutlineOf(ID: Integer): Boolean;
begin
  Result := OvlOutlineOn;
  if RdPOutline[ID] = PREF_ON then
    Result := True
  else if RdPOutline[ID] = PREF_OFF then
    Result := False;
  if not OvlOutline then
    Result := False;
end;

function RadarEditing(ID: Integer): Boolean;
begin
  Result := EdOn[ID] and (EdKind[ID] = ED_RADAR);
end;

{ the size factor of the list and the circle (1 = the settings) }
function RadarSize(ID: Integer): Single;
var
  M: Integer;
begin
  if RadarEditing(ID) then
    Result := EdScale[ID]
  else
  begin
    M := RadarMode(ID);
    Result := RdMSize[ID][M];
    if Result <= 0 then
      Result := 1;
  end;
end;

{ the zoom: more range, smaller marks (1 = the settings); a public user's radar reaches at most PublicMaxZoom x the
  range (a bigger list or circle takes its share of it) }
function RadarZoom(ID: Integer): Single;
var
  M: Integer;
  Cap, Sz: Single;
begin
  M := RadarMode(ID);
  Result := RdMZoom[ID][M];
  if Result <= 0 then
    Result := 1;
  if not OvlAllowed[ID] then
  begin
    Cap := OvlPublicMaxZoom;
    if (M = OVL_LIST) or (M = OVL_CIRCLE) then
    begin
      Sz := RadarSize(ID);
      if Sz > 1 then
        Cap := Cap / (1 + (Sz - 1) * OvlSizeRange);
    end;
    if Result > Cap then
      Result := Cap;
  end;
end;

function RadarMarksOf(ID: Integer): Single;
begin
  Result := RdPMarks[ID];
  if Result <= 0 then
    Result := 1;
end;

function RadarEdgeOf(ID: Integer): Single;
begin
  Result := RdPEdge[ID];
  if Result <= 0 then
    Result := OvlEdgeScale;
end;

{ how far the radar reaches: Range, a little more for a bigger radar ([Radar] SizeAffectsRange),
  times the zoom }
function RadarRange(ID: Integer): Single;
var
  M: Integer;
  R: Single;
begin
  M := RadarMode(ID);
  if M = OVL_LIST then
    R := OvlRangeList
  else if M = OVL_LABELS then
    R := OvlRangeLabels
  else if M = OVL_CIRCLE then
    R := OvlRangeCircle
  else
    R := OvlRangeRing;
  if R <= 0 then
    R := OvlRange;
  if (M = OVL_LIST) or (M = OVL_CIRCLE) then
    Result := R * (1 + (RadarSize(ID) - 1) * OvlSizeRange) * RadarZoom(ID)
  else
    Result := R * RadarZoom(ID);
  if Result < 50 then
    Result := 50;
end;

{ where the mode is drawn by default: the top-left corner of the list or of the circle }
procedure RadarDefPos(Mode: Integer; var X, Y: Integer);
begin
  if Mode = OVL_CIRCLE then
  begin
    X := OvlCircleX;
    Y := OvlCircleY;
  end
  else
  begin
    X := OvlListX;
    Y := OvlListY;
  end;
end;

procedure RadarPos(ID, Mode: Integer; var X, Y: Integer);
begin
  if RadarEditing(ID) then
  begin
    X := Round(EdX[ID]);
    Y := Round(EdY[ID]);
    Exit;
  end;
  RadarDefPos(Mode, X, Y);
  if (Mode >= 0) and (Mode <= 3) then
  begin
    if RdMX[ID][Mode] >= 0 then
      X := RdMX[ID][Mode];
    if RdMY[ID][Mode] >= 0 then
      Y := RdMY[ID][Mode];
  end;
end;

{ on or off: the player's own choice, else the default of his kind of user }
procedure RadarApplyOn(ID: Integer);
begin
  if RdPOn[ID] = PREF_ON then
    OvlOn[ID] := True
  else if RdPOn[ID] = PREF_OFF then
    OvlOn[ID] := False
  else if OvlAllowed[ID] then
    OvlOn[ID] := OvlDefaultOn
  else
    OvlOn[ID] := OvlPublicOn;
end;

function RadarTeamOf(ID: Integer): Boolean;
begin
  Result := OvlShowTeam;
  if RdPTeam[ID] = PREF_ON then
    Result := True
  else if RdPTeam[ID] = PREF_OFF then
    Result := False;
end;

{ which players the radar shows: all, those seen by the user or a team mate (seenall: dead team
  mates count), or those seen by the user or a living team mate (seen). A player of a public radar
  is not given less than PublicShow allows. }
{ a public user's choice M within PublicShow P: P itself, or the same sight rule without the dead team mates'
  views; any when P is all }
function ShowWithin(M, P: Integer): Boolean;
begin
  Result := M = P;
  if P = SHOW_ALL then
    Result := True
  else if P = SHOW_SEENALL then
    Result := (M = SHOW_SEENALL) or (M = SHOW_SEEN)
  else if P = SHOW_SEENALL_REAL then
    Result := (M = SHOW_SEENALL_REAL) or (M = SHOW_SEEN_REAL);
end;

function RadarShowOf(ID: Integer): Integer;
var
  Def: Integer;
begin
  if OvlAllowed[ID] then
    Def := OvlShow
  else
    Def := OvlPublicShow;
  Result := Def;
  if RdPShow[ID] >= 1 then
    Result := RdPShow[ID] - 1;
  if not OvlAllowed[ID] then
    if not ShowWithin(Result, OvlPublicShow) then
      Result := OvlPublicShow;
  { the radar a UAV gives shows what the team sees and has spotted, never everybody }
  if not OvlAllowed[ID] then
    if not OvlPublic then
      if Result = SHOW_ALL then
        Result := SHOW_SEEN;
end;

procedure FlagSnap();
var
  F: TActiveFlag;
  k, St, Gs: Integer;
begin
  Gs := Game.GameStyle;
  for k := 0 to 2 do
  begin
    St := 0;
    F := nil;
    if OvlFlags then
      if k < 2 then
      begin
        if (Gs = 3) or (Gs = 5) then
        begin
          if k = 0 then
            F := Map.RedFlag
          else
            F := Map.BlueFlag;
        end;
      end
      else if (Gs = 1) or (Gs = 6) then
        F := Map.YellowFlag;
    if F <> nil then
      if F.Active then
      begin
        St := 2;
        if F.InBase then
          St := 1;
        BE_SnapFlag(k, k + 1, St, F.X, F.Y);
      end;
    if St = 0 then
      BE_SnapFlag(k, k + 1, 0, 0, 0);
  end;
end;

procedure WorldSnap(Tick, Level: Integer; Extra: Boolean);
var
  b, W, Tg, Pg: Integer;
  Q: TActivePlayer;
  Aims, Vels, All, Alive, Fresh: Boolean;
begin
  if SnapTick = Tick then
    if SnapLevel >= Level then
      if (SnapExtraTick = Tick) or (not Extra) then
        Exit;
  SnapTick := Tick;
  SnapLevel := Level;
  if Extra then
    SnapExtraTick := Tick;
  Aims := Level >= SNAP_AIM;
  Vels := Level >= SNAP_FULL;
  Fresh := SnapNew > 0;
  SnapNew := 0;
  BE_SnapBegin(Tick);
  for b := 1 to TopSlot do
    if ActiveSlot[b] then
    begin
      Q := PL[b];
      All := False;
      if Fresh then
        if SnapIdx[b] < 0 then
        begin
          SnapIdx[b] := 0;
          All := True;
        end;
      Alive := Q.Alive;
      if Alive then
        BE_SnapPos(b, 1, Q.X, Q.Y)
      else
        BE_SnapPos(b, 0, Q.X, Q.Y);
      if All or Aims then
        BE_SnapAim(b, Q.MouseAimX, Q.MouseAimY);
      if Alive then
        if All or Vels or RdRing[b] then
          BE_SnapVel(b, Q.VelX, Q.VelY);
      if All or Extra then
      begin
        W := 0;
        Tg := TAG_NONE;
        Pg := 0;
        if Alive then
        begin
          W := HealthPct(Q.Health);
          if OvlTags then
          begin
            if Q.Flagger then
              Tg := TAG_FLAG
            else
            begin
              Tg := Q.Primary.WType;
              if (Tg = WEP_BOW) or (Tg = WEP_BOW_FIRE) then
                Tg := TAG_BOW
              else
                Tg := TAG_NONE;
            end;
          end;
        end;
        if OvlAdmin[b] then
          Pg := Q.Ping;
        BE_SnapExtra(b, W, Tg, Pg);
      end;
    end;
  if OvlFlags then
    if Extra or (Tick - FlagSnapTick >= 6) or (Tick < FlagSnapTick) then
    begin
      FlagSnapTick := Tick;
      FlagSnap();
    end;
  BE_SnapEnd(Tick);
end;

procedure OpsSend(A, n: Integer);
var
  k, Kind, Layer, Delay, Color: Integer;
  Sc, X, Y: Single;
  T: string;
  P: TActivePlayer;
begin
  if n <= 0 then
    Exit;
  P := PL[A];
  if not P.Active then
    Exit;
  for k := 0 to n - 1 do
  begin
    T := BE_Op(k, Kind, Layer, Delay, Color, Sc, X, Y);
    if Kind = OP_BIG then
      P.BigText(Layer, T, Delay, Color, Sc, Round(X), Round(Y))
    else if Kind = OP_WORLD then
      P.WorldText(Layer, T, Delay, Color, Sc, X, Y);
  end;
end;

procedure OpsCache(n: Integer);
var
  k: Integer;
begin
  if n > 256 then
    n := 256;
  for k := 0 to n - 1 do
    OpT[k] := BE_Op(k, OpKind[k], OpLayer[k], OpDelay[k], OpColor[k], OpSc[k], OpX[k], OpY[k]);
end;

procedure OpsCachedTo(A, n: Integer);
var
  k: Integer;
  P: TActivePlayer;
begin
  if not ActiveSlot[A] then
    Exit;
  P := PL[A];
  if n > 256 then
    n := 256;
  for k := 0 to n - 1 do
    if OpKind[k] = OP_BIG then
      P.BigText(OpLayer[k], OpT[k], OpDelay[k], OpColor[k], OpSc[k], Round(OpX[k]), Round(OpY[k]))
    else if OpKind[k] = OP_WORLD then
      P.WorldText(OpLayer[k], OpT[k], OpDelay[k], OpColor[k], OpSc[k], OpX[k], OpY[k]);
end;

{ the update period of a trajectory: three times longer when every player sees it }
function TrEvery(i, Ticks: Integer): Integer;
begin
  Result := Ticks;
  if TrAud[i] = TA_PUBLIC then
    Result := Ticks * 3;
end;

procedure TrSend(i, T, m: Integer);
var
  k: Integer;
begin
  if m <= 0 then
    Exit;
  if TrAud[i] = TA_ME then
  begin
    OpsSend(i, m);
    Exit;
  end;
  if TrAud[i] = TA_SELF then
  begin
    if T >= 1 then
      OpsSend(T, m);
    Exit;
  end;
  OpsCache(m);
  if TrAud[i] = TA_SELFME then
  begin
    OpsCachedTo(i, m);
    if (T >= 1) and (T <> i) then
      OpsCachedTo(T, m);
    Exit;
  end;
  for k := 1 to TopSlot do
    if ActiveSlot[k] then
      if HumanOf[k] or DebugBots then
        OpsCachedTo(k, m);
end;

function TrAudName(A: Integer): string;
begin
  if A = TA_SELF then
    Result := 'only that player sees it'
  else if A = TA_SELFME then
    Result := 'you and that player see it'
  else if A = TA_PUBLIC then
    Result := 'everybody sees it'
  else
    Result := 'only you see it';
end;

procedure RadarUserSync(A: Integer);
var
  M, X, Y, IsOn, Ed: Integer;
  Mk: Single;
begin
  M := RadarMode(A);
  if M <> OVL_LIST then
    if TeamOf[A] = TEAM_SPECTATOR then
      M := OVL_LIST;
  RadarPos(A, M, X, Y);
  IsOn := 0;
  if OvlAdmin[A] then
    IsOn := 1;
  Ed := 0;
  Mk := RadarSize(A);
  if RadarEditing(A) then
  begin
    Ed := 1;
    if RdMark[A] > 0 then
      Mk := RdMark[A];
  end;
  BE_RadarUser(A, IsOn, M, RadarShowOf(A), X, Y, RadarSize(A), RadarZoom(A), Mk, Ed);
  RdRing[A] := OvlAdmin[A] and (M = OVL_ARROWS);
  BE_RadarOpt(A, RO_FRIENDS, BoolInt(RadarTeamOf(A)));
  BE_RadarOpt(A, RO_OUTLINE, BoolInt(RadarOutlineOf(A)));
  BE_RadarOpt(A, RO_MARKS, Round(RadarMarksOf(A) * 1000));
  BE_RadarOpt(A, RO_EDGE, Round(RadarEdgeOf(A) * 1000));
  RdEvery[A] := RadarTicks(A);
  RdNeed[A] := 4;
end;

procedure OverlayHide(ID: Integer);
var
  n: Integer;
begin
  if not BeOk then
    Exit;
  n := BE_RadarHide(ID, 255);
  OpsSend(ID, n);
  StatOvl := StatOvl + n;
end;

procedure OverlayRecount();
var
  i: Integer;
  Was: Boolean;
begin
  OvlCount := 0;
  OvlNextTick := 0;
  VisNeeded := False;
  for i := 1 to 32 do
  begin
    Was := OvlAdmin[i];
    OvlAdmin[i] := False;
    if OvlEnabled then
      if BeOk then
        if OvlOn[i] then
          if RadarMay(i) then
            if ActiveSlot[i] then
              if PL[i].Human or DebugBots then
                OvlAdmin[i] := True;
    if OvlAdmin[i] then
    begin
      OvlUsers[OvlCount] := i;
      OvlCount := OvlCount + 1;
      if RadarShowOf(i) <> SHOW_ALL then
        VisNeeded := True;
      if not Was then
      begin
        RadarDirty(i);
        RdTokens[i] := OvlBurst;
        RdTokTick[i] := Game.TickCount;
        RdRetry[i] := 0;
      end;
    end;
    { a user who stays is synced by his redraw (RadarDirty) }
    if BeOk then
      if Was <> OvlAdmin[i] then
      begin
        if Was then
          if ActiveSlot[i] then
            OverlayHide(i);
        RadarUserSync(i);
      end;
  end;
end;

procedure OverlayTick(Tick: Integer);
var
  k, j, i, n, Budget, T, Next, Spent: Integer;
  Fresh, Extra: Boolean;
begin
  if Tick < OvlNextTick then
    Exit;
  Next := Tick + 600;
  Extra := Tick - SnapExtraTick >= OVL_EXTRA_TICKS;
  Spent := 0;
  if OvlCount > 0 then
    OvlStart := (OvlStart + 1) mod OvlCount;
  for j := 0 to OvlCount - 1 do
  begin
    k := (OvlStart + j) mod OvlCount;
    i := OvlUsers[k];
    { the texts of this tick are spent: the others go on in the next one }
    if Spent >= OvlTextsAll then
    begin
      Next := Tick + 1;
      Break;
    end;
    Fresh := (Tick >= RdDue[i]) or RdRedraw[i];
    if Fresh or (Tick >= RdRetry[i]) then
    begin
      if Fresh then
      begin
        if Extra or (Tick - SnapTick > OVL_SNAP_AGE) or (SnapTick > Tick) then
        begin
          { the vision needs the aim too: one snapshot for both }
          if VisNeeded then
            WorldSnap(Tick, SNAP_AIM, Extra)
          else
            WorldSnap(Tick, SNAP_POS, Extra);
        end;
        Extra := False;
        if RdRedraw[i] then
        begin
          RdRedraw[i] := False;
          RadarUserSync(i);
        end;
        T := RdEvery[i];
        if T < 1 then
          T := 1;
        RdDue[i] := After(Tick - (Tick + i) mod T, T);
      end;
      RdTokens[i] := RdTokens[i] + (Tick - RdTokTick[i]) * OvlRateTick;
      RdTokTick[i] := Tick;
      if RdTokens[i] > OvlBurst then
        RdTokens[i] := OvlBurst;
      Budget := Trunc(RdTokens[i]);
      if Budget > OvlTextsPerTick then
        Budget := OvlTextsPerTick;
      if Budget > OvlTextsAll - Spent then
        Budget := OvlTextsAll - Spent;
      if Budget < 1 then
        Budget := 1;
      n := BE_RadarPass(i, Tick, Budget);
      RdRetry[i] := RdDue[i];
      if n >= 65536 then
      begin
        n := n - 65536;
        T := 1;
        if RdTokens[i] - n < RdNeed[i] then
          T := Trunc((RdNeed[i] - RdTokens[i] + n) / OvlRateTick) + 1;
        if Tick + T < RdRetry[i] then
          RdRetry[i] := Tick + T;
      end;
      OpsSend(i, n);
      RdTokens[i] := RdTokens[i] - n;
      StatOvl := StatOvl + n;
      Spent := Spent + n;
    end;
    if RdRetry[i] < Next then
      Next := RdRetry[i];
  end;
  OvlNextTick := Next;
end;

procedure VisionTick(Tick: Integer);
var
  S, B, n: Integer;
  X1, Y1, X2, Y2: Single;
begin
  if (Tick - SnapTick >= 3) or (SnapLevel < SNAP_AIM) then
    WorldSnap(Tick, SNAP_AIM, False);
  if MapOk then
  begin
    n := BE_VisRun(Tick);
    if n >= 0 then
    begin
      StatRays := StatRays + n;
      Exit;
    end;
  end;
  n := 0;
  while BE_VisNext(Tick, S, B, X1, Y1, X2, Y2) = 1 do
  begin
    if Map.RayCast(X1, Y1, X2, Y2, False, False, False, False, 0) then
      BE_Vis(S, B, 0)
    else
      BE_Vis(S, B, 1);
    n := n + 1;
  end;
  StatRays := StatRays + n;
end;

function FxName(K: Integer): string;
begin
  case K of
    FX_PLAIN: Result := 'plain';
    FX_BIG: Result := 'big';
    FX_NUKE: Result := 'nuke';
    FX_LAW: Result := 'law';
    FX_M79: Result := 'm79';
    FX_ARROWS: Result := 'arrows';
    FX_FIREARROWS: Result := 'firearrows';
    FX_BULLETS: Result := 'bullets';
    FX_SPAS: Result := 'spas';
    FX_FLAME: Result := 'flame';
    FX_CLUSTER: Result := 'cluster';
    FX_NADES: Result := 'nades';
    FX_KNIVES: Result := 'knives';
    FX_RAIN: Result := 'rain';
  else
    Result := '';
  end;
end;

function FxKindOf(S: string): Integer;
var
  k: Integer;
begin
  S := LowerCase(Trim(S));
  Result := -1;
  if (S = '') or (S = 'normal') then
    S := 'plain'
  else if (S = 'boom') or (S = 'bigexplode') then
    S := 'big'
  else if (S = 'rocket') or (S = 'rockets') then
    S := 'law'
  else if (S = 'arrow') or (S = 'bow') then
    S := 'arrows'
  else if (S = 'firearrow') or (S = 'flamedarrows') then
    S := 'firearrows'
  else if (S = 'bullet') or (S = 'guns') then
    S := 'bullets'
  else if (S = 'shotgun') or (S = 'shells') then
    S := 'spas'
  else if (S = 'fire') or (S = 'flamer') then
    S := 'flame'
  else if (S = 'grenades') or (S = 'frags') then
    S := 'nades'
  else if S = 'knife' then
    S := 'knives';
  for k := 0 to FX_LAST do
    if FxName(k) = S then
    begin
      Result := k;
      Exit;
    end;
end;

function BulletsFree(Want: Integer): Integer;
var
  b: Integer;
begin
  Result := 0;
  for b := MAX_BULLET_ID downto 1 do
    if not BL[b].Active then
    begin
      Result := Result + 1;
      if Result >= Want then
        Exit;
    end;
end;

function BulletRoom(Need: Integer): Boolean;
begin
  Result := BulletsFree(Need + BULLET_MARGIN) >= Need + BULLET_MARGIN;
end;

procedure FxAdd(T, Kind: Integer);
var
  n, k, Tick, Style, Delay: Integer;
  DX, DY, VX, VY, HitM: Single;
begin
  Tick := Game.TickCount;
  n := BE_Fx(Kind, Tick * 31 + T * 977 + Random(0, 100000), FxPower);
  for k := 0 to n - 1 do
  begin
    if FxQCount >= FX_QUEUE then
    begin
      FxDropped := FxDropped + n - k;
      Break;
    end;
    if BE_FxGet(k, DX, DY, VX, VY, HitM, Style, Delay) = 1 then
    begin
      FxQTick[FxQCount] := Tick + Delay;
      if (FxQNext = 0) or (Tick + Delay < FxQNext) then
        FxQNext := Tick + Delay;
      FxQTarget[FxQCount] := T;
      FxQStyle[FxQCount] := Style;
      FxQX[FxQCount] := DX;
      FxQY[FxQCount] := DY;
      FxQVX[FxQCount] := VX;
      FxQVY[FxQCount] := VY;
      FxQHit[FxQCount] := HitM;
      FxQCount := FxQCount + 1;
    end;
  end;
end;

{ a bullet the script makes (effects, explosions): the library's bullet scan does not take it for a
  shot of its owner }
{ a bullet of the script (the hook in CreateBullet sees that it comes from Map.CreateBullet, so it is
  not a shot of the owner) }
function ScriptBullet(X, Y, VX, VY, HitM: Single; Style: Integer; Owner: TActivePlayer): Integer;
begin
  Result := Map.CreateBullet(X, Y, VX, VY, HitM, Style, Owner);
end;

procedure FxStart(T, Kind: Integer);
begin
  AdminHit[T] := Game.TickCount;
  if (Kind = FX_PLAIN) or (not BeOk) then
  begin
    if BulletRoom(1) then
      ScriptBullet(PL[T].X, PL[T].Y, 0, 0, 1000 * FxPower, 4, PL[T]);
  end
  else
    FxAdd(T, Kind);
end;

procedure FxTick(Tick: Integer);
var
  k, n, Fired, T, LastT, Allowed: Integer;
  X, Y: Single;
begin
  if Tick < FxQNext then
    Exit;
  Allowed := BulletsFree(FX_PER_TICK + BULLET_MARGIN) - BULLET_MARGIN;
  if Allowed <= 0 then
    Exit;
  n := 0;
  Fired := 0;
  LastT := 0;
  X := 0;
  Y := 0;
  for k := 0 to FxQCount - 1 do
    if (FxQTick[k] <= Tick) and (Fired < Allowed) then
    begin
      T := FxQTarget[k];
      if ActiveSlot[T] then
      begin
        if T <> LastT then
        begin
          LastT := T;
          X := PL[T].X;
          Y := PL[T].Y;
        end;
        AdminHit[T] := Tick;
        ScriptBullet(X + FxQX[k], Y + FxQY[k], FxQVX[k], FxQVY[k], FxQHit[k], FxQStyle[k], PL[T]);
        Fired := Fired + 1;
      end;
    end
    else
    begin
      if n <> k then
      begin
        FxQTick[n] := FxQTick[k];
        FxQTarget[n] := FxQTarget[k];
        FxQStyle[n] := FxQStyle[k];
        FxQX[n] := FxQX[k];
        FxQY[n] := FxQY[k];
        FxQVX[n] := FxQVX[k];
        FxQVY[n] := FxQVY[k];
        FxQHit[n] := FxQHit[k];
      end;
      n := n + 1;
    end;
  FxQCount := n;
  FxQNext := 0;
  for k := 0 to FxQCount - 1 do
    if (FxQNext = 0) or (FxQTick[k] < FxQNext) then
      FxQNext := FxQTick[k];
end;

procedure TrStop(ID: Integer);
var
  n, T: Integer;
begin
  T := TrWatch[ID];
  if T > 0 then
    TrCount := TrCount - 1;
  if BeOk then
  begin
    n := BE_TrajHide(ID, 255);
    if T > 0 then
      TrSend(ID, T, n)
    else if ActiveSlot[ID] then
      OpsSend(ID, n);
  end;
  TrWatch[ID] := 0;
  TrBullet[ID] := 0;
  TrCursor[ID] := False;
  TrAud[ID] := TA_ME;
  if TrCount < 0 then
    TrCount := 0;
end;

function TrFollowStep(i, T, Tick: Integer; P: TActivePlayer): Integer;
var
  b, k, Top, Start, A: Integer;
  Bul: TActiveMapBullet;
begin
  Result := -1;
  if not (P.IsProne or P.KeyCrouch) then
  begin
    TrBullet[i] := 0;
    Exit;
  end;
  b := TrBullet[i];
  Start := 0;
  if b > 0 then
  begin
    Bul := BL[b];
    if not Bul.Active then
      b := 0
    else if Bul.Owner <> T then
      b := 0;
  end;
  if b = 0 then
  begin
    TrBullet[i] := 0;
    if P.Primary.WType <> 8 then
      Exit;
    TrDue[i] := After(Tick, TrEvery(i, TrFollowTicks));
    A := P.Primary.Ammo;
    if P.KeyShoot or (A < TrAmmo[i]) then
      TrShotAt[i] := Tick;
    TrAmmo[i] := A;
    if Tick - TrShotAt[i] > 60 then
      Exit;
    Top := 0;
    if ScanTop > MAX_BULLET_ID then
      ScanTop := MAX_BULLET_ID;
    for k := 1 to ScanTop do
    begin
      Bul := BL[k];
      if Bul.Active then
      begin
        Top := k;
        if b = 0 then
          if Bul.Owner = T then
            if Bul.GetOwnerWeaponId = 8 then
              b := k;
      end;
    end;
    ScanTop := Top + 32;
    if b = 0 then
      Exit;
    TrBullet[i] := b;
    Start := 1;
    Bul := BL[b];
  end;
  Result := BE_TrajTrack(i, Tick, TrBudget, Start, TeamOf[T], Bul.X, Bul.Y, Bul.VelX, Bul.VelY);
end;

procedure TrTick(Tick: Integer);
var
  i, T, W, n, k, Vis, Hit, m, Cur, AX, AY, Fl: Integer;
  P: TActivePlayer;
  PX, PY, QX, QY: Single;
begin
  for i := 1 to TopSlot do
    if TrWatch[i] > 0 then
      if Tick >= TrDue[i] then
      begin
        TrDue[i] := After(Tick, TrEvery(i, TrTicks));
        T := TrWatch[i];
        if (not ActiveSlot[T]) or (not ActiveSlot[i]) then
        begin
          TrStop(i);
          Continue;
        end;
        P := PL[T];
        if TrCursor[i] then
        begin
          TrDue[i] := After(Tick, TrCursorTicks);
          AX := 0;
          AY := 0;
          Cur := 0;
          if P.Alive then
          begin
            AX := P.MouseAimX;
            AY := P.MouseAimY;
            Cur := 1;
          end;
          m := BE_TrajStep(i, Tick, TrBudget, -1, 0, 0, 0, 0, 0, 0, AX, AY, Cur);
          if m < 0 then
            m := BE_TrajPass(i, Tick, TrBudget, 0, -1, AX, AY, Cur);
          TrSend(i, T, m);
          StatTraj := StatTraj + m;
          Continue;
        end;
        if TrFollow then
          if MapOk then
            if P.Alive then
            begin
              m := TrFollowStep(i, T, Tick, P);
              if m >= 0 then
              begin
                TrDue[i] := After(Tick, TrEvery(i, TrFollowTicks));
                TrSend(i, T, m);
                StatTraj := StatTraj + m;
                Continue;
              end;
            end;
        Cur := 0;
        AX := 0;
        AY := 0;
        W := -1;
        if P.Alive then
        begin
          AX := P.MouseAimX;
          AY := P.MouseAimY;
          if T <> i then
            if TrAud[i] <> TA_SELF then
              Cur := 1;
          W := P.Primary.WType;
          if (W < 0) or (W > 16) or (W = 12) then
            W := -1;
        end;
        m := -1;
        if MapOk then
          if W >= 0 then
          begin
            Fl := 0;
            if P.IsProne then
              Fl := SF_PRONE
            else if P.KeyCrouch then
              Fl := SF_CROUCH;
            m := BE_TrajStep(i, Tick, TrBudget, W, Fl, TeamOf[T], P.X, P.Y, P.VelX, P.VelY, AX, AY, Cur);
          end
          else
            m := BE_TrajStep(i, Tick, TrBudget, -1, 0, 0, 0, 0, 0, 0, AX, AY, Cur);
        if m < 0 then
        begin
          Vis := 0;
          Hit := -1;
          if W >= 0 then
          begin
            n := BE_Path(W, P.X, P.Y - MUZZLE_HEIGHT, P.VelX, P.VelY, AX, AY, 600, TrSpacing, TrRange);
            if TrView then
              n := BE_PathClip(P.X + (AX - P.X) * 0.5, P.Y + (AY - P.Y) * 0.5, 560, 380);
            if n > 0 then
              if BE_PathPoint(0, PX, PY) = 1 then
              begin
                Vis := 1;
                k := 1;
                while k < n do
                begin
                  if BE_PathPoint(k, QX, QY) <> 1 then
                    Break;
                  Vis := k + 1;
                  if Map.RayCast(PX, PY, QX, QY, False, False, True, False, 0) then
                  begin
                    Hit := k;
                    Break;
                  end;
                  PX := QX;
                  PY := QY;
                  k := k + 1;
                end;
              end;
          end;
          m := BE_TrajPass(i, Tick, TrBudget, Vis, Hit, AX, AY, Cur);
        end;
        TrSend(i, T, m);
        StatTraj := StatTraj + m;
      end;
end;

function AcKey(ID: Integer): string;
begin
  Result := PL[ID].HWID;
  if Result = '' then
    Result := LowerCase(PL[ID].Name);
  Result := 'ac:' + Result;
end;

procedure AcTick(Tick: Integer);
var
  i, k, n, F: Integer;
  P: TActivePlayer;
begin
  { the weapon in the hands: a few players a tick, each one every WeaponCheckTicks }
  for i := 1 to TopSlot do
    if (Tick + i) mod AcWatchTicks = 0 then
    begin
      AcWep[i] := -1;
      if ActiveSlot[i] then
        if HumanOf[i] or DebugBots then
          if PL[i].Alive then
          begin
            k := PL[i].Primary.WType;
            if BE_AcWatched(k) = 1 then
              AcWep[i] := k;
            if (k >= 0) and (k <= 16) then
              if not AbOn[i] then
                if not InfOn[i] then
                  BE_AcAmmo(i, Tick, k, PL[i].Primary.Ammo);
          end;
    end;
  AcN := 0;
  for i := 1 to TopSlot do
    if AcWep[i] >= 0 then
      if ActiveSlot[i] then
      begin
        AcList[AcN] := i;
        AcN := AcN + 1;
      end;
  n := 0;
  for k := 0 to AcN - 1 do
  begin
    i := AcList[k];
    P := PL[i];
    F := 0;
    if P.KeyShoot then
    begin
      F := AF_FIRE;
      if P.KeyJetpack then
        F := F + AF_MOVE
      else if P.KeyLeft or P.KeyRight then
        if not P.KeyCrouch then
          if not P.IsProne then
            F := F + AF_MOVE;
      if not P.OnGround then
        F := F + AF_AIR;
    end;
    AcI[n] := i * 16 + F;
    n := n + 1;
  end;
  if n > 0 then
    BE_AcKeys(Tick, n, AcI);
  if Tick - SnapTick >= AcSnapTicks then
    WorldSnap(Tick, SNAP_POS, False);
end;

function AcKindName(Kind: Integer): string;
begin
  case Kind of
    ACK_STARTUP: Result := 'fast start-up';
    ACK_RATE: Result := 'fire rate';
    ACK_JUMP: Result := 'teleports';
    ACK_BINK: Result := 'no bink';
    ACK_MOVE: Result := 'aim on the run';
    ACK_SPEED: Result := 'speed';
    ACK_AMMO: Result := 'ammo';
    ACK_RELOAD: Result := 'fast reload';
  else
    Result := 'cheating';
  end;
end;

procedure AcVoteKick(ID, Kind, Sc, Tick: Integer);
var
  Why: string;
begin
  if not AcVote then
    Exit;
  if Sc < AcVoteScore then
    Exit;
  if Tick < VoteBusyUntil then
    Exit;
  if Tick - AcVoted[ID] < AcVoteEvery then
    Exit;
  if PL[ID].IsAdmin then
    Exit;
  if BE_AcFindings(ID) < AcVoteMin then
    Exit;
  AcVoted[ID] := Tick;
  VoteBusyUntil := Tick + VOTE_TICKS;
  Why := Copy('AC: ' + AcKindName(Kind) + ' ' + IntToStr(Sc) + '%', 1, 25);
  Game.StartVoteKick(ID, Why);
  SayAll('[AC] Vote to kick ' + PL[ID].Name + ': ' + BE_AcText(ID, '', 0, Tick), ColorBad);
  if AcLogName <> '' then
    BE_Log(PChar(DataDir + AcLogName), PChar(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '  vote kick started: ' +
      PL[ID].Name + ' - ' + BE_AcText(ID, '', 0, Tick)));
end;

procedure AcDrain(Tick: Integer);
var
  ID, Kind, Sc, Guard: Integer;
  T, Line: string;
begin
  Guard := 0;
  T := BE_AcNext(ID, Kind);
  while (T <> '') and (Guard < 64) do
  begin
    Guard := Guard + 1;
    Line := T;
    Sc := 0;
    if (ID >= 1) and (ID <= 32) then
      if ActiveSlot[ID] then
      begin
        Sc := BE_AcScore(ID);
        Line := Line + ' | suspicion ' + IntToStr(Sc) + '%, ping ' + IntToStr(PL[ID].Ping) + ' [' + PL[ID].HWID + ' ' +
          PL[ID].IP + ']';
        if AcNotify then
          if Sc >= AcNotifyScore then
            if Tick - AcTold[ID] >= AcCooldown then
            begin
              AcTold[ID] := Tick;
              SayAdmins('[AC ' + IntToStr(Sc) + '%] ' + T + '  (/acstats ' + IntToStr(ID) + ')', ColorBad);
            end;
        AcVoteKick(ID, Kind, Sc, Tick);
      end;
    if AcLogName <> '' then
      BE_Log(PChar(DataDir + AcLogName), PChar(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '  ' + Line));
    T := BE_AcNext(ID, Kind);
  end;
end;

procedure AcAmmoTouched(ID: Integer);
begin
  if AcOn then
    if BeOk then
      BE_AcAmmoReset(ID);
end;

procedure AcDamage(S, V, Tick, BulletId: Integer; Shooter: TActivePlayer);
var
  Bul: TActiveMapBullet;
  W: Integer;
begin
  if AcWep[V] >= 0 then
    BE_AcHurt(V, Tick, AcWep[V]);
  if Tick - AcSkip[S] < 600 then
    Exit;
  if Tick - AdminHit[S] < 600 then
    Exit;
  Bul := BL[BulletId];
  if not Bul.Active then
    Exit;
  if Bul.Owner <> S then
    Exit;
  W := Bul.GetOwnerWeaponId;
  if (W < 0) or (W > 16) then
    Exit;
  BE_AcHit(Tick, S, W, BulletId, Bul.X, Bul.Y, Bul.VelX, Bul.VelY, Shooter.X, Shooter.Y - 10);
end;

{ the aimbot's key: FlagKey while the player carries a flag (the flag key would throw it) }
function AbKeyOf(P: TActivePlayer): Integer;
begin
  Result := AbKey;
  if P.Flagger then
    Result := AbFlagKey;
end;

function AbKeyDown(P: TActivePlayer): Boolean;
var
  K: Integer;
begin
  K := AbKeyOf(P);
  if K = AK_JET then
    Result := P.KeyJetpack
  else if K = AK_PRONE then
    Result := P.KeyProne
  else if K = AK_FIRE then
    Result := P.KeyShoot
  else if K = AK_FLAG then
    Result := P.KeyFlagThrow
  else
    Result := P.KeyCrouch;
end;

procedure AbPlay(i, W, Tick: Integer);
var
  k, Iv: Integer;
  Snd: string;
  R, X, Y: Single;
begin
  if Tick < AbSoundAt[i] then
    Exit;
  Iv := WpInterval[W] - 1;
  if Iv < 2 then
    Iv := 2;
  AbSoundAt[i] := Tick + Iv;
  Snd := BE_WeaponSound(W);
  if Snd = '' then
    Exit;
  R := AbSoundRange;
  X := PL[i].X;
  Y := PL[i].Y;
  for k := 1 to TopSlot do
    if ActiveSlot[k] then
      if HumanOf[k] then
        if (Abs(PL[k].X - X) <= R) and (Abs(PL[k].Y - Y) <= R) then
          PL[k].PlaySound(Snd, X, Y);
end;

function AbLawOk(P: TActivePlayer; Rule: Integer): Boolean;
begin
  Result := True;
  if Rule = LAW_ANY then
    Exit;
  Result := P.OnGround;
  if Result then
    if Rule = LAW_GAME then
      Result := P.KeyCrouch or P.IsProne;
end;

procedure AbSpinSound(W: Integer; P: TActivePlayer);
var
  k: Integer;
  Snd: string;
begin
  Snd := 'minigun-start.wav';
  if (W = 8) or (W = WEP_LAW) then
    Snd := 'law-start.wav';
  for k := 1 to TopSlot do
    if ActiveSlot[k] then
      if HumanOf[k] then
        if (Abs(PL[k].X - P.X) <= AbSoundRange) and (Abs(PL[k].Y - P.Y) <= AbSoundRange) then
          PL[k].PlaySound(Snd, P.X, P.Y);
end;

procedure AbRelease(i, Tick: Integer);
begin
  AbExtra[i] := 0;
  AbLastT[i] := 0;
  AbSpinning[i] := False;
  if AbHeld[i] then
  begin
    AbHeld[i] := False;
    BE_GunTick(i, Tick, AbW[i], 0, 1);
  end;
end;

procedure AbDropKnife(P: TActivePlayer);
var
  NW: TNewWeapon;
begin
  NW := TNewWeapon.Create;
  try
    NW.WType := WEP_NONE;
    P.ForceWeapon(NW, P.Secondary);
  finally
    NW.Free;
  end;
end;

procedure AbEditStop(i: Integer; Save: Boolean);
var
  n: Integer;
begin
  if not AbEdit[i] then
    Exit;
  AbEdit[i] := False;
  AbEditCount := AbEditCount - 1;
  if AbEditCount < 0 then
    AbEditCount := 0;
  if Save then
  begin
    AbRadius[i] := AbEditR[i];
    Say(i, 'Aimbot radius saved: ' + IntToStr(Round(AbRadius[i])) + ' pixels.', ColorGood);
  end
  else
    Say(i, 'Aimbot radius not changed: ' + IntToStr(Round(AbRadius[i])) + ' pixels.', ColorGood);
  if BeOk then
    if ActiveSlot[i] then
    begin
      n := BE_AimCircleHide(i, 255);
      OpsSend(i, n);
    end;
end;

procedure AbEditTick(Tick: Integer);
var
  i, n: Integer;
  P: TActivePlayer;
  Big, Small: Boolean;
begin
  for i := 1 to TopSlot do
    if AbEdit[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        AbEdit[i] := False;
        AbEditCount := AbEditCount - 1;
        Continue;
      end;
      if Tick > AbEditUntil[i] then
      begin
        AbEditStop(i, True);
        Continue;
      end;
      if not P.Alive then
        Continue;
      Big := P.KeyReload;
      Small := P.KeyChangeWeap;
      if Big then
        AbEditR[i] := AbEditR[i] * 1.015;
      if Small then
        AbEditR[i] := AbEditR[i] / 1.015;
      if AbEditR[i] < 10 then
        AbEditR[i] := 10;
      if AbEditR[i] > 2000 then
        AbEditR[i] := 2000;
      if Tick >= AbEditDue[i] then
      begin
        AbEditDue[i] := After(Tick, AbCircleTicks);
        n := BE_AimCircle(i, Tick, AbCircleDots + 1, AbCircleDots, AbCircleLayer, AbCircleColor, P.MouseAimX,
          P.MouseAimY, AbEditR[i], AbCircleScale);
        OpsSend(i, n);
      end;
    end;
  if AbEditCount < 0 then
    AbEditCount := 0;
end;

{ the aimbot's target: the enemy BE_GunPick chooses (a clear line, colliders too with Colliders = 1),
  0 = none }
function AbFind(i: Integer; SX, SY: Single): Integer;
var
  c, k, n, Rays: Integer;
  Lim: Single;
begin
  Result := -1;
  Rays := MR_BULLET;
  if AbCol[i] then
    Rays := MR_BULLET + MR_COLLIDER;
  Lim := AbAngle;
  if AbMode[i] = AT_RADIUS then
  begin
    Lim := AbRadius[i];
    if AbEdit[i] then
      Lim := AbEditR[i];
  end;
  if MapOk then
    Result := BE_GunPick(i, AbMode[i], AbRange, Lim, SX, SY, BODY_HEIGHT, 4, Rays);
  if Result >= 0 then
    Exit;
  c := BE_GunTargets(i, AbMode[i], AbRange, Lim);
  Result := 0;
  k := 0;
  while (k < c) and (k < 4) do
  begin
    n := BE_GunTarget(k);
    if (n >= 1) and (n <= 32) then
      if not Map.RayCast(SX, SY, PL[n].X, PL[n].Y - BODY_HEIGHT, False, False, True, AbCol[i], 0) then
      begin
        Result := n;
        Exit;
      end;
    k := k + 1;
  end;
end;

{ the wind-up sound of a Minigun or Barrett when the gun starts to be held }
procedure AbSpinCheck(i, W: Integer; P: TActivePlayer; Held: Boolean);
begin
  if BeOk then
  begin
    if BE_GunCheckStartSound(i) = 1 then
      if AbSound then
        AbSpinSound(W, P);
  end
  else if WpStartUp[W] > 0 then
  begin
    if Held then
    begin
      if not AbSpinning[i] then
      begin
        AbSpinning[i] := True;
        if AbSound then
          AbSpinSound(W, P);
      end;
    end
    else
      AbSpinning[i] := False;
  end;
end;

procedure AimbotTick(Tick: Integer);
var
  i, W, G, n, k, T, Style, Ticks, A, Flags, B, Guard, Key, Lt: Integer;
  P, Q: TActivePlayer;
  SX, SY, SVX, SVY, TX, TY, TG, DX, DY, HitM, X, Y, VX, VY, SpreadF, RandOffset, Len, CX, CY, NDX, NDY: Single;
  Inf, Want, Aimed: Boolean;
begin
  for i := 1 to TopSlot do
    if AbOn[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        AbOn[i] := False;
        AbCount := AbCount - 1;
        Continue;
      end;
      if not P.Alive then
        Continue;
      if not AbKeyDown(P) then
      begin
        AbRelease(i, Tick);
        Continue;
      end;
      Key := AbKeyOf(P);
      if Key <> AK_FIRE then
        if P.KeyShoot then
        begin
          AbManualAt[i] := Tick;
          AbAmmoTick[i] := -1000000;
          AbRelease(i, Tick);
          Continue;
        end;
      if Tick - AbManualAt[i] < AbPause then
        Continue;
      W := P.Primary.WType;
      if (W < 0) or (W > 16) or (W = 12) then
        Continue;
      if W = WEP_LAW then
        if not AbLawOk(P, AbLaw[i]) then
        begin
          AbRelease(i, Tick);
          Continue;
        end;
      if not CanUse(i, C_AIMBOT, False) then
      begin
        AbOn[i] := False;
        AbCount := AbCount - 1;
        Say(i, 'Aimbot off: you may not use it any more.', ColorBad);
        Continue;
      end;
      Inf := AbInfinite or InfOn[i];
      A := 1;
      if not Inf then
      begin
        A := P.Primary.Ammo;
        if AmmoEnabled then
          A := BE_AmmoClip(i, Tick, A);
        if AbAmmoW[i] = W then
          if A > AbAmmoSet[i] then
          begin
            Guard := 45;
            if AbAmmoSet[i] = 0 then
              if WpReload[W] - 4 < Guard then
                Guard := WpReload[W] - 4;
            if Tick - AbAmmoTick[i] < Guard then
              A := AbAmmoSet[i];
          end;
      end;
      { the gun is held (a Minigun or Barrett winds up, with its sound) only while there is somebody to
        shoot at, and the target is looked for only when it matters: while the gun is held, when a
        shot may go; while it is not, every third tick }
      AbW[i] := W;
      G := 0;
      if AbHeld[i] then
      begin
        G := BE_GunTick(i, Tick, W, 1, 1);
        AbSpinCheck(i, W, P, True);
        if G <> 1 then
          Continue;
      end
      else if (Tick + i) mod 3 <> 0 then
        Continue;
      WorldSnap(Tick, SNAP_FULL, False);
      SX := P.X;
      SY := P.Y - MUZZLE_HEIGHT;
      SVX := P.VelX;
      SVY := P.VelY;
      T := AbFind(i, SX, SY);
      { extra shots only after a kill: a target merely out of sight (behind a wall) gets none, nor
        does a kill while another enemy is within range }
      if T = 0 then
        if AbExtra[i] <= 0 then
          if AbLastT[i] > 0 then
          begin
            Lt := AbLastT[i];
            AbLastT[i] := 0;
            AbXLast[i] := Lt;
            if AbXMax[i] > 0 then
              if WpInterval[W] <= AbXInterval then
                if WpAmmo[W] >= 2 then
                  if not PL[Lt].Alive then
                    if BE_GunTargets(i, AT_NEAREST, AbRange, 180) = 0 then
                    begin
                      AbExtra[i] := AbXMin[i] + Random(0, AbXMax[i] - AbXMin[i] + 1);
                      AbXCount[i] := 0;
                    end;
          end;
      Want := (T > 0) or (AbExtra[i] > 0);
      if not Want then
      begin
        if AbHeld[i] then
        begin
          AbHeld[i] := False;
          BE_GunTick(i, Tick, W, 0, 1);
          AbSpinCheck(i, W, P, False);
        end;
        Continue;
      end;
      if not AbHeld[i] then
      begin
        AbHeld[i] := True;
        G := BE_GunTick(i, Tick, W, 1, 1);
        AbSpinCheck(i, W, P, True);
        if G <> 1 then
          Continue;
      end;
      { the game reloads the weapon: it stays held, the shots wait }
      if not Inf then
        if A <= 0 then
          Continue;
      Flags := 0;
      if P.IsProne then
        Flags := SF_PRONE
      else if P.KeyCrouch then
        Flags := SF_CROUCH;
      if T = 0 then
      begin
        AbExtra[i] := AbExtra[i] - 1;
        AbXCount[i] := AbXCount[i] + 1;
        DX := AbLDX[i];
        DY := AbLDY[i];
        CX := AbCorpseX[i];
        CY := AbCorpseY[i];
        Aimed := False;
        { the corpse modes follow the body of the killed target, where the game has it }
        if (AbXMode = AB_XMODE_CORPSE) or (AbXMode = AB_XMODE_BOTH) then
          if (AbXLast[i] >= 1) and (AbXLast[i] <= 32) then
          begin
            Q := PL[AbXLast[i]];
            if Q.Active then
            begin
              CX := Q.X;
              CY := Q.Y - CORPSE_HEIGHT;
              TG := 0;
              if not Q.OnGround then
                TG := Game.Gravity;
              BE_Muzzle(SX, P.Y, CX, CY, Flags, SX, SY);
              BE_Solve(W, SX, SY, SVX, SVY, CX, CY, Q.VelX, Q.VelY, TG, DX, DY, Ticks);
              AbLDX[i] := DX;
              AbLDY[i] := DY;
              Aimed := True;
            end;
          end;
        if not Aimed then
          BE_Muzzle(SX, P.Y, SX + DX * 100, SY + DY * 100, Flags, SX, SY);
        { no shot into a wall }
        if Map.RayCast(SX, SY, CX, CY, False, False, True, AbCol[i], 0) then
        begin
          AbExtra[i] := 0;
          Continue;
        end;
        { the spread modes: each shot of the burst goes off by a random angle that grows with the
          shots; the direction itself stays }
        if (AbXMode = AB_XMODE_SPREAD) or (AbXMode = AB_XMODE_BOTH) then
          if AbXSpread > 0 then
          begin
            SpreadF := AbXCount[i] * (AbXSpread * 0.0035);
            RandOffset := (Random(0, 201) - 100) * 0.01;
            NDX := DX - DY * (RandOffset * SpreadF);
            NDY := DY + DX * (RandOffset * SpreadF);
            Len := Sqrt(NDX * NDX + NDY * NDY);
            if Len > 0.0001 then
            begin
              DX := NDX / Len;
              DY := NDY / Len;
            end;
          end;
      end
      else
      begin
        AbLastT[i] := T;
        AbExtra[i] := 0;
        AbXCount[i] := 0;
        Q := PL[T];
        TX := Q.X;
        TY := Q.Y - BODY_HEIGHT;
        TG := 0;
        if not Q.OnGround then
          TG := Game.Gravity;
        BE_Muzzle(SX, P.Y, TX, TY, Flags, SX, SY);
        BE_Solve(W, SX, SY, SVX, SVY, TX, TY, Q.VelX, Q.VelY, TG, DX, DY, Ticks);
        AbLDX[i] := DX;
        AbLDY[i] := DY;
        AbCorpseX[i] := TX;
        AbCorpseY[i] := TY;
      end;
      if AbAcc[i] > 0 then
      begin
        if not P.OnGround then
          Flags := Flags + SF_AIRBORNE;
        if P.KeyJetpack or ((P.KeyLeft or P.KeyRight) and P.OnGround) then
          Flags := Flags + SF_RUNNING;
      end;
      if W = 10 then
      begin
        if P.KeyJetpack then
          if P.Jets > 0 then
            Flags := Flags or SF_JET;
        if P.Flagger then
          Flags := Flags or SF_FLAG;
      end;
      n := BE_Shot(W, SX, SY, SVX, SVY, DX, DY, AbAcc[i] * 0.01, Tick * 17 + i * 131, Flags, Style, HitM);
      if not BulletRoom(n) then
        Continue;
      for k := 0 to n - 1 do
        if BE_ShotGet(k, X, Y, VX, VY) = 1 then
        begin
          AcSkip[i] := Tick;
          B := Map.CreateBullet(X, Y, VX, VY, HitM, Style, P);
          if (B >= 0) and (B <= 255) then
          begin
            AbBulletTick[B] := Tick;
            AbBulletOwner[B] := i;
            if BeOk then
              BE_BridgeSetWeapon(B, Style, W, HitM);
          end;
        end;
      BE_GunFired(i, Tick);
      StatShots := StatShots + n;
      { MuzzleFlash: a small flame at the muzzle that hurts nobody (the game draws none for a script's
        bullet), at most every 4 ticks }
      if AbMuzzleFlash then
        if W <> WEP_KNIFE then
          if Tick - AbFlashAt[i] >= 4 then
            if BulletRoom(1) then
            begin
              AbFlashAt[i] := Tick;
              Map.CreateBullet(SX + DX * 8, SY + DY * 8, DX * 1.2 + SVX, DY * 1.2 + SVY, 0, BS_FLAME, P);
            end;
      if AbPush then
        if (W = 5) or (W = 10) then
        begin
          BE_ShotPush(X, Y);
          if (Abs(X) > 0.001) or (Abs(Y) > 0.001) then
            P.SetVelocity(SVX + X, SVY + Y);
        end;
      if not Inf then
        if W = WEP_KNIFE then
        begin
          AbRelease(i, Tick);
          AbDropKnife(P);
        end
        else if Key <> AK_FIRE then
        begin
          P.Primary.Ammo := A - 1;
          AbAmmoW[i] := W;
          AbAmmoSet[i] := A - 1;
          AbAmmoTick[i] := Tick;
          if AmmoEnabled then
          begin
            BE_AmmoForced(i, Tick, W, A - 1);
            HudMark(i, False);
          end;
        end;
      if AbSound then
        AbPlay(i, W, Tick);
    end;
  if AbCount < 0 then
    AbCount := 0;
end;

{ ================================ the editor (health display, radar) ================================ }

{ what the editor shows while it is open: the health text, or the radar at the new place }
procedure EditorShow(ID: Integer);
begin
  if EdKind[ID] = ED_RADAR then
    RadarDirty(ID)
  else
    HudMark(ID, True);
end;

procedure EditorStop(ID: Integer; Save: Boolean);
var
  X, Y, M: Integer;
begin
  if not EdOn[ID] then
    Exit;
  EdOn[ID] := False;
  EdCount := EdCount - 1;
  if EdCount < 0 then
    EdCount := 0;
  { closed without saving: the display is on or off as before }
  if not Save then
  begin
    if EdKind[ID] = ED_RADAR then
    begin
      if RdPOn[ID] <> EdOldOn[ID] then
      begin
        RdPOn[ID] := EdOldOn[ID];
        RadarApplyOn(ID);
        OverlayRecount();
      end;
    end
    else if EdKind[ID] = ED_AMMO then
      AmPOn[ID] := EdOldOn[ID]
    else
      HudPOn[ID] := EdOldOn[ID];
  end;
  if EdKind[ID] = ED_RADAR then
  begin
    if Save then
    begin
      M := EdMode[ID];
      RdMX[ID][M] := Round(EdX[ID]);
      RdMY[ID][M] := Round(EdY[ID]);
      RdMSize[ID][M] := EdScale[ID];
      RadarDefPos(M, X, Y);
      if RdMX[ID][M] = X then
        if RdMY[ID][M] = Y then
        begin
          RdMX[ID][M] := -1;
          RdMY[ID][M] := -1;
        end;
      if Abs(RdMSize[ID][M] - 1) < 0.001 then
        RdMSize[ID][M] := 0;
      PrefsSave(ID);
      Say(ID, 'Radar (' + RadarModeName(M) + ') saved: position ' + IntToStr(Round(EdX[ID])) + ' ' +
        IntToStr(Round(EdY[ID])) + ', size ' + FloatStr(EdScale[ID], 2) + '.', ColorGood);
    end
    else
      Say(ID, 'Radar editor closed without saving.', ColorGood);
    RadarDirty(ID);
    Exit;
  end;
  if EdKind[ID] = ED_AMMO then
  begin
    if Save then
    begin
      AmPX[ID] := Round(EdX[ID]);
      AmPY[ID] := Round(EdY[ID]);
      AmPScale[ID] := EdScale[ID];
      if AmPX[ID] = AhDefX then
        if AmPY[ID] = AhDefY then
        begin
          AmPX[ID] := -1;
          AmPY[ID] := -1;
        end;
      if Abs(AmPScale[ID] - AhDefScale) < 0.0001 then
        AmPScale[ID] := 0;
      PrefsSave(ID);
      Say(ID, 'Ammo display saved: position ' + IntToStr(Round(EdX[ID])) + ' ' + IntToStr(Round(EdY[ID])) + ', size ' +
        FloatStr(EdScale[ID], 4) + '.', ColorGood);
    end
    else
      Say(ID, 'Ammo display editor closed without saving.', ColorGood);
    HudMark(ID, True);
    Exit;
  end;
  if Save then
  begin
    HudPX[ID] := Round(EdX[ID]);
    HudPY[ID] := Round(EdY[ID]);
    HudPScale[ID] := EdScale[ID];
    if HudPX[ID] = HudDefX then
      if HudPY[ID] = HudDefY then
      begin
        HudPX[ID] := -1;
        HudPY[ID] := -1;
      end;
    if Abs(HudPScale[ID] - HudDefScale) < 0.0001 then
      HudPScale[ID] := 0;
    PrefsSave(ID);
    Say(ID, 'Health display saved: position ' + IntToStr(Round(EdX[ID])) + ' ' + IntToStr(Round(EdY[ID])) +
      ', size ' + FloatStr(EdScale[ID], 4) + '.', ColorGood);
  end
  else
    Say(ID, 'Health display editor closed without saving.', ColorGood);
  HudMark(ID, True);
end;

{ Kind = ED_HUD, ED_AMMO or ED_RADAR. The player stands still; the keys move and resize the text. }
procedure EditorStart(ID, Kind: Integer);
var
  P: TActivePlayer;
  X, Y: Integer;
  S: Single;
begin
  P := PL[ID];
  if not P.Alive then
  begin
    Say(ID, 'The editor works only while you are alive.', ColorBad);
    Exit;
  end;
  { it holds him in place: only on the ground (else he would hang in the air) }
  if not P.OnGround then
    if not EdOn[ID] then
    begin
      Say(ID, 'Stand on the ground to open the editor.', ColorBad);
      Exit;
    end;
  if EdOn[ID] then
  begin
    if EdKind[ID] = Kind then
      Exit;
    EditorStop(ID, True);
  end;
  if Kind = ED_RADAR then
  begin
    EdMode[ID] := RadarMode(ID);
    RadarPos(ID, EdMode[ID], X, Y);
    S := RadarSize(ID);
  end;
  EdOn[ID] := True;
  EdKind[ID] := Kind;
  EdCount := EdCount + 1;
  EdUntil[ID] := Game.TickCount + HudEditorTicks;
  EdHold[ID] := 0;
  EdSizeHold[ID] := 0;
  EdProne[ID] := P.IsProne;
  EdNade[ID] := P.KeyGrenade;
  EdMoved[ID] := False;
  EdPinX[ID] := P.X;
  EdPinY[ID] := P.Y;
  EdPinAt[ID] := 0;
  EdShowAt[ID] := 0;
  if Kind = ED_RADAR then
  begin
    EdX[ID] := X;
    EdY[ID] := Y;
    EdScale[ID] := S;
    RdMark[ID] := S;
    if (EdMode[ID] = OVL_LABELS) or (EdMode[ID] = OVL_ARROWS) then
      RdMark[ID] := 0;
    EdOldOn[ID] := RdPOn[ID];
    if not OvlOn[ID] then
    begin
      RdPOn[ID] := PREF_ON;
      RadarApplyOn(ID);
      OverlayRecount();
    end;
    Say(ID, 'Radar editor: you stand still while it is open.', ColorGood);
  end
  else if Kind = ED_AMMO then
  begin
    EdX[ID] := AmPX[ID];
    if EdX[ID] < 0 then
      EdX[ID] := AhDefX;
    EdY[ID] := AmPY[ID];
    if EdY[ID] < 0 then
      EdY[ID] := AhDefY;
    EdScale[ID] := AmPScale[ID];
    if EdScale[ID] <= 0 then
      EdScale[ID] := AhDefScale;
    EdOldOn[ID] := AmPOn[ID];
    if not AmmoHudIsOn(ID) then
      AmPOn[ID] := PREF_ON;
    Say(ID, 'Ammo display editor: you stand still while it is open.', ColorGood);
  end
  else
  begin
    EdX[ID] := HudPX[ID];
    if EdX[ID] < 0 then
      EdX[ID] := HudDefX;
    EdY[ID] := HudPY[ID];
    if EdY[ID] < 0 then
      EdY[ID] := HudDefY;
    EdScale[ID] := HudPScale[ID];
    if EdScale[ID] <= 0 then
      EdScale[ID] := HudDefScale;
    EdOldOn[ID] := HudPOn[ID];
    if not HudIsOn(ID) then
      HudPOn[ID] := PREF_ON;
    Say(ID, 'Health display editor: you stand still while it is open.', ColorGood);
  end;
  Say(ID, 'Left / right, jump / crouch = move it (a tap = 1 pixel, hold = on and faster);', ColorGood);
  Say(ID, 'reload = bigger, change weapon = smaller.', ColorGood);
  Say(ID, 'Grenade (E) = save and close; lie down (X, prone) = close without saving. A hit or ' +
    IntToStr(HudEditorTicks div 60) + ' seconds save and close it.', ColorGood);
  EditorShow(ID);
end;

{ how many steps a key held for Hold ticks makes in this tick: a tap one step, then a pause of a
  third of a second, then one step every third tick, after a second one step a tick and after two
  seconds two }
function EditorSteps(Hold: Integer): Integer;
begin
  Result := 0;
  if Hold = 1 then
    Result := 1
  else if Hold > 120 then
    Result := 2
  else if Hold > 60 then
    Result := 1
  else if Hold > 20 then
    if Hold mod 3 = 0 then
      Result := 1;
end;

procedure EditorTick(Tick: Integer);
var
  i, Steps, ShowTicks, Rep: Integer;
  P: TActivePlayer;
  L, R, U, D, Big, Small, Prone, Nade, Any, Air: Boolean;
  Step, Lo, Hi, SizeStep, Drift, VY: Single;
begin
  for i := 1 to TopSlot do
    if EdOn[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        EdOn[i] := False;
        EdCount := EdCount - 1;
        Continue;
      end;
      if not P.Alive then
      begin
        EditorStop(i, False);
        Continue;
      end;
      if Tick > EdUntil[i] then
      begin
        EditorStop(i, True);
        Continue;
      end;
      { the keys come with the player's movement packets (every 4-5 ticks); prone is not a key
        the server sees, so going prone is read from the stance }
      L := P.KeyLeft;
      R := P.KeyRight;
      U := P.KeyUp;
      D := P.KeyCrouch;
      Big := P.KeyReload;
      Small := P.KeyChangeWeap;
      Prone := P.IsProne;
      Nade := P.KeyGrenade;
      if Nade then
        if not EdNade[i] then
        begin
          EditorStop(i, True);
          Continue;
        end;
      EdNade[i] := Nade;
      if Prone then
        if not EdProne[i] then
        begin
          EditorStop(i, False);
          Continue;
        end;
      EdProne[i] := Prone;
      if EdKind[i] = ED_RADAR then
      begin
        Lo := 0.3;
        Hi := 4;
        SizeStep := 1.05;
        if RadarMode(i) = OVL_CIRCLE then
          SizeStep := 1.02;
        if (EdMode[i] = OVL_LABELS) or (EdMode[i] = OVL_ARROWS) then
        begin
          SizeStep := 1.1;
          L := False;
          R := False;
          U := False;
          D := False;
        end;
        ShowTicks := 10;
      end
      else
      begin
        Lo := 0.005;
        Hi := 0.5;
        SizeStep := 1.04;
        ShowTicks := 3;
      end;
      Any := L or R or U or D or Big or Small;
      if Any then
      begin
        if L or R or U or D then
          EdHold[i] := EdHold[i] + 1
        else
          EdHold[i] := 0;
        Steps := EditorSteps(EdHold[i]);
        if Steps > 0 then
          if L or R or U or D then
          begin
            Step := HudEditorStep * Steps;
            if L then
              EdX[i] := EdX[i] - Step;
            if R then
              EdX[i] := EdX[i] + Step;
            if U then
              EdY[i] := EdY[i] - Step;
            if D then
              EdY[i] := EdY[i] + Step;
            if EdX[i] < 0 then
              EdX[i] := 0;
            if EdX[i] > 850 then
              EdX[i] := 850;
            if EdY[i] < 0 then
              EdY[i] := 0;
            if EdY[i] > 475 then
              EdY[i] := 475;
            EdMoved[i] := True;
          end;
        { the size: one step a press; held on, one every 6 ticks after 24 ticks (reload) or after a
          second (change weapon: the game sends that key as pressed for the whole weapon change, so
          a tap looks like a hold of half a second). Every size the client meets costs it a new set
          of letters; a fast stream of sizes stalled the game. }
        if Big or Small then
          EdSizeHold[i] := EdSizeHold[i] + 1
        else
          EdSizeHold[i] := 0;
        Rep := 24;
        if Small then
          Rep := 60;
        if Big or Small then
          if (EdSizeHold[i] = 1) or ((EdSizeHold[i] > Rep) and (EdSizeHold[i] mod 6 = 0)) then
          begin
            if Big then
              EdScale[i] := EdScale[i] * SizeStep;
            if Small then
              EdScale[i] := EdScale[i] / SizeStep;
            if EdScale[i] < Lo then
              EdScale[i] := Lo;
            if EdScale[i] > Hi then
              EdScale[i] := Hi;
            EdMoved[i] := True;
          end;
        { drawn at most every ShowTicks; the last step is drawn on release }
        if EdMoved[i] then
          if Tick >= EdShowAt[i] then
          begin
            EdMoved[i] := False;
            EdShowAt[i] := Tick + ShowTicks;
            EditorShow(i);
          end;
      end
      else
      begin
        EdHold[i] := 0;
        EdSizeHold[i] := 0;
        if EdMoved[i] then
        begin
          EdMoved[i] := False;
          EditorShow(i);
        end;
      end;
      { in the air (a jump, pushed off a ledge) the hold follows him down: he falls as anybody }
      Air := not P.OnGround;
      if Air then
        EdPinY[i] := P.Y;
      Drift := Abs(P.X - EdPinX[i]) + Abs(P.Y - EdPinY[i]);
      if Tick >= EdPinAt[i] then
        if L or R or U or D then
        begin
          if Drift > 80 then
          begin
            VY := 0;
            if Air then
              VY := P.VelY;
            MovePlayer(P, EdPinX[i], EdPinY[i]);
            P.SetVelocity(0, VY);
            EdPinAt[i] := Tick + 20;
          end;
        end
        else if Drift > 4 then
        begin
          VY := 0;
          if Air then
            VY := P.VelY;
          MovePlayer(P, EdPinX[i], EdPinY[i]);
          P.SetVelocity(0, VY);
          EdPinAt[i] := Tick + 6;
        end;
    end;
end;

{ ================================ admins by Steam id ================================ }

procedure SaveGrants();
begin
  try
    GrantList.SaveToFile(DataDir + 'granted_admins.txt');
  except
    Log('cannot write ' + DataDir + 'granted_admins.txt');
  end;
end;

{ [Admin] Steam-N: the player is an admin for this visit once Steam has confirmed his account (an
  HWID can be faked, a Steam account cannot). Soldat keeps admins by IP, and setting IsAdmin makes
  the server write the IP into remote.txt (taking it away removes it from there). So the script takes
  back only an IP it put there itself, and only when no other player it made admin uses that IP; an
  admin by remote.txt, 127.0.0.1 or a TCP login is left alone. }
{ his admin rights changed: the full radar follows them ([Radar] AdminsFull) }
procedure RadarRightsChanged(ID: Integer);
var
  Was: Boolean;
begin
  if not Started then
    Exit;
  Was := OvlAllowed[ID];
  OverlayAllow(ID);
  if Was <> OvlAllowed[ID] then
  begin
    RadarApplyOn(ID);
    RadarDirty(ID);
    OverlayRecount();
  end;
end;

procedure GrantSteamAdmin(ID: Integer);
var
  P: TActivePlayer;
  Ip: string;
begin
  if GrantedIp[ID] <> '' then
    Exit;
  if SteamId[ID] = '' then
    Exit;
  if AdSteams.IndexOf(SteamId[ID]) < 0 then
    Exit;
  P := PL[ID];
  Ip := P.IP;
  if Ip = '' then
    Exit;
  if P.IsAdmin then
  begin
    { already an admin: ours only when an earlier run of the script put the IP there }
    if GrantList.IndexOf(Ip) >= 0 then
      GrantedIp[ID] := Ip;
    Exit;
  end;
  P.IsAdmin := True;
  GrantedIp[ID] := Ip;
  RadarRightsChanged(ID);
  if GrantList.IndexOf(Ip) < 0 then
  begin
    GrantList.Add(Ip);
    SaveGrants();
  end;
  Log(P.Name + ' is an admin for this visit (' + AdSteamFile + ': ' + SteamId[ID] + ').');
  Say(ID, 'You are an admin on this server (Steam account ' + SteamId[ID] + ').', ColorGood);
end;

procedure RevokeGrant(ID: Integer);
var
  i, k: Integer;
  Ip: string;
begin
  Ip := GrantedIp[ID];
  GrantedIp[ID] := '';
  if Ip = '' then
    Exit;
  for i := 1 to 32 do
    if GrantedIp[i] = Ip then
      Exit;
  PL[ID].IsAdmin := False;
  RadarRightsChanged(ID);
  k := GrantList.IndexOf(Ip);
  if k >= 0 then
  begin
    GrantList.Delete(k);
    SaveGrants();
  end;
end;

{ An IP this script once made admin (the server stopped while that admin played, or his IP changed)
  and now used by a player it did not make admin: the rights are taken back, or whoever gets that
  address later would be an admin. A Steam admin who comes back gets them again when Steam confirms
  him. }
procedure DropStaleGrant(ID: Integer);
var
  i, k: Integer;
  Ip: string;
begin
  if GrantedIp[ID] <> '' then
    Exit;
  Ip := PL[ID].IP;
  if Ip = '' then
    Exit;
  k := GrantList.IndexOf(Ip);
  if k < 0 then
    Exit;
  for i := 1 to 32 do
    if GrantedIp[i] = Ip then
      Exit;
  PL[ID].IsAdmin := False;
  RadarRightsChanged(ID);
  GrantList.Delete(k);
  SaveGrants();
  Log('the admin rights of ' + Ip + ' (given for ' + AdSteamFile + ' earlier) were taken back: ' + PL[ID].Name +
    ' joined from it');
end;

{ after /reloadsettings or /steamadmin: players now on the list become admins, players taken off it
  lose what this script gave them }
procedure RecheckSteamAdmins();
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if SteamId[i] <> '' then
      begin
        if AdSteams.IndexOf(SteamId[i]) >= 0 then
          GrantSteamAdmin(i)
        else if GrantedIp[i] <> '' then
        begin
          RevokeGrant(i);
          Log(PL[i].Name + ' is not in ' + AdSteamFile + ' any more: the admin rights this script gave were taken back.');
        end;
      end;
end;

{ ================================ extras (from the owner's older scripts) ================================ }

{ a text of [Assists], [MultiKill] ...: the tokens replaced (count and seconds are the same number) }
function ExText(S, Player, Other: string; Points, Pct, Count, Need: Integer): string;
begin
  if BeOk then
  begin
    Result := BE_Fill(S, '{player}'#1 + Player + #1'{killer}'#1 + Player + #1'{victim}'#1 + Other + #1'{saved}'#1 +
      Other + #1'{points}'#1 + IntToStr(Points) + #1'{pct}'#1 + IntToStr(Pct) + #1'{count}'#1 + IntToStr(Count) +
      #1'{seconds}'#1 + IntToStr(Count) + #1'{need}'#1 + IntToStr(Need));
    Exit;
  end;
  Result := ReplaceAll(S, '{player}', Player);
  Result := ReplaceAll(Result, '{killer}', Player);
  Result := ReplaceAll(Result, '{victim}', Other);
  Result := ReplaceAll(Result, '{saved}', Other);
  Result := ReplaceAll(Result, '{points}', IntToStr(Points));
  Result := ReplaceAll(Result, '{pct}', IntToStr(Pct));
  Result := ReplaceAll(Result, '{count}', IntToStr(Count));
  Result := ReplaceAll(Result, '{seconds}', IntToStr(Count));
  Result := ReplaceAll(Result, '{need}', IntToStr(Need));
end;

{ [General] Opponents: somebody plays against him - a player of another team in the game (in the modes without teams
  anybody else), not a spectator; with humans only a human counts. Always True with off }
function HasOpponent(ID: Integer): Boolean;
var
  i, T: Integer;
  Teams: Boolean;
begin
  Result := True;
  if OppMode = OPP_OFF then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  Result := False;
  T := TeamOf[ID];
  Teams := TeamGame();
  for i := 1 to TopSlot do
    if i <> ID then
      if ActiveSlot[i] then
        if (TeamOf[i] >= 0) and (TeamOf[i] <= 4) then
          if HumanOf[i] or (OppMode = OPP_ANY) then
            if (not Teams) or (TeamOf[i] <> T) then
            begin
              Result := True;
              Exit;
            end;
end;

{ an earning may go to him: he has an opponent; else he is told why nothing came (once, again after he had one) }
function Opposed(ID: Integer): Boolean;
begin
  Result := HasOpponent(ID);
  if (ID < 1) or (ID > 32) then
    Exit;
  if Result then
    OppTold[ID] := False
  else if not OppTold[ID] then
  begin
    OppTold[ID] := True;
    if HumanOf[ID] then
      if OppText <> '' then
        Say(ID, OppText, ColorBad);
  end;
end;

{ kill points for a player (the scoreboard), never below 0; nothing earned without an opponent }
procedure AddPoints(ID, N: Integer);
var
  K: Integer;
begin
  if N = 0 then
    Exit;
  if N > 0 then
    if not Opposed(ID) then
      Exit;
  K := PL[ID].Kills + N;
  if K < 0 then
    K := 0;
  PL[ID].Kills := K;
end;

{ two players on opposite sides (every other player in the modes without teams) }
function Enemies(A, B: Integer): Boolean;
begin
  Result := A <> B;
  if Result then
    if TeamGame() then
      Result := TeamOf[A] <> TeamOf[B];
end;

{ [Assists]: whoever did at least MinPercent of the victim's health in his last fight (since his
  respawn or his last regeneration) gets an assist; PerPoint assists make Points kill points }
procedure AssistKill(K, V: Integer);
var
  s, Pct: Integer;
  T: string;
begin
  for s := 1 to TopSlot do
    if ActiveSlot[s] then
      if s <> V then
        if s <> K then
          if Enemies(s, V) then
          begin
            Pct := Round(Dealt[s][V] * 100 / MaxHealth);
            if Pct > 100 then
              Pct := 100;
            if Pct >= AsMinPct then
            begin
              AsCount[s] := AsCount[s] + 1;
              if (AsPerPoint > 0) and (AsCount[s] >= AsPerPoint) then
              begin
                AsCount[s] := 0;
                AddPoints(s, AsPoints);
                T := ExText(AsPointText, PL[s].Name, PL[V].Name, AsPoints, Pct, AsPerPoint, AsPerPoint);
              end
              else
                T := ExText(AsText, PL[s].Name, PL[V].Name, AsPoints, Pct, AsCount[s], AsPerPoint);
              if PL[s].Human then
                PL[s].BigText(AsLayer, T, AsTicks, AsColor, AsScale, AsX, AsY);
            end;
          end;
end;

{ [MultiKill]: kills of one player no more than WindowSeconds apart; the Nth of them brings the
  line ComboN (text|min-max points) }
procedure MultiKill(K, Tick: Integer);
var
  n, Pts: Integer;
begin
  if Tick - McLast[K] > McWindow then
    McCount[K] := 0;
  McLast[K] := Tick;
  McCount[K] := McCount[K] + 1;
  n := McCount[K];
  if (n < 2) or (n > 10) then
    Exit;
  if McText[n] = '' then
    Exit;
  Pts := McMin[n];
  if McMax[n] > McMin[n] then
    Pts := Random(McMin[n], McMax[n] + 1);
  AddPoints(K, Pts);
  SayAll(ExText(McText[n], PL[K].Name, '', Pts, 0, n, 0), McColor);
end;

procedure SpreeKill(K, V: Integer; Counts, RoundEnd: Boolean);
var
  i, n: Integer;
begin
  { H16: the survival round's end is no death (a slay, a bleed-out, a vest's own blast are) }
  if RoundEnd then
    Exit;
  n := SrRun[V];
  SrRun[V] := 0;
  if n >= SrEndMin then
    if K <> V then
      SayAll(ExText(SrEndText, PL[K].Name, PL[V].Name, 0, 0, n, 0), SrColor)
    else
      SayAll(ExText(SrEndText, PL[V].Name, PL[V].Name, 0, 0, n, 0), SrColor);
  if not Counts then
    Exit;
  SrRun[K] := SrRun[K] + 1;
  n := SrRun[K];
  for i := 1 to SrCount do
    if SrKills[i] = n then
      if SrText[i] <> '' then
        SayAll(ExText(SrText[i], PL[K].Name, PL[V].Name, 0, 0, n, 0), SrColor);
end;

{ [FirstBlood]: the first kill of the map }
procedure FirstBloodKill(K, V: Integer);
begin
  if FbDone then
    Exit;
  FbDone := True;
  AddPoints(K, FbPoints);
  SayAll(ExText(FbText, PL[K].Name, PL[V].Name, FbPoints, 0, 0, 0), FbColor);
  if FbPoints <> 0 then
    Say(K, ExText(FbPointsText, PL[K].Name, PL[V].Name, FbPoints, 0, 0, 0), FbColor);
end;

{ [Savior]: the victim had hit a team mate of the killer within WindowSeconds - that team mate was
  rescued }
procedure SaviorKill(K, V, Tick: Integer);
var
  Saved: Integer;
begin
  Saved := SvTarget[V];
  SvTarget[V] := 0;
  if (Saved < 1) or (Saved > 32) then
    Exit;
  if Tick - SvTick[V] > SvWindow then
    Exit;
  if Saved = K then
    Exit;
  if not ActiveSlot[Saved] then
    Exit;
  if not PL[Saved].Alive then
    Exit;
  if not TeamGame() then
    Exit;
  if TeamOf[Saved] <> TeamOf[K] then
    Exit;
  AddPoints(K, SvPoints);
  Say(Saved, ExText(SvSavedText, PL[K].Name, PL[Saved].Name, SvPoints, 0, 0, 0), SvColor);
  Say(K, ExText(SvText, PL[K].Name, PL[Saved].Name, SvPoints, 0, 0, 0), SvColor);
end;

{ [SelfKill]: a suicide costs Points kill points (not the kills of the server itself) }
procedure SelfKillPenalty(V: Integer);
begin
  if PL[V].Kills <= 0 then
    Exit;
  AddPoints(V, -SkPoints);
  Players.BigText(SkLayer, ExText(SkText, PL[V].Name, '', SkPoints, 0, 0, 0), SkTicks, SkColor, SkScale, SkX, SkY);
end;

{ [Posthumous]: the victim drops a live grenade where he died, with a chance of one in
  ChanceFactor - his kills (a good player more often); his own grenade, so its kills are his }
procedure PosthumousKill(V: Integer);
var
  Cd, B: Integer;
  P: TActivePlayer;
begin
  P := PL[V];
  if PhGround then
    if not P.OnGround then
      Exit;
  Cd := PhFactor - P.Kills;
  if Cd < 1 then
    Cd := 1;
  if Random(0, Cd) <> 0 then
  begin
    if PhNoText <> '' then
      Say(V, PhNoText, PhColor);
    Exit;
  end;
  if BulletRoom(1) then
  begin
    AcSkip[V] := Game.TickCount;
    B := ScriptBullet(P.X, P.Y - 30, 0, 0, PhPower, PhStyle, P);
    if (B >= 1) and (B <= 255) then
    begin
      PhBulOwner[B] := V;
      PhBulTick[B] := Game.TickCount;
    end;
  end;
  if PhText <> '' then
    Say(V, PhText, PhColor);
end;

{ [TimeToKill], once a second: when exactly AlivePlayers are alive a countdown starts; at 0 they all
  die (the server's own kill: no suicide penalty) }
procedure TimeToKillSecond(Tick: Integer);
var
  i, n: Integer;
begin
  { a pause or a map change: the countdown waits }
  if PausedNow or MapChanging then
    Exit;
  n := 0;
  if Game.Survival then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if TeamOf[i] <> TEAM_SPECTATOR then
          if PL[i].Alive then
            n := n + 1;
  if n <> TkAlive then
  begin
    if TkLeft > 0 then
      Players.BigText(TkLayer, ' ', 1, ColorGood, 0.01, 0, 0);
    TkLeft := 0;
    Exit;
  end;
  if TkLeft = 0 then
    TkLeft := TkSeconds + 1;
  TkLeft := TkLeft - 1;
  if TkLeft > 0 then
  begin
    Players.BigText(TkLayer, ExText(TkText, '', '', 0, 0, TkLeft, 0), 120, TkColor, TkScale, TkX, TkY);
    Exit;
  end;
  Players.BigText(TkLayer, ' ', 1, ColorGood, 0.01, 0, 0);
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] <> TEAM_SPECTATOR then
        if PL[i].Alive then
        begin
          ServerKill[i] := Tick;
          { [Downed]: a kill, not a down (a vest would leave the blow under the server's own) }
          DwKilling[i] := Tick;
          DwKillingAny := DwKillingAny + 1;
          PL[i].Health := 1;
          PL[i].Damage(i, 4000);
        end;
end;

{ [Medic], once a second. Mode = class: the medic of a team (!medic takes the job) heals the hurt
  team mates within Distance and gets a kill point for every PointEvery health he gave. Mode = call:
  a hurt player (or one next to a hurt team mate) calls the medic with !medic; he heals himself and
  those around him while anybody there is hurt, then the team waits CooldownSeconds. }
procedure MedicSecond();
var
  t, m, j: Integer;
  P, Q: TActivePlayer;
  Mx, My, H, Add, Cap, DX, DY: Single;
  Healed: Boolean;
begin
  Cap := MaxHealth;
  for t := 1 to 4 do
  begin
    { the wait after a called medic (it does not run while one is healing) }
    if MdCool[t] > 0 then
      if MdOf[t] = 0 then
      begin
        MdCool[t] := MdCool[t] - 1;
        if MdCool[t] = 0 then
          for j := 1 to TopSlot do
            if MdWants[j] then
              if TeamOf[j] = t then
              begin
                MdWants[j] := False;
                Say(j, 'The medic is there again (!medic).', MdColor);
              end;
      end;
    m := MdOf[t];
    if m < 1 then
      Continue;
    P := PL[m];
    if (not ActiveSlot[m]) or (TeamOf[m] <> t) then
    begin
      MdOf[t] := 0;
      if MdCall then
        MdCool[t] := MdCooldown;
      Continue;
    end;
    if not P.Alive then
    begin
      { a called medic who died ends the call; the team waits }
      if MdCall then
      begin
        MdOf[t] := 0;
        MdCool[t] := MdCooldown;
      end;
      Continue;
    end;
    { [Downed]: lying there he heals nobody }
    if DwDown[m] then
      Continue;
    Mx := P.X;
    My := P.Y;
    Healed := False;
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if TeamOf[j] = t then
        begin
          Q := PL[j];
          if Q.Alive then
          begin
            DX := Q.X - Mx;
            DY := Q.Y - My;
          end;
          if Q.Alive and (not DwDown[j]) then
            if DX * DX + DY * DY <= MdDist * MdDist then
            begin
              H := Q.Health;
              if H < Cap - 0.01 then
              begin
                Add := MdRate;
                if H + Add > Cap then
                  Add := Cap - H;
                Q.Health := H + Add;
                LastHealth[j] := H + Add;
                { [Bleeding]: a medic closes the grazes and gives blood }
                if BdActive then
                  BE_BodyHeal(j, BC_HEALED, 2);
                HudMarkL(j, HLB_HEALTH or HLB_BLOOD);
                Healed := True;
                if not MdCall then
                  if j <> m then
                  begin
                    MdGiven[t] := MdGiven[t] + Add;
                    if MdPointEvery > 0 then
                      if MdGiven[t] >= MdPointEvery then
                      begin
                        MdGiven[t] := 0;
                        if Opposed(m) then
                        begin
                          AddPoints(m, 1);
                          Say(m, 'You got 1 point for healing.', MdColor);
                        end;
                      end;
                  end;
              end;
            end;
        end;
    { a called medic leaves when nobody near him is hurt; then the team waits CooldownSeconds }
    if MdCall then
      if not Healed then
      begin
        MdOf[t] := 0;
        MdCool[t] := MdCooldown;
      end;
  end;
end;

{ !medic }
procedure CmdMedic(ID: Integer);
var
  t, j: Integer;
  Hurt2: Boolean;
  X, Y, DX, DY: Single;
begin
  if not MdEnabled then
  begin
    Say(ID, 'There is no medic on this server.', ColorBad);
    Exit;
  end;
  { [Classes]: the medics are a class here }
  if ClsActive and ClsAnyHeal then
  begin
    Say(ID, 'The medics are a class here: !classes, !class <name>.', ColorBad);
    Exit;
  end;
  t := TeamOf[ID];
  if t = 0 then
  begin
    Say(ID, 'The medic works in the team games only.', ColorBad);
    Exit;
  end;
  if (t < 0) or (t > 4) then
  begin
    Say(ID, 'Join a team first.', ColorBad);
    Exit;
  end;
  if not MdCall then
  begin
    if MdOf[t] = ID then
    begin
      MdOf[t] := 0;
      Say(ID, 'You are not the medic of your team any more.', MdColor);
      for j := 1 to TopSlot do
        if j <> ID then
          if ActiveSlot[j] then
            if TeamOf[j] = t then
              Say(j, 'Your team has no medic: !medic takes the job.', MdColor);
    end
    else if MdOf[t] = 0 then
    begin
      MdOf[t] := ID;
      MdGiven[t] := 0;
      Say(ID, 'You are the medic of your team: you heal the team mates near you and get points for it.', MdColor);
    end
    else
      Say(ID, 'The medic of your team is ' + PL[MdOf[t]].Name + '.', MdColor);
    Exit;
  end;
  { call mode }
  if MdOf[t] > 0 then
  begin
    Say(ID, 'The medic is healing at ' + PL[MdOf[t]].Name + ' now.', MdColor);
    Exit;
  end;
  if MdCool[t] > 0 then
  begin
    MdWants[ID] := True;
    Say(ID, 'The medic gathers supplies: wait ' + IntToStr(MdCool[t]) + ' seconds.', MdColor);
    Exit;
  end;
  Hurt2 := False;
  if PL[ID].Alive then
  begin
    X := PL[ID].X;
    Y := PL[ID].Y;
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if TeamOf[j] = t then
          if PL[j].Alive then
            if PL[j].Health < MaxHealth - 0.01 then
            begin
              DX := PL[j].X - X;
              DY := PL[j].Y - Y;
              if DX * DX + DY * DY <= MdDist * MdDist then
                Hurt2 := True;
            end;
  end;
  if not Hurt2 then
  begin
    Say(ID, 'Nobody near you is hurt.', ColorBad);
    Exit;
  end;
  MdOf[t] := ID;
  Say(ID, 'The medic is coming: they heal you and your team mates near you.', MdColor);
end;

{ [Reservation]: the last Slots slots are kept for the players of File (Steam ids or IPs; with
  AdminsToo those of [Admin] Steam-N too). Somebody else who takes one of them is kicked - once
  his Steam id is known (at the join or up to 8 seconds later). }
function ResReserved(ID: Integer): Boolean;
begin
  Result := False;
  if SteamId[ID] <> '' then
  begin
    if RsList.IndexOf(SteamId[ID]) >= 0 then
      Result := True;
    if RsAdmins then
      if AdSteams.IndexOf(SteamId[ID]) >= 0 then
        Result := True;
  end;
  if RsList.IndexOf(PL[ID].IP) >= 0 then
    Result := True;
end;

procedure ResCheck(ID: Integer; Final: Boolean);
var
  i, n: Integer;
begin
  RsWait[ID] := 0;
  if not RsEnabled then
    Exit;
  if not PL[ID].Human then
    Exit;
  { the server's admins (remote.txt) always get in }
  if PL[ID].IsAdmin then
    Exit;
  { the players count, not the bots (a bot's slot is free for a player) }
  n := 0;
  for i := 1 to TopSlot do
    if PL[i].Active then
      if PL[i].Human then
        n := n + 1;
  if n <= Game.MaxPlayers - RsSlots then
    Exit;
  if ResReserved(ID) then
    Exit;
  { the Steam id may still come }
  if SteamId[ID] = '' then
    if not Final then
    begin
      RsWait[ID] := After(Game.TickCount, 480);
      Exit;
    end;
  Say(ID, ReplaceAll(RsText, '{slots}', IntToStr(RsSlots)), ColorBad);
  Log(PL[ID].Name + ' kicked: a reserved slot ([Reservation])');
  ScheduleBan(ID, 0, '');
end;

procedure ResSecond(Tick: Integer);
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if RsWait[i] > 0 then
      if Tick >= RsWait[i] then
        if ActiveSlot[i] then
          ResCheck(i, True)
        else
          RsWait[i] := 0;
end;

{ ================================ logger ================================ }

{ [Logger]: one file a day in Folder (yyyy-mm-dd.txt), written by the library's thread; a watched
  player (Steam id, IP or name of Watch-N) also gets his own file in Folder/watched. A password
  typed after /adminlog is never written. }
procedure LogLine(ID: Integer; Text: string);
var
  F: string;
begin
  if not LgEnabled then
    Exit;
  if not BeOk then
    Exit;
  F := '';
  if (ID >= 1) and (ID <= 32) then
    if LgWatched[ID] then
      F := LgWatchName[ID];
  BE_LogStamp(PChar(LgFolder), PChar(Text), PChar(F));
end;

{ a file name out of a player name: letters, digits, - and _ stay }
function SafeName(S: string): string;
var
  i: Integer;
  C: string;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    C := Copy(S, i, 1);
    if ((C >= 'a') and (C <= 'z')) or ((C >= 'A') and (C <= 'Z')) or ((C >= '0') and (C <= '9')) or (C = '-') or
      (C = '_') then
      Result := Result + C
    else
      Result := Result + '_';
  end;
  if Result = '' then
    Result := 'player';
end;

{ is the player watched (Watch-N): by Steam id, IP or name }
procedure LogWatchCheck(ID: Integer);
begin
  LgWatched[ID] := False;
  if not LgEnabled then
    Exit;
  if not PL[ID].Human then
    Exit;
  if SteamId[ID] <> '' then
    if LgWatch.IndexOf(SteamId[ID]) >= 0 then
      LgWatched[ID] := True;
  if LgWatch.IndexOf(PL[ID].IP) >= 0 then
    LgWatched[ID] := True;
  if LgWatch.IndexOf(LowerCase(PL[ID].Name)) >= 0 then
    LgWatched[ID] := True;
  if SteamId[ID] <> '' then
    LgWatchName[ID] := SteamId[ID]
  else
    LgWatchName[ID] := SafeName(PL[ID].Name);
end;

{ a command as the log shows it: the arguments of the commands of [Logger] HideArgs (passwords) are left out }
function LogCommand(Text: string): string;
var
  W: string;
begin
  Result := Trim(Text);
  W := LowerCase(FirstWord(Result));
  if W <> '' then
    if (Copy(W, 1, 1) = '/') or (Copy(W, 1, 1) = '!') then
      Delete(W, 1, 1);
  if W <> '' then
    if Pos('|' + W + '|', '|' + LgHideArgs + '|') > 0 then
      Result := FirstWord(Result) + ' ***';
end;

function TeamName(T: Integer): string;
begin
  case T of
    0: Result := 'the game';
    1: Result := 'Alpha';
    2: Result := 'Bravo';
    3: Result := 'Charlie';
    4: Result := 'Delta';
    5: Result := 'the spectators';
  else
    Result := 'team ' + IntToStr(T);
  end;
end;

{ [Tips]: a message may come when its weight is above 0 and its own shortest time is over }
function TipOk(i, Tick: Integer): Boolean;
begin
  Result := False;
  if TiWeight[i] <= 0 then
    Exit;
  if TiGap[i] > 0 then
    if TiLast[i] <> 0 then
      if Tick - TiLast[i] < TiGap[i] then
        Exit;
  Result := True;
end;

{ one message by weight, not the last one again while there is another; 0 = none may come now }
function TipPick(Tick: Integer): Integer;
var
  i, Sum, Cand, R, Skip: Integer;
begin
  Result := 0;
  Cand := 0;
  for i := 1 to TiCount do
    if TipOk(i, Tick) then
      Cand := Cand + 1;
  if Cand = 0 then
    Exit;
  Skip := 0;
  if Cand > 1 then
    Skip := TiPrev;
  Sum := 0;
  for i := 1 to TiCount do
    if i <> Skip then
      if TipOk(i, Tick) then
        Sum := Sum + TiWeight[i];
  if Sum <= 0 then
    Exit;
  R := Random(0, Sum);
  for i := 1 to TiCount do
    if i <> Skip then
      if TipOk(i, Tick) then
      begin
        R := R - TiWeight[i];
        if R < 0 then
        begin
          Result := i;
          Exit;
        end;
      end;
end;

{ ================================ commands ================================ }

procedure ShowList(ID: Integer; List: TStringList; Colors: Boolean; Color: Longint; Pad: Integer; ToAll: Boolean);
var
  i, p: Integer;
  S: string;
  C: Longint;
begin
  for i := 0 to List.Count - 1 do
  begin
    S := List[i];
    C := Color;
    if Colors then
    begin
      p := Pos(#9, S);
      if p > 0 then
      begin
        C := StrToIntDef(Trim(Copy(S, 1, p - 1)), Color);
        S := Copy(S, p + 1, Length(S));
      end;
    end;
    SayTo(ID, ToAll, PadTo(S, Pad), C);
  end;
end;

function TargetOf(ID: Integer; Args: string): Integer;
begin
  if Trim(Args) = '' then
    Result := ID
  else
    Result := FindPlayer(Args);
end;

procedure CmdRatio(ID: Integer; Args: string);
var
  T, K, D: Integer;
  P: TActivePlayer;
  R: Single;
begin
  T := TargetOf(ID, Args);
  if T < 1 then
  begin
    Say(ID, 'Player not found (' + Args + ')', ColorBad);
    Exit;
  end;
  P := PL[T];
  if P.Team = TEAM_SPECTATOR then
  begin
    SayTo(ID, RaPublic, P.Name + ' - is spectating', ColorBad);
    Exit;
  end;
  K := P.Kills;
  D := P.Deaths;
  if D = 0 then
    SayTo(ID, RaPublic, P.Name + ' - K/D is incalculable (' + IntToStr(K) + '/0) with ' + IntToStr(P.Flags) + ' caps.',
      ColorBad)
  else
  begin
    R := K;
    R := R / D;
    SayTo(ID, RaPublic, P.Name + ' - K/D is ' + FloatStr(R, 2) + ' (' + IntToStr(K) + '/' + IntToStr(D) + ') with ' +
      IntToStr(P.Flags) + ' caps.', ColorGood);
  end;
end;

procedure CmdPing(ID: Integer; Args: string);
var
  T: Integer;
begin
  T := TargetOf(ID, Args);
