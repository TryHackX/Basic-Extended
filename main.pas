procedure OnSpeakEv(Player: TActivePlayer; Text: string);
var
  S: string;
  Wanted: Boolean;
begin
  S := Trim(Text);
  if Length(S) > 1 then
    if S[1] = '^' then
      Delete(S, 1, 1);
  if LgEnabled then
    if LgChat then
      LogLine(Player.ID, Player.Name + ': ' + LogCommand(Text));
  if SqActive then
    SqLine(Player.ID, S, Game.TickCount);
  Wanted := False;
  if Length(S) > 1 then
    if (S[1] = '!') or (S[1] = '?') then
      Wanted := True;
  if not Wanted then
    if ChEnabled then
      Wanted := ExecRegExpr(ChPattern, LowerCase(S));
  if Wanted then
    QueueText(Player.ID, SRC_CHAT, Text);
end;

{ a command typed by a player: run on the next tick. True keeps the server from running it itself
  (Soldat's own /info when [Info] HideSoldatInfo = 1). }
function OnCommandEv(Player: TActivePlayer; Command: string): Boolean;
var
  ID, Cmd: Integer;
begin
  Result := False;
  if LgEnabled then
    if LgCommands then
      LogLine(Player.ID, Player.Name + ' command: ' + LogCommand(Command));
  ID := Player.ID;
  { [AntiSpam] CountCommands: a command counts as a line }
  if SqActive then
    if SqCommands then
      SqLine(ID, Command, Game.TickCount);
  Cmd := SlashCommandId(Command);
  if Cmd = 0 then
    Exit;
  if (SeenTick[ID] = Game.TickCount) and (SeenText[ID] = Command) then
    Exit;
  SeenTick[ID] := Game.TickCount;
  SeenText[ID] := Command;
  QueueText(ID, SRC_COMMAND, Command);
  if Cmd = C_INFO then
    Result := InHide;
  if AdSuppress(Cmd, Command, False) then
    Result := True;
end;

{ Player = nil: the server console or a TCP admin. An admin in the game sends the same command
  through OnCommand as well; the second copy is skipped. }
function OnAdminCommandEv(Player: TActivePlayer; Command: string): Boolean;
var
  ID, Cmd: Integer;
begin
  Result := False;
  if BeOk then
    LoadWepSeen(Command);
  if LgEnabled then
    if LgAdmins then
      if Player = nil then
        LogLine(0, 'console/TCP admin: ' + LogCommand(Command));
  Cmd := SlashCommandId(Command);
  if Cmd < C_FIRST_ADMIN then
    Exit;
  if Player = nil then
  begin
    QueueText(0, SRC_CONSOLE, Command);
    Result := AdSuppress(Cmd, Command, True);
    Exit;
  end;
  ID := Player.ID;
  if (SeenTick[ID] = Game.TickCount) and (SeenText[ID] = Command) then
    Exit;
  SeenTick[ID] := Game.TickCount;
  SeenText[ID] := Command;
  QueueText(ID, SRC_COMMAND, Command);
end;

{ [TeamKill]: a bullet that is not his aimed fire at a mate - a mine's or claymore's blast, this script's kill of a
  downed or bleeding soldier, a class skill's (mortar, barrage, gunship, C4), a posthumous grenade, a vest's blast;
  the same rule for the damage and for the kill }
function FfSkipBullet(B, Owner, V: Integer): Boolean;
begin
  Result := True;
  if MnBulletKind(B, Owner) <> 0 then
    Exit;
  if LfOwnBullet(B, V) then
    Exit;
  if ClsBullet(B, Owner) then
    Exit;
  if (B >= 1) and (B <= 255) then
    if PhBulOwner[B] = Owner then
      if Game.TickCount - PhBulTick[B] <= 240 then
        Exit;
  if Owner > 0 then
    if InsBulletOf(B) = Owner then
      Exit;
  Result := False;
end;

function OnDamageRun(Shooter, Victim: TActivePlayer; Damage: Single; BulletId: Byte): Single;
var
  S, V, Tick: Integer;
  H, Shown: Single;
  Show, Count: Boolean;
begin
  Result := Damage;
  if Damage <= 0 then
  begin
    { [Bleeding]: a healing polygon (the game's -2 on himself every 12 ticks) closes grazes, gives blood }
    if Damage < 0 then
      if BdActive then
        if Shooter.ID = Victim.ID then
          if not InTick then
            BE_BodyHeal(Victim.ID, BC_HEALED, 0.3);
    Exit;
  end;
  V := Victim.ID;
  S := Shooter.ID;
  Tick := Game.TickCount;
  { [FlashNades]: a flash's explosion (not a Player.Damage of this script's own tick) does the flash's
    damage instead of a grenade's }
  if FnEnabled then
    if not InTick then
      if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
        if Damage <= SERVER_HIT_DAMAGE then
        begin
          if FnSlotOf[BulletId] = 0 then
            FnLate(BulletId, Shooter, Tick);
          if FnSlotOf[BulletId] > 0 then
          begin
            Damage := FnHit(Victim, S, BulletId, Damage, Tick);
            Result := Damage;
            if Damage <= 0 then
              Exit;
          end;
        end;
  { /god: no damage at all (the server's own kills still go through) }
  if GodOn[V] then
    if Damage <= SERVER_HIT_DAMAGE then
    begin
      Result := 0;
      Exit;
    end;
  { [SpawnProtection]: no damage from the others for a moment after the respawn, none by the protected
    (NoDamageDealt); the server's own blows and this script's kill bullets still go through }
  if SfCount > 0 then
    if S <> V then
      if Damage <= SERVER_HIT_DAMAGE then
        if not LfOwnBullet(BulletId, V) then
          if SfHit(S, V, BulletId, Tick) then
          begin
            Result := 0;
            Exit;
          end;
  if DmAny then
    if S <> V then
      if Damage <= SERVER_HIT_DAMAGE then
        Result := Damage * DmOut[S] * DmIn[V];
  { [Classes]: the damage perks and the armor }
  if ClsActive then
    if ClsDmgAny then
      if S <> V then
        if Damage <= SERVER_HIT_DAMAGE then
          Result := Result * ClsDamageFactor(S, V, Shooter);
  if AbOn[S] then
    if AbKeyOf(Shooter) = AK_FIRE then
      if S <> V then
        if (BulletId >= 1) and (BulletId <= 254) then
          if (AbBulletOwner[BulletId] <> S) or (Tick - AbBulletTick[BulletId] > 600) then
          begin
            Result := 0;
            Exit;
          end;
  { [TeamKill]: a hit on a team mate (how meant; blocked while his fire at the team is) }
  FfCurFriendly := False;
  if FfActive then
    if S <> V then
      if Damage <= SERVER_HIT_DAMAGE then
        if FfMates(S, V) then
          if not FfSkipBullet(BulletId, S, V) then
            Result := FfFriendlyHit(Victim, S, V, Result, BulletId, Tick);
  if Result <= 0 then
    Exit;
  if AcOn then
    if BeOk then
      if S <> V then
        if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
          if Damage <= SERVER_HIT_DAMAGE then
            if Shooter.Human or DebugBots then
              AcDamage(S, V, Tick, BulletId, Shooter);
  if Damage > SERVER_HIT_DAMAGE then
    ServerKill[V] := Tick;
  if S = V then
    if BulletId = NO_BULLET then
      if Abs(Damage - PKILL_DAMAGE) < 0.5 then
        ServerKill[V] := Tick;
  { [Bleeding], [Downed], the survival carry-over: a wound, a lethal hit that puts him down, the round's end }
  Result := LfOnDamage(Shooter, Victim, S, V, Result, Damage, BulletId, Tick);
  if Result <= 0 then
    Exit;
  { [Savior]: whom this player attacked last }
  if SvEnabled then
    if S <> V then
      if Enemies(S, V) then
      begin
        SvTarget[S] := V;
        SvTick[S] := Tick;
      end;
  { regeneration waits again, the health display shows the new value on the next tick }
  LastHit[V] := Tick;
  if Regenerating[V] then
    Regenerating[V] := False;
  if RegEnabled then
    if Victim.Human or RegBots then
      Hurt[V] := True;
  HudMarkL(V, HLB_HEALTH);
  if EdOn[V] then
    EditorStop(V, True);
  { damage numbers: only for a human shooter who wants them; own falls, polygons and /kill have no
    bullet and are not shown; the server's own kills count nowhere }
  Show := DmgEnabled;
  { C14: this script's kill of a downed or bleeding soldier (its last health point) is no hit to show }
  if Show then
    if LfOwnBullet(BulletId, V) then
      Show := False;
  if Show then
    if not Shooter.Human then
      if not DebugBots then
        Show := False;
  if Show then
    if not DmgIsOn(S) then
      Show := False;
  if Show then
    if S = V then
      if (not DmgShowSelf) or (BulletId = NO_BULLET) then
        Show := False;
  Count := True;
  if Damage > SERVER_HIT_DAMAGE then
  begin
    Show := False;
    Count := False;
  end;
  H := Victim.Health;
  if H < 0 then
    H := 0;
  { the hit before this one on the same player took what is gone since then }
  if VicPend[V] then
    DmgSettle(V, VicLastBefore[V] - H)
  else if VicCount < 32 then
  begin
    VicPend[V] := True;
    VicList[VicCount] := V;
    VicCount := VicCount + 1;
  end;
  VicLastS[V] := S;
  FfLastFriendly[V] := FfCurFriendly;
  FfLastIntent[V] := FfCurIntent;
  FfLastReason[V] := FfCurReason;
  VicLastBefore[V] := H;
  VicLastCount[V] := Count;
  VicLastShow[V] := False;
  if Show then
  begin
    VicLastX[V] := Victim.X;
    VicLastY[V] := Victim.Y;
    if DmgTaken then
      VicLastShow[V] := True
    else
    begin
      { Amount = hit: the damage the hit carried, as Soldat gave it to this script }
      Shown := Damage;
      if DmgPercent then
        Shown := Shown * 100 / MaxHealth;
      DmgAdd(S, V, Shown, VicLastX[V], VicLastY[V]);
    end;
  end;
end;

function OnDamageEv(Shooter, Victim: TActivePlayer; Damage: Single; BulletId: Byte): Single;
begin
  if ProfOn then
    BE_ProfBegin(27);
  Result := Damage;
  try
    Result := OnDamageRun(Shooter, Victim, Damage, BulletId);
    { [Shop]: an explosive AP round's blast at the soldier; the place of a killing hit (HeadshotMoney) }
    if ShActive then
      if Shooter.ID <> Victim.ID then
      begin
        if ShApCount + ShApLeft[Shooter.ID] > 0 then
          ShApHit(Shooter.ID, Victim.ID, BulletId, Result > 0);
        if Result > 0 then
          if Result >= Victim.Health then
            ShLethal(Victim.ID, BulletId);
      end;
    { [Points]: whom he attacked last (savior), the place of a killing hit (a headshot) }
    if BpActive then
      if Result > 0 then
        BpHit(Shooter.ID, Victim.ID, BulletId, Game.TickCount, Result >= Victim.Health);
    { [Classes] leech: health back for a hit on an enemy }
    if ClsActive then
      if Result > 0 then
        if Shooter.ID <> Victim.ID then
          ClsLeechHit(Shooter.ID, Victim.ID);
    { [Insurgents]: the place of a killing hit on a vest that counts down (a headshot stops it) }
    if InsActive then
      if Result >= Victim.Health then
        if InsArmAt[Victim.ID] > 0 then
          if BeOk then
            if (BulletId >= 1) and (BulletId <= 254) then
              InsHitPart[Victim.ID] := BE_BodyHitPart(Victim.ID, BL[BulletId].Style, BL[BulletId].X, BL[BulletId].Y,
                BL[BulletId].VelX, BL[BulletId].VelY);
  except
    StageError('damage');
  end;
  if ProfOn then
    BE_ProfEnd(27);
end;

{ the killing shot as "You killed" shows it: metres from where the bullet counts as fired to where it
  is now, seconds since then (the bridge reads its Initial and StartUpTime; '?' when unknown) }
procedure KillShot(B, Tick: Integer; var Dist, Air: string);
var
  OX, OY, DX, DY: Single;
  OT: Integer;
begin
  Dist := '?';
  Air := '?';
  if not BeOk then
    Exit;
  if (B < 1) or (B > MAX_BULLET_ID) then
    Exit;
  OX := 0;
  OY := 0;
  OT := 0;
  if BE_BulletOrigin(B, OX, OY, OT) <> 1 then
    Exit;
  if (OT > Tick) or (Tick - OT > 36000) then
    Exit;
  DX := BL[B].X - OX;
  DY := BL[B].Y - OY;
  Dist := FloatStr(Sqrt(DX * DX + DY * DY) / 14, 2);
  Air := FloatStr((Tick - OT) / 60.0, 2);
end;

procedure OnKillRun(Killer, Victim: TActivePlayer; BulletId: Byte);
var
  K, V, Tick, W, MnK: Integer;
  S, Wep, DS, KDist, KAir: string;
  Dealt2, KH: Single;
  RE: Boolean;
begin
  K := Killer.ID;
  V := Victim.ID;
  Tick := Game.TickCount;
  { the survival round's end (the server's hit on the survivors), the same test for every module }
  RE := Game.Survival and (K = V) and (CyRoundHit[V] = Tick) and (not MapChanging);
  { [Bleeding], [Downed], [Bounty], the survival carry-over }
  LfOnKill(K, V, Tick);
  { [Shop]: the killer's money, a death's losses, the end of a survival round }
  if ShActive then
  begin
    ShKill(K, V, BulletId, Tick, RE);
    if ShBuyOnly then
      if Game.Advance then
      begin
        ShMaskForce(K);
        ShMaskForce(V);
      end;
  end;
  { [Insurgents]: a vest's kill, a bomber killed while it counted down }
  if InsActive or (InsQN > 0) then
    InsOnKill(K, V, BulletId, Tick);
  { [Classes]: the class of his next life, a rally; a survival round's end; [Points] }
  if ClsActive or BpActive then
  begin
    if ClsActive then
    begin
      ClsOnKill(V, Tick, RE);
      if RE then
        if ClsRoundDone <> Tick then
        begin
          ClsRoundDone := Tick;
          ClsRoundOver(V);
        end;
    end;
    if BpActive then
      if not RE then
        BpKill(K, V, Tick, BulletId, not FfSkipBullet(BulletId, K, V));
  end;
  { [Spotting]: the spots on him go now ([Points] SpotKill has read them) }
  SgClearSpots(V);
  { [TeamKill]: he is dead for the library's eyes; a team kill }
  FfPlayerSync(V, False);
  if FfActive then
    if K <> V then
      if FfMates(K, V) then
        if not FfSkipBullet(BulletId, K, V) then
          FfKill(K, V, BulletId, Tick);
  { this script's kill bullet has done its work: its slot is free again }
  if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
    if DwKillB[BulletId] = V then
      DwKillB[BulletId] := 0;
  { [Mines]: a kill by a mine or a claymore (told); the kills towards the next ones (KillStreak: a death
    starts again) }
  MnK := 0;
  if MnEnabled then
  begin
    if K <> V then
      MnK := MnBulletKind(BulletId, K);
    if MnK > 0 then
      MnKillTell(K, V, MnK);
    if MnActive then
    begin
      if K <> V then
        if Enemies(K, V) then
          MnKillReward(K, MnK);
      { H16: the round's end is no death for the streak either }
      if MnStreak then
        if not RE then
        begin
          MnProgM[V] := 0;
          MnProgC[V] := 0;
        end;
      MnWork[V] := 0;
    end;
  end;
  Hurt[V] := False;
  Regenerating[V] := False;
  HudMark(V, False);
  if EdOn[V] then
    EditorStop(V, False);
  if AmmoEnabled then
  begin
    AmBody[V] := LootBodyNow();
    BE_AmmoSetBodyMode(BoolInt(AmBody[V]));
    AmCorpseW[V] := BE_AmmoDeath(V, Tick, Victim.X, Victim.Y);
    AmCorpseN := AmCorpseN + 1;
    AmCorpseT[V] := Tick;
    AmCorpseX[V] := Victim.X;
    AmCorpseY[V] := Victim.Y;
    AmSetLastW(V, -1);
    AmLastSW[V] := -1;
  end;
  if DmgEnabled then
    if K <> V then
      if Killer.Human or DebugBots then
        if DmgIsOn(K) then
          DmgKill(K, V, Tick);

  if KiEnabled then
    if K <> V then
      if Victim.Human then
      begin
        Wep := 'unknown';
        if (BulletId >= 1) and (BulletId <= MAX_BULLET_ID) then
          if BL[BulletId].Owner = K then
          begin
            W := BL[BulletId].GetOwnerWeaponId;
            Wep := WeaponName(W);
          end;
        if Wep = 'unknown' then
          Wep := Killer.Primary.Name;
        if MnK > 0 then
        begin
          Wep := MnKindName(MnK);
          Wep := UpperCase(Copy(Wep, 1, 1)) + Copy(Wep, 2, Length(Wep));
        end;
        { the damage he did to the killer in the killer's current fight (reset when the killer
          respawns or starts to regenerate), never more than a full health }
        Dealt2 := Dealt[V][K];
        if Dealt2 > MaxHealth then
          Dealt2 := MaxHealth;
        KH := Killer.Health;
        if DmgPercent then
          DS := IntToStr(Round(Dealt2 * 100 / MaxHealth)) + '%'
        else
          DS := IntToStr(Round(Dealt2));
        KillShot(BulletId, Tick, KDist, KAir);
        if BeOk then
          S := BE_Fill(KiText, '{killer}'#1 + Killer.Name + #1'{weapon}'#1 + Wep + #1'{pct}'#1 +
            IntToStr(HealthPct(KH)) + #1'{hp}'#1 + IntToStr(Round(KH)) + #1'{dealt}'#1 + DS + #1'{dist}'#1 + KDist +
            #1'{air}'#1 + KAir)
        else
        begin
          S := KiText;
          S := ReplaceAll(S, '{killer}', Killer.Name);
          S := ReplaceAll(S, '{weapon}', Wep);
          S := ReplaceAll(S, '{pct}', IntToStr(HealthPct(KH)));
          S := ReplaceAll(S, '{hp}', IntToStr(Round(KH)));
          S := ReplaceAll(S, '{dealt}', DS);
          S := ReplaceAll(S, '{dist}', KDist);
          S := ReplaceAll(S, '{air}', KAir);
        end;
        Say(V, S, KiColor);
      end;

  if SrEnabled then
    SpreeKill(K, V, (K <> V) and Enemies(K, V), RE);
  if K <> V then
  begin
    if Enemies(K, V) then
    begin
      if FbEnabled then
        FirstBloodKill(K, V);
      if McEnabled then
        MultiKill(K, Tick);
      if SvEnabled then
        SaviorKill(K, V, Tick);
    end;
    if AsEnabled then
      AssistKill(K, V);
    if PhEnabled then
      PosthumousKill(V);
  end
  else if SkEnabled then
    if OwnSuicide(V, Tick) then
      SelfKillPenalty(V);
  McCount[V] := 0;
  if LgEnabled then
    if LgKills then
      LogLine(K, Killer.Name + ' killed ' + Victim.Name);
end;

