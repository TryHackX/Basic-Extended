{ ================================ text and number helpers ================================ }

procedure Log(Text: string);
begin
  WriteLn(TAG + Text);
end;

{ an error in one part of the tick is logged, and the other parts still run }
{ one more error at Where: how many there were there (ErrSeen: 'where=count') }
function ErrCount(Where: string): Integer;
var
  k: Integer;
begin
  Errors := Errors + 1;
  if ErrSeen = nil then
    ErrSeen := File.CreateStringList();
  k := ErrSeen.IndexOfName(Where);
  if k < 0 then
  begin
    ErrSeen.Add(Where + '=1');
    Result := 1;
    Exit;
  end;
  Result := StrToIntDef(Copy(ErrSeen[k], Pos('=', ErrSeen[k]) + 1, 12), 0) + 1;
  ErrSeen[k] := Where + '=' + IntToStr(Result);
end;

{ the places of the errors for /be_status ('' = none) }
function ErrSummary(): string;
var
  k: Integer;
begin
  Result := '';
  if ErrSeen = nil then
    Exit;
  for k := 0 to ErrSeen.Count - 1 do
    if k < 6 then
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + ErrSeen[k];
    end;
  if ErrSeen.Count > 6 then
    Result := Result + ', ...';
end;

procedure StageError(Where: string);
var
  n: Integer;
begin
  n := ErrCount(Where);
  if (n <= 3) or (n mod 1000 = 0) then
    Log('error in ' + Where + ' (' + IntToStr(n) + '): ' + ExceptionToString(ExceptionType, ExceptionParam));
end;

function BoolInt(B: Boolean): Integer;
begin
  Result := 0;
  if B then
    Result := 1;
end;

function BoolText(B: Boolean): string;
begin
  if B then
    Result := 'on'
  else
    Result := 'off';
end;

function ParseBool(S: string; Def: Boolean; var Ok: Boolean): Boolean;
var
  L: string;
begin
  L := LowerCase(Trim(S));
  Ok := True;
  Result := Def;
  if (L = '1') or (L = 'true') or (L = 'yes') or (L = 'on') then
    Result := True
  else if (L = '0') or (L = 'false') or (L = 'no') or (L = 'off') then
    Result := False
  else
    Ok := False;
end;

{ a number with a dot or a comma, whatever the decimal separator of the server's system is }
function ParseFloat(S: string; var Ok: Boolean): Single;
var
  i, Len, Digit: Integer;
  Neg, Dot, Digits: Boolean;
  Value, Divisor: Extended;
begin
  Result := 0;
  Ok := False;
  S := Trim(S);
  Len := Length(S);
  if Len = 0 then
    Exit;
  i := 1;
  Neg := False;
  if S[1] = '-' then
  begin
    Neg := True;
    i := 2;
  end
  else if S[1] = '+' then
    i := 2;
  Value := 0;
  Divisor := 1;
  Dot := False;
  Digits := False;
  while i <= Len do
  begin
    Digit := Ord(S[i]) - 48;
    if (Digit >= 0) and (Digit <= 9) then
    begin
      Digits := True;
      Value := Value * 10 + Digit;
      if Dot then
        Divisor := Divisor * 10;
    end
    else if (S[i] = '.') or (S[i] = ',') then
    begin
      if Dot then
        Exit;
      Dot := True;
    end
    else
      Exit;
    i := i + 1;
  end;
  if not Digits then
    Exit;
  Result := Value / Divisor;
  if Neg then
    Result := -Result;
  Ok := True;
end;

{ a number with a dot, whatever the decimal separator of the server's system is }
function FloatStr(V: Extended; Decimals: Integer): string;
var
  i, Scale, All, Frac: Integer;
  Neg: Boolean;
  S: string;
begin
  if BeOk then
  begin
    Result := BE_FloatStr(V, Decimals);
    Exit;
  end;
  Neg := V < 0;
  if Neg then
    V := -V;
  Scale := 1;
  for i := 1 to Decimals do
    Scale := Scale * 10;
  All := Round(V * Scale);
  Frac := All mod Scale;
  Result := IntToStr(All div Scale);
  if Decimals > 0 then
  begin
    S := IntToStr(Frac);
    while Length(S) < Decimals do
      S := '0' + S;
    Result := Result + '.' + S;
  end;
  if Neg then
    if All <> 0 then
      Result := '-' + Result;
end;

function ReplaceAll(S, Find, Repl: string): string;
var
  p, L: Integer;
begin
  if BeOk then
    if Pos(Find, S) = 0 then
    begin
      Result := S;
      Exit;
    end
    else if Find <> '' then
    begin
      Result := BE_Replace(S, Find, Repl);
      Exit;
    end;
  Result := '';
  L := Length(Find);
  if L = 0 then
  begin
    Result := S;
    Exit;
  end;
  p := Pos(Find, S);
  while p > 0 do
  begin
    Result := Result + Copy(S, 1, p - 1) + Repl;
    Delete(S, 1, p + L - 1);
    p := Pos(Find, S);
  end;
  Result := Result + S;
end;

{ lines shorter than Width are filled with spaces: the client then draws the console line smaller }
function PadTo(S: string; Width: Integer): string;
begin
  Result := S;
  if Width <= 0 then
    Exit;
  while Length(Result) + 10 <= Width do
    Result := Result + '          ';
  while Length(Result) < Width do
    Result := Result + ' ';
end;

function FirstWord(S: string): string;
var
  p: Integer;
begin
  p := Pos(' ', S);
  if p = 0 then
    Result := S
  else
    Result := Copy(S, 1, p - 1);
end;

function AfterFirstWord(S: string): string;
var
  p: Integer;
begin
  p := Pos(' ', S);
  if p = 0 then
    Result := ''
  else
    Result := Trim(Copy(S, p + 1, Length(S)));
end;

function MixColor(A, B: Longint; T: Single): Longint;
var
  ar, ag, ab, br, bg, bb: Integer;
begin
  if BeOk then
  begin
    Result := BE_MixColor(A, B, T);
    Exit;
  end;
  if T < 0 then
    T := 0;
  if T > 1 then
    T := 1;
  ar := (A shr 16) and 255;
  ag := (A shr 8) and 255;
  ab := A and 255;
  br := (B shr 16) and 255;
  bg := (B shr 8) and 255;
  bb := B and 255;
  Result := (Round(ar + (br - ar) * T) shl 16) or (Round(ag + (bg - ag) * T) shl 8) or
    Round(ab + (bb - ab) * T);
end;

