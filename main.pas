{ the order of the list: the categories in turn, in each the items by their number }
function ShNth(n: Integer): Integer;
var
  Cat, It, k: Integer;
begin
  Result := -1;
  if n < 1 then
    Exit;
  k := 0;
  for Cat := 1 to 4 do
    for It := 0 to IT_LAST do
      if ShCat[It] = Cat then
        if ShListed(It) then
        begin
          k := k + 1;
          if k = n then
          begin
            Result := It;
            Exit;
          end;
        end;
end;

{ the item a word or a number of the list means; -1 = none }
function ShItemOf(Word: string): Integer;
var
  W: string;
  It, n: Integer;
begin
  Result := -1;
  W := LowerCase(Trim(Word));
  if W = '' then
    Exit;
  n := StrToIntDef(W, 0);
  if n > 0 then
  begin
    Result := ShNth(n);
    Exit;
  end;
  for It := 0 to IT_LAST do
    if Pos('|' + W + '|', ShWords[It]) > 0 then
    begin
      Result := It;
      Exit;
    end;
end;

{ the name of a category of the list }
function ShCatName(Cat: Integer): string;
begin
  case Cat of
    1: Result := 'Weapons';
    2: Result := 'Ammo';
    3: Result := 'Equipment';
  else
    Result := 'Special';
  end;
end;

{ where he may buy: anywhere, near his team's spawn points, near his flag }
function ShInZone(ID: Integer): Boolean;
var
  i, Tm: Integer;
  DX, DY, R2: Single;
  Spawns: Boolean;
begin
  Result := True;
  if ShWhere = 0 then
    Exit;
  Result := False;
  Tm := TeamOf[ID];
  R2 := ShBuyRadius * ShBuyRadius;
  { F18: BuyWhere = base without a flag base of his team (a mode without flags, Charlie and Delta): his spawn points }
  Spawns := ShWhere = 1;
  if not Spawns then
  begin
    Spawns := True;
    if (Tm >= 1) and (Tm <= 2) then
      if MnBaseOk[Tm] then
        Spawns := False;
  end;
  if Spawns then
  begin
    for i := 0 to MnSpCount - 1 do
      if (MnSpTeam[i] = Tm) or (MnSpTeam[i] = 0) then
      begin
        DX := PL[ID].X - MnSpX[i];
        DY := PL[ID].Y - MnSpY[i];
        if DX * DX + DY * DY <= R2 then
          Result := True;
      end;
    { without such points on the map: anywhere }
    if not Result then
      if MnSpCount = 0 then
        Result := True;
  end
  else
  begin
    DX := PL[ID].X - MnBaseX[Tm];
    DY := PL[ID].Y - MnBaseY[Tm];
    Result := DX * DX + DY * DY <= R2;
  end;
end;

{ the stationary gun of the shop (its object id; 0 = none) }
function ShSpawnStat(X, Y: Single): Integer;
var
  O: TNewMapObject;
  A: TActiveMapObject;
begin
  Result := 0;
  if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
    Exit;
  O := TNewMapObject.Create;
  try
    O.Style := 27;
    O.X := X;
    O.Y := Y;
    A := Map.AddObject(O);
    if A <> nil then
      if (A.ID >= 1) and (A.ID <= MAX_OBJECT_ID) then
      begin
        Result := A.ID;
        ObjKeep[A.ID] := After(Game.TickCount, OBJ_KEEP_TICKS);
      end;
  finally
    O.Free;
  end;
end;

{ the enemies of a player alive now }
function ShEnemiesAlive(ID: Integer): Integer;
var
  e: Integer;
begin
  Result := 0;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
      if PL[e].Alive then
        if Enemies(ID, e) then
          Result := Result + 1;
end;

{ his team sees every enemy for UavSeconds: marks over them or the radar ([Classes] SkillSpots) }
procedure ShUav(ID, Tick: Integer);
var
  e, Tm, n: Integer;
begin
  Tm := TeamOf[ID];
  if (Tm < 1) or (Tm > 4) then
    Exit;
  n := 0;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
      if PL[e].Alive then
        if Enemies(ID, e) then
        begin
          if After(Tick, ShUavTicks) > SgUntil[e][Tm] then
            SgUntil[e][Tm] := After(Tick, ShUavTicks);
          { [Classes] SkillSpots = marks: over the enemies for the team }
          if ClsSpotsMode = 0 then
          begin
            SgMarkIt[e][Tm] := True;
            SgMarkAny := True;
          end;
          if BeOk then
            BE_SpotSet(e, Tm, SgUntil[e][Tm]);
          n := n + 1;
        end;
  SgAny := SgAny + n;
  { SkillSpots = radar: the team has the radar while it works }
  if ClsSpotsMode = 1 then
    if Tick + ShUavTicks > ClsRadarUntil[Tm] then
    begin
      ClsRadarUntil[Tm] := Tick + ShUavTicks;
      OverlayRecount();
    end;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
      if HumanOf[e] then
        if TeamOf[e] = Tm then
          Say(e, PL[ID].Name + '''s UAV: ' + IntToStr(n) + ' enemies on the radar for ' + IntToStr(ShUavTicks div 60) +
            ' s.', ShColor);
end;

{ a stationary gun next to him for Ticks (the shop's item, the engineer's skill); StatgunMax of his at once }
function ShStatPlace(ID, Ticks, Tick: Integer): Boolean;
var
  P: TActivePlayer;
  n, k: Integer;
  H: Single;
begin
  Result := False;
  P := PL[ID];
  n := 0;
  for k := 0 to 15 do
    if ShStatObj[k] > 0 then
      if ShStatOwner[k] = ID then
        n := n + 1;
  if n >= ShStatMax then
  begin
    Say(ID, 'You have ' + IntToStr(ShStatMax) + ' stationary gun' + ShIf(ShStatMax = 1, '', 's') + ' standing already.',
      ShBadColor);
    Exit;
  end;
  k := -1;
  for n := 15 downto 0 do
    if ShStatObj[n] = 0 then
      k := n;
  if k < 0 then
    Exit;
  H := P.MouseAimX;
  if H < P.X then
    H := P.X - 20
  else
    H := P.X + 20;
  n := ShSpawnStat(H, P.Y - 20);
  if n = 0 then
  begin
    Say(ID, 'No room for another object on the map.', ShBadColor);
    Exit;
  end;
  ShStatObj[k] := n;
  ShStatOwner[k] := ID;
  ShStatEnd[k] := Tick + Ticks;
  ShStatLive := True;
  Say(ID, 'A stationary gun for ' + IntToStr(Ticks div 60) + ' s.', ShColor);
  Result := True;
end;

{ the item: True when he got it (the money then goes) }
function ShGive(ID, It: Integer): Boolean;
var
  P: TActivePlayer;
  W, n, Tick: Integer;
  H: Single;
begin
  Result := False;
  P := PL[ID];
  Tick := Game.TickCount;
  if (It >= 0) and (It <= 16) then
  begin
    if not ShWeaponOk(It) then
    begin
      Say(ID, 'The server does not allow the ' + WeaponName(It) + ' now.', ShBadColor);
      Exit;
    end;
    { [Classes] ShopClassOnly: the weapons of his class only }
    if ClsShopOnly then
      if not ClsAllows(ID, It, False) then
      begin
        Say(ID, 'Not a weapon of your class (' + ClsName[ClsOf[ID]] + ').', ShBadColor);
        Exit;
      end;
    { BuyOnly: one picked up is bought to be his }
    if (P.Primary.WType = It) or (P.Secondary.WType = It) then
      if not (ShBuyOnly and not ShOwnsWeapon(ID, It)) then
      begin
        Say(ID, 'You have the ' + WeaponName(It) + ' already (buy a magazine: !buy mag).', ShBadColor);
        Exit;
      end;
    ShGiveWeapon(ID, It);
    ShOwnSet(ID, It, True);
    if ShBuyOnly then
      ShMaskSend(ID);
    Result := True;
    Exit;
  end;
  if (It = IT_MAG) or (It = IT_AMMO) then
  begin
    W := P.Primary.WType;
    if (W < 0) or (W > 16) then
    begin
      Say(ID, 'Hold the weapon you want the ammunition for.', ShBadColor);
      Exit;
    end;
    if not (AmmoEnabled and BeOk) then
    begin
      { no ammunition system: the weapon again, full }
      ShGiveWeapon(ID, W);
      Result := True;
      Exit;
    end;
    if It = IT_MAG then
      n := BE_AmmoAddMags(ID, W, 1)
    else
      n := BE_AmmoTopUp(ID, W);
    if n <= 0 then
    begin
      Say(ID, 'Your pouch for the ' + WeaponName(W) + ' is full.', ShBadColor);
      Exit;
    end;
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if It = IT_NADE then
  begin
    if FnEnabled then
    begin
      if FnNadeLeft[ID] >= ShMaxNades then
      begin
        Say(ID, 'You carry ' + IntToStr(ShMaxNades) + ' grenades at most.', ShBadColor);
        Exit;
      end;
      FnNadeLeft[ID] := FnNadeLeft[ID] + ShNadesPer;
      if FnNadeLeft[ID] > ShMaxNades then
        FnNadeLeft[ID] := ShMaxNades;
      FnNeed[ID] := True;
    end
    else
    begin
      if P.Grenades >= Game.MaxGrenades then
      begin
        Say(ID, 'You carry all the grenades you can.', ShBadColor);
        Exit;
      end;
      if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
        Exit;
      P.GiveBonus(4);
    end;
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if It = IT_FLASH then
  begin
    if not FnEnabled then
    begin
      Say(ID, 'Flash grenades are off on this server.', ShBadColor);
      Exit;
    end;
    if FnFlashLeft[ID] >= ShMaxFlashes then
    begin
      Say(ID, 'You carry ' + IntToStr(ShMaxFlashes) + ' flash grenades at most.', ShBadColor);
      Exit;
    end;
    FnFlashLeft[ID] := FnFlashLeft[ID] + 1;
    FnNeed[ID] := True;
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if It = IT_CLUSTER then
  begin
    if FnEnabled then
    begin
      Say(ID, 'Cluster grenades do not go with the flash grenades of this server.', ShBadColor);
      Exit;
    end;
    if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
      Exit;
    P.GiveBonus(5);
    Result := True;
    Exit;
  end;
  if It = IT_VEST then
  begin
    if P.Vest >= 100 then
    begin
      Say(ID, 'Your vest is whole.', ShBadColor);
      Exit;
    end;
    H := P.Vest + ShVestAmount;
    if H > 100 then
      H := 100;
    P.Vest := H;
    Result := True;
    Exit;
  end;
  if It = IT_HEALTH then
  begin
    if P.Health >= MaxHealth - 0.5 then
    begin
      Say(ID, 'You are not hurt.', ShBadColor);
      Exit;
    end;
    P.Health := MaxHealth;
    LastHealth[ID] := MaxHealth;
    if BdActive then
      BE_BodyHeal(ID, BC_KIT, 30);
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if It = IT_BLOODBAG then
  begin
    if not BdActive then
    begin
      Say(ID, 'Blood bags come with [Bleeding], which is off here.', ShBadColor);
      Exit;
    end;
    if BdBlood[ID] >= 100 then
    begin
      Say(ID, 'Your blood is full.', ShBadColor);
      Exit;
    end;
    if BeOk then
      BE_BodyTransfuse(ID, ShBagBlood, ShBagTicks);
    Say(ID, 'Blood bag: ' + IntToStr(Round(ShBagBlood)) + '% of your blood back within ' + FloatStr(ShBagTicks / 60.0, 1) +
      ' s.', ShColor);
    Result := True;
    Exit;
  end;
  if (It = IT_BANDAGE) or (It = IT_KIT) then
  begin
    if not BdActive then
    begin
      Say(ID, 'Bandages and first-aid kits come with [Bleeding], which is off here.', ShBadColor);
      Exit;
    end;
    if It = IT_BANDAGE then
    begin
      if BdBand[ID] >= 99.5 then
      begin
        Say(ID, 'Your bandage is whole.', ShBadColor);
        Exit;
      end;
      BE_BodySupplies(ID, ShBandAmount, 0, 1);
    end
    else
    begin
      if BdKits[ID] >= ShMaxKits then
      begin
        Say(ID, 'You carry ' + IntToStr(ShMaxKits) + ' first-aid kits at most.', ShBadColor);
        Exit;
      end;
      BE_BodySupplies(ID, 0, 1, 1);
    end;
    BdSync(ID);
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if (It = IT_MINE) or (It = IT_CLAY) then
  begin
    if not MnActive then
    begin
      Say(ID, 'Mines are off here (' + MnIdleWhy + ').', ShBadColor);
      Exit;
    end;
    if It = IT_MINE then
      n := MnGive(ID, MN_LAND, 1, 'the shop', True)
    else
      n := MnGive(ID, MN_CLAY, 1, 'the shop', True);
    if n <= 0 then
    begin
      Say(ID, 'You carry all the ' + ShIf(It = IT_MINE, 'landmines', 'claymores') + ' you can.', ShBadColor);
      Exit;
    end;
    Result := True;
    Exit;
  end;
  if It = IT_JAV then
  begin
    if not RkEnabled then
    begin
      Say(ID, 'Guided rockets are off on this server.', ShBadColor);
      Exit;
    end;
    if RkRockets - RkUsed[ID] >= ShMaxJav then
    begin
      Say(ID, 'You carry ' + IntToStr(ShMaxJav) + ' Javelins at most.', ShBadColor);
      Exit;
    end;
    RkUsed[ID] := RkUsed[ID] - 1;
    if (P.Primary.WType <> WEP_LAW) and (P.Secondary.WType <> WEP_LAW) then
      Say(ID, 'A Javelin flies from a LAW - get one (!buy law).', ShColor);
    HudMark(ID, False);
    Result := True;
    Exit;
  end;
  if (It = IT_BERSERK) or (It = IT_PREDATOR) then
  begin
    if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
      Exit;
    if It = IT_BERSERK then
      P.GiveBonus(2)
    else
      P.GiveBonus(1);
    Result := True;
    Exit;
  end;
  if It = IT_STATGUN then
  begin
    Result := ShStatPlace(ID, ShStatTicks, Tick);
    Exit;
  end;
  if It = IT_UAV then
  begin
    if not TeamGame() then
    begin
      Say(ID, 'A UAV needs teams.', ShBadColor);
      Exit;
    end;
    if ClsSpotsMode = 1 then
      if not OvlEnabled then
      begin
        Say(ID, 'A UAV needs the radar, which is off on this server.', ShBadColor);
        Exit;
      end;
    if ShEnemiesAlive(ID) = 0 then
    begin
      Say(ID, 'No enemy alive for a UAV to find.', ShBadColor);
      Exit;
    end;
    ShUav(ID, Tick);
    Result := True;
    Exit;
  end;
  if It = IT_AP then
  begin
    ShApLeft[ID] := ShApLeft[ID] + ShApRounds;
    if ShApWatch = 0 then
      if BeOk then
        BE_HookWatch(8, 1);
    ShApWatch := 1;
    if MapOk and HookOn then
      Say(ID, 'The next ' + IntToStr(ShApLeft[ID]) + ' Barrett rounds explode where they hit.', ShColor)
    else
      Say(ID, 'The next ' + IntToStr(ShApLeft[ID]) + ' Barrett rounds explode in a soldier they hit (the walls of ' +
        'this map are not known here).', ShColor);
    Result := True;
    Exit;
  end;
  if It = IT_SUPPLY then
  begin
    if not SuEnabled then
    begin
      Say(ID, 'Supply drops are off on this server.', ShBadColor);
      Exit;
    end;
    Result := SuCall(ID, Tick);
    Exit;
  end;
end;

{ /buy <word or number> }
procedure ShBuy(ID, It: Integer);
var
  Price, Tick: Integer;
  P: TActivePlayer;
begin
  P := PL[ID];
  Tick := Game.TickCount;
  if Tick < ShNextBuy[ID] then
    Exit;
  ShNextBuy[ID] := Tick + ShCoolTicks;
  Price := ShPriceOf(ID, It);
  if Price < 0 then
  begin
    Say(ID, 'That is not sold here (!shop).', ShBadColor);
    Exit;
  end;
  if ShAlive then
    if not P.Alive then
    begin
      Say(ID, 'Buy while you are alive.', ShBadColor);
      Exit;
    end;
  if DwDown[ID] then
  begin
    Say(ID, 'Not while you are down.', ShBadColor);
    Exit;
  end;
  if TeamOf[ID] = TEAM_SPECTATOR then
    Exit;
  if not ShInZone(ID) then
  begin
    if ShWhere = 1 then
      Say(ID, 'Buy near your spawn point.', ShBadColor)
    else
      Say(ID, 'Buy near your flag.', ShBadColor);
    Exit;
  end;
  if Game.Survival then
  begin
    if ShSurvBuyTicks > 0 then
      if Tick - ShSpawnTick[ID] > ShSurvBuyTicks then
      begin
        Say(ID, 'The buy time of this round is over (' + IntToStr(ShSurvBuyTicks div 60) + ' s).', ShBadColor);
        Exit;
      end;
  end
  else if ShBuyTicks > 0 then
    if Tick - ShSpawnTick[ID] > ShBuyTicks then
    begin
      Say(ID, 'Buy within ' + IntToStr(ShBuyTicks div 60) + ' s of your respawn.', ShBadColor);
      Exit;
    end;
  if ShLimit[It] > 0 then
    if ShBought[ID][It] >= ShLimit[It] then
    begin
      Say(ID, 'That is ' + IntToStr(ShLimit[It]) + ' a life.', ShBadColor);
      Exit;
    end;
  if ShMoney[ID] < Price then
  begin
    Say(ID, 'Not enough money: ' + ShCurrency + IntToStr(Price) + ' needed, ' + ShCurrency + IntToStr(ShMoney[ID]) +
      ' there.', ShBadColor);
    Exit;
  end;
  if not ShGive(ID, It) then
    Exit;
  ShAdd(ID, -Price, '');
  ShBought[ID][It] := ShBought[ID][It] + 1;
  ClsUsed[ID] := True;
  ShStatSold := ShStatSold + 1;
  ShStatSpent := ShStatSpent + Price;
  Say(ID, 'Bought: ' + ShItemName(It) + ' for ' + ShCurrency + IntToStr(Price) + ' (' + ShCurrency +
    IntToStr(ShMoney[ID]) + ' left).', ShColor);
end;

procedure CmdBuy(ID: Integer; Args: string);
var
  It: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ShActive then
  begin
    Say(ID, 'The shop is closed (' + ShIdleWhy + ').', ShBadColor);
    Exit;
  end;
  if Trim(Args) = '' then
  begin
    Say(ID, 'Use: !buy <item> (or its number in !shop); bind a key: bind "F5" "/buy ak"', ShColor);
    Exit;
  end;
  It := ShItemOf(Args);
  if It < 0 then
  begin
    Say(ID, 'No such item: ' + Trim(Args) + ' (!shop lists them).', ShBadColor);
    Exit;
  end;
  ShBuy(ID, It);
end;

{ !shop [weapons | ammo | equipment | special | all]: each category on lines of its own colour, the items with
  their numbers (the same for everybody), short names and prices }
procedure CmdShop(ID: Integer; Args: string);
var
  W, Line, Head: string;
  Want, Cat, It, n, InLine, Per, Shown, Pr: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ShActive then
  begin
    Say(ID, 'The shop is closed (' + ShIdleWhy + ').', ShBadColor);
    Exit;
  end;
  W := LowerCase(Trim(Args));
  Want := 0;
  if (W = 'weapons') or (W = 'weapon') or (W = 'w') or (W = 'wep') then
    Want := 1
  else if (W = 'ammo') or (W = 'a') then
    Want := 2
  else if (W = 'equipment') or (W = 'equip') or (W = 'e') or (W = 'gear') then
    Want := 3
  else if (W = 'special') or (W = 's') then
    Want := 4
  else if (W = 'all') or (W = '*') then
    Want := 9;
  if Want = 0 then
  begin
    Say(ID, 'Shop - you have ' + ShCurrency + IntToStr(ShMoney[ID]) + '. !shop weapons | ammo | equipment | special | all',
      ShColor);
    Say(ID, '!buy <number or word>, !money, !pay <player> <amount>' + ShIf(ShSellOn, ', !sell', ''), ShColor);
    Exit;
  end;
  Say(ID, 'You have ' + ShCurrency + IntToStr(ShMoney[ID]) + ' - !buy <number or word>', ShColor);
  n := 0;
  Shown := 0;
  for Cat := 1 to 4 do
  begin
    Line := '';
    InLine := 0;
    Per := 3;
    if Cat = 1 then
      Per := 4;
    Head := ShCatName(Cat) + ':  ';
    for It := 0 to IT_LAST do
      if ShCat[It] = Cat then
        if ShListed(It) then
        begin
          n := n + 1;
          if (Want = 9) or (Want = Cat) then
          begin
            if InLine > 0 then
              Line := Line + '   |   ';
            Pr := ShPriceOf(ID, It);
            if Pr >= 0 then
              Line := Line + IntToStr(n) + ' ' + ShShortName(It) + ' ' + ShCurrency + IntToStr(Pr)
            else
              Line := Line + IntToStr(n) + ' ' + ShShortName(It) + ' ' + IntToStr(-100 - ShPrice[It]) + '%';
            InLine := InLine + 1;
            Shown := Shown + 1;
            if InLine >= Per then
            begin
              Say(ID, Head + Line, ShListColor[Cat]);
              Head := '      ';
              Line := '';
              InLine := 0;
            end;
          end;
        end;
    if Line <> '' then
      Say(ID, Head + Line, ShListColor[Cat]);
  end;
  if Shown = 0 then
    Say(ID, 'Nothing of that kind is sold here.', ShBadColor);
end;

procedure CmdMoney(ID: Integer);
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ShActive then
    Exit;
  Say(ID, 'You have ' + ShCurrency + IntToStr(ShMoney[ID]) + ShIf(ShGlobal, ShIf(ShLoaded[ID], ' (your account)',
    ' (your account comes with Steam)'), ' (this map)') + '.', ShColor);
end;

{ !pay <player> <amount>: to a team mate (Transfer = team) or anybody (all) }
procedure CmdPay(ID: Integer; Args: string);
var
  Rest, W: string;
  T, n: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ShActive then
    Exit;
  if ShTransfer = 0 then
  begin
    Say(ID, 'Money cannot be given on this server.', ShBadColor);
    Exit;
  end;
  Rest := Args;
  W := TakeArg(Rest);
  T := AdFindOne(ID, W);
  n := StrToIntDef(Trim(Rest), 0);
  if (T = 0) or (n <= 0) then
  begin
    Say(ID, 'Use: !pay <player> <amount>', ShBadColor);
    Exit;
  end;
  if T < 0 then
    Exit;
  if T = ID then
    Exit;
  if ShTransfer = 1 then
    if Enemies(ID, T) then
    begin
      Say(ID, 'Only to your team.', ShBadColor);
      Exit;
    end;
  if n > ShMoney[ID] then
  begin
    Say(ID, 'You have ' + ShCurrency + IntToStr(ShMoney[ID]) + '.', ShBadColor);
    Exit;
  end;
  if ShMoney[T] + n > ShMax() then
    n := ShMax() - ShMoney[T];
  if n <= 0 then
    Exit;
  ShAdd(ID, -n, '');
  ShAdd(T, n, 'from ' + PL[ID].Name);
  Say(ID, 'You gave ' + PL[T].Name + ' ' + ShCurrency + IntToStr(n) + '.', ShColor);
  Say(T, PL[ID].Name + ' gave you ' + ShCurrency + IntToStr(n) + '.', ShColor);
end;

{ !sell: the bought weapon in his hands for SellShare of what he paid }
procedure CmdSell(ID: Integer);
var
  W, n: Integer;
  NW, NS: TNewWeapon;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ShActive then
    Exit;
  if not ShSellOn then
  begin
    Say(ID, 'Nothing is bought back here.', ShBadColor);
    Exit;
  end;
  W := PL[ID].Primary.WType;
  if (W < 0) or (W > 16) then
    Exit;
  if ShBought[ID][W] <= 0 then
  begin
    Say(ID, 'Only a weapon you bought this life is bought back.', ShBadColor);
    Exit;
  end;
  n := Round(ShPriceOf(ID, W) * ShSellShare);
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NW.WType := PL[ID].Secondary.WType;
    NW.Ammo := PL[ID].Secondary.Ammo;
    NS.WType := WEP_NONE;
    PL[ID].ForceWeapon(NW, NS);
  finally
    NW.Free;
    NS.Free;
  end;
  AcAmmoTouched(ID);
  ShBought[ID][W] := ShBought[ID][W] - 1;
  ShOwnSet(ID, W, False);
  ShAdd(ID, n, 'sold');
  Say(ID, WeaponName(W) + ' sold for ' + ShCurrency + IntToStr(n) + '.', ShColor);
end;

