{ the event: does the server's own /map know this name (a map file of that name) }
function MmExact(Args: string): Boolean;
var
  W: string;
begin
  W := Trim(Args);
  Result := W = '';
  if not Result then
    Result := File.Exists(MgFolder + W + '.pms');
end;

{ ---------------- /warn ---------------- }

procedure CmdWarn(ID: Integer; Args: string);
var
  Rest, W: string;
  T, n: Integer;
begin
  if not WnEnabled then
    Exit;
  Rest := Args;
  W := TakeArg(Rest);
  T := AdFindOne(ID, W);
  if T = 0 then
  begin
    Say(ID, 'Use: /warn <player> <reason>', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  Rest := Trim(Rest);
  if Rest = '' then
    Rest := 'the rules';
  WnCount[T] := WnCount[T] + 1;
  n := WnCount[T];
  if HumanOf[T] then
    PL[T].BigText(WnBigLayer, ReplaceAll(ReplaceAll(WnText, '{reason}', Rest), '{count}', IntToStr(n)), WnBigTicks,
      ColorBad, WnBigScale, WnBigX, WnBigY);
  Say(T, ReplaceAll(ReplaceAll(WnText, '{reason}', Rest), '{count}', IntToStr(n)), ColorBad);
  if WnTellAll then
    SayAll(ReplaceAll(ReplaceAll(ReplaceAll(WnAllText, '{player}', PL[T].Name), '{reason}', Rest), '{count}',
      IntToStr(n)), WnColor)
  else
    Say(ID, PL[T].Name + ' warned (' + IntToStr(n) + ').', ColorGood);
  Log('[Warn] ' + PL[T].Name + ' warned (' + IntToStr(n) + '): ' + Rest);
  if WnKickAt > 0 then
    if n >= WnKickAt then
    begin
      WnCount[T] := 0;
      SayAll(PL[T].Name + ' is kicked after ' + IntToStr(n) + ' warnings.', ColorBad);
      ScheduleBan(T, WnBanMinutes, 'Warnings: ' + Rest);
    end;
end;

