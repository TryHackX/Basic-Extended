  else if (S = 'aug') or (S = 'steyr') or (S = 'steyraug') then
    Result := 4
  else if (S = 'spas') or (S = 'spas12') or (S = 'spas-12') or (S = 'shotgun') then
    Result := 5
  else if (S = 'ruger') or (S = 'ruger77') then
