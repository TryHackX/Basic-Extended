procedure CmdSpeed(ID: Integer; Args: string);
var
  k, T, M: Integer;
  W, Rest, V: string;
  F: Single;
  Ok, NewOn, Given: Boolean;
begin
  if not BeOk then
  begin
    Say(ID, 'The speed booster needs basicext_dll, which is not running.', ColorBad);
    Exit;
  end;
  Rest := Args;
  W := TakeArg(Rest);
  if W = '' then
  begin
    Say(ID, 'Use: /speed <player|all|me> [<1.1-5>|off] [all|ground|jump] - run and fly faster (2 = twice as ' +
      'fast); ground = only on the ground, jump = the ground and a stronger jump', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, W, True, False, False) then
    Exit;
  F := SpDefault;
  M := SpModeDef;
  Given := False;
  NewOn := True;
  V := LowerCase(Trim(TakeArg(Rest)));
  while V <> '' do
  begin
    if V[Length(V)] = 'x' then
      Delete(V, Length(V), 1);
    if SpeedModeOf(V) >= 0 then
      M := SpeedModeOf(V)
    else if (V = 'off') or (V = '0') or (V = '1') then
      NewOn := False
    else
    begin
      F := ParseFloat(V, Ok);
      if (not Ok) or (F < 1.1) or (F > 5) then
      begin
        Say(ID, 'The speed is 1.1 to 5 (or off); the kind all, ground or jump.', ColorBad);
        Exit;
      end;
      Given := True;
    end;
    V := LowerCase(Trim(TakeArg(Rest)));
  end;
  if NewOn and (not Given) then
    if (TgtCount = 1) and (not TgtMany) then
      if SpOn[TgtList[0]] then
        if SpMode[TgtList[0]] = M then
          NewOn := False;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    if NewOn then
    begin
      if not SpOn[T] then
        SpCount := SpCount + 1;
      SpOn[T] := True;
      SpFactor[T] := F;
      SpMode[T] := M;
      SpWasGround[T] := False;
    end
    else if SpOn[T] then
    begin
      SpOn[T] := False;
      SpCount := SpCount - 1;
    end;
  end;
  if SpCount < 0 then
    SpCount := 0;
  if NewOn then
    Say(ID, 'Speed x' + FloatStr(F, 1) + ' ' + SpeedModeName(M) + ': ' + TgtDesc() + '.', ColorGood)
  else
    Say(ID, 'Normal speed: ' + TgtDesc() + '.', ColorGood);
end;

procedure SpeedTick(Tick: Integer);
var
  i, Dir: Integer;
  P: TActivePlayer;
  VX, VY, NX, NY, Top, Step, K: Single;
  OnG: Boolean;
begin
  if Tick mod 2 <> 0 then
    Exit;
  for i := 1 to TopSlot do
    if SpOn[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        SpOn[i] := False;
        SpCount := SpCount - 1;
        Continue;
      end;
      if not P.Alive then
        Continue;
      OnG := P.OnGround;
      VX := P.VelX;
      VY := P.VelY;
      NX := VX;
      NY := VY;
      if OnG or (SpMode[i] = SPM_ALL) then
      begin
        Dir := 0;
        if P.KeyRight then
          Dir := 1;
        if P.KeyLeft then
          Dir := Dir - 1;
        if Dir <> 0 then
        begin
          Top := SpRun * SpFactor[i];
          if not OnG then
            Top := Top * 0.8;
          if Top > 11 then
            Top := 11;
          if Dir * VX < Top then
          begin
            Step := 0.5 * SpFactor[i];
            if Dir * VX + Step > Top then
              Step := Top - Dir * VX;
            NX := VX + Dir * Step;
          end;
        end;
      end;
      if SpMode[i] = SPM_ALL then
        if P.KeyJetpack then
          if P.Jets > 0 then
          begin
            NY := VY - SpJet * (SpFactor[i] - 1) * 2;
            if NY < -11 then
              NY := -11;
          end;
      if SpMode[i] = SPM_JUMP then
        if (not OnG) and SpWasGround[i] and (VY < -1) then
        begin
          K := 1 + (SpFactor[i] - 1) * SpJumpShare;
          NY := VY * K;
          if NY < -11 then
            NY := -11;
        end;
      SpWasGround[i] := OnG;
      if (Abs(NX - VX) > 0.05) or (Abs(NY - VY) > 0.05) then
      begin
        P.SetVelocity(NX, NY);
        if AcOn then
          BE_AcMoved(i, Tick);
      end;
    end;
  if SpCount < 0 then
    SpCount := 0;
end;

procedure SayChat(ID: Integer; Head, Text: string; Color: Longint);
begin
  if Length(Text) < 60 then
  begin
    if ID = 0 then
      SayAll(Head + Text, Color)
    else
      Say(ID, Head + Text, Color);
  end
  else if ID = 0 then
  begin
    SayAll(Head, Color);
    SayAll(' ' + Text, Color);
  end
  else
  begin
    Say(ID, Head, Color);
    Say(ID, ' ' + Text, Color);
  end;
end;

procedure CmdSayAs(ID: Integer; Args: string; Team: Boolean);
var
  k, T, Tm: Integer;
  Rest, Text, Line: string;
  C: Longint;
begin
  Rest := Args;
  if not PickTargets(ID, TakeArg(Rest), False, False, False) then
    Exit;
  Text := Trim(Rest);
  if (TgtCount <> 1) or (Text = '') then
  begin
    if Team then
      Say(ID, 'Use: /sayteam <player> <text> - the team mates of that player see it as their team chat', ColorBad)
    else
      Say(ID, 'Use: /sayas <player> <text> - everybody sees it as that player''s chat', ColorBad);
    Exit;
  end;
  T := TgtList[0];
  WriteLn(TAG + AdminName(ID) + ' used ' + iif(Team, '/sayteam', '/sayas') + ' as ' + PL[T].Name + ': ' + Text);
  if not Team then
  begin
    C := SayChatColor;
    if TeamOf[T] = TEAM_SPECTATOR then
      C := SaySpecColor;
    SayChat(0, '[' + PL[T].Name + '] ', Text, C);
    Exit;
  end;
  Tm := TeamOf[T];
  Line := '(TEAM) [' + PL[T].Name + '] ';
  for k := 1 to TopSlot do
    if ActiveSlot[k] then
      if TeamOf[k] = Tm then
        SayChat(k, Line, Text, SayTeamColor);
  if TeamOf[ID] <> Tm then
    Say(ID, 'Sent to the team of ' + PL[T].Name + ': ' + Text, ColorGood);
end;

procedure LoadWepSeen(Command: string);
var
  S, W: string;
begin
  S := Trim(Command);
  if S = '' then
    Exit;
  if S[1] = '/' then
    Delete(S, 1, 1);
  W := LowerCase(FirstWord(S));
  if W <> 'loadwep' then
    Exit;
  W := Trim(AfterFirstWord(S));
  if W = '' then
  begin
    if Game.Realistic then
      W := 'weapons_realistic'
    else
      W := 'weapons';
  end;
  if LowerCase(Copy(W, Length(W) - 3, 4)) = '.ini' then
    Delete(W, Length(W) - 3, 4);
  WmPending := 'configs/' + W + '.ini';
end;

procedure LoadWepSync();
var
  n, i, R: Integer;
begin
  R := BoolInt(Game.Realistic);
  n := BE_WeaponsLoad(PChar(WmPending), R);
  if n > 0 then
  begin
    WmLoaded := WmPending;
    WpRefresh();
    for i := 1 to TopSlot do
      AcAmmoTouched(i);
    WriteLn(TAG + 'weapons for the trajectory and the aimbot: ' + WmLoaded);
  end
  else
    WriteLn(TAG + 'loadwep: ' + WmPending + ' not found for the library, it keeps the old weapons');
  WmPending := '';
end;

procedure CmdSlay(ID: Integer; Args: string);
var
  k, T: Integer;
begin
  if Trim(Args) = '' then
  begin
    Say(ID, 'Use: /slay <player|all|others|team> - kills at once (counts as a suicide)', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, TakeArg(Args), True, True, True) then
    Exit;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    ServerKill[T] := Game.TickCount;
    PL[T].Damage(T, 4000);
  end;
  Say(ID, 'Slain: ' + TgtDesc() + '.', ColorGood);
end;

procedure InfTick(Tick: Integer);
var
  i, W, A, Low: Integer;
  P: TActivePlayer;
begin
  if Tick mod 3 <> 0 then
    Exit;
  for i := 1 to TopSlot do
    if InfOn[i] then
    begin
      P := PL[i];
      if not P.Active then
      begin
        InfOn[i] := False;
        InfCount := InfCount - 1;
        Continue;
      end;
      if not P.Alive then
        Continue;
      W := P.Primary.WType;
      { without the hook: the knife is gone from his hands (with it, KnifeThrown gives it back) }
      if not HookOn then
        if (W = WEP_NONE) and (InfLastW[i] = WEP_KNIFE) then
        begin
          KnifeGive(P);
          Continue;
        end;
      InfLastW[i] := W;
      if (W < 0) or (W > 16) or (W = WEP_KNIFE) or (W = 12) then
        Continue;
      A := P.Primary.Ammo;
      Low := WpAmmo[W] div 5;
      if A <= Low then
        if A < WpAmmo[W] then
          P.Primary.Ammo := WpAmmo[W];
    end;
  if InfCount < 0 then
    InfCount := 0;
end;

procedure FreezeTick(Tick: Integer);
var
  i: Integer;
  P: TActivePlayer;
begin
  for i := 1 to TopSlot do
    if FrOn[i] then
      if Tick >= FrAt[i] then
      begin
        P := PL[i];
        if not P.Active then
        begin
          FrOn[i] := False;
          FrCount := FrCount - 1;
          Continue;
        end;
        if not P.Alive then
          Continue;
        if (Abs(P.X - FrX[i]) > 4) or (Abs(P.Y - FrY[i]) > 4) then
        begin
          MovePlayer(P, FrX[i], FrY[i]);
          P.SetVelocity(0, 0);
          FrAt[i] := Tick + 4;
        end;
      end;
  if FrCount < 0 then
    FrCount := 0;
end;

{ ============ round 21: [Points] - battle points (the Battlefield mod's score) ============ }

{ N points with the word of the feed (Quiet: added to the gain shown, no word of its own unless there is none) }
procedure BpAdd(ID, N: Integer; Word: string; Quiet: Boolean);
begin
  if not BpActive then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if N = 0 then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not (HumanOf[ID] or BpBots) then
    Exit;
  { [General] Opponents: nothing earned without an opponent (a loss still counts) }
  if N > 0 then
    if not Opposed(ID) then
      Exit;
  BpScore[ID] := BpScore[ID] + N;
  BpStatEvents := BpStatEvents + 1;
  if Game.TickCount > BpGainUntil[ID] then
  begin
    BpGain[ID] := 0;
    BpWhy[ID] := '';
  end;
  BpGain[ID] := BpGain[ID] + N;
  if (not Quiet) or (BpWhy[ID] = '') then
    BpWhy[ID] := Word;
  BpGainUntil[ID] := Game.TickCount + BpGainTicks;
  if BpFeed then
    if not Quiet then
      if HumanOf[ID] then
        Say(ID, ReplaceAll(ReplaceAll(BpFeedText, '{points}', BpSigned(N)), '{why}', Word), BpColor);
  HudMarkL(ID, HLB_SCORE);
end;

procedure BpEvent(ID, E: Integer);
begin
  if BpVal[E] <> 0 then
    BpAdd(ID, BpVal[E], BpWord(E), False);
end;

{ health, vest or magazines given to mates: the event's points for every HealEvery, RepairEvery, AmmoEvery }
procedure BpGive(ID, E: Integer; Amount: Single);
var
  n: Integer;
begin
  if not BpActive then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if BpVal[E] = 0 then
    Exit;
  n := 0;
  if E = PE_HEALED then
  begin
    BpHealAcc[ID] := BpHealAcc[ID] + Amount;
    n := Trunc(BpHealAcc[ID] / BpHealEvery);
    BpHealAcc[ID] := BpHealAcc[ID] - n * BpHealEvery;
  end
  else if E = PE_REPAIRED then
  begin
    BpRepairAcc[ID] := BpRepairAcc[ID] + Amount;
    n := Trunc(BpRepairAcc[ID] / BpRepairEvery);
    BpRepairAcc[ID] := BpRepairAcc[ID] - n * BpRepairEvery;
  end
  else if E = PE_AMMO then
  begin
    BpAmmoAcc[ID] := BpAmmoAcc[ID] + Amount;
    n := Trunc(BpAmmoAcc[ID] / BpAmmoEvery);
    BpAmmoAcc[ID] := BpAmmoAcc[ID] - n * BpAmmoEvery;
  end;
  if n > 0 then
    BpAdd(ID, n * BpVal[E], BpWord(E), False);
end;

{ the damage of the hits DmgSettle added up: Damage for every percent of a health to enemies, TeamDamage to mates;
  the events the modules above this code owe him }
procedure BpPay(S: Integer);
var
  n, E: Integer;
begin
  if BpDmgPend[S] > 0 then
  begin
    BpDmgAcc[S] := BpDmgAcc[S] + BpDmgPend[S] * 100 / MaxHealth;
    BpDmgPend[S] := 0;
    n := Trunc(BpDmgAcc[S]);
    if n > 0 then
    begin
      BpDmgAcc[S] := BpDmgAcc[S] - n;
      if BpVal[PE_DAMAGE] <> 0 then
        BpAdd(S, n * BpVal[PE_DAMAGE], BpWord(PE_DAMAGE), True);
    end;
  end;
  if BpTeamPend[S] > 0 then
  begin
    BpTeamAcc[S] := BpTeamAcc[S] + BpTeamPend[S] * 100 / MaxHealth;
    BpTeamPend[S] := 0;
    n := Trunc(BpTeamAcc[S]);
    if n > 0 then
    begin
      BpTeamAcc[S] := BpTeamAcc[S] - n;
      if BpVal[PE_TEAMDMG] <> 0 then
        BpAdd(S, n * BpVal[PE_TEAMDMG], BpWord(PE_TEAMDMG), False);
    end;
  end;
  for E := 0 to PE_LAST do
    while BpEvPend[S][E] > 0 do
    begin
      BpEvPend[S][E] := BpEvPend[S][E] - 1;
      BpEvent(S, E);
    end;
end;

{ a hit (OnDamage): whom he attacked last (savior); a killing one: the place it hit (a headshot) }
procedure BpHit(S, V, B, Tick: Integer; Lethal: Boolean);
begin
  if (V < 1) or (V > 32) then
    Exit;
  if (S >= 1) and (S <= 32) then
    if S <> V then
      if Enemies(S, V) then
      begin
        BpSvTarget[S] := V;
        BpSvTick[S] := Tick;
      end;
  if Lethal then
    if BpVal[PE_HEADSHOT] <> 0 then
      if BeOk then
        if (B >= 1) and (B <= 254) then
          BpLastPart[V] := BE_BodyHitPart(V, BL[B].Style, BL[B].X, BL[B].Y, BL[B].VelX, BL[B].VelY);
end;

function BpMultiWord(n: Integer): string;
begin
  case n of
    2: Result := 'double kill';
    3: Result := 'triple kill';
    4: Result := 'multi kill';
    5: Result := 'mega kill';
  else
    Result := 'killing spree';
  end;
end;

{ a kill (OnKill; not the end of a survival round, not the server's own kills) }
procedure BpKill(K, V, Tick, B: Integer; OwnRound: Boolean);
var
  i, n, Pts, Tm, T: Integer;
  DX, DY, D, OX, OY: Single;
begin
  if not BpActive then
    Exit;
  if (V < 1) or (V > 32) then
    Exit;
  if (K < 1) or (K > 32) then
    Exit;
  if K = V then
  begin
    if OwnSuicide(V, Tick) then
      BpEvent(V, PE_SELF);
    BpLastPart[V] := 0;
    BpSvTarget[V] := 0;
    Exit;
  end;
  if not Enemies(K, V) then
  begin
    BpLastPart[V] := 0;
    BpSvTarget[V] := 0;
    Exit;
  end;
  BpEvent(K, PE_KILL);
  if BpLastPart[V] = 12 then
    BpEvent(K, PE_HEADSHOT);
  if not BpFirstDone then
  begin
    BpFirstDone := True;
    BpEvent(K, PE_FIRST);
  end;
  { the others who did AssistPercent of a health to him }
  if BpVal[PE_ASSIST] <> 0 then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if (i <> K) and (i <> V) then
          if Enemies(i, V) then
            if Dealt[i][V] * 100 >= BpAssistPct * MaxHealth then
              BpEvent(i, PE_ASSIST);
  { a kill from far away (the class's distance perk): his own round, from where it was fired }
  if BpVal[PE_DISTANCE] <> 0 then
    if OwnRound then
    if (B >= 1) and (B <= 254) then
    if BE_BulletOrigin(B, OX, OY, T) = 1 then
    begin
      DX := OX - PL[V].X;
      DY := OY - PL[V].Y;
      D := Sqrt(DX * DX + DY * DY);
      if D > BpDistFrom then
      begin
        Pts := BpDistBase + Trunc((D - BpDistFrom) / BpDistStep);
        if ClsActive then
          if (ClsOf[K] >= 1) and (ClsOf[K] <= ClsCount) then
            Pts := Round(Pts * ClsDistF[ClsOf[K]]);
        BpAdd(K, Pts * BpVal[PE_DISTANCE], BpWord(PE_DISTANCE) + ' ' + IntToStr(Round(D / 14)) + ' m', False);
      end;
    end;
  { he had just hurt a mate of the killer }
  if BpVal[PE_SAVIOR] <> 0 then
  begin
    n := BpSvTarget[V];
    if (n >= 1) and (n <= 32) then
      if n <> K then
        if Tick - BpSvTick[V] <= BpSaviorTicks then
          if ActiveSlot[n] then
            if PL[n].Alive then
              if TeamGame() then
                if TeamOf[n] = TeamOf[K] then
                  BpEvent(K, PE_SAVIOR);
  end;
  BpSvTarget[V] := 0;
  { the last one who killed him }
  if BpKilledBy[K] = V then
  begin
    if (BpRevAt[K] = 0) or (Tick - BpRevAt[K] >= 3600) then
    begin
      BpEvent(K, PE_REVENGE);
      BpRevAt[K] := Tick;
    end;
    BpKilledBy[K] := 0;
  end;
  BpKilledBy[V] := K;
  if not PL[K].Alive then
    if OwnRound then
      BpEvent(K, PE_POSTHUMOUS);
  { kills no more than MultiSeconds apart }
  if Tick - BpMultiTick[K] > BpMultiTicks then
    BpMultiN[K] := 0;
  BpMultiTick[K] := Tick;
  BpMultiN[K] := BpMultiN[K] + 1;
  n := BpMultiN[K];
  if n > 6 then
    n := 6;
  if n >= 2 then
    if BpMulti[n] <> 0 then
      BpAdd(K, BpMulti[n], BpMultiWord(n), False);
  { an enemy his team had spotted: the spotter }
  if BpVal[PE_SPOTKILL] <> 0 then
  begin
    Tm := TeamOf[K];
    if (Tm >= 1) and (Tm <= 4) then
      if SgUntil[V][Tm] > Tick then
      begin
        n := SgBy[V][Tm];
        if (n >= 1) and (n <= 32) then
          if n <> K then
            if ActiveSlot[n] then
              BpEvent(n, PE_SPOTKILL);
      end;
  end;
  BpLastPart[V] := 0;
end;

{ his place among the players (1 = the best) }
function BpPlace(ID: Integer): Integer;
var
  i: Integer;
begin
  Result := 1;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if i <> ID then
        if TeamOf[i] <> TEAM_SPECTATOR then
          if BpScore[i] > BpScore[ID] then
            Result := Result + 1;
end;

{ the best Lines players of a team (Tm 0 = everybody): "1. name 340" joined by Sep }
function BpList(Tm, Lines: Integer; Sep: string): string;
var
  i, n, Best: Integer;
  Used: array[1..32] of Boolean;
begin
  Result := '';
  for i := 1 to 32 do
    Used[i] := False;
  for n := 1 to Lines do
  begin
    Best := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if not Used[i] then
          if TeamOf[i] <> TEAM_SPECTATOR then
            if (Tm = 0) or (TeamOf[i] = Tm) then
            begin
              if Best = 0 then
                Best := i
              else if BpScore[i] > BpScore[Best] then
                Best := i;
            end;
    if Best = 0 then
      Break;
    Used[Best] := True;
    if Result <> '' then
      Result := Result + Sep;
    Result := Result + IntToStr(n) + '. ' + PL[Best].Name + ' ' + IntToStr(BpScore[Best]);
  end;
  if Result = '' then
    Result := '-';
end;

{ !score }
procedure CmdScore(ID: Integer);
var
  i, n: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not BpActive then
  begin
    Say(ID, 'Battle points are off here (' + BpIdleWhy + ').', ColorBad);
    Exit;
  end;
  n := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] <> TEAM_SPECTATOR then
        n := n + 1;
  Say(ID, 'Your score: ' + IntToStr(BpScore[ID]) + ' - place ' + IntToStr(BpPlace(ID)) + ' of ' + IntToStr(n) +
    ' (!scores: the best).', BpColor);
end;

{ !scores: the best of each team }
procedure CmdScores(ID: Integer);
var
  Tm, i, n: Integer;
begin
  if not BpActive then
  begin
    Say(ID, 'Battle points are off here (' + BpIdleWhy + ').', ColorBad);
    Exit;
  end;
  if not TeamGame() then
  begin
    Say(ID, 'Best: ' + BpList(0, BpTopLines, ', '), BpColor);
    Exit;
  end;
  for Tm := 1 to 4 do
  begin
    n := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if TeamOf[i] = Tm then
          n := n + 1;
    if n > 0 then
      Say(ID, TeamName(Tm) + ': ' + BpList(Tm, BpTopLines, ', '), BpColor);
  end;
end;

{ the end of a map (OnBeforeMapEv): the best in everybody's console, both teams' lists on every screen for
  BoardSeconds (taken away by BpTick) }
{ the players of team Tm (not spectators) }
function BpTeamSize(Tm: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] = Tm then
        Result := Result + 1;
end;

procedure BpBoard();
var
  i, Lines: Integer;
  A, B: string;
begin
  if not BpActive then
    Exit;
  if BpBestLines > 0 then
    SayAll('Battle points of the map - ' + BpList(0, BpBestLines, ', '), BpColor);
  if BpBoardTicks <= 0 then
    Exit;
  if TeamGame() then
  begin
    { F2-20: Charlie under Alpha and Delta under Bravo where they have players (shorter lists then) }
    Lines := 10;
    if (BpTeamSize(3) > 0) or (BpTeamSize(4) > 0) then
      Lines := 6;
    A := TeamName(1) + ':'#13#10 + BpList(1, Lines, #13#10);
    B := TeamName(2) + ':'#13#10 + BpList(2, Lines, #13#10);
    if BpTeamSize(3) > 0 then
      A := A + #13#10#13#10 + TeamName(3) + ':'#13#10 + BpList(3, Lines, #13#10);
    if BpTeamSize(4) > 0 then
      B := B + #13#10#13#10 + TeamName(4) + ':'#13#10 + BpList(4, Lines, #13#10);
  end
  else
  begin
    A := 'Best:'#13#10 + BpList(0, 10, #13#10);
    B := '';
  end;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
      begin
        PL[i].BigText(BpBoardLayer, A, BpBoardTicks, BpColor, 0.06, 5, 63);
        if B <> '' then
          PL[i].BigText(BpBoardLayer + 1, B, BpBoardTicks, $80B0FF, 0.06, 325, 63);
      end;
  BpBoardUntil := Game.TickCount + BpBoardTicks;
end;

{ a new map: everybody starts from 0 }
procedure BpMapStart();
var
  i, k: Integer;
begin
  for i := 1 to 32 do
  begin
    BpScore[i] := 0;
    BpGain[i] := 0;
    BpGainUntil[i] := 0;
    BpDmgAcc[i] := 0;
    BpTeamAcc[i] := 0;
    BpHealAcc[i] := 0;
    BpRepairAcc[i] := 0;
    BpAmmoAcc[i] := 0;
    BpKilledBy[i] := 0;
    BpMultiN[i] := 0;
    BpSvTarget[i] := 0;
    BpLastPart[i] := 0;
    BpDmgPend[i] := 0;
    BpTeamPend[i] := 0;
    for k := 0 to PE_LAST do
      BpEvPend[i][k] := 0;
    if ActiveSlot[i] then
      HudMarkL(i, HLB_SCORE);
  end;
  BpFirstDone := False;
  for k := 1 to 2 do
  begin
    BpFlagPaid[k] := False;
    BpFlagAway[k] := False;
  end;
  if BpKept <> nil then
    BpKept.Clear;
  BpRefresh();
end;

{ his key for the scores kept on this map (his computer id, known at the join; else his key) }
function BpKeyOf(ID: Integer): string;
begin
  Result := '';
  if HumanOf[ID] then
    if Trim(PL[ID].HWID) <> '' then
      Result := 'H' + Trim(PL[ID].HWID);
  if Result = '' then
    Result := AdKeyOf(ID);
  Result := ReplaceAll(Result, '=', '_');
end;

{ a player comes: nothing yet - or his score of this map when he was here before }
procedure BpSetup(ID: Integer);
var
  i, k: Integer;
begin
  BpScore[ID] := 0;
  BpGain[ID] := 0;
  BpGainUntil[ID] := 0;
  BpDmgAcc[ID] := 0;
  BpTeamAcc[ID] := 0;
  BpHealAcc[ID] := 0;
  BpRepairAcc[ID] := 0;
  BpAmmoAcc[ID] := 0;
  BpKilledBy[ID] := 0;
  BpMultiN[ID] := 0;
  BpMultiTick[ID] := 0;
  BpSvTarget[ID] := 0;
  BpLastPart[ID] := 0;
  BpDmgPend[ID] := 0;
  BpTeamPend[ID] := 0;
  for k := 0 to PE_LAST do
    BpEvPend[ID][k] := 0;
  for i := 1 to 32 do
    if BpKilledBy[i] = ID then
      BpKilledBy[i] := 0;
  if BpKept <> nil then
  begin
    k := BpKept.IndexOfName(BpKeyOf(ID));
    if k >= 0 then
    begin
      BpScore[ID] := StrToIntDef(Copy(BpKept[k], Pos('=', BpKept[k]) + 1, 12), 0);
      BpKept.Delete(k);
    end;
  end;
end;

{ he leaves: his score waits for him on this map }
procedure BpLeave(ID: Integer);
var
  K0: string;
  k: Integer;
begin
  if BpKept = nil then
    Exit;
  if BpScore[ID] = 0 then
    Exit;
  K0 := BpKeyOf(ID);
  k := BpKept.IndexOfName(K0);
  if k >= 0 then
    BpKept.Delete(k);
  if BpKept.Count >= 200 then
    BpKept.Delete(0);
  BpKept.Add(K0 + '=' + IntToStr(BpScore[ID]));
end;

{ the tick: what the modules owe is paid (every 10 ticks: the line is not redrawn for every hit), a gain that is over
  leaves the line (twice a second), the board goes }
procedure BpTick(Tick: Integer);
var
  i: Integer;
begin
  if BpPendAny then
    if Tick mod 10 = 0 then
  begin
    BpPendAny := False;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        BpPay(i);
  end;
  if BpBoardUntil > 0 then
    if Tick >= BpBoardUntil then
    begin
      BpBoardUntil := 0;
      for i := 1 to TopSlot do
        if ActiveSlot[i] then
          if HumanOf[i] then
          begin
            PL[i].BigText(BpBoardLayer, ' ', 1, ColorGood, 0.01, 0, 0);
            PL[i].BigText(BpBoardLayer + 1, ' ', 1, ColorGood, 0.01, 0, 0);
          end;
    end;
  if Tick mod 30 <> 0 then
    Exit;
  for i := 1 to TopSlot do
    if BpGainUntil[i] > 0 then
      if Tick > BpGainUntil[i] then
      begin
        BpGainUntil[i] := 0;
        BpGain[i] := 0;
        if ActiveSlot[i] then
          HudMarkL(i, HLB_SCORE);
      end;
end;

{ ============ round 21: [Classes] - the Battlefield classes ============ }

{ ---------------- the classes ---------------- }

{ a class of this game mode }
function ClsModeOk(k: Integer): Boolean;
begin
  Result := ((ClsModeBits[k] shr GameStyleNow()) and 1) <> 0;
end;

{ a class he may play: of this mode, and of his side - the insurgents' classes for the insurgents while [Insurgents]
  is on, the others for everybody else (and for all while it is off) }
function ClsFor(ID, k: Integer): Boolean;
begin
  Result := ClsModeOk(k);
  if not Result then
    Exit;
  if InsActive then
    Result := ClsIns[k] = InsIsIns(ID)
  else
    Result := not ClsIns[k];
end;

{ a class with a primary weapon the server lets anybody hold (else nobody could play it) }
function ClsHasPrimary(k: Integer): Boolean;
var
  w: Integer;
begin
  Result := ClsMenu[k] = 0;
  for w := 1 to 10 do
    if (ClsMenu[k] and (1 shl w)) <> 0 then
      if ShWeaponOk(w) then
        Result := True;
end;

{ the players of team Tm in class k now or in their next life (but ID; spectators never count) }
function ClsTeamCount(Tm, k, ID: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to TopSlot do
    if i <> ID then
      if ActiveSlot[i] then
        if TeamOf[i] = Tm then
          if ClsNow(i) = k then
            Result := Result + 1;
end;

{ at most this many of team Tm in class k (1000 = no limit; a percent of the team: at least 1) }
function ClsCap(k, Tm: Integer): Integer;
var
  i, n: Integer;
begin
  Result := 1000;
  if ClsMaxN[k] > 0 then
    Result := ClsMaxN[k]
  else if ClsMaxPct[k] > 0 then
  begin
    n := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if TeamOf[i] = Tm then
          n := n + 1;
    Result := (n * ClsMaxPct[k] + 99) div 100;
    if Result < 1 then
      Result := 1;
  end;
end;

{ the class rolled for him: of this mode, with a primary the server allows, not full; Balance: the fewest of his team,
  then the one he played least on this map; not his class again (Repeat = 0) while another is left }
function ClsRoll(ID: Integer): Integer;
var
  k, Tm, n, r, MinC, MinP, Cur: Integer;
  Cand: array[1..20] of Boolean;
  Cnt: array[1..20] of Integer;
begin
  Result := 0;
  if ClsCount = 0 then
    Exit;
  Tm := TeamOf[ID];
  n := 0;
  for k := 1 to ClsCount do
  begin
    Cnt[k] := ClsTeamCount(Tm, k, ID);
    Cand[k] := False;
    if ClsFor(ID, k) then
      if ClsHasPrimary(k) then
        if Cnt[k] < ClsCap(k, Tm) then
          Cand[k] := True;
    if Cand[k] then
      n := n + 1;
  end;
  { every class full: any of this mode }
  if n = 0 then
    for k := 1 to ClsCount do
      if ClsFor(ID, k) then
        if ClsHasPrimary(k) then
        begin
          Cand[k] := True;
          n := n + 1;
        end;
  if n = 0 then
    Exit;
  Cur := ClsOf[ID];
  if not ClsRepeat then
    if n > 1 then
      if (Cur >= 1) and (Cur <= ClsCount) then
        if Cand[Cur] then
        begin
          Cand[Cur] := False;
          n := n - 1;
        end;
  if ClsBalance then
  begin
    MinC := 100000;
    for k := 1 to ClsCount do
      if Cand[k] then
        if Cnt[k] < MinC then
          MinC := Cnt[k];
    MinP := 100000;
    for k := 1 to ClsCount do
      if Cand[k] then
        if Cnt[k] > MinC then
        begin
          Cand[k] := False;
          n := n - 1;
        end
        else if ClsPlayed[ID][k] < MinP then
          MinP := ClsPlayed[ID][k];
    for k := 1 to ClsCount do
      if Cand[k] then
        if ClsPlayed[ID][k] > MinP then
        begin
          Cand[k] := False;
          n := n - 1;
        end;
  end;
  if n <= 0 then
    Exit;
  r := Random(0, n);
  for k := 1 to ClsCount do
    if Cand[k] then
    begin
      if r = 0 then
      begin
        Result := k;
        ClsStatRolls := ClsStatRolls + 1;
        Exit;
      end;
      r := r - 1;
    end;
end;

{ the class a word or a number means (0 = none) }
function ClsOfWord(W: string): Integer;
var
  k, n: Integer;
begin
  Result := 0;
  W := LowerCase(Trim(W));
  if W = '' then
    Exit;
  n := StrToIntDef(W, 0);
  if (n >= 1) and (n <= ClsCount) then
  begin
    Result := n;
    Exit;
  end;
  for k := 1 to ClsCount do
    if (Pos('|' + W + '|', ClsWords[k]) > 0) or (LowerCase(ClsName[k]) = W) then
    begin
      Result := k;
      Exit;
    end;
end;

{ the weapons of a class: "AK-74, Steyr AUG / SOCOM, knife" }
function ClsWeaponsText(c: Integer): string;
var
  k: Integer;
  A, B: string;
begin
  A := '';
  B := '';
  if ClsMenu[c] = 0 then
  begin
    Result := 'every weapon';
    Exit;
  end;
  for k := 1 to 14 do
    if (ClsMenu[c] and (1 shl k)) <> 0 then
    begin
      if k <= 10 then
      begin
        if A <> '' then
          A := A + ', ';
        A := A + WeaponName(CyWeaponOfSlot(k));
      end
      else
      begin
        if B <> '' then
          B := B + ', ';
        B := B + WeaponName(CyWeaponOfSlot(k));
      end;
    end;
  Result := A;
  if B <> '' then
    Result := Result + ' / ' + B;
end;

{ the skills of a class for !class: "rally (15 s, every 60 s) | grenade kit (every 20 s)" }
function ClsSkillsText(c: Integer): string;
var
  n: Integer;
  T, Why: string;
begin
  Result := '';
  for n := 1 to 2 do
    if ClsSk[c][n] <> SK_NONE then
    begin
      T := ClsSkName(ClsSk[c][n]);
      if ClsSkOnT[c][n] > 0 then
        T := T + ' ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s';
      T := T + ', every ' + IntToStr(ClsSkCool[c][n] div 60) + ' s';
      Why := ClsSkWhy(ClsSk[c][n]);
      if Why <> '' then
        T := T + ' - ' + Why;
      if Result <> '' then
        Result := Result + ' | ';
      Result := Result + '!skill' + ShIf(n = 2, '2', '') + ': ' + T;
    end;
  if Result = '' then
    Result := 'no skills';
end;

{ ---------------- round 24: the choice told, its limit, one class for the whole map ---------------- }

{ the choice of his class: ChoiceText with the classes of his side (the token list) }
procedure ClsTellChoice(ID: Integer);
var
  c: Integer;
  L: string;
begin
  if ClsChoiceText = '' then
    Exit;
  L := '';
  for c := 1 to ClsCount do
    if ClsFor(ID, c) then
    begin
      if L <> '' then
        L := L + ', ';
      L := L + ClsName[c];
    end;
  Say(ID, ReplaceAll(ClsChoiceText, '{list}', L), ClsHudColor);
end;

{ Assign = limited: class c may be his choice - his team has fewer than LimitedSpread players in it more than in the
  class it has fewest of (of the other classes of his side that are not full) }
function ClsLimitOk(ID, c: Integer): Boolean;
var
  k, n, Least, Tm: Integer;
begin
  Result := True;
  Tm := TeamOf[ID];
  Least := 1000;
  for k := 1 to ClsCount do
    if k <> c then
      if ClsFor(ID, k) then
        if ClsHasPrimary(k) then
      begin
        n := ClsTeamCount(Tm, k, ID);
        if n < ClsCap(k, Tm) then
          if n < Least then
            Least := n;
      end;
  if Least >= 1000 then
    Exit;
  Result := ClsTeamCount(Tm, c, ID) < Least + ClsSpread;
end;

{ Assign = map: his class of this map, kept by his keys (his computer id, his account): leaving and coming back
  rolls no new one (0 = none) }
function ClsMapFind(ID: Integer): Integer;
var
  n, k: Integer;
  K0: string;
begin
  Result := 0;
  if ClsMapStore = nil then
    Exit;
  for n := 0 to 1 do
    if Result = 0 then
    begin
      K0 := ShMapKey(ID, n = 1);
      if K0 <> '' then
      begin
        k := ClsMapStore.IndexOfName(K0);
        if k >= 0 then
          Result := StrToIntDef(Copy(ClsMapStore[k], Pos('=', ClsMapStore[k]) + 1, 10), 0);
      end;
    end;
  if (Result < 1) or (Result > ClsCount) then
    Result := 0;
end;

procedure ClsMapKeep(ID, c: Integer);
var
  n, k: Integer;
  K0: string;
begin
  if ClsMapStore = nil then
    ClsMapStore := File.CreateStringList();
  for n := 0 to 1 do
  begin
    K0 := ShMapKey(ID, n = 1);
    if K0 <> '' then
    begin
      k := ClsMapStore.IndexOfName(K0);
      if k >= 0 then
        ClsMapStore.Delete(k);
      ClsMapStore.Add(K0 + '=' + IntToStr(c));
    end;
  end;
end;

{ Assign = map: the class kept for him on this map when it is one of his side, else one rolled and kept }
function ClsMapClass(ID: Integer): Integer;
begin
  Result := ClsMapFind(ID);
  if Result > 0 then
    if not ClsFor(ID, Result) then
      Result := 0;
  if Result = 0 then
  begin
    Result := ClsRoll(ID);
    if Result > 0 then
      ClsMapKeep(ID, Result);
  end;
end;

{ ---------------- the weapons of a class ---------------- }

{ a weapon he may hold: the server's list; one of the shop (bought in this life, or his own with BuyOnly - the class
  does not limit what he pays for); else his class's }
function ClsWeaponOk(ID, W: Integer): Boolean;
begin
  Result := False;
  if not ShWeaponOk(W) then
    Exit;
  if ShActive then
  begin
    if (W >= 0) and (W <= 16) then
      if ShBought[ID][W] > 0 then
      begin
        Result := True;
        Exit;
      end;
    if ShBuyOnly then
    begin
      Result := ShOwnsWeapon(ID, W);
      Exit;
    end;
  end;
  Result := ClsAllows(ID, W, False);
end;

{ a primary of his class he may hold: the one he chose last when it still is, else one of them (Rand: any, else the
  first); -1 = none }
function ClsPrimaryFor(ID: Integer; Rand: Boolean): Integer;
var
  w, n: Integer;
begin
  Result := -1;
  if (ClsPick[ID] >= 1) and (ClsPick[ID] <= 10) then
    if ClsWeaponOk(ID, ClsPick[ID]) then
    begin
      Result := ClsPick[ID];
      Exit;
    end;
  n := 0;
  for w := 1 to 10 do
    if ClsWeaponOk(ID, w) then
    begin
      n := n + 1;
      if Result < 0 then
        Result := w
      else if Rand then
        if Random(0, n) = 0 then
          Result := w;
    end;
end;

{ a secondary of his class he may hold (-1 = none): SOCOM, knife, chainsaw, LAW in that order }
function ClsSecondaryFor(ID: Integer): Integer;
begin
  Result := -1;
  if ClsWeaponOk(ID, 0) then
    Result := 0
  else if ClsWeaponOk(ID, 11) then
    Result := 11
  else if ClsWeaponOk(ID, 12) then
    Result := 12
  else if ClsWeaponOk(ID, 13) then
    Result := 13;
end;

{ his weapons are of his class: a weapon that is not (an altered client, a menu that came late, a bot - the server's
  bots ignore the menu) is replaced by one that is, with full magazines }
procedure ClsArm(ID: Integer);
var
  P: TActivePlayer;
  W, S, NWt, NSt: Integer;
  OkW, OkS: Boolean;
  NW, NS: TNewWeapon;
begin
  if not ClsActive then
    Exit;
  if (ClsOf[ID] < 1) or (ClsOf[ID] > ClsCount) then
    Exit;
  P := PL[ID];
  if not P.Alive then
    Exit;
  if DwDown[ID] then
    Exit;
  W := P.Primary.WType;
  S := P.Secondary.WType;
  { no primary: a player's choice; a bot (BuyOnly took his, he bought none) gets his class's }
  OkW := True;
  if W <> WEP_NONE then
    OkW := ClsWeaponOk(ID, W)
  else if not HumanOf[ID] then
    OkW := ClsPrimaryFor(ID, True) < 0
  else if Game.TickCount - ClsSpawnTick[ID] <= 180 then
    if ClsArmN[ID] < 2 then
    begin
      { his choice was refused by his game (the new menu came after it) or came too late: his class's own }
      ClsArmN[ID] := ClsArmN[ID] + 1;
      OkW := ClsPrimaryFor(ID, False) < 0;
    end;
  OkS := (S = WEP_NONE) or ClsWeaponOk(ID, S);
  if (W >= 1) and (W <= 10) then
    if OkW then
      ClsPick[ID] := W;
  if OkW and OkS then
    Exit;
  NWt := W;
  NSt := S;
  if not OkW then
    NWt := ClsPrimaryFor(ID, not HumanOf[ID]);
  if not OkS then
    NSt := ClsSecondaryFor(ID);
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NW.WType := WEP_NONE;
    NS.WType := WEP_NONE;
    if NWt >= 0 then
    begin
      NW.WType := NWt;
      if OkW then
        NW.Ammo := P.Primary.Ammo
      else
        NW.Ammo := ShMagOf(NWt);
    end;
    if NSt >= 0 then
    begin
      NS.WType := NSt;
      if OkS then
        NS.Ammo := P.Secondary.Ammo
      else
        NS.Ammo := ShMagOf(NSt);
    end;
    P.ForceWeapon(NW, NS);
    AmGiven(ID);
    if AmmoEnabled then
      if BeOk then
        if (NW.WType >= 0) and (NW.WType <= 16) then
          BE_AmmoForced(ID, Game.TickCount, NW.WType, NW.Ammo);
  finally
    NW.Free;
    NS.Free;
  end;
  AcAmmoTouched(ID);
  if HumanOf[ID] then
    if not OkW then
      Say(ID, 'Not a weapon of your class (' + ClsName[ClsOf[ID]] + ': ' + ClsWeaponsText(ClsOf[ID]) + ').', ColorBad);
end;

{ a weapon came into his hands (OnWeaponChange): in the first 3 s of a life it is the menu's - a lagging player's
  choice can come after the check of his respawn - so it is checked again in the next ticks; later it is a weapon
  picked up }
procedure ClsWeaponSeen(ID: Integer);
var
  Tick: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not HumanOf[ID] then
    Exit;
  Tick := Game.TickCount;
  if Tick - ClsSpawnTick[ID] > 180 then
    Exit;
  if ClsCheckAt[ID] = 0 then
    ClsCheckAny := ClsCheckAny + 1;
  ClsCheckAt[ID] := Tick + 2;
end;

{ ---------------- the class of a player ---------------- }

{ the loadout of his class (the respawn): what it names replaces what the modules gave; LoadoutOnly: what it does not
  name of those items is none; RespectShopOnly: nothing the shop sells only }
{ what he has of a loadout now (the quick class change compares with it) }
procedure ClsLoSnap(ID: Integer);
begin
  ClsLoGiven[ID][0] := FnNadeLeft[ID];
  ClsLoGiven[ID][1] := FnFlashLeft[ID];
  ClsLoGiven[ID][2] := MnHave[ID];
  ClsLoGiven[ID][3] := MnHaveC[ID];
  ClsLoGiven[ID][4] := RkUsed[ID];
  ClsLoGiven[ID][5] := ClsC4Left[ID];
  ClsLoGiven[ID][6] := BdKits[ID];
end;

procedure ClsGiveLoadout(ID, c: Integer);
var
  Kits, Shop: Integer;
  Band: Single;
begin
  if (c < 1) or (c > ClsCount) then
    Exit;
  Shop := 0;
  if ClsRespectShopOnly then
    if ShActive then
      Shop := ShShopOnly;
  if RkEnabled then
    if (Shop and 4) = 0 then
    begin
      if ClsLoad[c][LO_JAVS] >= 0 then
      begin
        RkUsed[ID] := RkRockets - ClsLoad[c][LO_JAVS];
        if RkUsed[ID] < 0 then
          RkUsed[ID] := 0;
      end
      else if (ClsLoadoutOnly and 1) <> 0 then
        RkUsed[ID] := RkRockets;
    end;
  if MnEnabled then
  begin
    if (Shop and 1) = 0 then
    begin
      if ClsLoad[c][LO_MINES] >= 0 then
        MnHave[ID] := ClsLoad[c][LO_MINES]
      else if (ClsLoadoutOnly and 2) <> 0 then
        MnHave[ID] := 0;
    end;
    if (Shop and 2) = 0 then
    begin
      if ClsLoad[c][LO_CLAYS] >= 0 then
        MnHaveC[ID] := ClsLoad[c][LO_CLAYS]
      else if (ClsLoadoutOnly and 4) <> 0 then
        MnHaveC[ID] := 0;
    end;
  end;
  if FnEnabled then
  begin
    if ClsLoad[c][LO_NADES] >= 0 then
      FnNadeLeft[ID] := ClsLoad[c][LO_NADES];
    if (Shop and 8) = 0 then
    begin
      if ClsLoad[c][LO_FLASHES] >= 0 then
        FnFlashLeft[ID] := ClsLoad[c][LO_FLASHES]
      else if (ClsLoadoutOnly and 8) <> 0 then
        FnFlashLeft[ID] := 0;
    end;
    FnAutoType(ID);
    FnNeed[ID] := True;
  end
  else if ClsLoad[c][LO_NADES] > 0 then
    if ObjectsFree(OBJECT_MARGIN) >= OBJECT_MARGIN then
      PL[ID].GiveBonus(4);
  if ClsLoad[c][LO_VEST] >= 0 then
    PL[ID].Vest := ClsLoad[c][LO_VEST];
  ClsC4Left[ID] := ClsLoad[c][LO_C4];
  if ClsC4Left[ID] < 0 then
    ClsC4Left[ID] := 0;
  if BdActive then
    if (ClsLoad[c][LO_BAND] >= 0) or (ClsLoad[c][LO_KITS] >= 0) then
    begin
      Band := BdBand[ID];
      Kits := BdKits[ID];
      if ClsLoad[c][LO_BAND] >= 0 then
        Band := ClsLoad[c][LO_BAND];
      if ClsLoad[c][LO_KITS] >= 0 then
        Kits := ClsLoad[c][LO_KITS];
      if BeOk then
        BE_BodySupplies(ID, Band, Kits, 0);
      BdSync(ID);
    end;
  ClsLoSnap(ID);
  HudMark(ID, False);
end;

{ the class's perks the library keeps (the bandaging and reviving speed, the reach of a revive; the spare magazines) }
procedure ClsPerksApply(ID: Integer);
var
  c, n: Integer;
begin
  if not BeOk then
    Exit;
  c := ClsOf[ID];
  if ClsActive and (c >= 1) and (c <= ClsCount) then
  begin
    BE_BodyPerk(ID, ClsBandF[c], ClsReviveF[c], ClsReviveR[c]);
    BE_BodyMedic(ID, ClsMedicR[c]);
    n := ClsLoad[c][LO_MAGS];
    if n < 0 then
      n := 0;
    if AmmoEnabled then
      BE_AmmoPlayerExtra(ID, n);
  end
  else
  begin
    BE_BodyPerk(ID, 1, 1, 0);
    BE_BodyMedic(ID, 0);
    if AmmoEnabled then
      BE_AmmoPlayerExtra(ID, 0);
  end;
end;

{ his class of the next life (a choice, a roll): his weapon menu now (it shows at his death) }
procedure ClsSetNext(ID, c: Integer; Tell: Boolean);
begin
  if (c < 1) or (c > ClsCount) then
    Exit;
  if c = ClsOf[ID] then
    ClsNext[ID] := 0
  else
    ClsNext[ID] := c;
  ShMaskSend(ID);
  if Tell then
    if HumanOf[ID] then
      Say(ID, ReplaceAll(ClsNextText, '{class}', ClsName[c]), ClsColor[c]);
  HudMarkL(ID, HLB_CLASS);
end;

{ he plays class c from now on: its perks, his menu, a word to him }
procedure ClsSet(ID, c: Integer; Tell: Boolean);
var
  k: Integer;
begin
  if (c < 1) or (c > ClsCount) then
    Exit;
  if ClsOf[ID] <> c then
  begin
    ClsLast[ID] := ClsOf[ID];
    { G24: the new class's skills wait as long as he last used the same skill (in any class) }
    for k := 1 to 2 do
    begin
      ClsCool[ID][k] := 0;
      ClsOn[ID][k] := 0;
      if (ClsSk[c][k] >= 1) and (ClsSk[c][k] <= 15) then
        ClsCool[ID][k] := ClsKindCool[ID][ClsSk[c][k]];
    end;
  end;
  ClsOf[ID] := c;
  ClsNext[ID] := 0;
  ClsPlayed[ID][c] := ClsPlayed[ID][c] + 1;
  ClsPerksApply(ID);
  ShMaskSend(ID);
  InsVestDirty[ID] := True;
  { a test server without players ([Debug] BotsSeeTexts): who plays what }
  if DebugBots then
    Log('[Classes] ' + PL[ID].Name + ': ' + ClsName[c]);
  if Tell then
    if HumanOf[ID] then
      Say(ID, ReplaceAll(ReplaceAll(ClsClassText, '{class}', ClsName[c]), '{info}', ClsInfo[c]), ClsColor[c]);
  HudMarkL(ID, HLB_CLASS);
end;

{ ---------------- the objects of the classes (a healthpack, a grenade kit) ---------------- }

{ a kit of a class on the map: [Kits] leaves it alone for its whole time (KitSeconds, the registry takes it away) }
function ClsSpawnObj(Style: Integer; X, Y: Single): Integer;
var
  O: TNewMapObject;
  A: TActiveMapObject;
begin
  Result := 0;
  if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
    Exit;
  O := TNewMapObject.Create;
  try
    O.Style := Style;
    O.X := X;
    O.Y := Y;
    A := Map.AddObject(O);
    if A <> nil then
      if (A.ID >= 1) and (A.ID <= MAX_OBJECT_ID) then
      begin
        Result := A.ID;
        ObjKeep[A.ID] := After(Game.TickCount, ClsObjTicks + 120);
      end;
  finally
    O.Free;
  end;
end;

{ the registry's entry of a map object (-1 = not a class's) }
function ClsObjOf(Slot: Integer): Integer;
var
  k: Integer;
begin
  Result := -1;
  for k := 0 to ClsObjN - 1 do
    if ClsObjSlot[k] = Slot then
      Result := k;
end;

{ entry k goes (Kill: its object too, when it still is the one) }
procedure ClsObjRemove(k: Integer; Kill: Boolean);
var
  s: Integer;
begin
  if (k < 0) or (k >= ClsObjN) then
    Exit;
  s := ClsObjSlot[k];
  if Kill then
    if (s >= 1) and (s <= MAX_OBJECT_ID) then
      if OB[s].Active then
        if OB[s].Style = ClsObjStyle[k] then
          OB[s].Kill;
  ClsObjN := ClsObjN - 1;
  ClsObjSlot[k] := ClsObjSlot[ClsObjN];
  ClsObjStyle[k] := ClsObjStyle[ClsObjN];
  ClsObjOwner[k] := ClsObjOwner[ClsObjN];
  ClsObjEnd[k] := ClsObjEnd[ClsObjN];
end;

{ his objects go (Style 0: all of them) }
procedure ClsObjForget(ID, Style: Integer);
var
  k: Integer;
begin
  for k := ClsObjN - 1 downto 0 do
    if ClsObjOwner[k] = ID then
      if (Style = 0) or (ClsObjStyle[k] = Style) then
        ClsObjRemove(k, True);
end;

{ a kit of his class next to him (one of each kind: his last one goes) }
function ClsDropKit(ID, Style, Tick: Integer): Boolean;
var
  P: TActivePlayer;
  X, GY: Single;
  s: Integer;
begin
  Result := False;
  if ClsObjN > 31 then
  begin
    Say(ID, 'Too many kits of the classes on the map.', ColorBad);
    Exit;
  end;
  ClsObjForget(ID, Style);
  P := PL[ID];
  { the aim is a whole number: compared through a Single (a direct comparison is a type mismatch) }
  X := P.MouseAimX;
  if X < P.X then
    X := P.X - 16
  else
    X := P.X + 16;
  GY := P.Y - 12;
  if BeOk then
    if MapOk then
      if BE_ShopGround(X, P.Y - 30, 200, GY) = 1 then
        GY := GY - 6;
  s := ClsSpawnObj(Style, X, GY);
  if s = 0 then
  begin
    Say(ID, 'No room for another object on the map.', ColorBad);
    Exit;
  end;
  ClsObjSlot[ClsObjN] := s;
  ClsObjStyle[ClsObjN] := Style;
  ClsObjOwner[ClsObjN] := ID;
  ClsObjEnd[ClsObjN] := Tick + ClsObjTicks;
  ClsObjN := ClsObjN + 1;
  Result := True;
end;

{ OnKitEv: a class's kit taken - its owner's points (a mate: KitTaken, an enemy: KitEnemy) }
function ClsKitTaken(ID, Slot: Integer): Boolean;
var
  k, O, St, Tick: Integer;
  Need: Boolean;
begin
  Result := False;
  k := ClsObjOf(Slot);
  if k < 0 then
    Exit;
  Result := True;
  O := ClsObjOwner[k];
  St := ClsObjStyle[k];
  ClsObjRemove(k, False);
  if (O >= 1) and (O <= 32) and (ID >= 1) and (ID <= 32) then
    if O <> ID then
      if ActiveSlot[O] then
      begin
        if Enemies(O, ID) then
          BpEvent(O, PE_KITENEMY)
        else
        begin
          { the mate needed it: a healthpack below 60 % of the health or with a wound, a grenade kit with no grenade }
          Need := True;
          if St = OBJECT_MEDKIT then
            Need := (LastHealth[ID] < MaxHealth * 0.6) or (BdWounds[ID] > 0)
          else if FnEnabled then
            Need := FnNadeLeft[ID] <= 0;
          Tick := Game.TickCount;
          if Need then
            if (ClsKitPaid[O][ID] = 0) or (Tick - ClsKitPaid[O][ID] >= 3600) then
            begin
              ClsKitPaid[O][ID] := Tick;
              BpEvent(O, PE_KITTAKEN);
            end;
        end;
      end;
end;

{ ---------------- round 22: C4, the sensor, the mortar from the sky ---------------- }

{ the free air over the ground at X, GY: how high the column is with nothing that stops a bullet (at most 450 px;
  without the map's walls 450) }
function ClsSkyOver(X, GY: Single): Single;
var
  Lo, Hi, Mid: Single;
  k: Integer;
begin
  Result := 450;
  if not (BeOk and MapOk) then
    Exit;
  if BE_MapRay(X, GY - 8, X, GY - 450, MR_BULLET, 0) <> 1 then
    Exit;
  Lo := 8;
  Hi := 450;
  for k := 1 to 7 do
  begin
    Mid := (Lo + Hi) / 2;
    if BE_MapRay(X, GY - 8, X, GY - Mid, MR_BULLET, 0) = 1 then
      Hi := Mid
    else
      Lo := Mid;
  end;
  Result := Lo;
end;

{ his C4 mark over a tagged enemy (slot 0-3 of his; '' takes it away) }
procedure ClsC4Mark(Tagger, V: Integer; On: Boolean);
begin
  if (Tagger < 1) or (Tagger > 32) then
    Exit;
  if On then
    LfOver(Tagger, ClsC4Layer + ClsC4Slot[V], 'C4', PL[V].X, PL[V].Y, 0.05, 34, 40, $FF4040)
  else
    LfOver(Tagger, ClsC4Layer + ClsC4Slot[V], '', 0, 0, 0.01, 0, 1, ColorGood);
end;

{ the C4 on V goes (Why: told to both; '' = quietly) }
procedure ClsC4Off(V: Integer; Why: string);
var
  T: Integer;
begin
  T := ClsC4By[V];
  if T = 0 then
    Exit;
  ClsC4Mark(T, V, False);
  ClsC4By[V] := 0;
  ClsC4Low[V] := 0;
  ClsC4Any := ClsC4Any - 1;
  if ClsC4Any < 0 then
    ClsC4Any := 0;
  if Why <> '' then
  begin
    if ActiveSlot[T] then
      if HumanOf[T] then
        Say(T, 'Your C4 on ' + PL[V].Name + ': ' + Why + '.', ColorBad);
  end;
end;

{ every C4 of tagger T goes (his death, he leaves) }
procedure ClsC4Drop(T: Integer);
var
  v: Integer;
begin
  if ClsC4Any = 0 then
    Exit;
  for v := 1 to 32 do
    if ClsC4By[v] = T then
      ClsC4Off(v, '');
end;

{ the enemy nearest to his aim within Range px of him, with nothing between them, not tagged yet (0 = none) }
{ CLS13: in realistic mode a soldier sees an enemy only in front of his aim and within 1001 px (the game's rule, KB
  round 2) - the skills that pick an enemy he sees follow it }
function ClsRealSees(PX, PY, AX, AY, EX, EY: Single): Boolean;
begin
  Result := True;
  if not Realistic then
    Exit;
  if (EX - PX) * (AX - PX) + (EY - PY) * (AY - PY) <= 0 then
    Result := False
  else if (EX - PX) * (EX - PX) + (EY - PY) * (EY - PY) > 1001.0 * 1001.0 then
    Result := False;
end;

function ClsC4Target(ID: Integer; Range: Single): Integer;
var
  e: Integer;
  P: TActivePlayer;
  AX, AY, D, Best: Single;
begin
  Result := 0;
  P := PL[ID];
  AX := P.MouseAimX;
  AY := P.MouseAimY;
  Best := 100000000;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
      if e <> ID then
        if ClsC4By[e] = 0 then
          if PL[e].Alive then
            if Enemies(ID, e) then
            begin
              D := (PL[e].X - P.X) * (PL[e].X - P.X) + (PL[e].Y - P.Y) * (PL[e].Y - P.Y);
              if D <= Range * Range then
                if ClsRealSees(P.X, P.Y, AX, AY, PL[e].X, PL[e].Y) then
                if not Ray(P.X, P.Y - 10, PL[e].X, PL[e].Y - 10, False) then
                begin
                  D := (PL[e].X - AX) * (PL[e].X - AX) + (PL[e].Y - AY) * (PL[e].Y - AY);
                  if D < Best then
                  begin
                    Best := D;
                    Result := e;
                  end;
                end;
            end;
end;

{ !skill c4: a charge stuck on the enemy nearest to his aim; True when it stuck }
function ClsC4Tag(ID: Integer; Range: Single): Boolean;
var
  v, s, k: Integer;
  Free: array[0..3] of Boolean;
begin
  Result := False;
  if ClsC4Left[ID] <= 0 then
  begin
    Say(ID, 'You have no C4 left in this life.', ColorBad);
    Exit;
  end;
  for k := 0 to 3 do
    Free[k] := True;
  for v := 1 to 32 do
    if ClsC4By[v] = ID then
      if (ClsC4Slot[v] >= 0) and (ClsC4Slot[v] <= 3) then
        Free[ClsC4Slot[v]] := False;
  s := -1;
  for k := 3 downto 0 do
    if Free[k] then
      s := k;
  if s < 0 then
  begin
    Say(ID, 'You have 4 charges on enemies already - /c4 sets them off.', ColorBad);
    Exit;
  end;
  v := ClsC4Target(ID, Range);
  if v = 0 then
  begin
    Say(ID, 'No enemy you can see within ' + IntToStr(Round(Range)) + ' px of you.', ColorBad);
    Exit;
  end;
  ClsC4By[v] := ID;
  ClsC4Slot[v] := s;
  ClsC4Low[v] := 0;
  ClsC4At[v] := Game.TickCount;
  ClsC4Any := ClsC4Any + 1;
  ClsC4Left[ID] := ClsC4Left[ID] - 1;
  ClsStatC4 := ClsStatC4 + 1;
  ClsC4Mark(ID, v, True);
  Say(ID, 'C4 on ' + PL[v].Name + ' (' + IntToStr(ClsC4Left[ID]) + ' left) - /c4 sets it off.', ClsHudColor);
  if HumanOf[v] then
    Say(v, 'C4 stuck on you! Lie down for ' + IntToStr((ClsC4Scrape + 59) div 60) + ' s to scrape it off.', ColorBad);
  HudMarkL(ID, HLB_CLASS);
  Result := True;
end;

{ /c4: his charges go off - a blast inside each tagged body (it surely goes off there; the kill is his) }
procedure CmdC4(ID: Integer);
var
  v, n, Young, B, Tick: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ClsActive then
  begin
    Say(ID, 'Classes are off here (' + ClsIdleWhy + ').', ColorBad);
    Exit;
  end;
  if PausedNow then
  begin
    Say(ID, 'Not during a pause.', ColorBad);
    Exit;
  end;
  { CLS2: not from the ground (down) or in shock }
  if DwDown[ID] or (BdShockUntil[ID] > 0) then
  begin
    Say(ID, 'You cannot set it off now.', ColorBad);
    Exit;
  end;
  Tick := Game.TickCount;
  n := 0;
  Young := 0;
  for v := 1 to 32 do
    if ClsC4By[v] = ID then
    begin
      { a charge is armed 2 s after it was put on (the tagged one has his moment to scrape it off) }
      if Tick - ClsC4At[v] < 120 then
        Young := Young + 1
      else
      begin
        if ActiveSlot[v] then
          if PL[v].Alive then
            if BulletRoom(2) then
            begin
              B := ScriptBullet(PL[v].X, PL[v].Y - 6, 0, 3, 1, 4, PL[ID]);
              if (B >= 1) and (B <= 255) then
              begin
                ClsBulOwner[B] := ID;
                ClsBulTick[B] := Tick;
              end;
              B := ScriptBullet(PL[v].X, PL[v].Y - 14, 0, 1, 1, 10, PL[ID]);
              if (B >= 1) and (B <= 255) then
              begin
                ClsBulOwner[B] := ID;
                ClsBulTick[B] := Tick;
              end;
              n := n + 1;
            end;
        ClsC4Off(v, '');
      end;
    end;
  if Young > 0 then
    Say(ID, 'Your C4 is armed 2 s after it is put on.', ColorBad);
  if n = 0 then
  begin
    if Young = 0 then
      Say(ID, 'You have no C4 on anybody (!skill puts one on the enemy nearest to your aim).', ColorBad);
  end
  else
    HudMarkL(ID, HLB_CLASS);
end;

{ every 10 ticks: the marks follow the tagged, a tagged soldier lying down scrapes his C4 off }
procedure ClsC4Tick(Tick: Integer);
var
  v, T: Integer;
begin
  for v := 1 to TopSlot do
  begin
    T := ClsC4By[v];
    if T > 0 then
    begin
      if not (ActiveSlot[v] and ActiveSlot[T]) then
      begin
        ClsC4Off(v, '');
        Continue;
      end;
      if PL[v].IsProne then
      begin
        if ClsC4Low[v] = 0 then
          ClsC4Low[v] := Tick;
        if Tick - ClsC4Low[v] >= ClsC4Scrape then
        begin
          if HumanOf[v] then
            Say(v, 'You scraped the C4 off.', ColorGood);
          ClsC4Off(v, 'scraped off');
          Continue;
        end;
      end
      else
        ClsC4Low[v] := 0;
      if Tick mod 20 = 0 then
        ClsC4Mark(T, v, True);
    end;
  end;
end;

{ SkillSpots = radar: team Tm has the radar until tick Till (its players are radar users for that time) }
procedure ClsSkRadar(Tm, Till: Integer);
begin
  if ClsSpotsMode <> 1 then
    Exit;
  if (Tm < 1) or (Tm > 4) then
    Exit;
  if Till > ClsRadarUntil[Tm] then
  begin
    ClsRadarUntil[Tm] := Till;
    OverlayRecount();
  end;
end;

{ once a second: the sensor (the enemies within its reach on his team's radar) and the mine detector (the enemy
  mines within its reach found, with a beep) }
procedure ClsSensorTick(Tick: Integer);
var
  i, c, n, e, Tm: Integer;
  R: Single;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if PL[i].Alive then
        if not DwDown[i] then
        begin
          c := ClsOf[i];
          if (c >= 1) and (c <= ClsCount) then
          begin
            { the sensor: one of his two skills working now }
            for n := 1 to 2 do
              if ClsSk[c][n] = SK_SENSOR then
                if ClsOn[i][n] > Tick then
                begin
                  Tm := TeamOf[i];
                  R := ClsSkP1[c][n];
                  if (Tm >= 1) and (Tm <= 4) then
                    for e := 1 to TopSlot do
                      if ActiveSlot[e] then
                        if PL[e].Alive then
                          if Enemies(i, e) then
                            if (PL[e].X - PL[i].X) * (PL[e].X - PL[i].X) + (PL[e].Y - PL[i].Y) * (PL[e].Y - PL[i].Y) <=
                              R * R then
                            begin
                              if SgUntil[e][Tm] <= Tick then
                                SgAny := SgAny + 1;
                              { G16: a longer spot stays as long as it was }
                              if After(Tick, 90) > SgUntil[e][Tm] then
                              begin
                                SgUntil[e][Tm] := After(Tick, 90);
                                SgBy[e][Tm] := i;
                              end;
                              if ClsSpotsMode = 0 then
                              begin
                                SgMarkIt[e][Tm] := True;
                                SgMarkAny := True;
                              end;
                              if BeOk then
                                BE_SpotSet(e, Tm, SgUntil[e][Tm]);
                            end;
                  ClsSkRadar(Tm, ClsOn[i][n]);
                end;
            { the mine detector }
            if ClsDetR[c] > 0 then
              if MnEnabled then
                if BeOk then
                  if BE_MineDetect(i, PL[i].X, PL[i].Y, ClsDetR[c]) > 0 then
                    if HumanOf[i] then
                      PL[i].PlaySound('signal.wav', PL[i].X, PL[i].Y);
          end;
        end;
end;

{ ---------------- round 23: steal, barrage, gunship, cloak ---------------- }

{ the enemy nearest to his aim within Range px of him, with nothing between them (0 = none) }
function ClsAimedEnemy(ID: Integer; Range: Single): Integer;
var
  e: Integer;
  P: TActivePlayer;
  AX, AY, D, Best: Single;
begin
  Result := 0;
  P := PL[ID];
  AX := P.MouseAimX;
  AY := P.MouseAimY;
  Best := 100000000;
  for e := 1 to TopSlot do
    if ActiveSlot[e] then
      if e <> ID then
        if PL[e].Alive then
          if Enemies(ID, e) then
          begin
            D := (PL[e].X - P.X) * (PL[e].X - P.X) + (PL[e].Y - P.Y) * (PL[e].Y - P.Y);
            if D <= Range * Range then
              if ClsRealSees(P.X, P.Y, AX, AY, PL[e].X, PL[e].Y) then
              if not Ray(P.X, P.Y - 10, PL[e].X, PL[e].Y - 10, False) then
              begin
                D := (PL[e].X - AX) * (PL[e].X - AX) + (PL[e].Y - AY) * (PL[e].Y - AY);
                if D < Best then
                begin
                  Best := D;
                  Result := e;
                end;
              end;
          end;
end;

{ steal: the weapon in the hands of the enemy nearest to his aim comes into his (with its magazine), his own goes to
  his second hand; the robbed one takes his second weapon }
function ClsSteal(ID: Integer; Range: Single): Boolean;
var
  V, VW, VA, VS, VSA, TW, TA: Integer;
  NW, NS: TNewWeapon;
begin
  Result := False;
  V := ClsAimedEnemy(ID, Range);
  if V = 0 then
  begin
    Say(ID, 'No enemy you can see within ' + IntToStr(Round(Range)) + ' px of you.', ColorBad);
    Exit;
  end;
  VW := PL[V].Primary.WType;
  if (VW < 0) or (VW > 16) then
  begin
    Say(ID, PL[V].Name + ' holds nothing to take.', ColorBad);
    Exit;
  end;
  VA := PL[V].Primary.Ammo;
  VS := PL[V].Secondary.WType;
  VSA := PL[V].Secondary.Ammo;
  TW := PL[ID].Primary.WType;
  TA := PL[ID].Primary.Ammo;
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NW.WType := VW;
    NW.Ammo := VA;
    if (TW >= 0) and (TW <= 16) then
    begin
      NS.WType := TW;
      NS.Ammo := TA;
    end
    else
    begin
      NS.WType := PL[ID].Secondary.WType;
      NS.Ammo := PL[ID].Secondary.Ammo;
    end;
    PL[ID].ForceWeapon(NW, NS);
    AmGiven(ID);
    NS.WType := WEP_NONE;
    NS.Ammo := 0;
    if (VS >= 0) and (VS <= 16) then
    begin
      NW.WType := VS;
      NW.Ammo := VSA;
    end
    else
    begin
      NW.WType := WEP_NONE;
      NW.Ammo := 0;
    end;
    PL[V].ForceWeapon(NW, NS);
    AmGiven(V);
  finally
    NW.Free;
    NS.Free;
  end;
  if AmmoEnabled then
    if BeOk then
    begin
      BE_AmmoForced(ID, Game.TickCount, VW, VA);
      if (VS >= 0) and (VS <= 16) then
        BE_AmmoForced(V, Game.TickCount, VS, VSA);
    end;
  AcAmmoTouched(ID);
  AcAmmoTouched(V);
  ClsStatSteals := ClsStatSteals + 1;
  Say(ID, 'You took ' + PL[V].Name + '''s ' + WeaponName(VW) + '.', ClsHudColor);
  if HumanOf[V] then
    Say(V, PL[ID].Name + ' took your ' + WeaponName(VW) + '!', ColorBad);
  Result := True;
end;

{ barrage: Shells shells from the sky over each of up to Targets enemies his team sees (spotted for it, or in his own
  sight within 1200 px), a warning over them first }
function ClsBarrage(ID, Shells, Targets: Integer): Boolean;
var
  e, Tm, n, k, j: Integer;
  X, GY, H, AX, AY: Single;
  Seen: Boolean;
begin
  Result := False;
  Tm := TeamOf[ID];
  AX := PL[ID].MouseAimX;
  AY := PL[ID].MouseAimY;
  n := 0;
  for e := 1 to TopSlot do
    if n < Targets then
      if BrgCount < 16 then
        if ActiveSlot[e] then
          if PL[e].Alive then
            if Enemies(ID, e) then
            begin
              Seen := False;
              if (Tm >= 1) and (Tm <= 4) then
                if SgUntil[e][Tm] > Game.TickCount then
                  Seen := True;
              if not Seen then
                if (PL[e].X - PL[ID].X) * (PL[e].X - PL[ID].X) + (PL[e].Y - PL[ID].Y) * (PL[e].Y - PL[ID].Y) <=
                  1000 * 1000 then
                  if ClsRealSees(PL[ID].X, PL[ID].Y, AX, AY, PL[e].X, PL[e].Y) then
                    if not Ray(PL[ID].X, PL[ID].Y - 10, PL[e].X, PL[e].Y - 10, False) then
                      Seen := True;
              if Seen then
              begin
                X := PL[e].X;
                GY := PL[e].Y;
                if BeOk then
                  if MapOk then
                  begin
                    H := GY;
                    if BE_ShopGround(X, PL[e].Y - 20, 300, H) = 1 then
                      GY := H;
                  end;
                if ClsSkyOver(X, GY) < 140 then
                  Continue;
                k := BrgCount;
                BrgX[k] := X;
                BrgY[k] := GY - 2;
                BrgSp[k] := 90;
                BrgOwner[k] := ID;
                BrgN[k] := Shells;
                BrgAt[k] := Game.TickCount + 60;
                BrgCount := BrgCount + 1;
                n := n + 1;
                for j := 1 to TopSlot do
                  if ActiveSlot[j] then
                    if HumanOf[j] or DebugBots then
                      if (PL[j].X - X) * (PL[j].X - X) + (PL[j].Y - GY) * (PL[j].Y - GY) <= 900 * 900 then
                        PL[j].WorldText(ClsMortarLayer, 'INCOMING', 150, $FF4040, 0.07, X - 26, GY - 40);
                if HumanOf[e] then
                  Say(e, 'Incoming fire on you!', ColorBad);
              end;
            end;
  if n = 0 then
  begin
    Say(ID, 'Your team sees no enemy for a barrage.', ColorBad);
    Exit;
  end;
  Say(ID, 'Barrage on ' + IntToStr(n) + ' ' + ShIf(n = 1, 'enemy', 'enemies') + '.', ClsHudColor);
  Result := True;
end;

{ the barrage's shells: one every 15 ticks over each target, from the free air (three bursts spreading as they fall) }
procedure ClsBarrageTick(Tick: Integer);
var
  k, j, b, Own: Integer;
  X, Sky: Single;
begin
  for k := BrgCount - 1 downto 0 do
  begin
    Own := BrgOwner[k];
    if (BrgN[k] > 0) and (Tick >= BrgAt[k]) then
    begin
      BrgN[k] := BrgN[k] - 1;
      BrgAt[k] := Tick + 15;
      if ActiveSlot[Own] then
      begin
        X := BrgX[k] + Random(-Round(BrgSp[k]), Round(BrgSp[k]) + 1) * 0.5;
        Sky := ClsSkyOver(X, BrgY[k]);
        if BulletRoom(3) then
          for j := 0 to 2 do
          begin
            b := ScriptBullet(X + (j - 1) * 6, BrgY[k] - Sky + 6, (j - 1) * 1.2, 7, 1, 10, PL[Own]);
            if (b >= 1) and (b <= 255) then
            begin
              ClsBulOwner[b] := Own;
              ClsBulTick[b] := Tick;
            end;
          end;
      end
      else
        BrgN[k] := 0;
    end;
    if BrgN[k] <= 0 then
    begin
      BrgCount := BrgCount - 1;
      BrgX[k] := BrgX[BrgCount];
      BrgY[k] := BrgY[BrgCount];
      BrgSp[k] := BrgSp[BrgCount];
      BrgOwner[k] := BrgOwner[BrgCount];
      BrgN[k] := BrgN[BrgCount];
      BrgAt[k] := BrgAt[BrgCount];
    end;
  end;
end;

{ gunship: every 6 ticks an M2 round from the free air over and behind him at the enemy nearest to the gun that it
  can see within its reach, led for his speed (under a roof it does not fire) }
procedure ClsGunTick(Tick: Integer);
var
  i, e, Best, b, n: Integer;
  GX, GY, D, BestD, T, AX, AY, L, Dir, Sky: Single;
begin
  n := 0;
  for i := 1 to TopSlot do
    if ClsGunUntil[i] > 0 then
    begin
      if (Tick >= ClsGunUntil[i]) or (not ActiveSlot[i]) then
      begin
        ClsGunUntil[i] := 0;
        Continue;
      end;
      if not PL[i].Alive then
      begin
        ClsGunUntil[i] := 0;
        Continue;
      end;
      n := n + 1;
      if Tick < ClsGunNext[i] then
        Continue;
      ClsGunNext[i] := Tick + 6;
      Dir := 1;
      AX := PL[i].MouseAimX;
      if AX < PL[i].X then
        Dir := -1;
      GX := PL[i].X - Dir * 200;
      Sky := ClsSkyOver(GX, PL[i].Y);
      if Sky < 140 then
        Continue;
      GY := PL[i].Y - Sky + 30;
      Best := 0;
      BestD := ClsGunR[i] * ClsGunR[i];
      for e := 1 to TopSlot do
        if ActiveSlot[e] then
          if PL[e].Alive then
            if Enemies(i, e) then
            begin
              D := (PL[e].X - GX) * (PL[e].X - GX) + (PL[e].Y - 10 - GY) * (PL[e].Y - 10 - GY);
              if D < BestD then
                if not Ray(GX, GY, PL[e].X, PL[e].Y - 10, True) then
                begin
                  BestD := D;
                  Best := e;
                end;
            end;
      if Best = 0 then
        Continue;
      T := Sqrt(BestD) / 30;
      AX := PL[Best].X + PL[Best].VelX * T - GX;
      AY := PL[Best].Y - 10 + PL[Best].VelY * T - GY;
      L := Sqrt(AX * AX + AY * AY);
      if L < 1 then
        Continue;
      if BulletRoom(1) then
      begin
        b := ScriptBullet(GX, GY, AX / L * 30 + Random(-10, 11) * 0.05, AY / L * 30 + Random(-10, 11) * 0.05, 1.3, 14,
          PL[i]);
        if (b >= 1) and (b <= 255) then
        begin
          ClsBulOwner[b] := i;
          ClsBulTick[b] := Tick;
        end;
      end;
    end;
  ClsGunAny := n;
end;

{ cloak: the game's predator bonus (unseen for its time), only SOCOM and a knife in his hands for Ticks; his health
  stays what it was (the bonus fills it), his weapons come back afterwards }
function ClsCloak(ID, Ticks: Integer): Boolean;
var
  P: TActivePlayer;
  NW, NS: TNewWeapon;
begin
  Result := False;
  { G2: the bonus makes a map object for a moment - none with every object slot taken (the server would write
    outside its table) }
  if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
  begin
    Say(ID, 'Not now - too many things lie on the map.', ColorBad);
    Exit;
  end;
  { CLS9: the game's predator bonus always lasts 25 s: the cloak is that long (the weapons come back with it) }
  Ticks := 1500;
  P := PL[ID];
  ClsCloakW[ID] := P.Primary.WType;
  ClsCloakWA[ID] := P.Primary.Ammo;
  ClsCloakS[ID] := P.Secondary.WType;
  ClsCloakSA[ID] := P.Secondary.Ammo;
  ClsCloakHP[ID] := P.Health;
  P.GiveBonus(1);
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    NW.WType := 0;
    NW.Ammo := ShMagOf(0);
    NS.WType := 11;
    NS.Ammo := 1;
    P.ForceWeapon(NW, NS);
    AmGiven(ID);
  finally
    NW.Free;
    NS.Free;
  end;
  if AmmoEnabled then
    if BeOk then
      BE_AmmoForced(ID, Game.TickCount, 0, ShMagOf(0));
  AcAmmoTouched(ID);
  ClsCloakUntil[ID] := Game.TickCount + Ticks;
  ClsCloakAny := ClsCloakAny + 1;
  Say(ID, 'Cloak for ' + IntToStr(Ticks div 60) + ' s: SOCOM and the knife only, your weapons come back after it.',
    ClsHudColor);
  Result := True;
end;

{ every tick while somebody is cloaked: his health set back once (the bonus filled it), his weapons back at the end }
procedure ClsCloakTick(Tick: Integer);
var
  i, n: Integer;
  NW, NS: TNewWeapon;
begin
  n := 0;
  for i := 1 to TopSlot do
    if ClsCloakUntil[i] > 0 then
    begin
      if not ActiveSlot[i] then
      begin
        ClsCloakUntil[i] := 0;
        Continue;
      end;
      if not PL[i].Alive then
      begin
        ClsCloakUntil[i] := 0;
        Continue;
      end;
      if ClsCloakHP[i] > 0 then
      begin
        if PL[i].Health > ClsCloakHP[i] then
        begin
          PL[i].Health := ClsCloakHP[i];
          LastHealth[i] := ClsCloakHP[i];
        end;
        ClsCloakHP[i] := 0;
      end;
      if Tick < ClsCloakUntil[i] then
      begin
        n := n + 1;
        Continue;
      end;
      ClsCloakUntil[i] := 0;
      NW := TNewWeapon.Create;
      NS := TNewWeapon.Create;
      try
        NW.WType := WEP_NONE;
        NS.WType := WEP_NONE;
        if (ClsCloakW[i] >= 0) and (ClsCloakW[i] <= 16) then
        begin
          NW.WType := ClsCloakW[i];
          NW.Ammo := ClsCloakWA[i];
        end;
        if (ClsCloakS[i] >= 0) and (ClsCloakS[i] <= 16) then
        begin
          NS.WType := ClsCloakS[i];
          NS.Ammo := ClsCloakSA[i];
        end;
        PL[i].ForceWeapon(NW, NS);
        AmGiven(i);
      finally
        NW.Free;
        NS.Free;
      end;
      if AmmoEnabled then
        if BeOk then
          if (ClsCloakW[i] >= 0) and (ClsCloakW[i] <= 16) then
            BE_AmmoForced(i, Tick, ClsCloakW[i], ClsCloakWA[i]);
      AcAmmoTouched(i);
      if HumanOf[i] then
        Say(i, 'Cloak over: your weapons are back.', ClsHudColor);
    end;
  ClsCloakAny := n;
end;

{ leech: a hit on an enemy gives him health back (up to the full health) }
procedure ClsLeechHit(S, V: Integer);
var
  c: Integer;
  H: Single;
begin
  if (S < 1) or (S > 32) then
    Exit;
  c := ClsOf[S];
  if (c < 1) or (c > ClsCount) then
    Exit;
  if ClsLeech[c] <= 0 then
    Exit;
  if not Enemies(S, V) then
    Exit;
  if not PL[S].Alive then
    Exit;
  H := PL[S].Health + ClsLeech[c];
  if H > MaxHealth then
    H := MaxHealth;
  if H > PL[S].Health then
  begin
    PL[S].Health := H;
    LastHealth[S] := H;
    HudMarkL(S, HLB_HEALTH);
  end;
end;

{ ---------------- the skills ---------------- }

{ a mate's death within the reach of a rally (OnKill): he comes back at the one who called it }
procedure ClsRallyDeath(V, Tick: Integer);
var
  g, c, n: Integer;
  DX, DY, R: Single;
begin
  ClsRallyBy[V] := 0;
  if not TeamGame() then
    Exit;
  for g := 1 to TopSlot do
    if g <> V then
      if ActiveSlot[g] then
          if TeamOf[g] = TeamOf[V] then
          begin
            c := ClsOf[g];
            if (c >= 1) and (c <= ClsCount) then
              for n := 1 to 2 do
                if ClsSk[c][n] = SK_RALLY then
                  if ClsOn[g][n] > Tick then
                    if PL[g].Alive then
                    begin
                      R := ClsSkP1[c][n];
                      DX := PL[g].X - PL[V].X;
                      DY := PL[g].Y - PL[V].Y;
                      if R > 0 then
                        if DX * DX + DY * DY <= R * R then
                        begin
                          if ClsRallyBy[V] = 0 then
                            ClsRallyBy[V] := g
                          else if ClsRallyLast[g] < ClsRallyLast[ClsRallyBy[V]] then
                            ClsRallyBy[V] := g;
                        end;
                    end;
          end;
end;

{ where the one who called a rally takes a mate now: next to him, or where he last stood on the ground while he is in
  the air; False and why not (down, a flag, in the air with no ground known) }
function ClsRallySpot(g: Integer; var X, Y: Single; var Why: string): Boolean;
var
  Q: TActivePlayer;
begin
  Q := PL[g];
  X := Q.X;
  Y := Q.Y;
  Why := '';
  if DwDown[g] then
    Why := 'is down'
  else if Q.Flagger then
    Why := 'carries a flag'
  else if not Q.OnGround then
  begin
    if ClsRallyGOk[g] then
    begin
      X := ClsRallyGX[g];
      Y := ClsRallyGY[g];
    end
    else
      Why := 'is in the air';
  end;
  Result := Why = '';
end;

{ k called a rally without a reach that is open for ID: of his team, it lasts, k is alive }
function ClsRallyOpen(k, ID, Tick: Integer): Boolean;
var
  c, n: Integer;
begin
  Result := False;
  if k = ID then
    Exit;
  if ClsRallyUntil[k] <= Tick then
    Exit;
  if not ActiveSlot[k] then
    Exit;
  if TeamOf[k] <> TeamOf[ID] then
    Exit;
  if not PL[k].Alive then
    Exit;
  c := ClsOf[k];
  if (c < 1) or (c > ClsCount) then
    Exit;
  for n := 1 to 2 do
    if ClsSk[c][n] = SK_RALLY then
      if ClsOn[k][n] > Tick then
        if ClsSkP1[c][n] <= 0 then
          Result := True;
end;

{ his respawn at the one who called a rally (before the spawn protection: a rallied soldier gets none): a rally with a
  reach - he died within it; without one - the rallies of his team take the mates in turn (the one that got a mate
  longest ago first, a new one at once), one that cannot take him now is passed by; at the one who called it, or where
  that one last stood on the ground (he is in the air); True when he was moved }
function ClsRallyRespawn(ID, Tick: Integer): Boolean;
var
  g, k: Integer;
  X, Y: Single;
  Why, Told: string;
begin
  Result := False;
  g := ClsRallyBy[ID];
  ClsRallyBy[ID] := 0;
  Told := '';
  if g > 0 then
  begin
    if not ActiveSlot[g] then
      Exit;
    if TeamOf[g] <> TeamOf[ID] then
      Exit;
    if not PL[g].Alive then
      Exit;
    if not ClsRallySpot(g, X, Y, Why) then
      Told := PL[g].Name + '''s rally: he ' + Why;
  end
  else if TeamGame() then
  begin
    for k := 1 to TopSlot do
      if ClsRallyOpen(k, ID, Tick) then
      begin
        if ClsRallySpot(k, X, Y, Why) then
        begin
          if g = 0 then
            g := k
          else if ClsRallyLast[k] < ClsRallyLast[g] then
            g := k;
        end
        else if Told = '' then
          Told := PL[k].Name + '''s rally: he ' + Why;
      end;
    { one could take him: no word of one that could not }
    if g > 0 then
    begin
      Told := '';
      if not ClsRallySpot(g, X, Y, Why) then
        g := 0;
    end;
  end;
  if Told <> '' then
  begin
    if HumanOf[ID] then
      Say(ID, Told + ' - you came back at a spawn point.', ColorBad);
    Exit;
  end;
  if g = 0 then
    Exit;
  MovePlayer(PL[ID], X, Y - 8);
  ClsRallyLast[g] := Tick;
  ClsStatRallied := ClsStatRallied + 1;
  BpEvent(g, PE_TEAMRESPAWN);
  if HumanOf[ID] then
    Say(ID, 'You came back at ' + PL[g].Name + '''s rally.', ClsHudColor);
  if HumanOf[g] then
    Say(g, PL[ID].Name + ' came back at your rally.', ClsHudColor);
  Result := True;
end;

{ a crate of [Supply] under his aim for his team, with the class's contents }
function ClsSupply(ID, c, n, Tick: Integer): Boolean;
var
  X, GY, AY: Single;
  k, Free0: Integer;
begin
  Result := False;
  Free0 := 0;
  for k := 0 to SuMax - 1 do
    if SuState[k] = 0 then
      Free0 := Free0 + 1;
  if Free0 = 0 then
  begin
    Say(ID, 'The sky is full of crates - wait a moment.', ColorBad);
    Exit;
  end;
  X := PL[ID].MouseAimX;
  AY := PL[ID].MouseAimY;
  { a bot's aim is its target: its crate falls at its own feet }
  if not HumanOf[ID] then
  begin
    X := PL[ID].X;
    AY := PL[ID].Y;
  end;
  GY := AY;
  if not (BeOk and MapOk) then
  begin
    X := PL[ID].X;
    GY := PL[ID].Y;
  end
  else if BE_ShopGround(X, AY - 40, 600, GY) = 0 then
  begin
    Say(ID, 'No ground under your aim for a crate.', ColorBad);
    Exit;
  end;
  SuDropWith(X, GY - 4, TeamOf[ID], Tick, 'for ' + PL[ID].Name + '''s team', ClsSkWhat[c][n], ID);
  Result := True;
end;

{ his own magazines and grenades back }
{ G19: the grenades a life of his class starts with ([FlashNades] Nades unless his class's loadout names a number) }
function ClsNadeCap(ID: Integer): Integer;
var
  c: Integer;
begin
  Result := FnNades;
  if ClsActive then
  begin
    c := ClsOf[ID];
    if (c >= 1) and (c <= ClsCount) then
      if ClsLoad[c][LO_NADES] >= 0 then
        Result := ClsLoad[c][LO_NADES];
  end;
end;

function ClsResupplySelf(ID: Integer): Boolean;
var
  P: TActivePlayer;
  W, NC: Integer;
begin
  Result := False;
  P := PL[ID];
  if AmmoEnabled and BeOk then
  begin
    W := P.Primary.WType;
    if (W >= 0) and (W <= 16) then
      if BE_AmmoTopUp(ID, W) > 0 then
        Result := True;
    W := P.Secondary.WType;
    if (W >= 0) and (W <= 16) then
      if BE_AmmoTopUp(ID, W) > 0 then
        Result := True;
  end;
  { G19: the grenades - as many as a life of his class starts with }
  if FnEnabled then
  begin
    NC := ClsNadeCap(ID);
    if FnNadeLeft[ID] < NC then
    begin
      FnNadeLeft[ID] := NC;
      FnNeed[ID] := True;
      Result := True;
    end;
  end;
  if Result then
    HudMark(ID, False);
end;

{ !skill, !skill2 }
procedure ClsSkillUse(ID, n: Integer);
var
  c, Kind, Tick, e, Tm, k: Integer;
  P: TActivePlayer;
  Why: string;
  Ok: Boolean;
  H, Add: Single;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ClsActive then
  begin
    Say(ID, 'Classes are off here (' + ClsIdleWhy + ').', ColorBad);
    Exit;
  end;
  P := PL[ID];
  c := ClsOf[ID];
  if (c < 1) or (c > ClsCount) or (not P.Alive) then
  begin
    Say(ID, 'Skills come with a class, while you are alive.', ColorBad);
    Exit;
  end;
  Kind := ClsSk[c][n];
  if Kind = SK_NONE then
  begin
    Say(ID, ClsName[c] + ' has no ' + ShIf(n = 1, 'first', 'second') + ' skill.', ColorBad);
    Exit;
  end;
  Why := ClsSkWhy(Kind);
  if Why <> '' then
  begin
    Say(ID, ClsSkName(Kind) + ': ' + Why + '.', ColorBad);
    Exit;
  end;
  if DwDown[ID] or (BdShockUntil[ID] > 0) then
  begin
    Say(ID, 'Not while you are down.', ColorBad);
    Exit;
  end;
  if PausedNow then
  begin
    Say(ID, 'Not during a pause.', ColorBad);
    Exit;
  end;
  Tick := Game.TickCount;
  if ClsCool[ID][n] > Tick then
  begin
    Say(ID, ClsSkName(Kind) + ' again in ' + IntToStr((ClsCool[ID][n] - Tick + 59) div 60) + ' s.', ColorBad);
    Exit;
  end;
  { G18: the game makes no bullet for the server's last slot (32): shells, rounds and charges would be nothing }
  if ID = 32 then
    if (Kind = SK_MORTAR) or (Kind = SK_BARRAGE) or (Kind = SK_GUNSHIP) or (Kind = SK_C4) then
    begin
      Say(ID, ClsSkName(Kind) + ' does not work from the server''s last player slot (32).', ColorBad);
      Exit;
    end;
  Ok := False;
  case Kind of
    SK_RALLY:
      begin
        ClsOn[ID][n] := Tick + ClsSkOnT[c][n];
        ClsRallyUntil[ID] := ClsOn[ID][n];
        ClsRallyLast[ID] := 0;
        ClsRallyGX[ID] := P.X;
        ClsRallyGY[ID] := P.Y;
        ClsRallyGOk[ID] := P.OnGround;
        Ok := True;
        if ClsSkP1[c][n] > 0 then
        begin
          for e := 1 to TopSlot do
            if ActiveSlot[e] then
              if HumanOf[e] then
                if e <> ID then
                  if TeamOf[e] = TeamOf[ID] then
                    Say(e, P.Name + '''s rally: who dies near him in ' + IntToStr(ClsSkOnT[c][n] div 60) +
                      ' s comes back at him.', ClsHudColor);
          Say(ID, 'Rally for ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s: your mates who die near you come back at you.',
            ClsHudColor);
        end
        else
        begin
          for e := 1 to TopSlot do
            if ActiveSlot[e] then
              if HumanOf[e] then
                if e <> ID then
                  if TeamOf[e] = TeamOf[ID] then
                    Say(e, P.Name + '''s rally: respawn at him for ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s.',
                      ClsHudColor);
          Say(ID, 'Rally for ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s: your mates respawn next to you.', ClsHudColor);
        end;
      end;
    SK_HEALTHPACK:
      begin
        Ok := ClsDropKit(ID, OBJECT_MEDKIT, Tick);
        if Ok then
          BpEvent(ID, PE_KITPLACED);
      end;
    SK_NADEKIT:
      begin
        Ok := ClsDropKit(ID, OBJECT_GRENADEKIT, Tick);
        if Ok then
          BpEvent(ID, PE_KITPLACED);
      end;
    SK_STATGUN:
      begin
        Ok := ShStatPlace(ID, ClsSkOnT[c][n], Tick);
        if Ok then
          BpEvent(ID, PE_STATGUN);
      end;
    SK_MORTAR:
      begin
        ClsMortX[ID] := P.MouseAimX;
        ClsMortY[ID] := P.MouseAimY;
        if BeOk then
          if MapOk then
          begin
            H := ClsMortY[ID];
            if BE_ShopGround(ClsMortX[ID], P.MouseAimY - 40, 800, H) = 1 then
              ClsMortY[ID] := H - 4;
          end;
        if ClsSkyOver(ClsMortX[ID], ClsMortY[ID]) < 140 then
        begin
          Say(ID, 'No open sky over your aim for a mortar.', ColorBad);
          Ok := False;
          ClsMortN[ID] := 0;
        end
        else
        begin
        ClsMortN[ID] := Round(ClsSkP1[c][n]);
        ClsMortAny := ClsMortAny + 1;
        ClsMortSp[ID] := ClsSkP2[c][n];
        ClsMortAt[ID] := Tick + 45;
        { everybody near is warned }
        for e := 1 to TopSlot do
          if ActiveSlot[e] then
            if HumanOf[e] or DebugBots then
              PL[e].WorldText(ClsMortarLayer, 'MORTAR', 150, $FF4040, 0.07, ClsMortX[ID] - 18,
                ClsMortY[ID] - 40);
        Ok := True;
        end;
      end;
    SK_UAV:
      begin
        Tm := TeamOf[ID];
        k := 0;
        for e := 1 to TopSlot do
          if ActiveSlot[e] then
            if PL[e].Alive then
              if Enemies(ID, e) then
              begin
                { G16: a longer spot stays as long as it was }
                if After(Tick, ClsSkOnT[c][n]) > SgUntil[e][Tm] then
                begin
                  SgUntil[e][Tm] := After(Tick, ClsSkOnT[c][n]);
                  SgBy[e][Tm] := ID;
                end;
                if ClsSpotsMode = 0 then
                begin
                  SgMarkIt[e][Tm] := True;
                  SgMarkAny := True;
                end;
                if BeOk then
                  BE_SpotSet(e, Tm, SgUntil[e][Tm]);
                k := k + 1;
              end;
        SgAny := SgAny + k;
        ClsOn[ID][n] := Tick + ClsSkOnT[c][n];
        ClsSkRadar(Tm, Tick + ClsSkOnT[c][n]);
        for e := 1 to TopSlot do
          if ActiveSlot[e] then
            if HumanOf[e] then
              if TeamOf[e] = Tm then
                Say(e, P.Name + '''s UAV: ' + IntToStr(k) + ' enemies on the radar for ' +
                  IntToStr(ClsSkOnT[c][n] div 60) + ' s.', ClsHudColor);
        Ok := True;
      end;
    SK_SUPPLY:
      Ok := ClsSupply(ID, c, n, Tick);
    SK_PATCHUP:
      begin
        H := P.Health;
        Add := ClsSkP1[c][n] * MaxHealth / 100;
        if H + Add > MaxHealth then
          Add := MaxHealth - H;
        if BdActive then
          if BdWounds[ID] > 0 then
          begin
            BE_BodyHeal(ID, BC_KIT, 0);
            BdSync(ID);
            Ok := True;
          end;
        if Add > 0.5 then
        begin
          P.Health := H + Add;
          LastHealth[ID] := H + Add;
          Ok := True;
        end;
        if Ok then
          HudMark(ID, False)
        else
          Say(ID, 'Nothing to patch up.', ColorBad);
      end;
    SK_RESUPPLY:
      begin
        Ok := ClsResupplySelf(ID);
        if not Ok then
          Say(ID, 'You have all your ammunition.', ColorBad);
      end;
    SK_C4:
      Ok := ClsC4Tag(ID, ClsSkP1[c][n]);
    SK_SENSOR:
      begin
        ClsOn[ID][n] := Tick + ClsSkOnT[c][n];
        Say(ID, 'Sensor for ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s: the enemies within ' +
          IntToStr(Round(ClsSkP1[c][n])) + ' px of you are on your team''s radar.', ClsHudColor);
        Ok := True;
      end;
    SK_STEAL:
      Ok := ClsSteal(ID, ClsSkP1[c][n]);
    SK_BARRAGE:
      Ok := ClsBarrage(ID, Round(ClsSkP1[c][n]), Round(ClsSkP2[c][n]));
    SK_GUNSHIP:
      begin
        ClsGunUntil[ID] := Tick + ClsSkOnT[c][n];
        ClsGunNext[ID] := Tick + 30;
        ClsGunR[ID] := ClsSkP1[c][n];
        ClsGunAny := ClsGunAny + 1;
        ClsOn[ID][n] := ClsGunUntil[ID];
        Say(ID, 'Gunship for ' + IntToStr(ClsSkOnT[c][n] div 60) + ' s: it fires from the sky at the enemies near you.',
          ClsHudColor);
        Ok := True;
      end;
    SK_CLOAK:
      begin
        Ok := ClsCloak(ID, ClsSkOnT[c][n]);
        if Ok then
          ClsOn[ID][n] := Tick + ClsSkOnT[c][n];
      end;
  end;
  if not Ok then
    Exit;
  ClsCool[ID][n] := Tick + ClsSkCool[c][n];
  if (Kind >= 1) and (Kind <= 15) then
    ClsKindCool[ID][Kind] := ClsCool[ID][n];
  { G20: an attack skill ends his spawn protection (as a shot does) }
  if (Kind = SK_MORTAR) or (Kind = SK_BARRAGE) or (Kind = SK_GUNSHIP) or (Kind = SK_C4) or (Kind = SK_STEAL) or
    (Kind = SK_CLOAK) then
    SfEnd(ID);
  ClsUsed[ID] := True;
  ClsStatSkills := ClsStatSkills + 1;
  HudMarkL(ID, HLB_CLASS);
end;

{ the mortar's shells: one every 12 ticks from the sky over the place (a pause: they wait) }
procedure ClsMortarTick(Tick: Integer);
var
  i, k, b: Integer;
  X, Sky: Single;
begin
  if ClsMortAny <= 0 then
    Exit;
  ClsMortAny := 0;
  for i := 1 to TopSlot do
    if ClsMortN[i] > 0 then
    begin
      ClsMortAny := ClsMortAny + 1;
      if Tick >= ClsMortAt[i] then
      begin
        if not ActiveSlot[i] then
        begin
          ClsMortN[i] := 0;
          Continue;
        end;
        ClsMortN[i] := ClsMortN[i] - 1;
        ClsMortAt[i] := Tick + 12;
        { a shell falls from the free air over its place: four bursts spreading as they fall - a soldier in the air
          under it is hit too }
        X := ClsMortX[i] + Random(-Round(ClsMortSp[i]), Round(ClsMortSp[i]) + 1) * 0.5;
        Sky := ClsSkyOver(X, ClsMortY[i]);
        if BulletRoom(4) then
          for k := 0 to 3 do
          begin
            b := ScriptBullet(X + (k - 1.5) * 6, ClsMortY[i] - Sky + 6, (k - 1.5) * 1.2, 7, 1, 10, PL[i]);
            if (b >= 1) and (b <= 255) then
            begin
              ClsBulOwner[b] := i;
              ClsBulTick[b] := Tick;
            end;
          end;
      end;
    end;
end;

{ a bullet of a class's skill (the mortar): no team kill guard, no spawn protection of its owner }
function ClsBullet(B, Owner: Integer): Boolean;
var
  X, Y: Single;
  T: Integer;
begin
  Result := False;
  if (B < 1) or (B > 255) then
    Exit;
  if ClsBulOwner[B] <> Owner then
    Exit;
  if Game.TickCount - ClsBulTick[B] > 180 then
    Exit;
  { the slot taken by a later bullet of his: not the skill's (the bridge knows when a bullet was made) }
  if BeOk then
    if B <= 254 then
      if BE_BulletOrigin(B, X, Y, T) = 1 then
        if Abs(T - ClsBulTick[B]) > 1 then
          Exit;
  Result := True;
end;

{ ---------------- the perks ---------------- }

{ a hit's factor of the classes: the shooter's damage perk (his weapon, his stance), the victim's armor }
function ClsDamageFactor(S, V: Integer; Shooter: TActivePlayer): Single;
var
  c, d, W: Integer;
  Low, Prone, Crouch: Boolean;
begin
  Result := 1;
  c := ClsOf[V];
  if (c >= 1) and (c <= ClsCount) then
    Result := Result * ClsArmor[c];
  c := ClsOf[S];
  if (c < 1) or (c > ClsCount) then
    Exit;
  { crit: a share of his hits on enemies harder }
  if ClsCrit[c] > 0 then
    if Enemies(S, V) then
      if Random(0, 10000) < Round(ClsCrit[c] * 100) then
        Result := Result * ClsCritF[c];
  if ClsDmgN[c] = 0 then
    Exit;
  W := Shooter.Primary.WType;
  Prone := Shooter.IsProne;
  Crouch := Shooter.KeyCrouch;
  Low := Prone or Crouch;
  for d := 0 to ClsDmgN[c] - 1 do
    if ClsDmgW[c][d] = W then
      if (ClsDmgSt[c][d] = STC_ANY) or ((ClsDmgSt[c][d] = STC_PRONE) and Prone) or
        ((ClsDmgSt[c][d] = STC_CROUCH) and Crouch) or ((ClsDmgSt[c][d] = STC_LOW) and Low) then
        Result := Result * ClsDmgF[c][d];
end;

{ once a second: the heal, repair and ammo of the classes for the mates around (and the healer himself) }
procedure ClsAuras(Tick: Integer);
var
  i, j, c: Integer;
  X, Y, DX, DY, R, H, Add, Vs: Single;
  Q: TActivePlayer;
  Ammo: Boolean;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      c := ClsOf[i];
      if (c < 1) or (c > ClsCount) then
        Continue;
      if (ClsHeal[c] <= 0) and (ClsRepair[c] <= 0) and (ClsAmmoN[c] <= 0) then
        Continue;
      if DwDown[i] then
        Continue;
      if not PL[i].Alive then
        Continue;
      X := PL[i].X;
      Y := PL[i].Y;
      Ammo := False;
      if ClsAmmoN[c] > 0 then
        if AmmoEnabled and BeOk then
          if Tick >= ClsAmmoAt[i] then
          begin
            Ammo := True;
            ClsAmmoAt[i] := Tick + ClsAmmoTicks[c];
          end;
      for j := 1 to TopSlot do
        if ActiveSlot[j] then
          if (j = i) or (TeamGame() and (TeamOf[j] = TeamOf[i])) then
          begin
            Q := PL[j];
            if not Q.Alive then
              Continue;
            if DwDown[j] then
              Continue;
            DX := Q.X - X;
            DY := Q.Y - Y;
            { the heal: not right after a hit (2 s) }
            if ClsHeal[c] > 0 then
            begin
              R := ClsHealR[c];
              if DX * DX + DY * DY <= R * R then
                if Tick - LastHit[j] > 120 then
                begin
                  H := Q.Health;
                  if H < MaxHealth - 0.5 then
                  begin
                    Add := ClsHeal[c] * MaxHealth / 100;
                    if H + Add > MaxHealth then
                      Add := MaxHealth - H;
                    Q.Health := H + Add;
                    LastHealth[j] := H + Add;
                    if BdActive then
                      BE_BodyHeal(j, BC_HEALED, 1);
                    HudMarkL(j, HLB_HEALTH or HLB_BLOOD);
                    ClsStatHealed := ClsStatHealed + 1;
                    if j <> i then
                      BpGive(i, PE_HEALED, Add * 100 / MaxHealth);
                  end;
                end;
            end;
            if j <> i then
            begin
              { the repair: only a vest he has }
              if ClsRepair[c] > 0 then
              begin
                R := ClsRepairR[c];
                if DX * DX + DY * DY <= R * R then
                begin
                  Vs := Q.Vest;
                  if (Vs > 0) and (Vs < 100) then
                  begin
                    Add := ClsRepair[c];
                    if Vs + Add > 100 then
                      Add := 100 - Vs;
                    Q.Vest := Vs + Add;
                    HudMarkL(j, HLB_HEALTH);
                    BpGive(i, PE_REPAIRED, Add);
                  end;
                end;
              end;
              { the ammunition: a spare magazine of the weapon in his hands }
              if Ammo then
              begin
                R := ClsAmmoR[c];
                if DX * DX + DY * DY <= R * R then
                  if (Q.Primary.WType >= 0) and (Q.Primary.WType <= 16) then
                    if BE_AmmoAddMags(j, Q.Primary.WType, Round(ClsAmmoN[c])) > 0 then
                    begin
                      HudMarkL(j, HlAmmoBits());
                      BpGive(i, PE_AMMO, ClsAmmoN[c]);
                    end;
              end;
            end;
          end;
    end;
end;

{ ---------------- a player's life ---------------- }

{ OnKill: the class of the next life (life: a roll; choice: what he chose; round: at the round's end), the rally }
procedure ClsOnKill(V, Tick: Integer; RoundEnd: Boolean);
var
  c, j: Integer;
begin
  if (V < 1) or (V > 32) then
    Exit;
  ClsArmN[V] := 0;
  { C4: his charges on the enemies go, a charge on him goes; his gunship and cloak end }
  ClsC4Drop(V);
  ClsC4Off(V, 'he died');
  ClsGunUntil[V] := 0;
  ClsCloakUntil[V] := 0;
  { G14: his rally and sensor end with him (the gunship and cloak above); the UAV is in the air for his team }
  ClsRallyUntil[V] := 0;
  c := ClsOf[V];
  if (c >= 1) and (c <= ClsCount) then
    for j := 1 to 2 do
      if (ClsSk[c][j] = SK_RALLY) or (ClsSk[c][j] = SK_SENSOR) or (ClsSk[c][j] = SK_GUNSHIP) or
        (ClsSk[c][j] = SK_CLOAK) then
        ClsOn[V][j] := 0;
  if not ClsActive then
    Exit;
  if RoundEnd then
  begin
    ShMaskSend(V);
    Exit;
  end;
  ClsRallyDeath(V, Tick);
  if (ClsAssign = CL_LIFE) or (ClsChoosing() and not HumanOf[V]) then
  begin
    { CLS6: a bot in a choice mode takes another class now and then too (it chooses nothing itself) }
    c := ClsRoll(V);
    if c > 0 then
      ClsSetNext(V, c, ClsNext[V] <> c);
  end;
  { his next life's weapon menu now: the death screen shows it (diff only) }
  ShMaskSend(V);
  { a choice of his own: he is told he may change it (the first ChoiceTimes deaths of a map) }
  if ClsChoosing() then
    if HumanOf[V] then
      if ClsToldN[V] < ClsChoiceTimes then
      begin
        ClsToldN[V] := ClsToldN[V] + 1;
        ClsTellChoice(V);
      end;
end;

{ a survival round is over (V: the first one the round's end killed; 0 = a new map): Assign = round - a new class for
  everybody's next round; with [Ammo] SurvivalCarry the survivors keep their kit, so their class too }
procedure ClsRoundOver(V: Integer);
var
  i, c, k: Integer;
  Keep: Boolean;
begin
  if not ClsActive then
    Exit;
  { CLS7: a survival round is one life: the skills are ready again for the next one }
  for i := 1 to 32 do
  begin
    for k := 1 to 2 do
      ClsCool[i][k] := 0;
    for k := 0 to 15 do
      ClsKindCool[i][k] := 0;
  end;
  if ClsKept <> nil then
    ClsKept.Clear;
  if ClsAssign <> CL_ROUND then
    Exit;
  { one at a time: each roll counts the ones rolled before it }
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] <> TEAM_SPECTATOR then
      begin
        Keep := False;
        if V > 0 then
          if CyCarry then
            if (i = V) or PL[i].Alive then
              Keep := True;
        if not Keep then
        begin
          c := ClsRoll(i);
          if c > 0 then
            ClsSetNext(i, c, True);
        end;
      end;
end;

{ the respawn (RespawnRun, after the other modules): the class of this life, its loadout, the check of the weapons }
procedure ClsRespawn(ID, Tick: Integer);
var
  c, OldC: Integer;
begin
  if not ClsActive then
    Exit;
  OldC := ClsOf[ID];
  { the respawn before the join: the join sets the class up }
  if not ActiveSlot[ID] then
    Exit;
  if TeamOf[ID] = TEAM_SPECTATOR then
    Exit;
  c := ClsNext[ID];
  if c = 0 then
    c := ClsOf[ID];
  { no short-circuit: the mode is asked only of a class that is }
  if (c < 1) or (c > ClsCount) then
    c := 0
  else if not ClsFor(ID, c) then
    c := 0;
  if c = 0 then
    c := ClsRoll(ID);
  if c = 0 then
    Exit;
  ClsSet(ID, c, c <> ClsOf[ID]);
  ClsSpawnTick[ID] := Tick;
  ClsUsed[ID] := False;
  ClsMortN[ID] := 0;
  { a survivor of a survival round keeps what he had (no new loadout) - unless he changed the class (CLS18) }
  if (not CyWasKept[ID]) or (c <> OldC) then
    ClsGiveLoadout(ID, c)
  else
    ClsLoSnap(ID);
  { the weapons: a bot at once (it ignores the menu), a human after his game had its chance }
  if HumanOf[ID] then
  begin
    ClsCheckAt[ID] := Tick + 3;
    ClsCheckAny := ClsCheckAny + 1;
  end
  else
    ClsArm(ID);
end;

{ the join (SetupPlayer; the script's start too): a class (rolled), his menu; alive (the server respawned him before the
  join): the loadout and the check }
procedure ClsJoin(ID, Tick: Integer);
var
  k, c, j, Kd: Integer;
  W0, Pair: string;
begin
  ClsOf[ID] := 0;
  ClsNext[ID] := 0;
  ClsLast[ID] := 0;
  ClsPick[ID] := -1;
  ClsRallyBy[ID] := 0;
  ClsRallyUntil[ID] := 0;
  ClsRallyLast[ID] := 0;
  ClsRallyGOk[ID] := False;
  ClsToldN[ID] := 0;
  ClsMortN[ID] := 0;
  ClsCheckAt[ID] := 0;
  ClsAmmoAt[ID] := 0;
  ClsBotC4At[ID] := 0;
  ClsUsed[ID] := False;
  for k := 1 to 20 do
    ClsPlayed[ID][k] := 0;
  for k := 1 to 2 do
  begin
    ClsCool[ID][k] := 0;
    ClsOn[ID][k] := 0;
  end;
  for k := 0 to 15 do
    ClsKindCool[ID][k] := 0;
  { O7: back on the same map - the cooldowns he left with (kind:tick pairs; his class's skills take them at his
    first life, ClsSet) }
  if ClsKept <> nil then
  begin
    k := ClsKept.IndexOfName(BpKeyOf(ID));
    if k >= 0 then
    begin
      W0 := Copy(ClsKept[k], Pos('=', ClsKept[k]) + 1, 400);
      ClsKept.Delete(k);
      while W0 <> '' do
      begin
        c := Pos(',', W0);
        if c = 0 then
          c := Length(W0) + 1;
        Pair := Copy(W0, 1, c - 1);
        W0 := Copy(W0, c + 1, 400);
        j := Pos(':', Pair);
        if j > 0 then
        begin
          Kd := StrToIntDef(Copy(Pair, 1, j - 1), -1);
          if (Kd >= 1) and (Kd <= 15) then
            ClsKindCool[ID][Kd] := StrToIntDef(Copy(Pair, j + 1, 20), 0);
        end;
      end;
    end;
  end;
  ClsObjForget(ID, 0);
  for k := 1 to 32 do
    if ClsRallyBy[k] = ID then
      ClsRallyBy[k] := 0;
  ClsC4Drop(ID);
  ClsC4Off(ID, '');
  ClsC4Left[ID] := 0;
  if not ClsActive then
  begin
    ClsPerksApply(ID);
    Exit;
  end;
  if TeamOf[ID] = TEAM_SPECTATOR then
    Exit;
  if ClsAssign = CL_MAP then
    c := ClsMapClass(ID)
  else
    c := ClsRoll(ID);
  if c = 0 then
    Exit;
  ClsSet(ID, c, True);
  if ClsChoosing() then
    if HumanOf[ID] then
      ClsTellChoice(ID);
  if PL[ID].Alive then
  begin
    ClsSpawnTick[ID] := Tick;
    ClsGiveLoadout(ID, c);
    if HumanOf[ID] then
    begin
      ClsCheckAt[ID] := Tick + 3;
      ClsCheckAny := ClsCheckAny + 1;
    end
    else
      ClsArm(ID);
  end;
end;

{ another team: his objects go, a class of the new team (not with a choice of his own) }
procedure ClsTeamChanged(ID, OldTeam: Integer);
var
  c, k: Integer;
  Life: Boolean;
begin
  Life := ClsTeamLife[ID];
  ClsTeamLife[ID] := False;
  if OldTeam <> TeamOf[ID] then
  begin
    ClsC4Drop(ID);
    ClsC4Off(ID, 'he changed teams');
    { CLS11: what his skills kept running was for the side he left }
    ClsRallyUntil[ID] := 0;
    ClsGunUntil[ID] := 0;
    ClsMortN[ID] := 0;
    for k := 1 to 2 do
      ClsOn[ID][k] := 0;
  end;
  ClsObjForget(ID, 0);
  ClsRallyBy[ID] := 0;
  if not ClsActive then
    Exit;
  if TeamOf[ID] = TEAM_SPECTATOR then
    Exit;
  if OldTeam = TeamOf[ID] then
    Exit;
  c := ClsOf[ID];
  if ClsNext[ID] > 0 then
    c := ClsNext[ID];
  if (c >= 1) and (c <= ClsCount) then
    if not ClsFor(ID, c) then
      c := 0;
  { CLS19: his class is full on the new team: another one }
  if (c >= 1) and (c <= ClsCount) then
    if ClsTeamCount(TeamOf[ID], c, ID) >= ClsCap(c, TeamOf[ID]) then
      c := 0;
  { a roll - with a choice of his own, or a class of the whole map, only when his class is not one of his new side }
  if ClsAssign = CL_MAP then
  begin
    if c = 0 then
    begin
      c := ClsMapClass(ID);
      if c > 0 then
        ClsSetNext(ID, c, True);
    end;
  end
  else if (not ClsChoosing()) or (c = 0) then
  begin
    c := ClsRoll(ID);
    if c > 0 then
      ClsSetNext(ID, c, True);
  end;
  if ClsChoosing() then
    if HumanOf[ID] then
      ClsTellChoice(ID);
  { the life the team change began (its respawn came before this event): his class of the new team now }
  if Life then
    if PL[ID].Alive then
      ClsRespawn(ID, Game.TickCount);
end;

procedure ClsLeave(ID: Integer);
var
  k, Tick: Integer;
  K0, W0: string;
begin
  { his cooldowns wait for him on this map (each skill's own: kind:tick pairs) }
  Tick := Game.TickCount;
  W0 := '';
  for k := 1 to 15 do
    if ClsKindCool[ID][k] > Tick then
    begin
      if W0 <> '' then
        W0 := W0 + ',';
      W0 := W0 + IntToStr(k) + ':' + IntToStr(ClsKindCool[ID][k]);
    end;
  if W0 <> '' then
  begin
    if ClsKept = nil then
      ClsKept := File.CreateStringList();
    K0 := BpKeyOf(ID);
    k := ClsKept.IndexOfName(K0);
    if k >= 0 then
      ClsKept.Delete(k);
    if ClsKept.Count >= 200 then
      ClsKept.Delete(0);
    ClsKept.Add(K0 + '=' + W0);
  end;
  for k := 0 to 15 do
    ClsKindCool[ID][k] := 0;
  ClsC4Drop(ID);
  ClsC4Off(ID, 'he left');
  ClsObjForget(ID, 0);
  ClsOf[ID] := 0;
  ClsNext[ID] := 0;
  ClsMortN[ID] := 0;
  for k := 1 to 32 do
    if ClsRallyBy[k] = ID then
      ClsRallyBy[k] := 0;
end;

{ the module goes on or idle (a reload, a map start): everybody's perks and menu follow }
procedure ClsRefresh();
var
  i: Integer;
begin
  if ClsRefreshState() then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
      begin
        ClsPerksApply(i);
        ShMaskSend(i);
        HudMarkL(i, HLB_CLASS);
      end;
end;

{ everybody's class still one of List and of this mode (a reload, a map start): a class that is not is rolled anew,
  who has none gets one; Arm (a map start): a new class of a living soldier brings its loadout and weapons }
procedure ClsValidate(Arm: Boolean);
var
  i, c: Integer;
begin
  if not ClsActive then
    Exit;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      if ClsNext[i] > ClsCount then
        ClsNext[i] := 0;
      if TeamOf[i] <> TEAM_SPECTATOR then
      begin
        c := ClsOf[i];
        if (c < 1) or (c > ClsCount) then
          c := 0
        else if not ClsFor(i, c) then
          c := 0;
        if c = 0 then
        begin
          c := ClsRoll(i);
          if c > 0 then
          begin
            ClsSet(i, c, True);
            if ClsAssign = CL_MAP then
              ClsMapKeep(i, c);
            if Arm then
              if PL[i].Alive then
              begin
                ClsGiveLoadout(i, c);
                ClsArm(i);
              end;
          end;
        end;
      end;
    end;
end;

{ before a map change: Assign = round - the classes of the new map's first round, before its respawns }
procedure ClsBeforeMap();
var
  i, c: Integer;
begin
  for i := 1 to 32 do
  begin
    ClsMortN[i] := 0;
    ClsRallyBy[i] := 0;
    ClsRallyUntil[i] := 0;
    ClsRallyLast[i] := 0;
    ClsC4By[i] := 0;
    ClsGunUntil[i] := 0;
    ClsCloakUntil[i] := 0;
  end;
  ClsC4Any := 0;
  BrgCount := 0;
  ClsObjN := 0;
  if ClsActive then
  begin
    if ClsAssign = CL_ROUND then
      ClsRoundOver(0);
    { Assign = map: everybody's class of the next map, kept by his keys }
    if ClsAssign = CL_MAP then
    begin
      if ClsMapStore <> nil then
        ClsMapStore.Clear;
      for i := 1 to TopSlot do
        if ActiveSlot[i] then
          if TeamOf[i] <> TEAM_SPECTATOR then
          begin
            c := ClsRoll(i);
            if c > 0 then
            begin
              ClsMapKeep(i, c);
              ClsSetNext(i, c, True);
            end;
          end;
    end;
  end;
end;

{ a new map: the values of its mode, nothing of the classes on the map any more, the played counts start again }
procedure ClsMapStart();
var
  i, k: Integer;
begin
  if ClsKept <> nil then
    ClsKept.Clear;
  ClsResolve(False);
  ClsRefresh();
  ClsValidate(True);
  ClsObjN := 0;
  for i := 1 to 32 do
  begin
    for k := 1 to 20 do
      ClsPlayed[i][k] := 0;
    ClsToldN[i] := 0;
    if ClsOf[i] >= 1 then
      if ClsOf[i] <= ClsCount then
        ClsPlayed[i][ClsOf[i]] := 1;
    for k := 1 to 2 do
    begin
      ClsCool[i][k] := 0;
      ClsOn[i][k] := 0;
    end;
    for k := 0 to 15 do
      ClsKindCool[i][k] := 0;
    if ActiveSlot[i] then
    begin
      ClsPerksApply(i);
      ShMaskForce(i);
      HudMarkL(i, HLB_CLASS);
      { E4: the map start took what the map change's respawn gave (mines, claymores, kits, bandage): again }
      if ClsActive then
        if PL[i].Alive then
          if (ClsOf[i] >= 1) and (ClsOf[i] <= ClsCount) then
            ClsGiveLoadout(i, ClsOf[i]);
    end;
  end;
end;

{ a paused tick: the clocks of the classes stand still (the cooldowns, a rally, the kits, the mortar) }
procedure ClsPauseShift();
var
  i, k: Integer;
begin
  for i := 1 to TopSlot do
  begin
    for k := 1 to 2 do
    begin
      if ClsCool[i][k] > 0 then
        ClsCool[i][k] := ClsCool[i][k] + 1;
      if ClsOn[i][k] > 0 then
        ClsOn[i][k] := ClsOn[i][k] + 1;
    end;
    for k := 1 to 15 do
      if ClsKindCool[i][k] > 0 then
        ClsKindCool[i][k] := ClsKindCool[i][k] + 1;
    if ClsMortN[i] > 0 then
      ClsMortAt[i] := ClsMortAt[i] + 1;
    if ClsCheckAt[i] > 0 then
      ClsCheckAt[i] := ClsCheckAt[i] + 1;
    if ClsAmmoAt[i] > 0 then
      ClsAmmoAt[i] := ClsAmmoAt[i] + 1;
    if ClsC4Low[i] > 0 then
      ClsC4Low[i] := ClsC4Low[i] + 1;
    if ClsGunUntil[i] > 0 then
    begin
      ClsGunUntil[i] := ClsGunUntil[i] + 1;
      ClsGunNext[i] := ClsGunNext[i] + 1;
    end;
    if ClsCloakUntil[i] > 0 then
      ClsCloakUntil[i] := ClsCloakUntil[i] + 1;
    if ClsRallyUntil[i] > 0 then
      ClsRallyUntil[i] := ClsRallyUntil[i] + 1;
    ClsSpawnTick[i] := ClsSpawnTick[i] + 1;
  end;
  for k := 0 to ClsObjN - 1 do
    ClsObjEnd[k] := ClsObjEnd[k] + 1;
  for k := 0 to BrgCount - 1 do
    BrgAt[k] := BrgAt[k] + 1;
end;

{ the tick: the weapons checked after a respawn, the mortar, the kits that go, once a second the auras and the lines
  of the cooldowns (idle: only what is on the map goes) }
{ CLS6: he or a mate of his within R px needs help - Mode 0: under 60 % health, 1: no grenade left, 2: either }
function ClsBotNeedNear(ID: Integer; R: Single; Mode: Integer): Boolean;
var
  j: Integer;
  DX, DY: Single;
  Tg: Boolean;
begin
  Result := False;
  Tg := TeamGame();
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if (j = ID) or (Tg and (TeamOf[j] = TeamOf[ID])) then
        if PL[j].Alive then
          if not DwDown[j] then
          begin
            DX := PL[j].X - PL[ID].X;
            DY := PL[j].Y - PL[ID].Y;
            if DX * DX + DY * DY <= R * R then
            begin
              if Mode <> 1 then
                if PL[j].Health < MaxHealth * 0.6 then
                  Result := True;
              if Mode <> 0 then
                if FnEnabled then
                  if FnNadeLeft[j] <= 0 then
                    Result := True;
              if Result then
                Exit;
            end;
          end;
end;

{ CLS6: whether a bot's skill helps now (once a second; a bot's aim is its target) }
function ClsBotWants(ID, c, n, Kind: Integer): Boolean;
var
  j, Dead, Mates: Integer;
  R: Single;
begin
  Result := False;
  case Kind of
    SK_HEALTHPACK:
      Result := ClsBotNeedNear(ID, 150, 0);
    SK_NADEKIT:
      Result := ClsBotNeedNear(ID, 150, 1);
    SK_SUPPLY:
      Result := ClsBotNeedNear(ID, 200, 2);
    SK_PATCHUP:
      begin
        Result := PL[ID].Health < MaxHealth * 0.5;
        if BdActive then
          if BdWounds[ID] > 0 then
            Result := True;
      end;
    SK_RESUPPLY:
      if FnEnabled then
        Result := FnNadeLeft[ID] <= 0;
    SK_STATGUN, SK_CLOAK:
      Result := ClsAimedEnemy(ID, 600) > 0;
    SK_MORTAR, SK_BARRAGE:
      Result := ClsAimedEnemy(ID, 1000) > 0;
    SK_C4, SK_STEAL:
      begin
        R := ClsSkP1[c][n];
        if R < 50 then
          R := 50;
        Result := ClsAimedEnemy(ID, R) > 0;
      end;
    SK_GUNSHIP:
      begin
        R := ClsSkP1[c][n];
        if R < 100 then
          R := 100;
        Result := ClsAimedEnemy(ID, R) > 0;
      end;
    SK_UAV, SK_SENSOR:
      { only for a team with somebody to look at the marks or the radar }
      if ShEnemiesAlive(ID) > 0 then
        for j := 1 to TopSlot do
          if ActiveSlot[j] then
            if HumanOf[j] then
              if TeamOf[j] = TeamOf[ID] then
                Result := True;
    SK_RALLY:
      begin
        Dead := 0;
        Mates := 0;
        for j := 1 to TopSlot do
          if j <> ID then
            if ActiveSlot[j] then
              if TeamOf[j] = TeamOf[ID] then
              begin
                Mates := Mates + 1;
                if not PL[j].Alive then
                  Dead := Dead + 1;
              end;
        Result := (Dead >= 2) or ((Mates = 1) and (Dead = 1));
      end;
  end;
end;

{ CLS6: [Classes] BotSkills - the bots use their skills (one a second at most); a bot's C4 goes off 2-3 s after it
  stuck }
procedure ClsBotSkills(Tick: Integer);
var
  i, c, n, Kind: Integer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if not HumanOf[i] then
      begin
        if ClsBotC4At[i] > 0 then
          if Tick >= ClsBotC4At[i] then
          begin
            ClsBotC4At[i] := 0;
            if PL[i].Alive then
              CmdC4(i);
          end;
        c := ClsOf[i];
        if (c < 1) or (c > ClsCount) then
          Continue;
        if not PL[i].Alive then
          Continue;
        if DwDown[i] or (BdShockUntil[i] > 0) then
          Continue;
        for n := 1 to 2 do
        begin
          Kind := ClsSk[c][n];
          if Kind = SK_NONE then
            Continue;
          if (ClsCool[i][n] > Tick) or (ClsOn[i][n] > Tick) then
            Continue;
          if ClsSkWhy(Kind) <> '' then
            Continue;
          if ClsBotWants(i, c, n, Kind) then
          begin
            ClsSkillUse(i, n);
            if Kind = SK_C4 then
              if ClsCool[i][n] > Tick then
                ClsBotC4At[i] := Tick + 150;
            Break;
          end;
        end;
      end;
end;

procedure ClsTick(Tick: Integer);
var
  i, k: Integer;
begin
  if ClsKitQN > 0 then
  begin
    for k := 0 to ClsKitQN - 1 do
      ClsKitTaken(ClsKitQT[k], ClsKitQS[k]);
    ClsKitQN := 0;
  end;
  if ClsCheckAny > 0 then
  begin
    ClsCheckAny := 0;
    for i := 1 to TopSlot do
      if ClsCheckAt[i] > 0 then
      begin
        if Tick >= ClsCheckAt[i] then
        begin
          ClsCheckAt[i] := 0;
          if ActiveSlot[i] then
            ClsArm(i);
        end
        else
          ClsCheckAny := ClsCheckAny + 1;
      end;
  end;
  { the rallies: the last ground of the one who called it (a mate comes back there while he is in the air) }
  if Tick mod 10 = 0 then
    for i := 1 to TopSlot do
      if ClsRallyUntil[i] > Tick then
        if ActiveSlot[i] then
          if PL[i].Alive then
            if PL[i].OnGround then
            begin
              ClsRallyGX[i] := PL[i].X;
              ClsRallyGY[i] := PL[i].Y;
              ClsRallyGOk[i] := True;
            end;
  ClsMortarTick(Tick);
  { a team's radar of a UAV or sensor ran out }
  if ClsSpotsMode = 1 then
    for k := 1 to 4 do
      if ClsRadarUntil[k] > 0 then
        if Tick >= ClsRadarUntil[k] then
        begin
          ClsRadarUntil[k] := 0;
          OverlayRecount();
        end;
  if ClsC4Any > 0 then
    if Tick mod 10 = 0 then
      ClsC4Tick(Tick);
  if BrgCount > 0 then
    ClsBarrageTick(Tick);
  if ClsGunAny > 0 then
    ClsGunTick(Tick);
  if ClsCloakAny > 0 then
    ClsCloakTick(Tick);
  if Tick mod 60 <> 0 then
    Exit;
  for k := ClsObjN - 1 downto 0 do
    if Tick >= ClsObjEnd[k] then
      ClsObjRemove(k, True);
  { the engineer's stationary guns go by the shop's clock - without the shop by this one }
  if not ShEnabled then
    ShStatTick(Tick);
  if not ClsActive then
    Exit;
  ClsAuras(Tick);
  ClsSensorTick(Tick);
  if ClsBotSkillsOn then
    if not PausedNow then
      ClsBotSkills(Tick);
  { the lines with a cooldown or a skill running: their seconds }
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      for k := 1 to 2 do
        if (ClsCool[i][k] > Tick - 60) or (ClsOn[i][k] > Tick - 60) then
          HudMarkL(i, HLB_CLASS);
end;

{ ---------------- the commands ---------------- }

{ his first magazine whole (he did not shoot since the respawn) }
function ClsFresh(ID: Integer): Boolean;
var
  W: Integer;
begin
  Result := True;
  W := PL[ID].Primary.WType;
  if (W >= 0) and (W <= 16) then
    if PL[ID].Primary.Ammo < ShMagOf(W) then
      Result := False;
  W := PL[ID].Secondary.WType;
  if (W >= 0) and (W <= 16) and (W <> WEP_KNIFE) then
    if PL[ID].Secondary.Ammo < ShMagOf(W) then
      Result := False;
  { B7/CLS4: anything of the loadout used since the respawn (a grenade or flash thrown, a mine or claymore planted, a
    Javelin fired, a C4 put on, a kit used) }
  if FnNadeLeft[ID] < ClsLoGiven[ID][0] then
    Result := False;
  if FnFlashLeft[ID] < ClsLoGiven[ID][1] then
    Result := False;
  if MnHave[ID] < ClsLoGiven[ID][2] then
    Result := False;
  if MnHaveC[ID] < ClsLoGiven[ID][3] then
    Result := False;
  if RkUsed[ID] > ClsLoGiven[ID][4] then
    Result := False;
  if ClsC4Left[ID] < ClsLoGiven[ID][5] then
    Result := False;
  if BdKits[ID] < ClsLoGiven[ID][6] then
    Result := False;
end;

{ !class [name|number] }
procedure CmdClass(ID: Integer; Args: string);
var
  c, Tick: Integer;
  W: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ClsActive then
  begin
    Say(ID, 'Classes are off here (' + ClsIdleWhy + ').', ColorBad);
    Exit;
  end;
  W := Trim(Args);
  if W = '' then
  begin
    c := ClsOf[ID];
    if (c >= 1) and (c <= ClsCount) then
    begin
      Say(ID, 'You are ' + ClsName[c] + ': ' + ClsInfo[c], ClsColor[c]);
      Say(ID, 'Weapons: ' + ClsWeaponsText(c) + '; ' + ClsSkillsText(c), ClsColor[c]);
    end;
    if ClsNext[ID] > 0 then
      Say(ID, 'Next life: ' + ClsName[ClsNext[ID]] + '.', ClsHudColor);
    if ClsChoosing() then
      Say(ID, '!class <name or number> for your next life (now within ' + IntToStr(ClsChangeTicks div 60) +
        ' s of a respawn), !classes: all of them' + ShIf(ClsAssign = CL_LIMITED,
        ' (a team''s classes stay mixed)', '') + '.', ClsHudColor)
    else if ClsAssign = CL_LIFE then
      Say(ID, 'A new class every life (the one your team has fewest of); !classes: all of them.', ClsHudColor)
    else if ClsAssign = CL_MAP then
      Say(ID, 'One class for the whole map; !classes: all of them.', ClsHudColor)
    else
      Say(ID, 'A new class every round; !classes: all of them.', ClsHudColor);
    Exit;
  end;
  if not ClsChoosing() then
  begin
    if ClsAssign = CL_MAP then
      Say(ID, 'The classes are given here (one for the whole map).', ColorBad)
    else
      Say(ID, 'The classes are given here (' + ShIf(ClsAssign = CL_LIFE, 'a new one every life',
        'a new one every round') + ').', ColorBad);
    Exit;
  end;
  if TeamOf[ID] = TEAM_SPECTATOR then
  begin
    Say(ID, 'Join a team first.', ColorBad);
    Exit;
  end;
  c := ClsOfWord(W);
  if c = 0 then
  begin
    Say(ID, 'No class "' + W + '": !classes', ColorBad);
    Exit;
  end;
  if not ClsFor(ID, c) then
  begin
    Say(ID, ClsName[c] + ' is not a class of your side here.', ColorBad);
    Exit;
  end;
  if (c <> ClsOf[ID]) and (c <> ClsNext[ID]) then
    if ClsTeamCount(TeamOf[ID], c, ID) >= ClsCap(c, TeamOf[ID]) then
    begin
      Say(ID, 'Your team has ' + IntToStr(ClsCap(c, TeamOf[ID])) + ' ' + ClsName[c] + ' already.', ColorBad);
      Exit;
    end;
  { Assign = limited: a team's classes stay mixed }
  if ClsAssign = CL_LIMITED then
    if (c <> ClsOf[ID]) and (c <> ClsNext[ID]) then
      if not ClsLimitOk(ID, c) then
      begin
        Say(ID, 'Your team has enough ' + ClsName[c] + ' now - choose a class it has fewer of (!classes).', ColorBad);
        Exit;
      end;
  Tick := Game.TickCount;
  { right after a respawn, with nothing used yet (no skill, no shot of his magazine): at once - the loadout
    replaced, the weapons of the class }
  if PL[ID].Alive then
    if c <> ClsOf[ID] then
      if not ClsUsed[ID] then
        if Tick - ClsSpawnTick[ID] <= ClsChangeTicks then
          if not DwDown[ID] then
            if ClsFresh(ID) then
          begin
            ClsSet(ID, c, True);
            ClsGiveLoadout(ID, c);
            ClsArm(ID);
            Exit;
          end;
  if c = ClsOf[ID] then
  begin
    if ClsNext[ID] > 0 then
    begin
      ClsNext[ID] := 0;
      ShMaskSend(ID);
      HudMarkL(ID, HLB_CLASS);
    end;
    Say(ID, 'You stay ' + ClsName[c] + '.', ClsColor[c]);
    Exit;
  end;
  ClsSetNext(ID, c, True);
end;

{ !classes: every class with the players of his team, the limit, the weapons }
procedure CmdClasses(ID: Integer);
var
  c, Tm: Integer;
  T, M: string;
begin
  if not ClsActive then
  begin
    Say(ID, 'Classes are off here (' + ClsIdleWhy + ').', ColorBad);
    Exit;
  end;
  Tm := -1;
  if (ID >= 1) and (ID <= 32) then
    Tm := TeamOf[ID];
  for c := 1 to ClsCount do
    if ((ID >= 1) and (ID <= 32) and ClsFor(ID, c)) or (((ID < 1) or (ID > 32)) and ClsModeOk(c)) then
    begin
      T := IntToStr(c) + '. ' + ClsName[c];
      if (Tm >= 0) and (Tm <= 4) then
      begin
        M := '';
        if ClsCap(c, Tm) < 1000 then
          M := '/' + IntToStr(ClsCap(c, Tm));
        T := T + ' (' + IntToStr(ClsTeamCount(Tm, c, 0)) + M + ')';
      end;
      Say(ID, T + ': ' + ClsWeaponsText(c) + ' - ' + ClsInfo[c], ClsColor[c]);
