{ a field of 'a | b | c' }
function ShField(S: string; k: Integer): string;
var
  i, p: Integer;
  R: string;
begin
  Result := '';
  R := S + '|';
  for i := 0 to k do
  begin
    p := Pos('|', R);
    if p = 0 then
    begin
      Result := '';
      Exit;
    end;
    Result := Trim(Copy(R, 1, p - 1));
    Delete(R, 1, p);
  end;
end;

{ the server's weapon list (soldat.ini [GAME] Weapon_1..14, read only): a weapon off there is never sold }
procedure ShReadServerWeapons();
var
  L: TStringList;
  i, k, n: Integer;
  S, Key: string;
  InGame: Boolean;
begin
  for k := 0 to 16 do
    ShServerW[k] := True;
  if not File.Exists('soldat.ini') then
    Exit;
  L := File.CreateStringListFromFile('soldat.ini');
  InGame := False;
  for i := 0 to L.Count - 1 do
  begin
    S := Trim(L[i]);
    if Copy(S, 1, 1) = '[' then
      InGame := LowerCase(S) = '[game]'
    else if InGame then
      if LowerCase(Copy(S, 1, 7)) = 'weapon_' then
        if Pos('=', S) > 0 then
        begin
          Key := Trim(Copy(S, 8, Pos('=', S) - 8));
          n := StrToIntDef(Key, 0);
          { the menu slots: 1-10 the primaries, 11 SOCOM, 12 knife, 13 chainsaw, 14 LAW }
          if (n >= 1) and (n <= 14) then
            if Trim(Copy(S, Pos('=', S) + 1, 10)) = '0' then
            begin
              if n <= 10 then
                ShServerW[n] := False
              else if n = 11 then
                ShServerW[0] := False
              else
                ShServerW[n - 1] := False;
            end;
        end;
  end;
  L.Free;
end;

