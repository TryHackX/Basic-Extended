end;

{ ---------------- [AdminChat] ---------------- }

{ a colour word: #RRGGBB, $RRGGBB, 0xRRGGBB, RRGGBB or a name of Colors; -1 = not a colour }
function CcColorOf(Word: string): Longint;
var
  S, H, N: string;
  p, k: Integer;
  Hex: Boolean;
begin
  Result := -1;
  S := LowerCase(Trim(Word));
  if S = '' then
    Exit;
  H := '';
  if (S[1] = '#') or (S[1] = '$') then
    H := Copy(S, 2, Length(S))
  else if Copy(S, 1, 2) = '0x' then
    H := Copy(S, 3, Length(S))
  else if Length(S) = 6 then
    H := S;
  if Length(H) = 6 then
  begin
    { six hex digits (not emptied inside the loop: the next H[k] would read past its end) }
    Hex := True;
    for k := 1 to 6 do
      if Pos(H[k], '0123456789abcdef') = 0 then
        Hex := False;
    if Hex then
    begin
      Result := StrToIntDef('$' + H, -1);
      Exit;
    end;
  end;
  { a name of the list: 'red $FF0000|green $00FF00' }
  N := '|' + CcColorNames + '|';
  p := Pos('|' + S + ' ', N);
  if p = 0 then
    Exit;
  N := Copy(N, p + Length(S) + 2, Length(N));
  p := Pos('|', N);
  if p > 0 then
    N := Copy(N, 1, p - 1);
  N := Trim(N);
  if N <> '' then
    if N[1] = '#' then
      N := '$' + Copy(N, 2, Length(N));
  Result := StrToIntDef(N, -1);
end;

{ the team a word names: alpha bravo charlie delta spectators or 1-5; -1 = none }
function CcTeamOf(Word: string): Integer;
var
  S: string;
begin
  S := LowerCase(Trim(Word));
  Result := StrToIntDef(S, -1);
  if (Result >= 1) and (Result <= 5) then
    Exit;
  Result := -1;
  if (S = 'alpha') or (S = 'red') or (S = 'a') then
    Result := 1
  else if (S = 'bravo') or (S = 'blue') or (S = 'b') then
    Result := 2
  else if (S = 'charlie') or (S = 'c') then
    Result := 3
  else if (S = 'delta') or (S = 'd') then
    Result := 4
  else if (S = 'spec') or (S = 'spectators') or (S = 's') then
    Result := 5;
end;

{ /col [colour] <text> to everybody (Mode 0), /colteam <team> [colour] <text> (1), /colp <player> [colour]
  <text> (2), /announce [colour] <text> (3: in the middle of the screens too) }
procedure CmdCol(ID: Integer; Args: string; Mode: Integer);
var
  Rest, W, Text, Who: string;
  T, Tm, i, n: Integer;
  C: Longint;
begin
  if not CcEnabled then
    Exit;
  Rest := Args;
  T := 0;
  Tm := -1;
  if Mode = 1 then
  begin
    Tm := CcTeamOf(TakeArg(Rest));
    if Tm < 0 then
    begin
      Say(ID, 'Use: /colteam <alpha|bravo|charlie|delta|spec> [colour] <text>', ColorBad);
      Exit;
    end;
  end
  else if Mode = 2 then
  begin
    W := TakeArg(Rest);
    T := AdFindOne(ID, W);
    if T = 0 then
    begin
      Say(ID, 'Use: /colp <player id or name> [colour] <text>', ColorBad);
      Exit;
    end;
    if T < 0 then
      Exit;
  end;
  Rest := Trim(Rest);
  C := CcDefColor;
  W := Rest;
  i := Pos(' ', W);
  if i > 0 then
  begin
    W := Copy(W, 1, i - 1);
    if CcColorOf(W) >= 0 then
    begin
      C := CcColorOf(W);
      Rest := Trim(Copy(Rest, i + 1, Length(Rest)));
    end;
  end;
  if Rest = '' then
  begin
    Say(ID, 'Use: /col [colour] <text> - a colour: #RRGGBB, $RRGGBB, RRGGBB or ' + ReplaceAll(CcColorNames, '|', ', '),
      ColorBad);
    Exit;
  end;
  Who := 'Server';
  if (ID >= 1) and (ID <= 32) then
    Who := PL[ID].Name;
  Text := AdFill2(CcFormat, '{text}', Rest, '{admin}', Who);
  if Mode = 2 then
  begin
    Say(T, Text, C);
    if ID <> T then
      Say(ID, 'To ' + PL[T].Name + ': ' + Text, C);
    Exit;
  end;
  if Mode = 1 then
  begin
    n := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if HumanOf[i] then
          if TeamOf[i] = Tm then
          begin
            Say(i, Text, C);
            n := n + 1;
          end;
    if (ID >= 1) and (ID <= 32) then
      if TeamOf[ID] <> Tm then
        Say(ID, 'To ' + TeamName(Tm) + ' (' + IntToStr(n) + '): ' + Text, C);
    Exit;
  end;
  SayAll(Text, C);
  if Mode = 3 then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if HumanOf[i] or DebugBots then
          PL[i].BigText(CcBigLayer, Rest, CcBigTicks, C, CcBigScale, CcBigX, CcBigY);
end;

{ ---------------- [AntiSpam]: chat flood control, timed mutes ---------------- }

{ seconds since 2000 (by the clock: a mute lasts across map changes, restarts of the script, a rejoin) }
function SqNow(): Integer;
begin
  Result := Round((Now - 36526) * 86400);
end;

{ a line folded for the repeat test: small letters, no spaces or marks, a letter repeated once }
function SqFold(Text: string): string;
var
  i, n, c, Last: Integer;
begin
  Result := '';
  Last := -1;
  n := Length(Text);
  if n > 200 then
    n := 200;
  for i := 1 to n do
  begin
    c := Ord(Text[i]);
    if (c >= 65) and (c <= 90) then
      c := c + 32;
    if ((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) then
      if c <> Last then
      begin
        Result := Result + Chr(c);
        Last := c;
        if Length(Result) >= 60 then
          Exit;
      end;
  end;
end;

{ the share of capitals among the letters (0-100) }
function SqCaps(Text: string): Integer;
var
  i, n, c, Up, Al: Integer;
begin
  Up := 0;
  Al := 0;
  n := Length(Text);
  if n > 200 then
    n := 200;
  for i := 1 to n do
  begin
    c := Ord(Text[i]);
    if (c >= 65) and (c <= 90) then
    begin
      Up := Up + 1;
      Al := Al + 1;
    end
    else if (c >= 97) and (c <= 122) then
      Al := Al + 1;
  end;
  Result := 0;
  if Al >= 8 then
    Result := Up * 100 div Al;
end;

{ the share of the commonest character but the space (0-100), for "aaaaaaaa" and "!!!!!!!!" }
function SqOneChar(Text: string): Integer;
var
  i, n, c, Best: Integer;
  Cnt: array[0..255] of Integer;
begin
  Result := 0;
  n := Length(Text);
  if n < 8 then
    Exit;
  if n > 200 then
    n := 200;
  for i := 0 to 255 do
    Cnt[i] := 0;
  Best := 0;
  for i := 1 to n do
  begin
    c := Ord(Text[i]) and 255;
    if c <> 32 then
    begin
      Cnt[c] := Cnt[c] + 1;
      if Cnt[c] > Best then
        Best := Cnt[c];
    end;
  end;
  Result := Best * 100 div n;
end;

{ the record of a mute in SqList: 'ip|key|until|strikes|last|reason' (seconds of SqNow); the index for
  his IP or key, -1 = none }
function SqFind(Ip, Key: string): Integer;
var
  i: Integer;
  S: string;
begin
  Result := -1;
  if SqList = nil then
    Exit;
  for i := 0 to SqList.Count - 1 do
  begin
    S := SqList[i];
    if Ip <> '' then
      if Copy(S, 1, Length(Ip) + 1) = Ip + '|' then
      begin
        Result := i;
        Exit;
      end;
    if Key <> '' then
      if Pos('|' + Key + '|', S) > 0 then
      begin
        Result := i;
        Exit;
      end;
  end;
end;

function SqPart(S: string; k: Integer): string;
var
  i, p: Integer;
  R: string;
begin
  Result := '';
  R := S + '|';
  for i := 0 to k do
  begin
    p := Pos('|', R);
    if p = 0 then
      Exit;
    Result := Copy(R, 1, p - 1);
    Delete(R, 1, p);
  end;
end;

{ the records nobody needs any more: the mute was lifted in the game and the last strike is older than MemoryMinutes.
  A mute that ran out while he was away stays until he comes back (the server mutes his address again at the join
  and only this record lets SqJoin lift it) - at most 30 days }
procedure SqPrune();
var
  i, N0, U: Integer;
begin
  if SqList = nil then
    Exit;
  N0 := SqNow();
  for i := SqList.Count - 1 downto 0 do
  begin
    U := StrToIntDef(SqPart(SqList[i], 2), 0);
    if U = 0 then
    begin
      if N0 - StrToIntDef(SqPart(SqList[i], 4), 0) > SqMemory then
        SqList.Delete(i);
    end
    else if U <= N0 then
      if N0 - U > 30 * 86400 then
        SqList.Delete(i);
  end;
end;

procedure SqSave();
begin
  SqDirty := False;
  if SqList = nil then
    Exit;
  SqPrune();
  if SqFileName = '' then
    Exit;
  if not SaveListFile(SqList, DataDir + SqFileName) then
    Log('[AntiSpam] cannot write ' + DataDir + SqFileName);
end;

procedure SqLoad();
var
  L: TStringList;
  i: Integer;
begin
  if SqList <> nil then
    Exit;
  SqList := File.CreateStringList();
  if SqFileName = '' then
    Exit;
  if not File.Exists(DataDir + SqFileName) then
    Exit;
  L := File.CreateStringListFromFile(DataDir + SqFileName);
  for i := 0 to L.Count - 1 do
    if Pos('|', L[i]) > 0 then
      SqList.Add(Trim(L[i]));
  L.Free;
  SqPrune();
end;

{ the strikes he has now (they are forgotten after MemoryMinutes without a mute) }
function SqStrikes(k: Integer): Integer;
begin
  Result := 0;
  if (k < 0) or (SqList = nil) then
    Exit;
  Result := StrToIntDef(SqPart(SqList[k], 3), 0);
  if SqNow() - StrToIntDef(SqPart(SqList[k], 4), 0) > SqMemory then
    Result := 0;
end;

{ mute him for Secs seconds (Strike: an automatic mute, counted for the next ones) }
procedure SqMute(ID, Secs: Integer; Reason: string; Strike: Boolean);
var
  k, St, Until0: Integer;
  Ip, Key: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  SqLoad();
  Ip := PL[ID].IP;
  Key := AdKeyOf(ID);
  k := SqFind(Ip, Key);
  St := SqStrikes(k);
  if Strike then
    St := St + 1;
  Until0 := SqNow() + Secs;
  if k >= 0 then
    SqList.Delete(k);
  SqList.Add(Ip + '|' + Key + '|' + IntToStr(Until0) + '|' + IntToStr(St) + '|' + IntToStr(SqNow()) + '|' +
    AdClean(Reason));
  SqDirty := True;
  PL[ID].Muted := True;
  SqMutedUntil[ID] := Until0;
  SqPoints[ID] := 0;
  SqStatMutes := SqStatMutes + 1;
  Say(ID, ReplaceAll(ReplaceAll(SqMutedText, '{seconds}', IntToStr(Secs)), '{reason}', Reason), ColorBad);
  if SqTellAll then
    SayAll(ReplaceAll(ReplaceAll(ReplaceAll(SqAllText, '{player}', PL[ID].Name), '{seconds}', IntToStr(Secs)),
      '{reason}', Reason), SqColor);
  Log('[AntiSpam] ' + PL[ID].Name + ' muted for ' + IntToStr(Secs) + ' s: ' + Reason);
end;

{ the mute is over (his record keeps the strikes) }
procedure SqUnmute(ID: Integer; Tell: Boolean);
var
  k: Integer;
  S: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  SqMutedUntil[ID] := 0;
  if ActiveSlot[ID] then
    if PL[ID].Muted then
      PL[ID].Muted := False;
  SqLoad();
  k := SqFind(PL[ID].IP, AdKeyOf(ID));
  if k >= 0 then
  begin
    S := SqList[k];
    SqList[k] := SqPart(S, 0) + '|' + SqPart(S, 1) + '|0|' + SqPart(S, 3) + '|' + SqPart(S, 4) + '|' + SqPart(S, 5);
    SqDirty := True;
  end;
  if Tell then
    Say(ID, SqUnmutedText, ColorGood);
end;

{ a player in the game: a mute of this script still running is kept on him (the server mutes his IP again
  at the join by itself); one that is over is lifted - also one the server put on him again after he left
  muted; a mute that is not this script's (an admin's own /mute) is left alone }
procedure SqJoin(ID: Integer);
var
  k, U: Integer;
begin
  if not SqEnabled then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  SqPoints[ID] := 0;
  SqLastTick[ID] := 0;
  SqWarnTick[ID] := 0;
  SqMutedUntil[ID] := 0;
  SqLine1[ID] := '';
  SqLine2[ID] := '';
  SqLine3[ID] := '';
  if not HumanOf[ID] then
    Exit;
  SqLoad();
  k := SqFind(PL[ID].IP, AdKeyOf(ID));
  if k < 0 then
    Exit;
  U := StrToIntDef(SqPart(SqList[k], 2), 0);
  if U > SqNow() then
  begin
    SqMutedUntil[ID] := U;
    if not PL[ID].Muted then
      PL[ID].Muted := True;
  end
  else if U > 0 then
    SqUnmute(ID, False);
end;

{ a chat line (every line, before the commands): its weight; a warning, a mute }
procedure SqLine(ID: Integer; Text: string; Tick: Integer);
var
  W, Dec0: Single;
  F, S: string;
  k, Secs, CapsP, OneP: Integer;
begin
  if not SqActive then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not HumanOf[ID] then
    Exit;
  if SqIgnoreAdmins then
    if PL[ID].IsAdmin then
      Exit;
  if SqMutedUntil[ID] > 0 then
    Exit;
  S := Trim(Text);
  if S = '' then
    Exit;
  if not SqCommands then
    if (S[1] = '!') or (S[1] = '/') then
      Exit;
  { the points melt }
  if SqLastTick[ID] > 0 then
  begin
    Dec0 := (Tick - SqLastTick[ID]) * SqDecay / 60;
    SqPoints[ID] := SqPoints[ID] - Dec0;
    if SqPoints[ID] < 0 then
      SqPoints[ID] := 0;
  end;
  W := 1;
  if SqLastTick[ID] > 0 then
    if Tick - SqLastTick[ID] < SqBurstTicks then
      W := W + SqBurstW;
  { the line weighed in the library in one pass (the script's three walks over it cost up to 1 ms a line) }
  CapsP := 0;
  OneP := 0;
  if BeOk then
    F := BE_ChatWeigh(PChar(S), CapsP, OneP)
  else
  begin
    F := SqFold(S);
    CapsP := SqCaps(S);
    OneP := SqOneChar(S);
  end;
  if F <> '' then
    if (F = SqLine1[ID]) or (F = SqLine2[ID]) or (F = SqLine3[ID]) then
      W := W + SqRepeatW;
  if Length(S) > SqLongLen then
    W := W + SqLongW;
  if CapsP >= SqCapsPct then
    W := W + SqCapsW;
  if OneP >= 60 then
    W := W + SqCharW;
  SqLine3[ID] := SqLine2[ID];
  SqLine2[ID] := SqLine1[ID];
  SqLine1[ID] := F;
  SqLastTick[ID] := Tick;
  SqPoints[ID] := SqPoints[ID] + W;
  if SqPoints[ID] >= SqMuteAt then
  begin
    SqLoad();
    k := SqFind(PL[ID].IP, AdKeyOf(ID));
    Secs := SqMuteSecs;
    k := SqStrikes(k);
    while k > 0 do
    begin
      Secs := Secs * 2;
      if Secs >= SqMaxSecs then
      begin
        Secs := SqMaxSecs;
        k := 0;
      end;
      k := k - 1;
    end;
    SqMute(ID, Secs, 'chat flood', True);
    Exit;
  end;
  if SqPoints[ID] >= SqWarnAt then
    if Tick - SqWarnTick[ID] > SqBurstTicks * 3 then
    begin
      SqWarnTick[ID] := Tick;
      SqStatWarns := SqStatWarns + 1;
      Say(ID, SqWarnText, ColorBad);
    end;
end;

{ once a second: the mutes that are over }
procedure SqTickRun(Tick: Integer);
var
  i, N0: Integer;
begin
  if Tick mod 60 <> 0 then
    Exit;
  N0 := SqNow();
  for i := 1 to TopSlot do
    if SqMutedUntil[i] > 0 then
      if N0 >= SqMutedUntil[i] then
        SqUnmute(i, True);
  if SqDirty then
    if Tick - SqSavedTick >= 300 then
    begin
      SqSavedTick := Tick;
      SqSave();
    end;
end;

{ /mute <player> [time] [reason]: time like 30s, 10m, 2h, 1d (MuteDefault without one) }
function SqTimeOf(W: string): Integer;
var
  S, U: string;
  n: Integer;
begin
  Result := -1;
  S := LowerCase(Trim(W));
  if S = '' then
    Exit;
  U := Copy(S, Length(S), 1);
  if Pos(U, '0123456789') > 0 then
  begin
    n := StrToIntDef(S, -1);
    if n >= 0 then
      Result := n * 60;
    Exit;
  end;
  n := StrToIntDef(Copy(S, 1, Length(S) - 1), -1);
  if n < 0 then
    Exit;
  if U = 's' then
    Result := n
  else if U = 'm' then
    Result := n * 60
  else if U = 'h' then
    Result := n * 3600
  else if U = 'd' then
    Result := n * 86400
  else if U = 'w' then
    Result := n * 604800;
end;

procedure CmdMute(ID: Integer; Args: string);
var
  Rest, W: string;
  T, Secs: Integer;
begin
  if not SqEnabled then
    Exit;
  Rest := Args;
  W := TakeArg(Rest);
  T := AdFindOne(ID, W);
  if T = 0 then
  begin
    Say(ID, 'Use: /' + SqMuteWord + ' <player> [time: 30s, 10m, 2h, 1d] [reason]', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  Rest := Trim(Rest);
  Secs := SqDefSecs;
  W := Rest;
  if Pos(' ', W) > 0 then
    W := Copy(W, 1, Pos(' ', W) - 1);
  if SqTimeOf(W) > 0 then
  begin
    Secs := SqTimeOf(W);
    Rest := Trim(Copy(Rest, Length(W) + 1, Length(Rest)));
  end;
  if Secs > 31536000 then
    Secs := 31536000;
  if Rest = '' then
    Rest := 'muted by an admin';
  SqMute(T, Secs, Rest, False);
  Say(ID, PL[T].Name + ' is muted for ' + IntToStr(Secs div 60) + ' min ' + IntToStr(Secs mod 60) + ' s.', ColorGood);
end;

procedure CmdUnmute(ID: Integer; Args: string);
var
  T: Integer;
begin
  if not SqEnabled then
    Exit;
  T := AdFindOne(ID, Args);
  if T = 0 then
  begin
    Say(ID, 'Use: /unmute <player>', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  SqUnmute(T, True);
  if PL[T].Muted then
    PL[T].Muted := False;
  Say(ID, PL[T].Name + ' can talk again.', ColorGood);
end;

procedure CmdMuteList(ID: Integer);
var
  i, n, U, N0: Integer;
begin
  if not SqEnabled then
    Exit;
  SqLoad();
  N0 := SqNow();
  n := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] and HumanOf[i] then
      if PL[i].Muted then
      begin
        n := n + 1;
        if SqMutedUntil[i] > 0 then
        begin
          U := SqMutedUntil[i] - N0;
          Say(ID, '(' + IntToStr(i) + ') ' + PL[i].Name + ': ' + IntToStr(U div 60) + ' min ' + IntToStr(U mod 60) +
            ' s left', SqColor);
        end
        else
          Say(ID, '(' + IntToStr(i) + ') ' + PL[i].Name + ': muted by the server (not timed by this script)', SqColor);
      end;
  if n = 0 then
    Say(ID, 'Nobody in the game is muted.', ColorGood);
end;

{ ---------------- [Pause]: !p, !up, /pause, /unpause with a countdown ---------------- }

procedure PzBig(Text: string; Ticks: Integer; Color: Longint);
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] or DebugBots then
        PL[i].BigText(PzBigLayer, Text, Ticks, Color, PzBigScale, PzBigX, PzBigY);
end;

{ seconds by the clock (the countdown must run while the game stands) }
function PzClock(): Double;
begin
  Result := (Now - 36526) * 86400;
end;

{ his key for the pauses of a map: his computer id (known at the join), else his key }
function PzKeyOf(ID: Integer): string;
begin
  Result := '';
  if HumanOf[ID] then
    if Trim(PL[ID].HWID) <> '' then
      Result := 'H' + Trim(PL[ID].HWID);
  if Result = '' then
    Result := AdKeyOf(ID);
  Result := ReplaceAll(Result, '=', '_');
end;

{ the pauses he used on this map (by his key: a rejoin in another slot keeps them) }
function PzUsedBy(ID: Integer): Integer;
var
  k: Integer;
  K0: string;
begin
  Result := 0;
  if PzKeys = nil then
    Exit;
  K0 := PzKeyOf(ID);
  if K0 = '' then
    Exit;
  k := PzKeys.IndexOfName(K0);
  if k >= 0 then
    Result := StrToIntDef(Copy(PzKeys[k], Pos('=', PzKeys[k]) + 1, 10), 0);
end;

procedure PzRemember(ID: Integer);
var
  k: Integer;
  K0: string;
begin
  if PzKeys = nil then
    PzKeys := File.CreateStringList();
  K0 := PzKeyOf(ID);
  if K0 = '' then
    Exit;
  k := PzKeys.IndexOfName(K0);
  if k >= 0 then
    PzKeys.Delete(k);
  PzKeys.Add(K0 + '=' + IntToStr(PzUsed[ID]));
end;

procedure CmdPause(ID: Integer; Console: Boolean);
var
  Admin: Boolean;
  Who: string;
begin
  if not PzEnabled then
    Exit;
  Admin := Console;
  if not Admin then
    if (ID >= 1) and (ID <= 32) then
      Admin := PL[ID].IsAdmin;
  if Game.Paused then
  begin
    if PzCountEnd > 0 then
    begin
      if not Admin then
        if (PzByAdmin) or (PzBy <> ID) then
        begin
          Say(ID, 'Only an admin (or the one who paused) can stop the countdown.', ColorBad);
          Exit;
        end;
      { a pause again during the countdown: it stays paused }
      PzCountEnd := 0;
      PzSince := PzClock();
      SayAll('The countdown is stopped: the game stays paused.', PzColor);
      PzBig(PzPausedText, 600, PzColor);
      Exit;
    end;
    Say(ID, 'The game is paused already.', ColorBad);
    Exit;
  end;
  if MapChanging then
  begin
    Say(ID, 'Not during a map change (a pause would lose it).', ColorBad);
    Exit;
  end;
  if not Admin then
  begin
    if not PzPlayers then
    begin
      Say(ID, 'Only the admins pause the game here.', ColorBad);
      Exit;
    end;
    if Game.NumPlayers < PzMinPlayers then
    begin
      Say(ID, 'A pause needs at least ' + IntToStr(PzMinPlayers) + ' players.', ColorBad);
      Exit;
    end;
    if PzPerMap > 0 then
      if PzUsed[ID] >= PzPerMap then
      begin
        Say(ID, 'You used your pause' + iif(PzPerMap = 1, '', 's') + ' on this map.', ColorBad);
        Exit;
      end;
    PzUsed[ID] := PzUsed[ID] + 1;
    PzRemember(ID);
  end;
  Game.Paused := True;
  PzBy := ID;
  PzByKey := '';
  Who := 'The server';
  if (ID >= 1) and (ID <= 32) then
  begin
    PzByKey := AdKeyOf(ID);
    Who := PL[ID].Name;
  end;
  PzByAdmin := Admin;
  PzSince := PzClock();
  PzCountEnd := 0;
  PzStatPauses := PzStatPauses + 1;
  SayAll(ReplaceAll(PzPauseText, '{player}', Who), PzColor);
  PzBig(PzPausedText, 600, PzColor);
end;

procedure CmdUnpause(ID: Integer; Console: Boolean);
var
  Admin: Boolean;
  Who: string;
begin
  if not PzEnabled then
    Exit;
  if not Game.Paused then
  begin
    Say(ID, 'The game is not paused.', ColorBad);
    Exit;
  end;
  if PzCountEnd > 0 then
  begin
    Say(ID, 'The game is about to go on.', ColorBad);
    Exit;
  end;
  Admin := Console;
  if not Admin then
    if (ID >= 1) and (ID <= 32) then
      Admin := PL[ID].IsAdmin;
  if not Admin then
  begin
    if PzWho = 2 then
    begin
      Say(ID, 'Only the admins end a pause here.', ColorBad);
      Exit;
    end;
    if PzWho = 0 then
      if PzByAdmin or (AdKeyOf(ID) <> PzByKey) then
      begin
        Say(ID, 'Only the one who paused (or an admin) ends this pause.', ColorBad);
        Exit;
      end;
  end;
  Who := 'The server';
  if (ID >= 1) and (ID <= 32) then
    Who := PL[ID].Name;
  PzCountEnd := PzClock() + PzCountSecs;
  PzLastShown := -1;
  SayAll(ReplaceAll(ReplaceAll(PzResumeText, '{player}', Who), '{seconds}', IntToStr(PzCountSecs)), PzColor);
end;

{ the countdown, a player's pause that lasts too long (by the clock: the game's ticks stand while paused) }
procedure PzTickRun;
var
  Left: Double;
  n: Integer;
begin
  if not Game.Paused then
  begin
    if (PzCountEnd > 0) or (PzSince > 0) then
    begin
      PzCountEnd := 0;
      PzSince := 0;
      PzBy := 0;
    end;
    Exit;
  end;
  { paused by somebody else (the server's own /pause from another script) }
  if PzSince = 0 then
  begin
    PzSince := PzClock();
    PzByAdmin := True;
  end;
  if PzCountEnd = 0 then
  begin
    if not PzByAdmin then
      if PzMaxSecs > 0 then
        if PzClock() - PzSince >= PzMaxSecs then
        begin
          PzCountEnd := PzClock() + PzCountSecs;
          PzLastShown := -1;
          SayAll('The pause is over (' + IntToStr(PzMaxSecs) + ' s).', PzColor);
        end;
    Exit;
  end;
  Left := PzCountEnd - PzClock();
  if Left <= 0 then
  begin
    PzCountEnd := 0;
    PzSince := 0;
    PzBy := 0;
    Game.Paused := False;
    PzBig(PzGoText, 90, PzColor);
    Exit;
  end;
  n := Trunc(Left) + 1;
  if n <> PzLastShown then
  begin
    PzLastShown := n;
    PzBig(ReplaceAll(PzCountText, '{seconds}', IntToStr(n)), 80, PzColor);
  end;
end;

{ ---------------- the ban journal: /unbanlast [n | time], /banlist ---------------- }

{ 'kind value' of the ban list now (IP: 'i 1.2.3.4', HW: 'h ABCDEF'), with its reason after #1 }
procedure UbSnapshot(L: TStringList);
var
  i, n: Integer;
  R: TBannedIP;
  H: TBannedHW;
begin
  L.Clear;
  n := Game.BanLists.BannedIPCount;
  for i := 1 to n do
  begin
    R := Game.BanLists.IP[i];
    if R.IP <> '' then
      L.Add('i ' + R.IP + #1 + R.Reason + #1 + IntToStr(R.Time));
  end;
  n := Game.BanLists.BannedHWCount;
  for i := 1 to n do
  begin
    H := Game.BanLists.HW[i];
    if H.HW <> '' then
      L.Add('h ' + H.HW + #1 + H.Reason + #1 + IntToStr(H.Time));
  end;
end;

function UbHead(S: string): string;
var
  p: Integer;
begin
  p := Pos(#1, S);
  Result := S;
  if p > 0 then
    Result := Copy(S, 1, p - 1);
end;

function UbTail(S: string; k: Integer): string;
var
  i, p: Integer;
  R: string;
begin
  R := S + #1;
  Result := '';
  for i := 0 to k do
  begin
    p := Pos(#1, R);
    if p = 0 then
      Exit;
    Result := Copy(R, 1, p - 1);
    Delete(R, 1, p);
  end;
end;

{ the journal from the data folder: 'seconds|kind value|reason|minutes|name', the last 1000 }
procedure UbLoad();
var
  L: TStringList;
  i, n: Integer;
begin
  if UbJournal <> nil then
    Exit;
  UbJournal := File.CreateStringList();
  UbNow := File.CreateStringList();
  UbHeads := File.CreateStringList();
  { a sorted set: IndexOf by halves }
  UbHeads.Sorted := True;
  if UbFileName <> '' then
    if File.Exists(DataDir + UbFileName) then
    begin
      L := File.CreateStringListFromFile(DataDir + UbFileName);
      { F11: only the last 1000 entries are kept (the file only grows): the ones before are skipped, not deleted }
      n := 0;
      for i := 0 to L.Count - 1 do
        if Pos('|', L[i]) > 0 then
          n := n + 1;
      n := n - 1000;
      for i := 0 to L.Count - 1 do
        if Pos('|', L[i]) > 0 then
        begin
          if n > 0 then
            n := n - 1
          else
            UbJournal.Add(L[i]);
        end;
      L.Free;
    end;
end;

{ the name of a journal line ('' = an old line without one: SqPart would give its last part) }
function UbNameField(Line: string): string;
var
  i, n: Integer;
begin
  Result := '';
  n := 0;
  for i := 1 to Length(Line) do
    if Line[i] = '|' then
      n := n + 1;
  if n >= 4 then
    Result := SqPart(Line, 4);
end;

{ [BanJournal] Names: the name of a new ban - the one this script's ban handed over, a player in the game with
  that address or computer id, or one who left within NameSeconds (the server's own bans kick at once) }
function UbNameOf(Hd: string): string;
var
  i, k, N0: Integer;
  V, Kind: string;
begin
  Result := '';
  if not UbNames then
    Exit;
  if UbHints <> nil then
    for i := UbHints.Count - 1 downto 0 do
      if Result = '' then
        if Copy(UbHints[i], 1, Length(Hd) + 1) = Hd + #1 then
          Result := Copy(UbHints[i], Length(Hd) + 2, 100);
  if Result <> '' then
    Exit;
  Kind := Copy(Hd, 1, 2);
  V := Copy(Hd, 3, Length(Hd));
  for i := 1 to TopSlot do
    if Result = '' then
      if ActiveSlot[i] then
        if HumanOf[i] then
        begin
          if Kind = 'i ' then
          begin
            if PL[i].IP = V then
              Result := PL[i].Name;
          end
          else if PL[i].HWID = V then
            Result := PL[i].Name;
        end;
  if Result <> '' then
    Exit;
  N0 := SqNow();
  for k := 0 to 31 do
    if Result = '' then
      if UbLeftName[k] <> '' then
        if N0 - UbLeftAt[k] <= UbNameSecs then
        begin
          if Kind = 'i ' then
          begin
            if UbLeftIP[k] = V then
              Result := UbLeftName[k];
          end
          else if UbLeftHW[k] = V then
            Result := UbLeftName[k];
        end;
end;

{ every few seconds: bans that are new in the server's lists go into the journal with the time - every ban,
  whoever made it (an admin, this script, the server's flood guard, another script) }
{ the bans of a pass (Cur) against the last one: the new ones go into the journal; Cur is the last one from now on }
procedure UbCompare(Cur: TStringList);
var
  i: Integer;
  Hd, Line, Mins: string;
begin
  if UbBaseDone then
    for i := 0 to Cur.Count - 1 do
    begin
      Hd := UbHead(Cur[i]);
      if UbHeads.IndexOf(Hd) < 0 then
      begin
        Mins := IntToStr(StrToIntDef(UbTail(Cur[i], 2), 0) div 3600);
        if StrToIntDef(UbTail(Cur[i], 2), 0) < 0 then
          Mins := 'perm';
        Line := IntToStr(SqNow()) + '|' + Hd + '|' + AdClean(UbTail(Cur[i], 1)) + '|' + Mins + '|' +
          AdClean(UbNameOf(Hd));
        UbJournal.Add(Line);
        while UbJournal.Count > 1000 do
          UbJournal.Delete(0);
        if BeOk then
          if UbFileName <> '' then
            BE_Log(PChar(DataDir + UbFileName), PChar(Line));
        UbStatSeen := UbStatSeen + 1;
      end;
    end;
  { the sorted set built at once (sorted once at the end, not with every line) }
  UbHeads.Sorted := False;
  UbHeads.Clear;
  for i := 0 to Cur.Count - 1 do
    UbHeads.Add(UbHead(Cur[i]));
  UbHeads.Sorted := True;
  UbBaseDone := True;
end;

{ F10: up to Room entries of the ban lists into UbNow; True when the pass has read both lists }
function UbPassStep(Room: Integer): Boolean;
var
  n: Integer;
  R: TBannedIP;
  H: TBannedHW;
begin
  Result := False;
  n := Game.BanLists.BannedIPCount;
  while (Room > 0) and (UbPassI <= n) do
  begin
    R := Game.BanLists.IP[UbPassI];
    if R.IP <> '' then
      UbNow.Add('i ' + R.IP + #1 + R.Reason + #1 + IntToStr(R.Time));
    UbPassI := UbPassI + 1;
    Room := Room - 1;
  end;
  if UbPassI <= n then
    Exit;
  n := Game.BanLists.BannedHWCount;
  while (Room > 0) and (UbPassH <= n) do
  begin
    H := Game.BanLists.HW[UbPassH];
    if H.HW <> '' then
      UbNow.Add('h ' + H.HW + #1 + H.Reason + #1 + IntToStr(H.Time));
    UbPassH := UbPassH + 1;
    Room := Room - 1;
  end;
  Result := UbPassH > n;
end;

{ every few seconds: bans that are new in the server's lists go into the journal with the time - every ban,
  whoever made it (an admin, this script, the server's flood guard, another script). Tick 0 (a command): the
  whole lists at once; else a pass of 50 entries a tick (F10: no 10 ms tick with 500 bans) }
procedure UbTickRun(Tick: Integer);
var
  n: Integer;
  Cur: TStringList;
begin
  if Tick > 0 then
    if UbPassOn then
    begin
      if UbPassStep(50) then
      begin
        UbPassOn := False;
        UbCompare(UbNow);
        UbNow.Clear;
      end;
      Exit;
    end;
  if Tick mod UbEveryTicks <> 0 then
    Exit;
  UbLoad();
  n := Game.BanLists.BannedIPCount + Game.BanLists.BannedHWCount;
  if UbBaseDone then
    if n = UbLastCount then
      if Tick - UbFullTick < 3600 then
        Exit;
  UbLastCount := n;
  UbFullTick := Tick;
  if Tick > 0 then
  begin
    UbNow.Clear;
    UbPassI := 1;
    UbPassH := 1;
    UbPassOn := True;
    Exit;
  end;
  UbPassOn := False;
  UbNow.Clear;
  Cur := File.CreateStringList();
  UbSnapshot(Cur);
  UbCompare(Cur);
  Cur.Free;
end;

function UbStillBanned(Hd: string): Boolean;
var
  V: string;
begin
  Result := False;
  V := Copy(Hd, 3, Length(Hd));
  if Copy(Hd, 1, 2) = 'i ' then
    Result := Game.BanLists.GetIPBanId(V) > 0
  else if Copy(Hd, 1, 2) = 'h ' then
    Result := Game.BanLists.GetHWBanId(V) > 0;
end;

function UbLift(Hd: string): Boolean;
var
  V: string;
begin
  Result := False;
  V := Copy(Hd, 3, Length(Hd));
  if Copy(Hd, 1, 2) = 'i ' then
    Result := Game.BanLists.DelIPBan(V)
  else if Copy(Hd, 1, 2) = 'h ' then
    Result := Game.BanLists.DelHWBan(V);
end;

function UbAgo(Secs: Integer): string;
begin
  if Secs < 120 then
    Result := IntToStr(Secs) + ' s'
  else if Secs < 7200 then
    Result := IntToStr(Secs div 60) + ' min'
  else if Secs < 172800 then
    Result := IntToStr(Secs div 3600) + ' h'
  else
    Result := IntToStr(Secs div 86400) + ' days';
end;

{ /unbanlast <n | time>: the last n bans of the journal still in force, or every one made within that time
  (30m, 2h, 1d, 1w); /unbanlast alone is the server's own (the last ban) }
procedure CmdUnbanLast(ID: Integer; Args: string);
var
  W, Hd, Line: string;
  i, n, Window, Done, N0, T0: Integer;
  ByCount: Boolean;
begin
  if not UbEnabled then
    Exit;
  W := LowerCase(Trim(Args));
  if W = '' then
    Exit;
  UbLoad();
  UbTickRun(0);
  N0 := SqNow();
  ByCount := Pos(Copy(W, Length(W), 1), '0123456789') > 0;
  n := 0;
  Window := 0;
  if ByCount then
  begin
    n := StrToIntDef(W, 0);
    if (n < 1) or (n > 200) then
    begin
      Say(ID, 'Use: /unbanlast <how many: 1-200> or <time: 30m, 2h, 1d, 1w> (alone: the last ban).', ColorBad);
      Exit;
    end;
  end
  else
  begin
    Window := SqTimeOf(W);
    if Window <= 0 then
    begin
      Say(ID, 'Use: /unbanlast <how many: 1-200> or <time: 30m, 2h, 1d, 1w> (alone: the last ban).', ColorBad);
      Exit;
    end;
  end;
  Done := 0;
  for i := UbJournal.Count - 1 downto 0 do
  begin
    Line := UbJournal[i];
    T0 := StrToIntDef(SqPart(Line, 0), 0);
    if not ByCount then
      if N0 - T0 > Window then
        Break;
    Hd := SqPart(Line, 1);
    if UbStillBanned(Hd) then
      if UbLift(Hd) then
      begin
        Done := Done + 1;
        if Done <= 12 then
          Say(ID, 'Unbanned ' + Hd + ' (' + SqPart(Line, 2) + ', ' + UbAgo(N0 - T0) + ' ago)', ColorGood);
        if ByCount then
          if Done >= n then
            Break;
      end;
  end;
  if Done > 12 then
    Say(ID, '... and ' + IntToStr(Done - 12) + ' more.', ColorGood);
  if Done = 0 then
    Say(ID, 'No ban of the journal in force there (the journal knows the bans made since this script runs on the server).',
      ColorBad)
  else
  begin
    UbStatLifted := UbStatLifted + Done;
    Log('[Bans] /unbanlast ' + W + ': ' + IntToStr(Done) + ' bans lifted');
  end;
  UbTickRun(0);
end;

{ ', 21 h left' / ', for good' of a ban in force ('' = not in force); the server counts its time while it runs }
function UbLeftText(Hd: string): string;
var
  V: string;
  k, T: Integer;
  R: TBannedIP;
  H: TBannedHW;
begin
  Result := '';
  V := Copy(Hd, 3, Length(Hd));
  T := 0;
  k := 0;
  { a record of the lists is read whole first (a field of the property is not reached) }
  if Copy(Hd, 1, 2) = 'i ' then
  begin
    k := Game.BanLists.GetIPBanId(V);
    if k > 0 then
    begin
      R := Game.BanLists.IP[k];
      T := R.Time;
    end;
  end
  else if Copy(Hd, 1, 2) = 'h ' then
  begin
    k := Game.BanLists.GetHWBanId(V);
    if k > 0 then
    begin
      H := Game.BanLists.HW[k];
      T := H.Time;
    end;
  end;
  if k <= 0 then
    Exit;
  if T < 0 then
    Result := ', for good'
  else
    Result := ', ' + UbAgo(T div 60) + ' left';
end;

{ /unbanname <part of a name>: every ban of the journal in force with that name (several names: the list) }
procedure CmdUnbanName(ID: Integer; Args: string);
var
  W, Line, Nm, Hd, Names, Disp: string;
  i, Done, Kinds: Integer;
begin
  if not UbEnabled then
    Exit;
  W := LowerCase(Trim(Args));
  if W = '' then
  begin
    Say(ID, 'Use: /unbanname <a part of the name> (/banlist shows the names)', ColorBad);
    Exit;
  end;
  UbLoad();
  UbTickRun(0);
  { the names that match, among the bans in force }
  Names := '|';
  Disp := '';
  Kinds := 0;
  for i := UbJournal.Count - 1 downto 0 do
  begin
    Line := UbJournal[i];
    Nm := UbNameField(Line);
    if Nm <> '' then
      if Nm <> '-' then
        if Pos(W, LowerCase(Nm)) > 0 then
          if UbStillBanned(SqPart(Line, 1)) then
            if Pos('|' + Nm + '|', Names) = 0 then
            begin
              Names := Names + Nm + '|';
              if Disp <> '' then
                Disp := Disp + ', ';
              Disp := Disp + Nm;
              Kinds := Kinds + 1;
            end;
  end;
  if Kinds = 0 then
  begin
    Say(ID, 'No ban in force with "' + Trim(Args) + '" in the name (/banlist).', ColorBad);
    Exit;
  end;
  if Kinds > 1 then
  begin
    Say(ID, 'Bans of several players match: ' + Disp + ' - type more of the name.', ColorBad);
    Exit;
  end;
  Nm := Copy(Names, 2, Length(Names) - 2);
  Done := 0;
  for i := UbJournal.Count - 1 downto 0 do
  begin
    Line := UbJournal[i];
    if UbNameField(Line) = Nm then
    begin
      Hd := SqPart(Line, 1);
      if UbStillBanned(Hd) then
        if UbLift(Hd) then
          Done := Done + 1;
    end;
  end;
  UbStatLifted := UbStatLifted + Done;
  Say(ID, 'Unbanned ' + Nm + ': ' + IntToStr(Done) + ' ban' + iif(Done = 1, '', 's') + ' lifted.', ColorGood);
  Log('[Bans] /unbanname ' + Nm + ' by ' + AdminName(ID) + ': ' + IntToStr(Done) + ' lifted');
  UbTickRun(0);
end;

{ /banlist [n]: the last bans of the journal (in force or not) }
procedure CmdBanJournal(ID: Integer; Args: string);
var
  i, n, Shown, N0: Integer;
  Line, Hd, Nm: string;
  C: Longint;
begin
  if not UbEnabled then
    Exit;
  UbLoad();
  UbTickRun(0);
  n := StrToIntDef(Trim(Args), 10);
  if n < 1 then
    n := 10;
  if n > 30 then
    n := 30;
  N0 := SqNow();
  Shown := 0;
  for i := UbJournal.Count - 1 downto 0 do
    if Shown < n then
    begin
      Line := UbJournal[i];
      Hd := SqPart(Line, 1);
      C := ColorGood;
      if UbStillBanned(Hd) then
        C := ColorBad;
      Nm := UbNameField(Line);
      if Nm = '' then
        Nm := '-';
      Say(ID, UbAgo(N0 - StrToIntDef(SqPart(Line, 0), 0)) + ' ago: ' + Nm + ' - ' + Hd + ' - ' + SqPart(Line, 2) + ' (' +
        SqPart(Line, 3) + iif(SqPart(Line, 3) = 'perm', '', ' min') + UbLeftText(Hd) + ')' +
        iif(UbStillBanned(Hd), '', ' - lifted'), C);
      Shown := Shown + 1;
    end;
  if Shown = 0 then
    Say(ID, 'The ban journal is empty (it fills while this script runs).', ColorGood);
end;

{ ---------------- the maps: /maplistadd, /maplistremove, /mapfind, /map by a part of the name ---------------- }

function MmFolderList(): string;
begin
  Result := '';
  if not BeOk then
    Exit;
  Result := BE_NamesFolder(PChar(MgFolder), '.pms');
end;

function MmRotation(): string;
var
  i, n: Integer;
begin
  Result := '';
  n := Game.MapsList.MapsCount;
  for i := 0 to n - 1 do
  begin
    if i > 0 then
      Result := Result + '|';
    Result := Result + Game.MapsList.Map[i];
  end;
end;

{ the one name of List a part means; '' = none or several (told to ID, with the first ones) }
function MmPick(ID: Integer; List, Part, What: string): string;
var
  n, k, Best: Integer;
  S: string;
begin
  Result := '';
  if not BeOk then
  begin
    Say(ID, 'Finding maps by a part of the name needs the script''s library.', ColorBad);
    Exit;
  end;
  n := BE_NamesRank(PChar(List), PChar(Part));
  if n = 0 then
  begin
    Say(ID, 'No ' + What + ' matches "' + Part + '".', ColorBad);
    Exit;
  end;
  Best := BE_NamesRankOf(0);
  { one exact name, or one best match }
  if (n = 1) or (Best = 0) or (BE_NamesRankOf(1) > Best) then
  begin
    Result := BE_NamesGet(0);
    Exit;
  end;
  S := '';
  for k := 0 to n - 1 do
    if k < 12 then
      if BE_NamesRankOf(k) = Best then
      begin
        if S <> '' then
          S := S + ', ';
        S := S + BE_NamesGet(k);
      end;
  Say(ID, 'Several ' + What + 's match "' + Part + '": ' + S + ' - type more of the name.', ColorBad);
end;

procedure CmdMapFind(ID: Integer; Args: string);
var
  n, k: Integer;
  S: string;
begin
  if not MmEnabled then
    Exit;
  if Trim(Args) = '' then
  begin
    Say(ID, 'Use: /mapfind <part of a map name>', ColorBad);
    Exit;
  end;
  if not BeOk then
    Exit;
  n := BE_NamesRank(PChar(MmFolderList()), PChar(Trim(Args)));
  if n = 0 then
  begin
    Say(ID, 'No map in ' + MgFolder + ' matches "' + Trim(Args) + '".', ColorBad);
    Exit;
  end;
  S := '';
  for k := 0 to n - 1 do
    if k < 20 then
    begin
      if S <> '' then
        S := S + ', ';
      S := S + BE_NamesGet(k);
      if Game.MapsList.GetMapIdByName(BE_NamesGet(k)) >= 0 then
        S := S + '*';
    end;
  Say(ID, IntToStr(n) + ' map' + iif(n = 1, '', 's') + ': ' + S + iif(n > 20, ' ...', '') + ' (* = in the list)', MmColor);
end;

{ /maplistadd <part> [position]: a map of the folder into the server's list (and mapslist.txt) }
procedure CmdMapListAdd(ID: Integer; Args: string);
var
  Rest, W, Name: string;
  Posn, i: Integer;
  L: TStringList;
begin
  if not MmEnabled then
    Exit;
  Rest := Args;
  W := TakeArg(Rest);
  if W = '' then
  begin
    Say(ID, 'Use: /maplistadd <part of a map name> [position in the list]', ColorBad);
    Exit;
  end;
  Name := MmPick(ID, MmFolderList(), W, 'map of the folder');
  if Name = '' then
    Exit;
  if Game.MapsList.GetMapIdByName(Name) >= 0 then
    if LowerCase(Trim(Rest)) <> 'again' then
    begin
      Say(ID, Name + ' is in the list already (/maplistadd ' + W + ' again: a second time).', ColorBad);
      Exit;
    end
    else
      Rest := '';
  Posn := StrToIntDef(Trim(Rest), 0);
  if (Posn < 1) or (Posn > Game.MapsList.MapsCount) then
  begin
    Game.MapsList.AddMap(Name);
    Say(ID, Name + ' added to the maps list (now ' + IntToStr(Game.MapsList.MapsCount) + ' maps).', ColorGood);
    Log('[Maps] ' + Name + ' added to the list');
    Exit;
  end;
  { at a place: the file, then the list read again }
  if not File.Exists(MapsFile) then
  begin
    Game.MapsList.AddMap(Name);
    Say(ID, Name + ' added at the end (' + MapsFile + ' not found).', ColorGood);
    Exit;
  end;
  L := File.CreateStringListFromFile(MapsFile);
  for i := L.Count - 1 downto 0 do
    if Trim(L[i]) = '' then
      L.Delete(i);
  if Posn > L.Count + 1 then
    Posn := L.Count + 1;
  L.Insert(Posn - 1, Name);
  try
    L.SaveToFile(MapsFile);
    Game.LoadList(MapsFile);
    Say(ID, Name + ' added as map ' + IntToStr(Posn) + ' of ' + IntToStr(L.Count) + '.', ColorGood);
    Log('[Maps] ' + Name + ' added to the list at ' + IntToStr(Posn));
  except
    Say(ID, 'Cannot write ' + MapsFile + '.', ColorBad);
  end;
  L.Free;
end;

{ /maplistremove <part | number>: out of the server's list (and mapslist.txt) }
procedure CmdMapListRemove(ID: Integer; Args: string);
var
  W, Name: string;
  n: Integer;
begin
  if not MmEnabled then
    Exit;
  W := Trim(Args);
  if W = '' then
  begin
    Say(ID, 'Use: /maplistremove <part of a map name | its number in !maplist>', ColorBad);
    Exit;
  end;
  Name := '';
  n := StrToIntDef(W, 0);
  if (n >= 1) and (n <= Game.MapsList.MapsCount) then
    Name := Game.MapsList.Map[n - 1]
  else
    Name := MmPick(ID, MmRotation(), W, 'map of the list');
  if Name = '' then
    Exit;
  if Game.MapsList.MapsCount <= 1 then
  begin
    Say(ID, 'The list keeps at least one map.', ColorBad);
    Exit;
  end;
  Game.MapsList.RemoveMap(Name);
  Say(ID, Name + ' taken out of the maps list (now ' + IntToStr(Game.MapsList.MapsCount) + ' maps).', ColorGood);
  Log('[Maps] ' + Name + ' taken out of the list');
end;

{ /map <part>: the server's /map wants the whole name - a part is found here (the event already kept the server
  from running it) }
procedure CmdMapPart(ID: Integer; Args: string);
var
  Name: string;
begin
