{ ============ round 21: [Resupply] - ammunition at the own base ============ }

procedure RyRefresh();
var
  Was: Boolean;
begin
  Was := RyActive;
  RyActive := False;
  RyIdleWhy := 'switched off';
  if RyEnabled then
  begin
    if ((RyModes shr GameStyleNow()) and 1) = 0 then
      RyIdleWhy := 'this game mode is not in [Resupply] Modes'
    else if Game.Survival and (not RySurvival) then
      RyIdleWhy := 'survival ([Resupply] Survival = 0)'
    else
    begin
      RyActive := True;
      RyIdleWhy := '';
    end;
    if RyActive <> Was then
    begin
      if RyActive then
        Log('[Resupply] on')
      else
        Log('[Resupply] idle: ' + RyIdleWhy);
    end;
  end;
end;

