{ /setclass <player> <class> }
procedure CmdSetClass(ID: Integer; Args: string);
var
  T, c: Integer;
  Who, W: string;
begin
  if not ClsActive then
  begin
    Say(ID, 'Classes are off here (' + ClsIdleWhy + ').', ColorBad);
    Exit;
  end;
  W := Args;
  Who := TakeArg(W);
  T := FindPlayerOnly(Who);
  c := ClsOfWord(W);
  if (T < 1) or (c = 0) then
  begin
    Say(ID, 'Use: /setclass <player> <class name or number>', ColorBad);
    Exit;
  end;
  { a class of the other side ([Insurgents]): for this life only (his next one rolls one of his side) }
  if not ClsFor(T, c) then
    if not PL[T].Alive then
