function ObjectsFree(Want: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := MAX_OBJECT_ID downto 1 do
    if not OB[i].Active then
    begin
      Result := Result + 1;
      if Result >= Want then
        Exit;
    end;
end;

function SpawnObject(Style: Integer; X, Y: Single): Boolean;
var
  O: TNewMapObject;
  A: TActiveMapObject;
begin
  Result := False;
  if (Style < 1) or (Style > 27) then
    Exit;
  if ObjectsFree(OBJECT_MARGIN) < OBJECT_MARGIN then
    Exit;
  O := TNewMapObject.Create;
  try
    O.Style := Style;
    O.X := X;
    O.Y := Y;
    A := Map.AddObject(O);
    if A <> nil then
    begin
      Result := True;
      if (A.ID >= 1) and (A.ID <= MAX_OBJECT_ID) then
        ObjKeep[A.ID] := After(Game.TickCount, OBJ_KEEP_TICKS);
    end;
  finally
    O.Free;
  end;
end;

function NearX(k: Integer): Single;
begin
  Result := ((k mod 5) - 2) * 14;
end;

{ ================================ flash grenades ([FlashNades]) ================================ }

{ Flash grenades, from the owner's FlashNades script. The grenade in a soldier's hand is the game's own
  one; whether it is a flash is decided when it is thrown - the hook in the server's CreateBullet
  reports it at once with its bullet slot (without the hook the bullet table is looked through) - by the
  type the player chose (/flash, /nade, crouch + change weapon). Every life brings Nades grenades and
  Flashes flash grenades. While this runs the game's Max_Grenades is 1: a soldier carries one grenade,
  and when it is thrown the script gives him the next one (GiveBonus), as long as he has any left.

  A flash explodes like any grenade (the players' games draw it), but OnDamage turns its damage into at
  most MaxDamage near it, the players around it are held where they stood (NoPush: the game pushes them
  a tick after the explosion, so they are moved back and stopped for a few ticks and then get their
  speed back), and everybody who sees it within Radius - no wall between it and his eyes, as the
  realistic mode's vision - gets a white screen for up to MaxTicks: a giant letter as a BigText or a
  WorldText, which the game fades out by itself over its last ticks. A bot cannot see texts: with
  BlindBots it stops for that time instead (its AI is paused). }

{ a player's grenades for a new life }
procedure FnFill(ID: Integer);
begin
  FnNadeLeft[ID] := FnNades;
  FnFlashLeft[ID] := FnFlashes;
  FnType[ID] := FnDefType;
  if FnType[ID] = FN_FLASH then
    if FnFlashLeft[ID] <= 0 then
      FnType[ID] := FN_NADE;
  if FnType[ID] = FN_NADE then
    if FnNadeLeft[ID] <= 0 then
      if FnFlashLeft[ID] > 0 then
        FnType[ID] := FN_FLASH;
  FnRefillAt[ID] := 0;
  FnNeed[ID] := True;
  HudMark(ID, False);
end;

{ AutoSwitch: the type chosen has run out - the other one, if there is any of it }
procedure FnAutoType(ID: Integer);
begin
  if not FnAuto then
    Exit;
  if FnType[ID] = FN_FLASH then
  begin
    if FnFlashLeft[ID] <= 0 then
      if FnNadeLeft[ID] > 0 then
        FnType[ID] := FN_NADE;
  end
  else if FnNadeLeft[ID] <= 0 then
    if FnFlashLeft[ID] > 0 then
      FnType[ID] := FN_FLASH;
end;

{ a grenade kit: KitNades and KitFlashes more, up to what a life brings }
procedure FnKitGive(ID: Integer);
var
  n: Integer;
begin
  n := FnNadeLeft[ID] + FnKitNades;
  if n > FnNades then
    n := FnNades;
  if n > FnNadeLeft[ID] then
    FnNadeLeft[ID] := n;
  if not (ShActive and ((ShShopOnly and 8) <> 0)) then
  begin
    n := FnFlashLeft[ID] + FnKitFlashes;
    if n > FnFlashes then
      n := FnFlashes;
    if n > FnFlashLeft[ID] then
      FnFlashLeft[ID] := n;
  end;
  FnAutoType(ID);
  FnRefillAt[ID] := 0;
  FnNeed[ID] := True;
  HudMark(ID, False);
end;

{ /bonus nades of an admin: everything a life brings, the type stays }
procedure FnGiveAll(ID: Integer);
begin
  FnNadeLeft[ID] := FnNades;
  FnFlashLeft[ID] := FnFlashes;
  FnAutoType(ID);
  FnRefillAt[ID] := 0;
  FnNeed[ID] := True;
  HudMark(ID, False);
end;

{ he misses something a grenade kit gives }
function FnKitWanted(ID: Integer): Boolean;
begin
  Result := False;
  if FnKitNades > 0 then
    if FnNadeLeft[ID] < FnNades then
      Result := True;
  if FnKitFlashes > 0 then
    if FnFlashLeft[ID] < FnFlashes then
      Result := True;
end;

{ the type of the next grenade: FN_NADE, FN_FLASH or -1 = the other one; by the key nothing is said }
procedure FnSwitch(ID, Mode: Integer; ByKey: Boolean);
begin
  if Mode < 0 then
    Mode := 1 - FnType[ID];
  if Mode = FN_FLASH then
  begin
    if FnFlashLeft[ID] <= 0 then
    begin
      if not ByKey then
        Say(ID, 'You have no flash grenades left.', ColorBad);
      Exit;
    end;
  end
  else if FnNadeLeft[ID] <= 0 then
  begin
    if not ByKey then
      Say(ID, 'You have no grenades left.', ColorBad);
    Exit;
  end;
  FnType[ID] := Mode;
  HudMark(ID, False);
  if not FnHud then
    Say(ID, 'Next grenade: ' + FnTypeName(Mode) + ' (grenades ' + IntToStr(FnNadeLeft[ID]) + ', flashes ' +
      IntToStr(FnFlashLeft[ID]) + ').', FnTextColor);
end;

{ the grenade at place k of the list is not followed any more (the last one takes its place); its word
  goes away for those who had it }
procedure FnForget(k: Integer);
var
  n, v: Integer;
begin
  if FnLabelTo[k] <> 0 then
    if not FnQuiet then
      for v := 1 to TopSlot do
        if (FnLabelTo[k] and SlotBit[v]) <> 0 then
          if PL[v].Active then
            PL[v].WorldText(FnLayer[k], ' ', 1, ColorGood, 0.01, 0, 0);
  if (FnSlot[k] >= 0) and (FnSlot[k] <= 255) then
    FnSlotOf[FnSlot[k]] := 0;
  n := FnCount - 1;
  if k < n then
  begin
    FnSlot[k] := FnSlot[n];
    FnOwner[k] := FnOwner[n];
    FnKind[k] := FnKind[n];
    FnLayer[k] := FnLayer[n];
    FnLabelTo[k] := FnLabelTo[n];
    FnTimeOut[k] := FnTimeOut[n];
    FnSentTick[k] := FnSentTick[n];
    FnX[k] := FnX[n];
    FnY[k] := FnY[n];
    FnPX[k] := FnPX[n];
    FnPY[k] := FnPY[n];
    FnSentX[k] := FnSentX[n];
    FnSentY[k] := FnSentY[n];
    FnVX[k] := FnVX[n];
    FnVY[k] := FnVY[n];
    FnLeadX[k] := FnLeadX[n];
    FnLeadY[k] := FnLeadY[n];
    FnSlotOf[FnSlot[k]] := k + 1;
  end;
  if n < 0 then
    n := 0;
  FnCount := n;
end;

{ nothing is followed any more (a map change, the feature switched off) }
procedure FnClear();
var
  k: Integer;
begin
  while FnCount > 0 do
    FnForget(FnCount - 1);
  for k := 0 to 255 do
  begin
    FnSlotOf[k] := 0;
    FnBoomTick[k] := -1000000;
  end;
  FnKitCount := 0;
  FnKitDue := 0;
  FnScanTop := MAX_BULLET_ID;
end;

{ a grenade was thrown: a flash when its thrower chose that type and has one left (with only flashes
  left, the grenade in his hand was one of them) }
procedure FnThrown(O, B: Integer; X, Y: Single; Tick: Integer);
var
  k, Kind: Integer;
begin
  if (O < 1) or (O > 32) then
    Exit;
  if (B < 1) or (B > MAX_BULLET_ID) then
    Exit;
  if not ActiveSlot[O] then
    Exit;
  { a slot used again before its old grenade was seen gone }
  if FnSlotOf[B] > 0 then
    FnForget(FnSlotOf[B] - 1);
  FnStatThrown := FnStatThrown + 1;
  { a bot chooses no type: BotFlashChance of its grenades are flashes while it has some }
  if not HumanOf[O] then
    if FnFlashLeft[O] > 0 then
    begin
      if Random(0, 1000) < Round(FnBotFlash * 1000) then
        FnType[O] := FN_FLASH
      else if FnNadeLeft[O] > 0 then
        FnType[O] := FN_NADE;
    end;
  Kind := FN_NADE;
  if FnType[O] = FN_FLASH then
  begin
    if FnFlashLeft[O] > 0 then
    begin
      Kind := FN_FLASH;
      FnFlashLeft[O] := FnFlashLeft[O] - 1;
    end
    else if FnNadeLeft[O] > 0 then
      FnNadeLeft[O] := FnNadeLeft[O] - 1;
  end
  else if FnNadeLeft[O] > 0 then
    FnNadeLeft[O] := FnNadeLeft[O] - 1
  else if FnFlashLeft[O] > 0 then
  begin
    Kind := FN_FLASH;
    FnFlashLeft[O] := FnFlashLeft[O] - 1;
  end;
  if Kind = FN_FLASH then
    FnStatFlashes := FnStatFlashes + 1;
  FnAutoType(O);
  { the next grenade a moment later (the throw's own sound first) }
  FnRefillAt[O] := Tick + 10;
  FnNeed[O] := True;
  HudMark(O, False);
  if FnCount >= FN_MAX then
    FnForget(0);
  k := FnCount;
  FnCount := FnCount + 1;
  FnSlot[k] := B;
  FnOwner[k] := O;
  FnKind[k] := Kind;
  FnLayer[k] := FnLabelFirst + (FnNextLayer mod FnLabelCount);
  FnNextLayer := FnNextLayer + 1;
  if FnNextLayer > 1000000 then
    FnNextLayer := 0;
  FnLabelTo[k] := 0;
  FnTimeOut[k] := 1000000;
  FnSentTick[k] := -1000000;
  FnX[k] := X;
  FnY[k] := Y;
  FnPX[k] := X;
  FnPY[k] := Y;
  FnSentX[k] := X;
  FnSentY[k] := Y;
  FnVX[k] := 0;
  FnVY[k] := 0;
  FnLeadX[k] := 0;
  FnLeadY[k] := 0;
  FnSlotOf[B] := k + 1;
  FnBoomTick[B] := -1000000;
end;

{ without the hook in the server the new grenades are looked for in the bullet table (up to the
  highest slot in use and a margin); a dead player's grenade (Posthumous) is not a throw }
procedure FnScan(Tick: Integer);
var
  b, Top, O: Integer;
  Bul: TActiveMapBullet;
begin
  Top := 0;
  if FnScanTop > MAX_BULLET_ID then
    FnScanTop := MAX_BULLET_ID;
  for b := 1 to FnScanTop do
  begin
    Bul := BL[b];
    if Bul.Active then
    begin
      Top := b;
      if FnSlotOf[b] = 0 then
        if Bul.Style = BS_FRAGNADE then
        begin
          O := Bul.Owner;
          if (O >= 1) and (O <= 32) then
            if PL[O].Alive then
              FnThrown(O, b, Bul.X, Bul.Y, Tick);
        end;
    end;
  end;
  FnScanTop := Top + 32;
end;

{ the words over the grenades in the air ([FlashNades] Labels): seen by the thrower, his team or
  everybody (an enemy only when he could see the grenade, in the realistic mode with LabelLineOfSight);
  sent every LabelTicks while the grenade moves, with a long display time (a text fades by its time
  left) and taken away with ' ' when the grenade is gone }
procedure FnLabel(k, Tick: Integer);
var
  v, O: Integer;
  T: string;
  C: Longint;
  W, LX, LY, Sc, AX, AY, PX, PY, G, NX, NY: Single;
  Show, Real, Teams: Boolean;
  Q: TActivePlayer;
  L: Integer;
begin
  if Tick - FnSentTick[k] < FnLabelTicks then
    Exit;
  if FnKind[k] = FN_FLASH then
  begin
    T := FnFlashLabel;
    C := FnFlashColor;
  end
  else
  begin
    T := FnNadeLabel;
    C := FnNadeColor;
  end;
  if T = '' then
    Exit;
  O := FnOwner[k];
  { the thrower's own game made his grenade itself, about his ping before the server did: his mark goes
    that far ahead (AX, AY) while the grenade flies - not into a wall, and not while it lies or rolls
    slowly (the fall of a flight would put the mark into the ground); the others' games got it from the
    server as late as they get the mark }
  AX := 0;
  AY := 0;
  if FnVX[k] * FnVX[k] + FnVY[k] * FnVY[k] >= 1 then
  begin
    L := 1;
    if HumanOf[O] then
      L := PL[O].Ping div 17 + 1;
    if L > 10 then
      L := 10;
    G := Game.Gravity * 2.25;
    PX := FnX[k] + FnVX[k] * L;
    PY := FnY[k] + FnVY[k] * L + 0.5 * G * L * L;
    if not Ray(FnX[k], FnY[k], PX, PY, True) then
    begin
      AX := PX - FnX[k];
      AY := PY - FnY[k];
    end;
  end;
  { a grenade that moved less than a pixel keeps its mark (sent again every second, or when the
    thrower's lead changed - it stopped); a slowly rolling one gets it every pixel, so the small ring
    does not lag behind it }
  if Tick - FnSentTick[k] < 60 then
    if Abs(FnX[k] - FnSentX[k]) + Abs(FnY[k] - FnSentY[k]) < 1 then
      if Abs(AX - FnLeadX[k]) + Abs(AY - FnLeadY[k]) < 1 then
        Exit;
  FnSentTick[k] := Tick;
  FnSentX[k] := FnX[k];
  FnSentY[k] := FnY[k];
  FnLeadX[k] := AX;
  FnLeadY[k] := AY;
  { one character is a mark with its ink centred on the grenade's picture (O: a ring around it), a word
    stands over it }
  if Length(T) = 1 then
  begin
    Sc := FnMarkScale;
    if FnKind[k] = FN_FLASH then
    begin
      LX := FnX[k] - FnFlashDX;
      LY := FnY[k] - FnFlashDY;
    end
    else
    begin
      LX := FnX[k] - FnNadeDX;
      LY := FnY[k] - FnNadeDY;
    end;
  end
  else
  begin
    Sc := FnLabelScale;
    if BeOk then
      W := BE_TextWidth(T, Sc)
    else
      W := Length(T) * Sc * WT_CHAR_WIDTH;
    LX := FnX[k] - W / 2;
    LY := FnY[k] - FnLabelY;
  end;
  Real := FnLabelSight and Realistic;
  Teams := TeamGame();
  for v := 1 to TopSlot do
    if ActiveSlot[v] then
      if HumanOf[v] or DebugBots then
      begin
        Show := v = O;
        if not Show then
          if FnSeenBy <> LS_OWNER then
          begin
            if Teams then
              if TeamOf[v] = TeamOf[O] then
                Show := True;
            if not Show then
              if FnSeenBy = LS_ALL then
              begin
                Show := True;
                if Real then
                begin
                  Q := PL[v];
                  if Q.Alive then
                    if (Abs(Q.X - FnX[k]) > LOS_RANGE) or (Abs(Q.Y - FnY[k]) > LOS_RANGE) then
                      Show := False
                    else
                    begin
                      { the game hides a grenade whose ray to the viewer's neck meets a wall }
                      SkPoint(v, 9, LOS_HEIGHT, NX, NY);
                      if Ray(NX, NY, FnX[k], FnY[k] - 2, False) then
                        Show := False;
                    end;
                end;
              end;
          end;
        if Show then
          if TextRoom(v, Tick) then
          begin
            if v = O then
              PL[v].WorldText(FnLayer[k], T, 150, C, Sc, LX + AX, LY + AY)
            else
              PL[v].WorldText(FnLayer[k], T, 150, C, Sc, LX, LY);
            TextSent(v);
            FnLabelTo[k] := FnLabelTo[k] or SlotBit[v];
          end;
      end;
end;

{ BlindBots: the keys of a bot whose AI is paused are let go (they would stay pressed) }
procedure FnBotKeysOff(P: TActivePlayer);
begin
  P.KeyLeft := False;
  P.KeyRight := False;
  P.KeyUp := False;
  P.KeyJetpack := False;
  P.KeyShoot := False;
  P.KeyGrenade := False;
  P.KeyChangeWeap := False;
  P.KeyThrow := False;
  P.KeyReload := False;
  P.KeyCrouch := False;
  P.KeyProne := False;
  P.KeyFlagThrow := False;
end;

{ BlindBots: a bot that cannot see stops until Due (its AI is paused); a bot somebody else made a dummy
  is left alone }
procedure FnBotFreeze(i: Integer; P: TActivePlayer; Due: Integer);
begin
  if not FnBotDummy[i] then
  begin
    if P.Dummy then
      if not LfBotDummy[i] then
        Exit;
    P.Dummy := True;
    FnBotDummy[i] := True;
    FnBotCount := FnBotCount + 1;
    FnBotKeysOff(P);
  end;
  if Due > FnBotUntil[i] then
    FnBotUntil[i] := Due;
end;

procedure FnBotRelease(i: Integer);
begin
  if not FnBotDummy[i] then
    Exit;
  FnBotDummy[i] := False;
  FnBotUntil[i] := 0;
  FnBotCount := FnBotCount - 1;
  if FnBotCount < 0 then
    FnBotCount := 0;
  if PL[i].Active then
    if not LfBotDummy[i] then
      PL[i].Dummy := False;
end;

{ BlindBots = 2: a blinded bot staggers about - a few steps one way or the other, now and then a crouch
  or a jump - and does not shoot }
procedure FnBotStagger(P: TActivePlayer);
var
  r: Integer;
begin
  r := Random(0, 6);
  P.KeyLeft := r = 0;
  P.KeyRight := r = 1;
  P.KeyCrouch := r = 2;
  P.KeyUp := r = 3;
end;

procedure FnBotTick(Tick: Integer);
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if FnBotDummy[i] then
    begin
      if not PL[i].Active then
        FnBotRelease(i)
      else if Tick >= FnBotUntil[i] then
        FnBotRelease(i)
      else if not PL[i].Alive then
        FnBotRelease(i)
      else if FnBotMode = 2 then
        if Tick mod 18 = 0 then
          FnBotStagger(PL[i]);
    end;
end;

{ the white screen for T ticks (never shortening a longer one) }
procedure FnBlind(i: Integer; P: TActivePlayer; T, Tick: Integer);
var
  Due: Integer;
begin
  Due := After(Tick, T);
  if Due <= FnBlindUntil[i] then
    Exit;
  FnBlindUntil[i] := Due;
  FnStatBlinded := FnStatBlinded + 1;
  if HumanOf[i] or DebugBots then
  begin
    if FnMethod = 1 then
      P.BigText(FnBigLayer, FnChar, T, FnColor, FnBigScale, Round(FnBigX), Round(FnBigY))
    else
      P.WorldText(FnWorldLayer, FnChar, T, FnColor, FnWorldScale, P.X + FnWorldX, P.Y + FnWorldY);
  end
  else if FnBlindBots then
    FnBotFreeze(i, P, After(Tick, T * 3 div 4));
end;

{ the white screen goes away (a new life) }
procedure FnUnblind(i: Integer);
begin
  if FnBlindUntil[i] > Game.TickCount then
    if PL[i].Active then
      if HumanOf[i] or DebugBots then
      begin
        if FnMethod = 1 then
          PL[i].BigText(FnBigLayer, ' ', 1, ColorGood, 0.01, 0, 0)
        else
          PL[i].WorldText(FnWorldLayer, ' ', 1, ColorGood, 0.01, 0, 0);
      end;
  FnBlindUntil[i] := 0;
end;

{ NoPush: held where he stood when a flash went off (a second flash keeps the first place) }
procedure FnHold(i: Integer; P: TActivePlayer; X, Y: Single);
begin
  if FnHoldLeft[i] <= 0 then
  begin
    FnHoldCount := FnHoldCount + 1;
    FnHoldX[i] := X;
    FnHoldY[i] := Y;
    FnHoldVX[i] := P.VelX;
    FnHoldVY[i] := P.VelY;
  end;
  FnHoldLeft[i] := FnPushTicks + 1;
end;

{ the players near a flash stay where they were for NoPushTicks, then get their speed back }
procedure FnHoldTick;
var
  i: Integer;
  P: TActivePlayer;
begin
  for i := 1 to TopSlot do
    if FnHoldLeft[i] > 0 then
    begin
      FnHoldLeft[i] := FnHoldLeft[i] - 1;
      if FnHoldLeft[i] = 0 then
        FnHoldCount := FnHoldCount - 1;
      P := PL[i];
      if not P.Active then
        Continue;
      if not P.Alive then
        Continue;
      if FnHoldLeft[i] > 0 then
      begin
        MovePlayer(P, FnHoldX[i], FnHoldY[i]);
        P.SetVelocity(0, 0);
      end
      else
        P.SetVelocity(FnHoldVX[i], FnHoldVY[i]);
    end;
  if FnHoldCount < 0 then
    FnHoldCount := 0;
end;

{ Defuse, MaxDamage: the flash's own damage, from the script (the server had no blast) - MaxDamage near
  it, less further out, nothing beyond DamageRadius or through a wall }
procedure FnOwnDamage(O: Integer; P: TActivePlayer; X, Y: Single);
var
  VX, VY, D2, R2, D: Single;
begin
  if FnDamage <= 0 then
    Exit;
  if (O < 1) or (O > 32) then
    Exit;
  if not ActiveSlot[O] then
    Exit;
  VX := P.X;
  VY := P.Y - BODY_HEIGHT;
  D2 := (VX - X) * (VX - X) + (VY - Y) * (VY - Y);
  R2 := FnDamageRadius * FnDamageRadius;
  if D2 >= R2 then
    Exit;
  if Ray(X, Y - 2, VX, VY, False) then
    Exit;
  D := FnDamage * (1 - D2 / R2);
  if D >= 1 then
    P.Damage(O, D);
end;

{ a flash went off at X, Y: whom it blinds, and for how long (the further away, the shorter). Defused =
  the script took the grenade out of the server just before (no blast there): only the players' games
  push them - the humans near it are held - and the flash's own damage comes from here }
procedure FnBoom(k: Integer; X, Y: Single; Tick: Integer; Defused: Boolean);
var
  i, O, T, n: Integer;
  P: TActivePlayer;
  PX, PY, EX, EY, HX, HY, DX, DY, D2, R2, H2, AX, AY, F: Single;
  Ok: Boolean;
begin
  O := FnOwner[k];
  R2 := FnRadius * FnRadius;
  H2 := FnPushRadius * FnPushRadius;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if TeamOf[i] <> TEAM_SPECTATOR then
      begin
        P := PL[i];
        if not P.Alive then
          Continue;
        { H17: the spawn protection keeps the flash's blindness off too }
        if SfUntil[i] > Tick then
          Continue;
        PX := P.X;
        PY := P.Y;
        { his eyes: the middle of his head as the server's skeleton has it (standing, crouching, lying,
          rolling, turned with the aim); without the library LOS_HEIGHT over his feet }
        EX := PX;
        EY := PY - LOS_HEIGHT;
        if BeOk then
          if BE_SpriteEyes(i, P, PX, PY, HX, HY) = 1 then
          begin
            EX := HX;
            EY := HY;
          end;
        DX := EX - X;
        DY := EY - Y;
        D2 := DX * DX + DY * DY;
        if FnNoPush then
          if D2 <= H2 then
            if (not Defused) or HumanOf[i] then
              FnHold(i, P, PX, PY);
        if Defused then
          FnOwnDamage(O, P, X, Y);
        if D2 > R2 then
          Continue;
        Ok := True;
        if FnAffects <> FA_ALL then
        begin
          if i = O then
            Ok := FnAffects = FA_ENEMIES_SELF
          else
            Ok := Enemies(O, i);
        end;
        if not Ok then
          Continue;
        { the flash is seen only with no wall between it and his eyes }
        if Ray(X, Y - 2, EX, EY, False) then
          Continue;
        { MaxTicks next to it, MinTicks at Radius; the higher Falloff, the longer it stays near MaxTicks
          before it drops towards the edge (1 = evenly) }
        F := Sqrt(D2) / FnRadius;
        AX := 1;
        for n := 1 to FnFalloff do
          AX := AX * F;
        T := FnMinTicks + Round((FnMaxTicks - FnMinTicks) * (1 - AX));
        if T < FnMinTicks then
          T := FnMinTicks;
        { turned away from it (the cursor on the other side): shorter }
        if FnBehind < 0.999 then
        begin
          AX := P.MouseAimX - EX;
          AY := P.MouseAimY - EY;
          if AX * (X - EX) + AY * (Y - EY) < 0 then
            T := Round(T * FnBehind);
        end;
        if T > 0 then
          FnBlind(i, P, T, Tick);
      end;
end;

{ the grenade at place k is about to touch a soldier or a collider: the game makes a frag grenade burst
  on a soldier (on his head, body or legs - from 3 to 19 px over his feet, 8 px around, the game's
  PART_RADIUS + 1; its thrower too once its fuse is under 130) and on the map's colliders, so a flash is
  taken out a tick before; its next step is looked at (and half a step more) }
function FnTouching(k: Integer; Bul: TActiveMapBullet; TOut: Integer): Boolean;
var
  i, n: Integer;
  BX, BY, SX, SY, CX, CY, PX, PY, DX, DY: Single;
  P: TActivePlayer;
begin
  Result := False;
  BX := Bul.X;
  BY := Bul.Y;
  SX := Bul.VelX * 1.5;
  SY := Bul.VelY * 1.5;
  if MapOk then
    if BE_MapColliderRay(BX, BY, BX + SX, BY + SY) = 1 then
    begin
      Result := True;
      Exit;
    end;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if (i <> FnOwner[k]) or (TOut < 130) then
        if TeamOf[i] <> TEAM_SPECTATOR then
        begin
          P := PL[i];
          if not P.Alive then
            Continue;
          PX := P.X - 2;
          PY := P.Y;
          if Abs(PX - BX) > 50 then
            Continue;
          if Abs(PY - 11 - BY) > 55 then
            Continue;
          for n := 0 to 2 do
          begin
            CX := BX + SX * n / 2;
            CY := BY + SY * n / 2;
            DX := CX - PX;
            if CY > PY - 3 then
              DY := CY - (PY - 3)
            else if CY < PY - 19 then
              DY := CY - (PY - 19)
            else
              DY := 0;
            if DX * DX + DY * DY <= 11 * 11 then
            begin
              Result := True;
              Exit;
            end;
          end;
        end;
end;

{ where the grenades are now; a grenade gone has exploded (a flash then does its work). The bridge
  tells a grenade from a new bullet in its slot (its owner, style and a fuse that only counts down);
  without it the bullet's own properties are read. Defuse: a flash is taken out of the server just
  before it goes off - its fuse at its end, or about to touch a soldier - and does its work here: the
  server has no blast, so no push and no damage of its own (the players' games still show it). }
procedure FnFollow(Tick: Integer);
var
  k, b, A, O, W, St, TOut, Info: Integer;
  Alive, Gone: Boolean;
  Bul: TActiveMapBullet;
  X, Y: Single;
begin
  k := FnCount - 1;
  while k >= 0 do
  begin
    b := FnSlot[k];
    Bul := BL[b];
    Alive := False;
    TOut := FnTimeOut[k];
    A := 0;
    O := 0;
    W := 0;
    St := 0;
    Info := 0;
    if BeOk then
      Info := BE_BulletInfo(b, A, O, W, St, TOut);
    if Info = 1 then
    begin
      if A = 1 then
        if O = FnOwner[k] then
          if St = BS_FRAGNADE then
            if TOut <= FnTimeOut[k] then
              Alive := True;
    end
    else if Bul.Active then
      if Bul.Style = BS_FRAGNADE then
        if Bul.Owner = FnOwner[k] then
          Alive := True;
    if Alive then
    begin
      FnTimeOut[k] := TOut;
      FnPX[k] := FnX[k];
      FnPY[k] := FnY[k];
      FnX[k] := Bul.X;
      FnY[k] := Bul.Y;
      FnVX[k] := Bul.VelX;
      FnVY[k] := Bul.VelY;
      Gone := False;
      if FnDefuse then
        if Info = 1 then
          if FnKind[k] = FN_FLASH then
            if (TOut <= 2) or FnTouching(k, Bul, TOut) then
              if BE_BulletKill(b, FnOwner[k], BS_FRAGNADE) = 1 then
              begin
                FnStatDefused := FnStatDefused + 1;
                FnBoom(k, FnX[k], FnY[k], Tick, True);
                FnForget(k);
                Gone := True;
              end;
      if not Gone then
        if FnLabels then
          FnLabel(k, Tick);
    end
    else
    begin
      if FnKind[k] = FN_FLASH then
      begin
        { where it went off: where it hurt somebody, or a step on from where it was last seen }
        if Tick - FnBoomTick[b] <= 2 then
        begin
          X := FnBoomX[b];
          Y := FnBoomY[b];
        end
        else
        begin
          X := FnX[k] + (FnX[k] - FnPX[k]);
          Y := FnY[k] + (FnY[k] - FnPY[k]);
        end;
        FnBoom(k, X, Y, Tick, False);
      end;
      FnForget(k);
    end;
    k := k - 1;
  end;
end;

{ OnDamage: the explosion of a flash does the flash's own damage - MaxDamage near it, less further out,
  nothing beyond DamageRadius or through a wall - instead of a grenade's; where it went off is kept }
function FnHit(V: TActivePlayer; S, B: Integer; Damage: Single; Tick: Integer): Single;
var
  k: Integer;
  BX, BY, VX, VY, D2, R2: Single;
  Bul: TActiveMapBullet;
begin
  Result := Damage;
  k := FnSlotOf[B] - 1;
  if k < 0 then
    Exit;
  if FnKind[k] <> FN_FLASH then
    Exit;
  if FnOwner[k] <> S then
    Exit;
  Bul := BL[B];
  if not Bul.Active then
    Exit;
  if Bul.Style <> BS_FRAGNADE then
    Exit;
  BX := Bul.X;
  BY := Bul.Y;
  FnBoomX[B] := BX;
  FnBoomY[B] := BY;
  FnBoomTick[B] := Tick;
  Result := 0;
  if FnDamage <= 0 then
    Exit;
  VX := V.X;
  VY := V.Y - BODY_HEIGHT;
  D2 := (VX - BX) * (VX - BX) + (VY - BY) * (VY - BY);
  R2 := FnDamageRadius * FnDamageRadius;
  if D2 >= R2 then
    Exit;
  if Ray(BX, BY - 2, VX, VY, False) then
    Exit;
  Result := FnDamage * (1 - D2 / R2);
end;

{ the soldiers whose grenade was thrown get the next one (with Max_Grenades 1 GiveBonus gives exactly
  one), as long as they have any left. The server counts a player's grenades itself (a thrown one it
  takes off, a grenade packet with none left it refuses), so its count is right at once. Only the players
  something happened to are looked at (a throw, a new life, a kit); All = everybody (every two seconds:
  clusters used up, anything missed). }
procedure FnRefill(Tick: Integer; All: Boolean);
var
  i: Integer;
  P: TActivePlayer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if FnNeed[i] or All then
        if Tick >= FnRefillAt[i] then
        begin
          if FnNadeLeft[i] + FnFlashLeft[i] <= 0 then
            FnNeed[i] := False
          else if TeamOf[i] <> TEAM_SPECTATOR then
          begin
            P := PL[i];
            if P.Alive and (not DwDown[i]) and (BdShockUntil[i] = 0) then
            begin
              if P.Grenades >= 1 then
                FnNeed[i] := False
              else if ObjectsFree(OBJECT_MARGIN) >= OBJECT_MARGIN then
              begin
                { looked at again once it is given }
                P.GiveBonus(4);
                FnRefillAt[i] := Tick + 20;
                FnNeed[i] := True;
              end;
            end;
          end;
        end;
end;

{ the grenade kits on the map (looked up every two seconds) }
procedure FnKitScan();
var
  i: Integer;
begin
  FnKitCount := 0;
  for i := 1 to MAX_OBJECT_ID do
    if OB[i].Active then
      if OB[i].Style = OBJECT_GRENADEKIT then
        if FnKitCount < 16 then
        begin
          FnKits[FnKitCount] := i;
          FnKitCount := FnKitCount + 1;
        end;
end;

{ a kit taken: it comes back at a grenade kit spawn point, as the game does }
procedure FnKitMove(K: Integer);
var
  i, n, Pick: Integer;
begin
  OB[K].Kill;
  n := 0;
  for i := 1 to MAX_SPAWN_ID do
    if SP[i].Active then
      if SP[i].Style = SPAWN_GRENADEKIT then
        n := n + 1;
  if n = 0 then
    Exit;
  Pick := Random(0, n) + 1;
  n := 0;
  for i := 1 to MAX_SPAWN_ID do
    if SP[i].Active then
      if SP[i].Style = SPAWN_GRENADEKIT then
      begin
        n := n + 1;
        if n = Pick then
        begin
          SpawnObject(OBJECT_GRENADEKIT, SP[i].X, SP[i].Y);
          Exit;
        end;
      end;
end;

{ A soldier carries one grenade (Max_Grenades 1), so the game lets him take a grenade kit only when he
  has none: the script gives a kit's grenades to anybody who touches it (KitRadius) and misses some. }
{ the object in slot K is a kit of a class ([Classes]) }
function FnClsKit(K: Integer): Boolean;
var
  q: Integer;
begin
  Result := False;
  for q := 0 to ClsObjN - 1 do
    if ClsObjSlot[q] = K then
      Result := True;
end;

procedure FnKitTick(Tick: Integer);
var
  j, K, i: Integer;
  KX, KY, R2, DX, DY: Single;
  P: TActivePlayer;
begin
  if Tick >= FnKitDue then
  begin
    FnKitDue := After(Tick, 120);
    FnKitScan();
  end;
  if FnKitCount = 0 then
    Exit;
  R2 := FnKitRadius * FnKitRadius;
  for j := FnKitCount - 1 downto 0 do
  begin
    K := FnKits[j];
    if not OB[K].Active then
      Continue;
    if OB[K].Style <> OBJECT_GRENADEKIT then
      Continue;
    KX := OB[K].X;
    KY := OB[K].Y;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if TeamOf[i] <> TEAM_SPECTATOR then
          if FnKitWanted(i) then
          begin
            P := PL[i];
            if P.Alive then
            begin
              DX := P.X - KX;
              DY := P.Y - KY;
              if DX * DX + DY * DY <= R2 then
              begin
                FnKitGive(i);
                if FnClsKit(K) then
                begin
                  { a class's kit: taken away (not moved to a spawn point); its owner's points come in ClsTick }
                  OB[K].Kill;
                  if ClsKitQN < 16 then
                  begin
                    ClsKitQT[ClsKitQN] := i;
                    ClsKitQS[ClsKitQN] := K;
                    ClsKitQN := ClsKitQN + 1;
                  end;
                end
                else
                  FnKitMove(K);
                FnKits[j] := FnKits[FnKitCount - 1];
                FnKitCount := FnKitCount - 1;
                Break;
              end;
            end;
          end;
  end;
end;

{ SwitchKey: a new press changes the type (the game sends the change weapon key for the whole weapon
  change, so only a press counts, not the key held) }
procedure FnKeysTick;
var
  i: Integer;
  P: TActivePlayer;
  Down: Boolean;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if HumanOf[i] then
      begin
        P := PL[i];
        Down := False;
        if P.Alive then
          Down := KeysHeld(P, FnSwitchKeys);
        if Down then
          if not FnKeyWas[i] then
            FnSwitch(i, -1, True);
        FnKeyWas[i] := Down;
      end;
end;

{ a new life: all the grenades, the type of [FlashNades] DefaultType, the white screen and a bot's pause
  are over }
procedure FnRespawn(ID: Integer);
var
  N, F: Integer;
begin
  N := FnNadeLeft[ID];
  F := FnFlashLeft[ID];
  FnFill(ID);
  { a survivor of a survival round keeps what he had left above a life's supply (ShopOnly flashes: only what
    he had) }
  if CyKept[ID] then
  begin
    if N > FnNadeLeft[ID] then
      FnNadeLeft[ID] := N;
    if ShActive and ((ShShopOnly and 8) <> 0) then
      FnFlashLeft[ID] := F
    else if F > FnFlashLeft[ID] then
      FnFlashLeft[ID] := F;
    FnAutoType(ID);
  end;
  FnUnblind(ID);
  FnBotRelease(ID);
  if FnHoldLeft[ID] > 0 then
  begin
    FnHoldLeft[ID] := 0;
    FnHoldCount := FnHoldCount - 1;
    if FnHoldCount < 0 then
      FnHoldCount := 0;
  end;
end;

{ the tokens of the flash texts, in braces: switch (how the type is switched here), nades and flashes (a
  life's) }
function FnFillText(S: string): string;
begin
  if BeOk then
    Result := BE_Fill(S, '{switch}'#1 + FnSwitchHow + #1'{nades}'#1 + IntToStr(FnNades) + #1'{flashes}'#1 +
      IntToStr(FnFlashes))
  else
  begin
    Result := ReplaceAll(S, '{switch}', FnSwitchHow);
    Result := ReplaceAll(Result, '{nades}', IntToStr(FnNades));
    Result := ReplaceAll(Result, '{flashes}', IntToStr(FnFlashes));
  end;
end;

{ [FlashNades] JoinText, JoinBigText: a new player is told how the flashes work }
procedure FnJoinHint(ID: Integer; P: TActivePlayer);
begin
  if FnJoinText <> '' then
    Say(ID, FnFillText(FnJoinText), FnTextColor);
  if FnJoinTicks > 0 then
    if FnJoinBig <> '' then
      P.BigText(FnJoinLayer, FnFillText(FnJoinBig), FnJoinTicks, FnHudColor, FnJoinScale, FnJoinX, FnJoinY);
end;

{ [FlashNades] off (or the script stops): Max_Grenades as it was, the bots it paused go on, no grenade
  is followed }
procedure FnRestore();
var
  i: Integer;
begin
  if FnSavedMax >= 0 then
  begin
    Game.MaxGrenades := FnSavedMax;
    Log('[FlashNades] off: Max_Grenades is ' + IntToStr(FnSavedMax) + ' again');
    FnSavedMax := -1;
  end;
  for i := 1 to 32 do
  begin
    FnBotRelease(i);
    FnHoldLeft[i] := 0;
  end;
  FnHoldCount := 0;
  FnClear();
end;

{ ================================ guided rockets ([ExtraRocket]) ================================ }

{ Guided rockets, from the owner's ExtraRocket script, which flew its rocket in a loop with Sleep and so
  stopped the whole server for half a second. Here the library (be_rocket) flies them, a tick at a time,
  like real guided missiles: the motor pushes against a drag that grows with the speed, the fins turn it
  at most Agility sideways - so the turn rate falls with the speed and a fast rocket turns wide -
  proportional navigation leads a running target, a look-ahead finds walls and throttles back to turn
  round them. A Javelin's launch: out of the tube slowly, the motor starts a moment later, and with room
  above it climbs over the target and dives on him. The script locks on the target (the sight closes on
  him while the keys are held), feeds in where the targets are and turns the library's events into
  flames, sounds and the burst: the old script's rings of M79 grenades and stationary gun bullets, the
  shooter's own; the bullet memory bridge writes the rocket's weapon into them, so a kill shows the LAW. }

{ a shot of the rocket's weapon (the hook): with UsesRound the rocket takes the round, so a shot that comes
  through right after a rocket (the player's game fired it before it heard of the rocket) is taken out
  of the game; just after a shot the weapon counts as not loaded }
procedure RkShotSeen(O, B, St, Tick: Integer);
begin
  if (O < 1) or (O > 32) then
    Exit;
  RkLawShot[O] := Tick;
  if RkLauncher <> RL_FREE then
    if Tick - RkLaunchAt[O] <= 30 then
      if BeOk then
        if BE_BulletKill(B, O, St) = 1 then
          RkStatKilled := RkStatKilled + 1;
end;

{ a knife for his hands (the secondary stays) }
procedure KnifeGive(P: TActivePlayer);
var
  NW: TNewWeapon;
begin
  NW := TNewWeapon.Create;
  try
    NW.WType := WEP_KNIFE;
    P.ForceWeapon(NW, P.Secondary);
    AmGiven(P.ID);
  finally
    NW.Free;
  end;
end;

{ a knife was thrown (the hook saw the thrown knife made; without it: the knife left his hands): with
  /infammo it comes back at once, with [Ammo] CombatKnife a spare one comes after the throw }
procedure KnifeThrown(O, Tick: Integer);
begin
  if (O < 1) or (O > 32) then
    Exit;
  if not ActiveSlot[O] then
    Exit;
  KnStatThrown := KnStatThrown + 1;
  if InfOn[O] then
  begin
    if KnGiveAt[O] = 0 then
      KnPending := KnPending + 1;
    KnGiveAt[O] := Tick + 12;
    Exit;
  end;
  if not AmmoEnabled then
    Exit;
  if not (HumanOf[O] or AmmoBots) then
    Exit;
  if KnLeft[O] <= 0 then
    Exit;
  KnLeft[O] := KnLeft[O] - 1;
  if KnGiveAt[O] = 0 then
    KnPending := KnPending + 1;
  KnGiveAt[O] := Tick + 20;
  HudMark(O, False);
end;

{ the knives waiting are given (every third tick): only into empty hands - who picked up a gun in the
  meantime keeps his spare knife; without the hook the throws are looked for here }
procedure KnifeTick(Tick: Integer);
var
  i, W: Integer;
  P: TActivePlayer;
begin
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
    begin
      P := PL[i];
      if not P.Alive then
      begin
        if KnGiveAt[i] > 0 then
        begin
          KnGiveAt[i] := 0;
          KnPending := KnPending - 1;
        end;
        KnLastW[i] := WEP_NONE;
        Continue;
      end;
      W := P.Primary.WType;
      if not HookOn then
        if W = WEP_NONE then
          if KnLastW[i] = WEP_KNIFE then
            if not InfOn[i] then
              KnifeThrown(i, Tick);
      KnLastW[i] := W;
      if KnGiveAt[i] > 0 then
        if Tick >= KnGiveAt[i] then
        begin
          KnGiveAt[i] := 0;
          KnPending := KnPending - 1;
          if W = WEP_NONE then
          begin
            KnifeGive(P);
            KnStatGiven := KnStatGiven + 1;
          end
          else if not InfOn[i] then
            KnLeft[i] := KnLeft[i] + 1;
          HudMark(i, False);
        end;
    end;
  if KnPending < 0 then
    KnPending := 0;
end;

{ The hook in the server's CreateBullet reports the bullets of the weapons watched the moment they are
  made - with its slot, even a point-blank one that is gone before this tick: the weapon numbers are the
  game's (0-16 the guns, 50 a frag grenade, 51 a cluster grenade, 53 a thrown knife). Here they go to the
  features: grenades to [FlashNades], thrown knives to the spare knives and /infammo, the rocket's
  weapon to [ExtraRocket]. }
procedure HookDrain(Tick: Integer);
var
  T, Slot, Owner, W, St, Guard: Integer;
  X, Y, VX, VY: Single;
begin
  Guard := 0;
  while BE_ShotNext(T, Slot, Owner, W, St, X, Y, VX, VY) = 1 do
  begin
    Guard := Guard + 1;
    if W = W_GRENADE then
    begin
      if FnEnabled then
        FnThrown(Owner, Slot, X, Y, Tick);
    end
    else if W = W_KNIFE_THROWN then
      KnifeThrown(Owner, Tick)
    else if (W = 8) and (ShApWatch > 0) then
    begin
      if ShQN <= 31 then
      begin
        ShQOwner[ShQN] := Owner;
        ShQT[ShQN] := T;
        ShQSlot[ShQN] := Slot;
        ShQStyle[ShQN] := St;
        ShQX[ShQN] := X;
        ShQY[ShQN] := Y;
        ShQVX[ShQN] := VX;
        ShQVY[ShQN] := VY;
        ShQN := ShQN + 1;
      end;
    end
    else if RkEnabled then
      if W = RkWeapon then
        RkShotSeen(Owner, Slot, St, Tick);
    if Guard >= 256 then
      Break;
  end;
end;

{ OnDamage of a frag grenade not followed yet: a bot's grenade can explode in the very frame it was
  thrown (point blank), before this script's tick - the hook's reports are read now; without the hook
  the grenade of a living player is taken as thrown now. No text is sent from inside the event. }
procedure FnLate(B: Integer; S: TActivePlayer; Tick: Integer);
var
  Bul: TActiveMapBullet;
begin
  Bul := BL[B];
  if Bul.Style <> BS_FRAGNADE then
    Exit;
  if not Bul.Active then
    Exit;
  FnQuiet := True;
  try
    if HookOn then
      HookDrain(Tick)
    else if S.Alive then
      FnThrown(S.ID, B, Bul.X, Bul.Y, Tick);
  finally
    FnQuiet := False;
  end;
end;

{ the rocket's target, in sight and within Range: Target = radius the enemy nearest to the cursor within
  CursorRadius of it, nearest the nearest enemy, cursor the one nearest to the line of the cursor within
  CursorAngle }
function RkFind(i: Integer; SX, SY: Single): Integer;
var
  c, k, n, Mode: Integer;
  Lim: Single;
begin
  Result := 0;
  Mode := RkTargetMode;
  Lim := 180;
  if Mode = AT_CURSOR then
    Lim := RkAngle
  else if Mode = AT_RADIUS then
    Lim := RkRadius;
  if MapOk then
  begin
    n := BE_GunPick(i, Mode, RkRange, Lim, SX, SY, BODY_HEIGHT, 4, MR_BULLET);
    if n >= 0 then
    begin
      Result := n;
      Exit;
    end;
  end;
  c := BE_GunTargets(i, Mode, RkRange, Lim);
  k := 0;
  while (k < c) and (k < 4) do
  begin
    n := BE_GunTarget(k);
    if (n >= 1) and (n <= 32) then
      if not Map.RayCast(SX, SY, PL[n].X, PL[n].Y - BODY_HEIGHT, False, False, True, False, 0) then
      begin
        Result := n;
        Exit;
      end;
    k := k + 1;
  end;
end;

{ the rocket in slot k is gone (burst or lost) }
procedure RkGone(k: Integer);
begin
  if (k < 0) or (k >= RK_MAX) then
    Exit;
  if not RkLive[k] then
    Exit;
  RkLive[k] := False;
  RkCount := RkCount - 1;
  if RkCount < 0 then
    RkCount := 0;
end;

{ no rocket flies any more (a map change, the feature switched off) }
procedure RkClearAll();
var
  k: Integer;
begin
  for k := 0 to RK_MAX - 1 do
    RkLive[k] := False;
  RkCount := 0;
  if BeOk then
    BE_RkReset();
end;

{ N bullets on a ring of radius R around X, Y, flying out at Speed (in with a negative one) plus DX, DY
  (the old script's nova) }
procedure RkNova(X, Y, DX, DY, R, Speed, Power: Single; N, Style, Owner: Integer);
var
  j, B: Integer;
  Ang, S, C: Single;
begin
  if N < 1 then
    Exit;
  if not BulletRoom(N) then
    Exit;
  Ang := 6.28318 / N;
  for j := N downto 1 do
  begin
    S := Sin(Ang * j);
    C := Cos(Ang * j);
    B := ScriptBullet(C * R + X, S * R + Y, C * Speed + DX, S * Speed + DY, Power, Style, PL[Owner]);
    if BeOk then
      if (B >= 1) and (B <= 255) then
        BE_BridgeSetWeapon(B, Style, RkWeapon, Power);
  end;
end;

{ the final blow: a real LAW rocket of the shooter at X, Y flying VX, VY - it bursts on what it touches.
  The bridge writes the rocket's weapon into it and where and when the Javelin of slot k left the tube,
  so a kill by it shows the LAW in the kill list and the whole distance and time in the air under
  "You killed" (the server's death message counts them from those two fields) }
procedure RkFinal(i, k: Integer; X, Y, VX, VY: Single; Tick: Integer);
var
  B: Integer;
  HitM: Single;
begin
  if not BulletRoom(1) then
    Exit;
  HitM := RkLawHitM * RkPower;
  B := ScriptBullet(X, Y, VX, VY, HitM, BS_LAW, PL[i]);
  if BeOk then
    if (B >= 1) and (B <= 255) then
    begin
      BE_BridgeSetWeapon(B, BS_LAW, RkWeapon, HitM);
      if (k >= 0) and (k < RK_MAX) then
        BE_BridgeSetOrigin(B, BS_LAW, X, Y, RkFromX[k], RkFromY[k], Tick - RkFromTick[k]);
    end;
end;

{ the burst of shooter i's rocket (slot k): How = 1 at T (the target or another enemy on its way; with
  HitPercent he first loses that share of his health, never the last point), 2 at a wall, 3 when its
  glide ended (the rocket goes on as a real LAW rocket and bursts where it lands). The blast is a column
  of real LAW rockets along the line from the launch (made first, they take the lower bullet slots, which
  the game moves first): whichever of them kills, the kill is a LAW's with the whole distance and time;
  the stationary gun sparks fly out of it (BlastSparks). }
procedure RkBurst(i, T, How, k: Integer; X, Y, VX, VY: Single; Tick: Integer);
var
  H, A, Pw, TX, TY, DX, DY, D: Single;
begin
  if (i < 1) or (i > 32) then
    Exit;
  if not ActiveSlot[i] then
    Exit;
  AcSkip[i] := Tick;
  Pw := RkPower;
  D := Sqrt(VX * VX + VY * VY);
  if How = 1 then
  begin
    RkStatHits := RkStatHits + 1;
    TX := X;
    TY := Y;
    if (T >= 1) and (T <= 32) then
      if ActiveSlot[T] then
        if PL[T].Alive then
        begin
          TX := PL[T].X;
          TY := PL[T].Y - BODY_HEIGHT;
          if RkHitPct > 0 then
          begin
            H := PL[T].Health;
            A := H * RkHitPct / 100;
            if H - A < 1 then
              A := H - 1;
            if A >= 1 then
              PL[T].Damage(i, A);
          end;
        end;
    { the final blow comes along the line from the launch, from 14 px before him (so the statistics
      see it fly away from where it was fired) }
    DX := VX;
    DY := VY;
    if (k >= 0) and (k < RK_MAX) then
    begin
      DX := TX - RkFromX[k];
      DY := TY - RkFromY[k];
    end;
    D := Sqrt(DX * DX + DY * DY);
    if D < 0.01 then
    begin
      DX := 1;
      DY := 0;
      D := 1;
    end;
    DX := DX / D;
    DY := DY / D;
    RkFinal(i, k, TX - DX * 14, TY - DY * 14, DX * 10, DY * 10, Tick);
    RkFinal(i, k, TX - DX * 22, TY - DY * 22, DX * 10, DY * 10, Tick);
    RkFinal(i, k, TX - DX * 30, TY - DY * 30, DX * 10, DY * 10, Tick);
    if RkSparks then
    begin
      RkNova(X, Y, VX / 2, VY / 2, 20, 5, 2 * Pw, 7, BS_M2, i);
      RkNova(TX, TY, 0, 0, 30, 8, 2 * Pw, 9, BS_M2, i);
    end;
  end
  else if How = 2 then
  begin
    if D < 0.01 then
    begin
      VX := 0;
      VY := 1;
      D := 1;
    end;
    RkFinal(i, k, X, Y, VX / D * 10, VY / D * 10, Tick);
    RkFinal(i, k, X - VX / D * 8, Y - VY / D * 8, VX / D * 10, VY / D * 10, Tick);
    if RkSparks then
      RkNova(X, Y, VX / 2, VY / 2, 20, 5, 2 * Pw, 7, BS_M2, i);
  end
  else
    RkFinal(i, k, X, Y, VX, VY, Tick);
end;

{ a sound of the rocket at X, Y, for the players near it }
procedure RkSoundAt(Snd: string; X, Y: Single);
var
  j: Integer;
begin
  if not RkSound then
    Exit;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] then
        if (Abs(PL[j].X - X) <= RkSoundRange) and (Abs(PL[j].Y - Y) <= RkSoundRange) then
          PL[j].PlaySound(Snd, X, Y);
end;

{ a flame of shooter i that hurts nobody (the trail, the motor starting) }
procedure RkFlame(i: Integer; X, Y, VX, VY: Single);
begin
  if (i < 1) or (i > 32) then
    Exit;
  if not ActiveSlot[i] then
    Exit;
  if BulletRoom(1) then
    ScriptBullet(X, Y, VX, VY, 0, BS_FLAME, PL[i]);
end;

{ the motor starts (heading DX, DY): a burst of flames backwards and the roar of a LAW }
procedure RkIgnite(i: Integer; X, Y, DX, DY: Single);
var
  j: Integer;
  S, C: Single;
begin
  for j := -2 to 2 do
  begin
    S := Sin(j * 0.35);
    C := Cos(j * 0.35);
    RkFlame(i, X - DX * 4, Y - DY * 4, (-DX * C + DY * S) * 2.5, (-DY * C - DX * S) * 2.5);
  end;
  RkSoundAt('law.wav', X, Y);
end;

{ the rocket leaves the tube. Launcher = reload / round: the loaded weapon is empty now and reloads
  (reload: its round comes back at the reload, the reserve stays; round: the round went into the rocket);
  the shooter and the target are told, the launch is heard }
procedure RkLaunch(i: Integer; P: TActivePlayer; T, W: Integer; SX, SY: Single; Tick: Integer);
var
  k, A: Integer;
begin
  k := BE_RkLaunch(i, T, SX, SY, PL[T].X, PL[T].Y - BODY_HEIGHT, PL[T].VelX, PL[T].VelY);
  if (k < 0) or (k >= RK_MAX) then
    Exit;
  if not RkLive[k] then
    RkCount := RkCount + 1;
  RkLive[k] := True;
  RkOwner[k] := i;
  RkTgt[k] := T;
  RkFromX[k] := SX;
  RkFromY[k] := SY;
  RkFromTick[k] := Tick;
  RkUsed[i] := RkUsed[i] + 1;
  RkNextAt[i] := After(Tick, RkCooldown);
  RkLaunchAt[i] := Tick;
  RkStatFired := RkStatFired + 1;
  RkWarnActive := True;
  AcSkip[i] := Tick;
  if RkLauncher <> RL_FREE then
  begin
    P.Primary.Ammo := 0;
    if AmmoEnabled then
    begin
      BE_AmmoForced(i, Tick, W, 0);
      if RkLauncher = RL_RELOAD then
        BE_AmmoKeep(i, W, 1);
    end;
    AcAmmoTouched(i);
  end
  else if (RkKeys and KM_FIRE) <> 0 then
  begin
    { the fire key is one of the keys: a fresh copy of the loaded weapon starts its own start-up again,
      so it does not fire by itself }
    A := P.Primary.Ammo;
    P.Primary.Ammo := A;
    if AmmoEnabled then
      BE_AmmoForced(i, Tick, W, A);
    AcAmmoTouched(i);
  end;
  HudMark(i, False);
  if RkFireText <> '' then
    Say(i, RkText(RkFireText, i, T), RkColor);
  if RkWarn then
    if HumanOf[T] then
      if RkWarnText <> '' then
        Say(T, RkText(RkWarnText, i, T), RkWarnColor);
  { out of the tube with a pop; the motor's roar comes when it starts }
  if RkEjectTicks > 0 then
    RkSoundAt('m79-fire.wav', SX, SY);
end;

{ the brackets of a sight: [ and ] Gap spaces apart }
function RkBrackets(Gap: Integer): string;
var
  n: Integer;
begin
  Result := '[';
  for n := 1 to Gap do
    Result := Result + ' ';
  Result := Result + ']';
end;

{ the gap of the sight while a lock runs: 7 spaces at its start, 2 when it is done }
function RkLockGap(Left: Integer): Integer;
begin
  Result := 2;
  if RkLockTicks > 0 then
    if Left > 0 then
      Result := 2 + (Left * 5 + RkLockTicks - 1) div RkLockTicks;
  if Result < 2 then
    Result := 2;
  if Result > 7 then
    Result := 7;
end;

{ the sight on the target while the lock runs: brackets that close on him, seen by the shooter only }
procedure RkReticle(i, T, Tick: Integer);
var
  S: string;
  DX, DY: Single;
begin
  if not HumanOf[i] then
    if not DebugBots then
      Exit;
  S := RkBrackets(RkLockGap(RkLockDue[i] - Tick));
  DX := 0;
  DY := 0;
  if BeOk then
    BE_TextInk(S, RkLockScale, 0, DX, DY);
  PL[i].WorldText(RkLockLayer, S, 30, RkLockColor, RkLockScale, PL[T].X - DX, PL[T].Y - BODY_HEIGHT - DY);
  RkLockSent[i] := Tick;
end;

{ while it seeks (Target = radius, SeekSight): the seeker's brackets around the cursor (SeekWidth) }
procedure RkSeekSight(i, Tick: Integer);
var
  DX, DY: Single;
begin
  if not RkSeekShow then
    Exit;
  if RkTargetMode <> AT_RADIUS then
    Exit;
  if not HumanOf[i] then
    if not DebugBots then
      Exit;
  DX := 0;
  DY := 0;
  if BeOk then
    BE_TextInk(RkSeekText, RkLockScale, 0, DX, DY);
  PL[i].WorldText(RkLockLayer, RkSeekText, 30, RkSeekColor, RkLockScale, PL[i].MouseAimX - DX, PL[i].MouseAimY - DY);
  RkLockSent[i] := Tick;
end;

{ the lock or the search ends (the rocket left, the keys were let go, the target was lost): the sight goes }
procedure RkLockEnd(i: Integer);
begin
  if RkLockSent[i] <> 0 then
    if PL[i].Active then
      PL[i].WorldText(RkLockLayer, ' ', 1, ColorGood, 0.01, 0, 0);
  RkLockOn[i] := 0;
  RkLockSent[i] := 0;
  RkSeeking[i] := False;
end;

{ he is still a target of a shot from SX, SY: alive, in the game, in sight and in range }
function RkStillThere(T: Integer; SX, SY: Single): Boolean;
var
  DX, DY: Single;
begin
  Result := False;
  if (T < 1) or (T > 32) then
    Exit;
  if not ActiveSlot[T] then
    Exit;
  if TeamOf[T] = TEAM_SPECTATOR then
    Exit;
  if not PL[T].Alive then
    Exit;
  DX := PL[T].X - SX;
  DY := PL[T].Y - BODY_HEIGHT - SY;
  if DX * DX + DY * DY > RkRange * RkRange * 1.44 then
    Exit;
  if Ray(SX, SY, PL[T].X, PL[T].Y - BODY_HEIGHT, True) then
    Exit;
  Result := True;
end;

{ the weapon is loaded (Launcher = reload or round: the rocket leaves from the loaded weapon) }
function RkLoaded(i: Integer; P: TActivePlayer; W, Tick: Integer): Boolean;
var
  A: Integer;
begin
  Result := True;
  if RkLauncher = RL_FREE then
    Exit;
  A := P.Primary.Ammo;
  if AmmoEnabled then
    A := BE_AmmoShown(i, Tick, W, A);
  { the weapon has just fired by itself }
  if Tick - RkLawShot[i] < 40 then
    A := 0;
  Result := A > 0;
end;

{ a flash blinds him: no lock until BlindLockSeconds before his white screen ends (it fades then) }
function RkBlinded(i, Tick: Integer): Boolean;
begin
  Result := False;
  if FnEnabled then
    if FnBlindUntil[i] - Tick > RkBlindTicks then
      Result := True;
end;

{ the rocket's keys are down; lying counts as crouching (crouch would make a lying soldier get up) }
function RkKeysDown(P: TActivePlayer): Boolean;
begin
  if (RkKeys and KM_CROUCH) <> 0 then
    if P.IsProne then
    begin
      Result := KeysHeld(P, RkKeys and (not KM_CROUCH));
      Exit;
    end;
  Result := KeysHeld(P, RkKeys);
end;

{ while the lock runs (every third tick): the keys must stay down, he must see and the target stay in
  sight - the cursor may go anywhere now; then the rocket leaves }
procedure RkLockTick(i: Integer; P: TActivePlayer; W: Integer; Down: Boolean; Tick: Integer);
var
  T: Integer;
  SX, SY: Single;
begin
  T := RkLockOn[i];
  if not Down then
  begin
    RkLockEnd(i);
    Exit;
  end;
  SX := P.X;
  SY := P.Y - MUZZLE_HEIGHT;
  if RkBlinded(i, Tick) or (not RkStillThere(T, SX, SY)) then
  begin
    RkLockEnd(i);
    RkNextAt[i] := After(Tick, 30);
    if RkLostText <> '' then
      Say(i, RkText(RkLostText, i, T), RkWarnColor);
    Exit;
  end;
  if Tick < RkLockDue[i] then
  begin
    RkReticle(i, T, Tick);
    { the lock tone: a beep, quicker and quicker as the sight closes }
    if RkLockSound <> '' then
      if HumanOf[i] then
        if Tick >= RkBeepAt[i] then
        begin
          RkBeepAt[i] := Tick + 3 + ((RkLockDue[i] - Tick) * 12) div RkLockTicks;
          P.PlaySound(RkLockSound, P.X, P.Y);
        end;
    Exit;
  end;
  RkLockEnd(i);
  if RkCount >= RkMaxFlying then
    Exit;
  if not RkLoaded(i, P, W, Tick) then
  begin
    if RkNotLoadedText <> '' then
      Say(i, RkText(RkNotLoadedText, i, 0), RkWarnColor);
    Exit;
  end;
  RkLaunch(i, P, T, W, SX, SY, Tick);
end;

{ a player holding the rocket's weapon presses the keys: a new press is checked (a rocket left, he sees,
  the weapon loaded), then while the keys stay down the rocket's eye looks for a target every third
  tick (Target = radius: near the cursor, the seeker's brackets around it); once it has one the lock
  begins - or the rocket leaves at once (LockSeconds = 0) }
procedure RkCheck(i, Tick: Integer);
var
  P: TActivePlayer;
  W, T, A: Integer;
  SX, SY: Single;
  Down, Held: Boolean;
begin
  P := PL[i];
  { the weapon in the hands: the ammunition has read it in this tick already }
  W := -1;
  if AmmoEnabled and (HumanOf[i] or AmmoBots) then
    W := AmLastW[i]
  else if P.Alive then
    W := P.Primary.WType;
  Held := False;
  if P.Alive then
    Held := W = RkWeapon;
  { the count next to the ammunition comes and goes with the weapon }
  if Held <> RkHudHeld[i] then
  begin
    RkHudHeld[i] := Held;
    HudMark(i, False);
  end;
  Down := False;
  if Held then
    if not DwDown[i] then
      if BdShockUntil[i] = 0 then
        Down := RkKeysDown(P);
  if RkLockOn[i] > 0 then
  begin
    RkLockTick(i, P, W, Down, Tick);
    RkKeyWas[i] := Down;
    Exit;
  end;
  if not Down then
  begin
    if RkSeeking[i] then
      RkLockEnd(i);
    RkKeyWas[i] := False;
    Exit;
  end;
  if not RkKeyWas[i] then
  begin
    RkKeyWas[i] := True;
    if Tick < RkNextAt[i] then
      Exit;
    if RkGround then
      if not P.OnGround then
        Exit;
    RkNextAt[i] := After(Tick, 30);
    if RkUsed[i] >= RkRockets then
    begin
      if RkEmptyText <> '' then
        Say(i, RkText(RkEmptyText, i, 0), RkWarnColor);
      Exit;
    end;
    if RkBlinded(i, Tick) then
    begin
      if RkBlindText <> '' then
        Say(i, RkText(RkBlindText, i, 0), RkWarnColor);
      Exit;
    end;
    if not RkLoaded(i, P, W, Tick) then
    begin
      if RkNotLoadedText <> '' then
        Say(i, RkText(RkNotLoadedText, i, 0), RkWarnColor);
      Exit;
    end;
    RkSeeking[i] := True;
    RkSeekFrom[i] := Tick;
    RkSeekSaid[i] := False;
    if RkSound then
      if HumanOf[i] then
        P.PlaySound('law-start.wav', P.X, P.Y);
  end;
  if not RkSeeking[i] then
    Exit;
  if RkBlinded(i, Tick) then
  begin
    RkLockEnd(i);
    if RkBlindText <> '' then
      Say(i, RkText(RkBlindText, i, 0), RkWarnColor);
    Exit;
  end;
  if RkCount >= RkMaxFlying then
    Exit;
  WorldSnap(Tick, SNAP_AIM, False);
  SX := P.X;
  SY := P.Y - MUZZLE_HEIGHT;
  T := RkFind(i, SX, SY);
  if T <= 0 then
  begin
    RkSeekSight(i, Tick);
    if not RkSeekSaid[i] then
      if Tick - RkSeekFrom[i] >= 30 then
      begin
        RkSeekSaid[i] := True;
        if RkNoTargetText <> '' then
          Say(i, RkText(RkNoTargetText, i, 0), RkColor);
      end;
    Exit;
  end;
  RkSeeking[i] := False;
  if RkLockTicks <= 0 then
  begin
    RkLockEnd(i);
    RkLaunch(i, P, T, W, SX, SY, Tick);
    Exit;
  end;
  RkLockOn[i] := T;
  RkLockDue[i] := Tick + RkLockTicks;
  RkBeepAt[i] := Tick;
  RkWarnActive := True;
  if (RkKeys and KM_FIRE) <> 0 then
    if RkLauncher = RL_FREE then
    begin
      { a fresh copy of the loaded weapon: its own start-up begins again }
      A := P.Primary.Ammo;
      P.Primary.Ammo := A;
      if AmmoEnabled then
        BE_AmmoForced(i, Tick, W, A);
      AcAmmoTouched(i);
    end;
  RkReticle(i, T, Tick);
  if RkLockSound <> '' then
    if HumanOf[i] then
    begin
      RkBeepAt[i] := Tick + 15;
      P.PlaySound(RkLockSound, P.X, P.Y);
    end;
end;

{ LockWarning: the one a Javelin locks on sees the sight closing on himself and LockWarnText over his
  head and hears WarnSound, quicker and quicker as the lock closes; while a rocket flies at him
  IncomingText blinks there and the beep is fast. Every third tick while anything of it is on. }
procedure RkWarnOff(T: Integer);
begin
  if PL[T].Active then
  begin
    PL[T].WorldText(RkLockLayer + 1, ' ', 1, ColorGood, 0.01, 0, 0);
    PL[T].WorldText(RkWarnLayer, ' ', 1, ColorGood, 0.01, 0, 0);
  end;
  RkWShown[T] := False;
  RkWSight[T] := False;
  RkWBeepAt[T] := 0;
end;

procedure RkWarnTick(Tick: Integer);
var
  i, T, k, Mode, Every: Integer;
  S: string;
  C: Longint;
  DX, DY, W: Single;
  Any: Boolean;
begin
  Any := False;
  for T := 1 to TopSlot do
  begin
    RkWMode[T] := 0;
    RkWLeft[T] := 1000000;
  end;
  for i := 1 to TopSlot do
    if RkLockOn[i] > 0 then
    if ActiveSlot[i] then
    begin
      T := RkLockOn[i];
      if (T >= 1) and (T <= 32) then
      begin
        if RkWMode[T] = 0 then
          RkWMode[T] := 1;
        if RkLockDue[i] - Tick < RkWLeft[T] then
          RkWLeft[T] := RkLockDue[i] - Tick;
        RkWFrom[T] := i;
      end;
    end;
  for k := 0 to RK_MAX - 1 do
    if RkLive[k] then
    begin
      T := RkTgt[k];
      if (T >= 1) and (T <= 32) then
      begin
        RkWMode[T] := 2;
        RkWFrom[T] := RkOwner[k];
      end;
    end;
  for T := 1 to TopSlot do
  begin
    Mode := RkWMode[T];
    if Mode > 0 then
      if not ActiveSlot[T] then
        Mode := 0
      else if not PL[T].Alive then
        Mode := 0
      else if not HumanOf[T] then
        if not DebugBots then
          Mode := 0;
    if Mode = 0 then
    begin
      if RkWShown[T] then
        RkWarnOff(T);
      Continue;
    end;
    Any := True;
    RkWShown[T] := True;
    if Mode = 1 then
    begin
      { the sight on himself, as the shooter sees it }
      S := RkBrackets(RkLockGap(RkWLeft[T]));
      DX := 0;
      DY := 0;
      if BeOk then
        BE_TextInk(S, RkLockScale, 0, DX, DY);
      PL[T].WorldText(RkLockLayer + 1, S, 30, RkLockColor, RkLockScale, PL[T].X - DX, PL[T].Y - BODY_HEIGHT - DY);
      RkWSight[T] := True;
      S := RkText(RkLockWarnText, RkWFrom[T], T);
      C := RkWarnColor;
      Every := 15;
      if RkLockTicks > 0 then
        Every := 3 + (RkWLeft[T] * 12) div RkLockTicks;
      if Every < 3 then
        Every := 3;
    end
    else
    begin
      if RkWSight[T] then
      begin
        PL[T].WorldText(RkLockLayer + 1, ' ', 1, ColorGood, 0.01, 0, 0);
        RkWSight[T] := False;
      end;
      S := RkText(RkIncomingText, RkWFrom[T], T);
      C := RkWarnColor;
      if (Tick div 6) mod 2 = 1 then
        C := $FFFFFF;
      Every := 6;
    end;
    if S <> '' then
    begin
      if BeOk then
        W := BE_TextWidth(S, RkWarnScale)
      else
        W := Length(S) * RkWarnScale * WT_CHAR_WIDTH;
      PL[T].WorldText(RkWarnLayer, S, 30, C, RkWarnScale, PL[T].X - W / 2, PL[T].Y - 46);
    end;
    if RkWarnSound <> '' then
      if Tick >= RkWBeepAt[T] then
      begin
        RkWBeepAt[T] := Tick + Every;
        PL[T].PlaySound(RkWarnSound, PL[T].X, PL[T].Y);
      end;
  end;
  RkWarnActive := Any;
end;

{ what the rockets did in this tick (be_rocket's events): flames, sounds, bursts }
procedure RkEvents(Tick: Integer);
var
  k, Kind, O, T, Guard: Integer;
  X, Y, VX, VY: Single;
begin
  Guard := 0;
  k := 0;
  Kind := 0;
  O := 0;
  T := 0;
  X := 0;
  Y := 0;
  VX := 0;
  VY := 0;
  while BE_RkNext(k, Kind, O, T, X, Y, VX, VY) = 1 do
  begin
    Guard := Guard + 1;
    case Kind of
      RE_TRAIL:
        RkFlame(O, X, Y, VX, VY);
      RE_IGNITE:
        RkIgnite(O, X, Y, VX, VY);
      RE_MOTOR:
        RkSoundAt('rocketz.wav', X, Y);
      RE_HIT, RE_PROX:
        begin
          RkGone(k);
          RkBurst(O, T, 1, k, X, Y, VX, VY, Tick);
        end;
      RE_WALL:
        begin
          RkGone(k);
          RkBurst(O, 0, 2, k, X, Y, VX, VY, Tick);
        end;
      RE_AIR:
        begin
          RkGone(k);
          RkBurst(O, 0, 3, k, X, Y, VX, VY, Tick);
        end;
      RE_LOST:
        RkGone(k);
    end;
    if Guard >= 512 then
      Break;
  end;
end;

{ without the map's walls in the library, the server's own rays stop the rockets at walls }
procedure RkWallsByServer(Tick: Integer);
var
  k, O, T, Ph: Integer;
  X, Y, PX, PY: Single;
begin
  for k := 0 to RK_MAX - 1 do
    if RkLive[k] then
      if BE_RkState(k, O, T, Ph, X, Y, PX, PY) = 1 then
        if Map.RayCast(PX, PY, X, Y, False, False, True, False, 0) then
        begin
          BE_RkDrop(k);
          RkGone(k);
          RkBurst(O, 0, 2, k, PX, PY, X - PX, Y - PY, Tick);
        end;
end;

{ the tick of [ExtraRocket]: the keys of the players, their searches and locks and the warnings of their
  targets (every third tick; a player holds the keys longer), the rockets in the air (the library flies
  them: where their targets are now goes in, the events come out), the hint to everybody }
procedure RkTick(Tick: Integer);
var
  i, k, T: Integer;
  Alive: Boolean;
begin
  if Tick mod 3 = 2 then
  begin
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if HumanOf[i] or RkBots then
          RkCheck(i, Tick);
    if RkLockWarn then
      if RkWarnActive then
        RkWarnTick(Tick);
  end;
  if RkCount > 0 then
  begin
    if MapOk <> RkWallsSent then
    begin
      RkWallsSent := MapOk;
      BE_RkSet(RKC_WALLS, BoolInt(MapOk) * 1.0);
    end;
    { the proximity fuse looks at everybody }
    if RkProx > 0 then
      WorldSnap(Tick, SNAP_POS, False);
    for k := 0 to RK_MAX - 1 do
      if RkLive[k] then
      begin
        T := RkTgt[k];
        Alive := False;
        if (T >= 1) and (T <= 32) then
          if ActiveSlot[T] then
            if TeamOf[T] <> TEAM_SPECTATOR then
              if PL[T].Alive then
                Alive := True;
        if Alive then
          BE_RkAim(k, 1, PL[T].X, PL[T].Y - BODY_HEIGHT, PL[T].VelX, PL[T].VelY)
        else
          BE_RkAim(k, 0, 0, 0, 0, 0);
      end;
    BE_RkStep(Tick);
    if not MapOk then
      RkWallsByServer(Tick);
    RkEvents(Tick);
  end;
  if RkHintTicks > 0 then
    if Tick >= RkDueHint then
    begin
      RkDueHint := After(Tick, RkHintTicks);
      if RkHintText <> '' then
        SayAll(RkText(RkHintText, 0, 0), RkColor);
    end;
end;

{ [ExtraRocket]: the flight's settings go to the library (the start, /reloadsettings, a new map); the
  LAW's damage and the seeker's brackets }
procedure RkConfigure();
var
  St, Iv, Am, Rl, Su, n: Integer;
  Sp, Dm, Spr, Inh, Wd: Single;
begin
  if not BeOk then
    Exit;
  BE_RkSet(RKC_EJECT_SPEED, RkEjectSpeed);
  BE_RkSet(RKC_EJECT_TICKS, RkEjectTicks * 1.0);
  BE_RkSet(RKC_MAX_SPEED, RkMaxSpeed);
  BE_RkSet(RKC_THRUST, RkThrust);
  BE_RkSet(RKC_AGILITY, RkAgility);
  BE_RkSet(RKC_TURN_DRAG, RkTurnDrag);
  BE_RkSet(RKC_GRAVITY, RkGravity);
  BE_RkSet(RKC_LEAD, RkLead);
  BE_RkSet(RKC_LOOK_TICKS, RkLook);
  BE_RkSet(RKC_BRAKE, RkBrake);
  BE_RkSet(RKC_AVOID, BoolInt(RkAvoid) * 1.0);
  BE_RkSet(RKC_FUEL_TICKS, RkFuelTicks * 1.0);
  BE_RkSet(RKC_COAST_TICKS, RkCoastTicks * 1.0);
  BE_RkSet(RKC_PROFILE, RkProfile * 1.0);
  BE_RkSet(RKC_TOP_HEIGHT, RkTopHeight);
  BE_RkSet(RKC_HIT_RADIUS, RkHitRadius);
  BE_RkSet(RKC_PROX_RADIUS, RkProx);
  BE_RkSet(RKC_TRAIL_SPACING, RkTrailSpacing);
  BE_RkSet(RKC_TRAIL_SHARE, RkTrailShare);
  BE_RkSet(RKC_MOTOR_TICKS, 24.0);
  BE_RkSet(RKC_BODY, BODY_HEIGHT * 1.0);
  BE_RkSet(RKC_TEAM_GAME, BoolInt(TeamGame()) * 1.0);
  BE_RkSet(RKC_WALLS, BoolInt(MapOk) * 1.0);
  RkWallsSent := MapOk;
  { the final blow is a LAW rocket with the LAW's own damage (weapons.ini, also after /loadwep) }
  RkLawHitM := 1550;
  if BE_Weapon(WEP_LAW, Sp, Dm, Spr, Inh, St, Iv, Am, Rl, Su) = 1 then
    if Dm > 0 then
      RkLawHitM := Dm;
  { the seeker's brackets: SeekWidth pixels wide (0 = as wide as the circle around the cursor) }
  Wd := RkSeekWidth;
  if Wd <= 0 then
    Wd := 2 * RkRadius;
  n := Round((Wd - BE_TextWidth('[]', RkLockScale)) / BE_TextWidth(' ', RkLockScale));
  if n < 1 then
    n := 1;
  if n > 120 then
    n := 120;
  RkSeekText := RkBrackets(n);
end;

{ every living soldier is looked up in the server's memory once (the slot's record never moves; from two
  of them the library works out every other one): the flashes' eyes, [Radar] SkeletonSight }
procedure SkeletonBind();
var
  i: Integer;
begin
  for i := 1 to TopSlot do
    if not SkBound[i] then
      if ActiveSlot[i] then
        if PL[i].Alive then
          if BE_SpriteBind(i, PL[i], PL[i].X, PL[i].Y) = 1 then
            SkBound[i] := True;
end;

{ the tick of [FlashNades]: the hook's reports (also for [ExtraRocket] and the knives), the knives to
  give, the grenades in the air, the players held, the bots paused, the switch key, the next grenades,
  the kits }
procedure FnTick(Tick: Integer);
begin
  { D14: a flash the game exploded last frame is seen before a new grenade of this tick takes its slot }
  if FnEnabled then
    if FnCount > 0 then
      FnFollow(Tick);
  if HookOn then
    HookDrain(Tick)
  else if FnEnabled then
    if Tick mod 2 = 0 then
      FnScan(Tick);
  if Tick mod 3 = 1 then
    if KnPending > 0 then
      KnifeTick(Tick)
    else if not HookOn then
      if AmmoEnabled then
        if AmmoMax[WEP_KNIFE] > 0 then
          KnifeTick(Tick);
  if not FnEnabled then
    Exit;
  if FnHoldCount > 0 then
    FnHoldTick;
  if FnBotCount > 0 then
    if Tick mod 6 = 0 then
      FnBotTick(Tick);
  if FnSwitchKeys <> 0 then
    if Tick mod 3 = 1 then
      FnKeysTick;
  if Tick mod 6 = 3 then
    FnRefill(Tick, Tick mod 120 = 3);
  if FnKitNades + FnKitFlashes > 0 then
    if Tick mod 10 = 5 then
      FnKitTick(Tick);
end;

{ after the settings were read (the start, /reloadsettings): the rocket's weapon and flight, the weapons
  the hook reports, the flash marks, Max_Grenades }
procedure FnApply();
var
  i, W: Integer;
begin
  W := WeaponOf(RkWeaponName);
  if (W < 0) or (W > 16) then
  begin
    if RkEnabled then
      Log('settings.ini: [ExtraRocket] Weapon = ' + RkWeaponName + ': not a weapon, the LAW used');
    W := WEP_LAW;
  end;
  RkWeapon := W;
  if BeOk then
    if HookOn then
    begin
      BE_HookWatch(-1, 0);
      BE_HookWatch(W_KNIFE_THROWN, 1);
      if FnEnabled then
        BE_HookWatch(W_GRENADE, 1);
      if RkEnabled then
        BE_HookWatch(RkWeapon, 1);
      if ShApWatch > 0 then
        BE_HookWatch(8, 1);
    end;
  { a one-character label is centred on its grenade's picture: where its ink is, less where the picture's
    centre is from the grenade (the game draws it about 2 px higher) }
  FnFlashDX := 0;
  FnFlashDY := 0;
  FnNadeDX := 0;
  FnNadeDY := 0;
  if BeOk then
  begin
    if Length(FnFlashLabel) = 1 then
    begin
      BE_TextInk(FnFlashLabel, FnMarkScale, 0, FnFlashDX, FnFlashDY);
      FnFlashDX := FnFlashDX - FnMarkOX;
      FnFlashDY := FnFlashDY - FnMarkOY;
    end;
    if Length(FnNadeLabel) = 1 then
    begin
      BE_TextInk(FnNadeLabel, FnMarkScale, 0, FnNadeDX, FnNadeDY);
      FnNadeDX := FnNadeDX - FnMarkOX;
      FnNadeDY := FnNadeDY - FnMarkOY;
    end;
  end;
  RkConfigure();
  if FnEnabled then
  begin
    if FnSavedMax < 0 then
    begin
      FnSavedMax := Game.MaxGrenades;
      Game.MaxGrenades := 1;
      Log('[FlashNades] on: Max_Grenades ' + IntToStr(FnSavedMax) + ' -> 1 (one grenade in the hand, the script ' +
        'gives the next one)');
      for i := 1 to 32 do
        if ActiveSlot[i] then
          FnFill(i);
    end;
    if not HookOn then
      Log('[FlashNades] the hook in the server is not there: the grenades are looked for in the bullet table');
  end
  else
    FnRestore();
  if not RkEnabled then
    RkClearAll();
end;

{ !grenadetype (the other type), !nade (a normal one), !flash (a flash - typed again: a normal one) }
procedure CmdNadeType(ID, Mode: Integer);
begin
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'The grenades are for players in the game.', ColorBad);
    Exit;
  end;
  if not FnEnabled then
  begin
    Say(ID, 'Flash grenades are switched off on this server.', ColorBad);
    Exit;
  end;
  if Mode = FN_FLASH + 10 then
  begin
    Mode := FN_FLASH;
    if FnType[ID] = FN_FLASH then
      Mode := FN_NADE;
  end;
  FnSwitch(ID, Mode, False);
end;

{ !flashhelp: how the flashes work here (from the settings: the keys and commands, the numbers) }
procedure CmdFlashHelp(ID: Integer);
var
  S: string;
begin
  if not FnEnabled then
  begin
    Say(ID, 'Flash grenades are switched off on this server.', ColorBad);
    Exit;
  end;
  S := 'Flash grenades: every life brings ' + IntToStr(FnNades) + ' normal and ' + IntToStr(FnFlashes) + ' flash grenade';
  if FnFlashes <> 1 then
    S := S + 's';
  if FnKitNades + FnKitFlashes > 0 then
    S := S + ', a grenade kit ' + IntToStr(FnKitNades) + ' and ' + IntToStr(FnKitFlashes) + ' more';
  Say(ID, S + '. You carry one grenade at a time; the next comes when it is thrown.', FnTextColor);
  S := 'A flash blinds ';
  if FnAffects = FA_ALL then
    S := S + 'everybody'
  else if FnAffects = FA_ENEMIES then
    S := S + 'the enemies'
  else
    S := S + 'the enemies and its thrower';
  S := S + ' within ' + FloatStr(FnRadius / 14, 1) + ' m who can see it for ' + FloatStr(FnMinTicks * 1.0 / 60, 1) + '-' +
    FloatStr(FnMaxTicks * 1.0 / 60, 1) + ' s';
  if FnDamage > 0 then
    S := S + ', hurts up to ' + IntToStr(Round(FnDamage)) + ' within ' + FloatStr(FnDamageRadius / 14, 1) + ' m'
  else
    S := S + ', hurts nobody';
  if FnNoPush then
    S := S + ' and pushes nobody';
  Say(ID, S + '.', FnTextColor);
  { how the type is switched here }
  S := 'Switch the next grenade:';
  if FnSwitchKeys <> 0 then
    S := S + ' ' + KeyMaskText(FnSwitchKeys) + ' (a new press),';
  if FnFlashShort <> '' then
    S := S + ' !' + FnFlashShort + ' or /' + FnFlashShort + ' = flash on/off,';
  if FnNadeShort <> '' then
    S := S + ' !' + FnNadeShort + ' = a normal one,';
  if FnSwitchWord <> '' then
    S := S + ' !' + FnSwitchWord + ' = the other type,';
  if Copy(S, Length(S), 1) = ',' then
    Delete(S, Length(S), 1);
  if FnAuto then
    S := S + '. When one type runs out, the other comes by itself';
  Say(ID, S + '.', FnTextColor);
  if FnSmokeTaunts then
    Say(ID, 'The default taunts: Alt+1 (/smoke) = a normal grenade, Alt+2 (/tabac) = a flash.', FnTextColor);
  if FnLabels then
    if (FnNadeLabel <> '') or (FnFlashLabel <> '') then
    begin
      if FnSeenBy = LS_OWNER then
        S := 'only you'
      else if FnSeenBy = LS_TEAM then
        S := 'you and your team'
      else if FnLabelSight then
        S := 'everybody (the enemies in the realistic mode only when they could see the grenade)'
      else
        S := 'everybody';
      if Length(FnFlashLabel) = 1 then
        Say(ID, 'A flash in the air has a ring (' + FnFlashLabel + ') around it, seen by ' + S + '.', FnTextColor)
      else
        Say(ID, 'The word over your grenade in the air is seen by ' + S + '.', FnTextColor);
    end;
end;

{ !rocket: the guided rockets left and how they are used (from the settings) }
{ [TeamKill] !tk: a player's own record; an admin names a player (/tk <player>); !tk 1-4 is the old
  script's /tk 1-4 (the victim's decision) }
procedure CmdTk(ID: Integer; Args: string);
var
  T, n: Integer;
  W: string;
  Adm: Boolean;
begin
  if not FfEnabled then
  begin
    Say(ID, 'The team kill guard is off on this server.', ColorBad);
    Exit;
  end;
  W := Trim(Args);
  if (ID >= 1) and (ID <= 32) then
    if (W = '1') or (W = '2') or (W = '3') or (W = '4') then
      if FfVoteBy[ID] > 0 then
      begin
        n := StrToIntDef(W, 0);
        if n = 1 then
          FfDecide(ID, TKV_FORGIVE)
        else if n = 2 then
          FfDecide(ID, TKV_PUNISH)
        else if n = 3 then
          FfDecide(ID, TKV_POINTS)
        else
          FfDecide(ID, TKV_NEXT);
        Exit;
      end;
  T := ID;
  Adm := ID < 1;
  if not Adm then
    Adm := PL[ID].IsAdmin;
  if W <> '' then
    if Adm then
    begin
      if not PickTargets(ID, TakeArg(Args), True, False, False) then
        Exit;
      T := TgtList[0];
    end;
  if (T < 1) or (T > 32) then
  begin
    Say(ID, 'Use: /tk <player>', ColorBad);
    Exit;
  end;
  Say(ID, FfRecord(T), FfInfoColor);
  if FfLastWhy[T] <> '' then
    Say(ID, 'Last: ' + FfLastWhy[T], FfInfoColor);
  if not FfActive then
    Say(ID, 'The guard is idle now: ' + FfIdleWhy + '.', FfInfoColor);
end;

procedure CmdTkDecide(ID, Choice: Integer);
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not FfEnabled then
    Exit;
  FfDecide(ID, Choice);
end;

{ /tklist: everybody with team kill points or team kills this map }
procedure CmdTkList(ID: Integer);
var
  i, n: Integer;
begin
  n := 0;
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if (FfPts[i] >= 0.05) or (FfMapKills[i] > 0) or (FfMapDmg[i] >= 1) then
      begin
        Say(ID, FfRecord(i), FfInfoColor);
        n := n + 1;
      end;
  if n = 0 then
    Say(ID, 'Nobody has team kill points or team kills now.', FfInfoColor);
  if BeOk then
    Say(ID, BE_TkInfo() + '; team hits ' + IntToStr(FfStatHits) + ', team kills ' + IntToStr(FfStatKills) + ', sprays ' +
      IntToStr(FfStatSprays) + ', penalties ' + IntToStr(FfStatPunished), FfInfoColor);
end;

{ /tkreset <player|all> [bans]: the points (and with "bans" the bans) go; the fire at the team is free }
procedure CmdTkReset(ID: Integer; Args: string);
var
  k, T: Integer;
  Rest: string;
  Bans: Boolean;
begin
  Rest := Args;
  if Trim(Rest) = '' then
  begin
    Say(ID, 'Use: /tkreset <player|all> [bans]', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, TakeArg(Rest), True, False, False) then
    Exit;
  Bans := LowerCase(Trim(Rest)) = 'bans';
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    FfPts[T] := 0;
    FfStep[T] := 0;
    FfShieldUntil[T] := 0;
    FfShieldNote[T] := False;
    FfNextRound[T] := False;
    if Bans then
    begin
      FfBans[T] := 0;
      FfBanMinute[T] := 0;
    end;
    FfDirty[T] := True;
    FfSave(T);
  end;
  if Bans then
    Say(ID, 'Team kill points and bans reset: ' + TgtDesc() + '.', ColorGood)
  else
    Say(ID, 'Team kill points reset: ' + TgtDesc() + '.', ColorGood);
end;

{ ================================ [Mines] ================================ }

procedure MnLog(Text: string);
begin
  if MnLogName = '' then
    Exit;
  if not BeOk then
    Exit;
  BE_Log(PChar(DataDir + MnLogName), PChar(FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + '  ' + Game.CurrentMap + '  ' +
    Text));
end;

{ a short word in the middle of his screen (BigLayer) }
procedure MnBig(ID: Integer; Text: string; Color: Longint);
begin
  if Text = '' then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  PL[ID].BigText(MnBigLayer, Text, MnBigTicks, Color, MnBigScale, MnBigX, MnBigY);
end;

procedure MnSay(ID: Integer; Text: string; Color: Longint);
begin
  if Text = '' then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if HumanOf[ID] then
    Say(ID, Text, Color);
end;

{ why a plant was refused: in the middle of the screen (a key) or in the console (a command) }
procedure MnRefuse(ID: Integer; ByKey: Boolean; Text: string);
begin
  if ByKey then
  begin
    if Game.TickCount - MnToldTick[ID] < 30 then
      Exit;
    MnToldTick[ID] := Game.TickCount;
    MnBig(ID, Text, ColorBad);
  end
  else
    Say(ID, Text, ColorBad);
end;

{ a short word over a mine at X, Y for ID only: a WorldText on Layer, WorkY px over it, gone by itself
  Ticks later (an empty word takes the last one away) }
procedure MnOver(ID, Layer: Integer; Text: string; X, Y: Single; Ticks: Integer);
var
  W: Single;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  if Text = '' then
  begin
    PL[ID].WorldText(Layer, ' ', 1, ColorGood, 0.01, 0, 0);
    Exit;
  end;
  if BeOk then
    W := BE_TextWidth(Text, MnWorkScale)
  else
    W := Length(Text) * MnWorkScale * WT_CHAR_WIDTH;
  PL[ID].WorldText(Layer, Text, Ticks, MnColor, MnWorkScale, X - W / 2, Y - MnWorkY);
end;

{ ticks as seconds for the texts: 2, 1.5 }
function MnSecs(Ticks: Integer): string;
begin
  if Ticks mod 60 = 0 then
    Result := IntToStr(Ticks div 60)
  else
    Result := FloatStr(Ticks / 60.0, 1);
end;

{ N more of a kind for ID, up to what he may carry; the number given }
function MnGive(ID, Kind, N: Integer; Why: string; Quiet: Boolean): Integer;
var
  Room: Integer;
begin
  Result := 0;
  if N <= 0 then
    Exit;
  if Kind = MN_CLAY then
  begin
    if not MnClay then
      Exit;
    Room := MnMaxC - MnHaveC[ID];
    if N > Room then
      N := Room;
    if N <= 0 then
      Exit;
    MnHaveC[ID] := MnHaveC[ID] + N;
  end
  else
  begin
    if not MnLand then
      Exit;
    Room := MnMaxM - MnHave[ID];
    if N > Room then
      N := Room;
    if N <= 0 then
      Exit;
    MnHave[ID] := MnHave[ID] + N;
  end;
  Result := N;
  HudMark(ID, False);
  if not Quiet then
    MnSay(ID, MnFill(MnEarnText, ID, Kind, 0, '', Why), MnColor);
end;

{ this map's flag bases and spawn points (the spawn points of the map: 0 everybody, 1-4 the teams, 5 and
  6 the flags of alpha and bravo) }
procedure MnMapScan();
var
  i, St: Integer;
begin
  for i := 1 to 4 do
    MnBaseOk[i] := False;
  MnSpCount := 0;
  for i := 1 to MAX_SPAWN_ID do
    if SP[i].Active then
    begin
      St := SP[i].Style;
      if (St = 5) or (St = 6) then
      begin
        MnBaseOk[St - 4] := True;
        MnBaseX[St - 4] := SP[i].X;
        MnBaseY[St - 4] := SP[i].Y;
      end
      else if (St >= 0) and (St <= 4) then
        if MnSpCount <= 255 then
        begin
          MnSpX[MnSpCount] := SP[i].X;
          MnSpY[MnSpCount] := SP[i].Y;
          MnSpTeam[MnSpCount] := St;
          MnSpCount := MnSpCount + 1;
        end;
    end;
end;

procedure MnReset(ID: Integer);
begin
  MnHave[ID] := 0;
  MnHaveC[ID] := 0;
  MnProgM[ID] := 0;
  MnProgC[ID] := 0;
  MnLastPlant[ID] := -1000000;
  MnKeyWasM[ID] := False;
  MnKeyWasC[ID] := False;
  MnWork[ID] := 0;
  MnWorkSent[ID] := 0;
  MnDrawnVer[ID] := -1;
  if MnDrawMore[ID] then
    MnMoreCount := MnMoreCount - 1;
  MnDrawMore[ID] := False;
  MnToldTick[ID] := -1000000;
end;

{ a player comes (or the script starts): nothing carried, nothing sent to him }
procedure MnSetup(ID: Integer);
begin
  MnReset(ID);
  if BeOk then
    BE_MineForget(ID);
end;

{ he leaves: his mines go with him }
procedure MnLeave(ID: Integer);
var
  n: Integer;
begin
  if BeOk then
  begin
    n := BE_MineRemoveOwner(ID);
    if n > 0 then
      MnLog(PL[ID].Name + ' left: his ' + IntToStr(n) + ' mines went');
    BE_MineForget(ID);
  end;
  MnReset(ID);
end;

{ another team: his planted ones go (they would change sides), he keeps what he carries }
procedure MnTeamChanged(ID: Integer);
var
  n: Integer;
begin
  if not BeOk then
    Exit;
  n := BE_MineRemoveOwner(ID);
  if n > 0 then
    if HumanOf[ID] then
      Say(ID, 'Your planted mines went with your team change.', MnColor);
  MnWork[ID] := 0;
end;

{ a new life: SpawnMines and SpawnClaymores at least }
procedure MnRespawn(ID: Integer);
begin
  if not MnActive then
    Exit;
  { F14: [Shop] ShopOnly - landmines (1) and claymores (2) each by their own bit }
  if not (ShActive and ((ShShopOnly and 1) <> 0)) then
    if MnSpawnM > MnHave[ID] then
      MnGive(ID, MN_LAND, MnSpawnM - MnHave[ID], 'a new life', True);
  if not (ShActive and ((ShShopOnly and 2) <> 0)) then
    if MnSpawnC > MnHaveC[ID] then
      MnGive(ID, MN_CLAY, MnSpawnC - MnHaveC[ID], 'a new life', True);
  MnWork[ID] := 0;
  HudMark(ID, False);
end;

{ a new map: the old map's mines are gone; KeepOnMapChange = 0: what everybody carried and his kills too }
procedure MnMapStart();
var
  i: Integer;
begin
  if BeOk then
    BE_MineClear();
  MnFuseCount := 0;
  for i := 1 to 255 do
    MnBulKind[i] := 0;
  for i := 1 to 32 do
  begin
    MnWork[i] := 0;
    MnDrawnVer[i] := -1;
    if not MnKeepMap then
    begin
      MnHave[i] := 0;
      MnHaveC[i] := 0;
      MnProgM[i] := 0;
      MnProgC[i] := 0;
    end;
  end;
  MnMapScan();
  MnRefresh();
  { the server respawned everybody before the new map started: the spawn mines of that life }
  if not MnKeepMap then
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if PL[i].Alive then
          MnRespawn(i);
end;

{ an enemy kill of K: his kills towards the next mine and claymore (MineKills = 0: not by a mine) }
procedure MnKillReward(K, Kind: Integer);
begin
  if not MnActive then
    Exit;
  if (K < 1) or (K > 32) then
    Exit;
  if not ActiveSlot[K] then
    Exit;
  if not (HumanOf[K] or MnBots) then
    Exit;
  if Kind > 0 then
    if not MnMineKills then
      Exit;
  { [Shop] ShopOnly: landmines (1) and claymores (2) only from the shop (F14: each its own) }
  if MnLand then
    if MnKillsM > 0 then
    if not (ShActive and ((ShShopOnly and 1) <> 0)) then
    begin
      MnProgM[K] := MnProgM[K] + 1;
      if MnProgM[K] >= MnKillsM then
      begin
        MnProgM[K] := 0;
        MnGive(K, MN_LAND, 1, IntToStr(MnKillsM) + ' kills', False);
      end;
    end;
  if MnClay then
    if MnKillsC > 0 then
    if not (ShActive and ((ShShopOnly and 2) <> 0)) then
    begin
      MnProgC[K] := MnProgC[K] + 1;
      if MnProgC[K] >= MnKillsC then
      begin
        MnProgC[K] := 0;
        MnGive(K, MN_CLAY, 1, IntToStr(MnKillsC) + ' kills', False);
      end;
    end;
end;

{ a kill by a mine or a claymore: the owner is told in the console, the victim in the middle of his
  screen (what got him) }
procedure MnKillTell(K, V, Kind: Integer);
begin
  MnStatKills := MnStatKills + 1;
  if K <> V then
    MnSay(K, MnFill(MnKillText, K, Kind, V, '', ''), MnColor);
  MnBig(V, MnFill(MnVictimText, V, Kind, K, '', ''), ColorBad);
  MnLog(PL[K].Name + '''s ' + MnKindName(Kind) + ' killed ' + PL[V].Name);
end;

{ a capture: CaptureMines and CaptureClaymores (not without an opponent) }
procedure MnCapture(ID: Integer);
begin
  if not MnActive then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not (HumanOf[ID] or MnBots) then
    Exit;
  if not Opposed(ID) then
    Exit;
  if not (ShActive and ((ShShopOnly and 1) <> 0)) then
    MnGive(ID, MN_LAND, MnCapM, 'the capture', False);
  if not (ShActive and ((ShShopOnly and 2) <> 0)) then
    MnGive(ID, MN_CLAY, MnCapC, 'the capture', False);
end;

{ an enemy spawn point within SpawnDistance of X, Y with no wall between (in the modes without teams every
  spawn point): a wall between keeps its soldiers off the mine }
function MnSpawnNear(X, Y: Single; Team: Integer): Boolean;
var
  k: Integer;
begin
  Result := False;
  if MnSpawnDist <= 0 then
    Exit;
  for k := 0 to MnSpCount - 1 do
    if (Team = 0) or (MnSpTeam[k] = 0) or (MnSpTeam[k] <> Team) then
      if (MnSpX[k] - X) * (MnSpX[k] - X) + (MnSpY[k] - Y) * (MnSpY[k] - Y) < MnSpawnDist * MnSpawnDist then
        if not Ray(X, Y - 12, MnSpX[k], MnSpY[k] - 12, False) then
        begin
          Result := True;
          Exit;
        end;
end;

{ a sound at X, Y for the players within R }
procedure MnSoundAt(Snd: string; X, Y, R: Single);
var
  j: Integer;
begin
  if Snd = '' then
    Exit;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] then
        if (Abs(PL[j].X - X) <= R) and (Abs(PL[j].Y - Y) <= R) then
          PL[j].PlaySound(Snd, X, Y);
end;

{ ID plants a mine of Kind at his feet (a claymore looks where he looks); True when it is in the ground }
function MnPlantTry(ID, Kind: Integer; ByKey: Boolean): Boolean;
var
  P: TActivePlayer;
  Tick, Mid, Tm, n, Most, K2, O2, T2: Integer;
  X, Y, D, MX, MY, FX2, FY2: Single;
  KN: string;
begin
  Result := False;
  if (ID < 1) or (ID > 32) then
    Exit;
  P := PL[ID];
  Tick := Game.TickCount;
  KN := MnKindName(Kind);
  if not MnActive then
  begin
    MnRefuse(ID, ByKey, 'Mines are off here (' + MnIdleWhy + ').');
    Exit;
  end;
  if DwDown[ID] or (BdShockUntil[ID] > 0) then
  begin
    MnRefuse(ID, ByKey, 'Not while you are down.');
    Exit;
  end;
  if Kind = MN_CLAY then
  begin
    if not MnClay then
    begin
      MnRefuse(ID, ByKey, 'Claymores are switched off on this server.');
      Exit;
    end;
    n := MnHaveC[ID];
  end
  else
  begin
    if not MnLand then
    begin
      MnRefuse(ID, ByKey, 'Mines are switched off on this server.');
      Exit;
    end;
    n := MnHave[ID];
  end;
  if n <= 0 then
  begin
    if Kind = MN_CLAY then
      MnRefuse(ID, ByKey, MnFill('You have no {kind}s - {nextclaymore} more enemy kills bring one.', ID, Kind, 0, '', ''))
    else
      MnRefuse(ID, ByKey, MnFill('You have no {kind}s - {nextmine} more enemy kills bring one.', ID, Kind, 0, '', ''));
    Exit;
  end;
  if not P.Alive then
  begin
    MnRefuse(ID, ByKey, 'Not while dead.');
    Exit;
  end;
  if not P.OnGround then
  begin
    MnRefuse(ID, ByKey, 'Only on the ground.');
    Exit;
  end;
  if Tick - MnLastPlant[ID] < MnPlantTicks then
  begin
    if not ByKey then
      Say(ID, 'One at a time - wait a moment.', ColorBad);
    Exit;
  end;
  if Kind = MN_CLAY then
    Most := MnMaxPlantC
  else
    Most := MnMaxPlantM;
  if BE_MineCount(ID, Kind) >= Most then
  begin
    MnRefuse(ID, ByKey, 'You have ' + IntToStr(Most) + ' ' + KN + 's in the ground already (the most).');
    Exit;
  end;
  if BE_MineCount(0, 0) >= MnMaxOnMap then
  begin
    MnRefuse(ID, ByKey, 'The map holds the most mines already.');
    Exit;
  end;
  X := P.X;
  Y := P.Y;
  Tm := TeamOf[ID];
  if (Tm < 0) or (Tm > 4) then
    Tm := 0;
  if MnFlagDist > 0 then
    if (Tm >= 1) and (Tm <= 4) then
      if MnBaseOk[Tm] then
        if (MnBaseX[Tm] - X) * (MnBaseX[Tm] - X) + (MnBaseY[Tm] - Y) * (MnBaseY[Tm] - Y) < MnFlagDist * MnFlagDist then
          if not Ray(X, Y - 12, MnBaseX[Tm], MnBaseY[Tm] - 12, False) then
          begin
            MnRefuse(ID, ByKey, 'Too close to your flag.');
            Exit;
          end;
  if MnSpawnNear(X, Y, Tm) then
  begin
    MnRefuse(ID, ByKey, 'Too close to an enemy spawn point.');
    Exit;
  end;
  if MnSpacing > 0 then
    if BE_MineNearest(X, Y, D) > 0 then
      if D < MnSpacing then
      begin
        MnRefuse(ID, ByKey, 'Too close to another mine.');
        Exit;
      end;
  if not TeamGame() then
    Tm := 0;
  Mid := BE_MinePlant(Kind, ID, Tm, X, Y, P.MouseAimX, P.MouseAimY, Tick);
  if Mid <= 0 then
  begin
    MnRefuse(ID, ByKey, 'No room for another mine.');
    Exit;
  end;
  if Kind = MN_CLAY then
    MnHaveC[ID] := MnHaveC[ID] - 1
  else
    MnHave[ID] := MnHave[ID] - 1;
  MnLastPlant[ID] := Tick;
  MnStatPlanted := MnStatPlanted + 1;
  HudMark(ID, False);
  { over it for him: armed in ... (then Armed - the text stays full until then) }
  if MnArmTicks > 0 then
    if BE_MineGet(Mid, K2, O2, T2, MX, MY, FX2, FY2) = 1 then
      MnOver(ID, MnPlantLayer, MnFill(MnPlantText, ID, Kind, 0, MnSecs(MnArmTicks), ''), MX, MY, MnArmTicks + 80);
  MnSoundAt(MnPlantSound, X, Y, 300);
  MnLog(P.Name + ' planted a ' + KN + ' at ' + IntToStr(Round(X)) + ',' + IntToStr(Round(Y)));
  Result := True;
end;

{ a bullet of a blast, remembered (the kill's reward and messages) }
procedure MnBullet(X, Y, VX, VY, HitM: Single; Style, Own, Kind, Tick: Integer);
var
  B: Integer;
begin
  B := ScriptBullet(X, Y, VX, VY, HitM, Style, PL[Own]);
  if (B >= 1) and (B <= 255) then
  begin
    MnBulTick[B] := Tick;
    MnBulOwner[B] := Own;
    MnBulKind[B] := Kind;
  end;
end;

{ mine Id goes off (How: 1 set off by By, 2 shot by By, 3 ran out, 4 a chain, 5 By's dead body on it). A landmine: Blasts M79
  explosions - the first one into the soldier who stepped on it (it goes off on him whatever the floor),
  the others in the ground where the ground stops bullets (a floor only players stand on lets them
  through: then into him too) - and Shrapnel shells up; a claymore: Pellets shells in its cone,
  BackPellets weaker ones around and behind it, Blast M79 explosions in the ground at it (where the
  ground stops bullets) and Flames harmless flames fanned out in its cone, the flash of the blast. The
  bullets are the owner's (a shot claymore's are the shooter's with ShooterKills) }
procedure MnBlast(Id, By, How, Tick: Integer);
var
  Kind, O, Team, Own, j, n, Room, Front, Back, Clus, Fl: Integer;
  X, Y, FX, FY, A0, A, Spd, T, Sh, G: Single;
  Vic: Boolean;
begin
  if not BeOk then
    Exit;
  if BE_MineGet(Id, Kind, O, Team, X, Y, FX, FY) <> 1 then
    Exit;
  G := BE_MineGround(Id);
  Vic := False;
  if How = 1 then
    if (By >= 1) and (By <= 32) then
      if ActiveSlot[By] then
        if PL[By].Alive then
          if (Abs(PL[By].X - X) <= 40) and (Abs(PL[By].Y - Y) <= 40) then
            Vic := True;
  if MnChainR > 0 then
    BE_MineChain(Id, MnChainR, Tick + MnChainTicks);
  BE_MineRemove(Id);
  Own := O;
  if How = 2 then
    if MnShotCredit then
      if (By >= 1) and (By <= 32) then
        if ActiveSlot[By] then
          Own := By;
  if (Own < 1) or (Own > 32) then
    Exit;
  if not ActiveSlot[Own] then
    Exit;
  MnStatBlasts := MnStatBlasts + 1;
  AcSkip[Own] := Tick;
  Fl := 0;
  if Kind = MN_CLAY then
  begin
    Front := MnPellets;
    Back := MnBackPellets;
    Clus := MnClusters;
    Fl := MnFlames;
    if G < 0 then
      Clus := 0;
  end
  else
  begin
    Front := MnShrap;
    Back := 0;
    Clus := MnBlasts;
  end;
  { the bullets there is room for (the blasts first, then the shells, the flames last) }
  n := Front + Back + Clus + Fl;
  Room := BulletsFree(n + BULLET_MARGIN) - BULLET_MARGIN;
  if Room < n then
  begin
    if Room < Clus then
      Clus := Room;
    Room := Room - Clus;
    if Front > Room then
      Front := Room;
    Room := Room - Front;
    if Back > Room then
      Back := Room;
    Room := Room - Back;
    if Fl > Room then
      Fl := Room;
  end;
  if Kind = MN_CLAY then
  begin
    { where it looks (it never looks straight up or down: FX is never 0) }
    A0 := ArcTan(FY / FX);
    if FX < 0 then
      A0 := A0 + 3.14159265;
    Sh := MnSpread * 3.14159265 / 180;
    for j := 0 to Clus - 1 do
      MnBullet(X + (j * 2 - (Clus - 1)) * 6, Y + G - 4, 0, 5, 1, BS_M79, Own, Kind, Tick);
    { the flash of the blast: flames that hurt nobody, fanned out in its cone }
    for j := 0 to Fl - 1 do
    begin
      A := A0 + (((j + 0.5) / Fl) * 2 - 1) * Sh;
      Spd := 2.5 + Random(0, 30) * 0.1;
      ScriptBullet(X + FX * 6, Y - 6 + FY * 6, Cos(A) * Spd, Sin(A) * Spd, 0, BS_FLAME, PL[Own]);
    end;
    for j := 0 to Front - 1 do
    begin
      { spread evenly over the cone, each within its own share of it }
      T := ((j + Random(20, 81) * 0.01) / Front) * 2 - 1;
      A := A0 + T * Sh;
      Spd := MnPelletSpeed * (0.88 + Random(0, 25) * 0.01);
      MnBullet(X + FX * 5, Y - 6 + FY * 5, Cos(A) * Spd, Sin(A) * Spd, 1.22 * MnPelletPower, 3, Own, Kind, Tick);
    end;
    for j := 0 to Back - 1 do
    begin
      A := A0 + 1.57079633 + ((j + Random(20, 81) * 0.01) / Back) * 3.14159265;
      Spd := MnBackSpeed * (0.8 + Random(0, 40) * 0.01);
      MnBullet(X - FX * 3, Y - 6, Cos(A) * Spd, Sin(A) * Spd, 1.22 * MnBackPower, 3, Own, Kind, Tick);
    end;
    MnSoundAt(MnBlastSound, X, Y, 900);
  end
  else
  begin
    for j := 0 to Clus - 1 do
    begin
      if Clus = 1 then
        T := 0
      else
        T := (j * 2.0 / (Clus - 1) - 1) * MnBlastSpread;
      if Vic and ((j = 0) or (G < 0)) then
        MnBullet(PL[By].X + T * 0.3, PL[By].Y - 6, 0, 3, 1, BS_M79, Own, Kind, Tick)
      else if G >= 0 then
        MnBullet(X + T, Y + G - 4, 0, 5, 1, BS_M79, Own, Kind, Tick);
    end;
    Sh := MnShrapAngle * 3.14159265 / 180;
    for j := 0 to Front - 1 do
    begin
      T := ((j + Random(20, 81) * 0.01) / Front) * 2 - 1;
      A := -1.57079633 + T * Sh;
      Spd := MnShrapSpeed * (0.85 + Random(0, 30) * 0.01);
      MnBullet(X + Cos(A) * 3, Y - 3 + Sin(A) * 3, Cos(A) * Spd, Sin(A) * Spd, 1.22 * MnShrapPower, 3, Own, Kind, Tick);
    end;
  end;
  if How = 2 then
    MnLog(PL[By].Name + ' shot ' + PL[O].Name + '''s ' + MnKindName(Kind))
  else if How = 3 then
    MnLog(PL[O].Name + '''s ' + MnKindName(Kind) + ' ran out and went off')
  else if How = 4 then
    MnLog(PL[O].Name + '''s ' + MnKindName(Kind) + ' went off with the one next to it')
  else if How = 5 then
    MnLog(PL[By].Name + '''s body set off ' + PL[O].Name + '''s ' + MnKindName(Kind))
  else if (By >= 1) and (By <= 32) then
    MnLog(PL[By].Name + ' set off ' + PL[O].Name + '''s ' + MnKindName(Kind));
end;

{ a fuse that burns (FuseSeconds): the mine goes off at At }
procedure MnFuseAdd(Id, By, At: Integer);
var
  Kind, O, Team: Integer;
  X, Y, FX, FY: Single;
begin
  if MnFuseCount >= 64 then
    Exit;
  if not BeOk then
    Exit;
  if BE_MineGet(Id, Kind, O, Team, X, Y, FX, FY) <> 1 then
    Exit;
  MnFuseId[MnFuseCount] := Id;
  MnFuseBy[MnFuseCount] := By;
  MnFuseAt[MnFuseCount] := At;
  MnFuseO[MnFuseCount] := O;
  MnFuseX[MnFuseCount] := X;
  MnFuseY[MnFuseCount] := Y;
  MnFuseCount := MnFuseCount + 1;
end;

{ E15: the mine in the fuse's slot is still the one it was lit on }
function MnFuseSame(k: Integer): Boolean;
var
  Kind, O, Team: Integer;
  X, Y, FX, FY: Single;
begin
  Result := False;
  if BE_MineGet(MnFuseId[k], Kind, O, Team, X, Y, FX, FY) = 1 then
    if O = MnFuseO[k] then
      if (Abs(X - MnFuseX[k]) < 20) and (Abs(Y - MnFuseY[k]) < 20) then
        Result := True;
end;

procedure MnFuseTick(Tick: Integer);
var
  k, j: Integer;
begin
  k := 0;
  while k < MnFuseCount do
  begin
    if Tick >= MnFuseAt[k] then
    begin
      if MnFuseSame(k) then
        MnBlast(MnFuseId[k], MnFuseBy[k], 1, Tick);
      for j := k to MnFuseCount - 2 do
      begin
        MnFuseId[j] := MnFuseId[j + 1];
        MnFuseBy[j] := MnFuseBy[j + 1];
        MnFuseAt[j] := MnFuseAt[j + 1];
        MnFuseO[j] := MnFuseO[j + 1];
        MnFuseX[j] := MnFuseX[j + 1];
        MnFuseY[j] := MnFuseY[j + 1];
      end;
      MnFuseCount := MnFuseCount - 1;
    end
    else
      k := k + 1;
  end;
end;

{ a word of the work on a mine, over the mine, for him only; a WorldText goes by itself Ticks later }
procedure MnWorkText(ID: Integer; Text: string; Ticks: Integer);
begin
  if Text = '' then
    Exit;
  MnOver(ID, MnWorkLayer, Text, MnWorkMX[ID], MnWorkMY[ID], Ticks);
end;

{ the progress of taking a mine apart (or picking it up), every 10 ticks; not sent again, it goes }
procedure MnWorkShow(ID, Tick: Integer);
var
  Pct: Integer;
begin
  if MnWork[ID] = 0 then
    Exit;
  if Tick - MnWorkSent[ID] < 10 then
    Exit;
  MnWorkSent[ID] := Tick;
  Pct := 0;
  if MnWorkNeed[ID] > 0 then
    Pct := (Tick - MnWorkStart[ID]) * 100 div MnWorkNeed[ID];
  if Pct > 99 then
    Pct := 99;
  if Pct < 0 then
    Pct := 0;
  if MnWorkOwn[ID] then
    MnWorkText(ID, MnFill(MnPickingText, ID, MnWorkKind[ID], 0, IntToStr(Pct), ''), 25)
  else
    MnWorkText(ID, MnFill(MnDefusingText, ID, MnWorkKind[ID], 0, IntToStr(Pct), ''), 25);
end;

{ an event of the library: Kind, the mine, a player, Q }
procedure MnEvent(Kind, Id, P, Q, Tick: Integer);
var
  K, O, Team, n: Integer;
  X, Y, FX, FY: Single;
  S: string;
begin
  { his work stopped - the mine may be gone already (a blast, a shot) }
  if Kind = MNE_WORK_STOP then
  begin
    if (P >= 1) and (P <= 32) then
      if MnWork[P] = Id then
      begin
        MnWork[P] := 0;
        if ActiveSlot[P] then
          if HumanOf[P] then
            PL[P].WorldText(MnWorkLayer, ' ', 1, ColorGood, 0.01, 0, 0);
      end;
    Exit;
  end;
  if BE_MineGet(Id, K, O, Team, X, Y, FX, FY) <> 1 then
    Exit;
  if Kind = MNE_ARMED then
  begin
    if HumanOf[O] then
      if ActiveSlot[O] then
      begin
        if MnArmSound <> '' then
          PL[O].PlaySound(MnArmSound, X, Y);
        MnOver(O, MnPlantLayer, MnFill(MnArmedText, O, K, 0, '', ''), X, Y, MnWorkTicks);
      end;
  end
  else if Kind = MNE_TRIGGER then
  begin
    if (P >= 1) and (P <= 32) and (MnFuseTicks > 0) then
    begin
      MnSoundAt(MnClickSound, X, Y, 200);
      MnFuseAdd(Id, P, Tick + MnFuseTicks);
    end
    else if Q = 1 then
      MnBlast(Id, P, 4, Tick)
    else if Q = 2 then
      MnBlast(Id, P, 5, Tick)
    else
      MnBlast(Id, P, 1, Tick);
  end
  else if Kind = MNE_SHOT then
  begin
    MnSay(O, MnFill(MnShotText, O, K, P, '', ''), MnColor);
    MnBlast(Id, P, 2, Tick);
  end
  else if Kind = MNE_EXPIRE then
  begin
    if MnExpireBlast then
      MnBlast(Id, 0, 3, Tick)
    else
    begin
      BE_MineRemove(Id);
      MnSay(O, MnFill(MnExpireText, O, K, 0, '', ''), MnColor);
    end;
  end
  else if Kind = MNE_SPOTTED then
  begin
    MnBig(P, MnFill(MnSpottedText, P, K, O, FloatStr(MnDefuseTicks / 60.0, 1), ''), MnColor);
    MnLog(PL[P].Name + ' found ' + PL[O].Name + '''s ' + MnKindName(K));
  end
  else if Kind = MNE_WORK then
  begin
    if (P >= 1) and (P <= 32) then
    begin
      MnWork[P] := Id;
      MnWorkStart[P] := Tick;
      MnWorkNeed[P] := Q;
      MnWorkKind[P] := K;
      MnWorkOwn[P] := (P = O);
      MnWorkMX[P] := X;
      MnWorkMY[P] := Y;
      MnWorkSent[P] := 0;
      MnWorkShow(P, Tick);
    end;
  end
  else if Kind = MNE_DEFUSED then
  begin
    BE_MineRemove(Id);
    if (P >= 1) and (P <= 32) then
    begin
      MnWork[P] := 0;
      MnStatDefused := MnStatDefused + 1;
      S := '';
      n := 0;
      if MnDefuseTake then
        n := MnGive(P, K, 1, 'taken apart', True);
      if n > 0 then
        S := ' - yours';
      MnWorkMX[P] := X;
      MnWorkMY[P] := Y;
      MnWorkText(P, MnFill(MnDefusedText, P, K, O, '', S), MnWorkTicks);
      if ActiveSlot[P] then
        if HumanOf[P] then
          if MnDefuseSound <> '' then
            PL[P].PlaySound(MnDefuseSound, X, Y);
      MnSay(O, MnFill(MnOwnerDefusedText, O, K, P, '', ''), MnColor);
      MnLog(PL[P].Name + ' took ' + PL[O].Name + '''s ' + MnKindName(K) + ' apart');
    end;
  end
  else if Kind = MNE_PICKED then
  begin
    BE_MineRemove(Id);
    if (P >= 1) and (P <= 32) then
    begin
      MnWork[P] := 0;
      MnGive(P, K, 1, 'picked up', True);
      MnWorkMX[P] := X;
      MnWorkMY[P] := Y;
      MnWorkText(P, MnFill(MnPickedText, P, K, 0, '', ''), MnWorkTicks);
      if ActiveSlot[P] then
        if HumanOf[P] then
          if MnDefuseSound <> '' then
            PL[P].PlaySound(MnDefuseSound, X, Y);
    end;
  end;
end;

{ the keys: ClaymoreKeys (the more exact ones, lying) plant a claymore, MineKeys a landmine - the other
  kind when he has none of that one; a new press only, never while he carries a flag (the keys throw it).
  When the landmine's keys are a part of the claymore's, they are read first: not held, neither is (one
  key read a tick) }
procedure MnKeys(i: Integer);
var
  P: TActivePlayer;
  DownC, DownM: Boolean;
  Kind: Integer;
begin
  P := PL[i];
  DownC := False;
  DownM := False;
  if MnKeysSub then
  begin
    DownM := KeysHeld(P, MnKeysM);
    if DownM then
    begin
      DownC := KeysHeld(P, MnKeysC);
      if DownC then
        DownM := False;
    end;
  end
  else
  begin
    if MnKeysC <> 0 then
      DownC := KeysHeld(P, MnKeysC);
    if not DownC then
      if MnKeysM <> 0 then
        DownM := KeysHeld(P, MnKeysM);
  end;
  { [Insurgents] KeysOverMines: his keys set off the vest (the claymore's stay his) }
  if InsKeysOverMines and InsActive then
    if InsVest[i] >= 0 then
      if (InsKeyMask and MnKeysM) <> 0 then
        DownM := False;
  Kind := 0;
  if DownC then
  begin
    if not MnKeyWasC[i] then
    begin
      Kind := MN_CLAY;
      if MnHaveC[i] <= 0 then
        if MnHave[i] > 0 then
          Kind := MN_LAND;
    end;
  end
  else if DownM then
    if not MnKeyWasM[i] then
    begin
      Kind := MN_LAND;
      if MnHave[i] <= 0 then
        if MnHaveC[i] > 0 then
          Kind := MN_CLAY;
    end;
  MnKeyWasC[i] := DownC;
  MnKeyWasM[i] := DownM;
  if Kind = 0 then
    Exit;
  if P.Flagger then
    Exit;
  MnPlantTry(i, Kind, True);
end;

{ a bot with mines plants one now and then (BotChance a second), on the ground, not within 300 px of his
  team's spawn points and flag (nobody of the enemies comes there) }
procedure MnBotTick(i: Integer);
var
  P: TActivePlayer;
  k, Tm: Integer;
  X, Y: Single;
begin
  P := PL[i];
  if not P.Alive then
    Exit;
  if Random(0, 1000) >= Round(MnBotChance * 1000) then
    Exit;
  if P.Flagger then
    Exit;
  X := P.X;
  Y := P.Y;
  Tm := TeamOf[i];
  if (Tm >= 1) and (Tm <= 4) then
  begin
    if MnBaseOk[Tm] then
      if (MnBaseX[Tm] - X) * (MnBaseX[Tm] - X) + (MnBaseY[Tm] - Y) * (MnBaseY[Tm] - Y) < 90000 then
        Exit;
    for k := 0 to MnSpCount - 1 do
      if MnSpTeam[k] = Tm then
        if (MnSpX[k] - X) * (MnSpX[k] - X) + (MnSpY[k] - Y) * (MnSpY[k] - Y) < 90000 then
          Exit;
  end;
  if MnHave[i] > 0 then
    MnPlantTry(i, MN_LAND, True)
  else if MnHaveC[i] > 0 then
    MnPlantTry(i, MN_CLAY, True);
end;

{ the marks of player i (what changed since the last time) }
procedure MnDrawOne(i, Tick, V: Integer);
var
  n, More: Integer;
begin
  MnDrawnVer[i] := V;
  if not ActiveSlot[i] then
    Exit;
  if not (HumanOf[i] or DebugBots) then
    Exit;
  More := 0;
  n := BE_MineDraw(i, Tick, 12, PL[i].X, PL[i].Y, More);
  if n > 0 then
    OpsSend(i, n);
  if More = 1 then
  begin
    if not MnDrawMore[i] then
      MnMoreCount := MnMoreCount + 1;
    MnDrawMore[i] := True;
  end
  else if MnDrawMore[i] then
  begin
    MnDrawMore[i] := False;
    MnMoreCount := MnMoreCount - 1;
  end;
end;

{ the marks: to every player when the mines changed (or some are left from the last time), and to one or
  two players a tick in turn - every DrawTicks each (he moves; realistic sight) - while there are any }
procedure MnDrawAll(Tick: Integer);
var
  i, V, D: Integer;
begin
  V := BE_MineVersion();
  if (V <> MnAllVer) or (MnMoreCount > 0) then
  begin
    MnAllVer := V;
    MnAny := BE_MineCount(0, 0) > 0;
    { a mine the enemies see only with their eyes on it: its marks come and go as they move }
    MnLosAny := False;
    if MnSightFast then
    begin
      if MnClayAll then
        if BE_MineCount(0, MN_CLAY) > 0 then
          MnLosAny := True;
      if MnLandAll then
        if BE_MineCount(0, MN_LAND) > 0 then
          MnLosAny := True;
    end;
    for i := 1 to TopSlot do
      if (MnDrawnVer[i] <> V) or MnDrawMore[i] then
        MnDrawOne(i, Tick, V);
    Exit;
  end;
  if not MnAny then
    Exit;
  { with the sight rule a mark comes and goes as the walls hide it: each player every 10 ticks }
  D := MnDrawTicks;
  if MnLosAny then
    D := 10;
  i := Tick mod D + 1;
  while i <= TopSlot do
  begin
    MnDrawOne(i, Tick, V);
    i := i + D;
  end;
end;

{ the tick of [Mines]: the soldiers the library does not know, its events, the fuses, the keys, the bots,
  the marks, the progress texts }
procedure MnTickRun(Tick: Integer);
var
  i, n, k, M, Kind, Id, P, Q: Integer;
begin
  if not MnActive then
  begin
    { switched off: the marks go }
    if MnHideDue then
    begin
      MnHideDue := False;
      if BeOk then
        for i := 1 to TopSlot do
          if ActiveSlot[i] then
          begin
            n := BE_MineHide(i, 64);
            if n > 0 then
              OpsSend(i, n);
          end;
      HudMarkAll(False);
    end;
    Exit;
  end;
  if BE_MineCount(0, 0) > 0 then
  begin
    { the crouch and prone keys of the soldiers near a mine (finding, taking apart, picking up) }
    M := BE_MineNear();
    if M <> 0 then
      for i := 1 to TopSlot do
        if (M and SlotBit[i]) <> 0 then
          if ActiveSlot[i] then
            BE_MineLow(i, BoolInt(PL[i].KeyCrouch or PL[i].IsProne));
    M := BE_MineWants();
    if M <> 0 then
      for i := 1 to TopSlot do
        if (M and SlotBit[i]) <> 0 then
          if ActiveSlot[i] then
            if PL[i].Alive then
              BE_MinePos(i, PL[i].X, PL[i].Y, BoolInt(PL[i].KeyCrouch or PL[i].IsProne));
    n := BE_MineTick(Tick);
    for k := 1 to n do
      if BE_MineNext(Kind, Id, P, Q) = 1 then
        MnEvent(Kind, Id, P, Q, Tick);
  end;
  if MnFuseCount > 0 then
    MnFuseTick(Tick);
  { the keys of the players who carry some }
  for i := 1 to TopSlot do
    if MnHave[i] + MnHaveC[i] > 0 then
      if HumanOf[i] then
        MnKeys(i);
  { a bot a tick in turn: each once a second }
  if MnBots then
  begin
    i := Tick mod 60 + 1;
    if i <= TopSlot then
      if ActiveSlot[i] then
        if not HumanOf[i] then
          if MnHave[i] + MnHaveC[i] > 0 then
            MnBotTick(i);
  end;
  { the progress of the work on a mine }
  if Tick mod 10 = 0 then
    for i := 1 to TopSlot do
      if MnWork[i] <> 0 then
        MnWorkShow(i, Tick);
  MnDrawAll(Tick);
end;

{ ---------------- [Mines] commands ---------------- }

procedure CmdMinePlant(ID, Kind: Integer);
begin
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'Mines are for players in the game.', ColorBad);
    Exit;
  end;
  MnPlantTry(ID, Kind, False);
end;

{ !mines: what he carries, his kills towards the next ones, how to plant, what the mines do }
procedure CmdMineInfo(ID: Integer);
var
  S: string;
begin
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'Mines are for players in the game (/minelist lists them).', ColorBad);
    Exit;
  end;
  if not MnActive then
  begin
    Say(ID, 'Mines are off here (' + MnIdleWhy + ').', ColorBad);
    Exit;
  end;
  S := 'You carry';
  if MnLand then
    S := S + ' ' + IntToStr(MnHave[ID]) + ' of ' + IntToStr(MnMaxM) + ' ' + MnNameM + 's';
  if MnClay then
  begin
    if MnLand then
      S := S + ' and';
    S := S + ' ' + IntToStr(MnHaveC[ID]) + ' of ' + IntToStr(MnMaxC) + ' ' + MnNameC + 's';
  end;
  S := S + '; in the ground ' + IntToStr(BE_MineCount(ID, 0)) + '.';
  Say(ID, S, MnColor);
  S := '';
  if MnLand then
    if MnKillsM > 0 then
      S := 'A ' + MnNameM + ' every ' + IntToStr(MnKillsM) + ' enemy kills (' + IntToStr(MnKillsM - MnProgM[ID]) + ' more)';
  if MnClay then
    if MnKillsC > 0 then
    begin
      if S <> '' then
        S := S + ', a '
      else
        S := 'A ';
      S := S + MnNameC + ' every ' + IntToStr(MnKillsC) + ' (' + IntToStr(MnKillsC - MnProgC[ID]) + ' more)';
    end;
  if S <> '' then
  begin
    if MnStreak then
      S := S + ' - in one life';
    if (MnCapM > 0) or (MnCapC > 0) then
      S := S + '; a capture brings some too';
    Say(ID, S + '.', MnColor);
  end;
  if MnLand then
  begin
    S := 'Plant a ' + MnNameM + ': !' + MnCmdM;
    if MnKeysM <> 0 then
      S := S + ' or ' + MnKeysTextM;
    Say(ID, S + ' - on the ground, it is armed in ' + FloatStr(MnArmTicks / 60.0, 1) + ' s; the enemies do not see ' +
      'it, it goes off under the first one who steps on it (jump over one you know about).', MnColor);
  end;
  if MnClay then
  begin
    S := 'Plant a ' + MnNameC + ': !' + MnCmdC;
    if MnKeysC <> 0 then
      S := S + ' or ' + MnKeysTextC;
    Say(ID, S + ' - it looks where you look; its wire along the ground sets it off and its shells fly that way. ' +
      'Everybody sees it; an enemy bullet sets it off.', MnColor);
  end;
  if MnDefuseTicks > 0 then
    Say(ID, 'Crouch or lie near an enemy mine to find it, stay low next to it for ' +
      FloatStr(MnDefuseTicks / 60.0, 1) + ' s to take it apart (not on it!); yours you pick up the same way.', MnColor);
end;

{ /minelist: every mine on the map with its owner and place }
procedure CmdMineList(ID: Integer);
var
  i, n, K, O, Team: Integer;
  X, Y, FX, FY: Single;
  S: string;
begin
  if not BeOk then
  begin
    Say(ID, 'Mines need the script''s library, which is not running.', ColorBad);
    Exit;
  end;
  if not MnEnabled then
    Say(ID, 'Mines are switched off ([Mines] Enabled = 0).', ColorBad)
  else if not MnActive then
    Say(ID, 'Mines are idle: ' + MnIdleWhy + '.', ColorBad);
  n := 0;
  for i := 1 to 64 do
    if BE_MineGet(i, K, O, Team, X, Y, FX, FY) = 1 then
    begin
      S := MnKindName(K) + ' of ' + PL[O].Name + ' at ' + IntToStr(Round(X)) + ',' + IntToStr(Round(Y));
      if K = MN_CLAY then
      begin
        if FX >= 0 then
          S := S + ', looking right'
        else
          S := S + ', looking left';
      end;
      Say(ID, S, MnColor);
      n := n + 1;
    end;
  Say(ID, IntToStr(n) + ' on the map; ' + BE_MineInfo(), MnColor);
end;

{ /mineclear <player|all>: the mines in the ground go }
procedure CmdMineClear(ID: Integer; Args: string);
var
  k, n: Integer;
begin
  if not BeOk then
  begin
    Say(ID, 'Mines need the script''s library, which is not running.', ColorBad);
    Exit;
  end;
  if LowerCase(Trim(Args)) = 'all' then
  begin
    n := BE_MineCount(0, 0);
    BE_MineClear();
    MnFuseCount := 0;
    for k := 1 to 32 do
      MnWork[k] := 0;
    Say(ID, 'All mines went (' + IntToStr(n) + ').', ColorGood);
    Exit;
  end;
  if Trim(Args) = '' then
  begin
    Say(ID, 'Use: /mineclear <player|all>', ColorBad);
    Exit;
  end;
  if not PickTargets(ID, Args, True, False, False) then
    Exit;
  n := 0;
  for k := 0 to TgtCount - 1 do
    n := n + BE_MineRemoveOwner(TgtList[k]);
  Say(ID, 'The mines of ' + TgtDesc() + ' went (' + IntToStr(n) + ').', ColorGood);
end;

{ /givemines <player|all|team> [count] [mines|claymores] (or two numbers: mines, claymores): more to carry,
  one of each without numbers }
procedure CmdMineGive(ID: Integer; Args: string);
var
  k, M, C, T, N1, N2, V, Kind: Integer;
  Who, Rest, W: string;
begin
  if not MnActive then
  begin
    Say(ID, 'Mines are off here (' + MnIdleWhy + ').', ColorBad);
    Exit;
  end;
  Rest := Args;
  Who := TakeArg(Rest);
  if Who = '' then
  begin
    Say(ID, 'Use: /givemines <player|all|team> [count] [mines|claymores] (or: [mines] [claymores])', ColorBad);
    Exit;
  end;
  N1 := -1;
  N2 := -1;
  Kind := 0;
  W := LowerCase(TakeArg(Rest));
  while W <> '' do
  begin
    V := StrToIntDef(W, -1);
    if V >= 0 then
    begin
      if N1 < 0 then
        N1 := V
      else if N2 < 0 then
        N2 := V;
    end
    else if (W = 'mine') or (W = 'mines') or (W = 'landmine') or (W = 'landmines') or (W = 'm') then
      Kind := MN_LAND
    else if (W = 'claymore') or (W = 'claymores') or (W = 'clay') or (W = 'c') then
      Kind := MN_CLAY
    else if W <> 'both' then
    begin
      Say(ID, 'Use: /givemines <player|all|team> [count] [mines|claymores] (or: [mines] [claymores])', ColorBad);
      Exit;
    end;
    W := LowerCase(TakeArg(Rest));
  end;
  if N1 < 0 then
    N1 := 1;
  if Kind = MN_LAND then
  begin
    M := N1;
    C := 0;
  end
  else if Kind = MN_CLAY then
  begin
    M := 0;
    C := N1;
  end
  else
  begin
    M := N1;
    C := N2;
    if C < 0 then
      C := N1;
  end;
  if not PickTargets(ID, Who, True, False, False) then
    Exit;
  for k := 0 to TgtCount - 1 do
  begin
    T := TgtList[k];
    MnGive(T, MN_LAND, M, 'from an admin', False);
    MnGive(T, MN_CLAY, C, 'from an admin', False);
  end;
  Say(ID, 'Mines for ' + TgtDesc() + ': ' + IntToStr(M) + ' ' + MnNameM + 's, ' + IntToStr(C) + ' ' + MnNameC +
    's (up to what one carries).', ColorGood);
end;

