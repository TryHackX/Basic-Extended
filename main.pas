{ ============ round 19: [Shop] - the economy, the shop, the items ============ }

{ ---------------- the economy ---------------- }

{ A when B, else C (ScriptCore's iif gives a Variant, a Char for one letter) }
function ShIf(B: Boolean; A, C: string): string;
begin
  if B then
    Result := A
  else
    Result := C;
end;

{ the factor of the earnings now: the mode (realistic, survival, advance) and the global economy }
function ShFactor(): Single;
begin
  Result := 1;
  if Game.Realistic then
    Result := Result * ShFactorR;
  if Game.Survival then
    Result := Result * ShFactorS;
  if Game.Advance then
    Result := Result * ShFactorA;
  if ShGlobal then
    Result := Result * ShFactorG;
end;

function ShMax(): Integer;
begin
  Result := ShMaxMoney;
  if ShGlobal then
    Result := ShGMaxMoney;
end;

{ the account of the global economy: his Steam id (or his computer id with GlobalComputerId); '' = none yet }
function ShAccountKey(ID: Integer): string;
begin
  Result := '';
  if not ShGlobal then
    Exit;
  if SteamId[ID] <> '' then
    Result := SteamId[ID]
  else if ShGlobalHwid then
    if Trim(PL[ID].HWID) <> '' then
      Result := 'H' + Trim(PL[ID].HWID);
end;

procedure ShSave(ID: Integer);
var
  V: TBEInts;
begin
  if not ShGlobal then
    Exit;
  if not ShLoaded[ID] then
    Exit;
  if ShKey[ID] = '' then
    Exit;
  if not BeOk then
    Exit;
  V[0] := ShMoney[ID];
  V[1] := ShEarned[ID];
  V[2] := ShSpent[ID];
  V[3] := Trunc(Now);
  BE_Pref_Save(PChar('$' + ShKey[ID]), 4, V);
  ShDirty[ID] := False;
  ShSavedTick[ID] := Game.TickCount;
end;

{ his account comes: its money and what he made or spent since the join (the session) }
procedure ShLoadAccount(ID: Integer);
var
  V: TBEInts;
  Key: string;
  n, M: Integer;
begin
  if not ShGlobal then
    Exit;
  if ShLoaded[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  Key := ShAccountKey(ID);
  if Key = '' then
    Exit;
  if not BeOk then
    Exit;
  ShKey[ID] := Key;
  n := BE_Pref_Load(PChar('$' + Key), V);
  M := ShGStartMoney;
  { an admin's /moneyreset before the account came }
  if ShResetPending[ID] then
  begin
    ShResetPending[ID] := False;
    n := 0;
    ShEarned[ID] := 0;
    ShSpent[ID] := 0;
  end;
  if n >= 3 then
  begin
    M := V[0];
    ShEarned[ID] := V[1];
    ShSpent[ID] := V[2];
  end;
  M := M + ShDelta[ID];
  if M < 0 then
    M := 0;
  if M > ShMax() then
    M := ShMax();
  ShMoney[ID] := M;
  ShLoaded[ID] := True;
  ShNoAcct[ID] := False;
  ShDirty[ID] := True;
  HudMark(ID, False);
end;

{ the money changes (Why: a word on his screen next to the money; '' = none) }
procedure ShAdd(ID, Amount: Integer; Why: string);
var
  M: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if Amount = 0 then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  M := ShMoney[ID] + Amount;
  if M < 0 then
  begin
    Amount := -ShMoney[ID];
    M := 0;
  end;
  if M > ShMax() then
  begin
    Amount := ShMax() - ShMoney[ID];
    M := ShMax();
  end;
  ShMoney[ID] := M;
  ShDelta[ID] := ShDelta[ID] + Amount;
  if Amount > 0 then
  begin
    ShEarned[ID] := ShEarned[ID] + Amount;
    ShStatEarned := ShStatEarned + Amount;
  end
  else
    ShSpent[ID] := ShSpent[ID] - Amount;
  ShDirty[ID] := True;
  if Why <> '' then
  begin
    if Game.TickCount > ShGainUntil[ID] then
    begin
      ShGainSum[ID] := 0;
      ShGainWhy[ID] := '';
    end;
    ShGainSum[ID] := ShGainSum[ID] + Amount;
    ShGainWhy[ID] := Why;
    ShGainUntil[ID] := Game.TickCount + 150;
  end;
  HudMark(ID, False);
end;

{ money earned: the factor of the mode; nothing below MinHumans or without an opponent ([General] Opponents - a
  loss still counts); bots only with Bots = 1 }
procedure ShEarn(ID, Base: Integer; F: Single; Why: string);
var
  i, H, Amount: Integer;
begin
  if not ShActive then
    Exit;
  if (ID < 1) or (ID > 32) then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not (HumanOf[ID] or ShBots) then
    Exit;
  if Base > 0 then
    if not Opposed(ID) then
      Exit;
  if ShMinHumans > 1 then
  begin
    H := 0;
    for i := 1 to TopSlot do
      if ActiveSlot[i] then
        if HumanOf[i] then
          H := H + 1;
    if H < ShMinHumans then
      Exit;
  end;
  if Base > 0 then
    Amount := Round(Base * F * ShFactor())
  else
    Amount := Round(Base * F);
  ShAdd(ID, Amount, Why);
end;

{ a weapon the server lets him hold now (its weapon list, a bow only in Rambo, the flamer only when the
  server's flamer bonus is off - FlamerWeapon or [Admin] GiveFlamer) }
function ShWeaponOk(W: Integer): Boolean;
begin
  Result := False;
  if (W < 0) or (W > 16) then
    Exit;
  if not ShServerW[W] then
    Exit;
  if (W = 15) or (W = 16) then
    if Game.GameStyle <> 4 then
      Exit;
  if W = 14 then
    if not (ShFlamerOk or AdGiveFlamer) then
      Exit;
  Result := True;
end;

function ShIsSecondary(W: Integer): Boolean;
begin
  Result := (W = 0) or (W = 11) or (W = 12) or (W = 13);
end;

{ the full magazine of a weapon (weapons.ini through the library) }
function ShMagOf(W: Integer): Integer;
var
  St, Iv, Am, Rl, Su: Integer;
  Sp, Dm, Spr, Inh: Single;
begin
  Result := 1;
  Am := 0;
  if BeOk then
    if BE_Weapon(W, Sp, Dm, Spr, Inh, St, Iv, Am, Rl, Su) = 1 then
      if Am > 0 then
        Result := Am;
end;



{ ============ round 21: [Classes] - the class whose weapons he may choose (before the supply crates and the weapon menu) ============ }

{ the class whose weapons he chooses now: while dead the one of his next life }
function ClsNow(ID: Integer): Integer;
begin
  Result := ClsOf[ID];
  if ClsNext[ID] > 0 then
    Result := ClsNext[ID];
end;

{ his class allows weapon W (no class, a class without a weapon list or a weapon outside the menu - bows, the flamer:
  every weapon); Now: the class of the menu he chooses from (the next life's while dead) }
function ClsAllows(ID, W: Integer; Now: Boolean): Boolean;
var
  c, k: Integer;
begin
  Result := True;
  if not ClsActive then
    Exit;
  if Now then
    c := ClsNow(ID)
  else
    c := ClsOf[ID];
  if (c < 1) or (c > ClsCount) then
    Exit;
  if ClsMenu[c] = 0 then
    Exit;
  k := CySlot(W);
  if k = 0 then
    Exit;
  Result := (ClsMenu[c] and (1 shl k)) <> 0;
end;

{ the weapons his class gives (its Primary and Secondary; a class without them gives none): with BuyOnly they are his
  like the ones he bought }
function ClsGives(ID, W: Integer; Now: Boolean): Boolean;
var
  c, k: Integer;
begin
  Result := False;
  if not ClsActive then
    Exit;
  if Now then
    c := ClsNow(ID)
  else
    c := ClsOf[ID];
  if (c < 1) or (c > ClsCount) then
    Exit;
  if ClsMenu[c] = 0 then
    Exit;
  k := CySlot(W);
  if k = 0 then
    Exit;
  Result := (ClsMenu[c] and (1 shl k)) <> 0;
end;

{ the shop may sell him W (and a bot may buy it): anything - his money, his choice; with ShopClassOnly only his
  class's weapons }
function ClsShopAllows(ID, W: Integer): Boolean;
begin
  Result := True;
  if ClsShopOnly then
    Result := ClsAllows(ID, W, False)
  else if not HumanOf[ID] then
    { CLS21: a bot buys only the weapons of its class }
    Result := ClsAllows(ID, W, False);
end;

{ ---------------- [Supply]: supply crates ---------------- }

procedure SuHide(k: Integer);
var
  j, L: Integer;
begin
  L := SuLayer0 + k;
  for j := 1 to TopSlot do
    if ActiveSlot[j] then
      if HumanOf[j] or DebugBots then
        PL[j].WorldText(L, ' ', 1, ColorGood, 0.01, 0, 0);
  if (SuOpener[k] >= 1) and (SuOpener[k] <= 32) then
    if ActiveSlot[SuOpener[k]] then
      LfOver(SuOpener[k], SuWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
  SuState[k] := 0;
  SuOpener[k] := 0;
  SuCount := SuCount - 1;
  if SuCount < 0 then
    SuCount := 0;
end;

{ a crate falls onto X, GY (the ground there) - for a team only for TeamSeconds (Team 0: everybody) }
procedure SuDrop(X, GY: Single; Team, Tick: Integer; Where: string);
var
  k, n: Integer;
begin
  k := -1;
  for n := SuMax - 1 downto 0 do
    if SuState[n] = 0 then
      k := n;
  if k < 0 then
    Exit;
  SuX[k] := X;
  SuY[k] := GY;
  SuY0[k] := GY - 360;
  SuState[k] := 1;
  SuBorn[k] := Tick;
  SuLand[k] := Tick + SuFallTicks;
  SuTeam[k] := Team;
  SuServed[k] := 0;
  SuTeamUntil[k] := Tick + SuFallTicks + SuTeamTicks;
  SuOwner[k] := 0;
  SuWhat[k] := '';
  SuOpener[k] := 0;
  SuOpenStart[k] := 0;
  SuSent[k] := 0;
  SuCount := SuCount + 1;
  SuStatDropped := SuStatDropped + 1;
  if SuAnnounce <> '' then
    SayAll(ReplaceAll(SuAnnounce, '{where}', Where), SuColor);
end;

{ a crate called by a player (a class's supply skill): its contents ('' = Contents) and its caller }
procedure SuDropWith(X, GY: Single; Team, Tick: Integer; Where, Contents: string; Owner: Integer);
var
  k: Integer;
begin
  SuDrop(X, GY, Team, Tick, Where);
  for k := 0 to SuMax - 1 do
    if SuState[k] = 1 then
      if SuBorn[k] = Tick then
        if SuOwner[k] = 0 then
          if Abs(SuX[k] - X) < 0.01 then
          begin
            SuOwner[k] := Owner;
            SuWhat[k] := Contents;
            SuServed[k] := 0;
          end;
end;

{ a crate at a random place: by a spawn point or a flag base of the map, on the ground under it }
procedure SuRandomDrop(Tick: Integer);
var
  n, k, Tm: Integer;
  X, Y, GY: Single;
  Where: string;
begin
  n := MnSpCount;
  if n <= 0 then
    Exit;
  k := Random(0, n);
  X := MnSpX[k] + Random(-150, 151);
  Y := MnSpY[k];
  Tm := MnSpTeam[k];
  GY := Y;
  if BeOk then
    if BE_ShopGround(X, Y - 20, 500, GY) = 0 then
    begin
      X := MnSpX[k];
      GY := Y;
      if BE_ShopGround(X, Y - 20, 500, GY) = 0 then
        GY := Y;
    end;
  Where := 'in the field';
  if (Tm >= 1) and (Tm <= 4) then
    Where := 'near ' + TeamName(Tm) + '''s spawn';
  SuDrop(X, GY - 4, 0, Tick, Where);
end;

{ the shop's supply drop: at the buyer's cursor (on the ground under it), his team's for TeamSeconds }
function SuCall(ID, Tick: Integer): Boolean;
var
  X, GY: Single;
  k, n: Integer;
begin
  Result := False;
  n := 0;
  for k := 0 to SuMax - 1 do
    if SuState[k] <> 0 then
      n := n + 1;
  if n >= SuMax then
  begin
    Say(ID, 'The sky is full of crates - wait a moment.', ColorBad);
    Exit;
  end;
  X := PL[ID].MouseAimX;
  GY := PL[ID].MouseAimY;
  { without the map's ground ([MapGeometry]): where he stands }
  if not (BeOk and MapOk) then
  begin
    X := PL[ID].X;
    GY := PL[ID].Y;
  end
  else if BE_ShopGround(X, PL[ID].MouseAimY - 40, 600, GY) = 0 then
  begin
    Say(ID, 'No ground under your aim for a crate.', ColorBad);
    Exit;
  end;
  SuDrop(X, GY - 4, TeamOf[ID], Tick, 'for ' + PL[ID].Name + '''s team');
  Result := True;
end;

{ /supplydrop [here]: an admin's crate - by a random spawn point, or onto the ground under his aim (for
  everybody) }
procedure CmdSupplyDrop(ID: Integer; Args: string);
var
  X, GY: Single;
  k, n: Integer;
begin
  if not SuActive then
  begin
    Say(ID, 'Supply crates are off here ([Supply] Enabled, the shop''s Modes).', ColorBad);
    Exit;
  end;
  n := 0;
  for k := 0 to SuMax - 1 do
    if SuState[k] <> 0 then
      n := n + 1;
  if n >= SuMax then
  begin
    Say(ID, IntToStr(SuMax) + ' crates are on the map already ([Supply] MaxCrates).', ColorBad);
    Exit;
  end;
  if LowerCase(Trim(Args)) <> 'here' then
  begin
    SuRandomDrop(Game.TickCount);
    if SuCount <= n then
      Say(ID, 'The map has no spawn point for a crate.', ColorBad);
    Exit;
  end;
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'Use: /supplydrop (a random place); /supplydrop here is for an admin in the game.', ColorBad);
    Exit;
  end;
  X := PL[ID].MouseAimX;
  GY := PL[ID].MouseAimY;
  { without the map's ground ([MapGeometry]): where he stands }
  if not (BeOk and MapOk) then
  begin
    X := PL[ID].X;
    GY := PL[ID].Y;
  end
  else if BE_ShopGround(X, PL[ID].MouseAimY - 40, 600, GY) = 0 then
  begin
    Say(ID, 'No ground under your aim for a crate.', ColorBad);
    Exit;
  end;
  SuDrop(X, GY - 4, 0, Game.TickCount, 'from the sky');
end;

{ what a crate gives: one of Contents by its weight }
function SuPick(Contents: string): string;
var
  S, W, All: string;
  Sum, R, n, p: Integer;
begin
  Result := 'money';
  Sum := 0;
  All := Contents;
  if Trim(All) = '' then
    All := SuContents;
  { "word weight" - a word without a weight weighs 1 }
  S := All + '|';
  while Pos('|', S) > 0 do
  begin
    W := Trim(Copy(S, 1, Pos('|', S) - 1));
    Delete(S, 1, Pos('|', S));
    p := Pos(' ', W);
    if p > 0 then
      Sum := Sum + StrToIntDef(Trim(Copy(W, p + 1, 10)), 0)
    else if W <> '' then
      Sum := Sum + 1;
  end;
  if Sum <= 0 then
    Exit;
  R := Random(0, Sum);
  S := All + '|';
  while Pos('|', S) > 0 do
  begin
    W := Trim(Copy(S, 1, Pos('|', S) - 1));
    Delete(S, 1, Pos('|', S));
    p := Pos(' ', W);
    n := 0;
    if p > 0 then
    begin
      n := StrToIntDef(Trim(Copy(W, p + 1, 10)), 0);
      W := Trim(Copy(W, 1, p - 1));
    end
    else if W <> '' then
      n := 1;
    if n > 0 then
    begin
      if R < n then
      begin
        Result := W;
        Exit;
      end;
      R := R - n;
    end;
  end;
end;

{ the crate's contents for ID: a few tries until one of the modules here gives something }
procedure SuGive(ID, k: Integer);
var
  What, Got: string;
  Try0, W, n: Integer;
  P: TActivePlayer;
begin
  P := PL[ID];
  Got := '';
  for Try0 := 1 to 6 do
    if Got = '' then
    begin
      What := SuPick(SuWhat[k]);
      if What = 'ammo' then
      begin
        W := P.Primary.WType;
        if AmmoEnabled and BeOk and (W >= 0) and (W <= 16) then
        begin
          n := BE_AmmoTopUp(ID, W) + BE_AmmoAddMags(ID, W, 2);
          if n > 0 then
            Got := 'magazines for the ' + WeaponName(W);
        end;
      end
      else if What = 'grenades' then
      begin
        if FnEnabled then
        begin
          if FnNadeLeft[ID] < ShMaxNades then
          begin
            FnNadeLeft[ID] := FnNadeLeft[ID] + 2;
            if FnNadeLeft[ID] > ShMaxNades then
              FnNadeLeft[ID] := ShMaxNades;
            FnNeed[ID] := True;
            Got := 'grenades';
          end;
        end
        else if ObjectsFree(OBJECT_MARGIN) >= OBJECT_MARGIN then
          if P.Grenades < Game.MaxGrenades then
          begin
            P.GiveBonus(4);
            Got := 'grenades';
          end;
      end
      else if What = 'flashes' then
      begin
        if FnEnabled then
          if FnFlashLeft[ID] < ShMaxFlashes then
          begin
            FnFlashLeft[ID] := FnFlashLeft[ID] + 1;
            FnNeed[ID] := True;
            Got := 'a flash grenade';
          end;
      end
      else if What = 'mines' then
      begin
        if MnEnabled then
          if MnGive(ID, MN_LAND, 2, 'a supply crate', True) > 0 then
            Got := 'landmines';
      end
      else if What = 'claymore' then
      begin
        if MnEnabled then
          if MnGive(ID, MN_CLAY, 1, 'a supply crate', True) > 0 then
            Got := 'a claymore';
      end
      else if What = 'javelin' then
      begin
        { F17: no more than the shop's MaxJavelins }
        if RkEnabled then
          if RkRockets - RkUsed[ID] < ShMaxJav then
          begin
            RkUsed[ID] := RkUsed[ID] - 1;
            Got := 'a Javelin';
          end;
      end
      else if What = 'medical' then
      begin
        P.Health := MaxHealth;
        LastHealth[ID] := MaxHealth;
        if BdActive then
        begin
          BE_BodyHeal(ID, BC_KIT, 50);
          BE_BodySupplies(ID, 100, 1, 1);
          BdSync(ID);
        end;
        Got := 'medical supplies';
      end
      else if What = 'vest' then
      begin
        P.Vest := 100;
        Got := 'a vest';
      end
      else if What = 'money' then
      begin
        { not without an opponent ([General] Opponents): the crate gives something else }
        if ShActive then
          if HasOpponent(ID) then
          begin
            ShAdd(ID, 300 + Random(0, 5) * 100, 'crate');
            Got := 'money';
          end;
      end
      else if What = 'weapon' then
      begin
        W := Random(1, 11);
        { a weapon the shop does not sell (the Minigun by default) is not in a crate either }
        if (ShWeaponOk(W) and ((not ShEnabled) or (ShPrice[W] <> -1))) or ((not ShEnabled) and (W >= 1) and (W <= 10)) then
          if SpawnObject(WeaponObject(W), SuX[k], SuY[k] - 20) then
            Got := 'a ' + WeaponName(W) + ' (on the ground)';
      end;
    end;
  if Got = '' then
  begin
    P.Health := MaxHealth;
    LastHealth[ID] := MaxHealth;
    Got := 'first aid';
  end;
  HudMark(ID, False);
  if HumanOf[ID] then
    LfBig(ID, SuBigLayer, ReplaceAll(SuGotText, '{what}', Got), SuColor);
  Say(ID, ReplaceAll(SuGotText, '{what}', Got), SuColor);
  SuStatOpened := SuStatOpened + 1;
  { [Points] CrateOpened: a mate opened the crate of the one who called it (paid by the points' tick) }
  if BpActive then
    if (SuOwner[k] >= 1) and (SuOwner[k] <= 32) then
      if SuOwner[k] <> ID then
        if TeamOf[SuOwner[k]] = TeamOf[ID] then
        begin
          BpEvPend[SuOwner[k]][PE_CRATE] := BpEvPend[SuOwner[k]][PE_CRATE] + 1;
          BpPendAny := True;
        end;
end;

{ the crates: the timer, the fall, the marks, the one who opens it }
procedure SuTickRun(Tick: Integer);
var
  k, j, Best, L: Integer;
  DX, DY, D, BestD, Y: Single;
  P: TActivePlayer;
  Low: Boolean;
begin
  if not SuActive then
    Exit;
  { the marks a reload left on layers the crates no longer use }
  if SuHideOldN > 0 then
  begin
    for k := SuHideOld0 to SuHideOld0 + SuHideOldN - 1 do
      if (k < SuLayer0) or (k >= SuLayer0 + SuMax) then
        if (k >= 1) and (k <= 255) then
          for j := 1 to TopSlot do
            if ActiveSlot[j] then
              if HumanOf[j] then
                PL[j].WorldText(k, ' ', 1, ColorGood, 0.01, 0, 0);
    SuHideOldN := 0;
  end;
  { a pause: the crates' clocks wait (their marks stay) }
  if PausedNow then
  begin
    if SuNextTick > 0 then
      SuNextTick := SuNextTick + 1;
    if SuRoundDrop > 0 then
      SuRoundDrop := SuRoundDrop + 1;
    for k := 0 to SuMax - 1 do
      if SuState[k] <> 0 then
      begin
        SuBorn[k] := SuBorn[k] + 1;
        SuLand[k] := SuLand[k] + 1;
        SuOpenStart[k] := SuOpenStart[k] + 1;
        SuTeamUntil[k] := SuTeamUntil[k] + 1;
      end;
  end;
  { the timer }
  if SuNextTick = 0 then
    SuNextTick := Tick + SuEveryTicks + Random(-SuJitter, SuJitter + 1);
  if Tick >= SuNextTick then
  begin
    SuNextTick := Tick + SuEveryTicks + Random(-SuJitter, SuJitter + 1);
    if Game.NumPlayers >= 2 then
      SuRandomDrop(Tick);
  end;
  if SuRoundDrop > 0 then
    if Tick >= SuRoundDrop then
    begin
      SuRoundDrop := 0;
      SuRandomDrop(Tick);
    end;
  if SuCount <= 0 then
    Exit;
  for k := 0 to SuMax - 1 do
    if SuState[k] <> 0 then
    begin
      L := SuLayer0 + k;
      if Tick - SuBorn[k] > SuFallTicks + SuLifeTicks then
      begin
        SuHide(k);
        Continue;
      end;
      if SuState[k] = 1 then
      begin
        { falling (a text lives longer than its next one: drawn whole - the client fades a short one) }
        if Tick >= SuLand[k] then
        begin
          SuState[k] := 2;
          SuSent[k] := 0;
        end
        else if Tick - SuSent[k] >= 6 then
        begin
          SuSent[k] := Tick;
          Y := SuY0[k] + (SuY[k] - SuY0[k]) * (Tick - SuBorn[k]) / SuFallTicks;
          LfOverAll(L, SuFallMark, SuX[k], Y, SuScale, SuMarkY, 86, SuColor, -1);
        end;
        Continue;
      end;
      { on the ground: its mark every second }
      if Tick - SuSent[k] >= 60 then
      begin
        SuSent[k] := Tick;
        LfOverAll(L, SuMark, SuX[k], SuY[k], SuScale, SuMarkY, 140, SuColor, -1);
      end;
      if Tick mod 10 <> 0 then
        Continue;
      { who opens it: the nearest soldier within OpenRadius, low (a bot: by staying there) }
      Best := 0;
      BestD := 0;
      for j := 1 to TopSlot do
        if ActiveSlot[j] then
        begin
          P := PL[j];
          if P.Alive then
            if not DwDown[j] then
              if (SuTeam[k] = 0) or (Tick >= SuTeamUntil[k]) or (TeamOf[j] = SuTeam[k]) then
              if (SuServed[k] and (1 shl (j - 1))) = 0 then
              begin
                DX := P.X - SuX[k];
                DY := P.Y - SuY[k];
                D := DX * DX + DY * DY;
                if D <= SuOpenR * SuOpenR then
                begin
                  Low := True;
                  if HumanOf[j] then
                    Low := P.KeyCrouch or P.IsProne
                  else if not SuBots then
                    Low := False;
                  if Low then
                    if (Best = 0) or (D < BestD) then
                    begin
                      Best := j;
                      BestD := D;
                    end;
                end;
              end;
        end;
      if Best = 0 then
      begin
        if SuOpener[k] > 0 then
          if ActiveSlot[SuOpener[k]] then
            LfOver(SuOpener[k], SuWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
        SuOpener[k] := 0;
        Continue;
      end;
      if Best <> SuOpener[k] then
      begin
        SuOpener[k] := Best;
        SuOpenStart[k] := Tick;
      end;
      j := SuOpenTicks;
      if not HumanOf[Best] then
        j := j * 2;
      if Tick - SuOpenStart[k] >= j then
      begin
        SuGive(Best, k);
        { a class's crate stays for the rest of its team (each one once) while it lies; any other goes }
        if SuOwner[k] > 0 then
        begin
          SuServed[k] := SuServed[k] or (1 shl (Best - 1));
          LfOver(Best, SuWorkLayer, '', 0, 0, 0.01, 0, 1, ColorGood);
          SuOpener[k] := 0;
        end
        else
          SuHide(k);
        Continue;
      end;
      if j > 0 then
        LfOver(Best, SuWorkLayer, ReplaceAll(SuOpenText, '{pct}', IntToStr((Tick - SuOpenStart[k]) * 100 div j)),
          SuX[k], SuY[k], 0.04, 26, 60, SuColor);
    end;
end;

procedure SuMapStart();
var
  k: Integer;
begin
  for k := 0 to 7 do
    SuState[k] := 0;
  SuCount := 0;
  SuNextTick := 0;
  SuRoundDrop := 0;
  SuRefresh();
  { the first survival round of the map has its crate too (its respawns came before this) }
  SuArmed := False;
  if SuActive then
    if SuPerRound then
      if Game.Survival then
      begin
        SuArmed := True;
        SuRoundDrop := Game.TickCount + Random(1200, 3000);
      end;
end;

{ a survival round starts: one crate at a random moment of it }
procedure SuRoundStart(Tick: Integer);
begin
  if SuActive then
    if SuPerRound then
      if not SuArmed then
      begin
        SuArmed := True;
        if SuRoundDrop = 0 then
          SuRoundDrop := Tick + Random(1200, 3000);
      end;
end;


{ ---------------- the items ---------------- }

{ the price of an item for him now (a share of the weapon in his hands for a magazine or ammunition; the
  mode's price factors); -1 = not sold }
function ShPriceOf(ID, It: Integer): Integer;
var
  P, W: Integer;
  F: Single;
begin
  Result := -1;
  if (It < 0) or (It > IT_LAST) then
    Exit;
  P := ShPrice[It];
  if P = -1 then
    Exit;
  if P <= -100 then
  begin
    W := PL[ID].Primary.WType;
    if (W < 0) or (W > 16) then
      Exit;
    if ShPrice[W] < 0 then
      Exit;
    P := ShPrice[W] * (-100 - P) div 100;
    if P < 1 then
      P := 1;
  end;
  F := 1;
  if Game.Realistic then
    F := F * ShPriceR;
  if Game.Survival then
    F := F * ShPriceS;
  if Game.Advance then
    F := F * ShPriceA;
  Result := Round(P * F);
end;

{ the weapon into his hands, from the tick: a primary in the primary slot (the old one becomes the secondary
  with OldPrimary = secondary), a secondary in the secondary slot; the other weapon keeps the count he has }
procedure ShGiveWeapon(ID, W: Integer);
var
  NW, NS: TNewWeapon;
  P: TActivePlayer;
  OW, OA, SW, SA, Tick: Integer;
begin
  P := PL[ID];
  Tick := Game.TickCount;
  OW := P.Primary.WType;
  OA := P.Primary.Ammo;
  if AmmoEnabled then
    if BeOk then
      if (OW >= 0) and (OW <= 16) then
        OA := BE_AmmoShown(ID, Tick, OW, OA);
  SW := P.Secondary.WType;
  SA := P.Secondary.Ammo;
  { F6: after Q the secondary is in the hands (the game's Primary): the rules work on his real primary }
  if (OW >= 0) and (OW <= 16) and (SW >= 0) and (SW <= 16) then
    if ShIsSecondary(OW) then
      if not ShIsSecondary(SW) then
      begin
        Tick := OW;
        OW := SW;
        SW := Tick;
        Tick := OA;
        OA := SA;
        SA := Tick;
        Tick := Game.TickCount;
      end;
  NW := TNewWeapon.Create;
  NS := TNewWeapon.Create;
  try
    if ShIsSecondary(W) then
    begin
      NW.WType := OW;
      NW.Ammo := OA;
      NS.WType := W;
      NS.Ammo := ShMagOf(W);
    end
    else
    begin
      NW.WType := W;
      NW.Ammo := ShMagOf(W);
      if ShOldToSecondary and (OW >= 0) and (OW <= 16) and (OW <> W) then
      begin
        NS.WType := OW;
        NS.Ammo := OA;
      end
      else
      begin
        NS.WType := SW;
        NS.Ammo := SA;
      end;
    end;
    P.ForceWeapon(NW, NS);
    AmGiven(ID);
    if AmmoEnabled then
      if BeOk then
        if (NW.WType >= 0) and (NW.WType <= 16) then
          BE_AmmoForced(ID, Tick, NW.WType, NW.Ammo);
  finally
    NW.Free;
    NS.Free;
  end;
  AcAmmoTouched(ID);
end;

{ ---------------- BuyOnly: the weapon menu is what he owns ---------------- }

function ShFreeSlot(k: Integer): Boolean;
begin
  { the secondaries (SOCOM, knife) are free when the shop sells them for nothing; a weapon not sold is
    never free }
  Result := False;
  if ShPrice[CyWeaponOfSlot(k)] = 0 then
    Result := True;
end;

{ his menu now: allowed by the server, not locked by SurvivalLock; with BuyOnly what he owns, the free ones and his
  class's, without it his class's; only what changed since the last one is sent }
procedure ShMaskSend(ID: Integer);
var
  k, M: Integer;
  On, Buy: Boolean;
begin
  Buy := ShBuyOnly and ShActive;
  if not ActiveSlot[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  { nothing manages the menu: the game's own. A menu this script changed before (known or not) goes back to what the
    server allows, once }
  if not (Buy or ClsActive or (InsActive and (InsMenu <> 0))) then
    if not CyAnyLock[ID] then
    begin
      if ShMaskLast[ID] = -2 then
        Exit;
      for k := 1 to 14 do
        PL[ID].WeaponActive[k] := ShServerW[CyWeaponOfSlot(k)];
      ShMaskLast[ID] := -2;
      Exit;
    end;
  M := 0;
  for k := 1 to 14 do
  begin
    { BuyOnly: what he owns, the free ones and his class's (of his next life while he is dead); without it the class's
      weapons only - the shop sells the others }
    On := True;
    if Buy then
      On := ShOwned[ID][k] or ShFreeSlot(k) or ClsGives(ID, CyWeaponOfSlot(k), True)
    else if ClsActive then
      On := ClsAllows(ID, CyWeaponOfSlot(k), True);
    { [Insurgents] Weapons (without [Classes]): the insurgents' menu }
    if On then
      if InsMenu <> 0 then
        if not ClsActive then
          if InsIsIns(ID) then
            if (InsMenu and (1 shl k)) = 0 then
              On := False;
    if CyLocked[ID][k] then
      On := False;
    if not ShServerW[CyWeaponOfSlot(k)] then
      On := False;
    if On then
      M := M or (1 shl k);
  end;
  for k := 1 to 14 do
  begin
    On := (M and (1 shl k)) <> 0;
    if ShMaskLast[ID] < 0 then
      PL[ID].WeaponActive[k] := On
    else if ((ShMaskLast[ID] and (1 shl k)) <> 0) <> On then
      PL[ID].WeaponActive[k] := On;
  end;
  ShMaskLast[ID] := M;
end;

{ his whole menu again (a new game client, a new map, the Advance mode's own changes) }
procedure ShMaskForce(ID: Integer);
begin
  if ShMaskLast[ID] <> -2 then
    ShMaskLast[ID] := -1
  else if (ShBuyOnly and ShActive) or ClsActive or (InsActive and (InsMenu <> 0)) then
    ShMaskLast[ID] := -1;
  ShMaskSend(ID);
end;

{ a team change reset the weapon menu in his game: BuyOnly's menu or the survival locks again }
procedure MenuAgainRun(Tick: Integer);
var
  i, k: Integer;
begin
  MenuAgainAny := 0;
  for i := 1 to TopSlot do
    if MenuAgainAt[i] > 0 then
    begin
      if Tick < MenuAgainAt[i] then
        MenuAgainAny := MenuAgainAny + 1
      else
      begin
        MenuAgainAt[i] := 0;
        if ActiveSlot[i] then
          if HumanOf[i] then
          begin
            if (ShBuyOnly and ShActive) or ClsActive or (InsActive and (InsMenu <> 0)) then
              ShMaskForce(i)
            else if CyAnyLock[i] then
              for k := 1 to 14 do
                if CyLocked[i][k] then
                  PL[i].WeaponActive[k] := False;
          end;
      end;
    end;
end;

procedure ShOwnSet(ID, W: Integer; On: Boolean);
var
  k: Integer;
begin
  k := CySlot(W);
  if k > 0 then
    ShOwned[ID][k] := On;
end;

procedure ShOwnClear(ID: Integer);
var
  k: Integer;
begin
  for k := 1 to 14 do
    ShOwned[ID][k] := False;
end;

{ BuyOnly: a weapon he may hold - his own, a free one, his class's, none, or one not in the menu (bows, flamer) }
function ShOwnsWeapon(ID, W: Integer): Boolean;
var
  k: Integer;
begin
  Result := True;
  k := CySlot(W);
  if k > 0 then
    Result := ShOwned[ID][k] or ShFreeSlot(k) or ClsGives(ID, W, False);
end;

{ ---------------- buying ---------------- }

{ an item on the list of the shop: sold here and now (the server's weapons, a bow only in Rambo, the flamer) - the
  same for every player, so a number of !shop means the same item for everybody }
function ShListed(It: Integer): Boolean;
begin
  Result := False;
  if (It < 0) or (It > IT_LAST) then
    Exit;
  if ShPrice[It] = -1 then
    Exit;
  if It <= 16 then
    if not ShWeaponOk(It) then
      Exit;
  { F16: what nothing here can deliver is not offered (the module idle, or the cluster with the flashes) }
  if It = IT_CLUSTER then
    if FnEnabled then
      Exit;
  if It = IT_FLASH then
    if not FnEnabled then
      Exit;
  if It = IT_MINE then
    if not (MnActive and MnLand) then
      Exit;
  if It = IT_CLAY then
    if not (MnActive and MnClay) then
      Exit;
  if It = IT_JAV then
    if not RkEnabled then
      Exit;
  if (It = IT_BANDAGE) or (It = IT_KIT) or (It = IT_BLOODBAG) then
    if not BdActive then
      Exit;
  if It = IT_SUPPLY then
    if not SuEnabled then
      Exit;
  if It = IT_UAV then
    if not TeamGame() then
      Exit;
  Result := True;
end;

