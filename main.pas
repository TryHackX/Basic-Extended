procedure PermLoad();
var
  Id, p: Integer;
  S, Who, Px: string;
begin
  for Id := 0 to 255 do
  begin
    CmdWho[Id] := PW_ALL;
    if Id >= C_FIRST_ADMIN then
      CmdWho[Id] := PW_ADMIN;
    CmdPfx[Id] := PX_NATIVE;
  end;
  CmdWho[C_TEST] := PW_CONSOLE;
  CmdWho[C_BENCH] := PW_CONSOLE;
  CmdWho[C_SUSPECTS] := PW_ALL;
  CmdPfx[C_SUSPECTS] := PX_BOTH;
  CmdWho[C_ACSTATS] := PW_ALL;
  CmdPfx[C_ACSTATS] := PX_BOTH;
  CmdWho[C_ACREVIEW] := PW_ALL;
  CmdPfx[C_ACREVIEW] := PX_BOTH;
  { the ammunition commands are for every player, typed with / or ! }
  CmdWho[C_AMMO] := PW_ALL;
  CmdPfx[C_AMMO] := PX_BOTH;
  CmdWho[C_MAG] := PW_ALL;
  CmdPfx[C_MAG] := PX_BOTH;
  CmdWho[C_REPACK] := PW_ALL;
  CmdPfx[C_REPACK] := PX_BOTH;
  CmdWho[C_AMMOHUD] := PW_ALL;
  CmdPfx[C_AMMOHUD] := PX_BOTH;
  { the flash grenade and guided rocket commands too }
  for Id := C_NADETYPE to C_ROCKET do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  { [TeamKill]: !tk and the victim's !1-!4 }
  for Id := C_TK to C_TKNEXT do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  { [Mines]: !mine, !claymore, !mines }
  for Id := C_MINE to C_MINEINFO do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  { [Spotting], [Bleeding], [Downed], [Bounty]: !spot, !bandage, !kit, !giveup, !bounty (and / for a bind) }
  for Id := C_SPOT to C_BOUNTY do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  { [PrivateMessages], [Notes]: /pm, /r, /pmmute, /pmunmute, /note, /report - only with / (a ! line is seen by
    everybody) }
  for Id := C_PM to C_REPORT do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_SLASH;
  end;
  { [Pause]: !p, !up, /pause, /unpause (who may: [Pause] Players, PlayersUnpause) }
  CmdWho[C_PAUSE] := PW_ALL;
  CmdPfx[C_PAUSE] := PX_BOTH;
  CmdWho[C_UNPAUSE] := PW_ALL;
  CmdPfx[C_UNPAUSE] := PX_BOTH;
  { [Shop]: !shop, !buy, !money, !pay, !sell (and / for a bind: bind "F5" "/buy ak") }
  for Id := C_SHOP to C_SELL do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  { [Classes], [Points]: !class, !classes, !skill, !skill2 (and / for a bind: bind "c" "/skill"), !score, !scores }
  for Id := C_CLASS to C_SKILL2 do
  begin
    CmdWho[Id] := PW_ALL;
    CmdPfx[Id] := PX_BOTH;
  end;
  CmdWho[C_SCORE] := PW_ALL;
  CmdPfx[C_SCORE] := PX_BOTH;
  CmdWho[C_SCORES] := PW_ALL;
  CmdPfx[C_SCORES] := PX_BOTH;
  { [Classes]: /c4 (and !c4; bind "x" "/c4") }
  CmdWho[C_C4] := PW_ALL;
  CmdPfx[C_C4] := PX_BOTH;
  { [Insurgents]: /detonate (bind "b" "/detonate"), !insurgents }
  CmdWho[C_DETONATE] := PW_ALL;
  CmdPfx[C_DETONATE] := PX_BOTH;
  CmdWho[C_INSINFO] := PW_ALL;
  CmdPfx[C_INSINFO] := PX_BOTH;
  for Id := 1 to C_LAST do
  begin
    if CmdKey(Id) = '' then
      Continue;
    S := LowerCase(Trim(CfgStr('Permissions', CmdKey(Id), '')));
    if S = '' then
      Continue;
    p := Pos(' ', S);
    if p > 0 then
    begin
      Who := Trim(Copy(S, 1, p - 1));
      Px := Trim(Copy(S, p + 1, Length(S)));
    end
    else
    begin
      Who := S;
      Px := '';
    end;
    if (Who = '/') or (Who = '!') or (Who = 'both') then
    begin
      Px := Who;
      Who := '';
    end;
    if (Who = 'all') or (Who = 'everybody') or (Who = 'players') then
      CmdWho[Id] := PW_ALL
    else if (Who = 'admins') or (Who = 'admin') then
      CmdWho[Id] := PW_ADMIN
    else if (Who = 'console') or (Who = 'rcon') then
      CmdWho[Id] := PW_CONSOLE
    else if (Who = 'off') or (Who = 'none') or (Who = 'nobody') then
      CmdWho[Id] := PW_OFF
    else if Who <> '' then
      CfgWarn('Permissions', CmdKey(Id), S, 'all, admins, console or off, then /, ! or both');
    if Px = '/' then
      CmdPfx[Id] := PX_SLASH
    else if Px = '!' then
      CmdPfx[Id] := PX_CHAT
    else if (Px = 'both') or (Px = '/!') or (Px = '!/') then
      CmdPfx[Id] := PX_BOTH
    else if Px <> '' then
      CfgWarn('Permissions', CmdKey(Id), S, 'the second word is /, ! or both');
  end;
end;

function CanUse(ID, Cmd: Integer; Console: Boolean): Boolean;
var
  W: Integer;
begin
  Result := False;
  if (Cmd < 1) or (Cmd > 255) then
    Exit;
  W := CmdWho[Cmd];
  if W = PW_OFF then
    Exit;
  Result := True;
  if Console then
    Exit;
  if W = PW_CONSOLE then
    Result := False
  else if W = PW_ADMIN then
  begin
    Result := PL[ID].IsAdmin;
    if not Result then
      if Cmd = C_OVERLAY then
        Result := OvlAllowed[ID] or OvlPublic;
  end;
end;

{ "text|$colour" lines of [Info]: the colour after the last | }
procedure SplitLine(S: string; Def: Longint; var Text: string; var Color: Longint);
var
  i, p: Integer;
begin
  Text := S;
  Color := Def;
  p := 0;
  for i := Length(S) downto 1 do
    if S[i] = '|' then
    begin
      p := i;
      Break;
    end;
  if p = 0 then
    Exit;
  if p < Length(S) then
    if S[p + 1] = '$' then
    begin
      Color := StrToIntDef(Trim(Copy(S, p + 1, Length(S))), Def);
      Text := Copy(S, 1, p - 1);
    end;
end;

{ the Steam ids of a setting ("id|id"; commas and spaces work too) in the S<number> form }
procedure LoadSteamWords(List: string; Dest: TStringList; Section, Key: string);
var
  S, W, N: string;
  p: Integer;
begin
  Dest.Clear;
  S := ReplaceAll(ReplaceAll(ReplaceAll(ReplaceAll(Trim(List), ',', '|'), ';', '|'), ' ', '|'), #9, '|');
  while S <> '' do
  begin
    p := Pos('|', S);
    if p = 0 then
    begin
      W := S;
      S := '';
    end
    else
    begin
      W := Copy(S, 1, p - 1);
      Delete(S, 1, p);
    end;
    W := Trim(W);
    if W <> '' then
    begin
      N := NormalizeSteam(W);
      if N = '' then
        CfgWarn(Section, Key, W, 'not a Steam id, left out')
      else if Dest.IndexOf(N) < 0 then
        Dest.Add(N);
    end;
  end;
end;

{ the numbers n of the keys Prefix-n of a section, in number order (any numbers, gaps allowed) }
procedure CfgNumbers(Section, Prefix: string; Nums: TStringList);
var
  Keys: TStringList;
  k, j, n: Integer;
  K2, Pf: string;
  Placed: Boolean;
begin
  Nums.Clear;
  if not CfgOk then
    Exit;
  Keys := File.CreateStringList();
  Cfg.ReadSection(Section, Keys);
  Pf := LowerCase(Prefix) + '-';
  for k := 0 to Keys.Count - 1 do
  begin
    K2 := LowerCase(Trim(Keys[k]));
    if Copy(K2, 1, Length(Pf)) = Pf then
    begin
      n := StrToIntDef(Copy(K2, Length(Pf) + 1, Length(K2)), -1);
      if n >= 1 then
      begin
        Placed := False;
        for j := 0 to Nums.Count - 1 do
          if not Placed then
            if StrToInt(Nums[j]) > n then
            begin
              Nums.Insert(j, IntToStr(n));
              Placed := True;
            end;
        if not Placed then
          Nums.Add(IntToStr(n));
      end;
    end;
  end;
  Keys.Free;
end;

{ the lines Prefix-1, Prefix-2 ... of a section for ShowList; with Color-Prefix-n a line is "colour<tab>
  text" }
function CfgTextLines(Section, Prefix: string): TStringList;
var
  Nums: TStringList;
  k: Integer;
  T, C: string;
begin
  Result := File.CreateStringList();
  Nums := File.CreateStringList();
  CfgNumbers(Section, Prefix, Nums);
  for k := 0 to Nums.Count - 1 do
  begin
    T := CfgStr(Section, Prefix + '-' + Nums[k], '');
    C := Trim(CfgStr(Section, 'Color-' + Prefix + '-' + Nums[k], ''));
    if C <> '' then
      Result.Add(C + #9 + T)
    else
      Result.Add(T);
  end;
  Nums.Free;
end;

{ settings.ini as text (so that its comments stay): Prefix-n = Value at the end of Section, n one
  more than the highest there; the section is made when it is missing }
procedure IniAppendNumbered(Section, Prefix, Value: string);
var
  L: TStringList;
  i, Start, Last, n, Top, p: Integer;
  S, K: string;
begin
  L := nil;
  try
    if File.Exists(CfgPath) then
      L := File.CreateStringListFromFile(CfgPath)
    else
      L := File.CreateStringList();
  except
    Log('cannot read ' + CfgPath);
    Exit;
  end;
  Start := -1;
  for i := 0 to L.Count - 1 do
    if Start < 0 then
      if LowerCase(Trim(L[i])) = '[' + LowerCase(Section) + ']' then
        Start := i;
  Top := 0;
  if Start < 0 then
  begin
    L.Add('');
    L.Add('[' + Section + ']');
    L.Add(Prefix + '-1 = ' + Value);
  end
  else
  begin
    Last := Start;
    i := Start + 1;
    while i < L.Count do
    begin
      S := Trim(L[i]);
      if S <> '' then
      begin
        if Copy(S, 1, 1) = '[' then
          Break;
        Last := i;
        p := Pos('=', S);
        if p > 0 then
        begin
          K := LowerCase(Trim(Copy(S, 1, p - 1)));
          if Copy(K, 1, Length(Prefix) + 1) = LowerCase(Prefix) + '-' then
          begin
            n := StrToIntDef(Copy(K, Length(Prefix) + 2, Length(K)), 0);
            if n > Top then
              Top := n;
          end;
        end;
      end;
      i := i + 1;
    end;
    L.Insert(Last + 1, Prefix + '-' + IntToStr(Top + 1) + ' = ' + Value);
  end;
  try
    L.SaveToFile(CfgPath);
  except
    Log('cannot write ' + CfgPath);
  end;
  L.Free;
end;

{ settings.ini as text: the Prefix-n lines of Section whose value starts with the Steam id N are
  taken out; how many }
function IniDropSteam(Section, Prefix, N: string): Integer;
var
  L: TStringList;
  i, p: Integer;
  S, K: string;
  InSec: Boolean;
begin
  Result := 0;
  if not File.Exists(CfgPath) then
    Exit;
  try
    L := File.CreateStringListFromFile(CfgPath);
  except
    Log('cannot read ' + CfgPath);
    Exit;
  end;
  InSec := False;
  i := 0;
  while i < L.Count do
  begin
    S := Trim(L[i]);
    if Copy(S, 1, 1) = '[' then
      InSec := LowerCase(S) = '[' + LowerCase(Section) + ']'
    else if InSec then
    begin
      p := Pos('=', S);
      if p > 0 then
      begin
        K := LowerCase(Trim(Copy(S, 1, p - 1)));
        if Copy(K, 1, Length(Prefix) + 1) = LowerCase(Prefix) + '-' then
          if SteamOfLine(Trim(Copy(S, p + 1, Length(S)))) = N then
          begin
            L.Delete(i);
            Result := Result + 1;
            Continue;
          end;
      end;
    end;
    i := i + 1;
  end;
  if Result > 0 then
    try
      L.SaveToFile(CfgPath);
    except
      Log('cannot write ' + CfgPath);
    end;
  L.Free;
end;

{ [Admin] Steam-1, Steam-2 ...: a Steam id in any form (S123456789, 76561198083722517,
  STEAM_0:1:61728394, [U:1:123456789]); the rest of the value is a comment (a name) }
procedure LoadAdminSteams();
var
  i: Integer;
  N, L: string;
  Nums: TStringList;
begin
  AdSteamRaw.Clear;
  AdSteams.Clear;
  Nums := File.CreateStringList();
  CfgNumbers('Admin', 'Steam', Nums);
  for i := 0 to Nums.Count - 1 do
  begin
    L := Trim(CfgStr('Admin', 'Steam-' + Nums[i], ''));
    N := SteamOfLine(L);
    if N <> '' then
    begin
      AdSteamRaw.Add(L);
      if AdSteams.IndexOf(N) < 0 then
        AdSteams.Add(N);
    end
    else if L <> '' then
      Log('settings.ini: [Admin] Steam-' + Nums[i] + ' = ' + L + ': not a Steam id at the start');
  end;
  Nums.Free;
end;

{ list, labels, circle or arrows (label and arrow too) -> OVL_*; -1 when it is none of them }
function RadarModeOf(S: string): Integer;
begin
  Result := -1;
  S := LowerCase(Trim(S));
  if S = 'list' then
    Result := OVL_LIST
  else if (S = 'labels') or (S = 'label') then
    Result := OVL_LABELS
  else if S = 'circle' then
    Result := OVL_CIRCLE
  else if (S = 'ring') or (S = 'arrows') or (S = 'arrow') or (S = 'dots') then
    Result := OVL_ARROWS;
end;

function RadarModeName(M: Integer): string;
begin
  Result := 'list';
  if M = OVL_LABELS then
    Result := 'labels'
  else if M = OVL_CIRCLE then
    Result := 'circle'
  else if M = OVL_ARROWS then
    Result := 'ring';
end;

function ShowName(S: Integer): string;
begin
  Result := 'all';
  if S = SHOW_SEENALL then
    Result := 'seenall'
  else if S = SHOW_SEEN then
    Result := 'seen'
  else if S = SHOW_SEENALL_REAL then
    Result := 'seenallreal'
  else if S = SHOW_SEEN_REAL then
    Result := 'seenreal';
end;

function ShowOf(S: string): Integer;
begin
  Result := -1;
  S := LowerCase(Trim(S));
  if S = 'all' then
    Result := SHOW_ALL
  else if S = 'seenall' then
    Result := SHOW_SEENALL
  else if S = 'seen' then
    Result := SHOW_SEEN
  else if S = 'seenallreal' then
    Result := SHOW_SEENALL_REAL
  else if S = 'seenreal' then
    Result := SHOW_SEEN_REAL;
end;

function ModesOf(S: string): Integer;
var
  W: string;
  p, M: Integer;
begin
  Result := 0;
  S := LowerCase(Trim(S));
  if S = 'all' then
  begin
    Result := MODES_ALL;
    Exit;
  end;
  S := ReplaceAll(ReplaceAll(S, ',', '|'), ' ', '|');
  while S <> '' do
  begin
    p := Pos('|', S);
    if p = 0 then
    begin
      W := S;
      S := '';
    end
    else
    begin
      W := Copy(S, 1, p - 1);
      Delete(S, 1, p);
    end;
    M := RadarModeOf(W);
    if M >= 0 then
      Result := Result or (1 shl M);
  end;
end;

function ModesText(Mask: Integer): string;
var
  M: Integer;
begin
  Result := '';
  for M := 0 to 3 do
    if (Mask and (1 shl M)) <> 0 then
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + RadarModeName(M);
    end;
  if Result = '' then
    Result := 'none';
end;

function ColorByName(S: string): Integer;
begin
  S := LowerCase(Trim(S));
  Result := -1;
  if S = 'none' then
    Result := LC_NONE
  else if S = 'team' then
    Result := LC_TEAM
  else if S = 'health' then
    Result := LC_HEALTH
  else if S = 'distance' then
    Result := LC_DISTANCE;
end;

function ColorByOf(Section, Key, Def: string): Integer;
var
  S: string;
begin
  S := CfgStr(Section, Key, Def);
  Result := ColorByName(S);
  if Result < 0 then
  begin
    CfgWarn(Section, Key, S, 'none, team, health or distance; ' + Def + ' used');
    Result := ColorByName(Def);
  end;
end;

{ a mark of the circle radar: the setting, or Def when it is empty }
function MarkChar(S, Def: string): string;
begin
  Result := Trim(S);
  if Result = '' then
    Result := Def;
end;

procedure PrepareHud();
var
  i, k: Integer;
  Full, Empty, S: string;
  CFull, CHalf, CLow: Longint;
begin
  for i := 1 to STYLE_COUNT do
  begin
    S := HudStyleText[i];
    HudHasPct[i] := Pos('{pct}', S) > 0;
    HudHasHp[i] := Pos('{hp}', S) > 0;
    HudHasMax[i] := Pos('{max}', S) > 0;
    HudHasBar[i] := Pos('{bar}', S) > 0;
    HudHasRegen[i] := Pos('{regen}', S) > 0;
    HudHasVest[i] := Pos('{vest}', S) > 0;
  end;
  Full := CfgStr('HealthHud', 'BarFull', '|');
  Empty := CfgStr('HealthHud', 'BarEmpty', '.');
  if BeOk then
  begin
    for i := 1 to STYLE_COUNT do
      BE_HudStyle(i, PChar(HudStyleText[i]));
    BE_HudBar(PChar(Full), PChar(Empty), HudBarLen);
    BE_HudRegen(PChar(HudRegenMark));
  end;
  for i := 0 to HudBarLen do
  begin
    S := '';
    for k := 1 to HudBarLen do
      if k <= i then
        S := S + Full
      else
        S := S + Empty;
    BarCache[i] := S;
  end;
  CFull := CfgColor('HealthHud', 'ColorFull', $00FF00);
  CHalf := CfgColor('HealthHud', 'ColorHalf', $FFFF00);
  CLow := CfgColor('HealthHud', 'ColorLow', $FF0000);
  HudColorFull := CFull;
  HudColorHalf := CHalf;
  HudColorLow := CLow;
  for i := 0 to 100 do
    if i >= 50 then
      HudColorAt[i] := MixColor(CHalf, CFull, (i - 50) * 0.02)
    else
      HudColorAt[i] := MixColor(CLow, CHalf, i * 0.02);
end;

{ [Aimbot] Key or FlagKey: crouch, jet, prone, fire or flagthrow }
function AbKeyParse(Key: string): Integer;
var
  S: string;
begin
  S := LowerCase(Trim(CfgStr('Aimbot', Key, 'crouch')));
  Result := AK_CROUCH;
  if (S = 'jet') or (S = 'jetpack') then
    Result := AK_JET
  else if S = 'prone' then
    Result := AK_PRONE
  else if (S = 'fire') or (S = 'shoot') then
    Result := AK_FIRE
  else if (S = 'flagthrow') or (S = 'throwflag') or (S = 'flag') then
    Result := AK_FLAG
  else if S <> 'crouch' then
    CfgWarn('Aimbot', Key, S, 'crouch, jet, prone, fire or flagthrow; crouch used');
end;

{ [FlashNades] SwitchKey, [ExtraRocket] Keys: key names joined by + (crouch, prone, reload, fire, jet,
  grenade, changeweapon, throw, flagthrow, up); 0 = none; Bad when a name is not known }
function KeyMaskParse(S: string; var Bad: Boolean): Integer;
var
  W: string;
  p: Integer;
begin
  Result := 0;
  Bad := False;
  S := LowerCase(Trim(S));
  if (S = 'none') or (S = 'off') or (S = '') then
    Exit;
  S := ReplaceAll(ReplaceAll(S, ' ', ''), ',', '+');
  while S <> '' do
  begin
    p := Pos('+', S);
    if p = 0 then
    begin
      W := S;
      S := '';
    end
    else
    begin
      W := Copy(S, 1, p - 1);
      Delete(S, 1, p);
    end;
    if W = 'crouch' then
      Result := Result or KM_CROUCH
    else if W = 'prone' then
      Result := Result or KM_PRONE
    else if W = 'reload' then
      Result := Result or KM_RELOAD
    else if (W = 'fire') or (W = 'shoot') then
      Result := Result or KM_FIRE
    else if (W = 'jet') or (W = 'jetpack') then
      Result := Result or KM_JET
    else if (W = 'grenade') or (W = 'nade') then
      Result := Result or KM_GRENADE
    else if (W = 'changeweapon') or (W = 'change') then
      Result := Result or KM_CHANGE
    else if W = 'throw' then
      Result := Result or KM_THROW
    else if (W = 'flagthrow') or (W = 'throwflag') or (W = 'flag') then
      Result := Result or KM_FLAG
    else if (W = 'up') or (W = 'jump') then
      Result := Result or KM_UP
    else if W <> '' then
      Bad := True;
  end;
end;

function KeyMaskOf(Section, Key, Def: string): Integer;
var
  S: string;
  Bad: Boolean;
begin
  S := CfgStr(Section, Key, Def);
  Result := KeyMaskParse(S, Bad);
  if Bad then
  begin
    CfgWarn(Section, Key, S, 'key names joined by + (crouch, prone, reload, fire, jet, grenade, changeweapon, throw, ' +
      'flagthrow, up) or none; ' + Def + ' used');
    Result := KeyMaskParse(Def, Bad);
  end;
end;

{ a sound of the game's sfx folder: 'signal' or 'signal.wav' -> 'signal.wav' ('' = none) }
function SoundFile(S: string): string;
begin
  Result := Trim(S);
  if Result <> '' then
    if Pos('.', Result) = 0 then
      Result := Result + '.wav';
end;

{ the shortest word of a list like 'flash|fla|f' (for the texts) }
function ShortestWord(S: string): string;
var
  p: Integer;
  W: string;
begin
  Result := '';
  S := S + '|';
  while S <> '' do
  begin
    p := Pos('|', S);
    W := Trim(Copy(S, 1, p - 1));
    Delete(S, 1, p);
    if W <> '' then
      if (W[1] = '!') or (W[1] = '/') then
        Delete(W, 1, 1);
    if W <> '' then
      if (Result = '') or (Length(W) < Length(Result)) then
        Result := W;
  end;
end;

{ the words of List that are not words of Drop ('nade|n|cc1|smoke' without 'skill|cc1|smoke' = 'nade|n') }
function WordsWithout(List, Drop: string): string;
var
  S, W, O: string;
  p: Integer;
begin
  Result := '';
  O := '|' + ReplaceAll(LowerCase(ReplaceAll(ReplaceAll(Drop, '!', ''), '/', '')), ' ', '') + '|';
  S := List + '|';
  while S <> '' do
  begin
    p := Pos('|', S);
    W := Trim(Copy(S, 1, p - 1));
    Delete(S, 1, p);
    if W <> '' then
      if Pos('|' + LowerCase(ReplaceAll(ReplaceAll(W, '!', ''), '/', '')) + '|', O) = 0 then
      begin
        if Result <> '' then
          Result := Result + '|';
        Result := Result + W;
      end;
  end;
end;

{ the weapon in his hands as the ammunition saw it last (-1: a new life); the library's pass (AmmoPass) looks at
  the soldiers whose weapon is still this one }
procedure AmSetLastW(ID, W: Integer);
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  AmLastW[ID] := W;
  if BeOk then
    BE_AmmoLastW(ID, W);
end;

{ the word W (without ! or /) is one of List's (joined by |) }
function WordIn(W, List: string): Boolean;
var
  T: string;
begin
  Result := False;
  T := LowerCase(ReplaceAll(ReplaceAll(Trim(W), '!', ''), '/', ''));
  if T = '' then
    Exit;
  Result := Pos('|' + T + '|', '|' + ReplaceAll(LowerCase(ReplaceAll(ReplaceAll(List, '!', ''), '/', '')), ' ', '') +
    '|') > 0;
end;

{ F12: a list written as a whole file - by the library's writer thread (no wait for the disk in the tick), without
  the library at once; False when it could not be written now }
function SaveListFile(L: TStringList; Path: string): Boolean;
begin
  Result := True;
  if BeOk then
  begin
    BE_FileSave(PChar(Path), PChar(L.Text));
    Exit;
  end;
  try
    L.SaveToFile(Path);
  except
    Result := False;
  end;
end;

function KeyMaskText(M: Integer): string;
begin
  Result := '';
  if (M and KM_CROUCH) <> 0 then
    Result := Result + ' + crouch';
  if (M and KM_PRONE) <> 0 then
    Result := Result + ' + prone';
  if (M and KM_RELOAD) <> 0 then
    Result := Result + ' + reload';
  if (M and KM_FIRE) <> 0 then
    Result := Result + ' + fire';
  if (M and KM_JET) <> 0 then
    Result := Result + ' + jet';
  if (M and KM_GRENADE) <> 0 then
    Result := Result + ' + grenade';
  if (M and KM_CHANGE) <> 0 then
    Result := Result + ' + change weapon';
  if (M and KM_THROW) <> 0 then
    Result := Result + ' + throw weapon';
  if (M and KM_FLAG) <> 0 then
    Result := Result + ' + throw flag';
  if (M and KM_UP) <> 0 then
    Result := Result + ' + jump';
  if Result = '' then
    Result := 'none'
  else
    Delete(Result, 1, 3);
end;

{ all the keys of M are held (the keys come with the player's movement packets; prone is not a key:
  IsProne); the rarest keys are read first, so most looks end after one read }
function KeysHeld(P: TActivePlayer; M: Integer): Boolean;
begin
  Result := False;
  if M = 0 then
    Exit;
  if (M and KM_RELOAD) <> 0 then
    if not P.KeyReload then
      Exit;
  if (M and KM_CHANGE) <> 0 then
    if not P.KeyChangeWeap then
      Exit;
  if (M and KM_FLAG) <> 0 then
    if not P.KeyFlagThrow then
      Exit;
  if (M and KM_THROW) <> 0 then
    if not P.KeyThrow then
      Exit;
  if (M and KM_GRENADE) <> 0 then
    if not P.KeyGrenade then
      Exit;
  if (M and KM_FIRE) <> 0 then
    if not P.KeyShoot then
      Exit;
  if (M and KM_JET) <> 0 then
    if not P.KeyJetpack then
      Exit;
  if (M and KM_UP) <> 0 then
    if not P.KeyUp then
      Exit;
  if (M and KM_CROUCH) <> 0 then
    if not P.KeyCrouch then
      Exit;
  if (M and KM_PRONE) <> 0 then
    if not P.IsProne then
      Exit;
  Result := True;
end;

{ [TeamKill]: is the guard on now - a game mode of Modes, the server's friendly fire on, realistic mode
  when RealisticOnly; the library's eyes on the shots only then (and with the hook) }
procedure FfRefresh();
var
  Was: Boolean;
  S: Integer;
begin
  Was := FfActive;
  FfActive := False;
  FfIdleWhy := 'switched off';
  if FfEnabled then
  begin
    S := Game.GameStyle;
    if (S < 0) or (S > 7) then
      S := 0;
    if not FfModeOk[S] then
      FfIdleWhy := 'this game mode is not in [TeamKill] Modes'
    else if not Game.FriendlyFire then
      FfIdleWhy := 'the server''s friendly fire is off (nobody can hurt his team)'
    else if FfRealOnly and (not Game.Realistic) then
      FfIdleWhy := 'only in realistic mode ([TeamKill] RealisticOnly)'
    else
    begin
      FfActive := True;
      FfIdleWhy := '';
    end;
  end;
  { the library follows the shots while the guard is on (the intent of every team hit); Spray only
    decides whether a spray blocks the fire at once }
  if BeOk then
    BE_TkSet(TKC_ON, BoolInt(FfActive and HookOn));
  if FfEnabled then
    if FfActive <> Was then
    begin
      if FfActive then
        Log('[TeamKill] on')
      else
        Log('[TeamKill] idle: ' + FfIdleWhy);
    end;
end;

