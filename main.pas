{ a vest's pattern by its word: FX_V_*; -1 random (a new one every life), -3 none, -2 a word it does not know }
function InsPatternOf(W: string): Integer;
begin
  W := LowerCase(Trim(W));
  Result := -2;
  if W = 'classic' then
    Result := FX_V_CLASSIC
  else if W = 'hawk' then
    Result := FX_V_HAWK
  else if W = 'inferno' then
    Result := FX_V_INFERNO
  else if W = 'shrapnel' then
    Result := FX_V_SHRAPNEL
  else if W = 'ring' then
    Result := FX_V_RING
  else if W = 'scatter' then
    Result := FX_V_SCATTER
  else if W = 'ied' then
    Result := FX_V_IED
  else if W = 'plain' then
    Result := FX_V_PLAIN
  else if W = 'random' then
    Result := -1
  else if (W = 'none') or (W = 'off') or (W = '-') then
    Result := -3;
end;

