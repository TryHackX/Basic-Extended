      Say(ID, ClsName[c] + ' is not a class of the side of ' + PL[T].Name + ' here.', ColorBad);
      Exit;
    end;
  if PL[T].Alive then
  begin
    ClsSet(T, c, True);
    ClsGiveLoadout(T, c);
    ClsArm(T);
