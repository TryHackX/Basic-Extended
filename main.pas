{ why a skill cannot be used here ('' = it can): the modules and the modes it needs }
function ClsSkWhy(Kind: Integer): string;
begin
  Result := '';
  case Kind of
    SK_RALLY:
      if Game.Survival then
        Result := 'not in survival'
      else if not TeamGame() then
        Result := 'needs teams';
    SK_BARRAGE:
      if not TeamGame() then
        Result := 'needs teams';
    SK_UAV, SK_SENSOR:
      if not TeamGame() then
        Result := 'needs teams'
      else if ClsSpotsMode = 1 then
      begin
        { [Classes] SkillSpots = radar }
        if not OvlEnabled then
          Result := 'no radar here';
      end;
    SK_SUPPLY:
      if not SuActive then
        Result := 'no supply crates here';
    SK_RESUPPLY:
      if not (AmmoEnabled or FnEnabled) then
        Result := 'nothing to resupply here';
  end;
end;

{ the state of his skill n for his line: ready, the seconds of its cooldown, the seconds it still works, or why it
  cannot be used }
function ClsSkState(ID, n, Tick: Integer): string;
var
  c, Kind: Integer;
  Why, St: string;
begin
  Result := ClsNoSkill;
  c := ClsOf[ID];
  if (c < 1) or (c > ClsCount) then
    Exit;
  Kind := ClsSk[c][n];
  if Kind = SK_NONE then
    Exit;
  Why := ClsSkWhy(Kind);
  { round 26: one call of the library fills the text (the HUD's class line is built every second) }
  if BeOk then
  begin
    if Why <> '' then
      St := ClsOffText
    else if (Kind = SK_C4) and (ClsCool[ID][n] <= Tick) then
      St := IntToStr(ClsC4Left[ID]) + ' left'
    else if ClsOn[ID][n] > Tick then
      St := BE_Fill(ClsActiveText, '{seconds}'#1 + IntToStr((ClsOn[ID][n] - Tick + 59) div 60))
    else if ClsCool[ID][n] > Tick then
      St := BE_Fill(ClsCoolText, '{seconds}'#1 + IntToStr((ClsCool[ID][n] - Tick + 59) div 60))
    else
      St := ClsReadyText;
    Result := BE_Fill(ClsSkillText, '{name}'#1 + ClsSkName(Kind) + #1'{state}'#1 + St);
    Exit;
  end;
  if Why <> '' then
    Result := ReplaceAll(ReplaceAll(ClsSkillText, '{name}', ClsSkName(Kind)), '{state}', ClsOffText)
  else if (Kind = SK_C4) and (ClsCool[ID][n] <= Tick) then
    Result := ReplaceAll(ReplaceAll(ClsSkillText, '{name}', ClsSkName(Kind)), '{state}', IntToStr(ClsC4Left[ID]) +
      ' left')
  else if ClsOn[ID][n] > Tick then
    Result := ReplaceAll(ReplaceAll(ClsSkillText, '{name}', ClsSkName(Kind)), '{state}',
      ReplaceAll(ClsActiveText, '{seconds}', IntToStr((ClsOn[ID][n] - Tick + 59) div 60)))
  else if ClsCool[ID][n] > Tick then
    Result := ReplaceAll(ReplaceAll(ClsSkillText, '{name}', ClsSkName(Kind)), '{state}',
      ReplaceAll(ClsCoolText, '{seconds}', IntToStr((ClsCool[ID][n] - Tick + 59) div 60)))
  else
    Result := ReplaceAll(ReplaceAll(ClsSkillText, '{name}', ClsSkName(Kind)), '{state}', ClsReadyText);
end;

{ the players choose their classes (Assign = choice or limited) }
function ClsChoosing(): Boolean;
begin
  Result := (ClsAssign = CL_CHOICE) or (ClsAssign = CL_LIMITED);
end;

{ [Classes] Hud: "Medic: healthpack ready | -" ('' = no line) }
function ClsHudWant(ID: Integer; P: TActivePlayer): string;
var
  c, Tick: Integer;
  Ch, S1, S2: string;
begin
  Result := '';
  if not ClsActive then
    Exit;
  if not ClsHudOn then
    Exit;
  if not (HumanOf[ID] or DebugBots) then
    Exit;
  if TeamOf[ID] = TEAM_SPECTATOR then
    Exit;
  c := ClsOf[ID];
  if not P.Alive then
    if ClsNext[ID] > 0 then
      c := ClsNext[ID];
  if (c < 1) or (c > ClsCount) then
    Exit;
  Tick := Game.TickCount;
  { round 26: one call of the library fills the line }
  if BeOk then
  begin
    Ch := '';
    if ClsChoosing() then
      Ch := ClsChooseText;
    if c = ClsOf[ID] then
    begin
      S1 := ClsSkState(ID, 1, Tick);
      S2 := ClsSkState(ID, 2, Tick);
    end
    else
    begin
      S1 := ClsNoSkill;
      S2 := ClsNoSkill;
    end;
    Result := BE_Fill(ClsHudText, '{class}'#1 + ClsName[c] + #1'{choose}'#1 + Ch + #1'{skill}'#1 + S1 + #1'{skill2}'#1 +
      S2);
    Exit;
  end;
  Result := ReplaceAll(ClsHudText, '{class}', ClsName[c]);
  if ClsChoosing() then
    Result := ReplaceAll(Result, '{choose}', ClsChooseText)
  else
    Result := ReplaceAll(Result, '{choose}', '');
  if c = ClsOf[ID] then
  begin
    Result := ReplaceAll(Result, '{skill}', ClsSkState(ID, 1, Tick));
    Result := ReplaceAll(Result, '{skill2}', ClsSkState(ID, 2, Tick));
  end
  else
  begin
    Result := ReplaceAll(Result, '{skill}', ClsNoSkill);
    Result := ReplaceAll(Result, '{skill2}', ClsNoSkill);
  end;
end;

