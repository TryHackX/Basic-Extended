procedure ShLoadItems();
var
  It, P0: Integer;
  S, Pr, W, Wd: string;
begin
  for It := 0 to IT_LAST do
  begin
    ShCat[It] := ShCatOf(It);
    ShPrice[It] := -1;
    ShLimit[It] := 0;
    ShWords[It] := '|';
    if ShItemKey(It) = '' then
      Continue;
    S := CfgStr('Shop', ShItemKey(It), ShItemDef(It));
    Pr := LowerCase(ShField(S, 0));
    if (Pr = 'off') or (Pr = '') or (Pr = '-1') then
      ShPrice[It] := -1
    else if Copy(Pr, Length(Pr), 1) = '%' then
      { a share of the weapon's price (magazines, ammunition): kept as -100 - percent }
      ShPrice[It] := -100 - StrToIntDef(Copy(Pr, 1, Length(Pr) - 1), 20)
    else
    begin
      ShPrice[It] := StrToIntDef(Pr, -1);
      if ShPrice[It] < 0 then
        CfgWarn('Shop', ShItemKey(It), S, 'a price (or off), then | the words to buy it, | the limit a life');
    end;
    W := LowerCase(ShField(S, 1));
    if Trim(W) = '' then
      W := LowerCase(ShField(ShItemDef(It), 1));
    while W <> '' do
    begin
      P0 := Pos(' ', W);
      if P0 = 0 then
      begin
        Wd := Trim(W);
        W := '';
      end
      else
      begin
        Wd := Trim(Copy(W, 1, P0 - 1));
        W := Trim(Copy(W, P0 + 1, Length(W)));
      end;
      if Wd <> '' then
        ShWords[It] := ShWords[It] + Wd + '|';
    end;
    if Trim(ShField(S, 2)) = '' then
      ShLimit[It] := StrToIntDef(ShField(ShItemDef(It), 2), 0)
    else
      ShLimit[It] := StrToIntDef(ShField(S, 2), 0);
  end;
end;

