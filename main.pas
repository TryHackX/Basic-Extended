procedure CmdShopList(ID: Integer);
var
  i, j, Best, n: Integer;
  Done: array[1..32] of Boolean;
begin
  if not ShEnabled then
    Exit;
  for i := 1 to 32 do
    Done[i] := False;
  for n := 1 to 12 do
  begin
    Best := 0;
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if not Done[j] then
        begin
          { no short-circuit in ScriptCore: ShMoney[0] would be out of range }
          if Best = 0 then
            Best := j
          else if ShMoney[j] > ShMoney[Best] then
            Best := j;
        end;
