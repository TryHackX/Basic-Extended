{ ============ round 18: [SpawnProtection], [PrivateMessages], [Notes], [AdminChat] ============ }

{ ---------------- shared ---------------- }

{ the one player a word means: his id, his whole name, or the only name that holds it; 0 = nobody, -1 =
  several (the list is told to ID) }
function AdFindOne(ID: Integer; Word: string): Integer;
var
  i, n, Hits: Integer;
  W, L, Names: string;
begin
  Result := 0;
  W := Trim(Word);
  if W = '' then
    Exit;
  n := StrToIntDef(W, 0);
  if (n >= 1) and (n <= 32) then
  begin
    if ActiveSlot[n] then
      Result := n;
    Exit;
  end;
  L := LowerCase(W);
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if LowerCase(PL[i].Name) = L then
      begin
        Result := i;
        Exit;
      end;
  Hits := 0;
  Names := '';
  for i := 1 to TopSlot do
    if ActiveSlot[i] then
      if Pos(L, LowerCase(PL[i].Name)) > 0 then
      begin
        Hits := Hits + 1;
        Result := i;
        if Names <> '' then
          Names := Names + ', ';
        Names := Names + '(' + IntToStr(i) + ') ' + PL[i].Name;
      end;
  if Hits > 1 then
  begin
    Result := -1;
    Say(ID, 'Several players match "' + W + '": ' + Names + ' - use the number.', ColorBad);
  end;
end;

{ the player a key stands for when he comes back: his Steam id or computer id, else his name }
function AdKeyOf(ID: Integer): string;
begin
  Result := '';
  if (ID < 1) or (ID > 32) then
    Exit;
  Result := PrefKey[ID];
  if Result = '' then
    Result := 'N' + LowerCase(PL[ID].Name);
end;

{ a text with no line breaks and no '|' (the separator of the files) }
function AdClean(S: string): string;
begin
  Result := ReplaceAll(ReplaceAll(ReplaceAll(S, '|', '/'), #13, ' '), #10, ' ');
end;

function AdFill2(T, K1, V1, K2, V2: string): string;
begin
  Result := ReplaceAll(ReplaceAll(T, K1, V1), K2, V2);
end;

{ ---------------- [SpawnProtection] ---------------- }

{ he is safe no more: his mark and his text go }
procedure SfEnd(ID: Integer);
var
  j, L: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if SfUntil[ID] = 0 then
    Exit;
  SfUntil[ID] := 0;
  SfCount := SfCount - 1;
  if SfCount < 0 then
    SfCount := 0;
  L := SfLayerOf[ID];
  SfLayerOf[ID] := -1;
  if L >= 0 then
    for j := 1 to TopSlot do
      if ActiveSlot[j] then
        if HumanOf[j] or DebugBots then
          PL[j].WorldText(L, ' ', 1, ColorGood, 0.01, 0, 0);
  if SfSelfShown[ID] then
  begin
    SfSelfShown[ID] := False;
    LfBig(ID, SfBigLayer, ' ', ColorGood);
  end;
end;

{ a respawn: protected for Seconds (not in survival with Survival = 0) }
procedure SfRespawn(ID, Tick: Integer);
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  SfEnd(ID);
  if not SfActive then
    Exit;
  if not (PL[ID].Human or SfBots) then
    Exit;
  if Game.Survival then
    if not SfSurvival then
      Exit;
  SfUntil[ID] := After(Tick, SfTicks);
  SfFresh[ID] := True;
  SfLastSec[ID] := -1;
  SfLayerOf[ID] := -1;
  SfSentTick[ID] := 0;
  SfCount := SfCount + 1;
  SfStatGiven := SfStatGiven + 1;
end;

{ OnDamage: S's hit on V does nothing - V is protected, or S is (NoDamageDealt: his own shots - not a mine or a
  claymore of his, a blow of this script, a bullet he made before this life) }
function SfHit(S, V, B, Tick: Integer): Boolean;
var
  X, Y: Single;
  T: Integer;
begin
  Result := False;
  if (V >= 1) and (V <= 32) then
    if SfUntil[V] > Tick then
      Result := True;
  if not Result then
    if SfNoDealt then
      if not InTick then
        if (S >= 1) and (S <= 32) then
          if SfUntil[S] > Tick then
            if MnBulletKind(B, S) = 0 then
            if not ((ClsBulOwner[B and 255] = S) and (Game.TickCount - ClsBulTick[B and 255] <= 180)) then
            begin
              Result := True;
              if (B >= 1) and (B <= 254) then
                if BeOk then
                  if BE_BulletOrigin(B, X, Y, T) = 1 then
                    if T < SfUntil[S] - SfTicks then
                      Result := False;
            end;
  if Result then
    SfStatStopped := SfStatStopped + 1;
end;

{ a layer of the pool no other protected soldier uses now (his own when he has one) }
function SfLayerFor(ID: Integer): Integer;
var
  k, j, L: Integer;
  Used: Boolean;
begin
  Result := SfLayerOf[ID];
  if Result >= 0 then
    Exit;
  { none free: no mark (the protection holds) }
  Result := -1;
  for k := 0 to SfLayers - 1 do
  begin
    L := SfLayer0 + ((ID + k) mod SfLayers);
    Used := False;
    for j := 1 to TopSlot do
      if j <> ID then
        if SfLayerOf[j] = L then
          Used := True;
    if not Used then
    begin
      Result := L;
      Exit;
    end;
  end;
end;

{ the protected: the time, a shot, the distance; the mark over them (again when the second changes or they
  moved) and their own text }
procedure SfTickRun(Tick: Integer);
var
  i, j, L, Sec: Integer;
  P: TActivePlayer;
  DX, DY: Single;
  Send: Boolean;
begin
  if SfCount <= 0 then
    Exit;
  { a pause: the protection's time waits }
  if PausedNow then
    for i := 1 to TopSlot do
      if SfUntil[i] > 0 then
        SfUntil[i] := SfUntil[i] + 1;
  for i := 1 to TopSlot do
    if SfUntil[i] > 0 then
    begin
      if not ActiveSlot[i] then
      begin
        SfEnd(i);
        Continue;
      end;
      P := PL[i];
      if (not P.Alive) or (Tick >= SfUntil[i]) then
      begin
        SfEnd(i);
        Continue;
      end;
      if SfFresh[i] then
      begin
        SfFresh[i] := False;
        SfX0[i] := P.X;
        SfY0[i] := P.Y;
      end
      else
      begin
        if SfEndShoot then
          if P.KeyShoot or P.KeyGrenade then
          begin
            SfStatEnded := SfStatEnded + 1;
            SfEnd(i);
            Continue;
          end;
        if SfEndDist > 0 then
        begin
          DX := P.X - SfX0[i];
          DY := P.Y - SfY0[i];
          if DX * DX + DY * DY > SfEndDist * SfEndDist then
          begin
            SfStatEnded := SfStatEnded + 1;
            SfEnd(i);
            Continue;
          end;
        end;
      end;
      Sec := (SfUntil[i] - Tick + 59) div 60;
      Send := Sec <> SfLastSec[i];
      if not Send then
        if Tick - SfSentTick[i] >= 8 then
        begin
          DX := P.X - SfSentX[i];
          DY := P.Y - SfSentY[i];
          if DX * DX + DY * DY > 144 then
            Send := True;
        end;
      if Send then
      begin
        if SfMark <> '' then
        begin
          L := SfLayerFor(i);
          SfLayerOf[i] := L;
          { realistic: only his team, the dead and the spectators see it (the sight rule) }
          j := -1;
          if Realistic then
            j := TeamOf[i];
          if L >= 0 then
            LfOverAll(L, ReplaceAll(SfMark, '{seconds}', IntToStr(Sec)), P.X, P.Y, SfMarkScale, SfMarkY, 70,
              SfMarkColor, j);
        end;
        SfSentTick[i] := Tick;
        SfSentX[i] := P.X;
        SfSentY[i] := P.Y;
        if Sec <> SfLastSec[i] then
          if SfSelfText <> '' then
          begin
            LfBig(i, SfBigLayer, ReplaceAll(SfSelfText, '{seconds}', IntToStr(Sec)), SfColor);
            SfSelfShown[i] := True;
          end;
        SfLastSec[i] := Sec;
      end;
    end;
end;

{ ---------------- [PrivateMessages] ---------------- }

function PmBlocked(F, T: Integer): Boolean;
begin
  Result := PmBlockAll[T];
  if not Result then
    Result := Pos('|' + AdKeyOf(F) + '|', PmBlocks[T]) > 0;
end;

{ a muted player (the server's mute: an admin's /mute or [AntiSpam]) }
function PmMutedNow(ID: Integer): Boolean;
begin
  Result := False;
  if (ID >= 1) and (ID <= 32) then
    if ActiveSlot[ID] then
      Result := PL[ID].Muted;
end;

procedure PmSend(ID, T: Integer; Text: string);
var
  i: Integer;
  S: string;
begin
  if T = ID then
  begin
    Say(ID, 'That is you.', ColorBad);
    Exit;
  end;
  if not HumanOf[T] then
  begin
    Say(ID, PL[T].Name + ' is a bot.', ColorBad);
    Exit;
  end;
  if Game.TickCount < PmNextOk[ID] then
  begin
    Say(ID, 'Not so fast - one private message a moment.', ColorBad);
    Exit;
  end;
  if not PmMutedCan then
    if PmMutedNow(ID) then
    begin
      Say(ID, 'You are muted: no private messages either.', ColorBad);
      Exit;
    end;
  S := Text;
  if Length(S) > PmMaxLen then
    S := Copy(S, 1, PmMaxLen);
  if PmBlocked(ID, T) then
  begin
    PmStatBlocked := PmStatBlocked + 1;
    Say(ID, PL[T].Name + ' does not take private messages from you.', ColorBad);
    Exit;
  end;
  Say(T, AdFill2(PmFromText, '{player}', PL[ID].Name, '{text}', S), PmColor);
  if PmLast[T] = 0 then
    Say(T, 'Answer with /r <text>; /pmmute stops private messages.', PmColor);
  Say(ID, AdFill2(PmToText, '{player}', PL[T].Name, '{text}', S), PmColor);
  PmLast[T] := ID;
  PmLastKey[T] := AdKeyOf(ID);
  PmNextOk[ID] := Game.TickCount + PmCoolTicks;
  PmStatSent := PmStatSent + 1;
  if PmAdminsSee then
    for i := 1 to TopSlot do
      if i <> ID then
        if i <> T then
          if ActiveSlot[i] then
            if HumanOf[i] then
              if PL[i].IsAdmin then
                Say(i, ReplaceAll(AdFill2(PmSpyText, '{from}', PL[ID].Name, '{to}', PL[T].Name), '{text}', S),
                  PmSpyColor);
  if PmLog then
    if LgEnabled then
      LogLine(ID, PL[ID].Name + ' PM to ' + PL[T].Name + ': ' + S);
end;

procedure CmdPm(ID: Integer; Args: string);
var
  Rest, W: string;
  T: Integer;
begin
  { the console's /pm is the server's own }
  if (ID < 1) or (ID > 32) then
    Exit;
  if not PmEnabled then
    Exit;
  Rest := Args;
  W := TakeArg(Rest);
  Rest := Trim(Rest);
  if (W = '') or (Rest = '') then
  begin
    Say(ID, 'Use: /pm <player id or name> <text>; /r <text> answers; /pmmute [player], /pmunmute [player].',
      ColorGood);
    Exit;
  end;
  T := AdFindOne(ID, W);
  if T = 0 then
  begin
    Say(ID, 'No player "' + W + '".', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  PmSend(ID, T, Rest);
end;

procedure CmdPmReply(ID: Integer; Args: string);
var
  T: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not PmEnabled then
    Exit;
  if Trim(Args) = '' then
  begin
    Say(ID, 'Use: /r <text> - answers the last one who wrote to you.', ColorGood);
    Exit;
  end;
  T := PmLast[ID];
  if (T < 1) or (T > 32) then
  begin
    Say(ID, 'Nobody wrote to you yet.', ColorBad);
    Exit;
  end;
  if not ActiveSlot[T] then
  begin
    Say(ID, 'The one who wrote to you has left.', ColorBad);
    Exit;
  end;
  if AdKeyOf(T) <> PmLastKey[ID] then
  begin
    Say(ID, 'The one who wrote to you has left.', ColorBad);
    Exit;
  end;
  PmSend(ID, T, Trim(Args));
end;

procedure CmdPmMute(ID: Integer; Args: string; Unmute: Boolean);
var
  Rest, W, K: string;
  T: Integer;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if not PmEnabled then
    Exit;
  Rest := Args;
  W := TakeArg(Rest);
  if W = '' then
  begin
    if Unmute then
    begin
      PmBlockAll[ID] := False;
      PmBlocks[ID] := '|';
      Say(ID, 'You take private messages from everybody again.', PmColor);
    end
    else
    begin
      PmBlockAll[ID] := True;
      Say(ID, 'You take no private messages now (/pmunmute: again).', PmColor);
    end;
    Exit;
  end;
  T := AdFindOne(ID, W);
  if T = 0 then
  begin
    Say(ID, 'No player "' + W + '".', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  K := AdKeyOf(T);
  if PmBlocks[ID] = '' then
    PmBlocks[ID] := '|';
  if Unmute then
  begin
    PmBlocks[ID] := ReplaceAll(PmBlocks[ID], '|' + K + '|', '|');
    Say(ID, 'You take private messages from ' + PL[T].Name + ' again.', PmColor);
  end
  else
  begin
    if Pos('|' + K + '|', PmBlocks[ID]) = 0 then
      PmBlocks[ID] := PmBlocks[ID] + K + '|';
    Say(ID, 'You take no private messages from ' + PL[T].Name + ' now.', PmColor);
  end;
end;

{ his blocks while he is away (by his key), back when he returns }
procedure PmLeave(ID: Integer);
var
  k: Integer;
  K0, V: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  K0 := AdKeyOf(ID);
  if PmStore <> nil then
    if K0 <> '' then
    begin
      k := PmStore.IndexOfName(K0);
      if k >= 0 then
        PmStore.Delete(k);
      V := PmBlocks[ID];
      if PmBlockAll[ID] then
        V := '*' + V;
      if (V <> '') and (V <> '|') then
        if PmStore.Count < 500 then
          PmStore.Add(K0 + '=' + V);
    end;
  PmBlockAll[ID] := False;
  PmBlocks[ID] := '|';
  PmLast[ID] := 0;
  PmLastKey[ID] := '';
  PmNextOk[ID] := 0;
end;

procedure PmRestore(ID: Integer);
var
  k: Integer;
  K0, V: string;
begin
  if (ID < 1) or (ID > 32) then
    Exit;
  if PmStore = nil then
    Exit;
  K0 := AdKeyOf(ID);
  if K0 = '' then
    Exit;
  k := PmStore.IndexOfName(K0);
  if k < 0 then
    Exit;
  V := PmStore[k];
  V := Copy(V, Pos('=', V) + 1, Length(V));
  PmBlockAll[ID] := False;
  if V <> '' then
    if V[1] = '*' then
    begin
      PmBlockAll[ID] := True;
      Delete(V, 1, 1);
    end;
  if V = '' then
    V := '|';
  PmBlocks[ID] := V;
end;

{ ---------------- [Notes] ---------------- }

{ field k (0 = '#n') of a note line }
function NtField(Line: string; k: Integer): string;
var
  S: string;
  i, p: Integer;
begin
  Result := '';
  S := Line + '|';
  for i := 0 to k do
  begin
    p := Pos('|', S);
    if p = 0 then
      Exit;
    Result := Copy(S, 1, p - 1);
    Delete(S, 1, p);
  end;
end;

function NtNumber(Line: string): Integer;
var
  S: string;
begin
  S := NtField(Line, 0);
  if Length(S) > 1 then
    Delete(S, 1, 1);
  Result := StrToIntDef(S, 0);
end;

function NtHiddenOf(n: Integer): Boolean;
begin
  Result := n <= NtClearedTo;
  if not Result then
    Result := Pos('|' + IntToStr(n) + '|', NtHidden) > 0;
end;

procedure NtSaveState();
var
  L: TStringList;
begin
  L := File.CreateStringList();
  L.Add('read=' + IntToStr(NtReadTo));
  L.Add('cleared=' + IntToStr(NtClearedTo));
  L.Add('hidden=' + NtHidden);
  try
    L.SaveToFile(DataDir + NtStateName);
  except
    Log('[Notes] cannot write ' + DataDir + NtStateName);
  end;
  L.Free;
end;

procedure NtSaveBans();
begin
  if NtBans = nil then
    Exit;
  try
    NtBans.SaveToFile(DataDir + NtBanName);
  except
    Log('[Notes] cannot write ' + DataDir + NtBanName);
  end;
end;

{ the notes, the state and the blacklist from the data folder (once a run: the library may still be writing
  the newest note when the settings are read again) }
procedure NtLoad();
var
  L: TStringList;
  i, n, Skip: Integer;
  S: string;
begin
  if NtLoaded then
    Exit;
  NtLoaded := True;
  NtList := File.CreateStringList();
  NtBans := File.CreateStringList();
  NtDay := File.CreateStringList();
  NtNext := 1;
  NtReadTo := 0;
  NtClearedTo := 0;
  NtHidden := '|';
  if NtFileName <> '' then
    if File.Exists(DataDir + NtFileName) then
    begin
      L := File.CreateStringListFromFile(DataDir + NtFileName);
      { F11: the last 500 notes (the numbers of all of them): the older ones are skipped, not deleted one by one }
      Skip := 0;
      for i := 0 to L.Count - 1 do
      begin
        S := L[i];
        if Length(S) > 1 then
          if S[1] = '#' then
          begin
            n := NtNumber(S);
            if n > 0 then
            begin
              Skip := Skip + 1;
              if n >= NtNext then
                NtNext := n + 1;
            end;
          end;
      end;
      Skip := Skip - 500;
      for i := 0 to L.Count - 1 do
      begin
        S := L[i];
        if Length(S) > 1 then
          if S[1] = '#' then
            if NtNumber(S) > 0 then
            begin
              if Skip > 0 then
                Skip := Skip - 1
              else
                NtList.Add(S);
            end;
      end;
      L.Free;
    end;
  if NtStateName <> '' then
    if File.Exists(DataDir + NtStateName) then
    begin
      L := File.CreateStringListFromFile(DataDir + NtStateName);
      for i := 0 to L.Count - 1 do
      begin
        S := Trim(L[i]);
        if Copy(S, 1, 5) = 'read=' then
          NtReadTo := StrToIntDef(Copy(S, 6, 20), 0)
        else if Copy(S, 1, 8) = 'cleared=' then
          NtClearedTo := StrToIntDef(Copy(S, 9, 20), 0)
        else if Copy(S, 1, 7) = 'hidden=' then
          NtHidden := Copy(S, 8, Length(S));
      end;
      L.Free;
      if NtHidden = '' then
        NtHidden := '|';
    end;
  if NtBanName <> '' then
    if File.Exists(DataDir + NtBanName) then
    begin
      L := File.CreateStringListFromFile(DataDir + NtBanName);
      for i := 0 to L.Count - 1 do
        if Trim(L[i]) <> '' then
          NtBans.Add(Trim(L[i]));
      L.Free;
    end;
end;

{ the unread notes (not hidden) }
function NtUnread(): Integer;
var
  i, n: Integer;
begin
  Result := 0;
  if NtList = nil then
    Exit;
  { the numbers grow: the newest first, until the read ones }
  for i := NtList.Count - 1 downto 0 do
  begin
    n := NtNumber(NtList[i]);
    if n <= NtReadTo then
      Exit;
    if not NtHiddenOf(n) then
      Result := Result + 1;
  end;
end;

{ the value of a blacklist line: 'ip 1.2.3.4 // name' -> '1.2.3.4' }
function NtBanValue(Line: string): string;
var
  S: string;
  p: Integer;
begin
  S := Trim(Line);
  p := Pos('//', S);
  if p > 0 then
    S := Trim(Copy(S, 1, p - 1));
  p := Pos(' ', S);
  Result := '';
  if p > 0 then
    Result := Trim(Copy(S, p + 1, Length(S)));
end;

function NtBanKind(Line: string): string;
var
  S: string;
  p: Integer;
begin
  S := LowerCase(Trim(Line));
  p := Pos(' ', S);
  Result := '';
  if p > 0 then
    Result := Copy(S, 1, p - 1);
end;

{ is he on the notes blacklist (his IP, computer id or Steam id) }
function NtBlocked(ID: Integer): Boolean;
var
  i: Integer;
  K, V, Ip, Hw, St: string;
begin
  Result := False;
  if NtBans = nil then
    Exit;
  Ip := PL[ID].IP;
  Hw := Trim(PL[ID].HWID);
  St := SteamId[ID];
  for i := 0 to NtBans.Count - 1 do
  begin
    K := NtBanKind(NtBans[i]);
    V := NtBanValue(NtBans[i]);
    if V <> '' then
    begin
      if K = 'ip' then
      begin
        if V = Ip then
          Result := True;
      end
      else if K = 'hw' then
      begin
        if V = Hw then
          Result := True;
      end
      else if K = 'steam' then
        if V = St then
          Result := True;
    end;
  end;
end;

{ his notes today (PerDay) }
function NtTodayAdd(ID: Integer; Add: Boolean): Integer;
var
  k: Integer;
  Name: string;
begin
  Result := 0;
  if NtDay = nil then
    Exit;
  Name := FormatDateTime('yyyymmdd', Now) + ' ' + AdKeyOf(ID);
  k := NtDay.IndexOfName(Name);
  if k >= 0 then
    Result := StrToIntDef(Copy(NtDay[k], Pos('=', NtDay[k]) + 1, 20), 0);
  if Add then
  begin
    Result := Result + 1;
    if k >= 0 then
      NtDay[k] := Name + '=' + IntToStr(Result)
    else
    begin
      if NtDay.Count > 300 then
        NtDay.Delete(0);
      NtDay.Add(Name + '=' + IntToStr(Result));
    end;
  end;
end;

{ /note <text>, /report <player> <text> }
procedure CmdNote(ID: Integer; Args: string; Report: Boolean);
var
  Rest, W, Text, Line, About: string;
  T, n: Integer;
begin
  if (ID < 1) or (ID > 32) then
  begin
    Say(ID, 'Notes are for the players in the game.', ColorBad);
    Exit;
  end;
  if not NtEnabled then
    Exit;
  NtLoad();
  Rest := Args;
  About := '';
  if Report then
  begin
    if not NtReports then
      Exit;
    W := TakeArg(Rest);
    if W = '' then
    begin
      Say(ID, 'Use: /report <player id or name> <what happened> - the admins read it.', ColorGood);
      Exit;
    end;
    T := AdFindOne(ID, W);
    if T = 0 then
    begin
      Say(ID, 'No player "' + W + '".', ColorBad);
      Exit;
    end;
    if T < 0 then
      Exit;
    About := '[report on ' + PL[T].Name + ' - ' + iif(SteamId[T] <> '', SteamId[T] + ' ', '') + 'hw ' +
      Trim(PL[T].HWID) + ' ip ' + PL[T].IP + '] ';
  end;
  Text := Trim(Rest);
  if Text = '' then
  begin
    Say(ID, 'Use: /note <text> - a note for the admins (they read it with /comments).', ColorGood);
    Exit;
  end;
  if NtBlocked(ID) then
  begin
    Say(ID, NtBannedText, ColorBad);
    Exit;
  end;
  if Game.TickCount < NtNextOk[ID] then
  begin
    Say(ID, 'One note at a time - wait ' + IntToStr((NtNextOk[ID] - Game.TickCount + 59) div 60) + ' s.', ColorBad);
    Exit;
  end;
  if NtPerDay > 0 then
    if NtTodayAdd(ID, False) >= NtPerDay then
    begin
      Say(ID, 'That is ' + IntToStr(NtPerDay) + ' notes today - the admins have them.', ColorBad);
      Exit;
    end;
  if Length(Text) > NtMaxLen then
    Text := Copy(Text, 1, NtMaxLen);
  n := NtNext;
  NtNext := NtNext + 1;
  Line := '#' + IntToStr(n) + '|' + FormatDateTime('yyyy-mm-dd hh:nn', Now) + '|' + AdClean(PL[ID].Name) + '|' +
    SteamId[ID] + '|' + AdClean(Trim(PL[ID].HWID)) + '|' + PL[ID].IP + '|' + AdClean(Game.CurrentMap) + '|' +
    AdClean(About + Text);
  if BeOk then
    if NtFileName <> '' then
      BE_Log(PChar(DataDir + NtFileName), PChar(Line));
  NtList.Add(Line);
  while NtList.Count > 500 do
    NtList.Delete(0);
  NtStatNew := NtStatNew + 1;
  NtNextOk[ID] := Game.TickCount + NtCoolTicks;
  n := NtTodayAdd(ID, True);
  Say(ID, ReplaceAll(NtSavedText, '{number}', IntToStr(NtNext - 1)), NtColor);
  if NtTellAdmins then
    n := SayAdmins('Note #' + IntToStr(NtNext - 1) + ' from ' + PL[ID].Name + ': ' + About + Text +
      ' (/comments)', NtColor);
  Log('[Notes] #' + IntToStr(NtNext - 1) + ' from ' + PL[ID].Name + ': ' + About + Text);
end;

{ a note in one line for the list }
function NtShort(Line: string): string;
begin
  Result := NtField(Line, 0) + ' ' + Copy(NtField(Line, 1), 6, 11) + ' ' + NtField(Line, 2) + ': ' + NtField(Line, 7);
end;

{ /comments [all | read <n> | <n> | del <n> | clear] }
procedure CmdComments(ID: Integer; Args: string);
var
  Rest, W: string;
  i, n, k, Shown: Integer;
  Line: string;
  Found: Boolean;
begin
  if not NtEnabled then
    Exit;
  NtLoad();
  Rest := Args;
  W := LowerCase(TakeArg(Rest));
  if (W = 'del') or (W = 'delete') or (W = 'hide') then
  begin
    n := StrToIntDef(TakeArg(Rest), 0);
    if n <= 0 then
    begin
      Say(ID, 'Use: /comments del <number>', ColorBad);
      Exit;
    end;
    if Pos('|' + IntToStr(n) + '|', NtHidden) = 0 then
      NtHidden := NtHidden + IntToStr(n) + '|';
    NtSaveState();
    Say(ID, 'Note #' + IntToStr(n) + ' is hidden (it stays in ' + NtFileName + ').', ColorGood);
    Exit;
  end;
  if W = 'clear' then
  begin
    NtClearedTo := NtNext - 1;
    NtReadTo := NtNext - 1;
    NtSaveState();
    Say(ID, 'Every note is hidden (they stay in ' + NtFileName + ').', ColorGood);
    Exit;
  end;
  if W = 'read' then
    W := TakeArg(Rest);
  n := StrToIntDef(W, 0);
  if n > 0 then
  begin
    Found := False;
    for i := 0 to NtList.Count - 1 do
      if NtNumber(NtList[i]) = n then
      begin
        Line := NtList[i];
        Found := True;
        Say(ID, '#' + IntToStr(n) + ' ' + NtField(Line, 1) + ' on ' + NtField(Line, 6) + ' from ' + NtField(Line, 2),
          NtColor);
        Say(ID, '  Steam ' + NtField(Line, 3) + ', computer ' + NtField(Line, 4) + ', IP ' + NtField(Line, 5), NtColor);
        Say(ID, '  ' + NtField(Line, 7), NtColor);
      end;
    if not Found then
      Say(ID, 'No note #' + IntToStr(n) + ' (only the last 500 are kept here; all of them are in ' + NtFileName + ').',
        ColorBad);
    Exit;
  end;
  { the unread ones, newest first; 'all': the last ones }
  Shown := 0;
  k := 0;
  for i := NtList.Count - 1 downto 0 do
  begin
    n := NtNumber(NtList[i]);
    if not NtHiddenOf(n) then
      if (W = 'all') or (n > NtReadTo) then
      begin
        k := k + 1;
        if Shown < NtShow then
        begin
          Say(ID, NtShort(NtList[i]), NtColor);
          Shown := Shown + 1;
        end;
      end;
  end;
  if k = 0 then
  begin
    if W = 'all' then
      Say(ID, 'No notes.', ColorGood)
    else
      Say(ID, 'No unread notes (/comments all: the last ones).', ColorGood);
    Exit;
  end;
  if k > Shown then
    Say(ID, IntToStr(k - Shown) + ' more. /comments read <n>: one in full, del <n>: hide, clear: hide all.', ColorGood)
  else
    Say(ID, '/comments read <n>: one in full, del <n>: hide, clear: hide all.', ColorGood);
  if W <> 'all' then
  begin
    NtReadTo := NtNext - 1;
    NtSaveState();
  end;
end;

{ /noteban <player>: his IP, computer id and Steam id on the notes blacklist }
procedure CmdNoteBan(ID: Integer; Args: string);
var
  T, n: Integer;
  Tail, Hw: string;
begin
  if not NtEnabled then
    Exit;
  NtLoad();
  T := AdFindOne(ID, Args);
  if T = 0 then
  begin
    Say(ID, 'Use: /noteban <player id or name> (players in the game; /notebanlist, /noteunban <n>).', ColorBad);
    Exit;
  end;
  if T < 0 then
    Exit;
  Tail := ' // ' + AdClean(PL[T].Name) + ' ' + FormatDateTime('yyyy-mm-dd', Now);
  n := 0;
  if PL[T].IP <> '' then
  begin
    NtBans.Add('ip ' + PL[T].IP + Tail);
    n := n + 1;
  end;
  Hw := Trim(PL[T].HWID);
  if Hw <> '' then
  begin
    NtBans.Add('hw ' + Hw + Tail);
    n := n + 1;
  end;
  if SteamId[T] <> '' then
  begin
    NtBans.Add('steam ' + SteamId[T] + Tail);
    n := n + 1;
  end;
  NtSaveBans();
  Say(ID, PL[T].Name + ' cannot leave notes any more (' + IntToStr(n) + ' entries: IP, computer id, Steam id).',
    ColorGood);
end;

{ /noteunban <n | player | value> }
procedure CmdNoteUnban(ID: Integer; Args: string);
var
  i, n, T, Gone: Integer;
  W, Ip, Hw, St, V: string;
begin
  if not NtEnabled then
    Exit;
  NtLoad();
  W := Trim(Args);
  if W = '' then
  begin
    Say(ID, 'Use: /noteunban <number of /notebanlist | player | IP, computer id or Steam id>', ColorBad);
    Exit;
  end;
  Gone := 0;
  n := StrToIntDef(W, 0);
  if (n >= 1) and (n <= NtBans.Count) and (Pos('.', W) = 0) then
  begin
    NtBans.Delete(n - 1);
    Gone := 1;
  end
  else
  begin
    Ip := '';
    Hw := '';
    St := '';
    T := 0;
    if Length(W) < 30 then
      T := AdFindOne(ID, W);
    if T < 0 then
      Exit;
    if T > 0 then
    begin
      Ip := PL[T].IP;
      Hw := Trim(PL[T].HWID);
      St := SteamId[T];
    end;
    for i := NtBans.Count - 1 downto 0 do
    begin
      V := NtBanValue(NtBans[i]);
      if V <> '' then
        if (V = W) or ((T > 0) and ((V = Ip) or (V = Hw) or (V = St))) then
        begin
          NtBans.Delete(i);
          Gone := Gone + 1;
        end;
    end;
  end;
  NtSaveBans();
  Say(ID, 'Entries taken off the notes blacklist: ' + IntToStr(Gone) + '.', ColorGood);
end;

procedure CmdNoteBanList(ID: Integer);
var
  i: Integer;
begin
  if not NtEnabled then
    Exit;
  NtLoad();
  if NtBans.Count = 0 then
  begin
    Say(ID, 'The notes blacklist is empty.', ColorGood);
    Exit;
  end;
  for i := 0 to NtBans.Count - 1 do
    if i < 20 then
      Say(ID, IntToStr(i + 1) + '. ' + NtBans[i], NtColor);
  if NtBans.Count > 20 then
    Say(ID, IntToStr(NtBans.Count - 20) + ' more in data/' + NtBanName + '.', NtColor);
end;

{ an admin who joined: the unread notes (once, 10 s after the join, when he is an admin by then) }
procedure NtAdminHint(ID: Integer);
var
  n: Integer;
begin
  if not NtEnabled then
    Exit;
  if not ActiveSlot[ID] then
    Exit;
  if not HumanOf[ID] then
    Exit;
  if not PL[ID].IsAdmin then
    Exit;
  NtLoad();
  n := NtUnread();
